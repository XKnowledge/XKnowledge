{"version":2,"nodes":[{"name":"茶学","des":"一片树叶的大学问：自茶树植物学、制茶工艺至饮茶文化，本图一切脉络由此生发。","symbolSize":70,"category":"源流与传播"},{"name":"茶树原产地","des":"澜沧江流域的原始丛林，云南为茶树起源与分化中心，参天野生古茶树至今犹立。","symbolSize":40,"category":"源流与传播"},{"name":"神农尝茶","des":"“神农尝百草，日遇七十二毒，得荼而解之”，传说是茶史的第一行笔墨。","symbolSize":40,"category":"源流与传播"},{"name":"陆羽","des":"复州竟陵人，字鸿渐，弃儒冠而事茶，以一部《茶经》定茶之品格，尊为茶圣。","symbolSize":50,"category":"源流与传播"},{"name":"茶经","des":"公元八世纪问世的世界上第一部茶学专著，三卷十章，源出江南而泽被千载。","symbolSize":60,"category":"源流与传播"},{"name":"卢仝","des":"唐代诗人，号玉川子，一曲《七碗茶歌》自喉吻润写到乘风归，后世尊为茶仙。","symbolSize":40,"category":"源流与传播"},{"name":"煎茶法","des":"唐代饮法：炙茶碾罗成末，候汤三沸投末而煎，陆羽为之定制二十四件茶器。","symbolSize":40,"category":"源流与传播"},{"name":"点茶","des":"宋代饮法：研膏茶末入盏，沸水环回击拂，雪沫乳花咬盏不散者为上品。","symbolSize":50,"category":"源流与传播"},{"name":"斗茶","des":"宋人较茶之戏：汤色以白为贵，水痕以晚为高，胜负只在毫厘之间。","symbolSize":40,"category":"源流与传播"},{"name":"茶百戏","des":"又称分茶，以茶筅或汤匙使沫饽幻出山水花鸟，是顷刻消散的盏中丹青。","symbolSize":40,"category":"源流与传播"},{"name":"径山茶宴","des":"杭州径山寺以茶宴宾的完整仪轨，随东渡僧传入日本，茶道之源流之一。","symbolSize":40,"category":"源流与传播"},{"name":"荣西","des":"日本僧人，两度入宋求禅，携茶种归国植于背振山，著《吃茶养生记》。","symbolSize":40,"category":"源流与传播"},{"name":"茶马古道","des":"以茶易马的千年商道，自滇川蜿蜒入藏，马帮与背夫把茶驮过横断山脉。","symbolSize":50,"category":"源流与传播"},{"name":"茶路西行","des":"从武夷山下梅村直达恰克图的万里茶道，与海路一道把茶送进欧洲茶杯。","symbolSize":40,"category":"源流与传播"},{"name":"明代散茶","des":"洪武诏罢龙团改贡叶茶，碾末之饮遂让位于散茶瀹泡，今日冲泡之始。","symbolSize":40,"category":"源流与传播"},{"name":"绿茶","des":"不发酵茶：杀青锁住青翠，清汤绿叶，鲜爽为本，中华产量最大的茶类。","symbolSize":55,"category":"六大茶类谱系"},{"name":"白茶","des":"微发酵茶：不炒不揉，全凭萎凋与日晒成茶，毫香蜜韵，最见茶之本味。","symbolSize":55,"category":"六大茶类谱系"},{"name":"黄茶","des":"轻发酵茶：闷黄造就黄汤黄叶，滋味转甘醇，六大茶类中最清瘦的一支。","symbolSize":55,"category":"六大茶类谱系"},{"name":"乌龙茶","des":"半发酵茶：做青摇出绿叶红镶边，兼得绿茶之鲜与红茶之甜，又名青茶。","symbolSize":55,"category":"六大茶类谱系"},{"name":"红茶","des":"全发酵茶：红汤红叶，香甜醇厚，曾沿海路风靡欧洲下午茶的东方树叶。","symbolSize":55,"category":"六大茶类谱系"},{"name":"黑茶","des":"后发酵茶：渥堆借微生物之力转化滋味，越陈越香，边销西域的主力。","symbolSize":55,"category":"六大茶类谱系"},{"name":"发酵程度","des":"以茶多酚氧化深浅为刻度的一条隐形轴，六大茶类沿轴排开，各安其位。","symbolSize":60,"category":"六大茶类谱系"},{"name":"陈椽","des":"二十世纪茶学名家，执教于安徽农学院，一九七九年确立六大茶类分类法。","symbolSize":40,"category":"六大茶类谱系"},{"name":"茶多酚","des":"茶中儿茶素类物质之统称，涩感与回甘之源，亦是发酵转化的全部底物。","symbolSize":40,"category":"六大茶类谱系"},{"name":"酶促氧化","des":"多酚氧化酶催化儿茶素氧化的过程，发酵一词的化学本体，红汤红叶之母。","symbolSize":40,"category":"六大茶类谱系"},{"name":"绿叶红镶边","des":"做青时叶缘碰撞氧化变红、叶心犹青的印记，乌龙茶叶底上的身份证。","symbolSize":40,"category":"六大茶类谱系"},{"name":"采青","des":"自茶树采下鲜叶，标准多在一芽一二叶之间，是所有茶类的第一道工序。","symbolSize":40,"category":"制茶工艺链"},{"name":"萎凋","des":"鲜叶摊晾缓缓失水，青气渐散花香初透，白茶红茶以此立身，成茶之枢。","symbolSize":50,"category":"制茶工艺链"},{"name":"做青","des":"摇青与晾青交替进行，叶缘碰撞而氧化，摇出香气、晾出韵味的看家工艺。","symbolSize":50,"category":"制茶工艺链"},{"name":"杀青","des":"以高温钝化酶活性，一举阻断氧化，青翠自此定格，绿茶命门之所系。","symbolSize":50,"category":"制茶工艺链"},{"name":"炒青","des":"铁锅翻炒杀青之法，火候直接炒进茶里，香高味醇，明代散茶的技术心脏。","symbolSize":40,"category":"制茶工艺链"},{"name":"揉捻","des":"揉搓使叶卷曲成形并破坏细胞，茶汁附着叶表，冲泡时滋味由此倾出。","symbolSize":40,"category":"制茶工艺链"},{"name":"闷黄","des":"趁热堆闷，湿热中叶内物质缓缓转化，黄汤黄叶由此而生，黄茶独门。","symbolSize":40,"category":"制茶工艺链"},{"name":"渥堆","des":"洒水堆置，借微生物与湿热之力速成陈味，汤色转红、滋味转醇，黑茶之钥。","symbolSize":50,"category":"制茶工艺链"},{"name":"干燥","des":"以烘焙蒸发余水、固定品质与香气，茶的样子在最后一炉火上定音。","symbolSize":40,"category":"制茶工艺链"},{"name":"焙火","des":"炭火慢焙提香增醇，文火出清雅、武火出醇厚，岩茶风骨由此炼成。","symbolSize":40,"category":"制茶工艺链"},{"name":"窨制","des":"鲜花与茶坯层层相叠，茶吸花香、花增茶味，一吐一吸间的合香之术。","symbolSize":40,"category":"制茶工艺链"},{"name":"蒸压成型","des":"蒸汽回软茶叶紧压为饼为砖，缩体防潮以便远运，边销茶的古老智慧。","symbolSize":40,"category":"制茶工艺链"},{"name":"西湖龙井","des":"杭州狮峰、龙井群山所出扁形绿茶，色翠香郁味甘形美四绝，绿茶魁首。","symbolSize":40,"category":"产区与名茶"},{"name":"碧螺春","des":"苏州洞庭东西山所产螺形嫩绿茶，一嫩三鲜，茶果间作养出满身花果香。","symbolSize":40,"category":"产区与名茶"},{"name":"黄山毛峰","des":"黄山高峰云雾间所出，形似雀舌、鱼叶金黄，名山与名茶相得益彰。","symbolSize":40,"category":"产区与名茶"},{"name":"六安瓜片","des":"皖西大别山片茶，唯一无芽无梗、单取叶片制成的绿茶，拉老火见真功。","symbolSize":40,"category":"产区与名茶"},{"name":"安吉白茶","des":"名为白茶实为绿茶，白化新品种春芽玉白，高氨低酚，鲜爽近于鸡汤。","symbolSize":40,"category":"产区与名茶"},{"name":"白毫银针","des":"福鼎太姥山单芽制成，满披白毫如银似雪，汤色杏黄，白茶中之王者。","symbolSize":40,"category":"产区与名茶"},{"name":"君山银针","des":"洞庭湖君山岛所出黄茶芽尖，芽头肥壮、金镶玉，冲泡时三起三落。","symbolSize":40,"category":"产区与名茶"},{"name":"武夷岩茶","des":"武夷山丹霞岩谷间的乌龙茶，岩骨花香，讲究山场与火功的茶中名门。","symbolSize":50,"category":"产区与名茶"},{"name":"大红袍","des":"自九龙窠崖壁母树繁衍而来的名丛，岩茶之王，焦糖香与岩韵的代名词。","symbolSize":40,"category":"产区与名茶"},{"name":"安溪铁观音","des":"闽南乌龙名品，美如观音重如铁，兰花香与观音韵，七泡犹有余香。","symbolSize":40,"category":"产区与名茶"},{"name":"凤凰单丛","des":"潮州凤凰山乌龙，一树一香、单株采制，蜜兰黄栀诸香竞秀，宋种犹存。","symbolSize":40,"category":"产区与名茶"},{"name":"正山小种","des":"武夷桐木关所出，世界红茶鼻祖，松烟香、桂圆汤，曾风靡英伦宫廷。","symbolSize":40,"category":"产区与名茶"},{"name":"祁门红茶","des":"安徽祁门所产工夫红茶，似花似果似蜜的祁门香，世界三大高香之一。","symbolSize":40,"category":"产区与名茶"},{"name":"滇红","des":"云南大叶种所制红茶，金毫显露、滋味浓强鲜爽，冬日里自有满盏暖意。","symbolSize":40,"category":"产区与名茶"},{"name":"云南普洱","des":"澜沧江畔的云南大叶茶，生熟分途、越陈越香，一饼好茶足以传世。","symbolSize":50,"category":"产区与名茶"},{"name":"茉莉花茶","des":"茶引花香、花增茶味，以福州窨制技艺为正宗，是老北京钟爱的香片。","symbolSize":40,"category":"产区与名茶"},{"name":"审评","des":"以外形、汤色、香气、滋味、叶底五因子评茶论级，把口感折成分数。","symbolSize":50,"category":"品鉴与风味"},{"name":"鲜爽","des":"氨基酸带来的鲜灵口感，如初春鸡汤般的清鲜，春茶与名优绿茶的本色。","symbolSize":40,"category":"品鉴与风味"},{"name":"岩韵","des":"武夷岩茶的落骨之感，香中有骨、咽后留韵，只可意会的风味印记。","symbolSize":40,"category":"品鉴与风味"},{"name":"山场","des":"微观风土之名：坑涧阴阳、岩土厚薄，同一香型因山场而身价迥异。","symbolSize":40,"category":"品鉴与风味"},{"name":"高山云雾","des":"高山漫射光足、昼夜温差大，氨基酸得以累积，云雾出好茶其理在此。","symbolSize":40,"category":"品鉴与风味"},{"name":"明前","des":"清明之前采制的头拨嫩芽，芽叶初萌而量少，明前茶贵如金的时令之约。","symbolSize":40,"category":"品鉴与风味"},{"name":"兰花香","des":"茶香中的清雅上品，幽长如空谷之兰，铁观音与凤凰单丛皆以此争胜。","symbolSize":40,"category":"品鉴与风味"},{"name":"陈化","des":"成茶在岁月中缓慢氧化、滋味重构的过程，仓储由此成为第二重工艺。","symbolSize":50,"category":"品鉴与风味"},{"name":"回甘","des":"苦味化开后喉间徐徐泛起的甘甜，先苦后甜，好茶滋味的深层结构。","symbolSize":40,"category":"品鉴与风味"},{"name":"生津","des":"茶汤咽下后舌面涌出津液，如泉徐来，两颊鸣泉、舌底鸣泉皆谓此。","symbolSize":40,"category":"品鉴与风味"},{"name":"喉韵","des":"茶汤过喉之后的甘润与回味，深而持久，是掂量茶底厚薄的一把尺。","symbolSize":40,"category":"品鉴与风味"},{"name":"紫砂壶","des":"宜兴黄龙山泥料所制双气孔陶壶，透气蓄香，伺茶养壶，壶随人老。","symbolSize":50,"category":"器具与冲泡"},{"name":"盖碗","des":"一盖一碗一托，观色、闻香、啜饮三用兼具，号称三才合一的万能茶器。","symbolSize":40,"category":"器具与冲泡"},{"name":"建盏","des":"建阳窑黑釉茶盏，兔毫油滴垂釉流纹，黑釉衬雪白，宋人斗茶至爱。","symbolSize":40,"category":"器具与冲泡"},{"name":"公道杯","des":"茶汤先入此杯再分入各盏，浓淡均一不偏不倚，公平之名由此而得。","symbolSize":40,"category":"器具与冲泡"},{"name":"闻香杯","des":"细高的聚香之杯，茶汤先过此杯再入品杯，幽香拢于鼻端细细分辨。","symbolSize":40,"category":"器具与冲泡"},{"name":"水温","des":"嫩茶怕烫、老茶嫌温，八十度至一百度的分寸，全看茶性脸色行事。","symbolSize":40,"category":"器具与冲泡"},{"name":"出汤","des":"注水之后倒出茶汤的时机，快一秒则薄、迟一秒则苦，分寸在毫厘。","symbolSize":40,"category":"器具与冲泡"},{"name":"功夫茶","des":"潮汕闽南的冲泡法度：小壶小杯、高冲低斟，把饮茶过成完整仪式。","symbolSize":50,"category":"器具与冲泡"},{"name":"煮茶","des":"茶入壶中直接烹煮，取其浓烈温暖，黑茶老茶尤宜，边地奶茶同其风。","symbolSize":40,"category":"器具与冲泡"},{"name":"择水","des":"水为茶之母：山水上、江水中、井水下，选好水是好茶的一半功课。","symbolSize":40,"category":"器具与冲泡"},{"name":"茶仓","des":"藏茶之所：温度、湿度、避光、隔味四事，仓的好坏写进茶的陈化。","symbolSize":40,"category":"器具与冲泡"}],"links":[{"source":"茶树原产地","target":"茶学","name":"溯源","des":"茶自滇藏交界的原始丛林一路走来，化草木为文明。"},{"source":"神农尝茶","target":"茶学","name":"传说","des":"神农得荼解毒的传说，为茶进入人间写下开头。"},{"source":"陆羽","target":"茶经","name":"著述","des":"隐居苕溪著成三卷十章，一人定千秋茶事。"},{"source":"茶经","target":"茶学","name":"奠基","des":"世界第一部茶学专著出世，茶自此有学可循。"},{"source":"陆羽","target":"煎茶法","name":"定型","des":"定二十四器、辨三沸之水，唐代煎饮由此成法。"},{"source":"卢仝","target":"茶学","name":"咏茶","des":"七碗茶歌把茶饮写到乘风欲仙，诗与茶相互成全。"},{"source":"卢仝","target":"陆羽","name":"嗣响","des":"茶圣立说于前，茶仙咏叹于后，唐代茶事双璧。"},{"source":"煎茶法","target":"点茶","name":"演化","des":"唐煎宋点，研末入盏代替投末入锅，风气随世而移。"},{"source":"点茶","target":"斗茶","name":"支撑","des":"斗茶以点茶比高下，汤花咬盏是胜负手筋。"},{"source":"茶百戏","target":"点茶","name":"衍生","des":"分茶使汤面幻化丹青，点茶技艺的极致余绪。"},{"source":"建盏","target":"斗茶","name":"应运","des":"黑釉衬得雪白汤花，斗茶之风养出建盏名窑。"},{"source":"荣西","target":"点茶","name":"承习","des":"入宋习禅，携茶种与点茶法东归日本。"},{"source":"径山茶宴","target":"荣西","name":"启蒙","des":"日僧多于径山求法，茶宴仪轨随禅东渡。"},{"source":"径山茶宴","target":"点茶","name":"行茶","des":"茶宴以点茶待客，仪式与茶汤一同输出。"},{"source":"荣西","target":"茶学","name":"东传","des":"《吃茶养生记》开日本茶道之先声。"},{"source":"茶马古道","target":"茶学","name":"传播","des":"以茶易马千年不绝，茶随马蹄进入雪域高原。"},{"source":"茶路西行","target":"茶学","name":"西渐","des":"万里茶道与海上茶船，把东方树叶送进欧洲茶杯。"},{"source":"明代散茶","target":"点茶","name":"取代","des":"罢造龙团改贡叶茶，碾末之饮让位于瀹泡。"},{"source":"神农尝茶","target":"茶经","name":"载于","des":"“茶之为饮，发乎神农氏”，开篇即引此传说。"},{"source":"茶马古道","target":"黑茶","name":"边销","des":"紧压砖茶耐储好运，经古道源源输往藏区。"},{"source":"云南普洱","target":"茶马古道","name":"驮运","des":"普洱府因茶而设，贡茶与边销皆自此启程。"},{"source":"茶树原产地","target":"云南普洱","name":"同源","des":"澜沧江流域的古茶树，是普洱茶最老的家底。"},{"source":"茶树原产地","target":"滇红","name":"同源","des":"云南大叶种自原生林走来，成就浓强的滇红。"},{"source":"祁门红茶","target":"茶路西行","name":"远销","des":"祁门香一度是欧洲下午茶的宠儿。"},{"source":"正山小种","target":"茶路西行","name":"远销","des":"松烟香的小种经海路风行英伦，调出下午茶。"},{"source":"煮茶","target":"煎茶法","name":"遗风","des":"今日围炉煮茶，犹是唐宋煮饮的余温。"},{"source":"红茶","target":"茶路西行","name":"风行","des":"红汤香甜合欧洲口味，外销自此以红茶为主。"},{"source":"茶经","target":"择水","name":"品第","des":"山水上江水中井下，五之煮定下千年水评。"},{"source":"炒青","target":"明代散茶","name":"支撑","des":"锅炒出香使散茶立得住，改制的技艺前提。"},{"source":"斗茶","target":"审评","name":"先声","des":"宋人较汤色水痕，堪称最早的感官审评。"},{"source":"茶马古道","target":"蒸压成型","name":"驱动","des":"砖饼缩体防潮，正是为长途驮运而生。"},{"source":"茶百戏","target":"斗茶","name":"同场","des":"分茶之技常在斗茶席上一并献演。"},{"source":"绿茶","target":"发酵程度","name":"不发酵","des":"杀青即止氧化，青翠在锅温中定格。"},{"source":"白茶","target":"发酵程度","name":"微发酵","des":"不炒不揉只经萎凋，氧化浅尝辄止。"},{"source":"黄茶","target":"发酵程度","name":"轻发酵","des":"闷黄促成轻转化，滋味向甘醇靠拢。"},{"source":"乌龙茶","target":"发酵程度","name":"半发酵","des":"做青摇晾之间，氧化停在青红交界。"},{"source":"红茶","target":"发酵程度","name":"全发酵","des":"酶促氧化充分进行，红汤红叶定型。"},{"source":"黑茶","target":"发酵程度","name":"后发酵","des":"渥堆之后仍借微生物缓慢接力转化。"},{"source":"陈椽","target":"茶学","name":"分类","des":"以发酵程度为纲，六大茶类分类法一锤定音。"},{"source":"茶多酚","target":"酶促氧化","name":"底物","des":"儿茶素等待氧化，发酵的戏份全由它担纲。"},{"source":"酶促氧化","target":"发酵程度","name":"机理","des":"发酵一词的化学本体，一切谱系的幕后。"},{"source":"发酵程度","target":"茶学","name":"主轴","des":"一条从零到全的隐形轴，串起六大茶类。"},{"source":"做青","target":"绿叶红镶边","name":"造就","des":"叶缘碰撞氧化变红，叶心犹青，印记分明。"},{"source":"绿叶红镶边","target":"乌龙茶","name":"印记","des":"看叶底如验明正身，半发酵的身份证。"},{"source":"杀青","target":"酶促氧化","name":"阻断","des":"高温钝化氧化酶，青翠与鲜爽得以保全。"},{"source":"酶促氧化","target":"红茶","name":"炼成","des":"儿茶素转为茶黄素茶红素，红汤由此而来。"},{"source":"发酵程度","target":"陈化","name":"延伸","des":"发酵止于初制，转化却可在岁月里续写。"},{"source":"采青","target":"萎凋","name":"入制","des":"鲜叶离树，先在摊放中交出水分。"},{"source":"萎凋","target":"做青","name":"铺垫","des":"适度失水叶质变软，摇青方经得起碰撞。"},{"source":"做青","target":"乌龙茶","name":"定型","des":"摇出香气晾出韵味，乌龙风骨由此养成。"},{"source":"杀青","target":"绿茶","name":"定青","des":"一锅高温锁住翠色，绿茶的命门工序。"},{"source":"炒青","target":"杀青","name":"隶属","des":"锅炒是杀青主流之法，火候即风味。"},{"source":"杀青","target":"揉捻","name":"接续","des":"杀青定色之后，揉捻随即塑形出汁。"},{"source":"揉捻","target":"干燥","name":"衔接","des":"成形之后进烘焙，水分退场品质定型。"},{"source":"闷黄","target":"黄茶","name":"专属","des":"一道闷黄，改写了绿茶的色谱与滋味。"},{"source":"闷黄","target":"君山银针","name":"塑造","des":"金镶玉的芽头与三起三落，皆从闷黄来。"},{"source":"渥堆","target":"黑茶","name":"点睛","des":"湿热与菌酵同工，速成黑茶的醇厚陈韵。"},{"source":"萎凋","target":"白茶","name":"独任","des":"不炒不揉全凭萎凋，日晒就是全部工艺。"},{"source":"萎凋","target":"红茶","name":"铺陈","des":"充分萎凋为发酵备好底物，甜香自此萌发。"},{"source":"干燥","target":"窨制","name":"备坯","des":"茶坯须干透才吸得进花香，先焙后窨。"},{"source":"焙火","target":"乌龙茶","name":"提香","des":"文火慢炖出熟香，岩骨与音韵借火而成。"},{"source":"焙火","target":"武夷岩茶","name":"火功","des":"火功轻重分出清香与足火，岩茶的第二命。"},{"source":"窨制","target":"茉莉花茶","name":"产出","des":"三窨一提甚至九窨，花香入骨方成香片。"},{"source":"蒸压成型","target":"云南普洱","name":"成饼","des":"蒸软紧压为七子饼，圆茶自此可以远行。"},{"source":"蒸压成型","target":"黑茶","name":"成砖","des":"茯砖青砖由此而出，金花亦生于砖内。"},{"source":"明前","target":"采青","name":"时令","des":"清明前头拨芽叶，采茶人争的就是这几天。"},{"source":"渥堆","target":"陈化","name":"速成","des":"渥堆以数十天追出岁月味，是陈化的快进键。"},{"source":"六安瓜片","target":"采青","name":"独法","des":"扳片去芽去梗，单取叶片，采法独树一帜。"},{"source":"正山小种","target":"焙火","name":"熏焙","des":"过红锅后松柴明火熏焙，松烟香由此入骨。"},{"source":"西湖龙井","target":"绿茶","name":"归属","des":"狮峰龙井色翠香郁，扁炒青的巅峰之作。"},{"source":"碧螺春","target":"绿茶","name":"归属","des":"洞庭东西山螺形嫩茶，花果香源自间作。"},{"source":"黄山毛峰","target":"绿茶","name":"归属","des":"高山云雾所出毛峰，形似雀舌绿泛象牙。"},{"source":"六安瓜片","target":"绿茶","name":"归属","des":"无芽无梗单片成茶，绿茶中的独行侠。"},{"source":"安吉白茶","target":"绿茶","name":"名实","des":"名字带白却是绿茶，白化品种的美丽误会。"},{"source":"白毫银针","target":"白茶","name":"归属","des":"福鼎太姥山单芽白茶，满披白毫如银。"},{"source":"君山银针","target":"黄茶","name":"归属","des":"洞庭君山金镶玉，黄茶芽茶的极致代表。"},{"source":"武夷岩茶","target":"乌龙茶","name":"归属","des":"闽北乌龙重水求韵，岩骨花香的门派。"},{"source":"大红袍","target":"武夷岩茶","name":"归属","des":"九龙窠母树的名丛，岩茶之王的血统。"},{"source":"安溪铁观音","target":"乌龙茶","name":"归属","des":"闽南乌龙代表，兰花香七泡有余。"},{"source":"凤凰单丛","target":"乌龙茶","name":"归属","des":"潮州乌龙一树一香，单株采制的极致。"},{"source":"正山小种","target":"红茶","name":"鼻祖","des":"桐木关红茶之源，世界红茶自它起步。"},{"source":"祁门红茶","target":"红茶","name":"归属","des":"祁门香高鲜甜，世界三大高香红茶。"},{"source":"滇红","target":"红茶","name":"归属","des":"大叶种金毫浓强，滇红以力度见长。"},{"source":"云南普洱","target":"黑茶","name":"归属","des":"熟普经渥堆归入黑茶，生普归属尚有争鸣。"},{"source":"西湖龙井","target":"明前","name":"抢鲜","des":"明前龙井贵如金，一年一等的等待。"},{"source":"武夷岩茶","target":"岩韵","name":"独有","des":"岩骨花香入口方知，岩茶独占的风味词。"},{"source":"武夷岩茶","target":"山场","name":"讲究","des":"三坑两涧各擅其胜，同岩不同场价悬殊。"},{"source":"凤凰单丛","target":"山场","name":"看山","des":"乌岽高山老丛难得，山头即身价的通行证。"},{"source":"安溪铁观音","target":"兰花香","name":"标志","des":"观音韵以兰花香为旗，幽长而清正。"},{"source":"凤凰单丛","target":"兰花香","name":"香型","des":"蜜兰香单丛兰香带蜜，香型谱系之首。"},{"source":"安吉白茶","target":"鲜爽","name":"印证","des":"高氨低酚的品种禀赋，鲜爽度冠绝绿茶。"},{"source":"云南普洱","target":"陈化","name":"越陈","des":"生熟皆可陈放，越陈越香的价值主张。"},{"source":"黄山毛峰","target":"高山云雾","name":"产自","des":"黄山峰谷云雾滋养，名山出好茶的注脚。"},{"source":"白茶","target":"陈化","name":"经年","des":"一年茶三年药七年宝，白茶也讲陈放。"},{"source":"云南普洱","target":"茶仓","name":"依托","des":"干仓慢养湿仓速成，仓即是第二重工艺。"},{"source":"白毫银针","target":"萎凋","name":"全凭","des":"单芽全凭日光萎凋，毫香蜜韵不事雕琢。"},{"source":"审评","target":"茶学","name":"法度","des":"五因子评茶，把口感折成可较的分数。"},{"source":"山场","target":"岩韵","name":"孕育","des":"坑涧风土写进茶汤，方有落骨之韵。"},{"source":"高山云雾","target":"鲜爽","name":"滋养","des":"漫射光促氨基酸累积，高处茶更鲜。"},{"source":"回甘","target":"生津","name":"相伴","des":"甘自苦回，津随甘生，如泉徐来舌底。"},{"source":"回甘","target":"喉韵","name":"递进","des":"甘意再往深处走，便成喉间的余韵。"},{"source":"茶多酚","target":"回甘","name":"伏笔","des":"先涩后甘的曲线，是儿茶素埋的伏笔。"},{"source":"茶仓","target":"陈化","name":"承载","des":"温湿光气四事，全由茶仓一手掌管。"},{"source":"绿茶","target":"鲜爽","name":"本色","des":"杀青保住茶氨酸，鲜爽是绿茶的底色。"},{"source":"出汤","target":"回甘","name":"左右","des":"迟一秒苦涩压场，回甘生津皆失其所。"},{"source":"闻香杯","target":"兰花香","name":"聚香","des":"细杯拢香于鼻端，幽香无所遁形。"},{"source":"紫砂壶","target":"乌龙茶","name":"宜泡","des":"双气孔透气蓄香，乌龙重汤尤宜砂壶。"},{"source":"紫砂壶","target":"功夫茶","name":"器具","des":"小壶聚香蓄韵，功夫茶席上的主角。"},{"source":"盖碗","target":"功夫茶","name":"器具","des":"掀盖闻香刮沫啜饮，一碗走遍六大茶类。"},{"source":"盖碗","target":"审评","name":"标准","des":"白瓷盖碗不偏不倚，审评席的标准器。"},{"source":"公道杯","target":"功夫茶","name":"匀汤","des":"先入公道再分盏，一席茶浓淡如一。"},{"source":"闻香杯","target":"功夫茶","name":"闻香","des":"高杯拢香低杯品汤，闽南茶席的搭配。"},{"source":"水温","target":"绿茶","name":"宜凉","des":"八十度上下温柔以待，嫩芽经不起滚烫。"},{"source":"水温","target":"出汤","name":"节拍","des":"温度定快慢，汤色浓淡随之起落。"},{"source":"功夫茶","target":"出汤","name":"讲究","des":"高冲低斟快出汤，快慢之间见真章。"},{"source":"功夫茶","target":"乌龙茶","name":"相伴","des":"乌龙香高韵厚，催出这一套小巧功夫。"},{"source":"功夫茶","target":"水温","name":"沸水","des":"非沸水不足以发乌龙之香，高冲激香。"},{"source":"煮茶","target":"黑茶","name":"宜煮","des":"老黑茶烹煮更醇厚，边地奶茶同其源。"},{"source":"明代散茶","target":"紫砂壶","name":"催生","des":"瀹泡散茶兴起，壶与盏随之改朝换代。"},{"source":"明代散茶","target":"功夫茶","name":"源起","des":"散茶瀹泡向下深耕，便是后来的功夫茶。"},{"source":"建盏","target":"点茶","name":"绝配","des":"兔毫盏衬雪白汤花，点茶家什以此为上。"},{"source":"水温","target":"云南普洱","name":"宜沸","des":"熟普老茶非沸水不能尽其味，且经得起煮。"}],"title":"茶学","description":"一叶落水六色分：自陆羽《茶经》的煎炉到功夫茶的杯盏，六大茶类的谱系全景。"}