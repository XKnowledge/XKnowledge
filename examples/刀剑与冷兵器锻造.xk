{"version":2,"title":"刀剑与冷兵器锻造","description":"炉火、铁砧与淬刃的战争艺术：从越王勾践剑的硫化处理到日本刀的玉钢折叠，从乌兹钢的大马士革纹到索林根与托莱多的行会较量——人类把最好的 metallurgy 都先给了武器。","nodes":[{"name":"刀剑与冷兵器锻造","des":"以锻打、淬火、研磨把铁钢做成刃器的完整技艺体系。火药之前，刀剑是技术的顶点；火药之后，它成了手艺的庇护所。","symbolSize":70,"category":"锻打之基"},{"name":"块炼铁","des":"低温固态还原得到的疏松铁块，需反复锻打挤渣致密——一切锻造文明的起点原料。","symbolSize":40,"category":"锻打之基"},{"name":"折叠锻打","des":"加热折叠、层层叠打以匀化成分去除夹杂，钢材的千层饼工艺，花纹的来源之一。","symbolSize":50,"category":"锻打之基"},{"name":"百炼钢","des":"汉代的多次加热锻打工艺，「百炼」言其反复之极，曹操的百炼宝刀自铭其数。","symbolSize":40,"category":"锻打之基"},{"name":"灌钢法","des":"把生铁灌入熟铁合炼的南北朝工艺，液体渗碳一步到位的古代智造。","symbolSize":40,"category":"锻打之基"},{"name":"局部淬火","des":"只淬刃口不淬刀身，硬刃软脊的复合性能设计，东西方共同的答案。","symbolSize":50,"category":"锻打之基"},{"name":"覆土烧刃","des":"以耐火泥覆盖刀身、裸露刃口淬火的控温技法，日本刀刃文的直接成因。","symbolSize":40,"category":"锻打之基"},{"name":"夹钢与贴钢","des":"软体包硬芯或硬面贴软体的复合材料学，中国农刃与刀具的实用路线。","symbolSize":40,"category":"锻打之基"},{"name":"硬度与韧性","des":"刃要硬到不卷口，身要韧到不断折——锻造的全部秘密就是这道平衡题。","symbolSize":50,"category":"锻打之基"},{"name":"刃口几何","des":"开刃角度与断面形状决定切割性能，斧刃凿刃剃刃各有角度的力学。","symbolSize":40,"category":"锻打之基"},{"name":"青铜剑时代","des":"高锡青铜铸剑的先秦时代，青铜的良好铸造性成就了中国最早的剑文化。","symbolSize":40,"category":"中国刀剑"},{"name":"越王勾践剑","des":"1965 年江陵望山出土的千年不锈青铜剑，菱形暗格纹与硫化处理至今成谜。","symbolSize":50,"category":"中国刀剑"},{"name":"复合青铜剑","des":"刃部高锡硬、脊部低锡韧的复合铸造工艺，战国吴越铸剑师的力学答案。","symbolSize":40,"category":"中国刀剑"},{"name":"秦剑","des":"兵马俑出土的八十一厘米长青铜剑，铬盐氧化处理的争议悬案。","symbolSize":40,"category":"中国刀剑"},{"name":"汉环首刀","des":"直刃单边、环首缠缑的长刀，取代长剑成为骑兵主战兵器，百炼钢的载体。","symbolSize":50,"category":"中国刀剑"},{"name":"唐刀","des":"覆土烧刃加夹钢的唐横刀，形制直接影响日本刀的母本，至今实物稀见。","symbolSize":40,"category":"中国刀剑"},{"name":"宋手刀与明雁翎","des":"宋代手刀的宽头实用主义到明代雁翎柳叶的边军体系，刀随战阵演化。","symbolSize":40,"category":"中国刀剑"},{"name":"龙泉宝剑","des":"浙江龙泉的铸剑传统，欧冶子龙渊剑的传说起点，今日非遗的产业样本。","symbolSize":40,"category":"中国刀剑"},{"name":"欧冶子","des":"春秋铸剑大师，湛卢龙渊泰阿皆出其手的传说人物，铸剑师的祖师爷。","symbolSize":40,"category":"中国刀剑"},{"name":"干将莫邪","des":"投身鼓炉铸剑的传说夫妇，吴越金铁之精的神话记忆，人剑合一的原型叙事。","symbolSize":40,"category":"中国刀剑"},{"name":"日本刀","des":"从平安末期定型的弯刀体系：玉钢为材、折返锻为骨、刃文为容、研磨为装——世界刀剑史上工序分工最细的锻造传统。","symbolSize":50,"category":"日本刀"},{"name":"玉钢","des":"踏鞴炼砂土法炼出的不均质钢块，含碳高低不一反而给了刀匠挑选空间，日本刀的材料之魂。","symbolSize":50,"category":"日本刀"},{"name":"踏鞴制铁","des":"连烧三昼夜的砂铁冶炼炉，一次开炉出钢数吨，传统 tatara 的 seasonal 仪式。","symbolSize":40,"category":"日本刀"},{"name":"折返锻","des":"玉钢反复折叠锻打十数层到数万层，碳分匀化与层理花纹同时完成。","symbolSize":40,"category":"日本刀"},{"name":"心皮结构","des":"软钢为心、硬钢为皮的组合锻造，断而不折的性能设计核心。","symbolSize":40,"category":"日本刀"},{"name":"刃文","des":"淬火时刃口形成的马氏体白色纹路，直刃与乱刃的美术馆，鉴赏日本刀的第一入口。","symbolSize":50,"category":"日本刀"},{"name":"地铁与地肌","des":"刀身本体的锻层肌理与折返纹，行家看地肌就能读出锻工的手法谱系。","symbolSize":40,"category":"日本刀"},{"name":"太刀与打刀","des":"马上的太刀与步战的打刀，佩挂方式与弧度各异的两大形制。","symbolSize":40,"category":"日本刀"},{"name":"胁差与短刀","des":"成对佩携的近身刀与贴身短刀，武士的双刃配置。","symbolSize":40,"category":"日本刀"},{"name":"三条宗近","des":"平安末期刀工，京都三条派的鼻祖，名物三日月宗近的作者。","symbolSize":40,"category":"日本刀"},{"name":"正宗","des":"镰仓末期相州刀工，地刃俱佳的标杆，「正宗」成为良刀代名词，其末裔流派遍布全国。","symbolSize":40,"category":"日本刀"},{"name":"村正","des":"伊势桑名刀工一族，德川家的克星传说让「妖刀」之名流传四百年。","symbolSize":40,"category":"日本刀"},{"name":"菊一文字则宗","des":"福冈一文字派的巅峰刀工，后鸟羽天皇菊纹御剑传说的主角。","symbolSize":40,"category":"日本刀"},{"name":"押形与茎","des":"刀工在茎（ Nakago）上铭刻的签名与鑢目锉痕，鉴定真伪的档案库。","symbolSize":40,"category":"日本刀"},{"name":"拵","des":"刀装的总称：鞘、柄、镡、小道具的整套外壳，与刀身并立的独立工艺体系。","symbolSize":40,"category":"日本刀"},{"name":"镡","des":"护手上的小铁画，铭家的山水花鸟方寸可鉴，独立成收藏门类。","symbolSize":40,"category":"日本刀"},{"name":"研师","des":"以十余种磨石逐级研磨的技师，好刀要研师唤醒，上研一次可达数月。","symbolSize":40,"category":"日本刀"},{"name":"乌兹钢","des":"印度海得拉巴坩埚炼出的高碳钢锭，内生碳化物纹理，真大马士革钢的唯一起源。","symbolSize":50,"category":"大马士革与花纹钢"},{"name":"大马士革刀","des":"以乌兹钢锻造的波斯弯刀 Shamshir，水纹如流、锋口自锐的传奇刀种。","symbolSize":50,"category":"大马士革与花纹钢"},{"name":"花纹焊接","des":"不同钢材叠焊扭锻出纹样的欧洲技术，维京剑与马来剑的共同语法，与乌兹钢殊途同归。","symbolSize":40,"category":"大马士革与花纹钢"},{"name":"乌兹失传","des":"十九世纪印度矿源枯竭加英殖铁器工业化，坩埚配方与纹路之谜至今未能完全复现。","symbolSize":40,"category":"大马士革与花纹钢"},{"name":"马来克里斯","des":"以陨铁与层叠锻打著称的波浪刃短剑，灵刃信仰与帕莫纹的双遗产。","symbolSize":40,"category":"大马士革与花纹钢"},{"name":"维京剑","des":"花纹焊接的青铜柄铁剑，乌尔夫贝特（Ulfberht）签名的高碳钢剑是那个时代的高科技。","symbolSize":40,"category":"大马士革与花纹钢"},{"name":"乌尔夫贝特剑","des":"剑身铭刻 +VLFBERH+ 的坩埚钢剑，比周边剑材领先一个技术代际的谜之品牌。","symbolSize":40,"category":"大马士革与花纹钢"},{"name":"奥克肖特类型学","des":"以剑形演变分型的现代体系，把中世纪欧洲剑排成谱系的度量衡。","symbolSize":40,"category":"欧洲行会"},{"name":"托莱多","des":"西班牙古城的兵器锻造传统，以炼钢与剑术双重闻名，欧洲刀剑的金字招牌之一。","symbolSize":40,"category":"欧洲行会"},{"name":"索林根","des":"德国的刀城，中世纪行会管束下的剪刀刀具刀剑产业，今日仍是双立人与博克的产地。","symbolSize":40,"category":"欧洲行会"},{"name":"帕绍狼印","des":"以狼形城印作为钢材质量标志的早期品牌实践，被索林根厂商竞相借用。","symbolSize":40,"category":"欧洲行会"},{"name":"剑术手册","des":"德意剑术大师留下的 Fechtbuch 图谱手册，利希特瑙尔传统把剑术变成可传承的知识体系。","symbolSize":40,"category":"欧洲行会"},{"name":"行会制度","des":"学徒帮工师傅的晋升阶梯与同业规范，欧洲匠作的质量控制与社会组织。","symbolSize":50,"category":"欧洲行会"},{"name":"火器冲击","des":"枪炮让刀剑退出战场主战序列，但也让锻造技艺转入和平领域与身份符号。","symbolSize":40,"category":"现代锻造"},{"name":"武士刀热","des":"战后欧美收藏热与今日美术刀剑市场，日本重要刀剑全部登录在册的文化财产制度。","symbolSize":40,"category":"现代锻造"},{"name":"ABS锻刀师协会","des":"1972 年美国成立的锻刀师行会，以 master smith 考试制度延续手工锻造一脉。","symbolSize":40,"category":"现代锻造"},{"name":"现代粉末钢","des":"雾化粉末热等静压成型的超高性能钢材，手锻与工业的分野在分子层面拉开。","symbolSize":40,"category":"现代锻造"},{"name":"人间国宝","des":"日本重要无形文化财产保持者制度，刀匠宫入行平与研磨师的本阿弥家系在列。","symbolSize":40,"category":"现代锻造"},{"name":"龙泉刀剑产业","des":"从古装道具到健身剑的当代龙泉产业集群，非遗与市场的磨合样本。","symbolSize":40,"category":"现代锻造"}],"links":[{"source":"刀剑与冷兵器锻造","target":"块炼铁","name":"原料起点","des":"一切从海绵状的熟铁块开始。"},{"source":"刀剑与冷兵器锻造","target":"硬度与韧性","name":"核心命题","des":"锻造就是在两个极端间找平衡。"},{"source":"刀剑与冷兵器锻造","target":"局部淬火","name":"关键技法","des":"让刃与身各司其职的热处理。"},{"source":"块炼铁","target":"折叠锻打","name":"致密化","des":"折叠捶打挤出夹渣匀化碳分。"},{"source":"折叠锻打","target":"百炼钢","name":"中国命名","des":"反复锻打在汉代文献中的说法。"},{"source":"灌钢法","target":"百炼钢","name":"提速","des":"生熟合炼省去千锤百炼。"},{"source":"局部淬火","target":"覆土烧刃","name":"技法分支","des":"以敷泥精确控制淬火边界。"},{"source":"局部淬火","target":"硬度与韧性","name":"解答","des":"硬刃软脊就是这道题的经典解。"},{"source":"夹钢与贴钢","target":"硬度与韧性","name":"另一种解","des":"以结构组合代替热处理取衡。"},{"source":"覆土烧刃","target":"刃文","name":"造就","des":"泥线走向决定刃纹的模样。"},{"source":"刃口几何","target":"硬度与韧性","name":"补充","des":"角度设计与材料性能互为表里。"},{"source":"青铜剑时代","target":"越王勾践剑","name":"巅峰","des":"千年不锈的青铜剑王。"},{"source":"青铜剑时代","target":"复合青铜剑","name":"技术","des":"分铸复合铸出刚柔并济。"},{"source":"复合青铜剑","target":"硬度与韧性","name":"青铜版答案","des":"不同配比合金各管一端。"},{"source":"秦剑","target":"越王勾践剑","name":"续章","des":"更长的剑体与表面处理之谜。"},{"source":"汉环首刀","target":"百炼钢","name":"载体","des":"三十炼五十炼的铭文自证。"},{"source":"汉环首刀","target":"唐刀","name":"演化","des":"直刃长刀形制的进一步成熟。"},{"source":"唐刀","target":"覆土烧刃","name":"工艺","des":"唐横刀已用敷土淬刃技法。"},{"source":"唐刀","target":"日本刀","name":"东传","des":"唐大刀是日本刀的直系祖先。"},{"source":"宋手刀与明雁翎","target":"汉环首刀","name":"后裔","des":"战阵需求让刀形变宽变曲。"},{"source":"欧冶子","target":"龙泉宝剑","name":"祖庭","des":"龙渊剑传说奠定龙泉谱系。"},{"source":"干将莫邪","target":"欧冶子","name":"同时代传说","des":"吴越铸剑群的神话记忆。"},{"source":"龙泉宝剑","target":"龙泉刀剑产业","name":"当代延续","des":"传说技艺的产业化转身。"},{"source":"踏鞴制铁","target":"玉钢","name":"产出","des":"三昼夜炉火炼出的钢块。"},{"source":"玉钢","target":"折返锻","name":"加工","des":"选料后反复折叠锻打。"},{"source":"折返锻","target":"心皮结构","name":"组合","des":"软硬钢料各就各位。"},{"source":"折返锻","target":"地铁与地肌","name":"留下痕迹","des":"层理肌理是锻打的年轮。"},{"source":"心皮结构","target":"覆土烧刃","name":"最后一步","des":"覆土入水，刃纹现形。"},{"source":"覆土烧刃","target":"刃文","name":"成就","des":"马氏体白线与 pearlite 底色的分界画。"},{"source":"太刀与打刀","target":"胁差与短刀","name":"配套","des":"大小二本差的佩携制度。"},{"source":"三条宗近","target":"正宗","name":"先声","des":"京物到相州传的谱系接力。"},{"source":"正宗","target":"村正","name":"对照","des":"正宗的美名与村正的妖名。"},{"source":"菊一文字则宗","target":"三条宗近","name":"并称","des":"平安镰仓名工的双璧传说。"},{"source":"押形与茎","target":"正宗","name":"铭证","des":"茎铭是鉴定流派的第一证据。"},{"source":"拵","target":"镡","name":"部件","des":"镡是刀装里的小宇宙。"},{"source":"研师","target":"刃文","name":"显影","des":"没有研磨刃文只是潜在的美。"},{"source":"研师","target":"地铁与地肌","name":"打磨","des":"逐级磨石唤醒地肌光泽。"},{"source":"乌兹钢","target":"大马士革刀","name":"锻成","des":"波斯工匠把钢锭打成弯刀。"},{"source":"乌兹钢","target":"乌兹失传","name":"断代","des":"矿源与配方在十九世纪中断。"},{"source":"花纹焊接","target":"大马士革刀","name":"同名异实","des":"焊接花纹常被误认作乌兹钢。"},{"source":"花纹焊接","target":"维京剑","name":"应用","des":"北欧铁匠的叠焊绝活。"},{"source":"维京剑","target":"乌尔夫贝特剑","name":"旗舰","des":"进口坩埚钢的顶级签名款。"},{"source":"乌尔夫贝特剑","target":"乌兹钢","name":"疑似同源","des":"有研究认为其钢材来自东方坩埚钢。"},{"source":"马来克里斯","target":"花纹焊接","name":"同技法","des":"数百层锻焊出帕莫纹。"},{"source":"奥克肖特类型学","target":"行会制度","name":"研究工具","des":"现代学者为中世纪剑建的坐标系。"},{"source":"索林根","target":"行会制度","name":"生长于","des":"刀城的品质由行会规约背书。"},{"source":"托莱多","target":"索林根","name":"对垒","des":"南北两大刀剑名城的竞争。"},{"source":"索林根","target":"帕绍狼印","name":"借用商标","des":"狼印是中世纪的质量认证。"},{"source":"剑术手册","target":"奥克肖特类型学","name":"互证","des":"图谱与实物互相校对断代。"},{"source":"火器冲击","target":"武士刀热","name":"转型","des":"战场武器变成收藏与美术。"},{"source":"ABS锻刀师协会","target":"折叠锻打","name":"复兴","des":"美洲匠人重拾花纹锻打传统。"},{"source":"ABS锻刀师协会","target":"行会制度","name":"制度回声","des":"大师考试是行会阶梯的现代版。"},{"source":"现代粉末钢","target":"ABS锻刀师协会","name":"分野","des":"工业极致与手作传统两条路。"},{"source":"人间国宝","target":"研师","name":"护持","des":"国家制度保住研磨一脉。"},{"source":"人间国宝","target":"踏鞴制铁","name":"复活","des":"日刀保存会曾重启踏鞴炼钢。"},{"source":"火器冲击","target":"龙泉刀剑产业","name":"同路","des":"刀剑退出实战后各国的生计转型。"},{"source":"花纹焊接","target":"折叠锻打","name":"殊途同归","des":"叠焊扭锻与折返叠打同以层理成纹，欧亚两条花纹之路会师。"},{"source":"欧冶子","target":"青铜剑时代","name":"植根","des":"铸剑祖师的传说植根于吴越青铜铸剑的巅峰时代。"},{"source":"日本刀","target":"正宗","name":"名工","des":"相州正宗地刃俱佳，「正宗」二字自此即良刀代名词。"},{"source":"日本刀","target":"太刀与打刀","name":"形制","des":"马上太刀、步战打刀，弯刀体系的两大佩挂形制。"},{"source":"日本刀","target":"拵","name":"外壳","des":"鞘柄镡整套刀装，与刀身并立的独立工艺体系。"}]}