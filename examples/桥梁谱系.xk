{
  "version": 2,
  "title": "桥梁谱系",
  "description": "从一根倒木到一跨海峡：梁在担、拱在挤、索在拉——一部用力学写成的跨越史，每一次跨度纪录的翻倍，背后都是材料、基础与风的新答案。",
  "nodes": [
    { "name": "桥梁谱系", "des": "从一根倒木到一跨海峡：人类用梁、拱、索三种方式跨过水面，也跨过技术的代际。", "symbolSize": 70, "category": "桥梁谱系" },
    { "name": "梁桥家族", "des": "最古老的桥型：一根受弯的杆，从独木到钢箱梁，跨度靠材料一点点撑大。", "symbolSize": 50, "category": "梁桥家族" },
    { "name": "独木桥", "des": "倒下的树干横在溪上，最原始的桥，梁的直系祖先。", "symbolSize": 40, "category": "梁桥家族" },
    { "name": "梁的力学", "des": "受弯的杆件，弯矩图里写着跨度的极限，支座越多跨得越远。", "symbolSize": 40, "category": "梁桥家族" },
    { "name": "简支梁与连续梁", "des": "一跨一支还是通长连续，力的分配方式决定跨越的能力。", "symbolSize": 40, "category": "梁桥家族" },
    { "name": "悬臂梁", "des": "从两岸伸出的手臂，不用脚手架也能在深渊上空握手。", "symbolSize": 40, "category": "梁桥家族" },
    { "name": "桁架桥", "des": "三角形单元拼成的空心大梁，用最少的材料撑起最大的跨度。", "symbolSize": 40, "category": "梁桥家族" },
    { "name": "福斯桥", "des": "1890年苏格兰悬臂钢桁架，管状钢臂隔湾相扣，钢桥时代的宣言。", "symbolSize": 40, "category": "梁桥家族" },
    { "name": "魁北克桥", "des": "1907年垮塌、1916年落梁，惨烈学费换回世界最长悬臂。", "symbolSize": 40, "category": "梁桥家族" },
    { "name": "贝雷梁", "des": "战时拼装的标准化钢桁构件，一天就能架通一条河。", "symbolSize": 40, "category": "梁桥家族" },
    { "name": "连续刚构", "des": "墩梁固结的混凝土长龙，当代高架桥的标准姿态。", "symbolSize": 40, "category": "梁桥家族" },
    { "name": "拱桥千年", "des": "石头互相挤紧便永不松手：拱把桥面荷载变成沿拱轴的压力。", "symbolSize": 50, "category": "拱桥千年" },
    { "name": "拱的力学", "des": "压力线循拱轴而行，推力被桥台吃进两岸的大地。", "symbolSize": 40, "category": "拱桥千年" },
    { "name": "罗马拱", "des": "火山灰混凝土浇筑的半圆拱，罗马人修桥如修路。", "symbolSize": 40, "category": "拱桥千年" },
    { "name": "加尔桥", "des": "三层拱叠起的法国引水桥，两千年后仍在输水与步行。", "symbolSize": 40, "category": "拱桥千年" },
    { "name": "赵州桥", "des": "隋代李春的敞肩石拱，一千四百年仍在洨河上值班。", "symbolSize": 40, "category": "拱桥千年" },
    { "name": "卢沟桥", "des": "十一孔联拱石桥，狮子数不清，马可·波罗称世界无双。", "symbolSize": 40, "category": "拱桥千年" },
    { "name": "科尔布鲁克代尔铁桥", "des": "1779年铸铁拱跨过塞文河，工业革命架出的第一道铁虹。", "symbolSize": 40, "category": "拱桥千年" },
    { "name": "悉尼港大桥", "des": "1932年钢拱一跨503米，海港城市的钢铁拱门。", "symbolSize": 40, "category": "拱桥千年" },
    { "name": "混凝土拱", "des": "弗雷西内借拱桥试验新工艺，混凝土也能飞跃山谷。", "symbolSize": 40, "category": "拱桥千年" },
    { "name": "系杆拱", "des": "受拉系杆抵住拱脚推力，拱桥从此站上软弱地基。", "symbolSize": 40, "category": "拱桥千年" },
    { "name": "中国石拱谱系", "des": "从隋代敞肩到双曲拱，石拱的东方传统自成一脉。", "symbolSize": 40, "category": "拱桥千年" },
    { "name": "悬索桥", "des": "主缆垂成抛物线，把整跨的重量递给两岸锚碇：跨度之王。", "symbolSize": 50, "category": "悬索桥" },
    { "name": "藤索与溜索", "des": "安第斯草绳桥与峡谷溜索，以柔克刚的早期悬索。", "symbolSize": 40, "category": "悬索桥" },
    { "name": "泸定桥", "des": "1706年十三根铁链横跨大渡河，康熙朝的铁索悬桥。", "symbolSize": 40, "category": "悬索桥" },
    { "name": "悬索桥原理", "des": "主缆、吊索、加劲梁与锚碇四件套，拉力被大地化解。", "symbolSize": 40, "category": "悬索桥" },
    { "name": "布鲁克林大桥", "des": "罗布林一家三代的钢缆悬索，气压沉箱之下的家族代价。", "symbolSize": 40, "category": "悬索桥" },
    { "name": "金门大桥", "des": "1937年一跨1280米，国际橙的塔柱成了旧金山的地标。", "symbolSize": 40, "category": "悬索桥" },
    { "name": "塔科马海峡桥", "des": "1940年舞动的格蒂，八级风扭塌了刚度不足的桥面。", "symbolSize": 40, "category": "悬索桥" },
    { "name": "风洞必修课", "des": "塔科马之后，每座大桥动工前都要先在风洞里过一遍风。", "symbolSize": 40, "category": "悬索桥" },
    { "name": "明石海峡大桥", "des": "1998年一跨1991米，悬索跨度长达一代人的世界之最。", "symbolSize": 40, "category": "悬索桥" },
    { "name": "主缆施工", "des": "空中纺线一缕缕缠出主缆，或预制索股一段段整根提升。", "symbolSize": 40, "category": "悬索桥" },
    { "name": "杨泗港大桥", "des": "2019年1700米一跨过江不设中墩，中国悬索的新标高。", "symbolSize": 40, "category": "悬索桥" },
    { "name": "斜拉桥", "des": "从塔顶斜向拉住桥面，每根索都是主梁的弹性支点：后起之秀。", "symbolSize": 50, "category": "斜拉桥" },
    { "name": "斜拉的概念", "des": "斜索即是弹性的中间支座，梁被一根根吊着走。", "symbolSize": 40, "category": "斜拉桥" },
    { "name": "斯特伦松德桥", "des": "1955年瑞典的一座小桥，现代斜拉桥的公认起点。", "symbolSize": 40, "category": "斜拉桥" },
    { "name": "密索体系", "des": "斜索由稀到密，主梁越做越轻盈，悬臂拼装如搭积木。", "symbolSize": 40, "category": "斜拉桥" },
    { "name": "诺曼底桥", "des": "1995年主跨856米，斜拉桥首次逼近悬索桥的领地。", "symbolSize": 40, "category": "斜拉桥" },
    { "name": "多多罗大桥", "des": "1999年890米，濑户内海上的斜拉新纪录。", "symbolSize": 40, "category": "斜拉桥" },
    { "name": "苏通大桥", "des": "2008年主跨1088米，中国斜拉首次登顶世界。", "symbolSize": 40, "category": "斜拉桥" },
    { "name": "俄罗斯岛大桥", "des": "2012年1104米，海参崴为峰会赶出的短命纪录。", "symbolSize": 40, "category": "斜拉桥" },
    { "name": "常泰长江大桥", "des": "2025年主跨1208米，斜拉跨度的世界之最，公铁两用。", "symbolSize": 40, "category": "斜拉桥" },
    { "name": "拉索疲劳", "des": "风雨振与应力腐蚀是斜拉桥的软肋，换索是百年必修课。", "symbolSize": 40, "category": "斜拉桥" },
    { "name": "材料革命", "des": "桥能跨多远，先看材料能扛多少：木石铁钢到预应力混凝土。", "symbolSize": 50, "category": "材料革命" },
    { "name": "木桥时代", "des": "木伸臂与叠梁，森林资源区的千年桥式。", "symbolSize": 40, "category": "材料革命" },
    { "name": "程阳风雨桥", "des": "侗寨廊桥楼桥一体，不用一钉一铆的木构杰作。", "symbolSize": 40, "category": "材料革命" },
    { "name": "从熟铁到钢", "des": "1856年贝塞麦转炉让钢变便宜，大桥从此敢想敢跨。", "symbolSize": 40, "category": "材料革命" },
    { "name": "钢筋混凝土", "des": "钢筋抗拉、混凝土抗压，人工石材的复合天赋。", "symbolSize": 40, "category": "材料革命" },
    { "name": "预应力混凝土", "des": "弗雷西内先绷紧再放张，让混凝土梁自带反拱。", "symbolSize": 40, "category": "材料革命" },
    { "name": "高强钢丝", "des": "冷拔镀锌钢丝抗拉巨强，悬索与斜拉的肌腱。", "symbolSize": 40, "category": "材料革命" },
    { "name": "钢箱梁", "des": "正交异性桥面板的自重轻过混凝土一半，大跨的标配。", "symbolSize": 40, "category": "材料革命" },
    { "name": "深水基础", "des": "桥的功夫在水下：把上部结构的重量稳稳送进河床深处。", "symbolSize": 50, "category": "深水基础" },
    { "name": "桩基础", "des": "从河底木桩到百米钻孔灌注桩，荷载送进持力层。", "symbolSize": 40, "category": "深水基础" },
    { "name": "气压沉箱", "des": "压缩空气撑开河水，工人在干舱挖基，潜函病随之而来。", "symbolSize": 40, "category": "深水基础" },
    { "name": "钢围堰", "des": "围堰圈出干岛，深水里造出施工的孤洲。", "symbolSize": 40, "category": "深水基础" },
    { "name": "苏通深水基础", "des": "百米深桩配巨型承台，长江入海口的地质答卷。", "symbolSize": 40, "category": "深水基础" },
    { "name": "桥墩防撞", "des": "船撞力以万吨计，消能护舷替桥墩挡下致命一击。", "symbolSize": 40, "category": "深水基础" },
    { "name": "减隔震支座", "des": "铅芯橡胶支座以柔克刚，桥在地震里学会晃而不倒。", "symbolSize": 40, "category": "深水基础" },
    { "name": "灾难启示录", "des": "桥梁规范几乎都是用事故写成的：每一节残骸都进了教科书。", "symbolSize": 50, "category": "灾难启示录" },
    { "name": "泰河桥灾难", "des": "1879年风暴夜列车坠湾，风力第一次成为设计荷载。", "symbolSize": 40, "category": "灾难启示录" },
    { "name": "魁北克桥坍塌", "des": "1907年弦杆压溃于施工中，数十工人罹难的教科书案例。", "symbolSize": 40, "category": "灾难启示录" },
    { "name": "银桥事件", "des": "1967年一根眼杆断裂引发连锁倒塌，美国由此建立桥梁强制体检制度。", "symbolSize": 40, "category": "灾难启示录" },
    { "name": "圣水大桥", "des": "1994年首尔城市桥突然断落，维护失职敲响的警钟。", "symbolSize": 40, "category": "灾难启示录" },
    { "name": "疲劳与腐蚀", "des": "反复应力与锈蚀是桥的慢性病，老年医学同样适用于桥。", "symbolSize": 40, "category": "灾难启示录" },
    { "name": "健康监测", "des": "应变计与传感器联网，桥学会自己汇报病情。", "symbolSize": 40, "category": "灾难启示录" },
    { "name": "桥与文明", "des": "桥从来不只是路：它是地标、是边境、是城市的一半历史。", "symbolSize": 50, "category": "桥与文明" },
    { "name": "水城以桥为街", "des": "威尼斯以桥为街，苏州以桥为巷，水城的一半历史在桥上。", "symbolSize": 40, "category": "桥与文明" },
    { "name": "桥与战争", "des": "炸桥与守桥，桥梁自古是兵家的必经与必断。", "symbolSize": 40, "category": "桥与文明" },
    { "name": "桥梁美学", "des": "从铁虹到悬索天际线，力流本身即是美的轮廓。", "symbolSize": 40, "category": "桥与文明" },
    { "name": "海峡宏图", "des": "直布罗陀、渤海与琼州，世纪跨海通道的纸上蓝图。", "symbolSize": 40, "category": "桥与文明" },
    { "name": "桥梁体检制度", "des": "银桥之后定期检查入法，桥梁台账全球通行。", "symbolSize": 40, "category": "桥与文明" },
    { "name": "桥的词汇", "des": "引桥、桥头堡、伸缩缝，工程语言长进了日常用语。", "symbolSize": 40, "category": "桥与文明" }
  ],
