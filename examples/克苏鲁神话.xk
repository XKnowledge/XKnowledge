{
  "version": 2,
  "title": "克苏鲁神话",
  "description": "从普罗维登斯书房里的信笺，到宇宙中心痴愚之神的笛声——旧日支配者、禁书与疯诗人共同织成的恐惧谱系。",
  "nodes": [
    { "name": "克苏鲁神话", "des": "众神不为善恶，只为人类的渺小作证：宇宙冷漠，真相致疯，这一谱系由书信、友谊与后继者接力写成。", "symbolSize": 70, "category": "宇宙观与核心" },
    { "name": "阿撒托斯", "des": "盲目痴愚之神，蜷在宇宙中心听魔笛的混沌巨核，万物自它无心的躁动中涌出，也终将归于它。", "symbolSize": 60, "category": "外神与旧神" },
    { "name": "奈亚拉托提普", "des": "千面伏行之混沌，外神唯一的意志与信使，乐于行走人间布下恶作剧般的灾祸，是谱系里最热心的恶。", "symbolSize": 60, "category": "外神与旧神" },
    { "name": "犹格·索托斯", "des": "门之钥与注视者，时空一体的存在，所有门与门之间的通道本身，知晓过去未来的一切角落。", "symbolSize": 50, "category": "外神与旧神" },
    { "name": "莎布·尼古拉丝", "des": "森之黑山羊，孕育千万子孙的宇宙生殖力化身，被无数邪教以最古老的音节颂唱。", "symbolSize": 50, "category": "外神与旧神" },
    { "name": "乌波·萨斯拉", "des": "无源之源，地底温热无定形的原初生命，万物源于它也将归于它，据说众神的谱系也自它开始。", "symbolSize": 40, "category": "外神与旧神" },
    { "name": "阿卜霍斯", "des": "地心自我繁殖的污秽之池，不断生出畸形后代又将其吞噬，是宇宙失误的具象。", "symbolSize": 40, "category": "外神与旧神" },
    { "name": "格赫罗斯", "des": "巡天的血色彗星核，凡它掠过的世界文明尽数疯灭，被称作天空的灾罚。", "symbolSize": 40, "category": "外神与旧神" },
    { "name": "撒托古亚", "des": "地底洞穴里永恒饕餮的黑蟾神，懒惰而贪婪，来自史密斯笔下的希珀波瑞亚冰原。", "symbolSize": 40, "category": "外神与旧神" },
    { "name": "诺登斯", "des": "大深渊之主，银发老者驾着巨贝战车驰骋梦境，是冷酷宇宙里罕见的庇护者。", "symbolSize": 40, "category": "外神与旧神" },
    { "name": "巴斯特", "des": "猫首女神，古埃及的芭丝特在谱系中被扶为猫族守护神，是孤独作者少有的温柔寄托。", "symbolSize": 40, "category": "外神与旧神" },
    { "name": "许普诺斯", "des": "睡神，掌管醒与梦的边界，据说直视他面容的人再也无法醒来。", "symbolSize": 40, "category": "外神与旧神" },
    { "name": "塔维尔·阿特·乌姆尔", "des": "太一之门前的乌姆尔长者，灰色长袍下的引导者，替门之钥接引极少数获准通行者。", "symbolSize": 40, "category": "外神与旧神" },
    { "name": "旧神封印", "des": "古老而善意的力量曾镇压群魔，以符咒将旧日支配者锁在各自的牢笼里，是谱系里秩序的残余。", "symbolSize": 40, "category": "外神与旧神" },
    { "name": "克苏鲁", "des": "沉睡在拉莱耶的大祭司，章鱼头颅与龙翼的巨人，星辰归位之时将在梦中统治世界。", "symbolSize": 60, "category": "旧日支配者" },
    { "name": "哈斯塔", "des": "不可言说之名，与黄衣之王纠缠的风之旧日支配者，被旧神囚于哈利湖畔的卡尔克萨。", "symbolSize": 50, "category": "旧日支配者" },
    { "name": "大衮", "des": "深潜者之父与首领，庞大的两栖神祇，与妻母海德拉一同受渔村邪教膜拜。", "symbolSize": 40, "category": "旧日支配者" },
    { "name": "克苏加", "des": "烈焰构成的火之旧日支配者，被旧神禁锢在南极的火瓶之中，觉醒时天空都会点燃。", "symbolSize": 40, "category": "旧日支配者" },
    { "name": "伊格", "des": "蛇人之父，半人形的众蛇之神，最记仇的一位，毁誓者将被其子嗣缠绕至疯狂。", "symbolSize": 40, "category": "旧日支配者" },
    { "name": "伊德-雅", "des": "克苏鲁的配偶，同样沉眠于拉莱耶的星裔母体，诞下了延续血脉的子嗣。", "symbolSize": 40, "category": "旧日支配者" },
    { "name": "克提亚", "des": "克苏鲁的星裔后代，罕见的善裔，金瞳巨躯与父亲镜像相对，出自拉姆利的笔下。", "symbolSize": 40, "category": "旧日支配者" },
    { "name": "加塔诺托亚", "des": "克苏鲁的长子，凝视其形者将被石化成只有大脑还活着的外壳，被旧神封于穆大陆山下。", "symbolSize": 40, "category": "旧日支配者" },
    { "name": "佐斯-奥摩格", "des": "克苏鲁的幼子，沉在穆大陆海底的锥头星裔，与兄长一同等待牢笼失效。", "symbolSize": 40, "category": "旧日支配者" },
    { "name": "四元素敌对体系", "des": "后继者德雷斯为群魔排定的秩序：水火风土四大阵营彼此争斗，像元素战争一样永无宁日。", "symbolSize": 40, "category": "旧日支配者" },
    { "name": "死灵之书", "des": "疯诗人阿尔哈兹莱德写就的天下第一禁书，阿拉伯文原稿早已散佚，抄本每一页都通向深渊。", "symbolSize": 50, "category": "禁书典籍" },
    { "name": "玄君七章秘经", "des": "玄君留下的七卷秘典，克苏鲁教团依其残章推算星辰的运行与归位之日。", "symbolSize": 40, "category": "禁书典籍" },
    { "name": "妖蛆的秘密", "des": "法国疯伯爵写就的食尸鬼祭祀书，书名本身即谶语，十七世纪后被列为禁书。", "symbolSize": 40, "category": "禁书典籍" },
    { "name": "无名祭祀书", "des": "冯·容兹以生命写成的大书，记录各地邪教的黑暗仪式，作者死状成谜。", "symbolSize": 40, "category": "禁书典籍" },
    { "name": "伊波之书", "des": "巫师伊波遗留的黑书，希珀波瑞亚的冰雪魔法尽在其中，由史密斯虚构而出。", "symbolSize": 40, "category": "禁书典籍" },
    { "name": "纳克特手稿", "des": "五亿年前写就的极古老卷册，出自伟大种族伊斯之手，记着连它们都畏惧的未来。", "symbolSize": 40, "category": "禁书典籍" },
    { "name": "拉莱耶文本", "des": "刻着沉没之城咒文残篇的诡异文本，与死灵之书互为印证。", "symbolSize": 40, "category": "禁书典籍" },
    { "name": "迪伊译本", "des": "伊丽莎白朝术士约翰·迪伊留下的死灵之书英译本，黑体字里藏着最危险的页码。", "symbolSize": 40, "category": "禁书典籍" },
    { "name": "黄衣之王", "des": "两幕剧本，第一幕永远缺席，读过第二幕的人无一例外地疯狂、颓败或死去。", "symbolSize": 40, "category": "禁书典籍" },
    { "name": "赛拉伊诺断简", "des": "自毕宿魔城流散的断章残卷，拼合起来便是克苏鲁一脉的星间谱牒。", "symbolSize": 40, "category": "禁书典籍" },
    { "name": "禁忌知识的代价", "des": "贯穿谱系的铁律：读得越多，离深渊越近；历代读者以疯狂与横死为书页作注。", "symbolSize": 40, "category": "禁书典籍" },
    { "name": "洛夫克拉夫特", "des": "普罗维登斯的隐士，一生清贫地写出整个宇宙的冷漠，死后才被尊为二十世纪恐怖文学的轴心。", "symbolSize": 60, "category": "作者与传承" },
    { "name": "奥古斯特·德雷斯", "des": "威斯康星的书痴，创立阿卡姆之屋为亡友出书，把散落的恐怖整理成体系化的神话。", "symbolSize": 50, "category": "作者与传承" },
    { "name": "克拉克·阿什顿·史密斯", "des": "雕塑家般的诗人，希珀波瑞亚与佐泰克的缔造者，与洛夫克拉夫特书信往还如孪生。", "symbolSize": 50, "category": "作者与传承" },
    { "name": "罗伯特·欧文·霍华德", "des": "德州的蛮王柯南之父，笔下世界与神话共享地名与神名，通信圈里最炽热的烈酒。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "弗兰克·贝克纳普·朗", "des": "最早的通信伙伴之一，创造出穿越时间折角追猎的蒂恩多洛斯猎犬。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "亨利·库特纳", "des": "年少成名的后辈，把神话元素嫁接进科幻与恶搞，是圈子里的变色龙。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "弗里茨·雷伯", "des": "剑与魔法文学的接棒人，让旧日支配者在新浪潮的都市里再次抬头。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "拉姆齐·坎贝尔", "des": "英伦恐怖的重镇，把新英格兰的雾移到利物浦，创造出天罚彗星格赫罗斯。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "林·卡特", "des": "谱系考据者，沿德雷斯的路数排定神谱、补齐断代，像族长一样整理群魔。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "布莱恩·拉姆利", "des": "把战场从坟场搬到星际的扩张者，笔下提图斯·克罗以科技对抗旧日支配者。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "阿卡姆之屋出版社", "des": "为保存亡友遗作而专门创立的出版社，战后神话复兴的诺亚方舟。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "洛夫克拉夫特圈", "des": "以数百封信件结成的松散兄弟会，成员彼此借用神名与禁书，织成共享的宇宙。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "安布罗斯·比尔斯", "des": "内战记者与毒舌作家，最早写下哈利与卡尔克萨之名，是谱系上溯的源头。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "罗伯特·钱伯斯", "des": "把比尔斯的地名炼成禁演剧本的作家，《黄衣之王》的阴影由此落到普罗维登斯。", "symbolSize": 40, "category": "作者与传承" },
    { "name": "伦道夫·卡特", "des": "作者在纸上的化身，银钥的持有者，三次远征梦境边陲，最终放弃人形遁入门后。", "symbolSize": 50, "category": "调查员与人物" },
    { "name": "阿卜杜·阿尔哈兹莱德", "des": "七世纪的疯诗人，死灵之书的作者，在沙漠尽头看见了常人不可承受之物。", "symbolSize": 50, "category": "调查员与人物" },
    { "name": "赫伯特·韦斯特", "des": "执刀的复生者医学生，十七次失败的实验让他最终被自己的造物分食。", "symbolSize": 40, "category": "调查员与人物" },
    { "name": "奥贝德·马什", "des": "印斯茅斯船长，把南洋深潜者的血契带回渔村，用邻人的婚床换来满舱渔获。", "symbolSize": 40, "category": "调查员与人物" },
    { "name": "威尔伯·沃特雷", "des": "敦威治山间农舍的早熟怪童，偷阅禁书、豢养孪生隐形，毕生为父之降临铺路。", "symbolSize": 40, "category": "调查员与人物" },
    { "name": "亨利·阿米蒂奇", "des": "米斯卡塔尼克大学的老馆员，带着禁书走上山冈，用咒文放逐了不可名状之物。", "symbolSize": 40, "category": "调查员与人物" },
    { "name": "皮克曼", "des": "波士顿的颓废画家，模特来自墓地深处，最终自己也走进了画框那一侧。", "symbolSize": 40, "category": "调查员与人物" },
    { "name": "库拉尼斯", "des": "梦见塞勒菲斯并加冕为王的浪子，毕生的执念只是回到少年时伦敦街角的梦中。", "symbolSize": 40, "category": "调查员与人物" },
    { "name": "克苏鲁的呼唤", "des": "雕塑师的泥塑、神智学者的笔记与沼地邪教拼出同一座绿城：在拉莱耶的宅邸中，克苏鲁候汝入梦。", "symbolSize": 50, "category": "核心作品" },
    { "name": "敦威治恐怖事件", "des": "山间农舍的双生子之一终于显形，老馆员以三本禁书迎击父与子的降临仪式。", "symbolSize": 40, "category": "核心作品" },
    { "name": "疯狂山脉", "des": "南极科考队凿开三亿年的冰层，读出古老者文明的全部兴亡，也惊醒了修格斯。", "symbolSize": 40, "category": "核心作品" },
    { "name": "印斯茅斯的阴霾", "des": "衰败渔村的斜眼居民与魔鬼礁下的深潜者血脉，逃亡的年轻人在镜中看见自己的未来。", "symbolSize": 40, "category": "核心作品" },
    { "name": "暗夜呢喃", "des": "佛蒙特丘陵的陨石带来外来真菌，脑壳被运往冥王星矿场，务农的父子早已不是父子。", "symbolSize": 40, "category": "核心作品" },
    { "name": "穿越银钥之门", "des": "卡特的最后一次远行：银钥开启太一之门，伏行的引导者向他揭示存在的残酷层级。", "symbolSize": 40, "category": "核心作品" },
    { "name": "超越时间之影", "des": "学者的意识被掷进亿万年前的锥体躯壳，伟大种族以交换身体的方式逃离注定灭亡。", "symbolSize": 40, "category": "核心作品" },
    { "name": "查尔斯·迪克斯特·瓦德事件", "des": "炼尸术从灰烬中唤回先人，医生掘开百年家史，发现坟墓从来锁不住真正的名字。", "symbolSize": 40, "category": "核心作品" },
    { "name": "雷德胡克的恐怖", "des": "布鲁克林移民巷深处的高个子先知，把多元的流浪者聚成召唤的合唱团。", "symbolSize": 40, "category": "核心作品" },
    { "name": "墙中的老鼠", "des": "英国古宅的墙内彻夜窸窣，家族十二代的食人史在猪圈之下层层揭开。", "symbolSize": 40, "category": "核心作品" },
    { "name": "魔宅", "des": "普罗维登斯布尔街的老宅，地窖里蒸腾着以生者精魂为食的黄色憎恶。", "symbolSize": 40, "category": "核心作品" },
    { "name": "节日", "des": "雪夜渡口，空中驶来载着戴角长者的船，金斯波特最古老的仪式藏在冬至。", "symbolSize": 40, "category": "核心作品" },
    { "name": "尸体复生者", "des": "韦斯特医生的系列实验记录，一次次失败的复生终以医生本人被拖走收场。", "symbolSize": 40, "category": "核心作品" },
    { "name": "暗夜魔星", "des": "废弃教堂里闪耀的偏方三八面体，召唤出有翼的黑暗潜伏者——伏行之混沌的化身。", "symbolSize": 40, "category": "核心作品" },
    { "name": "阿卡姆", "des": "米斯卡塔尼克河湾的咒城，巫术传闻与哥特山墙并立，是虚构新英格兰的首都。", "symbolSize": 50, "category": "场所与都市" },
    { "name": "米斯卡塔尼克大学", "des": "藏有死灵之书初版与纳克特手稿的学府，每个故事的学者都从这里出发。", "symbolSize": 40, "category": "场所与都市" },
    { "name": "印斯茅斯", "des": "人人绕道走的衰败渔港，空屋与鱼腥之下流淌着深潜者的血。", "symbolSize": 50, "category": "场所与都市" },
    { "name": "敦威治", "des": "阿卡姆西边山里的穷乡，圆山冈下的农舍曾养出不可名状之物。", "symbolSize": 40, "category": "场所与都市" },
    { "name": "金斯波特", "des": "崖顶老港，冬至的空中航船与百岁长者暗示着比殖民更古老的过去。", "symbolSize": 40, "category": "场所与都市" },
    { "name": "拉莱耶", "des": "非欧几何的绿石巨城沉在太平洋底，角度错误，太阳系自其建筑材料中诞生。", "symbolSize": 50, "category": "场所与都市" },
    { "name": "幻梦境", "des": "入梦者可抵达的边陲之地，七千级台阶之上是塞勒菲斯、冷原与诸神的冷宫卡达斯。", "symbolSize": 50, "category": "场所与都市" },
    { "name": "塞勒菲斯", "des": "虹色大理石筑成的云上之都，库拉尼斯在梦中加冕为王的城市。", "symbolSize": 40, "category": "场所与都市" },
    { "name": "卡达斯", "des": "莽原尽头的冷岩巨城，大地诸神的居所，无人能凭记忆找到它的方向。", "symbolSize": 40, "category": "场所与都市" },
    { "name": "冷原", "des": "起伏不定的诡原，蜂巢般的无窗僧院与月兽的黑帆集市同在雾中。", "symbolSize": 40, "category": "场所与都市" },
    { "name": "卡尔克萨", "des": "哈利湖畔的遗骸之城，暗星悬空，黄衣之王的终幕在此上演。", "symbolSize": 40, "category": "场所与都市" },
    { "name": "尤格斯", "des": "即冥王星的星间矿业前哨，米-戈在黑色矿脉下挖掘着不可名状之物。", "symbolSize": 40, "category": "场所与都市" },
    { "name": "普罗维登斯", "des": "作者生于斯葬于斯的殖民老城，联邦山的教堂与书桌是整个谱系的起点。", "symbolSize": 40, "category": "场所与都市" },
    { "name": "深潜者", "des": "两栖的鱼蛙眷族，与人类缔约繁衍混血，永生的它们终将完全蜕变入海。", "symbolSize": 50, "category": "眷族与教团" },
    { "name": "修格斯", "des": "无面原生质的造物，古老者的多用途奴工，最终学会叛变并模仿主人的笛声。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "米-戈", "des": "来自犹格斯的真菌蟹螯种族，摘取活人大脑装入金属缸运往星间，肉体凡胎看不见它们。", "symbolSize": 50, "category": "眷族与教团" },
    { "name": "伟大种族伊斯", "des": "超越时间的意识旅行者，以心灵交换占据各时代的躯体，把文明史写成自己的逃亡路线。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "飞天水螅", "des": "半可视的凶残风状种族，毁灭了伊斯人的肉身，连大地都记得它们的嘶鸣。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "星之眷族", "des": "随克苏鲁一同坠落的同种族裔，石柱沉城之中与祭司一同等待星辰归位。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "夜魇", "des": "无面黑翼的梦魇生物，抓挠般的触手令人遗忘一切，据说是深渊之主的坐骑。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "古革", "des": "梦境地下巨城的食人巨族，竖眼獠牙，被诸神罚入永夜的石城。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "月兽", "des": "月面的灰白蠕动者，伏行混沌的爪牙，黑帆船满载俘虏驶向那加人的哭嚎。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "食尸鬼", "des": "墓穴族群断然无惧于巨族，狗面驼背，用哑语交谈，人类偶尔也会加入它们的宴席。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "蛇人", "des": "远古城堡废墟下的爬行遗族，先于人类统治地表，至今仍在暗处蜕皮。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "古老者", "des": "五棱桶身的植物性初代文明，建起南极巨城，最终被自己的造物与冰层埋葬。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "蒂恩多洛斯猎犬", "des": "栖居于时间锐角中的苍白猎犬，穿越时空追猎一切越过时间曲线的窥视者。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "星辰智慧教会", "des": "盘踞联邦山老教堂的邪教，供奉闪耀的黑石，教徒跪求的正是黑暗潜伏者。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "克苏鲁教团", "des": "沼地穴洞里的非人合唱团，口吐无法记录的音节，等待城门再开的那一夜。", "symbolSize": 40, "category": "眷族与教团" },
    { "name": "大衮秘教", "des": "由船长自南洋带回的渔村邪教，以人祭换取渔获丰饶，最终连自己也被吞没。", "symbolSize": 40, "category": "眷族与教团" }
  ],
