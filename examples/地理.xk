    { "source": "厄尔尼诺", "target": "降水", "name": "扰乱", "des": "厄尔尼诺年环流异常，该下雨的地方反而干旱。" },
    { "source": "副热带高压", "target": "季风", "name": "进退", "des": "西太平洋副高的强弱，牵动夏季风前进的步伐。" },
    { "source": "大气环流", "target": "洋流", "name": "驱动", "des": "盛行风吹拂海面，推动海水形成风海流。" },
    { "source": "季风", "target": "河流补给", "name": "主导", "des": "季风区降水集中在夏，河流以雨水补给为主。" },
    { "source": "降水", "target": "河流补给", "name": "补给", "des": "雨水落地汇入河网，是多数河流的主要水源。" },
    { "source": "季风", "target": "水文特征", "name": "决定", "des": "夏季风一到汛期便至，季风不稳则旱涝无常。" },
    { "source": "全球变暖", "target": "海平面上升", "name": "导致", "des": "海水受热膨胀叠加冰川消融，海面逐年抬升。" },
    { "source": "全球变暖", "target": "冰川", "name": "消融", "des": "气温升高使山地冰川加速退缩，固体水库变薄。" },
    { "source": "气候类型", "target": "植被", "name": "决定", "des": "什么样的气候长什么样的植物，水热是画笔。" },
    { "source": "气候类型", "target": "农业区位", "name": "制约", "des": "气候框定熟制与作物，种什么先看天的脸色。" },
    { "source": "城市化", "target": "城市热岛", "name": "加剧", "des": "城市扩张硬地增多，热岛效应越发明显。" },
