    { "source": "热力环流", "target": "大气环流", "name": "基础", "des": "热力环流是大气环流的原型，放大到全球尺度便是环流。" },
    { "source": "气压带风带", "target": "大气环流", "name": "组成", "des": "七个气压带与六个风带，织成全球性环流的骨架。" },
    { "source": "大气环流", "target": "降水", "name": "控制", "des": "环流决定水汽通道，哪里被抬升哪里就多雨。" },
    { "source": "副热带高压", "target": "降水", "name": "抑制", "des": "副高控制区气流下沉，晴热少雨，伏旱由此而来。" },
    { "source": "锋面", "target": "降水", "name": "形成", "des": "冷暖气流相遇暖气团被抬升，冷却凝结成雨。" },
