{
  "version": 2,
  "title": "地理",
  "description": "大气、水文、地貌到区域关联的核心概念网络",
  "nodes": [
    { "name": "大气环流", "des": "太阳加热不均驱动的全球性空气大输送，像一台永不停歇的巨型热力发动机。", "symbolSize": 65, "category": "大气与气候" },
    { "name": "气压带风带", "des": "赤道与回归线附近成对出现的气压带和信风西风，全球气候分布的总开关。", "symbolSize": 60, "category": "大气与气候" },
    { "name": "季风", "des": "海陆吸热放热快慢不同，风向随季节掉头，夏季风带来满载水汽的雨。", "symbolSize": 65, "category": "大气与气候" },
    { "name": "热力环流", "des": "受热处空气上升、冷却处空气下沉的最基本运动，一切大气环流的原型。", "symbolSize": 45, "category": "大气与气候" },
    { "name": "副热带高压", "des": "盘踞回归线附近的暖性高压，它一控制天空晴朗少雨，长江中下游伏旱元凶。", "symbolSize": 50, "category": "大气与气候" },
    { "name": "锋面", "des": "冷暖空气相遇的交界面，暖气团被抬升冷却成云致雨，雨带常顺锋面铺开。", "symbolSize": 45, "category": "大气与气候" },
    { "name": "台风", "des": "热带洋面上诞生的强热带气旋，一边旋转一边把巨量水汽甩成狂风暴雨。", "symbolSize": 45, "category": "大气与气候" },
    { "name": "降水", "des": "水汽凝结后以雨雪冰雹等形式落回地面，陆上淡水最主要的来源。", "symbolSize": 55, "category": "大气与气候" },
    { "name": "气候类型", "des": "某地多年天气的平均性格，雨林终年多雨、地中海夏干冬湿，各成一派。", "symbolSize": 60, "category": "大气与气候" },
    { "name": "温室效应", "des": "大气中二氧化碳等像棉被一样裹住地表热量，让地球夜晚不至于太冷。", "symbolSize": 50, "category": "大气与气候" },
    { "name": "全球变暖", "des": "温室气体越排越多棉被太厚，全球气温持续攀升，牵动一串连锁反应。", "symbolSize": 55, "category": "大气与气候" },
    { "name": "厄尔尼诺", "des": "赤道太平洋东部海水异常变暖，打乱全球旱涝格局，秘鲁渔场随之减产。", "symbolSize": 50, "category": "大气与气候" },
    { "name": "城市热岛", "des": "城市水泥建筑吸热多散热难，市中心气温明显高于郊区，像一座发热的岛。", "symbolSize": 40, "category": "大气与气候" },
    { "name": "水循环", "des": "水在海洋、天空、陆地之间循环旅行，蒸发成云又落为雨，永不停歇。", "symbolSize": 65, "category": "水文与海洋" },
    { "name": "洋流", "des": "海洋里的河流，按固定路线大规模流动，暖流像暖气管，寒流似冷气机。", "symbolSize": 60, "category": "水文与海洋" },
    { "name": "河流", "des": "沿地势流动的天然水道，塑造大地也滋养文明，人类古老的摇篮。", "symbolSize": 60, "category": "水文与海洋" },
    { "name": "河流补给", "des": "河流的水从哪里来：雨水、冰雪融水、地下水等，水源决定河流的脾气。", "symbolSize": 55, "category": "水文与海洋" },
    { "name": "水文特征", "des": "河流的体检单：流量大小、汛期早晚、含沙量多少、冬天结不结冰。", "symbolSize": 50, "category": "水文与海洋" },
    { "name": "地下水", "des": "藏在土壤和岩石空隙里的水，流动慢更新慢，干旱地区的救命水。", "symbolSize": 45, "category": "水文与海洋" },
    { "name": "冰川", "des": "高山积雪多年压实形成的冰体，流动极慢的固体水库，淡水储量巨头。", "symbolSize": 45, "category": "水文与海洋" },
    { "name": "渔场", "des": "鱼群密集便于捕捞的海域，多在寒暖流交汇或上升流处，饵料格外丰富。", "symbolSize": 50, "category": "水文与海洋" },
    { "name": "潮汐", "des": "海水在日月引力下的周期性涨落，一天两涨两落，潮间带的呼吸节拍。", "symbolSize": 40, "category": "水文与海洋" },
    { "name": "凌汛", "des": "结冰河流上游先解冻，冰块在下游拥堵成坝，水位猛涨的春日汛情。", "symbolSize": 40, "category": "水文与海洋" },
    { "name": "洪涝", "des": "降水过于集中或排水不畅，洪水漫过土地，最常见的自然灾害之一。", "symbolSize": 45, "category": "水文与海洋" },
    { "name": "水资源", "des": "人类可直接利用的河湖淡水，总量少且分布极不均，弥足珍贵。", "symbolSize": 50, "category": "水文与海洋" },
    { "name": "海平面上升", "des": "海水受热膨胀叠加冰川融化，海面逐年抬高，沿海低地将被浸淹。", "symbolSize": 45, "category": "水文与海洋" },
    { "name": "板块构造", "des": "岩石圈裂成几大板块漂在软流圈上，碰撞张裂之间造就海陆变迁。", "symbolSize": 65, "category": "地貌与地质" },
    { "name": "地震", "des": "板块挤压使岩层突然断裂错动，能量瞬间释放，大地颤抖的元凶。", "symbolSize": 45, "category": "地貌与地质" },
    { "name": "火山", "des": "地下岩浆沿地壳薄弱处喷出地表，既是灾难，也是造岛造地的力量。", "symbolSize": 45, "category": "地貌与地质" },
    { "name": "褶皱与断层", "des": "岩层受挤压弯曲成褶皱、断裂错动成断层，造山运动的两大手法。", "symbolSize": 50, "category": "地貌与地质" },
    { "name": "地形", "des": "地表的起伏模样，山地高原平原盆地丘陵五种格局，影响一切布局。", "symbolSize": 60, "category": "地貌与地质" },
    { "name": "风化作用", "des": "温差、水和生物把坚硬岩石一点点酥松崩解，侵蚀作用的先头部队。", "symbolSize": 45, "category": "地貌与地质" },
    { "name": "流水侵蚀", "des": "流动的水切削挖掘地表，水滴石穿，地球上最伟大的雕刻家之一。", "symbolSize": 50, "category": "地貌与地质" },
    { "name": "喀斯特地貌", "des": "流水溶蚀可溶岩石雕出的奇观，峰林溶洞石林，地下的艺术宫殿。", "symbolSize": 50, "category": "地貌与地质" },
    { "name": "冲积平原", "des": "河流出山后泥沙层层堆积成的平坦沃野，土层深厚，农业天赐宝地。", "symbolSize": 55, "category": "地貌与地质" },
    { "name": "三角洲", "des": "河流入海处泥沙堆积成的三角形陆地，河海交汇、土壤肥美之地。", "symbolSize": 50, "category": "地貌与地质" },
    { "name": "黄土高原", "des": "风力沉积的厚黄土覆盖的高原，土质疏松遇雨易蚀，千沟万壑。", "symbolSize": 45, "category": "地貌与地质" },
    { "name": "风蚀地貌", "des": "干旱区狂风夹沙长期磨蚀，雕出蘑菇石与雅丹群，大地的风刻版画。", "symbolSize": 40, "category": "地貌与地质" },
    { "name": "冰川地貌", "des": "冰川缓慢移动时刨蚀搬运堆积，留下角峰、U形谷和串串冰碛湖。", "symbolSize": 45, "category": "地貌与地质" },
    { "name": "自然带", "des": "相同气候孕育的植被与土壤组合带，地球的天然皮肤，成带状分布。", "symbolSize": 60, "category": "自然带与生态" },
    { "name": "纬度地带性", "des": "自然带沿纬线东西延伸、随纬度南北更替，从雨林到苔原依次排开。", "symbolSize": 55, "category": "自然带与生态" },
    { "name": "经度地带性", "des": "自然带从沿海到内陆随降水递减更替，森林、草原、荒漠渐次登场。", "symbolSize": 50, "category": "自然带与生态" },
    { "name": "垂直地带性", "des": "山越高水热越不同，植被像从赤道到极地竖着排，一山有四季。", "symbolSize": 50, "category": "自然带与生态" },
    { "name": "植被", "des": "覆盖地面的植物群落总称，森林草原荒漠各安其境，大地的外衣。", "symbolSize": 55, "category": "自然带与生态" },
    { "name": "土壤", "des": "岩石风化加生物作用形成的疏松表层，陆地生命的温床和粮仓。", "symbolSize": 50, "category": "自然带与生态" },
    { "name": "热带雨林", "des": "终年高温多雨的森林，物种最密集的家园，地球之肺和巨型水塔。", "symbolSize": 45, "category": "自然带与生态" },
    { "name": "荒漠", "des": "降水稀少蒸发旺盛的地区，植被稀疏，生命存活能力的极限考场。", "symbolSize": 40, "category": "自然带与生态" },
    { "name": "草原", "des": "半干旱区连绵的草本植被海洋，风吹草低，牧民与牛羊的天堂。", "symbolSize": 40, "category": "自然带与生态" },
    { "name": "水土流失", "des": "缺乏植被保护时雨水冲走表层土壤，土地贫瘠化，河流含沙剧增。", "symbolSize": 50, "category": "自然带与生态" },
    { "name": "生物多样性", "des": "地球上物种与基因的丰富程度，生命之网的经纬，越密越稳固。", "symbolSize": 45, "category": "自然带与生态" },
    { "name": "湿地", "des": "水陆过渡地带，沼泽滩涂红树林，蓄洪又净水，被誉为自然之肾。", "symbolSize": 45, "category": "自然带与生态" },
    { "name": "人口增长", "des": "人口数量随出生与死亡而变化，经历从高出生到低增长的阶段转变。", "symbolSize": 50, "category": "人口与城市" },
    { "name": "人口迁移", "des": "人们离开家乡迁往他处讨生活，同时改变迁出地与迁入地的人口结构。", "symbolSize": 55, "category": "人口与城市" },
    { "name": "老龄化", "des": "老年人口占比不断上升，养老负担日益加重，银发浪潮悄然袭来。", "symbolSize": 45, "category": "人口与城市" },
    { "name": "环境承载力", "des": "环境能养活的人口上限，由水、土地、能源共同划定的天花板。", "symbolSize": 40, "category": "人口与城市" },
    { "name": "劳动力", "des": "能参与劳动的人口，区域发展的引擎，也是各地产业争夺的资源。", "symbolSize": 45, "category": "人口与城市" },
    { "name": "城市化", "des": "人口向城市集聚、乡村变城市的过程，社会经济发展的必经之路。", "symbolSize": 65, "category": "人口与城市" },
    { "name": "城市功能分区", "des": "城市内部商业区、住宅区、工业区各司其职的空间格局。", "symbolSize": 45, "category": "人口与城市" },
    { "name": "逆城市化", "des": "大城市中心人口迁往郊区和小城镇，追求环境与空间的新潮流。", "symbolSize": 45, "category": "人口与城市" },
    { "name": "城市群", "des": "多个城市连片发展、分工协作的巨型联合体，国家的经济引擎。", "symbolSize": 55, "category": "人口与城市" },
    { "name": "中心城市", "des": "城市群中辐射带动周边的核心城市，是城市群的龙头和大脑。", "symbolSize": 40, "category": "人口与城市" },
    { "name": "聚落", "des": "人类居住和活动的场所，乡村与城市的总称，多逐水而居。", "symbolSize": 40, "category": "人口与城市" },
    { "name": "人口分布", "des": "人口在地表的疏密格局，东亚南亚稠密，干旱高寒区人烟稀少。", "symbolSize": 45, "category": "人口与城市" },
    { "name": "农业区位", "des": "种什么、种在哪里的决策，气候地形水源市场共同参与权衡。", "symbolSize": 55, "category": "产业与区域发展" },
    { "name": "工业区位", "des": "工厂选址的考量，原料、市场、交通、劳动力孰轻孰重的算计。", "symbolSize": 55, "category": "产业与区域发展" },
    { "name": "水稻种植业", "des": "季风区雨热同期的经典农业，水田连片，养活亚洲海量人口。", "symbolSize": 45, "category": "产业与区域发展" },
    { "name": "畜牧业", "des": "靠放牧饲养牲畜获取肉奶毛皮的农业，广布于草原与干旱区。", "symbolSize": 40, "category": "产业与区域发展" },
    { "name": "矿产资源", "des": "埋藏地下可开采的煤铁石油等，工业的粮食，区域发展的家底。", "symbolSize": 50, "category": "产业与区域发展" },
    { "name": "交通运输", "des": "运送人和物资的铁路公路水运航空网络，区域发展的先行官。", "symbolSize": 65, "category": "产业与区域发展" },
    { "name": "港口", "des": "水陆运输衔接的枢纽，货物在这里换乘，城市也常因港而兴。", "symbolSize": 45, "category": "产业与区域发展" },
    { "name": "产业转移", "des": "企业从发达地区迁往欠发达地区，像产业版的候鸟迁徙。", "symbolSize": 50, "category": "产业与区域发展" },
    { "name": "高新技术产业", "des": "以技术和人才为核心的新兴产业，芯片、软件、生物医药等。", "symbolSize": 45, "category": "产业与区域发展" },
    { "name": "一带一路", "des": "联通亚欧非的基础设施与经贸合作网络，新时代的丝绸之路。", "symbolSize": 50, "category": "产业与区域发展" },
    { "name": "可持续发展", "des": "既满足当代又不损害后代利益的发展方式，经济生态两手抓。", "symbolSize": 55, "category": "产业与区域发展" },
    { "name": "资源型城市", "des": "因矿而兴的城市，如大庆鞍山，资源枯竭后面临转型大考。", "symbolSize": 40, "category": "产业与区域发展" },
    { "name": "市场", "des": "商品买卖的需求和场所，离市场近的农业与工业总占先机。", "symbolSize": 40, "category": "产业与区域发展" }
  ],
