    { "source": "毗湿奴", "target": "拉克希米", "name": "配偶", "des": "护持之神与吉祥之女，秩序与丰饶的联姻。" },
    { "source": "湿婆", "target": "帕尔瓦蒂", "name": "配偶", "des": "苦行之火与雪山之爱，毁灭者的另一半。" },
