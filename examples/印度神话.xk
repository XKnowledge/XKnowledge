{
  "version": 2,
  "title": "印度神话",
  "description": "从吠陀赞歌到两大史诗的战场，三主神、化身谱系、天神与阿修罗的宏大网络。",
  "nodes": [
    { "name": "印度神话", "des": "从吠陀的祭火到俱卢之野的号角，创造、护持与毁灭循环不息，众神与众生同在一张业报之网。", "symbolSize": 70, "category": "吠陀与原初" },
    { "name": "原人普鲁沙", "des": "千首千眼的宇宙巨人，诸神以其为祭分解其身，日月雷雨与四种姓皆出自他的肢体。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "梵卵", "des": "漂于原初之水的金胎，从中裂出的创世者开辟天地，宇宙的第一个清晨自此开始。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "吠陀", "des": "「明」与「知」，四部天启圣典的总名，祭仪、咒颂与宇宙秩序的最早档案。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "梨俱吠陀", "des": "一千余首赞歌构成的最古老吠陀，雅利安祭司在五河之地唱出的第一批诗。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "因陀罗", "des": "吠陀的战神与雷神，饮下三池苏摩、掷出金刚杵劈开巨蟒，为世界放出被囚的河水。", "symbolSize": 50, "category": "吠陀与原初" },
    { "name": "阿耆尼", "des": "祭火之神，诸神与人间之间的信使，每场祭祀都由他的火舌传递给上天。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "伐由", "des": "风神，迅疾如思想、为众神先驱的那一口气，史诗英雄们传说的父亲。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "伐楼拿", "des": "早期吠陀的天则守护者，以千眼巡视人间善恶的契约之神，后让位于因陀罗。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "苏摩", "des": "神性饮品亦是月神，祭司与神灵共饮的兴奋之流，因陀罗神力的来源。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "苏利耶", "des": "太阳神，七匹母马牵引的金车之主，昼夜与季节依他的轨道运转。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "乌莎斯", "des": "黎明女神，吠陀颂歌中最明亮的身影，每天清晨驱散她的黑暗姊妹。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "双马童", "des": "孪生的双子神医，驾金车巡于黎明之前，为众神与凡人疗伤祛病。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "阎摩", "des": "第一个死去的人，因此成为亡者之王，与爱犬共守冥府通道的法则之神。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "梵", "des": "奥义书所证的无上实在，万有的根基与归宿，名之不可名的那个「彼一」。", "symbolSize": 50, "category": "吠陀与原初" },
    { "name": "弗栗多", "des": "盘踞群山困住河水的巨蟒，众矢之的的混沌化身，因陀罗武勋的注脚。", "symbolSize": 40, "category": "吠陀与原初" },
    { "name": "梵天", "des": "自金胎而出的创世者，四首四臂、坐于莲上的祖父之神，创造之职的化身。", "symbolSize": 60, "category": "三主神与神妃" },
    { "name": "萨罗斯瓦蒂", "des": "河川与智慧的女神，梵天之妻，持维纳琴司掌语言、学问与艺术。", "symbolSize": 40, "category": "三主神与神妃" },
    { "name": "毗湿奴", "des": "遍入天，卧于千头蛇上的护持之神，每当宇宙倾危便降世为十大化身。", "symbolSize": 60, "category": "三主神与神妃" },
    { "name": "拉克希米", "des": "吉祥天女，自乳海莲花中升起的财富与美之女神，毗湿奴永恒的伴侣。", "symbolSize": 50, "category": "三主神与神妃" },
    { "name": "湿婆", "des": "毁灭与再生的舞蹈者，苦行之王与雪山之主，第三只眼睁开即是一个宇宙纪元。", "symbolSize": 60, "category": "三主神与神妃" },
    { "name": "帕尔瓦蒂", "des": "雪山之女，以苦修赢得湿婆的乌玛，温柔的妻与勇武的力一体两面。", "symbolSize": 50, "category": "三主神与神妃" },
    { "name": "杜尔迦", "des": "难近母，诸神合力铸就的十臂战神，骑狮挺矛诛灭水牛魔的降魔者。", "symbolSize": 50, "category": "三主神与神妃" },
    { "name": "迦梨", "des": "黑时母，从杜尔迦眉间跃出的灭世之怒，项链骷髅、踩湿婆而舞的黑面女神。", "symbolSize": 40, "category": "三主神与神妃" },
    { "name": "恒河女神", "des": "自毗湿奴足尖流下、经湿婆发丝缓冲的天河，洗净罪业的那一条银河。", "symbolSize": 50, "category": "三主神与神妃" },
    { "name": "林伽", "des": "无相之神的石柱象征，与约尼合一的宇宙基座，湿婆信仰最朴素的形体。", "symbolSize": 40, "category": "三主神与神妃" },
    { "name": "凯拉萨山", "des": "湿婆与帕尔瓦蒂的雪山居所，须弥山侧的圣峰，后世画不完的坛城。", "symbolSize": 40, "category": "三主神与神妃" },
    { "name": "舞王", "des": "在火环中起舞的湿婆，一足踏灭、一足护生的宇宙节奏本身。", "symbolSize": 40, "category": "三主神与神妃" },
    { "name": "化身学说", "des": "每当正法倾颓，护持之神便降世救度的神学，十化身的谱系由此成立。", "symbolSize": 50, "category": "三主神与神妃" },
    { "name": "摩蹉", "des": "鱼化身，洪水中牵引方舟、救起人类始祖摩奴的大鱼，印度版诺亚的故事。", "symbolSize": 40, "category": "毗湿奴化身" },
    { "name": "俱利摩", "des": "龟化身，潜入乳海托起搅棒巨山的神龟，众神搅海得以施展的基石。", "symbolSize": 40, "category": "毗湿奴化身" },
    { "name": "筏罗亥", "des": "野猪化身，潜入洪水深渊以獠牙拱起沉没大地的雄猪，拯救泥土之球。", "symbolSize": 40, "category": "毗湿奴化身" },
    { "name": "那罗辛哈", "des": "狮人化身，非人非兽非神非魔、恰在黄昏杀死不可被杀的暴君的第四身。", "symbolSize": 40, "category": "毗湿奴化身" },
    { "name": "筏摩那", "des": "侏儒化身，三步跨越天地，从魔王巴利足下要回三界的婆罗门童子。", "symbolSize": 40, "category": "毗湿奴化身" },
    { "name": "持斧罗摩", "des": "持斧的婆罗门战士，二十一次屠尽傲慢刹帝利的第六化身，武艺的祖师。", "symbolSize": 40, "category": "毗湿奴化身" },
    { "name": "罗摩", "des": "阿逾陀的理想王子，十车王之子、楞伽的征服者，「罗摩衍那」之名所在。", "symbolSize": 60, "category": "毗湿奴化身" },
    { "name": "克里希纳", "des": "黑天，吹笛的牧牛之神与俱卢之野的御者，梵歌自他口中流出的至高化身。", "symbolSize": 60, "category": "毗湿奴化身" },
    { "name": "持棒罗摩", "des": "克里希纳的兄长，持犁的白衣大力士，部分传统中位列第八的化身。", "symbolSize": 40, "category": "毗湿奴化身" },
    { "name": "佛陀", "des": "被纳入化身谱系的释迦牟尼，以慈悲与空观示现、令祭仪让位于觉悟的一身。", "symbolSize": 40, "category": "毗湿奴化身" },
    { "name": "迦尔基", "des": "尚未降临的末世化身，骑白马持利剑的骑士，黑暗纪元的终结者。", "symbolSize": 40, "category": "毗湿奴化身" },
    { "name": "提婆", "des": "天神族，光明与祭供的受惠者，与堂兄弟阿修罗分治又争夺着宇宙。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "阿修罗", "des": "与天神同源的魔族，并非单纯之恶，亦有苦修千年的虔诚与被欺骗的怨愤。", "symbolSize": 50, "category": "天神与阿修罗" },
    { "name": "迦叶波", "des": "远古的生主之一，诸天、魔族、飞禽与蛇族的共同祖父，一位多婚的始祖。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "阿底提", "des": "「无缚者」，生下因陀罗等天神的伟大母亲，八位阿底提耶之母。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "底提", "des": "阿底提的姊妹，阿修罗一族的母祖，其子们的复仇绵延了整个宇宙纪元。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "达努", "des": "另一位母祖，诞下以弗栗多为首的魔龙世系，诸天宿敌的血脉。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "搅拌乳海", "des": "以巨山为杵、蛇王为绳的千年合作，天神与魔族共搅出不死甘露与吉祥天女。", "symbolSize": 50, "category": "天神与阿修罗" },
    { "name": "不死甘露", "des": "搅海所得的永生之露，分配风波引出的欺诈与追索，月亏的起源。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "罗睺", "des": "偷饮甘露被斩首的魔星，不死的首级永远追逐日月，蚀的天文神话。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "曼陀罗山", "des": "被拔起作搅棒的圣山，众神以之为杵在乳海中搅动千年。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "婆苏基", "des": "缠上巨山作搅绳的千头蛇王，被拔起时喷涌的毒液几乎焚尽三界，后来由湿婆一饮而尽。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "陀湿多", "des": "天界的巧匠之神，铸神兵与神杯，因丧子而造出复仇巨蟒的锻造师。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "金翅鸟", "des": "伽鲁达，毗湿奴的白面坐骑，以蛇族为食的百翼鸟王，速度的极限。", "symbolSize": 40, "category": "天神与阿修罗" },
    { "name": "十车王", "des": "阿逾陀的老王，有子难立的焦虑与信守诺言的固执，酿成流放的开端。", "symbolSize": 40, "category": "罗摩衍那" },
    { "name": "悉多", "des": "犁沟里诞生的公主，随夫流放、被劫又投身大地证明清白的女主角。", "symbolSize": 50, "category": "罗摩衍那" },
    { "name": "罗什曼那", "des": "罗摩最忠诚的弟弟，十四年流放寸步不离，为兄长警戒守夜的剑与影子。", "symbolSize": 40, "category": "罗摩衍那" },
    { "name": "哈奴曼", "des": "风神之子、猴族的英雄，一跃跨海、尾大焚城，智慧与忠诚的猴神。", "symbolSize": 50, "category": "罗摩衍那" },
    { "name": "须羯哩婆", "des": "流亡的猴王，在罗摩帮助下复位，猴军寻找悉多的组织者。", "symbolSize": 40, "category": "罗摩衍那" },
    { "name": "罗波那", "des": "十首二十臂的楞伽魔王，湿婆的苦修者与世界的劫掠者，因傲慢失去一切。", "symbolSize": 50, "category": "罗摩衍那" },
    { "name": "维毗沙那", "des": "罗波那的幼弟，劝谏无效后投向罗摩，楞伽之战的倒戈者与后世明君。", "symbolSize": 40, "category": "罗摩衍那" },
    { "name": "楞伽之战", "des": "猴军渡海攻城的终局之战，神魔与众生的大战，罗摩故事的最高潮。", "symbolSize": 40, "category": "罗摩衍那" },
    { "name": "阿逾陀", "des": "萨罗逾河畔的理想王都，日族王朝的都城，罗摩流放与归来加冕的政治舞台。", "symbolSize": 40, "category": "罗摩衍那" },
    { "name": "金鹿", "des": "魔王遣人幻化的金色麋鹿，以稀世之美诱走罗摩，劫夺悉多的第一步棋。", "symbolSize": 40, "category": "罗摩衍那" },
    { "name": "森林流放", "des": "十四年的林居岁月，王子弃国携妻，神话从此离开王宫进入荒野。", "symbolSize": 40, "category": "罗摩衍那" },
    { "name": "般度", "des": "般度族的挂名之父，受咒而不能生育的五子之父，早逝的悲剧国王。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "贡蒂", "des": "掌握召神咒的太后，婚前弃子、婚后借神生下三子的隐忍母亲。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "坚战", "des": "法王之子、般度家长子，永远诚实却输掉一切，掷骰与复国的两面人生。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "怖军", "des": "风神之子的大力士，食量与怒火同样惊人，为黑公主折断难敌大腿的复仇者。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "阿周那", "des": "因陀罗之子的神射手，克里希纳的挚友与御者，临阵手软的绝世弓手。", "symbolSize": 50, "category": "摩诃婆罗多" },
    { "name": "无种", "des": "孪生兄弟中的兄者，俊美的剑客与驯马师，双马神之子。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "偕天", "des": "孪生兄弟中的弟者，精通星象与医药的智者，五兄弟中最沉默的幼弟。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "黑公主", "des": "火坛中诞生的木黑之女，一妻共五夫的般度族王后，掷骰与雪耻的当事人。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "迦尔纳", "des": "太阳之子、贡蒂的长子，生而为敌营所养，车轮陷地的悲剧英雄。", "symbolSize": 50, "category": "摩诃婆罗多" },
    { "name": "持国", "des": "盲眼的兄长国王，一百个难驯之子的父亲，溺爱铸成大错的老人。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "难敌", "des": "持国长子，嫉妒与野心的化身，掷骰夺国与设计辱嫂的挑局者。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "沙恭尼", "des": "操纵骰子的舅父，甘德哈拉来的策士，用一副骨头做的骰子赢走一个王国。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "毗湿摩", "des": "恒河之子、两族的祖父，为父弃爱的誓言者，箭床上躺卧九日的老人。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "德罗纳", "des": "婆罗门武师，两族共同的老师，偏爱阿周那而不容迦尔纳的导师。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "俱卢之野", "des": "「法之地」，十八天的大战，一亿八千万人死去的地方，法与非法的总清算。", "symbolSize": 40, "category": "摩诃婆罗多" },
    { "name": "薄伽梵歌", "des": "战车之上克里希纳对阿周那的开示，行动、虔信与梵我的圣典。", "symbolSize": 50, "category": "摩诃婆罗多" }
  ],
  "links": [
    { "source": "印度神话", "target": "原人普鲁沙", "name": "源起", "des": "万有自原人之身而出，神话从一场分解开始。" },
    { "source": "印度神话", "target": "梵天", "name": "创世", "des": "创造者端坐莲上，展开宇宙的第一页。" },
    { "source": "印度神话", "target": "毗湿奴", "name": "护持", "des": "每当秩序倾危，卧于蛇榻者便起身降世。" },
    { "source": "印度神话", "target": "湿婆", "name": "轮舞", "des": "毁灭即新生，火环中的舞步从不停止。" },
    { "source": "印度神话", "target": "罗摩", "name": "传诵", "des": "一位王子的流放与归来，唱成了最初的史诗。" },
    { "source": "印度神话", "target": "克里希纳", "name": "谋局", "des": "不执兵刃的御者，才是大战真正的掌盘者。" },
    { "source": "梨俱吠陀", "target": "原人普鲁沙", "name": "载咏", "des": "原人之歌藏于最古的颂集，种姓的想象由此而来。" },
    { "source": "吠陀", "target": "梨俱吠陀", "name": "最古", "des": "四吠陀之首，其余三典皆环绕它而成。" },
    { "source": "梵卵", "target": "梵天", "name": "孵化", "des": "金胎裂开，创世者自水中现身。" },
    { "source": "梨俱吠陀", "target": "阿耆尼", "name": "首颂", "des": "颂集以祭火开篇，神与人由火舌相连。" },
    { "source": "因陀罗", "target": "阿耆尼", "name": "孪生", "des": "雷神与火神的同源之说，一对神兄弟。" },
    { "source": "伐由", "target": "因陀罗", "name": "伴随", "des": "风为雷神先驱，风暴相随的战车双翼。" },
    { "source": "梨俱吠陀", "target": "因陀罗", "name": "颂主", "des": "约四分之一的颂歌献给掷杵者，吠陀第一战神。" },
