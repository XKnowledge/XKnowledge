    { "source": "毗湿摩", "target": "持国", "name": "祖辈", "des": "祖父之兄的族长，两系共同的长者。" },
    { "source": "毗湿摩", "target": "坚战", "name": "祖辈", "des": "箭床上的老人，向攻方的王子口授取胜之策。" },
    { "source": "恒河女神", "target": "毗湿摩", "name": "母子", "des": "天河之子，为父弃位不娶的誓言者。" },
    { "source": "德罗纳", "target": "阿周那", "name": "师承", "des": "「我若还有弟子，便不是你的老师」，偏爱成全了神射手。" },
    { "source": "德罗纳", "target": "难敌", "name": "师承", "des": "同一位老师教出两族，技艺不分善恶。" },
    { "source": "德罗纳", "target": "迦尔纳", "name": "拒授", "des": "出身之问挡在门外，师者的一念埋下祸根。" },
    { "source": "迦尔纳", "target": "难敌", "name": "知遇", "des": "比武场上的羞辱被一顶王冠化解，此命以报。" },
    { "source": "迦尔纳", "target": "阿周那", "name": "兄弟", "des": "同母的宿敌，至死不知彼此血缘的分量。" },
    { "source": "克里希纳", "target": "阿周那", "name": "御者", "des": "不执兵刃的黑天执缰，挚友的战车由他驱驰。" },
    { "source": "克里希纳", "target": "坚战", "name": "智囊", "des": "军队与非军队之间，他选择做般度族的军师。" },
    { "source": "薄伽梵歌", "target": "克里希纳", "name": "宣说", "des": "两军之间，御者向垂头的弓手开口。" },
    { "source": "薄伽梵歌", "target": "俱卢之野", "name": "开示", "des": "垂首的弓手在阵前听法，行动的哲学自此成立。" },
    { "source": "薄伽梵歌", "target": "梵", "name": "指归", "des": "千手的梵我之理，在战车上向阿周那显圣。" }
  ]
}
