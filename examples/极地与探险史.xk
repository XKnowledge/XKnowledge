  "version": 2,
  "nodes": [
    { "name": "极地与高山探险", "des": "地球两端与八千米之上的极端环境探险史：勇气、科学与灾难交织的白与高的史诗。", "symbolSize": 70, "category": "总纲" },
    { "name": "西北航道", "des": "北美北缘通往太平洋的设想水道，冻海之下四百年的执念与坟场。", "symbolSize": 60, "category": "北极航道" },
    { "name": "东北航道", "des": "北欧沿俄国海岸至白令海峡的水路，沙皇与列强接力测绘的海上门缝。", "symbolSize": 50, "category": "北极航道" },
    { "name": "大北方探险", "des": "1733至1743年俄国组织的北极海岸大普查，白令亦殒命于此的十年壮举。", "symbolSize": 40, "category": "北极航道" },
    { "name": "罗斯与帕里的探航", "des": "1818年起英国海军的系列北探，兰开斯特海峡与北极误撞的先驱组合。", "symbolSize": 40, "category": "北极航道" },
    { "name": "富兰克林失踪", "des": "1845年幽冥号与恐怖号全员失踪之谜，2014年起沉船才被找到的世纪悬案。", "symbolSize": 60, "category": "北极航道" },
    { "name": "南森与前进号", "des": "1893至1896年主动冻入浮冰随流漂移的科学豪赌，极点未至而方法永存。", "symbolSize": 60, "category": "北极航道" },
    { "name": "诺登舍尔德环欧亚", "des": "1878至1879年维加号首航贯通东北航道，环欧亚大陆一周的瑞典男爵。", "symbolSize": 40, "category": "北极航道" },
    { "name": "阿蒙森走通西北航道", "des": "1903至1906年约阿号小船历时三年走通西北航道，以小博大的典范。", "symbolSize": 40, "category": "北极航道" },
    { "name": "北极点之争", "des": "1909年皮里与库克互指造假的抵达悬案，极地探险史上最著名的罗生门。", "symbolSize": 50, "category": "北极航道" },
    { "name": "北极漂流站", "des": "1937年起苏联NP系列浮冰站，把浮冰当船用的极地科学城。", "symbolSize": 40, "category": "北极航道" },
    { "name": "南极英雄时代", "des": "1897至1922年南极探险的史诗窗口，以沙克尔顿之逝落幕的争胜年代。", "symbolSize": 60, "category": "南极英雄时代" },
    { "name": "别林斯高晋首见", "des": "1820年俄船东方号与和平号首见南极冰缘，环球双圈的高纬巡航。", "symbolSize": 40, "category": "南极英雄时代" },
    { "name": "罗斯探险", "des": "1839至1843年发现罗斯冰架与埃里伯斯火山，日后南极跳板的奠基巡航。", "symbolSize": 40, "category": "南极英雄时代" },
    { "name": "阿蒙森南极点", "des": "1911年12月14日狗拉滑雪五十五天抵达，效率美学的完胜。", "symbolSize": 60, "category": "南极英雄时代" },
    { "name": "斯科特南极点", "des": "1912年1月17日抵达却全员殒于归途，日记成英国悲剧美学的圣典。", "symbolSize": 60, "category": "南极英雄时代" },
    { "name": "坚忍号远征", "des": "1914至1917年船毁冰海、小艇渡怒海、全员生还的失败远征，领袖力教科书。", "symbolSize": 60, "category": "南极英雄时代" },
    { "name": "毛森远征", "des": "1911至1914年澳大利亚南极远征，同伴殒命独行百里的科学苦旅。", "symbolSize": 40, "category": "南极英雄时代" },
    { "name": "伯德与飞行时代", "des": "1929年伯德首次飞越南极点，机械时代取代雪橇英雄的开端。", "symbolSize": 40, "category": "南极英雄时代" },
    { "name": "英联邦横穿南极", "des": "1957至1958年富克斯与希拉里车辆纵队首次陆穿南极大陆。", "symbolSize": 40, "category": "南极英雄时代" },
    { "name": "南极条约", "des": "1959年签署的十四条宪章，冻结主权索取、只许和平与科学的大陆法。", "symbolSize": 60, "category": "南极英雄时代" },
    { "name": "南乔治亚与捕鲸业", "des": "南极海域的捕鲸站网络，坚忍号传奇的终点与南极产业史的暗面。", "symbolSize": 40, "category": "南极英雄时代" },
    { "name": "喜马拉雅黄金时代", "des": "1950至1964年十四座八千米全部首登的十四年，高原上的登山文艺复兴。", "symbolSize": 60, "category": "八千米高峰" },
    { "name": "安娜普尔纳首攀", "des": "1950年埃尔佐格率法队登顶，携冻截肢而归的胜利打开黄金时代。", "symbolSize": 50, "category": "八千米高峰" },
    { "name": "珠峰首攀", "des": "1953年5月29日希拉里与丹增登顶世界之巅，给加冕礼的献礼。", "symbolSize": 70, "category": "八千米高峰" },
    { "name": "乔戈里峰", "des": "8611米的K2，登顶死亡率远超珠峰的野蛮之山，2021年方有冬季首登。", "symbolSize": 50, "category": "八千米高峰" },
    { "name": "十四座八千米", "des": "全部十四座八千米高山的名单，1986年梅斯纳尔率先集齐的终极清单。", "symbolSize": 50, "category": "八千米高峰" },
    { "name": "无氧登顶", "des": "1978年梅斯纳尔与哈伯勒不带瓶装氧气登顶珠峰，改写人类极限定义。", "symbolSize": 50, "category": "八千米高峰" },
    { "name": "阿尔卑斯式攀登", "des": "轻装快速、结组直上的登山风格，对喜马拉雅围攻式大兵团的逆反。", "symbolSize": 40, "category": "八千米高峰" },
    { "name": "波兰冬季军团", "des": "八十年代专攻冬季首登的波兰登山家群，苦难美学的冰战士。", "symbolSize": 40, "category": "八千米高峰" },
    { "name": "阿蒙森", "des": "罗阿尔德·阿蒙森：走通西北航道、夺下南极点的挪威人，殒于北极救援飞行。", "symbolSize": 60, "category": "探险家群像" },
    { "name": "斯科特", "des": "罗伯特·斯科特：两次南极远征统帅，科学优先的固执与最后的伟大跋涉。", "symbolSize": 50, "category": "探险家群像" },
    { "name": "沙克尔顿", "des": "欧内斯特·沙克尔顿：三次远征未达极点，却以零阵亡成为领袖力之神。", "symbolSize": 50, "category": "探险家群像" },
    { "name": "南森", "des": "弗里乔夫·南森：滑雪横穿格陵兰、前进号漂流的设计者，后来成了外交家与诺贝尔奖得主。", "symbolSize": 50, "category": "探险家群像" },
    { "name": "乔治·马洛里", "des": "因为山就在那里的名言主人，1924年与欧文冲顶失踪，1999年遗骸重见。", "symbolSize": 50, "category": "探险家群像" },
    { "name": "埃德蒙·希拉里", "des": "新西兰养蜂人，珠峰首登者与南极大穿越的车队统帅，余生献给喜马拉雅民生。", "symbolSize": 50, "category": "探险家群像" },
    { "name": "丹增·诺盖", "des": "夏尔巴登山家，与希拉里同时站上世界之巅的两次尝试者。", "symbolSize": 40, "category": "探险家群像" },
    { "name": "梅斯纳尔", "des": "莱因霍尔德·梅斯纳尔：无氧登顶、首完十四座、 solo 直上新路线的世纪登山家。", "symbolSize": 60, "category": "探险家群像" },
    { "name": "田部井淳子", "des": "1975年首位登顶珠峰的女性，此后完成七大山峰的女性先驱。", "symbolSize": 40, "category": "探险家群像" },
    { "name": "雪橇犬与滑雪", "des": "挪威式机动的胜负手：狗队轮换拉橇、人踏雪板，阿蒙森效率的全部秘密。", "symbolSize": 50, "category": "技术与后勤" },
    { "name": "因纽特技术", "des": "雪屋、皮划艇、兽皮衣与狗队的千年智慧，极地探险者的活教科书。", "symbolSize": 50, "category": "技术与后勤" },
    { "name": "极地装备演进", "des": "从羊毛油布到企鹅服与合成纤维，从雪橇到飞机与履带车的百年迭代。", "symbolSize": 40, "category": "技术与后勤" },
    { "name": "破冰船", "des": "从1898年叶尔马克号到核动力舰队，以船首坡度骑冰压碎的工程答案。", "symbolSize": 40, "category": "技术与后勤" },
    { "name": "极地科考站", "des": "从毛森的小屋到阿蒙森-斯科特站与昆仑站，冰盖上的常年科学村落。", "symbolSize": 40, "category": "技术与后勤" },
    { "name": "极地口粮与营养", "des": " pemmican 肉砖、饼干与巧克力的高热量配方，坏血病与维C的百年补课。", "symbolSize": 40, "category": "技术与后勤" },
    { "name": "死亡地带生理学", "des": "8000米以上人体的极限地带：缺氧、代谢崩坏与判断力瓦解的医学地图。", "symbolSize": 40, "category": "灾难与救援" },
    { "name": "1996珠峰山难", "des": "风暴一日夺走八条生命的世纪山难，《进入空气稀薄地带》的行业警钟。", "symbolSize": 50, "category": "灾难与救援" },
    { "name": "2008K2惨案", "des": "冰塔崩落引发串坠与被困，十一人罹难的乔戈里峰黑色一天。", "symbolSize": 40, "category": "灾难与救援" },
    { "name": "高山救援体系", "des": "直升机、固定绳与专职协作队，把探险事故纳入现代应急的救援网络。", "symbolSize": 40, "category": "灾难与救援" },
    { "name": "气候变化与北极", "des": "海冰消融正把千年冰封航道变成季节性通航水道，地缘与生态双重变局。", "symbolSize": 50, "category": "现代极地" },
    { "name": "南极旅游", "des": "每年数万人到访的白色邮轮产业，条约体系下的旅行新边疆。", "symbolSize": 40, "category": "现代极地" },
    { "name": "商业登山", "des": "付费向导、氧气与固定绳的服务体系，把八千米变成清单经济的商品。", "symbolSize": 50, "category": "现代极地" },
    { "name": "极地资源与主权", "des": "油气、渔业与航道的利益角力，北极主权声索与南极冻结的攻防。", "symbolSize": 40, "category": "现代极地" },
    { "name": "国际极地年", "des": "1882年起四次联动的全球极地科学协作，数据基线与外交信任的老传统。", "symbolSize": 40, "category": "现代极地" }
