    { "source": "贝斯特拉", "target": "奥丁", "name": "母子", "des": "巨人女儿生下众神之父，血脉自此交错。" },
    { "source": "包尔", "target": "奥丁", "name": "父子", "des": "神族一系的直传，自包尔而至奥丁。" },
    { "source": "奥丁", "target": "尤弥尔", "name": "弑杀", "des": "三兄弟弑杀原初巨人，以其尸身筑造世界。" },
    { "source": "尤弥尔", "target": "世界树尤克特拉希尔", "name": "身化", "des": "血成海，肉成地，骨成山，巨树扎根其上。" },
    { "source": "兀儿德之泉", "target": "世界树尤克特拉希尔", "name": "浇灌", "des": "圣泉之水日日润泽树根，世界得以常青。" },
    { "source": "诺伦三女神", "target": "兀儿德之泉", "name": "守护", "des": "命运三姐妹居于泉畔，以泉水浇灌树根。" },
    { "source": "奥丁", "target": "芙丽嘉", "name": "配偶", "des": "众神之父与天空之后，神廷最尊贵的一对。" },
