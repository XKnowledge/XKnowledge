{
  "version": 2,
  "title": "北欧神话",
  "description": "从金伦加鸿沟的雾火相遇，到诸神黄昏的烈焰与新芽，神族、巨人、英雄与九界的谱系和命运。",
  "nodes": [
    { "name": "北欧神话", "des": "雾与火在鸿沟相遇的世界，诸神、巨人与英雄的命运之网自此铺展，而终局早已被命运三女神织定。", "symbolSize": 70, "category": "创世与原初" },
    { "name": "金伦加鸿沟", "des": "太初的裂谷，一端是冰雾的死寂，一端是烈焰的灼热，冷热相激，第一个活物由此凝结成形。", "symbolSize": 50, "category": "创世与原初" },
    { "name": "尤弥尔", "des": "原初巨人，霜雾所化的第一个活物，众神之祖亦是众神之敌，血肉最终成了大地与山海的材料。", "symbolSize": 50, "category": "创世与原初" },
    { "name": "欧德姆布拉", "des": "太初母牛，舔食冰上的盐霜舔出神明布尔，又以乳汁哺育尤弥尔，两个敌对种族由她分别滋养。", "symbolSize": 40, "category": "创世与原初" },
    { "name": "布尔", "des": "母牛自盐岩中舔出的第一位神明，包尔之父，奥丁血脉在冰与盐之间悄然开始的起点。", "symbolSize": 40, "category": "创世与原初" },
    { "name": "包尔", "des": "布尔之子，娶巨人之女贝斯特拉，生下奥丁三兄弟，神与巨人的血脉自此难分难解地交织。", "symbolSize": 40, "category": "创世与原初" },
    { "name": "贝斯特拉", "des": "巨人之女，嫁给包尔生下奥丁，神族的母亲竟出自敌族，姻亲与宿怨自此同根而生。", "symbolSize": 40, "category": "创世与原初" },
    { "name": "穆斯贝尔海姆", "des": "南方的烈火之国，先于大地与诸神存在，火巨人苏尔特尔持焰剑守界，终有一日焚尽世界。", "symbolSize": 40, "category": "创世与原初" },
    { "name": "尼福尔海姆", "des": "北方的冰雾之国，无数寒泉涌动的死寂之地，与烈焰之国隔沟相望，鸿沟的冷自它而来。", "symbolSize": 40, "category": "创世与原初" },
    { "name": "埃利伐加尔", "des": "太初的冰河群，寒水自尼福尔海姆奔涌注入鸿沟，冻结成最初的霜，是尤弥尔成形的摇篮。", "symbolSize": 40, "category": "创世与原初" },
    { "name": "兀儿德之泉", "des": "世界树下的圣泉，命运与过往在此沉淀，诸神每日渡过彩虹桥来泉边集会，审度世界的命运。", "symbolSize": 40, "category": "创世与原初" },
    { "name": "世界树尤克特拉希尔", "des": "贯通九界的巨梣树，三条根须分饮圣泉与深渊，枝叶承载诸神与人类，一切存在皆栖于其上。", "symbolSize": 50, "category": "创世与原初" },
    { "name": "奥丁", "des": "众神之父，以独眼换饮智慧之泉，悬于世界树九夜求得卢恩文字，既织就胜利也预知败亡。", "symbolSize": 60, "category": "阿萨神廷" },
    { "name": "芙丽嘉", "des": "奥丁之妻，天空之后，知晓一切命运却缄默不言，为爱子巴德尔问遍万物立誓，独漏了槲寄生。", "symbolSize": 50, "category": "阿萨神廷" },
    { "name": "索尔", "des": "雷神，红须的巨人克星，挥舞妙尔尼尔巡视东方边界，是阿斯加德最锋利的矛与最厚的盾。", "symbolSize": 60, "category": "阿萨神廷" },
    { "name": "希芙", "des": "索尔之妻，金发的丰收女神，被洛基剪去长发后换得黄金之发，从此金色麦穗随风起伏。", "symbolSize": 40, "category": "阿萨神廷" },
    { "name": "提尔", "des": "独手的战争与誓约之神，为缚魔狼押上手掌作保，一诺之下断腕，成为信义最重的化身。", "symbolSize": 40, "category": "阿萨神廷" },
    { "name": "巴德尔", "des": "光明之神，众神最钟爱的儿子，凶梦预示其死后，母亲问遍万物立誓，唯独漏掉了槲寄生。", "symbolSize": 50, "category": "阿萨神廷" },
    { "name": "南娜", "des": "巴德尔之妻，见夫身死当场殉情，与丈夫同眠于柴堆，等待诸神黄昏之后的重逢。", "symbolSize": 40, "category": "阿萨神廷" },
    { "name": "布拉基", "des": "诗歌之神，白须的吟游者，舌尖刻着卢恩纹章，蜜酒所化的灵感由他唱成人间诗篇。", "symbolSize": 40, "category": "阿萨神廷" },
    { "name": "伊登", "des": "青春女神，守护使诸神不老的金苹果，曾被巨人掳走，众神鬓生白霜方知她的分量。", "symbolSize": 40, "category": "阿萨神廷" },
    { "name": "海姆达尔", "des": "彩虹桥的守望者，九位母亲所生，能听见草的生长、看见百里之外，将在终局吹响号角。", "symbolSize": 50, "category": "阿萨神廷" },
    { "name": "霍德尔", "des": "双目失明的神，受洛基诱骗掷出槲寄生之箭，亲手杀死了兄长，成了宿命手中的那支箭。", "symbolSize": 40, "category": "阿萨神廷" },
    { "name": "维达", "des": "沉默之神，奥丁与巨人之子，厚靴踏地无声，诸神黄昏后将裂开魔狼之颚，为父复仇。", "symbolSize": 40, "category": "阿萨神廷" },
    { "name": "瓦利", "des": "诞生仅一日便长大成人的神，只为射杀霍德尔而降生，以血偿血，此后不洗面不梳发。", "symbolSize": 40, "category": "阿萨神廷" },
    { "name": "洛基", "des": "巨人之血混入神廷的变数，机巧与祸心并存，与奥丁结义又诞下三怪，终将引燃诸神黄昏。", "symbolSize": 60, "category": "阿萨神廷" },
    { "name": "诺伦三女神", "des": "兀儿德、薇儿丹蒂与诗蔻蒂，命运三姐妹，在树下汲泉浇灌，把众生的寿数织进命运之网。", "symbolSize": 40, "category": "阿萨神廷" },
    { "name": "阿斯加德", "des": "众神的城邦，十二王殿与黄金屋顶之地，以彩虹桥连结人间，也是终局之战的最前线。", "symbolSize": 40, "category": "阿萨神廷" },
    { "name": "尼奥尔德", "des": "海风与航船之神，华纳族的人质与使者，与雪靴女神联姻，海水与寒山之间各住九夜。", "symbolSize": 50, "category": "华纳与侏儒" },
    { "name": "弗雷", "des": "丰饶与阳光之神，华纳族最尊贵的公子，为爱情交出神剑，终将空手面对火巨人之王。", "symbolSize": 50, "category": "华纳与侏儒" },
    { "name": "弗蕾亚", "des": "爱与战争女神，华纳族的明珠，驾猫车巡游，泪水滴落成金，阵亡者的一半归她领有。", "symbolSize": 50, "category": "华纳与侏儒" },
    { "name": "古尔薇格", "des": "长枪般刺入神廷的华纳女巫，三次被焚三次自灰烬重生，她的火焰点燃了两大神族的战争。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "密米尔", "des": "智慧之泉的守护者，人质交换中被华纳族斩首，头颅经奥丁以药防腐，终日与之密谈。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "华纳海姆", "des": "华纳神族的家园，海洋与丰饶之神的老家，战后与阿斯加德互换人质，缔下两族之盟。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "斯瓦塔尔法海姆", "des": "侏儒的黑暗国度，山岩与地底深处的锻炉之乡，诸神所持的神器几乎皆出于此。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "布洛克", "des": "侏儒锻造师，与兄弟以头颅作保打赌，锻出雷神之锤，锤柄短了一截只因苍蝇的叮咬。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "辛德里", "des": "侏儒锻造大师，兄弟锻炉前的操锤者，永恒之枪与聚金魔戒皆出自他的炉火与巧手。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "妙尔尼尔", "des": "雷神之锤，掷出必中且自返手中，神廷最著名的兵器，也是巨人族世代恐惧的来源。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "冈格尼尔", "des": "奥丁的永恒之枪，刻着卢恩誓约，掷出必贯穿目标，誓言与命运随枪锋一同落定。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "德罗普尼尔", "des": "奥丁的聚金魔戒，每九夜滴生八枚同样的戒指，丰饶与循环的象征，后随巴德尔火葬。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "斯基德普拉特尼", "des": "弗雷的神奇宝船，可折叠收进口袋，展开足以承载全军，风向永远顺着他航向的方向。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "格莱普尼尔", "des": "侏儒以六种不存在之物织就的细索，看似丝带却缚住魔狼，薄如纱而坚于任何铁链。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "蜜酒", "des": "以智者克瓦希尔之血酿成的诗之蜜酒，饮者即成诗人，被奥丁盗回神域，诗才自此传于世间。", "symbolSize": 40, "category": "华纳与侏儒" },
    { "name": "法布提", "des": "洛基之父，名号「挥棒者」，如闪电般的巨人，与山崖女巨人劳菲结合生下火焰的化身。", "symbolSize": 40, "category": "巨人族" },
    { "name": "劳菲", "des": "洛基之母，针叶山崖间的女巨人，「柴薪」般轻盈的名字之下，藏着将焚及神廷的火种。", "symbolSize": 40, "category": "巨人族" },
    { "name": "安格尔波达", "des": "名号「带来哀伤者」，铁林的巨狼女，与洛基生下魔狼、尘世巨蟒与死亡女神三个孩子。", "symbolSize": 50, "category": "巨人族" },
    { "name": "蒂阿兹", "des": "鹰羽巨人，掳走伊登偷走青春金果，令诸神衰老，最终被追杀焚于阿斯加德的界墙边。", "symbolSize": 40, "category": "巨人族" },
    { "name": "斯卡蒂", "des": "雪靴与狩猎女神，为父之死向诸神索赔婚姻，山与海之争最终败给了海滩上的海鸥啼叫。", "symbolSize": 40, "category": "巨人族" },
    { "name": "乌特加德·洛基", "des": "外域的洛基，幻术巨人之王，用视错觉让雷神一行处处碰壁，让蛮力在幻象面前铩羽而归。", "symbolSize": 40, "category": "巨人族" },
    { "name": "赫朗格尼尔", "des": "石颅巨人，闯入阿斯加德饮酒逞凶，与索尔约定单挑，碎裂的头颅化作山岩至今立在荒原。", "symbolSize": 40, "category": "巨人族" },
    { "name": "格莉德", "des": "好心的女巨人，助索尔涉险渡河，赠他神力腰带与铁手套，亦是沉默之神维达的母亲。", "symbolSize": 40, "category": "巨人族" },
    { "name": "希密尔", "des": "海边巨人，与索尔同船出海垂钓，惊见巨蟒衔钩而大骇，割断钓线时吓得面色发青。", "symbolSize": 40, "category": "巨人族" },
    { "name": "瓦夫苏鲁特尼尔", "des": "博学的老巨人，与伪装的奥丁以性命为注斗诗问答，创世的秘辛在一问一答间流转。", "symbolSize": 40, "category": "巨人族" },
    { "name": "埃吉尔", "des": "海洋巨人，酿麦酒宴请诸神，金釜映照海面波光，他的九个女儿便是九种形态的海浪。", "symbolSize": 40, "category": "巨人族" },
    { "name": "约顿海姆", "des": "巨人的国度，世界东侧的荒寒之地，山岩与冰峰之间，是魔狼、石颅巨人与幻术师的家园。", "symbolSize": 40, "category": "巨人族" },
    { "name": "西吉", "des": "沃尔松格家族的始祖，传说为奥丁之后，猎场上的一怒杀人，开启了英雄血脉的第一章。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "西格蒙德", "des": "沃尔松格家族的支柱，唯一从树中拔出奥丁之剑的人，垂暮之年仍披甲为复国而战。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "西格妮", "des": "西格蒙德的孪生姐姐，为报父仇不惜易容与弟所生骨肉，最终在烈火中以身殉家。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "西格鲁德", "des": "屠龙的英雄，以重铸的格拉墨刺穿法夫纳，尝龙血而通鸟语，却困于命运与情爱的罗网。", "symbolSize": 60, "category": "英雄与沃尔松格" },
    { "name": "法夫纳", "des": "为独占家财弑父化龙的侏儒，盘踞荒原喷吐毒雾，是贪婪在传说里活成的鳞甲之形。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "雷金", "des": "法夫纳之弟，赫瑞德玛之子，能干的锻造师傅，怂恿养子屠龙夺金，最终死于养子剑下。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "格拉墨", "des": "奥丁插入百柱厅大树中的神剑，西格蒙德拔出，断裂后重铸，随西格鲁德刺穿龙之要害。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "格雷姆希尔德", "des": "吉克家族主母，精通迷药，一杯酒让西格鲁德忘却前盟，也为家族埋下血仇的种子。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "贡纳", "des": "吉克家族之王，得西格鲁德变形代聘布伦希尔德，终因贪恋黄金与兄弟合谋杀死义弟。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "霍格尼", "des": "贡纳之弟，冷静的谋士，与兄共谋杀死屠龙英雄，最终在匈奴王的地窖中被活活挖心。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "古德伦", "des": "吉克家族之女，先嫁屠龙英雄，再嫁匈奴之王，命运碾过她，她把复仇酿成一杯毒酒。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "布伦希尔德", "des": "命运最烈的女武神，沉睡于火焰环堡，被唤醒后为爱执拗赴死，火葬堆上殉夫而终。", "symbolSize": 50, "category": "英雄与沃尔松格" },
    { "name": "瓦尔基里", "des": "奥丁的天鹅少女战士，翱翔于战场之上挑选亡者，半数送往英灵殿，为终末之战蓄兵。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "阿提利", "des": "布伦希尔德之兄，匈奴之王，觊觎法夫纳的黄金设宴诱捕贡纳兄弟，死于古德伦的复仇。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "米德加尔特", "des": "人类的世界，世界树中段的陆岛，被尘世巨蟒环抱，凡人的城郭、麦田与战火所在。", "symbolSize": 40, "category": "英雄与沃尔松格" },
    { "name": "芬里尔", "des": "洛基与巨狼女的长子，上颚抵天、下颚触地的魔狼，诸神缚之于孤岛，终将吞下众神之父。", "symbolSize": 50, "category": "诸神黄昏与终局" },
    { "name": "耶梦加得", "des": "尘世巨蟒，环抱米德加尔特衔尾而眠，毒液漫过山海之日，便是终局到来之时。", "symbolSize": 40, "category": "诸神黄昏与终局" },
    { "name": "海拉", "des": "洛基之女，半身生肌半身腐肉的女王，冥府的统治者，冷面裁决亡魂的去留与赎金。", "symbolSize": 40, "category": "诸神黄昏与终局" },
    { "name": "斯库尔与哈提", "des": "追逐日月的双狼，魔狼芬里尔之子，终有一天追上太阳与月亮，把天空的光一口吞没。", "symbolSize": 40, "category": "诸神黄昏与终局" },
    { "name": "纳吉尔法", "des": "以死者指甲打造的恐怖巨船，凡人不剪指甲便是在为它添料，终局之日载着亡军渡海而来。", "symbolSize": 40, "category": "诸神黄昏与终局" },
    { "name": "苏尔特尔", "des": "火巨人之王，自穆斯贝尔海姆持焰剑而来，旧世界的每一寸草木都将臣服于他的火。", "symbolSize": 50, "category": "诸神黄昏与终局" },
    { "name": "芬布尔之冬", "des": "终局前连绵三年的大雪之冬，不见太阳，狼群相食，兄弟阋墙，人间秩序先于诸神死去。", "symbolSize": 40, "category": "诸神黄昏与终局" },
    { "name": "诸神黄昏", "des": "命运预演至尽的终局大战，神与巨人同归灰烬，旧世界沉入海中，新世界自灰烬里升起。", "symbolSize": 60, "category": "诸神黄昏与终局" },
    { "name": "维格利德平原", "des": "终局决战的平原，方圆百里的战场，两军自四面八方涌来，血将浸透每一寸土地。", "symbolSize": 40, "category": "诸神黄昏与终局" },
    { "name": "伊达沃尔平原", "des": "新世界的绿色平原，幸存诸神重聚之地，金棋重摆，巴德尔自冥府归来的欢宴所在。", "symbolSize": 40, "category": "诸神黄昏与终局" },
    { "name": "利夫与利芙诗拉希尔", "des": "藏身世界树浓荫中的人类始祖夫妇，终局的火与水都未能夺走他们，新人类由此繁衍。", "symbolSize": 40, "category": "诸神黄昏与终局" },
    { "name": "巴德尔归来", "des": "光明之神自死者之国归来的那个清晨，与幸存诸神在伊达沃尔重聚，旧怨在新阳光下消融。", "symbolSize": 40, "category": "诸神黄昏与终局" },
    { "name": "英灵殿", "des": "奥丁的战士殿堂，五百四十门，墙叠矛、梁架盾，阵亡勇士日日宴饮操练，只待终局一战。", "symbolSize": 40, "category": "诸神黄昏与终局" }
  ],
  "links": [
    { "source": "北欧神话", "target": "金伦加鸿沟", "name": "源起", "des": "一切自雾与火的裂谷开始，世界的第一页写着冷热相激。" },
    { "source": "北欧神话", "target": "奥丁", "name": "统摄", "des": "众神之父的神廷，是全图叙事最密集的中枢。" },
    { "source": "北欧神话", "target": "洛基", "name": "变数", "des": "血统之外的第八神，一切转折都藏在他的笑里。" },
    { "source": "北欧神话", "target": "西格鲁德", "name": "传诵", "des": "屠龙英雄的悲欢，是人间传唱最久的诗篇。" },
    { "source": "北欧神话", "target": "世界树尤克特拉希尔", "name": "架构", "des": "九界悬于一树，全图的坐标自此展开。" },
    { "source": "北欧神话", "target": "诸神黄昏", "name": "归宿", "des": "众神的黄昏既定，所有谱系都奔向同一个终点。" },
    { "source": "尼福尔海姆", "target": "金伦加鸿沟", "name": "寒雾", "des": "冰雾之国的寒气流入裂谷，凝成霜的原初之冰。" },
    { "source": "穆斯贝尔海姆", "target": "金伦加鸿沟", "name": "飞火", "des": "烈火之国的火星溅入裂谷，与寒冰相触相激。" },
    { "source": "金伦加鸿沟", "target": "尤弥尔", "name": "凝生", "des": "融霜滴落，聚成原初巨人，第一个活物睁眼。" },
    { "source": "埃利伐加尔", "target": "尼福尔海姆", "name": "发源", "des": "太初冰河自冰雾之国涌出，奔向鸿沟而去。" },
    { "source": "尤弥尔", "target": "欧德姆布拉", "name": "吮乳", "des": "巨人以母牛的乳汁为食，得以在荒芜中长大。" },
    { "source": "欧德姆布拉", "target": "布尔", "name": "舐生", "des": "母牛舔食盐岩，三日夜舔出神明的形体。" },
    { "source": "布尔", "target": "包尔", "name": "亲子", "des": "第一位神明的儿子，血脉在冰原上继续。" },
