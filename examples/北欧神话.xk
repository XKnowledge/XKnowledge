    { "source": "西格鲁德", "target": "古德伦", "name": "配偶", "des": "英雄与吉克之女的婚姻，以遗忘为地基。" },
    { "source": "贡纳", "target": "布伦希尔德", "name": "假聘", "des": "变形的西格鲁德替胆怯的王兄穿过了火墙。" },
    { "source": "布伦希尔德", "target": "贡纳", "name": "配偶", "des": "她以为嫁的是穿火墙的人，愤怒由此而生。" },
    { "source": "贡纳", "target": "古德伦", "name": "兄妹", "des": "吉克家的兄妹，共享黄金也共担血债。" },
    { "source": "霍格尼", "target": "贡纳", "name": "兄弟", "des": "谋士之弟与优柔之兄，合谋也同死。" },
    { "source": "布伦希尔德", "target": "西格鲁德", "name": "遗恨", "des": "真相揭开，她决意与负心人共赴死亡。" },
    { "source": "贡纳", "target": "西格鲁德", "name": "计杀", "des": "王兄终究听信枕边风，义弟血溅河畔。" },
    { "source": "西格鲁德", "target": "贡纳", "name": "义结", "des": "曾歃血为兄弟的两人，以背叛收场。" },
    { "source": "古德伦", "target": "阿提利", "name": "再嫁", "des": "丧夫的寡妇被娘家当筹码，改嫁匈奴王。" },
    { "source": "阿提利", "target": "贡纳", "name": "诱捕", "des": "假宴设局，只为逼出法夫纳的黄金。" },
    { "source": "阿提利", "target": "霍格尼", "name": "虐杀", "des": "冷静的谋士被活体挖心，至死不哼一声。" },
    { "source": "古德伦", "target": "阿提利", "name": "复仇", "des": "她杀子取心做成宴席，一把火烧尽王庭。" },
    { "source": "布伦希尔德", "target": "阿提利", "name": "兄妹", "des": "女武神与匈奴王是同母所出的兄妹。" },
    { "source": "布伦希尔德", "target": "古德伦", "name": "争执", "des": "两后斗气，一句「我夫穿过了火墙」点燃血案。" },
    { "source": "格雷姆希尔德", "target": "贡纳", "name": "母子", "des": "主母的每个决断，都把儿子推向深渊。" },
    { "source": "芬里尔", "target": "格莱普尼尔", "name": "受缚", "des": "丝带般的柔索缚住巨狼，挣断即预示终局。" },
    { "source": "提尔", "target": "格莱普尼尔", "name": "作保", "des": "他把手掌放进狼口作保，诚实以断腕为价。" },
    { "source": "提尔", "target": "芬里尔", "name": "失手", "des": "狼口合拢，战神自此只剩一只手。" },
    { "source": "芬里尔", "target": "诸神黄昏", "name": "吞主", "des": "挣脱之日，魔狼一口吞下众神之父。" },
    { "source": "奥丁", "target": "诸神黄昏", "name": "预知", "des": "他早已知道一切，仍日日为终局练兵。" },
    { "source": "奥丁", "target": "世界树尤克特拉希尔", "name": "悬吊", "des": "九夜倒悬，以自身为祭换来卢恩的秘文。" },
    { "source": "世界树尤克特拉希尔", "target": "诸神黄昏", "name": "振颤", "des": "巨梣在终局中抖动，比风声更骇人。" },
    { "source": "诺伦三女神", "target": "诸神黄昏", "name": "织定", "des": "命运之网早已织就，无神能够挣脱。" },
    { "source": "芬布尔之冬", "target": "诸神黄昏", "name": "先声", "des": "三年连绵的严冬，是终局递出的名帖。" },
    { "source": "芬布尔之冬", "target": "米德加尔特", "name": "肆虐", "des": "人间的秩序在暴雪中先于诸神崩塌。" },
    { "source": "纳吉尔法", "target": "诸神黄昏", "name": "载军", "des": "死指甲拼成的巨船，载着亡军驶向战场。" },
    { "source": "海拉", "target": "纳吉尔法", "name": "役使", "des": "冥府的亡者登船，女王的军队自死界而来。" },
    { "source": "海拉", "target": "尼福尔海姆", "name": "统领", "des": "半死的女王统治冰雾深处的亡者之国。" },
    { "source": "苏尔特尔", "target": "穆斯贝尔海姆", "name": "守门", "des": "火巨人之王持焰剑镇守烈火之国的边界。" },
    { "source": "苏尔特尔", "target": "诸神黄昏", "name": "焚世", "des": "焰剑挥落，世界在火中沉入海中。" },
    { "source": "弗雷", "target": "苏尔特尔", "name": "争锋", "des": "交出了神剑的丰饶之神，空手迎向火焰。" },
    { "source": "耶梦加得", "target": "诸神黄昏", "name": "涌毒", "des": "巨蟒自海中昂首，毒液漫过天空与大地。" },
    { "source": "索尔", "target": "耶梦加得", "name": "同殒", "des": "九步之后，雷神与巨蟒的仇恨一同落幕。" },
    { "source": "维达", "target": "芬里尔", "name": "裂颚", "des": "沉默之子一脚踩住狼下颚，双手撕裂魔狼。" },
    { "source": "维格利德平原", "target": "诸神黄昏", "name": "决战", "des": "百里的平原上，两军没有留任何退路。" },
    { "source": "巴德尔", "target": "海拉", "name": "求赎", "des": "万物哀求赎回光明，女王的条件无人能满足。" },
    { "source": "巴德尔归来", "target": "巴德尔", "name": "归返", "des": "旧世界焚尽之后，光明才被允许回来。" },
    { "source": "海拉", "target": "巴德尔归来", "name": "放归", "des": "亡者之国的女王松手，归还她扣下的光。" },
    { "source": "伊达沃尔平原", "target": "巴德尔归来", "name": "重聚", "des": "幸存的诸神在绿原重聚，金棋重新摆上。" },
    { "source": "南娜", "target": "巴德尔归来", "name": "相随", "des": "殉情的妻子随光明一同归来，再不分离。" },
    { "source": "利夫与利芙诗拉希尔", "target": "世界树尤克特拉希尔", "name": "藏身", "des": "浓荫蔽体，火与洪水都寻不到人类的最后血脉。" },
    { "source": "利夫与利芙诗拉希尔", "target": "米德加尔特", "name": "繁衍", "des": "晨光里他们醒来，人间的故事重新开始。" },
    { "source": "斯库尔与哈提", "target": "诸神黄昏", "name": "追逐", "des": "双狼终于咬住了日月，天空就此熄灭。" },
    { "source": "斯库尔与哈提", "target": "芬里尔", "name": "血裔", "des": "魔狼之子承父之志，追逐是天职。" },
    { "source": "耶梦加得", "target": "米德加尔特", "name": "环抱", "des": "巨蟒衔尾环抱人间，是边界也是枷锁。" },
    { "source": "阿斯加德", "target": "米德加尔特", "name": "虹桥", "des": "三色虹桥横跨两界，神与人往来其间。" }
