{
  "version": 2,
  "title": "三体宇宙",
  "description": "「宇宙就是一座黑暗森林」：从红岸的第一次回波到太阳系的二维化，公理、猜疑与威慑推着两个文明走向死神永生的终局。",
  "nodes": [
    { "name": "三体宇宙", "des": "刘慈欣以两条公理推出的冷酷宇宙：文明在猜疑中互猎，技术在爆炸中失衡，每一次善意的抬头都可能换来毁灭的回声。", "symbolSize": 70, "category": "宇宙全景" },
    { "name": "黑暗森林法则", "des": "宇宙社会学第一推论：宇宙就是一座黑暗森林，每个文明都是带枪的猎人——被发现即被消灭，善意无法证明善意。", "symbolSize": 60, "category": "宇宙社会学体系" },
    { "name": "宇宙社会学两公理", "des": "叶文洁留给罗辑的两块基石：生存是文明的第一需要；文明不断增长和扩张，而宇宙中的物质总量保持不变。", "symbolSize": 50, "category": "宇宙社会学体系" },
    { "name": "猜疑链", "des": "我不知道你是怎么想我怎么想你怎么想我的——无限递归的不信任，在星际距离与光速延迟下永远无法解开。", "symbolSize": 50, "category": "宇宙社会学体系" },
    { "name": "技术爆炸", "des": "文明的技术进步是加速曲线而非匀速直线：今天的猎人可能明天就被猎物反超，因此没人敢等。", "symbolSize": 40, "category": "宇宙社会学体系" },
    { "name": "黑暗森林打击", "des": "法则的执行层：光粒点穴、二向箔降维，清理从不确认目标——毁灭你，与你何干。", "symbolSize": 40, "category": "宇宙社会学体系" },
    { "name": "宇宙安全声明", "des": "自证无害的唯一途径：把本星系光速降到第三宇宙速度以下，织成黑域，把自己锁死在永远的摇篮里。", "symbolSize": 40, "category": "宇宙社会学体系" },
    { "name": "降维打击", "des": "用二向箔把三维世界压成一幅画：不是打败你，是把你的战场连同物理法则一并没收。", "symbolSize": 40, "category": "宇宙社会学体系" },
    { "name": "田园时代与降维战争", "des": "十维的田园时代以来，宇宙被一场场维度战争层层压薄——神级文明的战场，是物理常数本身。", "symbolSize": 40, "category": "宇宙社会学体系" },
    { "name": "归零者与宇宙重启", "des": "向全宇宙广播回归运动声明的超神器文明：请归还你们拿走的质量，让宇宙重新坍缩，回到田园时代。", "symbolSize": 40, "category": "宇宙社会学体系" },
    { "name": "三体星系", "des": "半人马座的三颗无规则恒星：一轮轮回的毁灭与重生，磨出了一个学会脱水等待的文明。", "symbolSize": 50, "category": "三体文明与游戏" },
    { "name": "三体人", "des": "科技远超人类却困于乱纪元的种族：思维透明、说不了谎，也无法理解计谋——直到他们遇到了人类。", "symbolSize": 50, "category": "三体文明与游戏" },
    { "name": "恒纪元与乱纪元", "des": "三颗恒星的礼物与诅咒：恒纪元里文明生长，乱纪元里一切归零，两百轮文明都在等待一个解不出的问题。", "symbolSize": 40, "category": "三体文明与游戏" },
    { "name": "脱水与浸泡", "des": "乱纪元的第一生存术：干燥成一张纤维皮，恒纪元来临再扔进水里醒来——文明的档案库人手一份。", "symbolSize": 40, "category": "三体文明与游戏" },
    { "name": "三体人的思维透明", "des": "思维即交流、没有谋略的民族性：他们读不懂《三国》也读不懂谎言，于是人类唯一的优势藏在大脑里。", "symbolSize": 40, "category": "三体文明与游戏" },
    { "name": "人列计算机", "des": "三体游戏里的名场面：三千万秦军举旗为门，人肉搭出一台冯·诺依曼结构——文明的算力曾以人为元件。", "symbolSize": 40, "category": "三体文明与游戏" },
    { "name": "三体舰队", "des": "一千艘星际战舰的远征军，百分之一光速，四百年航程：人类第一次看清倒计时的形状。", "symbolSize": 40, "category": "三体文明与游戏" },
    { "name": "智子", "des": "质子二维展开蚀刻的超级计算机：锁死地球基础物理、监视全人类、把倒计时打上视网膜——从工程师到女武士的万能精灵。", "symbolSize": 60, "category": "三体文明与游戏" },
    { "name": "三体游戏", "des": "ETO 发展成员的 VR 试炼场：周文王、墨子、秦始皇轮番登场，玩家通关之日即幻灭之时。", "symbolSize": 40, "category": "三体文明与游戏" },
    { "name": "1379号监听员", "des": "三体监听站的老守望者，一生无波的人生里发出那句改变两个世界的警告：不要回答！不要回答！！不要回答！！！", "symbolSize": 40, "category": "三体文明与游戏" },
    { "name": "红岸基地", "des": "大兴安岭雷达峰上的绝密工程：名义是监测，实为向太阳系外发送信息——人类递出第一把刀的窗口。", "symbolSize": 50, "category": "红岸与ETO" },
    { "name": "叶文洁", "des": "目睹父亲死于批斗场的天体物理学家：对人类文明彻底绝望后，在红岸按下发射键——她是两个世界的引路人，也是宇宙社会学的无名教母。", "symbolSize": 60, "category": "红岸与ETO" },
    { "name": "叶哲泰", "des": "清华物理教授，在批斗台上仍不肯违背物理事实，死于乱拳——绝望的种子从他的倒下那一刻埋进女儿心里。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "太阳增益反射", "des": "叶文洁的发现：把太阳当作超级天线增益发射，地球的呼喊第一次有了恒星的音量。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "伊文斯", "des": "物种共产主义者，继承了巨额遗产的救鸟青年：他想要的不是三体降临，是人类的终结。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "审判日号", "des": "ETO 的第二红岸基地，游弋的巨轮「审判日」：巴拿马运河上，它驶向了一排看不见的琴弦。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "地球三体组织", "des": "叶文洁为精神领袖、伊文斯为统领的地下组织：消灭人类暴政，世界属于三体——绝望者的弥撒。", "symbolSize": 50, "category": "红岸与ETO" },
    { "name": "降临派拯救派幸存派", "des": "ETO 的三条暗流：盼主降临的、真信其文明的、只想给子孙留船票的——同床异梦的末世同盟。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "古筝行动", "des": "纳米飞刃横陈运河的切割战：审判日号在四十余根琴弦上被削成薄片，硬盘里的背叛史落入人类之手。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "纳米飞刃", "des": "汪淼的「飞刃」材料：头发丝细度、强度堪比钢缆——基础研究的成果，第一次成了武器。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "科学边界", "des": "渗透各国前沿物理学家的神秘学会：实验结果「不讲道理」，成员接连自尽——智子导演的物理学不存在了。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "宇宙闪烁", "des": "整个宇宙对着一个人闪烁：汪淼看见的 3K 背景辐射波动，是智子在他视网膜上放映的恐吓片。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "幽灵倒计时", "des": "打在视野角落的 1200:00:00：不是幻觉，是警告——停下来，否则倒计时归零时你将消失。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "射手与农场主假说", "des": "神枪手与农场主的二维世界：规律未必是规律，物理定律可能只是更高存在的随意——杨冬遗言里的深渊。", "symbolSize": 40, "category": "红岸与ETO" },
    { "name": "面壁计划", "des": "利用人类思维不透明的最后优势：四位面壁者获得不受质询的绝对权力，把真实战略永远藏在心里。", "symbolSize": 40, "category": "面壁与威慑" },
    { "name": "泰勒", "des": "第一位面壁者：要建一支宏原子聚变的幽灵舰队，用人类的自杀式打击换取三体的迟疑——被自己的破壁人温柔肢解。", "symbolSize": 40, "category": "面壁与威慑" },
    { "name": "雷迪亚兹", "des": "第二位面壁者：研发巨型氢弹欲推落水星连锁砸向太阳——同归于尽式的讹诈，止步于一次会面。", "symbolSize": 40, "category": "面壁与威慑" },
    { "name": "希恩斯", "des": "第三位面壁者：以思想钢印给太空军注入必胜信念——破壁人是他最亲的人，胜利主义被印成了失败主义。", "symbolSize": 40, "category": "面壁与威慑" },
    { "name": "罗辑", "des": "玩世不恭的学者，被叶文洁的一句话推上祭坛：从雪湖木屋的梦幻人生到执剑五十四年——他一个人挡住了一个文明。", "symbolSize": 60, "category": "面壁与威慑" },
    { "name": "破壁人", "des": "ETO 为每位面壁者配备的解读者：「我是你的破壁人」——他们不需要看穿谎言，只需要看穿你。", "symbolSize": 40, "category": "面壁与威慑" },
    { "name": "思想钢印", "des": "希恩斯的神经科学产物：把命题直接烙进大脑，不经推理的绝对信念——伦理上不可逾越，战场上无人能敌。", "symbolSize": 40, "category": "面壁与威慑" },
    { "name": "咒语实验", "des": "罗辑以雪地工程向恒星 187J3X1 发出的「诅咒」坐标广播：五十年后那颗星熄灭了，黑暗森林从假说变成定律。", "symbolSize": 40, "category": "面壁与威慑" },
    { "name": "威慑纪元", "des": "罗辑建立黑暗森林威慑后的六十年和平：引力波开关在手，三体文明与地球文明彼此抵着对方的死穴。", "symbolSize": 50, "category": "面壁与威慑" },
    { "name": "执剑人", "des": "威慑纪元的最高存在：不眠不休地握着引力波开关，五十四年如一日——权力最小、责任最大的人。", "symbolSize": 40, "category": "面壁与威慑" },
    { "name": "引力波天线", "des": "威慑的剑柄：地面台站与万有引力号上的发射阵列，一旦启动，三体星系的坐标将响彻银河。", "symbolSize": 40, "category": "面壁与威慑" },
    { "name": "章北海", "des": "最彻底的胜利主义伪装成最坚定的失败主义：从太空军政委到前进四的劫舰者，他保住的是人类的火种而非舰队。", "symbolSize": 50, "category": "太空军与星舰" },
    { "name": "太空军", "des": "危机纪元组建的新军种：从被嘲笑的军服到两千艘战舰的舰队——人类用两百年攒出了一场葬礼的排场。", "symbolSize": 40, "category": "太空军与星舰" },
    { "name": "自然选择号", "des": "亚洲舰队的旗舰，前进四的化身：章北海以一人之身劫走它，为人类留了一条真正的活路。", "symbolSize": 40, "category": "太空军与星舰" },
    { "name": "东方延绪", "des": "自然选择号的舰长：把启动权限交出去的那一刻，她还没意识到自己见证的是人类文明的分岔。", "symbolSize": 40, "category": "太空军与星舰" },
    { "name": "蓝色空间号", "des": "黑暗战役的猎手、四维空间的闯入者：他们在水下打开了魔戒，也在万有引力号上按下了广播。", "symbolSize": 40, "category": "太空军与星舰" },
    { "name": "万有引力号", "des": "搭载引力波天线的追击舰：末日之战后与蓝色空间号在深空汇合，最终成为三体坐标的宣告者。", "symbolSize": 40, "category": "太空军与星舰" },
    { "name": "青铜时代号", "des": "黑暗战役的另一艘幸存舰：以同伴的躯体撑过饥饿返航归来，等来的却是人类法庭的审判。", "symbolSize": 40, "category": "太空军与星舰" },
    { "name": "黑暗战役", "des": "末日之战后残存战舰间的相互猎杀：燃料与配件只够一艘船回家——新人类的道德在太空中第一次剥落。", "symbolSize": 40, "category": "太空军与星舰" },
    { "name": "末日之战", "des": "两千艘战舰对一枚水滴的「胜利大游行」：三十分钟，人类太空武装力量全灭于绝对光滑的镜面之前。", "symbolSize": 50, "category": "太空军与星舰" },
    { "name": "水滴", "des": "强相互作用力探测器：镜面光滑到分子级别、坚不可摧、优美如一滴圣母的眼泪——毁灭你，与你何干。", "symbolSize": 50, "category": "太空军与星舰" },
    { "name": "掩体纪元", "des": "威慑崩溃后的最后一搏：人类躲进木星等气态巨行星的阴影，赌黑暗森林打击仍是点穴式的光粒。", "symbolSize": 40, "category": "掩体与降维纪元" },
    { "name": "星环集团", "des": "程心接手、维德掌舵的超级企业：从掩体工程的巨头到光速飞船的孤胆研发者，一个公司对抗整个联邦法律。", "symbolSize": 40, "category": "掩体与降维纪元" },
    { "name": "星环号", "des": "人类唯一一艘光速飞船：曲率驱动的白船，载着程心与艾AA驶出正在变成画的太阳系。", "symbolSize": 40, "category": "掩体与降维纪元" },
    { "name": "曲率驱动", "des": "以空间曲率航行的光速引擎：航迹会留下低光速的黑线——既是最快的船，也是最危险的签名。", "symbolSize": 40, "category": "掩体与降维纪元" },
    { "name": "黑域", "des": "把光速降到第三宇宙速度以下的星域级安全声明：进去的文明永远出不来，宇宙里最体面的自阉。", "symbolSize": 40, "category": "掩体与降维纪元" },
    { "name": "二向箔", "des": "一张卡片大小的降维武器：展开后以光速扩散的二维化平面，把太阳系连同它的历史压成一幅无限薄的画。", "symbolSize": 50, "category": "掩体与降维纪元" },
    { "name": "太阳系二维化", "des": "歌者随手掷出的清理：行星压成圆盘、人类摊成像素，凡·高的星空第一次成为物理现实。", "symbolSize": 40, "category": "掩体与降维纪元" },
    { "name": "歌者文明", "des": "银河清理员所在的低层神级文明：长膜、种子与弹星者的世界，毁灭一个恒星系只是每天例行的卫生工作。", "symbolSize": 40, "category": "掩体与降维纪元" },
    { "name": "云天明的童话", "des": "三颗童话里藏着的情报：深水王子、露珠与针眼画师——人类唯一一次收到来自敌营的情书与答卷。", "symbolSize": 40, "category": "掩体与降维纪元" },
    { "name": "汪淼", "des": "纳米材料学家，《三体》的第一视角：从幽灵倒计时到三体游戏，物理学家崩溃的现场记录人。", "symbolSize": 40, "category": "人物谱系" },
    { "name": "史强", "des": "大史：不懂数学但懂人间的警察，一句「倒计时的尽头是什么」点醒书里书外所有人——粗砺的常识主义。", "symbolSize": 50, "category": "人物谱系" },
    { "name": "杨冬", "des": "叶文洁之女，最纯粹的理论物理学家：当实验结果开始「不讲道理」，她比所有人先一步失去了活着的理由。", "symbolSize": 40, "category": "人物谱系" },
    { "name": "程心", "des": "两次手握人类命运的圣母式人物：爱所有人所以错了两次——刘慈欣写给道德的最锋利的情书。", "symbolSize": 50, "category": "人物谱系" },
    { "name": "艾AA", "des": "程心在冥王星时代收养的陪伴者：乐观得不像末世，是人类最后二十年里最亮的那点烟火气。", "symbolSize": 40, "category": "人物谱系" },
    { "name": "云天明", "des": "送出一颗星星、一个大脑、三个童话的男人：单恋的极限是跨越四光年为她的文明递一份答案。", "symbolSize": 40, "category": "人物谱系" },
    { "name": "维德", "des": "「前进！前进！！不择手段地前进！！！」：人类丛林性的化身，每次都选对、每次都输给人类自己的善良。", "symbolSize": 50, "category": "人物谱系" },
    { "name": "关一帆", "des": "蓝色空间号时代的学者、四维空间的亲历者：在宇宙尽头的漂流瓶里，陪程心走到时间的小宇宙外。", "symbolSize": 40, "category": "人物谱系" },
    { "name": "刘慈欣", "des": "山西娘子关电厂的工程师，在机房值班室写出中国科幻的巅峰：硬核的想象与冰冷的浪漫同源。", "symbolSize": 50, "category": "作品与影响" },
    { "name": "《三体》", "des": "2006 年的第一部：文革、红岸与三体游戏三线并进，把中国历史的伤痕接到宇宙尺度的冷酷上。", "symbolSize": 40, "category": "作品与影响" },
    { "name": "《黑暗森林》", "des": "2008 年的第二部：面壁与破壁的博弈、末日之战与黑暗战役——书名本身即剧透，读罢才懂其寒意。", "symbolSize": 40, "category": "作品与影响" },
    { "name": "《死神永生》", "des": "2010 年的终章：程心的两次抉择、太阳系二维化与小宇宙的漂流——宇宙很大，生活更大。", "symbolSize": 40, "category": "作品与影响" },
