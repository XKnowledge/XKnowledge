{"version":2,"nodes":[{"name":"土木工程","des":"用土、石、钢与混凝土同重力谈判的古老学科：让结构站立千年是它全部的尊严。","symbolSize":70,"category":"力学基础"},{"name":"材料力学","des":"杆件受拉压弯剪扭时的内力与变形分析，结构设计的语言起点。","symbolSize":50,"category":"力学基础"},{"name":"应力与应变","des":"内力密度与变形程度的度量，材料受力的一对基本词汇。","symbolSize":50,"category":"力学基础"},{"name":"弹性模量","des":"应力与应变的比值，材料刚度的身份证。","symbolSize":40,"category":"力学基础"},{"name":"弹性与塑性","des":"卸载能回弹的是弹性，留下永久变形的是塑性，破坏预报的分水岭。","symbolSize":40,"category":"力学基础"},{"name":"梁与弯曲","des":"承受横向荷载的杆件，弯矩图是土木人的心电图。","symbolSize":40,"category":"力学基础"},{"name":"桁架","des":"二力杆铰接的三角形骨架，用最少的材料撑起最大的跨度。","symbolSize":40,"category":"力学基础"},{"name":"拱","des":"把竖向压力转化为轴向推力的曲线智慧，罗马人的传家宝。","symbolSize":40,"category":"力学基础"},{"name":"扭转与剪切","des":"力偶绕轴与平行力错切，两种常被忽略的破坏策源地。","symbolSize":40,"category":"力学基础"},{"name":"疲劳","des":"循环荷载下裂纹缓慢生长，桥梁倒塌的无声前奏。","symbolSize":40,"category":"力学基础"},{"name":"蠕变","des":"恒载下变形随时间增长，混凝土徐变让桥梁十年后仍在下挠。","symbolSize":40,"category":"力学基础"},{"name":"结构力学","des":"把梁柱板壳组装成体系后的内力求解学。","symbolSize":50,"category":"力学基础"},{"name":"有限元分析","des":"把连续体切碎成单元近似求解，数字时代的结构实验室。","symbolSize":50,"category":"力学基础"},{"name":"荷载","des":"恒载、活载、风、雪与地震：结构要伺候的全部甲方。","symbolSize":40,"category":"力学基础"},{"name":"风荷载","des":"高层与大跨的主导侧向力，涡激振动是柔性结构的天敌。","symbolSize":40,"category":"力学基础"},{"name":"地震作用","des":"地面加速度激起的惯性力，抗震设计的核心假想敌。","symbolSize":40,"category":"力学基础"},{"name":"混凝土","des":"骨料加水泥水化的人造石：抗压强、抗拉弱，浇筑成型无所不能。","symbolSize":50,"category":"工程材料"},{"name":"钢筋混凝土","des":"钢筋受拉、混凝土受压的互补婚姻，现代文明的隐形骨骼。","symbolSize":50,"category":"工程材料"},{"name":"预应力混凝土","des":"先张拉钢筋再放张，让混凝土天生受压，裂缝被推迟的魔法。","symbolSize":50,"category":"工程材料"},{"name":"钢材","des":"强度高、延性好、可焊接，大跨与高层的首选。","symbolSize":40,"category":"工程材料"},{"name":"结构钢与型钢","des":"工字钢、H 型钢与箱形截面：轧制出来的标准肌肉。","symbolSize":40,"category":"工程材料"},{"name":"木材","des":"各向异性的天然纤维复合材料，古建与大跨屋顶的温情材料。","symbolSize":40,"category":"工程材料"},{"name":"砌体","des":"砖石砂浆垒叠的受压老臣，抗震是它的软肋。","symbolSize":40,"category":"工程材料"},{"name":"水泥","des":"熟料磨粉遇水硬化的胶凝材料，世界用量第二的人造物。","symbolSize":40,"category":"工程材料"},{"name":"骨料与配合比","des":"砂石级配与水灰比，混凝土配方的核心变量。","symbolSize":40,"category":"工程材料"},{"name":"高性能混凝土","des":"自密实、高强与纤维增强，材料工程师的进阶作品。","symbolSize":40,"category":"工程材料"},{"name":"碳纤维加固","des":"贴在结构表面的补强布，旧桥旧楼的经济续命术。","symbolSize":40,"category":"工程材料"},{"name":"结构设计","des":"在安全、适用、经济与耐久之间求平衡的决策艺术。","symbolSize":50,"category":"结构与设计"},{"name":"安全系数","des":"对不确定性的制度性让步，规范强制的保守余量。","symbolSize":40,"category":"结构与设计"},{"name":"极限状态设计","des":"承载力与正常使用两套验算，现代规范的骨架。","symbolSize":40,"category":"结构与设计"},{"name":"概念设计","des":"传力路径先于计算：好结构是想出来的，不是算出来的。","symbolSize":40,"category":"结构与设计"},{"name":"结构体系","des":"框架、剪力墙与筒体：高层建筑的骨骼选型。","symbolSize":40,"category":"结构与设计"},{"name":"高层结构","des":"高宽比控制与侧移限值，摩天楼的力学本质是一根悬臂梁。","symbolSize":40,"category":"结构与设计"},{"name":"大跨空间结构","des":"网壳、悬索与张拉整体：覆盖体育场的天穹智慧。","symbolSize":40,"category":"结构与设计"},{"name":"抗震设计","des":"小震不坏、中震可修、大震不倒的三水准设防。","symbolSize":40,"category":"结构与设计"},{"name":"隔震与消能","des":"铅芯橡胶垫与阻尼器，让结构柔性避震而非硬碰硬。","symbolSize":40,"category":"结构与设计"},{"name":"BIM","des":"建筑信息模型：设计施工运维共享一个三维数字底账。","symbolSize":40,"category":"结构与设计"},{"name":"桥梁","des":"跨越障碍的结构宣言，土木工程里最浪漫的分册。","symbolSize":50,"category":"桥梁工程"},{"name":"梁桥","des":"以受弯为主的朴素桥型，从简支到连续，中小跨度主力。","symbolSize":40,"category":"桥梁工程"},{"name":"拱桥","des":"推力结构的美学巅峰，从赵州桥到钢管混凝土系杆拱。","symbolSize":40,"category":"桥梁工程"},{"name":"悬索桥","des":"主缆抛物线吊起桥面，千米以上跨度的唯一选择。","symbolSize":40,"category":"桥梁工程"},{"name":"斜拉桥","des":"塔上斜索直接锚固梁体，刚度优于悬索的中间路线。","symbolSize":40,"category":"桥梁工程"},{"name":"悬臂梁桥","des":"从两岸向中间伸臂拼接，箱梁悬浇的主战场。","symbolSize":40,"category":"桥梁工程"},{"name":"桥墩与基础","des":"把上部荷载传入地层的竖向关节，深水基础是难点。","symbolSize":40,"category":"桥梁工程"},{"name":"支座与伸缩缝","des":"允许结构热胀冷缩与转动的活动关节。","symbolSize":40,"category":"桥梁工程"},{"name":"桥梁风振","des":"涡激、颤振与抖振：风与柔性结构的致命共舞。","symbolSize":40,"category":"桥梁工程"},{"name":"塔科马海峡桥","des":"1940 年风致扭转发散的世纪录像，桥梁风工程的起点。","symbolSize":40,"category":"桥梁工程"},{"name":"港珠澳大桥","des":"55 公里桥岛隧组合工程，现代跨海建造的博物馆。","symbolSize":40,"category":"桥梁工程"},{"name":"明石海峡大桥","des":"1991 米主跨的悬索纪录，抗震设计的日本答卷。","symbolSize":40,"category":"桥梁工程"},{"name":"赵州桥","des":"隋代敞肩石拱，一千四百年不倒的传世孤本。","symbolSize":40,"category":"桥梁工程"},{"name":"隧道","des":"穿山越水的地下通道，在围岩中抢空间的胆量工程。","symbolSize":50,"category":"隧道与地下工程"},{"name":"盾构法","des":"钢筒护盾下掘进拼装，软土地层安全掘进的神器。","symbolSize":50,"category":"隧道与地下工程"},{"name":"新奥法","des":"喷锚支护让围岩自承：围岩是盟友而非敌人的哲学转变。","symbolSize":40,"category":"隧道与地下工程"},{"name":"矿山法","des":"钻爆开挖的传统工法，硬岩山岭的看家本领。","symbolSize":40,"category":"隧道与地下工程"},{"name":"沉管隧道","des":"预制管段浮运沉放对接，水底通道的搭积木工艺。","symbolSize":40,"category":"隧道与地下工程"},{"name":"围岩","des":"隧道周围的岩体，既是荷载也是结构的一部分。","symbolSize":40,"category":"隧道与地下工程"},{"name":"喷锚支护","des":"喷混凝土加锚杆及时封闭岩面，新奥法的双手。","symbolSize":40,"category":"隧道与地下工程"},{"name":"英法海底隧道","des":"三条平行隧道贯通英吉利海峡，掘进机挖出的世纪工程。","symbolSize":40,"category":"隧道与地下工程"},{"name":"青函隧道","des":"53.9 公里贯通津轻海峡，世界最长海底铁路隧道。","symbolSize":40,"category":"隧道与地下工程"},{"name":"城市地下空间","des":"地铁、综合管廊与地下综合体：向下的城市新维度。","symbolSize":40,"category":"隧道与地下工程"},{"name":"大坝","des":"拦河蓄水的人造山脉，防洪灌溉发电的巨型水龙头。","symbolSize":50,"category":"大坝与水利"},{"name":"重力坝","des":"靠自重压住水推力的憨厚坝型，混凝土方量惊人。","symbolSize":40,"category":"大坝与水利"},{"name":"拱坝","des":"凸向上游的拱形壳体，把水压力传给两岸山体，薄而优雅。","symbolSize":40,"category":"大坝与水利"},{"name":"土石坝","des":"就地取材的碾压堆石坝，当地材料坝的集大成者。","symbolSize":40,"category":"大坝与水利"},{"name":"渗流","des":"水在坝体与地基孔隙中的暗流，管涌是溃坝的头号内鬼。","symbolSize":40,"category":"大坝与水利"},{"name":"扬压力","des":"坝底向上的水压托举，排水帷幕与廊道的对抗目标。","symbolSize":40,"category":"大坝与水利"},{"name":"泄洪","des":"洪水期的宣泄通道，消能防冲是设计的关键戏码。","symbolSize":40,"category":"大坝与水利"},{"name":"三峡大坝","des":"世界装机容量最大的水电站，防洪发电航运的世纪工程。","symbolSize":40,"category":"大坝与水利"},{"name":"胡佛大坝","des":"大萧条时代的混凝土拱形重力坝，美国工程的图腾。","symbolSize":40,"category":"大坝与水利"},{"name":"伊泰普水电站","des":"巴拉那河上的两国联营，曾长期保持发电量世界纪录。","symbolSize":40,"category":"大坝与水利"},{"name":"溃坝教训","des":"从提堂坝到 Oroville 泄洪道危机：水是最有耐心的对手。","symbolSize":40,"category":"大坝与水利"},{"name":"都江堰","des":"无坝引水的鱼嘴分水，两千余年仍在服役的活文物。","symbolSize":40,"category":"大坝与水利"},{"name":"土力学","des":"太沙基奠基的散粒体力学：土是骨架、水与气的三相体。","symbolSize":50,"category":"岩土地基"},{"name":"有效应力原理","des":"太沙基 1925：总应力等于有效应力加孔压，土力学的牛顿定律。","symbolSize":50,"category":"岩土地基"},{"name":"地基承载力","des":"土层支撑基础荷载的极限，超载即剪切破坏。","symbolSize":40,"category":"岩土地基"},{"name":"浅基础","des":"独立基础、条基与筏板：直接摊在浅层土上的底盘。","symbolSize":40,"category":"岩土地基"},{"name":"桩基础","des":"把荷载传到深部硬层的长杆，摩擦桩与端承桩两大家族。","symbolSize":40,"category":"岩土地基"},{"name":"沉井与地下连续墙","des":"深基础的两大工艺，桥梁锚碇与深基坑的围墙。","symbolSize":40,"category":"岩土地基"},{"name":"边坡稳定","des":"滑裂面上的抗滑与下滑拉锯，滑坡是最常见的地质灾害。","symbolSize":40,"category":"岩土地基"},{"name":"基坑工程","des":"城市深挖的支护之战：围护墙、支撑与降水三件套。","symbolSize":40,"category":"岩土地基"},{"name":"地基处理","des":"换填、强夯、排水固结与注浆：把软土调教合格的手艺。","symbolSize":40,"category":"岩土地基"},{"name":"太沙基","des":"土力学之父，把经验打桩变成计算科学的先驱。","symbolSize":40,"category":"岩土地基"},{"name":"布鲁内尔","des":"维多利亚时代的工程巨匠，大西方铁路与克莱夫顿悬索桥。","symbolSize":40,"category":"大师与反思"},{"name":"埃菲尔","des":"铁塔设计者，桥梁与结构钢时代的弄潮儿。","symbolSize":40,"category":"大师与反思"},{"name":"茅以升","des":"钱塘江大桥设计者，炸桥阻敌又亲手复建的民族脊梁。","symbolSize":40,"category":"大师与反思"},{"name":"结构健康监测","des":"传感器常驻桥坝，给结构做心电图。","symbolSize":40,"category":"大师与反思"},{"name":"工程伦理","des":"安全责任重于进度与成本，行业执照背后的道德契约。","symbolSize":40,"category":"大师与反思"}],"links":[{"source":"土木工程","target":"材料力学","name":"语言","des":"先学会描述受力，才谈得上设计结构。"},{"source":"土木工程","target":"桥梁","name":"宣言","des":"跨越是这门学科最浪漫的表达。"},{"source":"土木工程","target":"隧道","name":"胆量","des":"在千米岩层之下抢出空间。"},{"source":"土木工程","target":"大坝","name":"重器","des":"与江河对话的国之利器。"},{"source":"土木工程","target":"土力学","name":"地基","des":"一切结构最终都要交给大地。"},{"source":"土木工程","target":"工程伦理","name":"底线","des":"图纸上的每个数字都连着人命。"},{"source":"应力与应变","target":"弹性模量","name":"比值","des":"弹性阶段的应力应变之比即刚度。"},{"source":"弹性模量","target":"弹性与塑性","name":"定义域","des":"只在弹性范围内谈模量。"},{"source":"梁与弯曲","target":"材料力学","name":"求助","des":"弯矩与剪力的求解是材力的看家戏。"},{"source":"桁架","target":"材料力学","name":"简化为","des":"二力杆假设让静定分析成为可能。"},{"source":"拱","target":"应力与应变","name":"改写","des":"把弯矩转化为轴向压力，石头也能抗拉。"},{"source":"结构力学","target":"材料力学","name":"组装自","des":"单根杆件到整体体系的升维。"},{"source":"有限元分析","target":"结构力学","name":"数字化","des":"手算不可为的复杂体系交给单元网格。"},{"source":"荷载","target":"结构力学","name":"输入","des":"先有荷载组合，后有内力求解。"},{"source":"风荷载","target":"桥梁风振","name":"激发","des":"风流过钝体断面诱发振动。"},{"source":"地震作用","target":"抗震设计","name":"驱动","des":"抗震的一切手段都围绕惯性力展开。"},{"source":"疲劳","target":"钢材","name":"盯上","des":"钢桥在千万次车流下裂纹暗长。"},{"source":"蠕变","target":"混凝土","name":"内生于","des":"水化凝胶的粘弹性即徐变。"},{"source":"水泥","target":"混凝土","name":"胶结","des":"浆体把散粒骨料粘成整石。"},{"source":"骨料与配合比","target":"混凝土","name":"配制成","des":"强度、工作性与耐久性的配方核心。"},{"source":"混凝土","target":"钢筋混凝土","name":"强化为","des":"埋入钢筋补上抗拉短板。"},{"source":"钢筋混凝土","target":"预应力混凝土","name":"预压成","des":"先给混凝土上压应力，让裂缝迟迟不来。"},{"source":"高性能混凝土","target":"混凝土","name":"进化自","des":"超高层泵送与百年耐久的进阶需求。"},{"source":"碳纤维加固","target":"钢筋混凝土","name":"修补","des":"贴布补强，旧结构的微创手术。"},{"source":"钢材","target":"结构钢与型钢","name":"轧制为","des":"标准截面让设计与加工对接。"},{"source":"材料力学","target":"钢材","name":"描绘","des":"理想弹塑性曲线的标准模特。"},{"source":"材料力学","target":"混凝土","name":"描绘","des":"受压优异受拉怯懦的偏科生。"},{"source":"材料力学","target":"木材","name":"描绘","des":"顺纹横纹判若两材。"},{"source":"砌体","target":"抗震设计","name":"软肋于","des":"脆性材料最怕地震往复作用。"},{"source":"结构设计","target":"极限状态设计","name":"遵循","des":"承载能力与正常使用双验算。"},{"source":"安全系数","target":"极限状态设计","name":"体现为","des":"分项系数是安全系数的现代形态。"},{"source":"概念设计","target":"结构设计","name":"先于","des":"传力路径清晰，计算才有意义。"},{"source":"结构体系","target":"高层结构","name":"选型出","des":"框筒、筒中筒与束筒的谱系。"},{"source":"高层结构","target":"风荷载","name":"受制于","des":"侧移与舒适度由风控。"},{"source":"大跨空间结构","target":"桁架","name":"借力","des":"网架网壳是桁架思想的平面展开。"},{"source":"大跨空间结构","target":"拱","name":"借力","des":"刚性网格也能搭出拱的推力逻辑。"},{"source":"抗震设计","target":"地震作用","name":"抗衡","des":"三水准设防对三类地震动。"},{"source":"隔震与消能","target":"抗震设计","name":"软化","des":"从硬抗改为以柔克刚。"},{"source":"BIM","target":"结构设计","name":"数字化","des":"三维底账贯穿设计施工运维。"},{"source":"桥梁","target":"梁桥","name":"谱系","des":"受弯是最朴素的跨越方式。"},{"source":