{"version":2,"nodes":[{"name":"近体诗","des":"唐代成熟的格律诗体系，篇有定句、句有定字、字有定声，与古体诗相对，定型于初唐沈佺期、宋之问之手。","symbolSize":65,"category":"汉诗格律"},{"name":"平仄","des":"中古汉语平上去入四声归并为平仄两类后形成的声调对立，齐梁间由沈约等人发明，是近体诗的声律骨架。","symbolSize":60,"category":"汉诗格律"},{"name":"四声说","des":"齐梁周颙作《四声切韵》、沈约以四声调配诗文声律，中国诗歌由自然声韵进入自觉格律时代的起点。","symbolSize":50,"category":"汉诗格律"},{"name":"对仗","des":"律诗中间两联须词性、结构两两相对的平行句法，如杜甫「两个黄鹂鸣翠柳，一行白鹭上青天」。","symbolSize":50,"category":"汉诗格律"},{"name":"律诗","des":"近体诗代表体裁，八句四韵，五律四十字、七律五十六字，颔联颈联必须对仗，杜甫《登高》被誉为七律之冠。","symbolSize":50,"category":"汉诗格律"},{"name":"绝句","des":"四句一首的近体诗，五绝二十字、七绝二十八字，犹截律诗之半，盛唐王昌龄、李白将其推至巅峰。","symbolSize":50,"category":"汉诗格律"},{"name":"永明体","des":"南齐永明年间（483-493）沈约、王融等讲求四声声律的新体诗，近体诗的直接前身。","symbolSize":50,"category":"汉诗格律"},{"name":"平水韵","des":"金代刘渊 1252 年刊行的 107 韵系统，后世通行 106 韵，此后近体诗押韵一依此谱。","symbolSize":50,"category":"汉诗格律"},{"name":"粘对","des":"近体诗组合规则：联内句间平仄相对、联间平仄相粘，违者称失对失粘，唐代科举试帖诗严守此律。","symbolSize":50,"category":"汉诗格律"},{"name":"沈约","des":"441-513，南朝声律学领袖，首倡四声、附会八病，永明体核心人物，撰《宋书》兼通史学与音律。","symbolSize":40,"category":"汉诗格律"},{"name":"八病","des":"沈约等提出的平头、上尾、蜂腰、鹤膝等八种声病，齐梁人避忌的诗歌声律细则，唐代近体诗定形后多废弃。","symbolSize":35,"category":"汉诗格律"},{"name":"孤平","des":"近体诗韵句中除韵脚外只剩一个平声字的声病，被视为大忌，常须拗救避免。","symbolSize":35,"category":"汉诗格律"},{"name":"拗救","des":"句内平仄违格时在指定位置补偿的技巧，如五言「平平仄仄平」首字拗则第三字救。","symbolSize":35,"category":"汉诗格律"},{"name":"排律","des":"十句以上的律诗延伸体，除首尾联外通篇对仗，唐代科举试帖诗多用五言六韵排律。","symbolSize":35,"category":"汉诗格律"},{"name":"词牌","des":"词的曲调格律谱，调有定句、句有定字、字有定声，如《水调歌头》九十五字，现存词牌八百余调。","symbolSize":65,"category":"词与曲"},{"name":"曲牌","des":"散曲与剧曲的曲调谱，较词牌可加衬字、格律更活，元曲常用曲牌逾三百。","symbolSize":60,"category":"词与曲"},{"name":"填词","des":"依词牌平仄谱式填入文辞的创作方式，又称依声，宋以后文人的基本功。","symbolSize":50,"category":"词与曲"},{"name":"小令","des":"五十八字以内的短词，如《如梦令》三十三字；散曲中亦指单曲独立的作品，一名跨词曲两体。","symbolSize":50,"category":"词与曲"},{"name":"长调","des":"九十一字以上的慢词，柳永当年创制极多，《雨霖铃》《望海潮》皆其名篇。","symbolSize":50,"category":"词与曲"},{"name":"散曲","des":"元代兴盛的曲牌体抒情诗，分小令与套数两类，与杂剧合称元曲。","symbolSize":50,"category":"词与曲"},{"name":"宫调","des":"曲牌按十七宫调归属组织的系统，如【越调·天净沙】【双调·夜行船】，规定曲牌的调高与调式。","symbolSize":50,"category":"词与曲"},{"name":"柳永","des":"约 984-1053，北宋慢词大家，自称「奉旨填词柳三变」，创制长调极多，凡有井水处皆能歌柳词。","symbolSize":40,"category":"词与曲"},{"name":"周邦彦","des":"1056-1121，北宋词人，提举大晟府审定音律，格律精严，被尊为「词家之冠」。","symbolSize":40,"category":"词与曲"},{"name":"姜夔","des":"约 1155-1221，南宋词人音乐家，自度曲十七首旁缀工尺谱传世，《扬州慢》为其名作。","symbolSize":40,"category":"词与曲"},{"name":"马致远","des":"元代散曲大家，《天净沙·秋思》二十八字被誉为「秋思之祖」。","symbolSize":40,"category":"词与曲"},{"name":"《钦定词谱》","des":"康熙五十四年（1715）陈廷敬等奉敕编纂，收 826 调 2306 体，最完备的词谱总集。","symbolSize":35,"category":"词与曲"},{"name":"《水调歌头》","des":"九十五字词牌，苏轼 1076 年中秋所作「明月几时有」为其绝唱。","symbolSize":35,"category":"词与曲"},{"name":"十四行诗","des":"14 行格律诗型，源于意大利语 sonetto「小歌」，文艺复兴时期通行欧洲，分彼特拉克体与莎士比亚体两大系。","symbolSize":65,"category":"欧洲诗律"},{"name":"音步","des":"英诗格律基本节拍单位，由重读与非重读音节按固定序列组合成抑扬格、扬抑格等，是音节-重音体系的计量基础。","symbolSize":60,"category":"欧洲诗律"},{"name":"抑扬格五音步","des":"每行五个「轻-重」音步共十音节，英语诗第一格律，乔叟以降八百年主流。","symbolSize":50,"category":"欧洲诗律"},{"name":"英雄双韵体","des":"押韵的抑扬格五音步双行，17-18 世纪英诗主导体式，蒲柏《夺发记》为其极峰。","symbolSize":50,"category":"欧洲诗律"},{"name":"亚历山大体","des":"法语十二音节诗行，中间断为 6+6，11 世纪《罗兰之歌》至拉辛悲剧的法国标准诗行。","symbolSize":50,"category":"欧洲诗律"},{"name":"彼特拉克体","des":"十四行诗正体：前八行 abbaabba 加后六行两三韵，第九行处 volta 转折，彼特拉克《歌集》317 首定型。","symbolSize":50,"category":"欧洲诗律"},{"name":"莎士比亚体","des":"英体十四行诗：三个四行组 abab cdcd efef 加 gg 对句收束，萨里伯爵首创、莎士比亚 154 首定型。","symbolSize":50,"category":"欧洲诗律"},{"name":"无韵诗","des":"不押韵的抑扬格五音步，萨里译《埃涅阿斯纪》开例，莎士比亚戏剧与弥尔顿《失乐园》的体式。","symbolSize":50,"category":"欧洲诗律"},{"name":"三行连环韵","des":"aba bcb cdc 环环相扣的韵式，但丁《神曲》全篇一万四千余行的骨架。","symbolSize":50,"category":"欧洲诗律"},{"name":"斯宾塞体","des":"abab bcbc cdcd ee 的连环韵十四行，《仙后》作者斯宾塞 1590 年代创制，人称「诗人之诗人」。","symbolSize":50,"category":"欧洲诗律"},{"name":"彼特拉克","des":"1304-1374，意大利人文主义之父，《歌集》317 首十四行诗献给劳拉，使 sonnet 风行欧洲。","symbolSize":40,"category":"欧洲诗律"},{"name":"怀亚特","des":"1503-1542，英国外交官诗人，1530 年代把彼特拉克体十四行诗带入英语并改其韵式，与萨里同开英诗新境。","symbolSize":40,"category":"欧洲诗律"},{"name":"弥尔顿","des":"1608-1674，《失乐园》逾万行无韵诗，把 blank verse 从舞台推向史诗殿堂。","symbolSize":40,"category":"欧洲诗律"},{"name":"十四行诗第18首","des":"Shall I compare thee to a summer's day，1609 年四开本莎士比亚十四行诗集的首名篇。","symbolSize":35,"category":"欧洲诗律"},{"name":"龙萨","des":"1524-1585，法国七星诗社领袖，把彼特拉克体十四行与亚历山大体植入法语，《致爱莲娜》传世。","symbolSize":40,"category":"欧洲诗律"},{"name":"白朗宁夫人","des":"1806-1861，《葡萄牙人十四行诗》43 首，维多利亚时代十四行复兴的代表。","symbolSize":35,"category":"欧洲诗律"},{"name":"俳句","des":"世界最短定型诗，五-七-五共 17 音，必含季语，1890 年代正冈子规为其定名并确立独立地位。","symbolSize":65,"category":"东亚诗型"},{"name":"和歌","des":"日本古典定型诗总称，以五七音交替为基础，自《万叶集》至《新古今集》绵延千年。","symbolSize":60,"category":"东亚诗型"},{"name":"短歌","des":"五七五七七共 31 音的和歌主流体式，《新古今集》以降日本抒情诗的正宗。","symbolSize":50,"category":"东亚诗型"},{"name":"长歌","des":"五七反复、以七七收束的长篇和歌，《万叶集》中柿本人麻吕的挽歌为极峰。","symbolSize":50,"category":"东亚诗型"},{"name":"连歌","des":"二人以上连锁创作：五七五发句接七七胁句循环接力，室町时代达于大成。","symbolSize":50,"category":"东亚诗型"},{"name":"俳谐","des":"带谐谑趣味的连句，17 世纪经松尾芭蕉点铁成金，升华为高度艺术。","symbolSize":50,"category":"东亚诗型"},{"name":"季语","des":"表示季节的定语词，如「蛙」属春、「残雪」属初春，《岁时记》收录数千，俳句必具的时间坐标。","symbolSize":50,"category":"东亚诗型"},{"name":"音数律","des":"以五、七音节数交替为律的诗歌原理，直接取自汉诗五言七言，是和歌与俳句共同的音数基础。","symbolSize":50,"category":"东亚诗型"},{"name":"松尾芭蕉","des":"1644-1694，「俳圣」，《奥州小道》纪行与「古池や蛙飞び込む水の音」把俳谐推向艺术极峰。","symbolSize":40,"category":"东亚诗型"},{"name":"与谢芜村","des":"1716-1783，画家兼俳人，诗画一体，名句「菜の花や月は东日は西に」色彩如画。","symbolSize":40,"category":"东亚诗型"},{"name":"小林一茶","des":"1763-1827，江户后期俳人，「やせ蛙まけるな一茶これにあり」充满平民悲悯。","symbolSize":40,"category":"东亚诗型"},{"name":"正冈子规","des":"1867-1902，1890 年代以「写生」说革新俳句与短歌，为俳句定名，门下出高滨虚子等。","symbolSize":40,"category":"东亚诗型"},{"name":"《万叶集》","des":"八世纪成立的和歌总集，收 4500 余首，日本和歌传统的源头典籍。","symbolSize":50,"category":"东亚诗型"},{"name":"切字","des":"は、や、けり等收尾助词，为句断出余韵，俳句「切れ」韵味所在。","symbolSize":35,"category":"东亚诗型"},{"name":"加扎勒","des":"阿拉伯-波斯-乌尔都抒情诗型，5-15 个同韵对句串联，句尾复现副歌拉德夫，哈菲兹《迪万》为巅峰。","symbolSize":60,"category":"中东诗型"},{"name":"鲁拜","des":"波斯四行诗，AABA 韵式（第三行常逸韵），海亚姆约百首哲思鲁拜闻名世界。","symbolSize":50,"category":"中东诗型"},{"name":"卡西达","des":"阿拉伯颂体长诗，可逾百个对句，前伊斯兰「悬诗」即其形态，乌姆鲁勒·盖斯为祖师。","symbolSize":50,"category":"中东诗型"},{"name":"阿鲁德","des":"哈利勒·本·艾哈迈德 8 世纪创立的阿拉伯诗歌韵律学，把音节分长短组合出十六格律，沿用至今。","symbolSize":50,"category":"中东诗型"},{"name":"对句","des":"加扎勒的最小单元（sher），双行独立成意，且第二行押全诗统一韵脚。","symbolSize":50,"category":"中东诗型"},{"name":"拉德夫","des":"加扎勒每联句尾复现的一两个词或短语，听众闻声知体的听觉签名。","symbolSize":50,"category":"中东诗型"},{"name":"海亚姆","des":"1048-1131，波斯数学家诗人，《鲁拜集》传世约百首，四行之内谈宇宙生死。","symbolSize":40,"category":"中东诗型"},{"name":"哈菲兹","des":"约 1315-1390，波斯加扎勒大师，《迪万》近 500 首，苏菲神秘与人间之爱交织。","symbolSize":40,"category":"中东诗型"},{"name":"鲁米","des":"1207-1273，《玛斯纳维》25000 余对句，每两行自押一韵的叙事双行体，苏菲诗巅峰。","symbolSize":40,"category":"中东诗型"},{"name":"菲茨杰拉德","des":"1809-1883，1859 年自由意译《鲁拜集》，四版累销，维多利亚时代最畅销诗书之一。","symbolSize":35,"category":"中东诗型"},{"name":"哈利勒","des":"约 718-791，巴士拉语文学家，创阿鲁德十六格律并著《诗歌韵律书》，阿拉伯诗律学之父。","symbolSize":35,"category":"中东诗型"},{"name":"押韵","des":"语言单位尾音呼应的声音黏合技术，世界多数诗歌传统通用，从汉语韵书到英语 rhyme 皆围绕它展开。","symbolSize":65,"category":"韵律体系"},{"name":"头韵","des":"词首辅音重复，日耳曼、凯尔特与闪米特诗歌最古老的声律骨架，不依赖重音与韵脚。","symbolSize":60,"category":"韵律体系"},{"name":"脚韵","des":"落在诗行末的押韵，欧洲诗律最主要韵形态，也是 rhyme 一词的默认含义。","symbolSize":50,"category":"韵律体系"},{"name":"韵式","des":"脚韵在诗节内的排布图案，以字母标记为 ABAB、AABB 等式样，决定诗节的听觉建筑。","symbolSize":50,"category":"韵律体系"},{"name":"腹韵","des":"诗行内部或词内部的押韵，爱尔兰与威尔士诗歌的精深传统，乔伊斯《芬尼根守灵夜》大量使用。","symbolSize":50,"category":"韵律体系"},{"name":"音节计数诗","des":"只数音节不计重音的诗律，法语、日语、威尔士语等重音不显著语言的格律基础。","symbolSize":50,"category":"韵律体系"},{"name":"音节重音体系","des":"重音数与音节数双重计量的格律体系，英诗「五音步十音节五重音」即其标准形态，乔叟 14 世纪移植法语诗律时定型。","symbolSize":50,"category":"韵律体系"},{"name":"交叉韵","des":"ABAB 隔行交替韵式，英语民谣体的经典排布。","symbolSize":35,"category":"韵律体系"},{"name":"对韵","des":"AABB 相邻双行押韵，歌谣与英雄双韵体的基本式样。","symbolSize":35,"category":"韵律体系"},{"name":"环抱韵","des":"ABBA 包围式韵式，彼特拉克体十四行前八行的排布。","symbolSize":35,"category":"韵律体系"},{"name":"阴韵","des":"押韵音节后再带非重读音节（trembling/emptying），越出音步界限，英语诗晚出而精细的韵类。","symbolSize":35,"category":"韵律体系"},{"name":"半韵","des":"只押元音或只押辅音的不完全韵，哈代、狄兰·托马斯常用以制造松弛感。","symbolSize":35,"category":"韵律体系"},{"name":"眼韵","des":"拼写相同读音不同（love/prove），目押而耳不押，文艺复兴英诗常见通融。","symbolSize":35,"category":"韵律体系"},{"name":"定量诗律","des":"以元音长短而非重音计量的格律，古希腊拉丁诗与阿拉伯阿鲁德共用原理，文艺复兴学者试图移植英语未成。","symbolSize":35,"category":"韵律体系"},{"name":"《贝奥武甫》","des":"约 8-11 世纪古英语史诗 3182 行，每行四个重音、三个头韵、行中顿，头韵律的活标本。","symbolSize":50,"category":"韵律体系"},{"name":"自由诗","des":"弃固定音步、固定韵式与诗节定型的诗体，惠特曼开山，1912 年《诗刊》创刊后渐成英美诗主流。","symbolSize":65,"category":"现代诗革命"},{"name":"《草叶集》","des":"惠特曼 1855 年自费初版仅 12 首，此后九版扩增至 400 余首，长句排比自由体宣告英语诗的解放。","symbolSize":50,"category":"现代诗革命"},{"name":"意象主义","des":"1912-1917 年英美诗运动，庞德三原则主张直接处理意象、删弃废字，两行《在地铁站》为其标志。","symbolSize":50,"category":"现代诗革命"},{"name":"《荒原》","des":"艾略特 1922 年发表 434 行拼贴式自由诗，经庞德删削近半，现代诗歌的分水岭。","symbolSize":50,"category":"现代诗革命"},{"name":"视觉诗","des":"以字形、排布与页面空间参与表意的诗型总称，20 世纪初先锋派将其推向自觉。","symbolSize":50,"category":"现代诗革命"},{"name":"具象诗","des":"1950 年代瑞士与巴西兴起的极端视觉诗，语言材料彻底空间化、字形即图形，戈姆林格与德·梅洛为代表。","symbolSize":50,"category":"现代诗革命"},{"name":"图案诗","des":"古希腊以降把诗行排成翅膀、斧头、祭坛等形状的传统（technopaignion），巴洛克时期再度风行。","symbolSize":50,"category":"现代诗革命"},{"name":"惠特曼","des":"1819-1892，美国诗人，《草叶集》自由长句开英语自由诗先河，自道「我辽阔博大，我包罗万象」。","symbolSize":40,"category":"现代诗革命"},{"name":"庞德","des":"1885-1972，意象主义发起人，1913 年两行《在地铁站》浓缩俳句式拼贴，后著长诗《诗章》。","symbolSize":40,"category":"现代诗革命"},{"name":"阿波利奈尔","des":"1880-1918，《美好的文字》1918 年版收图诗，诗句排成雨丝、领带与心形，预言超现实主义。","symbolSize":40,"category":"现代诗革命"},{"name":"卡明斯","des":"1894-1962，以小写署名 e.e. cummings，拆字、乱序与版面游戏最激进的英语视觉诗人。","symbolSize":35,"category":"现代诗革命"},{"name":"马里内蒂","des":"1876-1944，1909 年《未来主义宣言》、1913 年《自由语宣言》，主张摧毁句法让字词自由。","symbolSize":35,"category":"现代诗革命"},{"name":"摩尔","des":"1887-1972，玛丽安·摩尔，自由诗外壳下暗藏严格音节计数，名句「诗中我亦不喜爱它」。","symbolSize":35,"category":"现代诗革命"}],"links":[{"source":"近体诗","target":"平仄","name":"骨架","des":"平仄对立是近体诗的声律骨架。"},{"source":"近体诗","target":"律诗","name":"代表","des":"律诗是近体诗最成熟的代表体裁。"},{"source":"近体诗","target":"绝句","name":"代表","des":"绝句是近体诗四句短制的代表。"},{"source":"近体诗","target":"排律","name":"延伸","des":"排律是律诗向长篇的规则化延伸。"},{"source":"律诗","target":"对仗","name":"中联","des":"律诗颔联颈联两联必须对仗。"},{"source":"排律","target":"对仗","name":"通篇","des":"排律除首尾联外通篇对仗。"},{"source":"四声说","target":"平仄","name":"二分","des":"平仄是四声按平与非平的二元归并。"},{"source":"沈约","target":"四声说","name":"首倡","des":"沈约与周颙并倡四声用于诗文。"},{"source":"沈约","target":"永明体","name":"核心","des":"沈约为永明体核心作家。"},{"source":"永明体","target":"八病","name":"避忌","des":"永明声律说附会八病避忌。"},{"source":"永明体","target":"近体诗","name":"前身","des":"永明体演进二百余年定为近体诗。"},{"source":"永明体","target":"四声说","name":"运用","des":"永明体以四声说调配诗句声调。"},{"source":"近体诗","target":"平水韵","name":"官韵","des":"后世近体诗押韵一依平水韵系。"},{"source":"律诗","target":"粘对","name":"遵循","des":"律诗联内相对、联间相粘。"},{"source":"平仄","target":"孤平","name":"大病","des":"孤平为近体诗第一大忌。"},{"source":"平仄","target":"拗救","name":"补救","des":"拗救使失律之句起死回生。"},{"source":"绝句","target":"律诗","name":"截律","des":"绝句犹截律诗之半，故又称截句。"},{"source":"词牌","target":"填词","name":"依谱","des":"填词即依词牌平仄谱式落笔。"},{"source":"词牌","target":"小令","name":"短体","des":"小令为五十八字以内的词牌短体。"},{"source":"词牌","target":"长调","name":"慢体","des":"长调为九十一字以上的慢词体式。"},{"source":"长调","target":"柳永","name":"拓制","des":"柳永大量创制长调使慢词与令词平分秋色。"},{"source":"填词","target":"周邦彦","name":"精律","des":"周邦彦提举大晟府精审定律。"},{"source":"词牌","target":"姜夔","name":"自度","des":"姜夔自度曲十七首并旁谱传世。"},{"source":"词牌","target":"《钦定词谱》","name":"著录","des":"《钦定词谱》著录 826 调 2306 体。"},{"source":"词牌","target":"《水调歌头》","name":"一调","des":"《水调歌头》为九十五字的具体词调。"},{"source":"曲牌","target":"散曲","name":"构成","des":"散曲以曲牌为单元成篇。"},{"source":"散曲","target":"马致远","name":"大家","des":"马致远《天净沙·秋思》为散曲绝唱。"},{"source":"曲牌","target":"宫调","name":"隶属","des":"曲牌分属各宫调而定调高调式。"},{"source":"散曲","target":"小令","name":"兼指","des":"小令在散曲中指单曲独立之体。"},{"source":"马致远","target":"宫调","name":"隶调","des":"《天净沙》属越调，为宫调隶曲牌之例。"},{"source":"词牌","target":"曲牌","name":"演化","des":"曲牌多自词牌演化而来，衬字更自由。"},{"source":"十四行诗","target":"彼特拉克体","name":"正体","des":"彼特拉克体为十四行诗的意大利正体。"},{"source":"十四行诗","target":"莎士比亚体","name":"英体","des":"莎士比亚体为十四行诗的英国变体。"},{"source":"十四行诗","target":"斯宾塞体","name":"变体","des":"斯宾塞体为十四行诗的第三大变体。"},{"source":"彼特拉克体","target":"彼特拉克","name":"定型","des":"彼特拉克《歌集》317 首定型此体。"},{"source":"莎士比亚体","target":"十四行诗第18首","name":"名篇","des":"第 18 首为莎体十四行的第一名篇。"},{"source":"怀亚特","target":"十四行诗","name":"引入","des":"怀亚特 1530 年代把十四行诗带入英语。"},{"source":"龙萨","target":"彼特拉克体","name":"移植","des":"龙萨把彼特拉克体移植入法语。"},{"source":"白朗宁夫人","target":"十四行诗","name":"复兴","des":"白朗宁夫人为维多利亚十四行复兴代表。"},{"source":"音步","target":"抑扬格五音步","name":"组成","des":"五个抑扬格音步叠成一行五音步。"},{"source":"抑扬格五音步","target":"英雄双韵体","name":"底格","des":"英雄双韵体即押韵的抑扬格五音步双行。"},{"source":"抑扬格五音步","target":"无韵诗","name":"行格","des":"无韵诗即不押韵的抑扬格五音步。"},{"source":"无韵诗","target":"弥尔顿","name":"登峰","des":"《失乐园》把无韵诗推上史诗高度。"},{"source":"抑扬格五音步","target":"十四行诗","name":"行基","des":"英体十四行以五音步行为基础。"},{"source":"斯宾塞体","target":"三行连环韵","name":"化用","des":"斯宾塞把连环韵织入十四行韵式。"},{"source":"亚历山大体","target":"龙萨","name":"推行","des":"七星诗社与龙萨推行亚历山大体。"},{"source":"抑扬格五音步","target":"亚历山大体","name":"对行","des":"英以重音计量、法以音节计量，两大标准诗行相对。"},{"source":"怀亚特","target":"彼特拉克体","name":"改译","des":"怀亚特改译彼特拉克并调整韵式。"},{"source":"弥尔顿","target":"彼特拉克体","name":"沿用","des":"弥尔顿十四行沿用意体韵式。"},{"source":"和歌","target":"短歌","name":"主流","des":"短歌 31 音为和歌的主流体式。"},{"source":"和歌","target":"长歌","name":"古体","des":"长歌为《万叶集》时代盛行的古体。"},{"source":"短歌","target":"连歌","name":"连锁","des":"连歌把短歌拆为五七五与七七两半接力。"},{"source":"连歌","target":"俳谐","name":"谐化","des":"俳谐连歌为连歌注入谐谑趣味。"},{"source":"俳谐","target":"俳句","name":"发句","des":"俳句即俳谐连句发句的独立成体。"},{"source":"俳句","target":"季语","name":"必备","des":"无季语不成俳句。"},{"source":"俳句","target":"切字","name":"余韵","des":"切字为俳句断出余韵。"},{"source":"俳句","target":"松尾芭蕉","name":"俳圣","des":"芭蕉把俳谐发句提纯为艺术。"},{"source":"松尾芭蕉","target":"与谢芜村","name":"后劲","des":"芜村为芭蕉之后的江户中期大家。"},{"source":"与谢芜村","target":"小林一茶","name":"后继","des":"一茶为江户后期俳坛殿军。"},{"source":"正冈子规","target":"俳句","name":"革新","des":"子规 1890 年代为俳句定名并革新。"},{"source":"正冈子规","target":"短歌","name":"写生","des":"子规以写生说同步革新短歌。"},{"source":"《万叶集》","target":"和歌","name":"本源","des":"《万叶集》为和歌传统的本源典籍。"},{"source":"和歌","target":"音数律","name":"基础","des":"和歌以五七音数律为音的基础。"},{"source":"俳谐","target":"季语","name":"季题","des":"俳谐讲季题，季语承之入俳句。"},{"source":"加扎勒","target":"对句","name":"串联","des":"加扎勒由 5-15 个同韵对句串联而成。"},{"source":"加扎勒","target":"拉德夫","name":"签名","des":"拉德夫复现为加扎勒的听觉签名。"},{"source":"哈菲兹","target":"加扎勒","name":"圣手","des":"哈菲兹近 500 首加扎勒登峰造极。"},{"source":"鲁拜","target":"海亚姆","name":"闻世","des":"海亚姆使鲁拜体闻名世界。"},{"source":"鲁拜","target":"菲茨杰拉德","name":"英译","des":"1859 年英译使鲁拜风靡英语世界。"},{"source":"鲁拜","target":"对句","name":"两组","des":"鲁拜即两个对句按 AABA 组合。"},{"source":"卡西达","target":"对句","name":"百联","des":"卡西达以数十上百对句铺陈。"},{"source":"鲁米","target":"对句","name":"变格","des":"《玛斯纳维》双行各自换韵，为对句变格。"},{"source":"阿鲁德","target":"哈利勒","name":"草创","des":"哈利勒草创阿鲁德十六格律。"},{"source":"加扎勒","target":"阿鲁德","name":"检律","des":"加扎勒以阿鲁德体系检核格律。"},{"source":"鲁拜","target":"加扎勒","name":"并流","des":"鲁拜与加扎勒为波斯抒情两大并行诗型。"},{"source":"卡西达","target":"加扎勒","name":"先型","des":"卡西达为加扎勒的对句先型。"},{"source":"押韵","target":"脚韵","name":"主形","des":"脚韵为押韵最主要的形态。"},{"source":"脚韵","target":"韵式","name":"布阵","des":"韵式即脚韵在诗节内的布阵图案。"},{"source":"韵式","target":"交叉韵","name":"隔行","des":"交叉韵为 ABAB 隔行布阵。"},{"source":"韵式","target":"对韵","name":"邻行","des":"对韵为 AABB 邻行布阵。"},{"source":"韵式","target":"环抱韵","name":"围合","des":"环抱韵为 ABBA 围合布阵。"},{"source":"押韵","target":"腹韵","name":"行内","des":"腹韵把押韵移入行内。"},{"source":"押韵","target":"半韵","name":"宽押","des":"半韵为押韵的不完全宽式。"},{"source":"押韵","target":"眼韵","name":"目押","des":"眼韵形似而音异，目押耳不押。"},{"source":"脚韵","target":"阴韵","name":"越步","des":"阴韵多一非重读尾音节而越出音步。"},{"source":"头韵","target":"《贝奥武甫》","name":"贯行","des":"《贝奥武甫》每行三个头韵贯串全诗。"},{"source":"头韵","target":"腹韵","name":"部位","des":"一个押在词首、一个押在行内，部位互补。"},{"source":"音节计数诗","target":"音节重音体系","name":"加压","des":"英语在音节数上再加重音计量成双重体系。"},{"source":"定量诗律","target":"音节重音体系","name":"移植","des":"文艺复兴学者把定量格律移植英语的失败实验。"},{"source":"头韵","target":"押韵","name":"对照","des":"日耳曼头韵传统与罗曼脚韵传统两大路线。"},{"source":"自由诗","target":"《草叶集》","name":"开山","des":"《草叶集》为英语自由诗开山之作。"},{"source":"《草叶集》","target":"惠特曼","name":"作者","des":"惠特曼 1855 年自费初版《草叶集》。"},{"source":"自由诗","target":"意象主义","name":"主潮","des":"意象派以自由诗为主力形式。"},{"source":"意象主义","target":"庞德","name":"立纲","des":"庞德 1912 年拟定意象派三原则。"},{"source":"庞德","target":"《荒原》","name":"删削","des":"庞德删削《荒原》成稿近半。"},{"source":"《荒原》","target":"自由诗","name":"峰作","des":"《荒原》为自由诗确立现代峰位。"},{"source":"视觉诗","target":"图案诗","name":"远祖","des":"希腊图案诗为视觉诗的远祖。"},{"source":"视觉诗","target":"具象诗","name":"激化","des":"具象诗把视觉诗推向字形即图形的极端。"},{"source":"视觉诗","target":"阿波利奈尔","name":"图诗","des":"阿波利奈尔《美好的文字》为图诗名作。"},{"source":"视觉诗","target":"卡明斯","name":"拆字","des":"卡明斯以拆字乱序玩弄版面。"},{"source":"马里内蒂","target":"视觉诗","name":"先声","des":"未来主义自由语为视觉诗先声。"},{"source":"马里内蒂","target":"自由诗","name":"废律","des":"自由语宣言连句法一并废去。"},{"source":"摩尔","target":"自由诗","name":"暗律","des":"摩尔自由诗外壳下藏严格音节数。"},{"source":"意象主义","target":"《荒原》","name":"师承","des":"艾略特经庞德沾溉意象派方法。"},{"source":"平水韵","target":"押韵","name":"分部","des":"平水韵为音节文字传统的押韵分部体系。"},{"source":"近体诗","target":"词牌","name":"诗余","des":"词号诗余，由近体增损衬字而衍生。"},{"source":"近体诗","target":"音数律","name":"东传","des":"日本五七音数律取自汉诗五七言。"},{"source":"填词","target":"音节计数诗","name":"同构","des":"依谱填字是最严格的音节定数写作。"},{"source":"亚历山大体","target":"音节计数诗","name":"定数","des":"法语诗行以十二音节定数为律。"},{"source":"音步","target":"音节重音体系","name":"节拍","des":"音步为音节-重音双重计量的节拍化。"},{"source":"自由诗","target":"音步","name":"反叛","des":"自由诗以弃固定音步立身。"},{"source":"对句","target":"英雄双韵体","name":"遥应","des":"东西方各自成熟的双行同韵单元遥相呼应。"},{"source":"俳句","target":"意象主义","name":"点拨","des":"俳句式拼贴点拨意象派短诗。"},{"source":"对句","target":"押韵","name":"落韵","des":"对句尾韵即脚韵的波斯形态。"},{"source":"阿鲁德","target":"定量诗律","name":"同原","des":"两者皆以音长而非重音计量。"},{"source":"摩尔","target":"音节计数诗","name":"暗用","des":"摩尔在自由诗中暗用音节计数。"},{"source":"音节计数诗","target":"音数律","name":"同理","des":"同为不依赖重音的音节定数体系。"},{"source":"对韵","target":"英雄双韵体","name":"双行","des":"英雄双韵体即对韵布阵的放大应用。"}],"title":"诗歌形式与格律","description":"从平仄四声到音步韵式，从词牌俳句到加扎勒鲁拜，再到自由诗与具象诗革命的全球诗歌形式谱系。"}