{"version":2,"nodes":[{"name":"围棋","des":"黑白二子围地争胜的古老棋戏，纵横十九道三百六十一路，规则至简而变化近无穷，本图一切脉络由此生发。","symbolSize":70,"category":"规则基础"},{"name":"气与提子","des":"棋子直线紧邻的空点为气，气尽之子即被提取离盘，围棋全部规则的细胞。","symbolSize":40,"category":"规则基础"},{"name":"禁着点","des":"落子后己方无气且不能提对方子的交叉点不得投子，保障对局不陷循环，规则的第二块基石。","symbolSize":40,"category":"规则基础"},{"name":"打劫与劫争","des":"提一子后对方不得立即回提的劫规，劫材多少决定天下大小劫争的胜负归属。","symbolSize":50,"category":"规则基础"},{"name":"目与地","des":"围住的空点为目，目数多寡即地盘大小，双方经营争夺的根本对象。","symbolSize":40,"category":"规则基础"},{"name":"贴目","des":"补偿黑棋先行之利的制度，从无贴目到四目半、五目半再到六目半，现代围棋公平性的标尺。","symbolSize":50,"category":"规则基础"},{"name":"中国规则数子法","des":"终局数活子定胜负，子空皆地，黑贴三又四分之三子，简明难起争议。","symbolSize":40,"category":"规则基础"},{"name":"日本规则比目法","des":"只数各自围住的目数并相抵比较，黑贴六目半，二十世纪棋界话语的主导规则。","symbolSize":40,"category":"规则基础"},{"name":"应氏规则计点制","des":"应昌期创立，以点数计地、黑贴八点，超时罚点而不径直判负，细致自成一系。","symbolSize":40,"category":"规则基础"},{"name":"棋份与让子","des":"分先、定先、先相先直至让二子九子，段位差决定行棋次序，旧时代棋界身份的刻度。","symbolSize":40,"category":"规则基础"},{"name":"终局与胜负计算","des":"双方连续虚手即终局，数子、比目或计点各依其规，一局棋的最后一道算术。","symbolSize":40,"category":"规则基础"},{"name":"座子制","des":"中国古代对局前黑白各置对角星位二子，布局被迫从边角展开，二十世纪初随日本棋制传入而废止。","symbolSize":40,"category":"规则基础"},{"name":"星位","des":"四路线与边线正中的交叉点，一手取角兼得外势，现代布局中使用率最高的占角点。","symbolSize":40,"category":"布局与定式"},{"name":"小目","des":"三路四路叠交的占角点，重实地而变化繁多，日本旧时代布局的正统起点。","symbolSize":40,"category":"布局与定式"},{"name":"三三","des":"三路正中一手净得角地，低位而确实，由俗手变为新布局利器的传奇一点。","symbolSize":40,"category":"布局与定式"},{"name":"目外与高目","des":"小目外侧与四五路的占角变着，轻角地而重外势，为角部攻防埋下伏笔。","symbolSize":40,"category":"布局与定式"},{"name":"金角银边草肚皮","des":"角上效率最高、边次之、中腹最亏的空间棋谚，围棋价值观的第一课。","symbolSize":50,"category":"布局与定式"},{"name":"大场与急场","des":"全局开阔处为大场，生死攻防处为急场，急场优先于大场是行棋的节拍器。","symbolSize":40,"category":"布局与定式"},{"name":"实地与厚势","des":"现时确定之地与未来潜力之势的取舍，贯穿布局选择与一切棋风分野的两极。","symbolSize":50,"category":"布局与定式"},{"name":"中国流","des":"星加小目再速占边路的布阵，二十世纪六十年代中国棋手集体使用而得名的高效布局。","symbolSize":40,"category":"布局与定式"},{"name":"秀策流","des":"小目开局、步步为营的坚实黑番下法，本因坊秀策御城棋全胜的象征。","symbolSize":40,"category":"布局与定式"},{"name":"小林流","des":"星与小目无忧角组合的重实布局，小林光一八十年代执黑胜率惊人的看家阵势。","symbolSize":40,"category":"布局与定式"},{"name":"三连星","des":"同边三个星位连成一线，弃角取势雄图中原，新布局时代的产物，至武宫正树而极。","symbolSize":40,"category":"布局与定式"},{"name":"宇宙流","des":"武宫正树独树一帜的棋风，弃边角实利而经营中腹大模样，浪漫主义的极致。","symbolSize":40,"category":"布局与定式"},{"name":"定式","des":"角部攻防约定俗成的两分变化，局部均衡的百科全书，理解重于背诵方能活用。","symbolSize":50,"category":"布局与定式"},{"name":"大雪崩定式","des":"小目挂角扭断而成的庞大变化，征子关系牵动全局，旧时职业棋士的必修难关。","symbolSize":40,"category":"布局与定式"},{"name":"妖刀定式","des":"由目外引出的大斜千变，路数诡奇号称妖刀出鞘，与雪崩并称定式中的险地。","symbolSize":40,"category":"布局与定式"},{"name":"新布局","des":"1933年吴清源与木谷实联手倡导，星位、三三、天元自由落子，解放边角教条的布局革命。","symbolSize":50,"category":"布局与定式"},{"name":"眼与真眼假眼","des":"被围之棋须有两只真眼方活，假眼可被点杀，一切死活判断的基石。","symbolSize":50,"category":"死活与手筋"},{"name":"直三曲三","des":"三目一团的两种基本形，中间一点即定其生死，死活计算的入门第一课。","symbolSize":40,"category":"死活与手筋"},{"name":"丁四刀把五","des":"方四一手难成两眼，刀把五被点柄部即死，膨胀过快的棋形反成棺材。","symbolSize":40,"category":"死活与手筋"},{"name":"板六","des":"六目长方的基本活形，两口内气即活，唯盘角板六成劫，角部死活的著名特例。","symbolSize":40,"category":"死活与手筋"},{"name":"盘角曲四","des":"角上曲四原则上净死，劫材尽在对方手中的特殊定例，日本规则径直判其为死棋。","symbolSize":40,"category":"死活与手筋"},{"name":"胀牯牛","des":"看似有眼却被塞成假眼的憋杀之形，死活题中最常设的陷阱。","symbolSize":40,"category":"死活与手筋"},{"name":"打劫活","des":"凭劫争维持一眼的活法，死活与劫材的联立方程，胜负常在此纠缠。","symbolSize":40,"category":"死活与手筋"},{"name":"死活题","des":"给定局部求杀或求活的功课，古今棋手每日必修，棋力养成的核心训练。","symbolSize":50,"category":"死活与手筋"},{"name":"发阳论","des":"四世井上因硕桑原道节所著死活秘笈，门内秘传二百余年，难度冠绝古典。","symbolSize":40,"category":"死活与手筋"},{"name":"官子谱","des":"清初陶式玉辑官子与死活巨著，收题千五百余，手筋与收官的百科全书。","symbolSize":40,"category":"死活与手筋"},{"name":"手筋","des":"局部攻防中高效妙手的总称，一击而局面改观，棋艺锋芒之所系。","symbolSize":50,"category":"死活与手筋"},{"name":"枷","des":"不与敌子接触而隔空罩吃的取子手筋，飞枷尤宜封吃征子不利之子。","symbolSize":40,"category":"死活与手筋"},{"name":"挖","des":"突入对方两子间隙制造断点的强手，乱战中寻求转机的常用手段。","symbolSize":40,"category":"死活与手筋"},{"name":"渡","des":"贴边爬行连通本体的手筋，治孤求活的地下通道。","symbolSize":40,"category":"死活与手筋"},{"name":"倒脱靴","des":"故意送吃数子再利用断点反杀的手筋，舍与取的华彩转换。","symbolSize":40,"category":"死活与手筋"},{"name":"镇神头","des":"唐代顾师言一子解双征的绝艺，日本国王子瞠目而退，棋史上最早流传的名局手筋。","symbolSize":40,"category":"死活与手筋"},{"name":"愚形与好形","des":"重复凝滞为愚形，轻灵高效为好形，棋形的感觉既是审美的也是计算的。","symbolSize":40,"category":"死活与手筋"},{"name":"打入","des":"深入对方阵地就地求活或转身的强袭手段，中盘战斗最常见的导火索。","symbolSize":40,"category":"中盘与官子"},{"name":"侵消","des":"以肩冲、镇头等浅削手段消减对方模样，不与死活相搏，火候重于深度。","symbolSize":40,"category":"中盘与官子"},{"name":"治孤","des":"将孤棋安顿、做活乃至反戈一击的艺术，坂田荣男与赵治勋的招牌绝技。","symbolSize":40,"category":"中盘与官子"},{"name":"腾挪","des":"弃子转身、借力打力的轻功，处于劣势局部求得转寰的枢机。","symbolSize":40,"category":"中盘与官子"},{"name":"官子","des":"终局前划定疆界的收束功夫，先后手与大小次序的排列组合，半目胜负决于此。","symbolSize":50,"category":"中盘与官子"},{"name":"先手与后手","des":"对方必须应答为先手，否则即后手，一手之差动辄逆转全局，价值判断的第一标尺。","symbolSize":40,"category":"中盘与官子"},{"name":"逆收官子","des":"抢先收掉对方先手官子的后手之着，价值按两倍计的收官算术。","symbolSize":40,"category":"中盘与官子"},{"name":"目数计算","des":"将每一手官子折算为目数再排定次序的价值度量，职业棋手的算盘功夫。","symbolSize":40,"category":"中盘与官子"},{"name":"尧造围棋传说","des":"晋人张华《博物志》托名尧造围棋以教子丹朱，为这项棋戏给出最早的文化授权。","symbolSize":40,"category":"棋史与棋家"},{"name":"烂柯传说","des":"樵夫王质入石室山观仙人对局，一局未终斧柯已烂，人间百年，围棋时间隐喻的源头。","symbolSize":40,"category":"棋史与棋家"},{"name":"弈秋","des":"《孟子》所载通国之善弈者，诲二人弈而专心致志的寓言，史上第一位留名的棋手。","symbolSize":40,"category":"棋史与棋家"},{"name":"王积薪","des":"唐玄宗朝第一国手棋待诏，相传撰棋道十诀，马嵬驿夜闻妇姑口弈的传奇主角。","symbolSize":40,"category":"棋史与棋家"},{"name":"黄龙士","des":"清初棋圣，十八岁成国手，棋风幽玄灵动，与徐星友十局血泪篇传为佳话。","symbolSize":40,"category":"棋史与棋家"},{"name":"范西屏","des":"乾隆棋圣，落子如飞灵变似仙，与施襄夏当湖争锋，中国古代棋艺的最高峰。","symbolSize":40,"category":"棋史与棋家"},{"name":"施襄夏","des":"与范西屏并世的双圣之一，棋风严谨绵密，著《弈理指归》传后世。","symbolSize":40,"category":"棋史与棋家"},{"name":"当湖十局","des":"乾隆间范施在当湖对弈留下的十余局杀谱，惊心动魄，座子棋时代的巅峰对决。","symbolSize":40,"category":"棋史与棋家"},{"name":"本因坊算砂","des":"京都寂光寺僧日海，织田信长惊为名人，开本因坊家，日本职业棋士制度的源头。","symbolSize":40,"category":"棋史与棋家"},{"name":"江户四大家","des":"本因坊、井上、安井、林四家受幕府俸禄分掌棋界，家元合议推举名人棋所，明争暗斗二百余年。","symbolSize":50,"category":"棋史与棋家"},{"name":"名人与棋所","des":"技艺至尊者称名人，全国唯一而终身；执掌棋界行政之职为棋所，二者合一即棋界之主。","symbolSize":40,"category":"棋史与棋家"},{"name":"丈和","des":"十二世本因坊，腕力雄强古今无双，天保年间吐血之局压服井上家挑战。","symbolSize":40,"category":"棋史与棋家"},{"name":"御城棋","des":"幕府将军御前一年一度的正式对局，江户四大家荣辱所系，秀策在此写下全胜纪录。","symbolSize":40,"category":"棋史与棋家"},{"name":"本因坊秀策","des":"幕末天才，御城棋十九局全胜，一子不苟的坚实棋风，霍乱早逝未及名人位。","symbolSize":50,"category":"棋史与棋家"},{"name":"耳赤之局","des":"1853年秀策对幻庵因硕，第127手耳赤之妙令满盘转机，棋感直觉的传世名局。","symbolSize":40,"category":"棋史与棋家"},{"name":"本因坊秀哉","des":"二十一世本因坊，最后的世袭名人，1938年引退，让名之举开启头衔战时代。","symbolSize":40,"category":"棋史与棋家"},{"name":"方圆社","des":"1879年村濑秀甫创立的近代棋社，办刊物、售棋谱、平价发免状，推动棋界近代化。","symbolSize":40,"category":"棋史与棋家"},{"name":"日本棋院","des":"1924年大仓喜七郎出资合并各派而成，统一段位与棋战制度，现代职业围棋的基座。","symbolSize":40,"category":"棋史与棋家"},{"name":"本因坊战","des":"1939年开赛的日本第一大棋战，世袭名位自此改为实力争夺的头衔。","symbolSize":40,"category":"棋史与棋家"},{"name":"新闻棋战","des":"报社主办棋战以棋谱招徕读者，读卖十番棋与七大棋战皆新闻资本所养，围棋近代化的输血管。","symbolSize":40,"category":"棋史与棋家"},{"name":"应昌期","des":"台湾实业家，倾家创立应氏规则与应氏杯，倡围棋规则大同的幕后巨人。","symbolSize":40,"category":"棋史与棋家"},{"name":"应氏杯","des":"1988年创办四年一届的世界围棋大赛，冠军奖金四十万美元，曹薰铉首届夺魁点燃韩国围棋热。","symbolSize":40,"category":"棋史与棋家"},{"name":"曹薰铉","des":"韩国围棋皇帝，柔风快枪，1989年首届应氏杯决赛胜聂卫平，开启韩国称霸二十年。","symbolSize":40,"category":"棋史与棋家"},{"name":"吴清源","des":"少年渡日的天才，新布局革命与读卖十番棋连破日本顶尖，令天下先的昭和棋圣。","symbolSize":50,"category":"棋史与棋家"},{"name":"木谷实","des":"与吴清源共创新布局，后开木谷道场育成大批超一流，内弟子制的人才工厂。","symbolSize":50,"category":"棋史与棋家"},{"name":"坂田荣男","des":"剃刀坂田，手筋与治孤的魔术师，1964年一年独揽七冠的空前纪录。","symbolSize":40,"category":"棋史与棋家"},{"name":"藤泽秀行","des":"棋圣六连霸的天才与浪子，屡率围棋访华团倾囊相授，中国棋界尊称秀行老师。","symbolSize":40,"category":"棋史与棋家"},{"name":"六超时代","des":"大竹英雄、林海峰、赵治勋、小林光一、武宫正树、加藤正夫并称六超，昭和末年日本围棋最后的黄金期。","symbolSize":40,"category":"棋史与棋家"},{"name":"武宫正树","des":"宇宙流宗师，弃边角实利经营中腹大模样，1988年夺得首届富士通杯，世界大赛冠军第一人。","symbolSize":40,"category":"棋史与棋家"},{"name":"赵治勋","des":"韩国赴日的斗魂，七番棋之魔，治孤与贴地缠斗的极致，头衔数冠绝日本棋史。","symbolSize":40,"category":"棋史与棋家"},{"name":"聂卫平","des":"中日围棋擂台赛三届主将十一连胜，掀起神州围棋热，中国棋圣称号由此而来。","symbolSize":50,"category":"棋史与棋家"},{"name":"中日围棋擂台赛","des":"1984年创办的中日团体对抗赛，聂卫平铸就铁闸神话，中国围棋复兴的引爆点。","symbolSize":50,"category":"棋史与棋家"},{"name":"马晓春","des":"妖刀般灵动的棋风，1995年连夺东洋证券杯与富士通杯，中国首位世界双冠。","symbolSize":40,"category":"棋史与棋家"},{"name":"常昊","des":"聂门弟子，韧劲十足的领军者，2005年应氏杯登顶，三夺世界冠军。","symbolSize":40,"category":"棋史与棋家"},{"name":"古力","des":"中国力量流代表，攻击凌厉，八项世界冠军，与李世石同期争霸一世。","symbolSize":40,"category":"棋史与棋家"},{"name":"李昌镐","des":"石佛，官子天下第一，面无表情的胜负机器，十七座世界冠军的绝对王者。","symbolSize":50,"category":"棋史与棋家"},{"name":"李世石","des":"叛逆不羁的力棋天才，十四个世界冠军，2016年对AlphaGo第四局下出神之一手，为人类取回一胜。","symbolSize":50,"category":"棋史与棋家"},{"name":"柯洁","des":"中国新生代领军，最年轻的八冠王，2017年乌镇迎战AlphaGo虽败犹荣。","symbolSize":50,"category":"棋史与棋家"},{"name":"申真谞","des":"绰号申工智能的韩国第一人，训练全面倚赖AI，2020年代世界大赛的常胜统治者。","symbolSize":40,"category":"棋史与棋家"},{"name":"琴棋书画","des":"文人四艺并称，棋居其间，既是游艺又是修养，围棋的士大夫身份由此确立。","symbolSize":50,"category":"围棋文化与AI"},{"name":"坐隐与手谈","des":"围棋的两个雅称，对坐如隐、落子代语，魏晋名士风度的注脚。","symbolSize":40,"category":"围棋文化与AI"},{"name":"棋经十三篇","des":"北宋张拟仿兵书体例论弈，宁输数子勿失一先等论影响千年，弈理论的元典。","symbolSize":40,"category":"围棋文化与AI"},{"name":"棋品九品","des":"南朝仿九品官人法品第棋手，自入神、坐照而下至守拙九等，柳恽奉敕撰棋品而定其制。","symbolSize":40,"category":"围棋文化与AI"},{"name":"棋道十诀","des":"相传王积薪所撰十句口诀，不得贪胜居首、弃子争先居四，从技进乎道的千年棋训。","symbolSize":50,"category":"围棋文化与AI"},{"name":"围棋外交","des":"陈毅元帅与日本政要借棋局往来，1960年代棋手互访先行于邦交正常化，小球之前的黑白先行。","symbolSize":40,"category":"围棋文化与AI"},{"name":"棋具","des":"榧木盘枰以刀刻漆线，蛤碁石与黑曜石子黑白分明，名器千金，为棋道增色。","symbolSize":40,"category":"围棋文化与AI"},{"name":"围棋西传","des":"德国人科歇尔特十九世纪七十年代在日本学棋后著书介绍，围棋自此入欧，俱乐部渐次生根。","symbolSize":40,"category":"围棋文化与AI"},{"name":"国际围棋联盟","des":"1982年成立的世界围棋组织，协调各洲协会，推动围棋进入世界智力运动会。","symbolSize":40,"category":"围棋文化与AI"},{"name":"AlphaGo","des":"DeepMind研发的围棋程序，2016年四比一胜李世石，深度学习与树搜索结合的里程碑。","symbolSize":50,"category":"围棋文化与AI"},{"name":"人机大战","des":"2016年首尔五番棋与2017年乌镇三番棋，AlphaGo接连击败李世石、柯洁，职业围棋范式自此改写。","symbolSize":50,"category":"围棋文化与AI"},{"name":"AlphaGo Zero","des":"抛弃人类棋谱从零自我对弈的版本，三日超越旧版，布局新知反哺人类棋界。","symbolSize":40,"category":"围棋文化与AI"},{"name":"蒙特卡洛树搜索","des":"以随机模拟评估局面再择优扩展的搜索框架，围棋AI突破僵局的关键引擎。","symbolSize":40,"category":"围棋文化与AI"},{"name":"策略网络与价值网络","des":"深度神经网络分别负责选点与胜率评估，与树搜索相济后棋力飞跃的AI架构。","symbolSize":40,"category":"围棋文化与AI"}],"links":[{"source":"围棋","target":"气与提子","name":"基石","des":"气尽提子，规则的全部细胞。"},{"source":"围棋","target":"目与地","name":"争胜","des":"围地多者为胜，三百六十一点即战场。"},{"source":"气与提子","target":"禁着点","name":"引出","des":"无气又不能提子的空点不得入子。"},{"source":"气与提子","target":"打劫与劫争","name":"特例","des":"互提一子的死循环由劫规截断。"},{"source":"打劫与劫争","target":"打劫活","name":"引出","des":"以劫争换取一眼的活法。"},{"source":"目与地","target":"日本规则比目法","name":"计量","des":"比目法只数围空，双方相抵见胜负。"},{"source":"目与地","target":"中国规则数子法","name":"计量","des":"数子法子空皆地，活子多者胜。"},{"source":"贴目","target":"日本规则比目法","name":"施行","des":"日本规则由五目半而六目半。"},{"source":"贴目","target":"中国规则数子法","name":"施行","des":"中国规则黑贴三又四分之三子。"},{"source":"贴目","target":"应氏规则计点制","name":"施行","des":"应氏规则黑贴八点，罚点代罚时。"},{"source":"应昌期","target":"应氏规则计点制","name":"创制","des":"倾毕生财力以计点制求规则大同。"},{"source":"应昌期","target":"应氏杯","name":"创办","des":"1988年创设四年一届的世界大赛。"},{"source":"应氏规则计点制","target":"应氏杯","name":"施行","des":"应氏杯为计点制规则的最大舞台。"},{"source":"棋份与让子","target":"贴目","name":"让位","des":"贴目制兴起后对局趋于分先平等。"},{"source":"围棋","target":"终局与胜负计算","name":"归结","des":"双方虚手终局，依规点目数子计点。"},{"source":"中国规则数子法","target":"应氏规则计点制","name":"发展","des":"应氏计点制自数子法改良而来。"},{"source":"本因坊算砂","target":"座子制","name":"废止","des":"日本改行空枰开局，布局天地顿开。"},{"source":"座子制","target":"星位","name":"预设","des":"座子即对角星位，起手四星。"},{"source":"座子制","target":"当湖十局","name":"依循","des":"范施巅峰对局仍在座子之下。"},{"source":"围棋","target":"棋份与让子","name":"序列","des":"分先定先直至让九子的对局格局。"},{"source":"金角银边草肚皮","target":"星位","name":"昭示","des":"星一手取角兼势，效率之选。"},{"source":"金角银边草肚皮","target":"小目","name":"昭示","des":"小目偏重实地与后续变化。"},{"source":"金角银边草肚皮","target":"三三","name":"昭示","des":"三三一手净得角地。"},{"source":"目外与高目","target":"小目","name":"变着","des":"目外高目弃角取势，与小目互为表里。"},{"source":"大场与急场","target":"金角银边草肚皮","name":"细化","des":"谚语指明方位，急场先于大场定次序。"},{"source":"实地与厚势","target":"大场与急场","name":"权衡","des":"取地取势的取向不同，大场选择随之而异。"},{"source":"星位","target":"三连星","name":"铺陈","des":"同边三星连成一线取势。"