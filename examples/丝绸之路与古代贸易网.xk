{
  "version": 2,
  "nodes": [
    { "name": "丝绸之路", "des": "1877年李希霍芬命名的欧亚动脉，实为无数纵横商路织成的千年路网。", "symbolSize": 70, "category": "干道与路网" },
    { "name": "绿洲丝路", "des": "长安经河西走廊、西域绿洲至河中与波斯的经典主干，驼铃与烽燧串起的走廊。", "symbolSize": 60, "category": "干道与路网" },
    { "name": "草原丝绸之路", "des": "沿欧亚草原带东西横贯的北方高速路，游牧民族与皮毛马匹的大道。", "symbolSize": 50, "category": "干道与路网" },
    { "name": "海上丝绸之路", "des": "从广州泉州经南海、马六甲至波斯湾的帆船航路，瓷器时代的海上动脉。", "symbolSize": 60, "category": "干道与路网" },
    { "name": "西南丝绸之路", "des": "蜀身毒道：自成都经云南入缅甸达印度的古道，早于张骞的民间商道。", "symbolSize": 40, "category": "干道与路网" },
    { "name": "茶马古道", "des": "滇川藏之间以茶易马的山地网络，横断山峡谷里的千年盐茶互市。", "symbolSize": 50, "category": "干道与路网" },
    { "name": "香料之路", "des": "印度洋季风航路上的胡椒、丁香与肉桂，海路上的按斤称金。", "symbolSize": 50, "category": "干道与路网" },
    { "name": "琥珀之路", "des": "波罗的海琥珀南运地中海的史前商路，比丝路古老数千年的北方珠链。", "symbolSize": 40, "category": "干道与路网" },
    { "name": "撒哈拉黄金商路", "des": "骆驼驮着西非黄金与沙漠盐块北抵地中海的旱路，加纳与马里的财富之源。", "symbolSize": 40, "category": "干道与路网" },
    { "name": "长安", "des": "丝路东端的百万人口帝都，西市胡商云集的国际都会。", "symbolSize": 60, "category": "枢纽城市" },
    { "name": "敦煌", "des": "河西走廊咽喉，四百年石窟画廊与藏经洞的锁钥之城。", "symbolSize": 60, "category": "枢纽城市" },
    { "name": "喀什", "des": "葱岭脚下的十字路口，翻越帕米尔前最后的绿洲大邑。", "symbolSize": 40, "category": "枢纽城市" },
    { "name": "撒马尔罕", "des": "粟特人的都城、帖木儿的帝都，传说中贴金镶玉的东方明珠。", "symbolSize": 50, "category": "枢纽城市" },
    { "name": "布哈拉", "des": "河中商城与伊斯兰学术重镇，丝路中段的知识与货栈双中心。", "symbolSize": 40, "category": "枢纽城市" },
    { "name": "梅尔夫", "des": "呼罗珊的绿洲要邑，一夜之间被蒙古屠为白地的世界之城。", "symbolSize": 40, "category": "枢纽城市" },
    { "name": "巴格达", "des": "阿拔斯轮子之城，智慧宫里翻译希腊与印度知识的贸易终点港。", "symbolSize": 50, "category": "枢纽城市" },
    { "name": "君士坦丁堡", "des": "欧亚桥头堡，丝路货物入地中海的最后一道帝国税卡。", "symbolSize": 50, "category": "枢纽城市" },
    { "name": "威尼斯", "des": "潟湖商邦，垄断东地中海转口贸易的白银之城。", "symbolSize": 50, "category": "枢纽城市" },
    { "name": "泉州", "des": "刺桐港，宋元东方第一大港，万国商船云集的梯航门户。", "symbolSize": 50, "category": "枢纽城市" },
    { "name": "广州", "des": "通海夷道的起点，唐代设市舶使的千年外贸南门。", "symbolSize": 40, "category": "枢纽城市" },
    { "name": "马六甲", "des": "香料咽喉与东西洋十字闸口，五方语言杂处的港城。", "symbolSize": 40, "category": "枢纽城市" },
    { "name": "丝绸", "des": "给这条路命名的商品，罗马人为之一掷千金的中国软黄金。", "symbolSize": 60, "category": "贸易品" },
    { "name": "瓷器", "des": "海上丝路的压舱主角，易碎却利润惊人的白色黄金。", "symbolSize": 50, "category": "贸易品" },
    { "name": "茶叶", "des": "从唐饼茶到俄蒙砖茶，越洋跨山成瘾的东方叶子。", "symbolSize": 40, "category": "贸易品" },
    { "name": "香料", "des": "胡椒、丁香、肉桂与乳香，中世纪欧洲按克论价的厨房黄金。", "symbolSize": 50, "category": "贸易品" },
    { "name": "汗血马", "des": "费尔干纳盆地的天马，汉武帝为之两征大宛的种马外交。", "symbolSize": 40, "category": "贸易品" },
    { "name": "玻璃器", "des": "罗马与波斯的透明珍玩东销，与丝绸西行恰成对流。", "symbolSize": 40, "category": "贸易品" },
    { "name": "青金石", "des": "巴达赫尚深山里的天堂之蓝，从法老面具到敦煌壁画的颜色。", "symbolSize": 40, "category": "贸易品" },
    { "name": "纸张", "des": "改变知识成本的商品，比丝绸更深刻地重塑了欧亚书写史。", "symbolSize": 40, "category": "贸易品" },
    { "name": "毛织与地毯", "des": "波斯地毯与草原毛毡，驮在驼背上的流动家居。", "symbolSize": 40, "category": "贸易品" },
    { "name": "珊瑚与宝石", "des": "地中海珊瑚东销中国，红蓝宝石与珍珠沿路回流的双向珍玩。", "symbolSize": 40, "category": "贸易品" },
    { "name": "粟特商人", "des": "丝路贸易的专业中介民族，从撒马尔罕到长安的跨国商网操盘手。", "symbolSize": 60, "category": "商人与商帮" },
    { "name": "波斯商人", "des": "萨珊与伊斯兰时代的海陆双栖商团，中介贸易的长期玩家。", "symbolSize": 40, "category": "商人与商帮" },
    { "name": "阿拉伯商人", "des": "印度洋季风的主人，从巴士拉到广州的海路网络经营者。", "symbolSize": 40, "category": "商人与商帮" },
    { "name": "拉赫德犹太商团", "des": "九世纪横跨法兰西至中国的犹太商人联盟，语言与信用的跨国网络。", "symbolSize": 40, "category": "商人与商帮" },
    { "name": "骆驼商队", "des": "四足的物流系统，一峰骆驼一担货，绿洲间距即它的续航单位。", "symbolSize": 50, "category": "商人与商帮" },
    { "name": "商队旅馆", "des": "丝路沿线的客栈堡垒，人畜歇脚、情报交换与信用见证的三合一场所。", "symbolSize": 40, "category": "商人与商帮" },
    { "name": "晋商与万里茶道", "des": "清代山西商帮自武夷山贩茶至恰克图的南茶北销干线。", "symbolSize": 40, "category": "商人与商帮" },
    { "name": "市舶司", "des": "宋元管理海外贸易的海关机构，抽解与博买撑起财政的海上门房。", "symbolSize": 40, "category": "商人与商帮" },
    { "name": "造纸术西传", "des": "751年怛罗斯之战后战俘工匠西去，撒马尔罕纸坊开启百年西渐。", "symbolSize": 60, "category": "技术与思想传播" },
    { "name": "印刷术西传", "des": "雕版与活字沿路西行，古腾堡之前的六个世纪东方已在印书。", "symbolSize": 40, "category": "技术与思想传播" },
    { "name": "火药西传", "des": "炼丹炉里的意外配方，经蒙古西征改写欧亚战争史的黑色旅行。", "symbolSize": 40, "category": "技术与思想传播" },
    { "name": "佛教东传", "des": "白马驮经入洛阳，石窟、梵呗与犍陀罗艺术沿路东来的千年思潮。", "symbolSize": 60, "category": "技术与思想传播" },
    { "name": "伊斯兰教东传", "des": "从广州怀圣寺光塔到泉州清净寺，海陆两路的信仰东渐。", "symbolSize": 40, "category": "技术与思想传播" },
    { "name": "景教", "des": "入华的聂斯脱里派基督教，《大秦景教流行中国碑》的实证。", "symbolSize": 40, "category": "技术与思想传播" },
    { "name": "摩尼教", "des": "从波斯流亡东来的光明信仰，从回鹘国教到福建霞浦的千年潜伏。", "symbolSize": 40, "category": "技术与思想传播" },
    { "name": "数字与天文", "des": "印度数字经阿拉伯接力西传，托勒密与历法知识东西互授。", "symbolSize": 40, "category": "技术与思想传播" },
    { "name": "乐舞与乐器", "des": "琵琶、箜篌与胡旋舞东来，笙与鼓乐西往的欧亚声音之路。", "symbolSize": 40, "category": "技术与思想传播" },
    { "name": "黑死病沿路", "des": "1347年蒙古军帐下的喀法城，商路同时也是疫路，欧洲三分之一人口的代价。", "symbolSize": 50, "category": "技术与思想传播" },
    { "name": "拜占庭金币", "des": "索里得金币，数百年币值稳定的丝路国际硬通货。", "symbolSize": 40, "category": "货币与信用" },
    { "name": "萨珊银币", "des": "丝路东段流通量最大的银币，河西安西出土成千枚的德拉克马。", "symbolSize": 40, "category": "货币与信用" },
    { "name": "飞钱与汇票", "des": "唐飞钱与伊斯兰汇票，免押运现钱的远程信用工具。", "symbolSize": 40, "category": "货币与信用" },
    { "name": "粟特文古信札", "des": "敦煌长城烽燧下发现的四世纪初粟特商函，丝路贸易的一手账本。", "symbolSize": 40, "category": "货币与信用" },
    { "name": "关市与商税", "des": "从玉门关验传到伊斯兰市场税，商路上层层缴纳的通行成本。", "symbolSize": 40, "category": "货币与信用" },
    { "name": "张骞凿空", "des": "前138年与前119年两使西域，史册所谓凿空，丝路的国家级开篇。", "symbolSize": 60, "category": "兴衰与现代回响" },
    { "name": "班超与西域都护", "des": "投笔从戎的经营者在西域三十一年，重开丝路的东汉支柱。", "symbolSize": 40, "category": "兴衰与现代回响" },
    { "name": "蒙古治世", "des": "十三世纪蒙古大一统下的商路安全期，货物与信仰畅行无阻的百年。", "symbolSize": 60, "category": "兴衰与现代回响" },
    { "name": "驿站系统", "des": "蒙古站赤与汉唐邮驿，官方情报与信使网络为商路导航。", "symbolSize": 40, "category": "兴衰与现代回响" },
    { "name": "马可·波罗", "des": "自称往来元朝的威尼斯人，一部游记点燃整个欧洲的东方想象。", "symbolSize": 50, "category": "兴衰与现代回响" },
    { "name": "伊本·白图泰", "des": "行程十二万公里的摩洛哥法学家，十四世纪穆斯林世界的环球行者。", "symbolSize": 40, "category": "兴衰与现代回响" },
    { "name": "柏朗嘉宾与鲁布鲁克", "des": "十三世纪赴蒙古宫廷的方济各会使节，欧洲认识东方的最早报告人。", "symbolSize": 40, "category": "兴衰与现代回响" },
    { "name": "帖木儿帝国", "des": "河中的最后辉煌，以征服重画商路版图却又令其代价高昂的跛子帝国。", "symbolSize": 40, "category": "兴衰与现代回响" },
    { "name": "奥斯曼壁垒", "des": "1453年后层层税卡与封锁，传统陆海商路成本高企的东方之墙。", "symbolSize": 50, "category": "兴衰与现代回响" },
    { "name": "海路替代", "des": "好望角与马尼拉航线绕开陆路，传统丝路在十六世纪渐次退潮。", "symbolSize": 50, "category": "兴衰与现代回响" },
    { "name": "丝路考古与藏经洞", "des": "1900年王道士偶然凿开的石窟文库，斯坦因与伯希和的时代随之而来。", "symbolSize": 50, "category": "兴衰与现代回响" },
    { "name": "斯文·赫定与楼兰", "des": "1899年后瑞典探险家在罗布荒漠唤醒的沙埋古城与罗布泊之谜。", "symbolSize": 40, "category": "兴衰与现代回响" },
    { "name": "李希霍芬命名", "des": "1877年德国地理学家以丝绸为这条古路定名，学术想象成为世界名词。", "symbolSize": 40, "category": "兴衰与现代回响" },
    { "name": "丝绸之路申遗", "des": "2014年中哈吉三国联合申报的长安天山廊道，首例跨国丝路遗产。", "symbolSize": 40, "category": "兴衰与现代回响" },
    { "name": "郑和下西洋", "des": "1405至1433年七下西洋的宝船队，海上丝路的国家级巅峰时刻。", "symbolSize": 50, "category": "兴衰与现代回响" },
    { "name": "甘英西使", "des": "97年奉班超之命使大秦，止于条支望海而还的丝路最远使节。", "symbolSize": 40, "category": "兴衰与现代回响" },
    { "name": "回鹘与高昌", "des": "接替粟特人的回鹘商团，高昌与北庭的绿洲转运与转译中心。", "symbolSize": 40, "category": "兴衰与现代回响" },
    { "name": "一带一路", "des": "2013年提出的当代倡议，古丝路名号的现代地缘经济回响。", "symbolSize": 50, "category": "兴衰与现代回响" }
  ],
