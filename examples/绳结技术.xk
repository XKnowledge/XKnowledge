{
  "version": 2,
  "title": "绳结技术",
  "description": "人类最古老的机械：一段绳几个弯，就能绑、能连、能滑、能解。从水手的帆桁到登山者的保护绳，从中国结的盘长到《艾希莉结绳大全》的四千种打法——摩擦力的全部智慧，打法各异，原理一条。",
  "nodes": [
    { "name": "绳结技术", "des": "以绳索互绕构成可受力结构的手工体系。一切绳结的物理基础是摩擦力，一切好结的标准是：受力时越咬越紧，不受力时一拉就解。", "symbolSize": 70, "category": "结之原理" },
    { "name": "摩擦力", "des": "绳结科学的唯一主角：缠绕圈数越多、包角越大，正压力分布越均匀，结越可靠。", "symbolSize": 50, "category": "结之原理" },
    { "name": "强度保留率", "des": "打结后绳索剩余强度百分比：好结保留七成以上，锐弯的坏结直接砍半——结是绳的弱点也是灵魂。", "symbolSize": 40, "category": "结之原理" },
    { "name": "滑与咬", "des": "受力后是否位移的判据：抓结类靠咬紧承重，滑结类靠预留松量解套。", "symbolSize": 40, "category": "结之原理" },
    { "name": "绳尾防散", "des": " whipping 捆扎头、back splice 反插编结、热熔——三种收尾的古今方案。", "symbolSize": 40, "category": "结之原理" },
    { "name": "绳的构造", "des": "三股拧绳、编织绳、kernmantle 芯鞘绳：外皮耐磨内芯承力，现代攀登绳的分工设计。", "symbolSize": 40, "category": "结之原理" },
    { "name": "绳材演化", "des": "从麻、椰棕、棕榈纤维到尼龙、涤纶、迪尼玛：材料每换一代，结的名单就改写一次。", "symbolSize": 50, "category": "结之原理" },
    { "name": "《艾希莉结绳大全》", "des": "1944 年 Clifford Ashley 的 620 页巨著，收录约 3900 种结法的结绳圣经。", "symbolSize": 50, "category": "结之原理" },
    { "name": "国际结绳协会", "des": "1982 年成立的 IGKT，结绳爱好者的全球俱乐部，给古老手艺续了香火。", "symbolSize": 40, "category": "结之原理" },
    { "name": "单结与八字结", "des": "最基础的反手结及其八字变体：八字结受力后仍易解，是攀登绳头的标准配置。", "symbolSize": 40, "category": "基础结组" },
    { "name": "平结", "des": "两绳相接的经典正解，「左压右、右压左」的口诀结，错误打成奶奶结一拉就散。", "symbolSize": 50, "category": "基础结组" },
    { "name": "水结", "des": "扁带端头相连的 overword retrace 结，安全带的每一环都由它闭合。", "symbolSize": 40, "category": "基础结组" },
    { "name": "渔人结", "des": "两绳互绕双圈的连接结，滑溜的钓鱼线也咬得住，还有加强版双渔人结。", "symbolSize": 40, "category": "基础结组" },
    { "name": "称人结", "des": "bowline：固定绳圈的万结之王，不受力时一抽就解，救援与航海的通用语。", "symbolSize": 50, "category": "基础结组" },
    { "name": "双套结", "des": "clove hitch：把绳快速固定在柱桩上的横向固定结，系船解缆的日常动作。", "symbolSize": 50, "category": "基础结组" },
    { "name": "抓结原理", "des": "以细绳在主绳上缠圈的摩擦自锁：受力咬紧、松手可移，绳上的活动扳手。", "symbolSize": 40, "category": "基础结组" },
    { "name": "普鲁士结", "des": "1931 年以登山先驱普鲁士命名的经典抓结，冰川裂缝救援的上升利器。", "symbolSize": 40, "category": "基础结组" },
    { "name": "缩帆结与系缆", "des": "帆船上收帆角与系缆桩的标准动作：cleat hitch 八字缠桩加锁定眼的港口肌肉记忆。", "symbolSize": 40, "category": "航海绳结" },
    { "name": "航海结系谱", "des": "帆船时代的结阵：rolling hitch、constrictor、sheet bend、bowline 各司其职，一船上百结。", "symbolSize": 50, "category": "航海绳结" },
    { "name": "缩绳结", "des": "把长绳临时收短的三重折叠法，不用剪断的长度管理。", "symbolSize": 40, "category": "航海绳结" },
    { "name": "吊板结与脚手架", "des": "传统造船与建筑工地的吊板捆扎：绳子承起一个工作平台的百年工法。", "symbolSize": 40, "category": "航海绳结" },
    { "name": "鞭绳与杖绳", "des": "舵柄与手杖上的皮革缠结装饰，功能与手感的老派修辞。", "symbolSize": 40, "category": "航海绳结" },
    { "name": "八字返穿结", "des": "figure-8 follow-through：攀登者把绳头系进安全带的标准结，受力前有检查口诀。", "symbolSize": 50, "category": "攀登与保护" },
    { "name": "意大利半扣", "des": "Munter hitch：绕锁扣下降制动的摩擦结，不带下降器也能救急的保底技术。", "symbolSize": 40, "category": "攀登与保护" },
    { "name": "法式抓结", "des": "autobloc：下降时作备份制动的辅绳摩擦结，松放自如的温和派。", "symbolSize": 40, "category": "攀登与保护" },
    { "name": "克莱姆黑斯特结", "des": "以扁带代替辅绳的抓结变体，方向性更强的技术选择。", "symbolSize": 40, "category": "攀登与保护" },
    { "name": "绳索救援", "des": "滑轮组省力系统与担架护送的结绳集成：3:1 与 5:1 的力学放大是绳结的物理高潮。", "symbolSize": 40, "category": "攀登与保护" },
    { "name": "戈尔达结", "des": "Garda hitch：两只锁扣组成的单向自锁，省去抓结的另类答案。", "symbolSize": 40, "category": "攀登与保护" },
    { "name": "垂钓结系谱", "des": "改良克林奇、帕洛玛、FG、路亚环结：钓线连接的微雕工程，结径越细越好过导环。", "symbolSize": 40, "category": "垂钓结组" },
    { "name": "路亚与导环", "des": "拟饵换绑的快结需求：FG 结以细结节径穿越导环不打响，竞技钓手的必修课。", "symbolSize": 40, "category": "垂钓结组" },
    { "name": "中国结", "des": "以一根绳盘绕成结的汉族装饰结艺：对称、连续、有图必有意，意必吉祥。", "symbolSize": 50, "category": "中国结与装饰" },
    { "name": "盘长结", "des": "中国结的代表形：回环贯穿、无始无终的八回结，佛门八宝之一。", "symbolSize": 40, "category": "中国结与装饰" },
    { "name": "吉祥结与十字结", "des": "万字锦囊式的吉祥语结：祈愿的立体化与可佩化。", "symbolSize": 40, "category": "中国结与装饰" },
    { "name": "纽扣结与琵琶扣", "des": "盘扣体系：中式衣襟上的功能结与装饰结，旗袍的收束语言。", "symbolSize": 40, "category": "中国结与装饰" },
    { "name": "双钱结与万字结", "des": "以形拟物的小型结：铜钱、卍字、寿字，结语的吉祥话词典。", "symbolSize": 40, "category": "中国结与装饰" },
    { "name": "流苏与编绳", "des": "结体以下的长穗与平编：金刚结、蛇结、玉米结的手串经济。", "symbolSize": 40, "category": "中国结与装饰" },
    { "name": "Macramé 绳编", "des": "不诉诸织机的手结挂毯艺术：斜卷结为字母，19 世纪水手的业余传统到波西米亚风格的复兴。", "symbolSize": 40, "category": "中国结与装饰" },
    { "name": "土耳其头结", "des": "turk's head：绕柱盘旋的封闭辫结，手杖柄与马球鞭上的立体装饰珍品。", "symbolSize": 40, "category": "中国结与装饰" },
    { "name": "结的现代应用", "des": "外科手术结、编织裁缝结、消防水带结：结的原理在各行各业的转世。", "symbolSize": 40, "category": "中国结与装饰" },
    { "name": "童军结绳", "des": "童子军把结绳列入必修徽章体系：平结称人双套的全球少年启蒙课。", "symbolSize": 40, "category": "中国结与装饰" }
  ],
