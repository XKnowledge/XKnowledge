{
  "version": 2,
  "nodes": [
    { "name": "建筑史", "des": "从巨石阵的日出轴线到算法生成的曲面，一部以结构征服空间、以风格铭刻时代的历史。", "symbolSize": 70, "category": "巨石与神殿" },
    { "name": "巨石阵", "des": "索尔兹伯里平原的环状列石，石梁以榫卯咬合立石，冬至与夏至的日出在此对准轴线。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "古埃及建筑", "des": "以花岗岩与几何为永恒服务的建造体系，金字塔、塔门与柱厅是它的三部曲。", "symbolSize": 50, "category": "巨石与神殿" },
    { "name": "金字塔", "des": "吉萨的胡夫金字塔以二百三十万块巨石叠成，此后近四千年无人再超越其高度。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "古希腊建筑", "des": "以大理石柱式确立比例与和谐的法度，神庙是柱廊围合的雕塑，也是光的容器。", "symbolSize": 50, "category": "巨石与神殿" },
    { "name": "多立克柱式", "des": "无柱础的男性柱式，二十道凹槽配三陇板，刚健质朴，帕特农是其最准的一次落地。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "爱奥尼柱式", "des": "柱头双涡卷、柱身修长，源自小亚细亚的轻灵语调，适合图书馆与祭坛的书卷气。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "科林斯柱式", "des": "柱头莨苕叶簇层层包裹，繁茂华美，罗马人最钟爱的柱式，后世学院的门面语言。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "帕特农神庙", "des": "伯里克利时代立于雅典卫城，多立克围廊配通体视觉校正，古典和谐的一次定格。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "古罗马建筑", "des": "照收希腊柱式，以拱券、混凝土与穹顶另辟疆土，建筑从神庙走向浴场与世俗。", "symbolSize": 50, "category": "巨石与神殿" },
    { "name": "罗马混凝土", "des": "火山灰与石灰浆凝成整体结构，可灌筑任意跨度，万神庙的穹顶因它得以自立。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "穹顶", "des": "半球形自支撑结构，以环向与径向的内力化解荷载，万神庙后成为空间野心的标尺。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "万神庙", "des": "哈德良时代重建于罗马城，四十三米混凝土穹顶迄今完整，顶眼洞开，天光如柱。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "拱券", "des": "以曲线构件把竖向重量导向两脚的跨越术，罗马人以它输水、造桥、开凯旋门。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "十字拱", "des": "两道筒拱直角相交的覆盖单元，四柱托起一方天窗，哥特肋拱顶的直系先祖。", "symbolSize": 40, "category": "巨石与神殿" },
    { "name": "拜占庭建筑", "des": "希腊十字平面与集中式穹顶群，金底马赛克漫反射天光，东部帝国的空间神学。", "symbolSize": 50, "category": "信仰的垂直向度" },
    { "name": "圣索菲亚大教堂", "des": "查士丁尼敕建于君士坦丁堡，帆拱托起大穹顶，四十道窗令穹顶如悬于光中。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "帆拱", "des": "以球面三角弧段过渡方形平面与圆形穹底，拜占庭工匠的空间魔术，沿用至今。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "罗马风建筑", "des": "十至十二世纪西欧的厚重语法，半圆筒拱、粗石墙面与修道院工匠的粗犷柱头。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "修道院", "des": "自给自足的祈祷公社，回廊、膳堂与缮写室围合出中世纪的知识与工程试验场。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "哥特式", "des": "尖拱、肋拱与飞扶壁合力把石头推向天空，墙体退位给彩色玻璃，光即神学。", "symbolSize": 60, "category": "信仰的垂直向度" },
    { "name": "尖拱", "des": "两段圆弧相接的拱，侧推力更趋竖直，令开洞更高更窄，哥特升腾的第一步。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "肋拱顶", "des": "先砌骨架肋再填薄壳的分步拱顶，重量与工期同时减轻，覆盖从此可拆解。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "飞扶壁", "des": "凌空跨越侧廊上空的扶壁拱，把拱顶侧推力接住引向外墩，墙因此让位于窗。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "玫瑰花窗", "des": "正立面的圆形大窗，铅条与彩色玻璃拼出放射纹样，阳光被筛成神学的颜色。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "巴黎圣母院", "des": "西岱岛上的主教座堂，飞扶壁在此首次成体系登场，早期哥特向盛期的转折。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "沙特尔大教堂", "des": "三层中殿与一百七十六块彩窗，沙特尔蓝统治室内光线，盛期哥特的度量衡。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "科隆大教堂", "des": "双塔高一百五十七米，尖塔与透空肋拱把哥特逻辑推向极限，工期逾六百年。", "symbolSize": 40, "category": "信仰的垂直向度" },
    { "name": "文艺复兴建筑", "des": "重拾古典柱式与比例的秩序，中心化平面取代神秘纵深，人文主义的空间宣言。", "symbolSize": 55, "category": "比例与戏剧" },
    { "name": "伯鲁乃列斯基", "des": "佛罗伦萨金匠出身的建筑师，复活古典、发明线性透视，并造出时代最大的穹顶。", "symbolSize": 50, "category": "比例与戏剧" },
    { "name": "圣母百花大穹顶", "des": "伯鲁乃列斯基为佛罗伦萨主教堂封顶，双层壳体加鱼骨砌法，不设落地脚手架。", "symbolSize": 40, "category": "比例与戏剧" },
    { "name": "阿尔伯蒂", "des": "人文主义者兼建筑师，以拉丁文著《论建筑》，把营造从手艺升格为自由学科。", "symbolSize": 40, "category": "比例与戏剧" },
    { "name": "论建筑", "des": "阿尔伯蒂仿维特鲁威体例写就的理论，美观即比例的和谐，文艺复兴的立法文本。", "symbolSize": 40, "category": "比例与戏剧" },
    { "name": "帕拉第奥", "des": "维琴察的建筑师，《建筑四书》把古典法则编成图谱，英语世界乡宅的范本。", "symbolSize": 50, "category": "比例与戏剧" },
    { "name": "帕拉第奥母题", "des": "大小拱券套叠、柱列分层的立面节奏，出自巴西利卡的旧立面改造，流传极广。", "symbolSize": 40, "category": "比例与戏剧" },
    { "name": "圆厅别墅", "des": "四面同一门廊托起中央圆厅，绝对对称的乡村宅第，被后世反复临摹的偶像。", "symbolSize": 40, "category": "比例与戏剧" },
    { "name": "巴洛克建筑", "des": "曲线、错觉与戏剧性采光的空间修辞，静态比例松绑为运动，庄严演成激情。", "symbolSize": 55, "category": "比例与戏剧" },
    { "name": "波洛米尼", "des": "圣卡罗四喷泉教堂的作者，立面凹凸起伏、塔身扭曲如波，巴洛克的孤高怪才。", "symbolSize": 40, "category": "比例与戏剧" },
    { "name": "贝尼尼", "des": "雕塑家兼建筑师，圣彼得广场双柱廊如双臂环抱，把仪式导演成空间剧场。", "symbolSize": 40, "category": "比例与戏剧" },
    { "name": "圣彼得大教堂", "des": "布拉曼特起笔、米开朗基罗定穹、贝尼尼收尾，文艺复兴与巴洛克的接力总谱。", "symbolSize": 40, "category": "比例与戏剧" },
    { "name": "凡尔赛宫", "des": "勒诺特尔的轴线花园与蒙萨尔的镜厅，太阳王以空间尺度宣告绝对的王权。", "symbolSize": 40, "category": "比例与戏剧" },
    { "name": "古典主义", "des": "法国宫廷的正统语法：轴线、对称与山花，以纪律驯服巴洛克的戏剧冲动。", "symbolSize": 40, "category": "比例与戏剧" },
    { "name": "工业革命", "des": "蒸汽机与轧钢改写建造业，铸铁、玻璃与标准预制件让建筑挣脱石头的力学。", "symbolSize": 50, "category": "铁与玻璃的世纪" },
    { "name": "帕克斯顿", "des": "温室设计师出身的营造奇才，以百合温室的经验装配水晶宫，预制时代的先知。", "symbolSize": 40, "category": "铁与玻璃的世纪" },
    { "name": "水晶宫", "des": "1851年伦敦世博会的展览馆，铸铁与玻璃的预制装配，九个月在海德公园立起。", "symbolSize": 40, "category": "铁与玻璃的世纪" },
    { "name": "芝加哥学派", "des": "1871年大火后的重建军团，钢框架、高层与电梯在此合体，摩天楼的孵化器。", "symbolSize": 50, "category": "铁与玻璃的世纪" },
    { "name": "沙利文", "des": "学派主将与精神导师，保证大厦立起高层语法，留下“形式追随功能”的信条。", "symbolSize": 50, "category": "铁与玻璃的世纪" },
    { "name": "形式追随功能", "des": "外形由内部生活与结构逻辑自然决定的信条，一句顶一万句的现代主义种子。", "symbolSize": 40, "category": "铁与玻璃的世纪" },
    { "name": "电梯", "des": "奥蒂斯的应急安全闸让升降不再可怕，楼层摆脱腿脚的极限，从此向上生长。", "symbolSize": 40, "category": "铁与玻璃的世纪" },
    { "name": "摩天楼", "des": "钢框架承重、幕墙围合、电梯竖向交通的垂直城市，芝加哥孵化，曼哈顿成林。", "symbolSize": 40, "category": "铁与玻璃的世纪" },
    { "name": "新艺术运动", "des": "铁材开出藤蔓、玻璃染上虹彩的装饰浪潮，布鲁塞尔与巴黎对机器的柔化回应。", "symbolSize": 40, "category": "铁与玻璃的世纪" },
    { "name": "高迪", "des": "加泰罗尼亚建筑师，以悬链模型与自然曲面工作，把结构本身做成装饰与神学。", "symbolSize": 50, "category": "铁与玻璃的世纪" },
    { "name": "悬链拱", "des": "倒置悬链所得的纯受压拱线，高迪以配重链条找形，在桂尔地下室完成试验。", "symbolSize": 40, "category": "铁与玻璃的世纪" },
    { "name": "圣家堂", "des": "巴塞罗那建造逾百年的赎罪教堂，倾斜树柱与分叉拱托起石林般的塔林，未竟。", "symbolSize": 40, "category": "铁与玻璃的世纪" },
    { "name": "现代主义建筑", "des": "以功能优先、结构诚实与反装饰为纲的全球运动，二十世纪城市的通用母语。", "symbolSize": 60, "category": "现代主义星丛" },
    { "name": "包豪斯", "des": "1919年格罗皮乌斯创立于魏玛的学校，工艺与艺术合一，现代设计的策源地。", "symbolSize": 60, "category": "现代主义星丛" },
    { "name": "格罗皮乌斯", "des": "包豪斯创校校长，法古斯工厂首现玻璃转角，晚年渡美执掌哈佛设计学院。", "symbolSize": 50, "category": "现代主义星丛" },
    { "name": "法古斯工厂", "des": "格罗皮乌斯与迈耶合作的鞋楦厂，玻璃转角消去角柱，创校前三年的建成宣言。", "symbolSize": 40, "category": "现代主义星丛" },
    { "name": "勒·柯布西耶", "des": "画家出身的建筑先知，白色时期与粗野晚期判若两人，重新发明了城市与住宅。", "symbolSize": 55, "category": "现代主义星丛" },
    { "name": "走向新建筑", "des": "柯布西耶1923年的宣言集，“住宅是居住的机器”，工程师美学对学院的宣战书。", "symbolSize": 40, "category": "现代主义星丛" },
    { "name": "新建筑五点", "des": "底层架空、屋顶花园、自由平面、横向长窗、自由立面，钢混框架的五项红利。", "symbolSize": 40, "category": "现代主义星丛" },
    { "name": "萨伏伊别墅", "des": "普瓦西郊外的白匣子住宅，一层架空、坡道纵贯，新建筑五点的全尺寸示范。", "symbolSize": 40, "category": "现代主义星丛" },
    { "name": "密斯·凡·德·罗", "des": "亚琛石匠之子出身的钢结构诗人，以玻璃与钢的精确美学，晚年定芝加哥范式。", "symbolSize": 55, "category": "现代主义星丛" },
    { "name": "少即是多", "des": "密斯的信条：删至结构与光而后止，节点与比例的精确成为新的装饰。", "symbolSize": 40, "category": "现代主义星丛" },
    { "name": "巴塞罗那德国馆", "des": "1929年世博会德国馆，八根十字钢柱托平顶，独立墙自由布位成就流动空间。", "symbolSize": 40, "category": "现代主义星丛" },
    { "name": "赖特", "des": "美国草原的宗师，六十余年实践自草原住宅到古根海姆，有机建筑的布道者。", "symbolSize": 50, "category": "现代主义星丛" },
    { "name": "有机建筑", "des": "建筑如植物从场地里长出：材料、结构与形式服从同一个内在的生命逻辑。", "symbolSize": 40, "category": "现代主义星丛" },
    { "name": "流水别墅", "des": "赖特为考夫曼家建于熊跑溪之上，混凝土悬臂叠于岩床，与瀑布互为里外。", "symbolSize": 40, "category": "现代主义星丛" },
    { "name": "雅典宪章", "des": "1933年国际现代建筑会议的都市纲领，居住、工作、游憩与交通四大功能分区。", "symbolSize": 40, "category": "现代主义星丛" },
    { "name": "桁架", "des": "三角形单元串接的直杆骨架，受压受拉各司其职，桥梁与屋顶的省料大跨之道。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "悬索", "des": "高强钢索垂成受拉悬链，锚固端扛住水平力，跨越江海的屋盖与桥式之道。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "薄壳", "des": "厚仅数厘米的混凝土曲面，以形状而非厚度抵抗荷载，蛋壳原理的工程放大。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "奈尔维", "des": "意大利工程师兼建筑师，钢筋混凝土的结构诗人，在罗马把力学画成装饰图案。", "symbolSize": 50, "category": "结构的诗与参数化" },
    { "name": "罗马小体育宫", "des": "奈尔维为1960年奥运会所造，辐射肋与斜柱环咬穹顶，结构图案即天花。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "富勒", "des": "美国思想家与发明家，短程线穹顶令其扬名，毕生鼓吹以最少资源办最多事。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "短程线穹顶", "des": "以球面大圆弧三角剖分的网格穹顶，应力均匀、用料极省，万能覆盖的通用件。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "伍重", "des": "丹麦建筑师，以悉尼湾的壳体竞赛一举夺魁，加泰罗尼亚拱与平台是其母语。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "悉尼歌剧院", "des": "伍重设计于悉尼湾，球面切片拼出壳形屋顶，预制肋拱一解施工的死结。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "后现代主义", "des": "对现代主义正统的群起反击：历史符号、商业趣味与隐喻，重新收进立面。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "文丘里", "des": "《建筑的复杂性与矛盾性》作者，母亲住宅的山花与斜裂山墙，后现代的点火者。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "少即是烦", "des": "文丘里对密斯一字之差的戏答，为混杂、折衷与日常趣味翻案的著名口号。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "解构主义", "des": "把建筑拆成倾斜、碎裂与非欧几何的运动，秩序与重力在图面上重新谈判。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "扎哈·哈迪德", "des": "巴格达出生的伦敦建筑师，从绘画式变形到参数化建成，曲面空间的开路者。", "symbolSize": 50, "category": "结构的诗与参数化" },
    { "name": "参数化设计", "des": "以算法脚本生成与优化形体的方法，曲面从屏幕直通数控加工，设计换了笔。", "symbolSize": 40, "category": "结构的诗与参数化" },
    { "name": "可持续建筑", "des": "以被动式节能、自然通风与可再生能源为纲，把气候伦理写进设计的章程。", "symbolSize": 40, "category": "结构的诗与参数化" }
