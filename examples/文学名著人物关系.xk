{"version":2,"nodes":[{"name":"文学名著人物关系","des":"七部传世之书的人物星河：木石前盟、桃园结义、逼上梁山、护戒远征、魔法七年、莎翁悲剧与科幻星海。","symbolSize":70,"category":"总览"},{"name":"红楼梦","des":"曹雪芹「十年辛苦不寻常」：四大家族的钟鸣鼎食与运终数尽，宝黛钗的情感纠葛是全书跳动的心脏。","symbolSize":60,"category":"红楼梦·大观园"},{"name":"贾宝玉","des":"荣国府衔玉而生的凤凰，脂粉队里养大的情种，历尽繁华后悬崖撒手，遁入白茫茫大地真干净。","symbolSize":50,"category":"红楼梦·大观园"},{"name":"林黛玉","des":"姑苏才女，绛珠仙草转世，以一世眼泪偿还灌溉之恩；诗魂葬花，焚稿断痴情，泪尽而逝。","symbolSize":50,"category":"红楼梦·大观园"},{"name":"薛宝钗","des":"皇商之女，金锁配宝玉的「金玉良缘」，博学端庄、随分从时，终究守着一段有名无实的婚姻。","symbolSize":50,"category":"红楼梦·大观园"},{"name":"王熙凤","des":"荣府管家奶奶，未见其人先闻其声，协理宁国府杀伐决断；「机关算尽太聪明，反算了卿卿性命」。","symbolSize":50,"category":"红楼梦·大观园"},{"name":"贾母","des":"史侯家的小姐、贾府的老祖宗，含饴弄孙富贵双全，是钟鸣鼎食之家最后也是最大的庇荫。","symbolSize":50,"category":"红楼梦·大观园"},{"name":"金陵十二钗","des":"太虚幻境正册十二位女子，宝玉梦中所见的判词，早已写定众人「千红一哭、万艳同悲」的命运。","symbolSize":50,"category":"红楼梦·大观园"},{"name":"大观园","des":"元春省亲的别院，宝玉与众钗的诗意乌托邦：海棠诗社、螃蟹宴与葬花吟的舞台，繁华顶点亦是转场。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"贾政","des":"宝玉之父，端方守礼的儒家信徒，恨铁不成钢的一顿板子，打不醒儿子的痴顽也拉不住家族的下坠。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"王夫人","des":"宝玉之母，吃斋念佛的慈母，一句「好好的爷们都被勾引坏了」，逐晴雯时冷酷决绝。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"贾琏","des":"凤姐之夫，荣府外务的跑腿人，惧内而偷腥，在「凤辣子」的锋芒下萎缩的浪荡子。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"贾元春","des":"宝玉长姐，入宫封贤德妃，省亲一夕烟花盛景，「那不得见人的去处」道尽深宫寂寞。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"贾探春","des":"庶出的玫瑰花，「才自精明志自高」，兴利除弊改革家政，远嫁海疆如断线风筝。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"史湘云","des":"史家侄孙女，豪爽咬舌的「爱哥哥」，醉眠芍药裀是真名士自风流，「英豪阔大宽宏量」。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"妙玉","des":"带发修行的官宦小姐，栊翠庵的梅雪体己茶，「欲洁何曾洁，云空未必空」。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"秦可卿","des":"宁府长孙媳，「兼美」之貌谜一样的人物，托梦凤姐预言盛极而衰，早逝留下重重悬案。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"袭人","des":"宝玉首席大丫鬟，「枉自温柔和顺」的准姨娘，贾府败落后嫁了蒋玉菡，各得其所。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"晴雯","des":"宝玉的丫鬟，「心比天高，身为下贱」，撕扇千金一笑，病补雀金裘，终被谗言逐出抱屈夭亡。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"李纨","des":"孀居的长嫂，清净守节「如槁木死灰」，课子读书熬到兰桂齐芳的「晚韶光」。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"刘姥姥","des":"久经世故的乡村老妪，三进荣国府，一句「老祖宗老菩萨」逗笑满堂，日后救巧姐于火坑。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"贾雨村","des":"葫芦庙的穷儒，受甄士隐资助发迹，乱判葫芦案、巴结贾府，精致的利己主义者样本。","symbolSize":40,"category":"红楼梦·大观园"},{"name":"三国演义","des":"罗贯中「据正史、采小说」演义百年：从桃园结义到三分归晋，权谋与忠义在乱世烽烟里各自成灰。","symbolSize":60,"category":"三国·魏蜀吴"},{"name":"曹操","des":"「治世之能臣，乱世之奸雄」，挟天子以令诸侯，官渡以弱胜强、赤壁踉跄北还，唯才是举的一代枭雄。","symbolSize":50,"category":"三国·魏蜀吴"},{"name":"刘备","des":"织席贩履的中山靖王之后，以仁德为旗，桃园结义、三顾茅庐，颠沛半生终成西川基业。","symbolSize":50,"category":"三国·魏蜀吴"},{"name":"诸葛亮","des":"卧龙先生，隆中一对定三分，白帝受托孤之重；六出祁山鞠躬尽瘁，「出师未捷身先死」。","symbolSize":50,"category":"三国·魏蜀吴"},{"name":"关羽","des":"美髯公，温酒斩华雄、千里走单骑、水淹七军，义薄云天；大意失荆州后由将入圣。","symbolSize":50,"category":"三国·魏蜀吴"},{"name":"孙权","des":"碧眼紫髯的江东之主，十九岁坐断东南，联刘抗曹赤壁破敌，曹操叹「生子当如孙仲谋」。","symbolSize":50,"category":"三国·魏蜀吴"},{"name":"司马懿","des":"「冢虎」司马懿，隐忍待机与诸葛亮对垒五丈原，高平陵之变为儿孙代魏埋下伏笔。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"张飞","des":"燕颔虎须的猛张飞，长坂坡据水断桥一声喝退曹兵；粗中有细，暴而无恩终遭部下所害。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"赵云","des":"常山赵子龙，长坂坡七进七出单骑救主，「子龙一身都是胆」，谦逊持重的儒将典范。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"周瑜","des":"江东周郎，羽扇纶巾谈笑间赤壁纵火；「既生瑜，何生亮」是演义加给他的千古委屈。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"吕布","des":"人中吕布、马中赤兔，方天画戟无双武勇；三姓家奴的反复无常，白门楼殒命。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"貂蝉","des":"王允府中的歌伎，连环计里周旋于董卓吕布之间，四大美人里唯一的虚构者。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"董卓","des":"西凉军阀，废立天子、火烧洛阳，残暴招致十八路诸侯共讨，落得腹上燃灯的结局。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"曹丕","des":"曹操次子，受禅建魏；逼弟七步成诗，「相煎何太急」的胜利者与孤独者。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"鲁肃","des":"东吴战略家，榻上对策早于隆中三分构想；忠厚长者，孙刘联盟一生的黏合剂。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"陆逊","des":"江东书生拜大都督，夷陵火烧连营七百里，一战烧掉刘备的复仇梦。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"姜维","des":"天水降将，诸葛亮衣钵传人；九伐中原明知不可为而为之，「吾计不成，乃天命也」。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"汉献帝","des":"颠沛流离的末代天子，先董卓后曹操；衣带诏也救不回傀儡的命运，禅位于曹丕。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"华佗","des":"神医，为关羽刮骨疗毒谈笑自若；向曹操献开颅之议反遭疑忌，死于狱中。","symbolSize":40,"category":"三国·魏蜀吴"},{"name":"水浒传","des":"施耐庵笔下的一百单八将：从逼上梁山到受招安、征方腊、鸩酒散场，江湖聚义的宏大挽歌。","symbolSize":60,"category":"水浒·梁山泊"},{"name":"宋江","des":"及时雨、孝义黑三郎，仗义疏财坐上头把交椅；一心招安，把兄弟们带进了坟场。","symbolSize":50,"category":"水浒·梁山泊"},{"name":"吴用","des":"智多星，智取生辰纲的军师、梁山的大脑；「智赚玉麒麟」，招安路线的总设计师。","symbolSize":50,"category":"水浒·梁山泊"},{"name":"林冲","des":"东京八十万禁军教头，一忍再忍：白虎堂、野猪林、风雪山神庙，「逼上梁山」的代言人。","symbolSize":50,"category":"水浒·梁山泊"},{"name":"鲁智深","des":"花和尚，拳打镇关西、倒拔垂杨柳、大闹野猪林；杀人放火的赤子心，钱塘江上听潮圆寂。","symbolSize":50,"category":"水浒·梁山泊"},{"name":"武松","des":"打虎都头，斗杀西门庆、醉打蒋门神、血溅鸳鸯楼；快意恩仇的天伤星行者。","symbolSize":50,"category":"水浒·梁山泊"},{"name":"卢俊义","des":"河北玉麒麟，枪棒天下无对；被吴用赚上梁山，坐了第二把交椅。","symbolSize":40,"category":"水浒·梁山泊"},{"name":"李逵","des":"黑旋风，两把板斧排头砍去；天真蛮勇死忠宋江，最终喝了哥哥递来的毒酒。","symbolSize":40,"category":"水浒·梁山泊"},{"name":"晁盖","des":"托塔天王，生辰纲的牵头人、梁山第二代寨主；曾头市中箭，遗言谁能擒史文恭谁为寨主。","symbolSize":40,"category":"水浒·梁山泊"},{"name":"燕青","des":"浪子，卢俊义的心腹家仆，相扑天下无敌；功成身退，最潇洒的明白人。","symbolSize":40,"category":"水浒·梁山泊"},{"name":"花荣","des":"小李广，神箭将军，宋江的生死知音；蓼儿洼前双双自缢，全了忠义。","symbolSize":40,"category":"水浒·梁山泊"},{"name":"高俅","des":"端王府踢球发迹的太尉，逼走林冲、逼反杨志；「逼上梁山」的体制推手。","symbolSize":40,"category":"水浒·梁山泊"},{"name":"杨志","des":"青面兽，三代将门之后；卖刀杀牛二、失陷生辰纲，命运总差一步。","symbolSize":40,"category":"水浒·梁山泊"},{"name":"孙二娘","des":"母夜叉，十字坡人肉包子铺的老板娘，武松的不打不相识。","symbolSize":40,"category":"水浒·梁山泊"},{"name":"柴进","des":"小旋风，后周皇裔，丹书铁券在身；专爱资助江湖好汉，梁山的「天使投资人」。","symbolSize":40,"category":"水浒·梁山泊"},{"name":"潘金莲","des":"清河的嫂嫂，与西门庆合谋毒杀武大；武松复仇路上的第一个祭品。","symbolSize":40,"category":"水浒·梁山泊"},{"name":"指环王","des":"托尔金的中土史诗：至尊魔戒的销毁之旅——同盟与背叛、王座的回归与灰港的远航。","symbolSize":60,"category":"指环王·中土世界"},{"name":"弗罗多","des":"袋底洞的霍比特人，圣爱隆议会上一句「我愿意带它去，虽然我不知道路」，扛起了中土的命运。","symbolSize":50,"category":"指环王·中土世界"},{"name":"山姆","des":"园丁山姆怀斯，「我不能替你背负魔戒，但我可以背负你」——从袋边偷听到末日火山的最后一步。","symbolSize":50,"category":"指环王·中土世界"},{"name":"甘道夫","des":"灰袍巫师、迈雅神灵，烟花师傅与引路人；摩瑞亚桥上一句「你不能通过！」，坠渊后白袍归来。","symbolSize":50,"category":"指环王·中土世界"},{"name":"阿拉贡","des":"流浪北境的游侠「大步」，伊西铎血脉的继承人；王者归来时加冕刚铎，娶暮星为后。","symbolSize":50,"category":"指环王·中土世界"},{"name":"索伦","des":"第二纪元的黑暗魔君，铸造又失去至尊魔戒；燃烧之眼在巴拉督尔塔顶俯瞰中土。","symbolSize":50,"category":"指环王·中土世界"},{"name":"至尊魔戒","des":"统御众戒的至尊戒：一枚戒指统领众戒，一枚戒指寻获众戒，一枚戒指召来众戒，在黑暗中禁锢众戒。","symbolSize":50,"category":"指环王·中土世界"},{"name":"咕噜","des":"斯麦戈，被魔戒扭曲五百年的前霍比特人，「宝贝」的奴隶、弗罗多的向导与背叛者。","symbolSize":40,"category":"指环王·中土世界"},{"name":"比尔博","des":"袋底洞的老霍比特人，《霍比特人》远征的主人公；从咕噜手里赢得魔戒，留下一笔烫手的遗产。","symbolSize":40,"category":"指环王·中土世界"},{"name":"莱戈拉斯","des":"幽暗密林的精灵王子，百步穿杨的弓手，护戒同盟与三猎手之一。","symbolSize":40,"category":"指环王·中土世界"},{"name":"金雳","des":"葛罗音之子的矮人战士，战斧与豪言，「谁说矮人不敢跳」；精灵友谊的破冰者。","symbolSize":40,"category":"指环王·中土世界"},{"name":"博罗米尔","des":"刚铎宰相长子，受魔戒蛊惑堕落一瞬，又用两支箭赎回荣誉的护戒人。","symbolSize":40,"category":"指环王·中土世界"},{"name":"梅里","des":"梅里雅达克，机智的霍比特人，与皮平一路闯祸一路成长，罗翰的骑士。","symbolSize":40,"category":"指环王·中土世界"},{"name":"皮平","des":"皮瑞格林，个头最小麻烦最多的霍比特人，偷看帕蓝提尔直面索伦，终为刚铎而战。","symbolSize":40,"category":"指环王·中土世界"},{"name":"萨鲁曼","des":"白袍巫师之首，研究魔戒反被腐蚀；艾辛格竖起了强兽人的工厂。","symbolSize":40,"category":"指环王·中土世界"},{"name":"埃尔隆德","des":"瑞文戴尔的精灵领主，圣爱隆议会的召集人；养育阿拉贡，守着阿尔玟的抉择。","symbolSize":40,"category":"指环王·中土世界"},{"name":"加拉德瑞尔","des":"罗瑞恩的白夫人，经受住魔戒试探的诺多遗光；镜与光的赠礼人。","symbolSize":40,"category":"指环王·中土世界"},{"name":"阿尔玟","des":"埃尔隆德之女，「暮星」阿尔玟，为爱放弃精灵永生的骑士之后。","symbolSize":40,"category":"指环王·中土世界"},{"name":"《哈利·波特》","des":"J.K.罗琳的魔法七部曲：从楼梯下的碗柜到霍格沃茨的大战，「大难不死的男孩」用七年长大成人。","symbolSize":60,"category":"霍格沃茨·魔法世界"},{"name":"哈利·波特","des":"大难不死的男孩，额头一道闪电伤疤；从「活下来的那个孩子」到自愿赴死又活回来的救世主。","symbolSize":50,"category":"霍格沃茨·魔法世界"},{"name":"伏地魔","des":"汤姆·里德尔，「那个连名字都不能提的人」；灵魂分裂七次，以恐惧统治巫师界。","symbolSize":50,"category":"霍格沃茨·魔法世界"},{"name":"阿不思·邓布利多","des":"霍格沃茨校长、凤凰社首领、上一代黑魔王格林德沃的对手；「为了更伟大的利益」，连死亡都在他的布局里。","symbolSize":50,"category":"霍格沃茨·魔法世界"},{"name":"西弗勒斯·斯内普","des":"魔药课教授、「混血王子」、双面间谍；一句「Always」，半生守护着绿眼睛的男孩。","symbolSize":50,"category":"霍格沃茨·魔法世界"},{"name":"罗恩·韦斯莱","des":"韦斯莱家的第六个孩子，巫师棋盘上的骑士；从救世主最好的朋友，活成自己的光。","symbolSize":50,"category":"霍格沃茨·魔法世界"},{"name":"赫敏·格兰杰","des":"麻瓜出身的最强大脑，时间转换器与图书馆的主人；「我就是泥巴种，而且我为之骄傲」。","symbolSize":50,"category":"霍格沃茨·魔法世界"},{"name":"小天狼星布莱克","des":"哈利的教父，阿兹卡班的越狱者，劫盗者里的「大脚板」；格里莫广场12号给了哈利最后一个「家」。","symbolSize":40,"category":"霍格沃茨·魔法世界"},{"name":"莱姆斯·卢平","des":"「月亮脸」，狼人教授，守护神咒课上教哈利直面恐惧的温柔师长。","symbolSize":40,"category":"霍格沃茨·魔法世界"},{"name":"小矮星彼得","des":"「虫尾巴」，出卖波特夫妇的第四个劫盗者，装了十二年的老鼠。","symbolSize":40,"category":"霍格沃茨·魔法世界"},{"name":"詹姆·波特","des":"哈利的父亲，劫盗者之首「尖头叉子」；从校园恶作剧王到挡在伏地魔面前的父亲。","symbolSize":40,"category":"霍格沃茨·魔法世界"},{"name":"莉莉·波特","des":"哈利的母亲，以死护子，留下「爱」这道最古老的护身咒。","symbolSize":40,"category":"霍格沃茨·魔法世界"},{"name":"鲁伯·海格","des":"混血巨人的钥匙保管员兼猎场看守；生日蛋糕上的第一句话——「你是一名巫师，哈利」。","symbolSize":40,"category":"霍格沃茨·魔法世界"},{"name":"米勒娃·麦格","des":"变形术教授、格兰芬多院长，原则的化身，阿尼马格斯斑猫。","symbolSize":40,"category":"霍格沃茨·魔法世界"},{"name":"德拉科·马尔福","des":"斯莱特林的校园宿敌，卢修斯之子；纯血世家的骄傲与被吓坏的少年。","symbolSize":40,"category":"霍格沃茨·魔法世界"},{"name":"多比","des":"马尔福家的家养小精灵，一只旧袜子换来自由；「多比是一个自由的小精灵！」","symbolSize":40,"category":"霍格沃茨·魔法世界"},{"name":"莎士比亚戏剧","des":"斯特拉福镇手套匠之子，环球剧场的股东兼编剧；三十七部戏写尽人性的明暗，世界是一个舞台。","symbolSize":60,"category":"莎翁·环球剧场"},{"name":"哈姆雷特","des":"丹麦王子，「生存还是毁灭」；延宕的复仇者，文艺复兴人文主义的忧郁结晶，戏剧史上最著名的内心。","symbolSize":50,"category":"莎翁·环球剧场"},{"name":"麦克白","des":"平叛归来的苏格兰将军，女巫的预言点燃野心，弑王之后是血里蹚不完的路：「人生不过是一个行走的影子」。","symbolSize":50,"category":"莎翁·环球剧场"},{"name":"李尔王","des":"不列颠老王，以爱的言辞分割国土，暴风雨的荒野上才认出真心的女儿，权力与人性的双重悲剧。","symbolSize":50,"category":"莎翁·环球剧场"},{"name":"奥赛罗","des":"威尼斯的摩尔人将军，异乡的传奇与轻信的嫉妒，亲手掐死忠贞后再自刎殉情。","symbolSize":50,"category":"莎翁·环球剧场"},{"name":"罗密欧","des":"蒙太古家的少年，翻墙赴约的痴情，一杯毒饮在误会成真的墓穴。","symbolSize":50,"category":"莎翁·环球剧场"},{"name":"朱丽叶","des":"凯普莱特家的十三岁新娘，「我的慷慨像海一样浩渺」，假死成真的殉情者。","symbolSize":50,"category":"莎翁·环球剧场"},{"name":"四大悲剧","des":"《哈姆雷特》《奥赛罗》《李尔王》《麦克白》，莎翁悲剧的四座高峰，人性弱点的四份病历。","symbolSize":50,"category":"莎翁·环球剧场"},{"name":"奥菲莉娅","des":"御前大臣之女，疯癫与溺水，「她的衣服四散展开」，被复仇碾碎的无辜者。","symbolSize":40,"category":"莎翁·环球剧场"},{"name":"克劳狄斯","des":"弑兄篡位娶嫂的丹麦新王，戏中戏被戳穿前，祈祷也洗不净双手的伪君子。","symbolSize":40,"category":"莎翁·环球剧场"},{"name":"麦克白夫人","des":"「来，解开我的女性」，怂恿弑君的铁腕；梦游中一遍遍洗不净的手。","symbolSize":40,"category":"莎翁·环球剧场"},{"name":"考狄利娅","des":"李尔最幼的女儿，「我爱您只是按照我的名分」；沉默的真心被错付，无辜赴死引爆老王心碎。","symbolSize":40,"category":"莎翁·环球剧场"},{"name":"伊阿古","des":"「我不是我」的旗官，纯恶的动机学家，一方手帕毁掉一桩婚姻与一代名将。","symbolSize":40,"category":"莎翁·环球剧场"},{"name":"苔丝狄蒙娜","des":"违抗父命私奔的元老之女，至死温柔：「没有人杀我，是我自己。」","symbolSize":40,"category":"莎翁·环球剧场"},{"name":"夏洛克","des":"威尼斯的犹太放贷人，「一磅肉」的契约与「难道犹太人没有眼睛吗」的诘问，喜剧里的悲剧人。","symbolSize":40,"category":"莎翁·环球剧场"},{"name":"鲍西娅","des":"《威尼斯商人》的女主角，假扮法学博士断案：「慈悲不是勉强而来的。」","symbolSize":40,"category":"莎翁·环球剧场"},{"name":"普洛斯彼罗","des":"被篡位流放的米兰公爵、荒岛的魔法师；掀起一场暴风雨只为完成宽恕，「折断我的魔杖」。","symbolSize":40,"category":"莎翁·环球剧场"},{"name":"科幻文学史","des":"从弗兰肯斯坦的实验室到三体的黑暗森林：两百年想象力的接力，「科幻是可能性的文学」。","symbolSize":60,"category":"科幻·星海谱系"},{"name":"玛丽·雪莱","des":"十九岁的日内瓦湖畔，与拜伦的鬼故事赌局催生《弗兰肯斯坦》（1818），科幻的开山之母。","symbolSize":50,"category":"科幻·星海谱系"},{"name":"儒勒·凡尔纳","des":"「科学幻想之父」：鹦鹉螺号、炮弹登月、八十天环游地球，用计算的乐观飞向未来。","symbolSize":50,"category":"科幻·星海谱系"},{"name":"H·G·威尔斯","des":"《时间机器》与《星际战争》：把社会学寓言装进科学设定，与凡尔纳分庭抗礼的另一座源头。","symbolSize":50,"category":"科幻·星海谱系"},{"name":"阿西莫夫","des":"「神一样的人」：五百本书的写作者，银河帝国与机器人系列的织网人，科幻黄金时代的旗手。","symbolSize":50,"category":"科幻·星海谱系"},{"name":"威廉·吉布森","des":"《神经漫游者》一句「赛博空间」，给数字时代起了名字；赛博朋克之父。","symbolSize":50,"category":"科幻·星海谱系"},{"name":"刘慈欣","des":"娘子关电厂的工程师，「以一己之力将中国科幻提升到世界水平」（克拉克奖授奖辞）。","symbolSize":50,"category":"科幻·星海谱系"},{"name":"《三体》","des":"「地球往事」三部曲：宇宙社会学、面壁计划与降维打击，亚洲首部雨果奖最佳长篇。","symbolSize":50,"category":"科幻·星海谱系"},{"name":"尼摩船长","des":"鹦鹉螺号的船长，「我与整个人类社会断绝了一切关系」，凡尔纳的浪子先知。","symbolSize":40,"category":"科幻·星海谱系"},{"name":"机器人三定律","des":"「机器人不得伤害人类」——1942年写就的金律，后世机器人学与AI伦理绕不开的原点。","symbolSize":40,"category":"科幻·星海谱系"},{"name":"罗伯特·海因莱因","des":"「科幻三巨头」之一，《星船伞兵》《异乡异客》，硬汉派科幻与「未来史」的作者。","symbolSize":40,"category":"科幻·星海谱系"},{"name":"亚瑟·克拉克","des":"三巨头之一，《2001太空漫游》与拉玛系列；「任何足够先进的技术，初看都与魔法无异」。","symbolSize":40,"category":"科幻·星海谱系"},{"name":"菲利普·迪克","des":"「我关心的不是未来，而是现在」：《仿生人会梦见电子羊吗》，现实与幻境的拆卸工。","symbolSize":40,"category":"科幻·星海谱系"},{"name":"赛博朋克","des":"「高科技，低生活」：巨型企业、霓虹雨巷、义体与虚拟空间，从文学蔓延成时代美学。","symbolSize":40,"category":"科幻·星海谱系"},{"name":"弗兰克·赫伯特","des":"《沙丘》的厄拉科斯：生态、宗教与政治的太空史诗，「恐惧是思维的杀手」。","symbolSize":40,"category":"科幻·星海谱系"},{"name":"黑暗森林法则","des":"宇宙社会学两条公理推演的冷酷结论：「宇宙就是一座黑暗森林。」","symbolSize":40,"category":"科幻·星海谱系"},{"name":"纸浆杂志时代","des":"《惊奇故事》与《银河》的连载生态：三巨头的发表阵地。","symbolSize":35,"category":"科幻·星海谱系"},{"name":"新浪潮运动","des":"1960 年代英美的实验转向：巴拉德与《危险的幻象》。","symbolSize":35,"category":"科幻·星海谱系"},{"name":"科幻主题树","des":"机器人、时间旅行与外星接触的三大母题谱系。","symbolSize":30,"category":"科幻·星海谱系"},{"name":"硬科幻与软科幻","des":"以科学严谨度分野的两大传统。","symbolSize":25,"category":"科幻·星海谱系"},{"name":"科幻奖项体系","des":"雨果与星云双奖的荣誉制度。","symbolSize":25,"category":"科幻·星海谱系"}],"links":[{"source":"文学名著人物关系","target":"红楼梦","name":"世情","des":"木石前盟与金玉良缘，中国古典小说人物关系的巅峰织锦。"},{"source":"红楼梦","target":"贾宝玉","name":"主人公","des":"阖府围绕的「混世魔王」，一切关系的圆心。"},{"source":"红楼梦","target":"林黛玉","name":"还泪","des":"绛珠仙草的还泪之旅，全书的诗意之源。"},{"source":"红楼梦","target":"王熙凤","name":"管家","des":"荣宁二府的运转中枢，人际网络的关键节点。"},{"source":"红楼梦","target":"金陵十二钗","name":"判词","des":"太虚幻境正册，命运的伏线。"},{"source":"红楼梦","target":"大观园","name":"舞台","des":"青春王国的兴衰之场。"},{"source":"贾宝玉","target":"林黛玉","name":"知己","des":"木石前盟：从两小无猜到诉肺腑，说不出口的深情。"},{"source":"贾宝玉","target":"薛宝钗","name":"姻缘","des":"金玉良缘：掉包计下的婚事，一个出走，一个独守。"},{"source":"林黛玉","target":"薛宝钗","name":"金兰","des":"互剖金兰语、兰言解疑癖，情敌终成姐妹。"},{"source":"贾母","target":"贾宝玉","name":"祖孙","des":"老祖宗的心尖肉，替他挡住严父的板子。"},{"source":"贾政","target":"贾宝玉","name":"父子","des":"恨铁不成钢：大观园试才题对额，宝玉挨打是两代人的正面相撞。"},{"source":"王夫人","target":"贾宝玉","name":"母子","des":"衔玉而生的命根子，母爱里裹着对「狐媚子」的恨意。"},{"source":"贾政","target":"王夫人","name":"夫妻","des":"端方老爷与念佛夫人，荣府正房的规矩联盟。"},{"source":"贾母","target":"林黛玉","name":"外祖母","des":"女儿贾敏的遗孤，老祖宗搂着「心肝儿肉」大哭。"},{"source":"王夫人","target":"薛宝钗","name":"姨母","des":"亲姨侄女，金玉良缘的撮合人。"},{"source":"王熙凤","target":"贾琏","name":"夫妻","des":"凤姐管家贾琏跑外，「一从二令三人木」。"},{"source":"王熙凤","target":"王夫人","name":"内侄女","des":"借调协理荣国府的权力来源。"},{"source":"王熙凤","target":"贾母","name":"承欢","des":"逗趣捧哏的开心果，「凤辣子」的护身符。"},{"source":"贾元春","target":"贾宝玉","name":"姐弟","des":"长姐如母，手引口传教宝玉识字，省亲时携手揽于怀内。"},{"source":"贾探春","target":"贾宝玉","name":"姐弟","des":"同父异母的姐弟，诗社里的常务发起人。"},{"source":"贾探春","target":"王熙凤","name":"对峙","des":"抄检大观园，探春怒斥「自杀自灭」：百足之虫，死而不僵。"},{"source":"史湘云","target":"贾母","name":"侄孙女","des":"娘家史家的血脉，老祖宗的开心亲戚。"},{"source":"史湘云","target":"林黛玉","name":"联诗","des":"凹晶馆联诗「寒塘渡鹤影，冷月葬花魂」，两个孤女的相知。"},{"source":"妙玉","target":"贾宝玉","name":"槛外","des":"红梅与体己茶，槛外人说不清的青眼。"},{"source":"秦可卿","target":"王熙凤","name":"托梦","des":"临终托梦：月满则亏，水满则溢，烈火烹油须留后路。"},{"source":"袭人","target":"贾宝玉","name":"侍奉","des":"准姨娘的温柔规劝，怡红院里最早的「心上人」。"},{"source":"晴雯","target":"贾宝玉","name":"撕扇","des":"撕扇子作千金一笑，病补雀金裘，俏丫鬟抱屈夭风流。"},{"source":"晴雯","target":"王夫人","name":"被逐","des":"「眉眼有些像你林妹妹的」，王夫人的驱逐令要了她的命。"},{"source":"晴雯","target":"袭人","name":"同列","des":"同为怡红院大丫鬟：袭人守礼藏拙，晴雯锋芒毕露。"},{"source":"刘姥姥","target":"贾母","name":"逗趣","des":"「老亲家」两字定交，一个借寿一个讨巧。"},{"source":"刘姥姥","target":"王熙凤","name":"因果","des":"二十两银子的施舍，换来日后巧姐的救赎。"},{"source":"贾雨村","target":"贾政","name":"投靠","des":"宗侄的名帖换来起复，护官符上的门路学问。"},{"source":"贾雨村","target":"贾宝玉","name":"塾师","des":"曾做宝玉塾师，爱谈「成王败寇」的浊世高论。"},{"source":"李纨","target":"贾宝玉","name":"寡嫂","des":"大嫂子清净守节，带着兰哥儿独居稻香村。"},{"source":"贾元春","target":"大观园","name":"省亲","des":"为迎元妃省亲而建，「天上人间诸景备」。"},{"source":"大观园","target":"贾宝玉","name":"怡红院","des":"怡红快绿，公子与群芳的院落。"},{"source":"大观园","target":"林黛玉","name":"潇湘馆","des":"千竿翠竹掩映，凤尾森森，龙吟细细。"},{"source":"金陵十二钗","target":"林黛玉","name":"正册","des":"「堪怜咏絮才」。"},{"source":"金陵十二钗","target":"薛宝钗","name":"正册","des":"「山中高士晶莹雪」。"},{"source":"金陵十二钗","target":"王熙凤","name":"正册","des":"「凡鸟偏从末世来」。"},{"source":"金陵十二钗","target":"贾元春","name":"正册","des":"「虎兕相逢大梦归」。"},{"source":"金陵十二钗","target":"贾探春","name":"正册","des":"「生于末世运偏消」。"},{"source":"金陵十二钗","target":"史湘云","name":"正册","des":"「英豪阔大宽宏量」。"},{"source":"金陵十二钗","target":"妙玉","name":"正册","des":"「欲洁何曾洁」。"},{"source":"金陵十二钗","target":"秦可卿","name":"正册","des":"「情天情海幻情身」。"},{"source":"金陵十二钗","target":"李纨"