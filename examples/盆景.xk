{"version":2,"title":"盆景","description":"一勺水一撮土间的百年山林：流派、树种、造型与技法的完整体系。","nodes":[{"name":"盆景","des":"以盆为纸、以树为笔的立体山水，浓缩的自然与时间。","symbolSize":70,"category":"盆景"},{"name":"源流","des":"从唐代壁画到日本盆栽再到国际展会的一千三百年。","symbolSize":50,"category":"盆景"},{"name":"流派","des":"岭南川苏扬海浙六大流派，各有各的身法与刀法。","symbolSize":50,"category":"盆景"},{"name":"树种","des":"松柏杂木花果三大类，选树如选角。","symbolSize":50,"category":"盆景"},{"name":"造型形式","des":"直干斜干悬崖文人木，构图的格律与变格。","symbolSize":50,"category":"盆景"},{"name":"技法","des":"蟠扎修剪截干蓄枝，与树谈判的全部手艺。","symbolSize":50,"category":"盆景"},{"name":"盆与几架","des":"一景二盆三几架，作品三要素的器物学。","symbolSize":50,"category":"盆景"},{"name":"山水盆景与赏石","des":"树石与纯石的方寸江山，文人的赏石传统。","symbolSize":50,"category":"盆景"},{"name":"唐代盆景壁画","des":"章怀太子墓侍女手捧盆景，世界最早的图像证据。","symbolSize":40,"category":"源流"},{"name":"宋代盆玩","des":"文人案头的袖珍山水，东坡诗里的峰峦。","symbolSize":40,"category":"源流"},{"name":"明清盆景论著","des":"《考槃余事》与《长物志》，盆景第一次写进生活美学。","symbolSize":40,"category":"源流"},{"name":"日本盆栽","des":"遣唐使东传的技艺，大宫盆栽村与国风展的谱系。","symbolSize":40,"category":"源流"},{"name":"盆景国际化","des":"战后经日本走向欧美，成为世界的园艺语言。","symbolSize":40,"category":"源流"},{"name":"岭南派","des":"截干蓄枝的大手笔，苍劲自然的大树缩影。","symbolSize":40,"category":"流派"},{"name":"川派","des":"掉拐与滚龙抱柱的规则身法，严谨的巴蜀古风。","symbolSize":40,"category":"流派"},{"name":"苏派","des":"圆片与六台三托一顶，苏州园林的案头版。","symbolSize":40,"category":"流派"},{"name":"扬派","des":"寸枝三弯的云片，精工细扎的扬州功夫。","symbolSize":40,"category":"流派"},{"name":"海派","des":"博采众长的自然形，大都市的开放气质。","symbolSize":40,"category":"流派"},{"name":"浙派","des":"以五针松见长，高干合栽的豪放路线。","symbolSize":40,"category":"流派"},{"name":"黑松","des":"刚劲针叶的代表，舍利神枝的主角。","symbolSize":40,"category":"树种"},{"name":"五针松","des":"短针密簇的名门，浙派的主打树种。","symbolSize":40,"category":"树种"},{"name":"罗汉松","des":"江南庭院的常青，叶短耐扎的良材。","symbolSize":40,"category":"树种"},{"name":"真柏","des":"柏类舍利艺术的顶流，翠鳞与白骨同树。","symbolSize":40,"category":"树种"},{"name":"雀梅","des":"岭南杂木之王，截干蓄枝的最佳学生。","symbolSize":40,"category":"树种"},{"name":"榔榆","des":"南北通用的小叶杂木，愈剪愈茂的勤快树。","symbolSize":40,"category":"树种"},{"name":"三角枫与鸡爪槭","des":"霜后转红的双枫，落叶后的寒枝另成一景。","symbolSize":40,"category":"树种"},{"name":"黄杨","des":"一寸长三年的慢树，越老越贵的千年矮。","symbolSize":40,"category":"树种"},{"name":"老鸦柿","des":"秋果挂枝的观果新贵，小果如灯。","symbolSize":40,"category":"树种"},{"name":"火棘","des":"红果满枝的观果担当，丰收景象的盆上版。","symbolSize":40,"category":"树种"},{"name":"梅花","des":"疏影横斜的盆上诗，以曲为美的花果类。","symbolSize":40,"category":"树种"},{"name":"杜鹃盆景","des":"花开满冠的酸性土明星，春景的爆点。","symbolSize":40,"category":"树种"},{"name":"紫藤","des":"垂花如瀑的藤本，悬崖式的天然题材。","symbolSize":40,"category":"树种"},{"name":"直干式","des":"一干冲天的正格，稳如泰山的构图。","symbolSize":40,"category":"造型形式"},{"name":"斜干式","des":"倾而不倒的动势，风中的舞者。","symbolSize":40,"category":"造型形式"},{"name":"曲干式","des":"三弯九拐的韵律，规则身法的舞台。","symbolSize":40,"category":"造型形式"},{"name":"卧干式","des":"横卧而起的复苏感，老树回春的叙事。","symbolSize":40,"category":"造型形式"},{"name":"悬崖式","des":"探出盆外的绝壁求生，半悬与全悬两档。","symbolSize":40,"category":"造型形式"},{"name":"临水式","des":"探向水面的岸树，与悬崖的区别在俯仰。","symbolSize":40,"category":"造型形式"},{"name":"文人木","des":"细干高枝的孤高剪影，中日共通的禅意。","symbolSize":40,"category":"造型形式"},{"name":"丛林式","des":"多株合栽的森林叙事，主从聚散的章法。","symbolSize":40,"category":"造型形式"},{"name":"附石式","des":"根抱石头的岩生景观，树石共生。","symbolSize":40,"category":"造型形式"},{"name":"露根式","des":"提根露爪的苍老相，根盘也是看点。","symbolSize":40,"category":"造型形式"},{"name":"舍利干与神","des":"撕皮雕刻的白骨枝干，生死同树的美学。","symbolSize":40,"category":"造型形式"},{"name":"蟠扎","des":"铝丝棕丝的弯枝术，定型前的整形手术。","symbolSize":40,"category":"技法"},{"name":"修剪","des":"摘芽疏枝与回缩，造型的主要语言。","symbolSize":40,"category":"技法"},{"name":"截干蓄枝","des":"一节一节的收尖工程，岭南造型的独门心法。","symbolSize":40,"category":"技法"},{"name":"摘叶控芽","des":"摘老叶促新叶，小叶化的视觉魔法。","symbolSize":40,"category":"技法"},{"name":"嫁接补枝","des":"缺枝处靠接补位，改劣换优的手术。","symbolSize":40,"category":"技法"},{"name":"提根","des":"逐年上提的根系暴露术，露根式的手段。","symbolSize":40,"category":"技法"},{"name":"换盆与修根","des":"二至五年一次的根系更新，盆景的续命功课。","symbolSize":40,"category":"技法"},{"name":"配土","des":"赤玉土鹿沼土的颗粒配方，排水的日式标准。","symbolSize":40,"category":"技法"},{"name":"浇水三年功","des":"盆景界的第一戒律，手上有数全凭年头。","symbolSize":40,"category":"技法"},{"name":"施肥与控肥","des":"薄肥勤施与花前控肥的节奏学。","symbolSize":40,"category":"技法"},{"name":"紫砂盆","des":"宜兴紫砂的呼吸孔隙，与树共老的名器。","symbolSize":40,"category":"盆与几架"},{"name":"釉陶盆","des":"石湾窑变与各地釉色，色彩派的花器。","symbolSize":40,"category":"盆与几架"},{"name":"几架","des":"红木高低几架，作品的底座语法。","symbolSize":40,"category":"盆与几架"},{"name":"一景二盆三几架","des":"好作品三要素的行话排序，景为本器为辅。","symbolSize":40,"category":"盆与几架"},{"name":"名家老盆","des":"名家旧盆本身成为收藏品，器与艺互相抬价。","symbolSize":40,"category":"盆与几架"},{"name":"水旱盆景","des":"树石共处一盆的微景观，盆景与山水画的合流。","symbolSize":40,"category":"山水盆景与赏石"},{"name":"山水盆景","des":"软石雕琢硬石拼接，纯石头堆出的江山。","symbolSize":40,"category":"山水盆景与赏石"},{"name":"太湖石","des":"皱瘦漏透四大字诀，江南园林的名石。","symbolSize":40,"category":"山水盆景与赏石"},{"name":"灵璧石","des":"声如青铜的磬石，帝王书房的清供。","symbolSize":40,"category":"山水盆景与赏石"},{"name":"供石文化","des":"文人案头的清供传统，一块石头的山水想象。","symbolSize":40,"category":"山水盆景与赏石"}],"links":[{"source":"盆景","target":"源流","name":"千年","des":"从唐代壁画到国际展会的一千三百年。"},{"source":"盆景","target":"流派","name":"分宗","des":"六大流派各有身法与刀法。"},{"source":"盆景","target":"树种","name":"选角","des":"松柏杂木花果，各演各的角色。"},{"source":"盆景","target":"造型形式","name":"格律","des":"构图的形式语言。"},{"source":"盆景","target":"技法","name":"手艺","des":"与树谈判的全部手段。"},{"source":"盆景","target":"盆与几架","name":"器物","des":"景盆几三位一体的下半场。"},{"source":"盆景","target":"山水盆景与赏石","name":"山川","des":"从树桩走向石头的另一半传统。"},{"source":"源流","target":"唐代盆景壁画","name":"证据","des":"章怀太子墓的侍女捧盆，最早的图像。"},{"source":"唐代盆景壁画","target":"宋代盆玩","name":"承接","des":"从宫廷赏玩到文人案头。"},{"source":"宋代盆玩","target":"明清盆景论著","name":"立论","des":"经验终于写成了书。"},{"source":"唐代盆景壁画","target":"日本盆栽","name":"东渡","des":"遣唐使把盆栽带回岛国。"},{"source":"日本盆栽","target":"盆景国际化","name":"反哺","des":"战后经日本走向欧美展会。"},{"source":"流派","target":"岭南派","name":"南宗","des":"截干蓄枝的自然刀法。"},{"source":"岭南派","target":"截干蓄枝","name":"独创","des":"一节一节的岭南心法。"},{"source":"流派","target":"川派","name":"身法","des":"掉拐滚龙的规则舞步。"},{"source":"川派","target":"曲干式","name":"舞台","des":"规则身法的展示场。"},{"source":"流派","target":"苏派","name":"圆片","des":"六台三托一顶的圆片章法。"},{"source":"流派","target":"扬派","name":"云片","des":"一寸三弯的精工云片。"},{"source":"流派","target":"海派","name":"海纳","des":"博采众长的自然形。"},{"source":"流派","target":"浙派","name":"松风","des":"五针松高干的豪放派。"},{"source":"浙派","target":"五针松","name":"主打","des":"高干垂枝的松树气象。"},{"source":"树种","target":"黑松","name":"刚劲","des":"舍利神枝的首选松。"},{"source":"黑松","target":"舍利干与神","name":"良材","des":"皮红骨白的生死同树。"},{"source":"树种","target":"五针松","name":"优雅","des":"短针密簇的名门。"},{"source":"树种","target":"罗汉松","name":"常青","des":"江南的耐扎良材。"},{"source":"树种","target":"真柏","name":"顶流","des":"舍利艺术的当家树。"},{"source":"真柏","target":"舍利干与神","name":"绝配","des":"翠鳞与白骨的对照美学。"},{"source":"树种","target":"雀梅","name":"南王","des":"岭南杂木之王。"},{"source":"雀梅","target":"岭南派","name":"门生","des":"截干蓄枝的最佳实践者。"},{"source":"树种","target":"榔榆","name":"通用","des":"南北通吃的小叶杂木。"},{"source":"树种","target":"三角枫与鸡爪槭","name":"秋色","des":"霜后的红与寒枝的骨。"},{"source":"树种","target":"黄杨","name":"岁月","des":"一寸长三年的慢功夫。"},{"source":"树种","target":"老鸦柿","name":"观果","des":"秋果挂枝的新贵。"},{"source":"树种","target":"火棘","name":"红果","des":"满枝红果的丰收相。"},{"source":"树种","target":"梅花","name":"入诗","des":"疏影横斜的花果类。"},{"source":"梅花","target":"曲干式","name":"相宜","des":"梅以曲为美，老干新枝。"},{"source":"树种","target":"杜鹃盆景","name":"花球","des":"花开满冠的春景。"},{"source":"树种","target":"紫藤","name":"垂瀑","des":"悬瀑造型的藤本。"},{"source":"紫藤","target":"悬崖式","name":"下垂","des":"花序天然的垂势。"},{"source":"造型形式","target":"直干式","name":"正格","des":"稳如泰山的构图。"},{"source":"造型形式","target":"斜干式","name":"动势","des":"倾而不倒的风姿。"},{"source":"造型形式","target":"曲干式","name":"韵律","des":"三弯九拐的身法。"},{"source":"造型形式","target":"卧干式","name":"苏醒","des":"横卧而起的复苏感。"},{"source":"造型形式","target":"悬崖式","name":"绝境","des":"探出盆外的求生欲。"},{"source":"悬崖式","target":"临水式","name":"对照","des":"一个俯冲一个平出。"},{"source":"造型形式","target":"文人木","name":"孤高","des":"细干高枝的禅意剪影。"},{"source":"造型形式","target":"丛林式","name":"森林","des":"多株合栽的叙事。"},{"source":"造型形式","target":"附石式","name":"岩生","des":"根抱石的共生。"},{"source":"造型形式","target":"露根式","name":"苍老","des":"露根如爪的年轮感。"},{"source":"露根式","target":"提根","name":"手段","des":"提根术造出的老相。"},{"source":"技法","target":"