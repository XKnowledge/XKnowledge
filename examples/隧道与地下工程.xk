{
  "version": 2,
  "title": "隧道与地下工程",
  "description": "向下的长征：从矿工的坑道到穿海的巨盾，矿山法、盾构、沉管三大工法各擅胜场——人类在地表之下再造的第二层文明。",
  "nodes": [
    { "name": "隧道与地下工程", "des": "向下的长征：凿岩、推盾、沉管三路并进，人类在地表之下再造一层文明。", "symbolSize": 70, "category": "隧道与地下工程" },
    { "name": "矿山法传统", "des": "矿工传下来的手艺：钻眼、爆破、支护，山里凿洞的最古老工法。", "symbolSize": 50, "category": "矿山法传统" },
    { "name": "采矿坑道", "des": "从矿工的巷道到穿山的大路，地下工程的祖师爷在矿山上。", "symbolSize": 40, "category": "矿山法传统" },
    { "name": "钻爆法", "des": "凿岩机打眼、装药、起爆，进尺与扰动的取舍艺术。", "symbolSize": 40, "category": "矿山法传统" },
    { "name": "炸药谱系", "des": "黑火药到硝化甘油再到乳化炸药，威力与安全的漫长平衡。", "symbolSize": 40, "category": "矿山法传统" },
    { "name": "新奥法", "des": "让围岩自己承重，支护只帮一把：六十年代改写隧道哲学。", "symbolSize": 40, "category": "矿山法传统" },
    { "name": "喷锚支护", "des": "喷混凝土、锚杆加钢拱架，与围岩共同受力的柔性铠甲。", "symbolSize": 40, "category": "矿山法传统" },
    { "name": "台阶法与全断面", "des": "大洞化小、分部开挖，地质说了算的开挖菜单。", "symbolSize": 40, "category": "矿山法传统" },
    { "name": "光面爆破", "des": "周边眼密布小药量，爆出平整轮廓少扰动。", "symbolSize": 40, "category": "矿山法传统" },
    { "name": "超前地质预报", "des": "地震波与超前钻探，给掌子面装上前视眼。", "symbolSize": 40, "category": "矿山法传统" },
    { "name": "涌水突泥", "des": "掌子面后暗藏的地下河，隧道人最怕的突涌。", "symbolSize": 40, "category": "矿山法传统" },
    { "name": "盾构革命", "des": "一边挖一边衬：圆柱形钢铁地龙让穿江过海变成流水线。", "symbolSize": 50, "category": "盾构革命" },
    { "name": "船蛆的启发", "des": "布鲁内尔盯上船蛆钻木的头壳，盾构概念图来自甲壳类。", "symbolSize": 40, "category": "盾构革命" },
    { "name": "泰晤士隧道", "des": "1825到1843，塌涌不断十八年，世界第一座水下人行隧道。", "symbolSize": 40, "category": "盾构革命" },
    { "name": "格雷特黑德盾构", "des": "1884年压气加圆盾定型，伦敦软土里的地老鼠。", "symbolSize": 40, "category": "盾构革命" },
    { "name": "掘进机TBM", "des": "罗宾斯的旋转刀盘啃硬岩，日进尺数十米的钢铁穿山甲。", "symbolSize": 40, "category": "盾构革命" },
    { "name": "泥水与土压平衡", "des": "泥水仓或土仓顶住开挖面，城市地层不再塌陷。", "symbolSize": 40, "category": "盾构革命" },
    { "name": "复合式盾构", "des": "软硬通吃的混合刀盘，一机穿过一部地质百科。", "symbolSize": 40, "category": "盾构革命" },
    { "name": "管片衬砌", "des": "预制弧片拼成一环，盾构边挖边给自己穿铠甲。", "symbolSize": 40, "category": "盾构革命" },
    { "name": "始发与到达", "des": "从工作井破壁出发，到接收井被请出地面。", "symbolSize": 40, "category": "盾构革命" },
    { "name": "沉降控制", "des": "同步注浆加姿态纠偏，头顶楼群的毫米级敬畏。", "symbolSize": 40, "category": "盾构革命" },
    { "name": "沉管隧道", "des": "岸上预制巨管、浮运沉放对接：水底工程的预制装配路线。", "symbolSize": 50, "category": "沉管隧道" },
    { "name": "沉管的逻辑", "des": "把水下作业搬回岸上船坞，工期与质量一起打包。", "symbolSize": 40, "category": "沉管隧道" },
    { "name": "底特律河隧道", "des": "1910年铁路沉管首航，美国河底的先行试验。", "symbolSize": 40, "category": "沉管隧道" },
    { "name": "厄勒海峡隧道", "des": "2000年二十节沉管连起哥本哈根与马尔默。", "symbolSize": 40, "category": "沉管隧道" },
    { "name": "港珠澳沉管", "des": "三十三节巨管深海对接，半刚性沉管的中国方案。", "symbolSize": 40, "category": "沉管隧道" },
    { "name": "管段预制场", "des": "干坞里的巨型产房，一节管段一座小楼。", "symbolSize": 40, "category": "沉管隧道" },
    { "name": "最终接头", "des": "合龙口的楔形钢壳，水下最后一厘米的精确落位。", "symbolSize": 40, "category": "沉管隧道" },
    { "name": "GINA止水带", "des": "管段接头处的大橡胶圈，压水即密封的巧思。", "symbolSize": 40, "category": "沉管隧道" },
    { "name": "基槽与清淤", "des": "挖槽、抛石、整平，沉管的河床要平如手术台。", "symbolSize": 40, "category": "沉管隧道" },
    { "name": "明挖与顶进", "des": "最直接的地下工法：挖开修好再回填，或从障碍物底下顶过去。", "symbolSize": 50, "category": "明挖与顶进" },
    { "name": "明挖回填", "des": "挖开、浇筑、回填，最古老也最直接，闹市地铁的常选。", "symbolSize": 40, "category": "明挖与顶进" },
    { "name": "首条地铁", "des": "1863年伦敦大都会铁路，明挖法修出的蒸汽地铁。", "symbolSize": 40, "category": "明挖与顶进" },
    { "name": "盖挖法", "des": "先盖板后开挖，路面照常通车，商店照常开门。", "symbolSize": 40, "category": "明挖与顶进" },
    { "name": "基坑支护", "des": "围护桩加内支撑，深坑先穿骨架再挖土。", "symbolSize": 40, "category": "明挖与顶进" },
    { "name": "箱涵顶进", "des": "预制箱涵从铁路底下顶过去，火车头顶上的地道。", "symbolSize": 40, "category": "明挖与顶进" },
    { "name": "顶管法", "des": "小口径管道的地下穿行，过路不掘路。", "symbolSize": 40, "category": "明挖与顶进" },
    { "name": "辅助工法", "des": "冻、注、降、棚：给不良地质加 buff 的四大护法。", "symbolSize": 50, "category": "辅助工法" },
    { "name": "冻结法", "des": "1883年珀奇专利，把含水地层冻成冻土再开挖。", "symbolSize": 40, "category": "辅助工法" },
    { "name": "注浆加固", "des": "水泥与化学浆液填满裂隙，松散地层变磐石。", "symbolSize": 40, "category": "辅助工法" },
    { "name": "井点降水", "des": "轻井点抽走地下水，干开挖的先行官。", "symbolSize": 40, "category": "辅助工法" },
    { "name": "管棚超前", "des": "钢管在掌子面上方先撑起棚顶，软土里先护后挖。", "symbolSize": 40, "category": "辅助工法" },
    { "name": "城市地下空间", "des": "地铁、管廊、深隧、地下街：城市向地下长出的第二张网。", "symbolSize": 50, "category": "城市地下空间" },
    { "name": "地铁网络", "des": "从伦敦一环到上海八百公里，城市往地下再长一遍。", "symbolSize": 40, "category": "城市地下空间" },
    { "name": "地下街", "des": "东京八重洲到蒙特利尔地下城，严寒酷暑里的另一座城。", "symbolSize": 40, "category": "城市地下空间" },
    { "name": "综合管廊", "des": "水电气信一廊通行，马路告别拉链式开挖。", "symbolSize": 40, "category": "城市地下空间" },
    { "name": "引水隧洞", "des": "水电站的引水隧洞与调压井，大山腹中的水力机关。", "symbolSize": 40, "category": "城市地下空间" },
    { "name": "深层排水深隧", "des": "芝加哥深隧与武汉大东湖深隧，暴雨季的城市胃。", "symbolSize": 40, "category": "城市地下空间" },
    { "name": "战略储备库", "des": "地下水封油库与粮库，国家的隐秘仓廪。", "symbolSize": 40, "category": "城市地下空间" },
    { "name": "人防工程", "des": "从防空洞到地下商城，冷战记忆的和平利用。", "symbolSize": 40, "category": "城市地下空间" },
    { "name": "世纪工程", "des": "穿海峡、贯阿尔卑斯、越天山：写进纪录的地下长征。", "symbolSize": 50, "category": "世纪工程" },
    { "name": "英法海峡隧道", "des": "1994年通车50.5公里，英伦岛与大陆二百年后重逢。", "symbolSize": 40, "category": "世纪工程" },
    { "name": "青函隧道", "des": "1988年通车53.85公里，二十四年凿穿津轻海峡。", "symbolSize": 40, "category": "世纪工程" },
    { "name": "圣哥达基线隧道", "des": "2016年通车57公里，世界最长铁路隧道，阿尔卑斯的平底快线。", "symbolSize": 40, "category": "世纪工程" },
    { "name": "洛达尔隧道", "des": "2000年通车24.5公里，世界最长公路隧道，三处巨穴破单调。", "symbolSize": 40, "category": "世纪工程" },
    { "name": "终南山隧道", "des": "2007年18公里穿秦岭，中国公路隧道的里程碑。", "symbolSize": 40, "category": "世纪工程" },
    { "name": "天山胜利隧道", "des": "2025年贯通22公里，改写世界最长高速公路隧道纪录。", "symbolSize": 40, "category": "世纪工程" },
    { "name": "东京湾横断道路", "des": "1997年隧桥结合穿湾，把湾区缝合为一线。", "symbolSize": 40, "category": "世纪工程" },
    { "name": "安全与未来", "des": "防火灾、控沉降、盯健康，再往深处去：从深地实验室到月面熔岩管。", "symbolSize": 50, "category": "安全与未来" },
    { "name": "勃朗峰隧道火灾", "des": "1999年39人罹难，欧洲隧道安全规范由此重写。", "symbolSize": 40, "category": "安全与未来" },
    { "name": "全尺寸燃烧试验", "des": "真车真火在隧道里烧出来的规范条款。", "symbolSize": 40, "category": "安全与未来" },
    { "name": "通风与排烟", "des": "射流风机与纵向通风，火灾时的排烟求生通道。", "symbolSize": 40, "category": "安全与未来" },
    { "name": "防排水体系", "des": "防水板、盲沟与注浆堵水，滴水不漏是昂贵的承诺。", "symbolSize": 40, "category": "安全与未来" },
    { "name": "逃生横通道", "des": "双洞之间的横通道互为退路，间距就是安全距离。", "symbolSize": 40, "category": "安全与未来" },
    { "name": "深地实验室", "des": "锦屏2400米岩层之下，宇宙射线到不了的前沿物理。", "symbolSize": 40, "category": "安全与未来" },
    { "name": "核废料深埋", "des": "芬兰翁卡洛，以十万年为尺度的封存责任。", "symbolSize": 40, "category": "安全与未来" },
    { "name": "跨海通道宏图", "des": "直布罗陀到琼州海峡，工程边界的下一战。", "symbolSize": 40, "category": "安全与未来" },
    { "name": "月下掘进", "des": "熔岩管里的月球基地构想，隧道技术的星际番外。", "symbolSize": 40, "category": "安全与未来" }
  ],
