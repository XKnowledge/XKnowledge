{
  "version": 2,
  "title": "家电演变",
  "description": "把仆役、井水与炉火装进铁盒子：冰箱、洗衣机、空调的技术谱系，加上厨房、清洁与个护电器——二十世纪最安静的一场家庭革命。",
  "nodes": [
    { "name": "家电演变", "des": "把仆役、井水与炉火装进铁盒子：二十世纪最安静的一场家庭革命。", "symbolSize": 70, "category": "家电演变" },
    { "name": "制冷前史", "des": "冰窖与冰盒的年代：要凉，先得运冰，再学会造冰。", "symbolSize": 50, "category": "制冷前史" },
    { "name": "天然冰贸易", "des": "新英格兰锯冰船运热带，十九世纪的冷链全球化。", "symbolSize": 40, "category": "制冷前史" },
    { "name": "冰盒与送冰人", "des": "橡木柜里放冰块，送冰人挨家投递的旧时光。", "symbolSize": 40, "category": "制冷前史" },
    { "name": "制冰厂", "des": "机器制冰取代天然冰，城市冷饮业的物质基础。", "symbolSize": 40, "category": "制冷前史" },
    { "name": "卡雷循环原理", "des": "蒸发吸热的逆热机，一切机械制冷的理论底座。", "symbolSize": 40, "category": "制冷前史" },
    { "name": "首台家用电冰箱", "des": "一九一三年多米尼试水，冰箱从工程件变家什。", "symbolSize": 40, "category": "制冷前史" },
    { "name": "凯尔维纳特量产", "des": "一九一八年品牌化量产，冰箱走进中产厨房。", "symbolSize": 40, "category": "制冷前史" },
    { "name": "冰箱成熟", "des": "全封闭压缩机与氟利昂：冷藏链进入厨房的深水区。", "symbolSize": 50, "category": "冰箱成熟" },
    { "name": "米奇利与氟利昂", "des": "一九二八年合成氟氯烃，安全不燃的奇迹与臭氧隐患。", "symbolSize": 40, "category": "冰箱成熟" },
    { "name": "全封闭压缩机", "des": "电机泵体合一封进壳体，冰箱安静长寿的关键件。", "symbolSize": 40, "category": "冰箱成熟" },
    { "name": "双门与风冷无霜", "des": "冷冻冷藏分箱各控温，自动化霜告别冰铲。", "symbolSize": 40, "category": "冰箱成熟" },
    { "name": "吸收式冰箱", "des": "无压缩机静音可用燃气，酒店客房的默默凉意。", "symbolSize": 40, "category": "冰箱成熟" },
    { "name": "冷藏链与冷冻柜", "des": "从产地冷库到家用冷柜，食物储藏的全程低温革命。", "symbolSize": 40, "category": "冰箱成熟" },
    { "name": "无氟替代", "des": "蒙特利尔议定书淘汰氟利昂，碳氢制冷剂时代。", "symbolSize": 40, "category": "冰箱成熟" },
    { "name": "洗衣革命", "des": "从搓板到滚筒：家务里最重的一小时被机器接管。", "symbolSize": 50, "category": "洗衣革命" },
    { "name": "搓板与捣衣", "des": "河埠棒槌声声，洗衣的千年体力活。", "symbolSize": 40, "category": "洗衣革命" },
    { "name": "手摇与蒸汽洗衣", "des": "曲柄搅桶与洗衣作坊，机器代手的先声。", "symbolSize": 40, "category": "洗衣革命" },
    { "name": "首台电动洗衣机", "des": "一九一〇年代电机驱动搅桶，甩干与安全尚远。", "symbolSize": 40, "category": "洗衣革命" },
    { "name": "肥皂与洗涤剂", "des": "从皂角胰子到合成洗涤剂，洗衣机的水电搭档。", "symbolSize": 40, "category": "洗衣革命" },
    { "name": "搅拌式与波轮", "des": "美式立桶搅拌、日式波轮涡卷，两条技术路线。", "symbolSize": 40, "category": "洗衣革命" },
    { "name": "滚筒与烘干", "des": "欧式滚筒摔打洗净，冷凝烘干一体成套。", "symbolSize": 40, "category": "洗衣革命" },
    { "name": "全自动与变频直驱", "des": "程控进水到直驱电机，洗衣进入一键时代。", "symbolSize": 40, "category": "洗衣革命" },
    { "name": "空调世纪", "des": "从印刷厂除湿到全民冷气：温度也成了商品。", "symbolSize": 50, "category": "空调世纪" },
    { "name": "开利与除湿", "des": "一九〇二年为印刷厂控温控湿，空调先伺候机器。", "symbolSize": 40, "category": "空调世纪" },
    { "name": "窗式空调", "des": "一九三〇年代塞进窗框的整机，房间制冷的开端。", "symbolSize": 40, "category": "空调世纪" },
    { "name": "分体机与中央空调", "des": "室内外机分体、楼宇风道送冷，冷气的两种尺度。", "symbolSize": 40, "category": "空调世纪" },
    { "name": "热泵", "des": "制冷循环反着走，一份电搬走两份热。", "symbolSize": 40, "category": "空调世纪" },
    { "name": "变频压缩机", "des": "按需调速恒温省电，空调心脏的进化。", "symbolSize": 40, "category": "空调世纪" },
    { "name": "制冷剂变迁", "des": "R22 到 R410a 再到 R32，环保推着冷媒换血。", "symbolSize": 40, "category": "空调世纪" },
    { "name": "新风与净化", "des": "换气过滤与除菌入列，空调兼管空气质量。", "symbolSize": 40, "category": "空调世纪" },
    { "name": "空调普及与东亚制造", "des": "战后冷气普及改写城市，中日厂商主导全球产能。", "symbolSize": 40, "category": "空调世纪" },
    { "name": "厨房电器", "des": "电进厨房：火与刀之后，炊事的第三次革命。", "symbolSize": 50, "category": "厨房电器" },
    { "name": "电灶与电烤箱", "des": "电阻丝替代明火，厨房去烟化的第一步。", "symbolSize": 40, "category": "厨房电器" },
    { "name": "微波炉", "des": "雷达磁控管融化巧克力，一九四七年雷达炉上舰。", "symbolSize": 40, "category": "厨房电器" },
    { "name": "电饭煲", "des": "一九五五年东芝上市，磁钢限温自动跳闸。", "symbolSize": 40, "category": "厨房电器" },
    { "name": "电磁炉", "des": "涡流直接加热锅底，灶台变成一块玻璃。", "symbolSize": 40, "category": "厨房电器" },
    { "name": "抽油烟机", "des": "中式爆炒催生的滤网风柜，厨房的排烟器官。", "symbolSize": 40, "category": "厨房电器" },
    { "name": "多士炉与面包机", "des": "弹跳烤面包与小家电军团的欧美味蕾。", "symbolSize": 40, "category": "厨房电器" },
    { "name": "厨师机与料理棒", "des": "电机接管打蛋揉面与切碎，厨房里的电动工具。", "symbolSize": 40, "category": "厨房电器" },
    { "name": "清洁电器", "des": "吸走尘土的电机战争：从地毯清扫器到扫地机器人。", "symbolSize": 50, "category": "清洁电器" },
    { "name": "地毯清扫器", "des": "滚刷手推无动力，吸尘器的直系前身。", "symbolSize": 40, "category": "清洁电器" },
    { "name": "胡佛与立式吸尘", "des": "一九〇八年专利立式机，吸尘器成了动词。", "symbolSize": 40, "category": "清洁电器" },
    { "name": "卧式与尘袋", "des": "箱体拖管配尘袋过滤，欧式家庭的标配。", "symbolSize": 40, "category": "清洁电器" },
    { "name": "戴森旋风分离", "des": "一九八三年气旋除尘免尘袋，吸力的再定义。", "symbolSize": 40, "category": "清洁电器" },
    { "name": "扫地机器人", "des": "二〇〇二年圆盘机器人上岗，家务再让一寸。", "symbolSize": 40, "category": "清洁电器" },
    { "name": "洗地机与蒸汽拖把", "des": "吸拖一体与蒸汽除菌，湿式清洁的新军团。", "symbolSize": 40, "category": "清洁电器" },
    { "name": "个护小家电", "des": "电替手执剪刀与熨斗：仪容与整洁的电气化。", "symbolSize": 50, "category": "个护小家电" },
    { "name": "电熨斗", "des": "一八八二年电热熨烫，衬衫平展的日常功课。", "symbolSize": 40, "category": "个护小家电" },
    { "name": "电风扇", "des": "摇头扇到无叶扇，人造风的百年演进。", "symbolSize": 40, "category": "个护小家电" },
    { "name": "电吹风", "des": "手持热风烘干，理发手艺的工业化。", "symbolSize": 40, "category": "个护小家电" },
    { "name": "电动剃须刀", "des": "一九三〇年代往复刀网问世，干刮的自由。", "symbolSize": 40, "category": "个护小家电" },
    { "name": "电动牙刷", "des": "一九五四年医师推出声波振动，刷牙也有了电机。", "symbolSize": 40, "category": "个护小家电" },
    { "name": "电热水壶", "des": "蒸汽开关自动断电，一杯开水的等待缩短。", "symbolSize": 40, "category": "个护小家电" },
    { "name": "家电与社会", "des": "家电不省家务，而是重写家务：电气化厨房里的性别与标准。", "symbolSize": 50, "category": "家电与社会" },
    { "name": "电气化厨房", "des": "从煤炉到电灶，厨房设计围绕插座重新排布。", "symbolSize": 40, "category": "家电与社会" },
    { "name": "家务时间之争", "des": "省力还是抬高标准，家电史的永恒辩题。", "symbolSize": 40, "category": "家电与社会" },
    { "name": "白色家电产业", "des": "流水线与品牌战国，耐用消费品的百年赛道。", "symbolSize": 40, "category": "家电与社会" },
