{"version":2,"nodes":[{"name":"法学","des":"以法为对象的学问：从汉谟拉比石柱上的同态复仇到罗尔斯的无知之幕，人类用四千年追问权力与权利如何共处。","symbolSize":70,"category":"法系与源流"},{"name":"汉谟拉比法典","des":"约公元前1754年刻于玄武岩石柱，282条涵盖租赁、婚姻与伤害，公开成文与等级义务的最早完整样本。","symbolSize":50,"category":"法系与源流"},{"name":"罗马法","des":"从十二表到国法大全的千年体系，私法之精妙使其越过帝国废墟，成为大陆法系共同的底本。","symbolSize":50,"category":"法系与源流"},{"name":"十二表法","des":"公元前451至前450年铸于铜表，罗马最早的成文法，平民斗争迫使贵族把法公之于众。","symbolSize":40,"category":"法系与源流"},{"name":"乌尔比安","des":"罗马五大法学家之一，首创公法与私法之分，言「法是善与公正的艺术」。","symbolSize":40,"category":"法系与源流"},{"name":"国法大全","des":"6世纪查士丁尼主持汇编的《学说汇纂》《法学阶梯》等总集，罗马法就此定型，千年后成为复兴火种。","symbolSize":40,"category":"法系与源流"},{"name":"大陆法系","des":"以成文法典与学理体系为主干的法族，源自罗马法，经法国、德国两次法典化浪潮播及全球。","symbolSize":50,"category":"法系与源流"},{"name":"普通法系","des":"1066年诺曼征服后由王室法官巡回累积判例而成，遵循先例、重程序救济，随英帝国传遍世界。","symbolSize":50,"category":"法系与源流"},{"name":"遵循先例","des":"stare decisis：同类案件同等待遇，让法官造法既灵活又不失可预期，普通法的稳定锚。","symbolSize":40,"category":"法系与源流"},{"name":"衡平法","des":"普通法救济僵硬之处，由大法官以良心与衡平补足，1873年司法改革后两轨合一。","symbolSize":40,"category":"法系与源流"},{"name":"伊斯兰法系","des":"以《古兰经》与圣训为首要渊源的宗教法，沙里亚统摄信仰、伦理与日常，法学家阐释传统深厚。","symbolSize":40,"category":"法系与源流"},{"name":"中华法系","des":"以唐律为母法、礼法合一、民刑有别的东亚法传统，辐射朝鲜、日本与越南，至清末修律而解体。","symbolSize":50,"category":"法系与源流"},{"name":"唐律疏议","des":"唐永徽四年（653年）律文与疏议合璧颁行，一准乎礼、科条简要，中华法系的巅峰与域外蓝本。","symbolSize":50,"category":"法系与源流"},{"name":"清末修律","des":"1902年起仿大陆法系体例删改旧律、创订新章，延续千余年的中华法系就此转身。","symbolSize":40,"category":"法系与源流"},{"name":"沈家本","des":"清末修订法律大臣，主持翻译西法、删酷刑、订新律，会通中西的近代转型关键人物。","symbolSize":40,"category":"法系与源流"},{"name":"自然法","des":"法之上尚有法：正义的标准高于人定法，「恶法非法」命题自斯多亚传至二战审判的千年源头。","symbolSize":50,"category":"法理学"},{"name":"阿奎那","des":"经院哲学集大成者，将法律排为永恒法、自然法、神法与人法的层级，自然法由此嵌入神学大厦。","symbolSize":40,"category":"法理学"},{"name":"格劳秀斯","des":"「纵无上帝，自然法依然有效」：1625年《战争与和平法》令自然法世俗化，兼开近代国际法。","symbolSize":40,"category":"法理学"},{"name":"法律实证主义","des":"法律的效力来自由权威颁布这一事实，与其道德善恶无涉，「恶法亦法」是它背了百年的标签。","symbolSize":50,"category":"法理学"},{"name":"奥斯丁","des":"分析法学开山者，称法律是主权者以制裁为后盾的命令，法学从此与伦理学分家。","symbolSize":40,"category":"法理学"},{"name":"凯尔森","des":"纯粹法学：规范层层授权直至悬设的基础规范，把道德彻底请出法律科学。","symbolSize":40,"category":"法理学"},{"name":"哈特","des":"1961年《法律的概念》以规则与内在观点重构法律，承认规则化解命令说的困境。","symbolSize":50,"category":"法理学"},{"name":"富勒","des":"提出法律八项内在道德：一般、公布、明确、不溯及既往……以程序自然法回应实证主义。","symbolSize":40,"category":"法理学"},{"name":"德沃金","des":"驳哈特规则模式：法律还包含原则，法官须在整全法中寻找唯一正解，主张认真对待权利。","symbolSize":40,"category":"法理学"},{"name":"法律与道德之辩","des":"由纳粹告密者案引发的哈特—富勒论战与拉德布鲁赫公式，法哲学史上最著名的交锋。","symbolSize":40,"category":"法理学"},{"name":"功利主义","des":"边沁的算术：行为的正当在于最大多数人的最大幸福，立法与社会改革皆可据此计算。","symbolSize":40,"category":"法理学"},{"name":"边沁","des":"功利主义立法设计师，讥普通法为「狗法」，毕生鼓吹全面法典化并亲手起草范本。","symbolSize":40,"category":"法理学"},{"name":"历史法学派","des":"1814年萨维尼对蒂堡论战所创：法如语言，是民族精神的有机生长，反对仓促立法典。","symbolSize":40,"category":"法理学"},{"name":"萨维尼","des":"历史法学派宗师、潘德克顿学说的集大成者，那场论战让德国民法典晚了半个世纪却更精工。","symbolSize":50,"category":"法理学"},{"name":"耶林","des":"由概念法学转向目的法学，《为权利而斗争》言主张权利是对自己与社会的义务。","symbolSize":40,"category":"法理学"},{"name":"霍姆斯","des":"「法律的生命不在于逻辑而在于经验」：1881年《普通法》的格言，最高法院大法官任上三十年。","symbolSize":50,"category":"法理学"},{"name":"法律现实主义","des":"卢埃林与弗兰克为代表：与其空谈规则，不如研究法官实际怎么做，法学转向经验。","symbolSize":40,"category":"法理学"},{"name":"马克斯·韦伯","des":"以理想型分法律为形式理性诸种，断言形式理性法与资本主义有亲和关系。","symbolSize":40,"category":"法理学"},{"name":"拉德布鲁赫","des":"新康德主义法哲学家，1946年提出拉德布鲁赫公式：实定法与正义冲突到不可容忍时即失其法性。","symbolSize":40,"category":"法理学"},{"name":"罗尔斯","des":"1971年《正义论》以社会契约重启规范政治哲学，两个正义原则自此成为讨论的公共坐标。","symbolSize":50,"category":"法理学"},{"name":"无知之幕","des":"缔约者不知自己将处的阶层、天赋与命运，唯有如此选出的原则才配称正义。","symbolSize":40,"category":"法理学"},{"name":"宪法","des":"规定国家权力如何组织、公民权利如何保障的根本法，其最高效力须靠审查机制兑现。","symbolSize":50,"category":"宪法与公法"},{"name":"大宪章","des":"1215年约翰王被迫签署，第39条非经同侪合法裁判不得拘禁，「王在法下」首次成文。","symbolSize":40,"category":"宪法与公法"},{"name":"社会契约论","des":"国家权力源自人民同意的让渡：洛克护自由，卢梭主公意，现代宪政的规范地基。","symbolSize":40,"category":"宪法与公法"},{"name":"洛克","des":"《政府论》主张生命自由财产不可让渡，政府背约则人民有权反抗，分权思想先声。","symbolSize":40,"category":"宪法与公法"},{"name":"卢梭","des":"1762年《社会契约论》以公意立说，人民主权论直接点燃法国大革命。","symbolSize":40,"category":"宪法与公法"},{"name":"孟德斯鸠","des":"《论法的精神》1748年借英格兰政制提炼三权分立，兼开比较法学与法社会学先河。","symbolSize":50,"category":"宪法与公法"},{"name":"三权分立","des":"立法、行政、司法分立且互相制衡，1787年美国宪法将其落为可运行的制度。","symbolSize":50,"category":"宪法与公法"},{"name":"违宪审查","des":"由司法机关审查法律是否抵触宪法：宪法的最高效力由此长出牙齿。","symbolSize":50,"category":"宪法与公法"},{"name":"马伯里诉麦迪逊","des":"1803年马歇尔以「马伯里的委任状」为引，为最高法院争得违宪审查权。","symbolSize":40,"category":"宪法与公法"},{"name":"人权","des":"人之为人生而固有的权利，从自然权利学说到二战后的国际人权公约，宪政的规范核心。","symbolSize":50,"category":"宪法与公法"},{"name":"人权宣言","des":"1789年法国《人权与公民权宣言》：人生而自由平等，财产安全与反抗压迫乃天赋。","symbolSize":40,"category":"宪法与公法"},{"name":"世界人权宣言","des":"1948年联合国大会通过，30条为普世人权立下共同标准，国际人权法的总纲。","symbolSize":40,"category":"宪法与公法"},{"name":"正当程序","des":"非经正当法律程序，不得剥夺生命、自由或财产，程序正义的宪法化表达。","symbolSize":40,"category":"宪法与公法"},{"name":"行政法","des":"控制行政权运行的法：授权有据、程序公开、救济有门三重防线。","symbolSize":40,"category":"宪法与公法"},{"name":"比例原则","des":"公法帝王条款：目的适当、手段必要、损益均衡，审查公权力干涉的三把尺。","symbolSize":40,"category":"宪法与公法"},{"name":"戴雪","des":"《英宪精义》1885年，以议会主权与法治两大原则疏解不成文宪制的英国经验。","symbolSize":40,"category":"宪法与公法"},{"name":"民法","des":"调整平等主体间人身与财产关系的私法，市场交易与日常生活的基本规则。","symbolSize":50,"category":"民法"},{"name":"法国民法典","des":"1804年拿破仑主持编纂，三编制结构，革命平等理想与法国南部习惯的合流。","symbolSize":50,"category":"民法"},{"name":"德国民法典","des":"1896年通过、1900年施行，五编制潘德克顿体系，概念精确如钟表，抽象总则冠绝各法典。","symbolSize":50,"category":"民法"},{"name":"潘德克顿体系","des":"由罗马法学说提炼的总则、债、物、亲属、继承五编制，德民蓝本，远播东亚拉美。","symbolSize":40,"category":"民法"},{"name":"法律行为","des":"以意思表示为核心设立变更消灭法律关系的构造，德国民法最抽象也最强大的工具。","symbolSize":40,"category":"民法"},{"name":"物权","des":"直接支配物并排除他人的绝对权，物权法定与公示原则守护交易的静的安全。","symbolSize":40,"category":"民法"},{"name":"债权","des":"请求特定人为特定行为的相对权，合同、侵权、无因管理与不当得利为其四种发生根据。","symbolSize":40,"category":"民法"},{"name":"合同","des":"两个意思表示的合致即生拘束，私法自治最日常的舞台，市场经济的基本细胞。","symbolSize":40,"category":"民法"},{"name":"侵权责任","des":"因过错侵害他人权益即须赔偿，从结果责任到过错责任，文明的刻度之一。","symbolSize":40,"category":"民法"},{"name":"中国民法典","des":"2020年通过、2021年施行，七编制1260条，人格权独立成编开世界法典之先例。","symbolSize":50,"category":"民法"},{"name":"刑法","des":"规定犯罪、刑事责任与刑罚的国家强行法，既是打击利刃也是保障公民的大宪章。","symbolSize":50,"category":"刑法"},{"name":"罪刑法定","des":"nullum crimen, nulla poena sine lege：无法律明文则无罪无刑，刑法的第一铁则。","symbolSize":50,"category":"刑法"},{"name":"费尔巴哈","des":"1801年以拉丁格言确立罪刑法定，并提出心理强制说：以刑罚的必定性威慑潜在犯罪人。","symbolSize":40,"category":"刑法"},{"name":"贝卡利亚","des":"26岁写下《论犯罪与刑罚》的米兰贵族，启蒙刑罚观的旗帜，酷刑与死刑的著名论敌。","symbolSize":50,"category":"刑法"},{"name":"论犯罪与刑罚","des":"1764年匿名出版的小册子：刑罚的及时与必定重于严酷，死刑当废、酷刑当止。","symbolSize":40,"category":"刑法"},{"name":"无罪推定","des":"未经法院生效判决有罪，任何人均应被推定无罪，举证责任与证明标准皆由控方承担。","symbolSize":40,"category":"刑法"},{"name":"犯罪构成","des":"成立犯罪须齐备的要件体系，四要件平面与三阶层递进两大谱系，刑法学的核心装置。","symbolSize":40,"category":"刑法"},{"name":"正当防卫","des":"对正在进行的不法侵害可反击而不负刑责，「法不得向不法让步」的权利宣示。","symbolSize":40,"category":"刑法"},{"name":"刑罚目的","des":"报应回望罪行，预防前瞻未来：一般威慑与特殊预防的配比争论两百年未歇。","symbolSize":40,"category":"刑法"},{"name":"李斯特","des":"目的刑论与刑事政策大师：「应受惩罚的不是行为而是行为人」，实证学派的旗手。","symbolSize":40,"category":"刑法"},{"name":"死刑存废","des":"贝卡利亚开题的两百年论战：报应正义、威慑实效与误判不可逆之间的权衡。","symbolSize":40,"category":"刑法"},{"name":"龙勃罗梭","des":"测量罪犯颅骨提出天生犯罪人说，开创实证犯罪学，刑法目光从行为转向行为人。","symbolSize":40,"category":"刑法"},{"name":"诉讼结构","des":"控辩审三方在程序中的位置关系：谁主导事实调查与证据提出，决定一场审判的性格。","symbolSize":40,"category":"程序法与国际法"},{"name":"当事人主义","des":"控辩双方对抗推进、法官居中听证，交叉询问是招牌，英美法庭剧的制度剧本。","symbolSize":40,"category":"程序法与国际法"},{"name":"职权主义","des":"法官主导证据调查与程序推进，大陆法系由纠问传统改良而来的审判构造。","symbolSize":40,"category":"程序法与国际法"},{"name":"陪审制","des":"随机抽选的平民裁断事实，大宪章同侪审判条款的血脉，参与式民主在法庭的延伸。","symbolSize":40,"category":"程序法与国际法"},{"name":"证据规则","des":"何种材料可入法庭、如何采信的规矩：非法证据排除与传闻法则是两大支柱。","symbolSize":40,"category":"程序法与国际法"},{"name":"排除合理怀疑","des":"刑事定罪的最高证明标准，与无罪推定一体两面，宁纵勿枉的制度表达。","symbolSize":40,"category":"程序法与国际法"},{"name":"国际法","des":"调整主权国家相互关系的法：无世界政府而法行其上，靠同意与对等维系。","symbolSize":50,"category":"程序法与国际法"},{"name":"主权","des":"博丹1576年界定的国家绝对永续权力，对内最高对外独立，国际法体系的基本单位。","symbolSize":40,"category":"程序法与国际法"},{"name":"威斯特伐利亚体系","des":"1648年和约终结三十年战争，承认主权国家平等共存，近代国际秩序的奠基礼。","symbolSize":40,"category":"程序法与国际法"},{"name":"条约","des":"国家间书面协议，国际法首要渊源，pacta sunt servanda（约定必须信守）为其效力支柱。","symbolSize":40,"category":"程序法与国际法"},{"name":"国际法院","des":"1945年设于海牙和平宫的联合国主要司法机关，以诉讼与咨询意见两种方式运作。","symbolSize":40,"category":"程序法与国际法"},{"name":"日内瓦公约","des":"1949年四公约及附加议定书：限制作战手段，保护伤病员、战俘与平民的国际人道法核心。","symbolSize":40,"category":"程序法与国际法"},{"name":"纽伦堡审判","des":"1945至1946年审判纳粹首要战犯，确立个人可为反和平罪与反人类罪担责的先例。","symbolSize":40,"category":"程序法与国际法"}],"links":[{"source":"汉谟拉比法典","target":"法学","name":"先声","des":"最早的大型成文法，把正义刻上石柱昭告天下。"},{"source":"乌尔比安","target":"罗马法","name":"集成","des":"五大法学家的答复构成学说汇纂的半壁。"},{"source":"乌尔比安","target":"法学","name":"界分","des":"公法私法之分为法学立起第一张地图。"},{"source":"十二表法","target":"罗马法","name":"开端","des":"罗马人首次把法写上铜表公之于众。"},{"source":"国法大全","target":"罗马法","name":"定型","des":"查士丁尼汇编使千年学理汇成一部。"},{"source":"国法大全","target":"潘德克顿体系","name":"转化","des":"学说汇纂的学理经德国法学之手体系化。"},{"source":"罗马法","target":"大陆法系","name":"滋养","des":"千年私法体系成为大陆法系的共同底本。"},{"source":"大陆法系","target":"法学","name":"谱系","des":"成文法典传统的主脉。"},{"source":"普通法系","target":"法学","name":"谱系","des":"判例与程序传统的主脉。"},{"source":"遵循先例","target":"普通法系","name":"内核","des":"同类案件同等待遇，法官造法不失可预期。"},{"source":"衡平法","target":"普通法系","name":"补足","des":"以良心救济普通法之僵硬，终两轨合一。"},{"source":"伊斯兰法系","target":"法学","name":"谱系","des":"宗教法传统的独立一支。"},{"source":"唐律疏议","target":"中华法系","name":"立极","des":"一准乎礼的巅峰之作，东亚立法的蓝本。"},{"source":"唐律疏议","target":"刑法","name":"形态","des":"诸法合体而以刑为主，科条简要。"},{"source":"中华法系","target":"法学","name":"谱系","des":"礼法合一的东亚传统。"},{"source":"清末修律","target":"中华法系","name":"解体","des":"改采大陆法系体例，旧法统就此转身。"},{"source":"沈家本","target":"清末修律","name":"主持","des":"译介西法、删旧立新，会通中西。"},{"source":"清末修律","target":"大陆法系","name":"移植","des":"以德日为蓝本重构六法体系。"},{"source":"戴雪","target":"普通法系","name":"诠释","des":"英宪植根于普通法土壤的法治经验。"},{"source":"阿奎那","target":"自然法","name":"集成","des":"把自然法嵌入永恒法与人法的层级。"},{"source":"格劳秀斯","target":"自然法","name":"世俗化","des":"纵无上帝自然法依然有效的著名断言。"},{"source":"格劳秀斯","target":"国际