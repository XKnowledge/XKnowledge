{
  "version": 2,
  "nodes": [
    { "name": "法学", "des": "以法为对象的学问，从规范条文追问到正义根基，两千年来往返于书斋与法庭之间。", "symbolSize": 70, "category": "法理学基石" },
    { "name": "法律", "des": "由国家强制保障的行为规范体系，秩序的骨架，也是正义与权力反复争夺的领地。", "symbolSize": 55, "category": "法理学基石" },
    { "name": "权利", "des": "法律承认并保护的利益与自由，近代法学的中心概念，义务与责任皆以它为镜像。", "symbolSize": 50, "category": "法理学基石" },
    { "name": "义务", "des": "法律课以的作为或不作为负担，与权利相生相伴，无义务则权利无所附丽。", "symbolSize": 40, "category": "法理学基石" },
    { "name": "法律责任", "des": "违反义务所触发的强制后果，赔偿、惩罚与恢复的三副面孔，法之严肃所在。", "symbolSize": 40, "category": "法理学基石" },
    { "name": "法律关系", "des": "主体之间依规范结成的权利义务纽带，把生活事实翻译为法律世界的语汇。", "symbolSize": 40, "category": "法理学基石" },
    { "name": "法的渊源", "des": "规范效力的来处：制定法、判例、习惯与法理，法官找法时按图索骥的藏宝图。", "symbolSize": 40, "category": "法理学基石" },
    { "name": "正义", "des": "各得其应得的古老训诫，法学的永恒问号，一切法哲学论战背后隐身的裁判席。", "symbolSize": 55, "category": "法理学基石" },
    { "name": "法治", "des": "规则之治而非人意之治，与“法制”一字之差，隔开工具理性与价值理想。", "symbolSize": 55, "category": "法理学基石" },
    { "name": "法律解释", "des": "条文与案情之间的摆渡人，文义、体系与目的诸方法在此轮番登场。", "symbolSize": 40, "category": "法理学基石" },
    { "name": "法律推理", "des": "从大前提到小前提推出结论的技艺，演绎、类比与权衡轮番上阵的裁判功课。", "symbolSize": 40, "category": "法理学基石" },
    { "name": "立法", "des": "把社会共识铸成规范的国家活动，法的生命起点，也是各方利益博弈的战场。", "symbolSize": 40, "category": "法理学基石" },
    { "name": "法律行为", "des": "以意思表示为要素的自主设权行为，民法大厦的原子单元，法律关系的发动机。", "symbolSize": 40, "category": "法理学基石" },
    { "name": "自然法", "des": "高悬于人定法之上的理性法则，权利与正义的永恒上诉法院，两千年不灭的火种。", "symbolSize": 60, "category": "自然法与法哲学" },
    { "name": "实证主义法学", "des": "只问法是什么、不问法应当如何，以主权者意志与逻辑体系立学，与自然法对峙。", "symbolSize": 50, "category": "自然法与法哲学" },
    { "name": "社会契约论", "des": "国家源于相约而非神授，从格劳秀斯到康德的接力，现代政治合法性的总图纸。", "symbolSize": 50, "category": "自然法与法哲学" },
    { "name": "霍布斯", "des": "《利维坦》作者，自然状态下人对人是狼，绝对主权是走出丛林状态的代价。", "symbolSize": 40, "category": "自然法与法哲学" },
    { "name": "洛克", "des": "政府源于保护生命自由财产的委托，背约即丧失合法性，分权学说的先声。", "symbolSize": 40, "category": "自然法与法哲学" },
    { "name": "卢梭", "des": "人生而自由却无往不在枷锁之中，公意学说点燃主权在民，也埋下多数暴政之忧。", "symbolSize": 40, "category": "自然法与法哲学" },
    { "name": "亚里士多德", "des": "法治优于一人之治的最早论证者，衡平观念的源头，西方法律思想的希腊起点。", "symbolSize": 40, "category": "自然法与法哲学" },
    { "name": "孟德斯鸠", "des": "《论法的精神》作者，自由寄身于权力分立，其学说随启蒙浪潮震动了整个欧洲。", "symbolSize": 50, "category": "自然法与法哲学" },
    { "name": "边沁", "des": "以最大多数人的最大幸福重估一切法律，法典化运动的旗手，功利主义法学开创者。", "symbolSize": 50, "category": "自然法与法哲学" },
    { "name": "功利主义", "des": "苦乐计算作为立法的标尺，制度须以总福利后果论成败，法律改革的伦理引擎。", "symbolSize": 40, "category": "自然法与法哲学" },
    { "name": "奥斯丁", "des": "法律命令说的奠基者，法是主权者以制裁为后盾的命令，实证主义的第一块界碑。", "symbolSize": 50, "category": "自然法与法哲学" },
    { "name": "法律命令说", "des": "法即主权者的命令，违者受制裁，简洁有力，却在习惯法与授权立法前节节败退。", "symbolSize": 40, "category": "自然法与法哲学" },
    { "name": "哈特", "des": "《法律的概念》作者，以承认规则取代命令模型，初级与次级规则的体系设计者。", "symbolSize": 55, "category": "自然法与法哲学" },
    { "name": "富勒", "des": "法律内在道德八项要求的提出者，程序自然法的旗手，因恶法之争留名青史。", "symbolSize": 50, "category": "自然法与法哲学" },
    { "name": "德沃金", "des": "认真对待权利的法哲学家，法律不止规则更有原则，权利是抗衡政策的王牌。", "symbolSize": 40, "category": "自然法与法哲学" },
    { "name": "罗马法", "des": "以《十二铜表法》开篇的千年伟业，私法体系的基因库，后世一切法典的远祖。", "symbolSize": 60, "category": "两大法系源流" },
    { "name": "大陆法系", "des": "承罗马法余绪、以成文法典为骨的家族，从巴黎到东京，演绎推理的规范世界。", "symbolSize": 55, "category": "两大法系源流" },
    { "name": "英美法系", "des": "从英格兰法庭里生长出来的判例家族，法官造法，程序优先，经验压倒逻辑。", "symbolSize": 55, "category": "两大法系源流" },
    { "name": "民法大全", "des": "查士丁尼时代汇编的学说与敕令总集，千年罗马智慧的封存，也是复兴的火种。", "symbolSize": 50, "category": "两大法系源流" },
    { "name": "法典化", "des": "把散乱规范熔铸成体系严整的成文法典的雄心，理性时代最盛大的立法信仰。", "symbolSize": 50, "category": "两大法系源流" },
    { "name": "拿破仑法典", "des": "一八〇四年《法国民法典》，革命理想与罗马传统的合体，随军旗传遍世界。", "symbolSize": 50, "category": "两大法系源流" },
    { "name": "德国民法典", "des": "一九〇〇年生效的《德国民法典》，潘德克顿学派的巅峰，概念法学的结晶。", "symbolSize": 50, "category": "两大法系源流" },
    { "name": "普通法", "des": "诺曼征服后王室法院累积的判例之网，如珊瑚礁般缓慢生长的法官造法。", "symbolSize": 55, "category": "两大法系源流" },
    { "name": "衡平法", "des": "普通法僵硬处的良心补丁，大法官以衡平救济令状之穷，终成一平行体系。", "symbolSize": 40, "category": "两大法系源流" },
    { "name": "遵循先例", "des": "后来的法官须受先前判决拘束，判例法的脊柱，稳定性与个案正义的平衡术。", "symbolSize": 50, "category": "两大法系源流" },
    { "name": "陪审团", "des": "平民裁事实、法官适用法的分工设计，民众参与司法的古老英格兰遗产。", "symbolSize": 40, "category": "两大法系源流" },
    { "name": "令状制度", "des": "没有令状就没有救济，程序形式先于实体权利，普通法形式主义的胎记。", "symbolSize": 40, "category": "两大法系源流" },
    { "name": "乌尔比安", "des": "罗马五大法学家之一，公法私法之分的提出者，语录占《学说汇纂》三分之一。", "symbolSize": 40, "category": "两大法系源流" },
    { "name": "萨维尼", "des": "历史法学派宗师，法是民族精神的沉静生长，与蒂堡论战并反对仓促法典化。", "symbolSize": 40, "category": "两大法系源流" },
    { "name": "历史法学派", "des": "法如语言随民族生长，罗马法研究由此重焕生机，潘德克顿体系的孵化器。", "symbolSize": 40, "category": "两大法系源流" },
    { "name": "宪法", "des": "规定国家权力组织与公民根本地位的最高法，法律位阶金字塔的塔尖。", "symbolSize": 55, "category": "宪政与公法" },
    { "name": "宪政", "des": "以宪法约束权力的政治形态，权力驯服于规则，是法治在公法领域的完成式。", "symbolSize": 40, "category": "宪政与公法" },
    { "name": "权力分立", "des": "立法、行政与司法分立制衡的设计，防止绝对权力，孟德斯鸠的传世图纸。", "symbolSize": 50, "category": "宪政与公法" },
    { "name": "违宪审查", "des": "审查法律本身是否违宪的机制，宪法的牙齿，让根本法真正长出咬合力。", "symbolSize": 50, "category": "宪政与公法" },
    { "name": "马伯里诉麦迪逊", "des": "一八〇三年马歇尔所判名案，最高法院赢得解释宪法并推翻法律之权的开山之作。", "symbolSize": 50, "category": "宪政与公法" },
    { "name": "基本权利", "des": "宪法所保障的公民根本权利，抵抗多数决定的防线，个人对抗国家的盾牌。", "symbolSize": 40, "category": "宪政与公法" },
    { "name": "人权", "des": "人之为人即应享有的权利，从自然权利到世界宣言，道德诉求的法律化身。", "symbolSize": 40, "category": "宪政与公法" },
    { "name": "平等原则", "des": "相同情形相同对待、不同情形差别对待，法律面前人人平等的规范内核。", "symbolSize": 40, "category": "宪政与公法" },
    { "name": "比例原则", "des": "审查公权手段是否过当的均衡术，禁止以大炮轰麻雀，公法中的帝王条款。", "symbolSize": 40, "category": "宪政与公法" },
    { "name": "依法行政", "des": "行政须有法律授权并依法律而行，法无授权不可为，法治在行政领域的化身。", "symbolSize": 40, "category": "宪政与公法" },
    { "name": "行政诉讼", "des": "民告官的法庭，把行政机关拖入司法审查的轨道，官民对峙的制度化场景。", "symbolSize": 40, "category": "宪政与公法" },
    { "name": "主权在民", "des": "国家一切权力属于人民，公意学说的宪法化表达，现代民主合法性的总纲。", "symbolSize": 40, "category": "宪政与公法" },
    { "name": "民法", "des": "调整平等主体间人身财产关系的私法，从摇篮到坟墓，日常生活的默示背景。", "symbolSize": 55, "category": "民法与私法自治" },
    { "name": "私法自治", "des": "当事人依自己意思塑造法律关系，合同自由为核心，市场经济的法律灵魂。", "symbolSize": 50, "category": "民法与私法自治" },
    { "name": "民事主体", "des": "权利义务的归属者，从自然人到组织的千年扩张史，法律人格的边界之争。", "symbolSize": 40, "category": "民法与私法自治" },
    { "name": "法人", "des": "被法律拟制的人格，公司为其最强劲形态，有限责任重塑了整个商业世界。", "symbolSize": 40, "category": "民法与私法自治" },
    { "name": "物权", "des": "对物直接支配并排除他人干涉的权利，静态财产秩序的骨架，对世权的典型。", "symbolSize": 50, "category": "民法与私法自治" },
    { "name": "所有权", "des": "占有使用收益处分四权能的集大成，私产制度的法律心脏，物权体系原点。", "symbolSize": 40, "category": "民法与私法自治" },
    { "name": "债权", "des": "请求特定人为特定行为的权利，动态财产流转的经纬，与物权相对而成对。", "symbolSize": 50, "category": "民法与私法自治" },
    { "name": "合同", "des": "合意即法，当事人为自己立法，债权头号发生原因，私法自治的主舞台。", "symbolSize": 50, "category": "民法与私法自治" },
    { "name": "侵权责任", "des": "不法侵害他人权益的赔偿之责，行为自由的边界与代价，债权第二引擎。", "symbolSize": 50, "category": "民法与私法自治" },
    { "name": "过错责任", "des": "无过错即无责任，以主观可归责性定责罚，个人主义时代的民法信条。", "symbolSize": 40, "category": "民法与私法自治" },
    { "name": "无过错责任", "des": "危险所在、责任所归，工业事故催生的归责新篇，企业风险的分配正义。", "symbolSize": 40, "category": "民法与私法自治" },
    { "name": "代理", "des": "以他人名义行为而效果归于本人，私法自治的时空延伸，民事生活的触手。", "symbolSize": 40, "category": "民法与私法自治" },
    { "name": "婚姻继承", "des": "身份法与财产法的交汇地带，从家父权到配偶平等，继承回望一生所积。", "symbolSize": 40, "category": "民法与私法自治" },
    { "name": "诚实信用", "des": "行使权利履行义务须持诚信，道德入法的帝王条款，民法的弹性灵魂。", "symbolSize": 50, "category": "民法与私法自治" },
    { "name": "刑法", "des": "规定犯罪与刑罚的国家法律，生杀予夺之权所在的法域，最需缰绳的猛兽。", "symbolSize": 55, "category": "刑法与正当程序" },
    { "name": "罪刑法定", "des": "法无明文规定不为罪、不处罚，公民对抗国家刑罚权的堡垒，现代刑法第一原则。", "symbolSize": 60, "category": "刑法与正当程序" },
    { "name": "罪刑相适应", "des": "重罪重刑、轻罪轻刑，刑罚须与罪责相称，罪刑法定原则的孪生支柱。", "symbolSize": 40, "category": "刑法与正当程序" },
    { "name": "无罪推定", "des": "未经审判证明有罪之前推定其无罪，控方承担证明责任，刑事司法的度量衡。", "symbolSize": 50, "category": "刑法与正当程序" },
    { "name": "贝卡里亚", "des": "《论犯罪与刑罚》的年轻作者，罪刑法定与刑罚人道化的启蒙吹哨人。", "symbolSize": 50, "category": "刑法与正当程序" },
    { "name": "正当防卫", "des": "面对不法侵害的即时反击权，法不向不法让步，个人权利的自力救赎。", "symbolSize": 40, "category": "刑法与正当程序" },
    { "name": "犯罪故意", "des": "明知并希望或放任结果发生的主观心态，归责的第一台阶，罪责的心核。", "symbolSize": 40, "category": "刑法与正当程序" },
    { "name": "犯罪过失", "des": "应注意、能注意而不注意，疏忽与过于自信的罪责，注意义务的法律刻度。", "symbolSize": 40, "category": "刑法与正当程序" },
    { "name": "犯罪未遂", "des": "已着手而未得逞的犯罪形态，主观恶性的半程证明，处罚从宽的理由所在。", "symbolSize": 40, "category": "刑法与正当程序" },
    { "name": "刑事诉讼", "des": "国家追诉犯罪的程序剧场，惩罚犯罪与保障人权的拉锯场，宪法的安全阀。", "symbolSize": 50, "category": "刑法与正当程序" },
    { "name": "民事诉讼", "des": "平等主体对簿公堂解决私权之争，不告不理，辩论主义主导的裁判空间。", "symbolSize": 40, "category": "刑法与正当程序" },
    { "name": "证据", "des": "诉讼的燃料，裁判事实认定的唯一凭据，举证之所在、败诉之所在的竞技场。", "symbolSize": 40, "category": "刑法与正当程序" },
    { "name": "正当程序", "des": "程序本身即是正义，剥夺权利须经正当过程，英美法最响亮的宪政口号。", "symbolSize": 55, "category": "刑法与正当程序" },
    { "name": "米兰达规则", "des": "你有权保持沉默，羁押讯问前的权利告知，正当程序原则最著名的台词。", "symbolSize": 40, "category": "刑法与正当程序" },
    { "name": "司法独立", "des": "法官依法律独立审判，以任期与薪酬保障免受干预，法治的组织基石。", "symbolSize": 50, "category": "刑法与正当程序" },
    { "name": "辩护权", "des": "被告人申辩并获得帮助的权利，对抗指控的盾牌，控辩平等的制度支点。", "symbolSize": 40, "category": "刑法与正当程序" }
  ],
