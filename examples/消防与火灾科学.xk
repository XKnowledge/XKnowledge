{
  "version": 2,
  "title": "消防与火灾科学",
  "description": "从燃烧三角到轰燃回燃、从罗马夜巡队到现代消防体制：灭火剂、装备体系、建筑防火与野火科学——人类与火共处的全部知识。",
  "nodes": [
    { "name": "消防与火灾科学", "des": "学会用火之后五十万年，人类才开始真正理解火：燃烧学解释它，火灾动力学预测它，工程学驯服它，而消防员在所有计算失准的地方冲进去。", "symbolSize": 70, "category": "燃烧学" },
    { "name": "燃烧三角与四面体", "des": "可燃物、氧气与温度构成三角，加上链式反应变成四面体——灭火就是拆掉其中一条边。", "symbolSize": 50, "category": "燃烧学" },
    { "name": "闪点与燃点", "des": "液体表面蒸气够浓即可闪燃的温度门槛，油品危险分级的硬指标。", "symbolSize": 40, "category": "燃烧学" },
    { "name": "阴燃与明燃", "des": "无焰的缓慢氧化与有焰的快速放热，沙发垫里的烟头是前者的惯犯。", "symbolSize": 40, "category": "燃烧学" },
    { "name": "热传递三式", "des": "传导、对流与辐射：火焰烤着隔壁、热气顶着天花板、辐射引燃对面家具。", "symbolSize": 40, "category": "燃烧学" },
    { "name": "燃烧产物与毒气", "des": "火场遇难者多数死于烟气而非烧伤：一氧化碳与氰化氢的现代家装毒雾。", "symbolSize": 40, "category": "燃烧学" },
    { "name": "火灾分类", "des": "A 固体、B 液体、C 气体、D 金属、F 烹饪油脂：分类决定了用什么打。", "symbolSize": 40, "category": "燃烧学" },
    { "name": "火灾动力学", "des": "把火当作可计算的流体与能量过程：从经验扑救走向预测防控的学科转向。", "symbolSize": 50, "category": "火灾动力学" },
    { "name": "火羽流", "des": "火源上方上升的热气柱，卷吸冷空气、顶开烟层，房间火灾的发动机。", "symbolSize": 40, "category": "火灾动力学" },
    { "name": "轰燃", "des": "室内可燃物几乎同时着火的临界时刻：轰燃前是火灾，轰燃后是绝境，逃生与内攻的分水岭。", "symbolSize": 50, "category": "火灾动力学" },
    { "name": "回燃", "des": "缺氧闷烧的房间突然进氧引发的爆炸性复燃，消防员破门最怕的那口气。", "symbolSize": 40, "category": "火灾动力学" },
    { "name": "烟囱效应", "des": "高层竖井里热气上升抽吸冷空气的天然风机，楼梯间变成烟囱只需几分钟。", "symbolSize": 40, "category": "火灾动力学" },
    { "name": "通风控制与燃料控制", "des": "开窗越大烧得越旺还是燃料先耗尽？两种火的决定论，现代消防战术的理论底座。", "symbolSize": 40, "category": "火灾动力学" },
    { "name": "火灾荷载", "des": "单位面积可燃物的潜在放热量：现代客厅的合成材料让轰燃时间从十几分钟缩到三四分钟。", "symbolSize": 40, "category": "火灾动力学" },
    { "name": "火灾旋风", "des": "火场自我组织的旋转气柱，从一人高的火魔到吞噬街区的火风暴前奏。", "symbolSize": 40, "category": "火灾动力学" },
    { "name": "灭火原理", "des": "冷却、窒息、隔离与化学抑制四选一或全上——一切灭火战术的理论菜单。", "symbolSize": 50, "category": "灭火与灭火剂" },
    { "name": "水与水枪", "des": "汽化吸热是最便宜的高效冷却，直流、喷雾与水雾的射流选择是战术语言。", "symbolSize": 40, "category": "灭火与灭火剂" },
    { "name": "泡沫灭火剂", "des": "以泡沫层隔氧的 B 类火克星，从蛋白泡沫到成膜氟蛋白，PFAS 环保问题缠身。", "symbolSize": 40, "category": "灭火与灭火剂" },
    { "name": "干粉灭火剂", "des": "碳酸氢钠或磷酸铵盐粉末中断链式反应，万能又留渣的化学抑制选手。", "symbolSize": 40, "category": "灭火与灭火剂" },
    { "name": "二氧化碳灭火", "des": "窒息加不留残迹的气体灭火，图书档案与机房的心头好，人不可久留。", "symbolSize": 40, "category": "灭火与灭火剂" },
    { "name": "哈龙与替代品", "des": "曾是最优雅的气体灭火剂，因啃臭氧层被蒙特利尔议定书请退，七氟丙烷与 IG541 接班。", "symbolSize": 40, "category": "灭火与灭火剂" },
    { "name": "细水雾", "des": "以微米级水雾吸热隔氧的高效新贵，一滴水化成千滴用的工程学。", "symbolSize": 40, "category": "灭火与灭火剂" },
    { "name": "消防车", "des": "从马车拖泵到泵浦车、云梯车与登高平台的谱系，移动的水力学军火库。", "symbolSize": 50, "category": "消防装备" },
    { "name": "蒸汽消防车", "des": "十九世纪以蒸汽机驱动水泵的马拖时代，马拉蒸汽泵在街头的重金属阵容。", "symbolSize": 40, "category": "消防装备" },
    { "name": "云梯与登高平台", "des": "钢臂举到百米的空中走廊，高层救援与外部进攻的制高点。", "symbolSize": 40, "category": "消防装备" },
    { "name": "空气呼吸器", "des": "正压式 SCBA 让消防员在毒雾里呼吸，面罩后的气瓶余量是生命倒计时。", "symbolSize": 40, "category": "消防装备" },
    { "name": "消防服", "des": "外层芳纶、中层防水透气膜、内层隔热的三明治盔甲，二十公斤的耐受极限。", "symbolSize": 40, "category": "消防装备" },
    { "name": "热成像仪", "des": "透过浓烟找热点与受困者的电子眼，火场搜索的降维装备。", "symbolSize": 40, "category": "消防装备" },
    { "name": "正压通风", "des": "以风机向火场压入新鲜空气引导烟热排出的战术，用得好是神器，用错是助燃机。", "symbolSize": 40, "category": "消防装备" },
    { "name": "消防水源与供水", "des": "消火栓、水池与远程供水管线：大火扑不灭多半是水先断了。", "symbolSize": 40, "category": "消防装备" },
    { "name": "建筑防火", "des": "以设计把火关进笼子：分区、疏散、结构与材料的四重防线。", "symbolSize": 50, "category": "建筑防火" },
    { "name": "耐火极限", "des": "构件在标准火灾曲线下挺住的小时数，防火墙三小时、楼梯间二小时的制度韧性。", "symbolSize": 40, "category": "建筑防火" },
    { "name": "防火分区", "des": "以防火墙与楼板把建筑切块，把一场大火切成一场小火的疆界学。", "symbolSize": 40, "category": "建筑防火" },
    { "name": "防火门与防火卷帘", "des": "平时通行、火时自闭的活动边界，常闭式防火门是被吐槽最多也最救命的设备。", "symbolSize": 40, "category": "建筑防火" },
    { "name": "疏散楼梯与前室", "des": "防烟前室加两部梯的冗余设计，高层建筑的生命通道几何学。", "symbolSize": 40, "category": "建筑防火" },
    { "name": "钢结构防火", "des": "钢材 600 度即失稳，防火涂料与包覆给钢骨穿上隔热衣，世贸倒塌的教训课。", "symbolSize": 40, "category": "建筑防火" },
    { "name": "自动喷淋", "des": "1874 年帕马利首创、格里内尔定型的玻璃球喷头，起火房间内就地镇压的最强发明。", "symbolSize": 50, "category": "建筑防火" },
    { "name": "火灾报警系统", "des": "感烟、感温与手报组成的神经网，早一分钟报警就多十分钟逃生。", "symbolSize": 40, "category": "建筑防火" },
    { "name": "防排烟系统", "des": "挡烟垂壁、排烟口与加压送风，给逃生通道留出无烟时间的呼吸工程。", "symbolSize": 40, "category": "建筑防火" },
    { "name": "性能化防火设计", "des": "从死扣条文到模拟场景：疏散时间与危险时间的赛跑模型，超限建筑的通行证。", "symbolSize": 40, "category": "建筑防火" },
    { "name": "古罗马夜巡队", "des": "公元 6 年奥古斯都组建的 vigiles，七千人的世界首支职业消防队，配水泵配斧头配哨子。", "symbolSize": 40, "category": "消防组织史" },
    { "name": "宋代潜火队", "des": "汴京望火楼、军巡铺与潜火兵：世界最早的城市消防体系之一，望火楼上是全天哨位。", "symbolSize": 40, "category": "消防组织史" },
    { "name": "伦敦大火", "des": "1666 年三天烧掉一万三千栋房的布丁巷之火，烧出了砖石建筑法规与现代保险业。", "symbolSize": 50, "category": "消防组织史" },
    { "name": "火灾保险与保险消防队", "des": "保险公司在门前挂铜牌，只保自家客户的救火队，竞争性消防的怪异百年。", "symbolSize": 40, "category": "消防组织史" },
    { "name": "志愿消防传统", "des": "1736 年富兰克林在费城组建志愿消防队，今天德国与美国的乡镇仍靠义务队撑着。", "symbolSize": 40, "category": "消防组织史" },
    { "name": "现代消防体制", "des": "职业化、准军事化与联勤调度，119 接警席后的城市应急大脑。", "symbolSize": 40, "category": "消防组织史" },
    { "name": "灭火战术", "des": "内攻与防御、通风与破拆、两人一组进出的纪律：火场决策的科学与艺术。", "symbolSize": 40, "category": "消防组织史" },
    { "name": "旧金山大火", "des": "1906 年地震断了水管，三天大火烧掉半个城，炸楼开隔离带的悲壮手笔。", "symbolSize": 40, "category": "世纪之火" },
    { "name": "关东大地震火灾", "des": "1923 年东京，地震撞上午饭炉火，本所广场上数万人被火灾旋风吞噬的世纪惨剧。", "symbolSize": 40, "category": "世纪之火" },
    { "name": "国王十字车站火灾", "des": "1987 年伦敦地铁木扶梯的沟槽效应轰燃，32 人遇难，此后地铁全面禁用木扶梯。", "symbolSize": 40, "category": "世纪之火" },
    { "name": "布拉德福德球场火灾", "des": "1985 年积垢多年的木顶棚一分钟能吞看台，56 人遇难，座椅材料法规从此改写。", "symbolSize": 40, "category": "世纪之火" },
    { "name": "格伦费尔塔火灾", "des": "2017 年伦敦 24 层住宅的可燃包层一夜烧透，72 人遇难，外保温材料与贫民高层的大审判。", "symbolSize": 40, "category": "世纪之火" },
    { "name": "野火科学", "des": "火行为三角、可燃物管理与计划烧除：把火当生态过程而非单纯灾害的新学科。", "symbolSize": 50, "category": "野火与自然" },
    { "name": "火行为三角", "des": "燃料、天气与地形决定火怎么走，预测野火的第一性框架。", "symbolSize": 40, "category": "野火与自然" },
    { "name": "计划烧除", "des": "主动烧掉枯枝减负荷，以小火防大火的原住民智慧回归科学体系。", "symbolSize": 40, "category": "野火与自然" },
    { "name": "空降与地面野战消防", "des": "烟雾跳伞员与热点小组：荒野纵深里的两栖部队。", "symbolSize": 40, "category": "野火与自然" },
    { "name": "城镇交界域", "des": "野地与城市交接的 WUI 地带，房子挨着林子，全球野火损失最贵的一线。", "symbolSize": 40, "category": "野火与自然" },
    { "name": "坎普大火", "des": "2018 年加州天堂镇被山火整体抹除，85 人遇难，输电线路与交界域风险的标志案例。", "symbolSize": 40, "category": "野火与自然" },
    { "name": "火灾调查", "des": "从 V 形烧痕与熔痕反推起火点与起火原因，火场考古学与物证化学的合体。", "symbolSize": 40, "category": "调查与科研" },
    { "name": "纵火侦查", "des": "助燃剂检测、犬只与资金流向调查，火灾调查的刑侦半边天。", "symbolSize": 40, "category": "调查与科研" },
    { "name": "火灾计算机模拟", "des": "NIST 的 FDS 场模型与区域模型：火灾科学的数字风洞，事故复盘与设计的通用工具。", "symbolSize": 40, "category": "调查与科研" },
    { "name": "全尺寸火灾实验", "des": "卡丁顿钢框架整体烧与 UL 家具燃烧实验，真实火焰给出的标定数据。", "symbolSize": 40, "category": "调查与科研" },
    { "name": "消防研究机构", "des": "NIST 与 UL 的火灾研究所在内的公共安全智库，把火场经验翻译成规范条文。", "symbolSize": 40, "category": "调查与科研" }
  ],
