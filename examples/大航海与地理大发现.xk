{
  "version": 2,
  "nodes": [
    { "name": "恩里克王子", "des": "葡萄牙航海王子的四十年布局，以南非下之名持续投资非洲西岸探航。", "symbolSize": 50, "category": "航海家" },
    { "name": "郑和", "des": "七下西洋的三宝太监，两百余艘宝船的统帅，早于西人半世纪巡弋印度洋。", "symbolSize": 50, "category": "航海家" },
    { "name": "巴尔博亚", "des": "1513年翻越巴拿马地峡望见大南海的西班牙人，欧洲人首见太平洋。", "symbolSize": 40, "category": "航海家" },
    { "name": "迪亚士", "des": "1488年首抵风暴角的葡萄牙船长，为印度航路踩下第一块踏脚石。", "symbolSize": 40, "category": "航海家" },
    { "name": "达·伽马", "des": "1498年绕非洲抵卡利卡特的葡萄牙人，欧洲与印度直航的开通者。", "symbolSize": 50, "category": "航海家" },
    { "name": "卡布拉尔", "des": "1500年西偏避风意外撞见巴西的船长，葡萄牙帝国版图的意外之喜。", "symbolSize": 40, "category": "航海家" },
    { "name": "哥伦布", "des": "坚信西行可达日本的热那亚航海家，1492年三帆船改变两个半球的历史。", "symbolSize": 70, "category": "航海家" },
    { "name": "亚美利哥·韦斯普奇", "des": "书信里点破新大陆之为新大陆的佛罗伦萨人，两块大洲以他得名。", "symbolSize": 40, "category": "航海家" },
    { "name": "麦哲伦", "des": "率五舰西行寻香料群岛的葡萄牙人，海峡与太平洋皆以他为名。", "symbolSize": 60, "category": "航海家" },
    { "name": "埃尔卡诺", "des": "船长殒命后续领残队归航的巴斯克人，环球一周的真正完成者。", "symbolSize": 40, "category": "航海家" },
    { "name": "德雷克", "des": "劫掠西班牙珍宝船的海上爵士，第二次环球航行的指挥官。", "symbolSize": 50, "category": "航海家" },
    { "name": "塔斯曼", "des": "1642至1643年环澳洲大陆测绘的荷兰船长，塔斯马尼亚以他为名。", "symbolSize": 40, "category": "航海家" },
    { "name": "库克", "des": "三次太平洋远航的英国船长，测绘、天文与坏血病防治的集大成者。", "symbolSize": 50, "category": "航海家" },
    { "name": "卡伯特", "des": "1497年为英王探得纽芬兰的威尼斯人，西北梦想的先行者。", "symbolSize": 40, "category": "航海家" },
    { "name": "卡蒂埃", "des": "1534年起溯圣劳伦斯河而上的法国船长，加拿大之名由其纪行而来。", "symbolSize": 40, "category": "航海家" },
    { "name": "白令", "des": "为俄皇探北太平洋的丹麦船长，亚美之间的海峡以他为名。", "symbolSize": 40, "category": "航海家" },
    { "name": "哈德逊", "des": "四度寻北的水手，河口湾以他为名，终被叛变船员放逐冰海。", "symbolSize": 40, "category": "航海家" },
    { "name": "太平洋", "des": "麦哲伦命名的平静大洋，占地球面积三分之一，大帆船时代的银路。", "symbolSize": 50, "category": "航线与大洋" },
    { "name": "好望角航线", "des": "绕过非洲南端的东方航路，葡萄牙百年探航的总收获。", "symbolSize": 50, "category": "航线与大洋" },
    { "name": "印度洋航线", "des": "季风与洋流织成的古老航道网，香料与棉布的世界性动脉。", "symbolSize": 50, "category": "航线与大洋" },
    { "name": "香料群岛", "des": "摩鹿加群岛，丁香与肉豆蔻的唯一产地，大航海的最初目的地。", "symbolSize": 40, "category": "航线与大洋" },
    { "name": "环球航行", "des": "1519至1522年的维多利亚号壮举，地球之为球形的最强实证。", "symbolSize": 60, "category": "航线与大洋" },
    { "name": "麦哲伦海峡", "des": "南美大陆尖端蜿蜒五百公里的险峡，帆船时代的鬼门关。", "symbolSize": 40, "category": "航线与大洋" },
    { "name": "合恩角", "des": "1616年命名的南方海角，风暴与巨浪的代名词。", "symbolSize": 40, "category": "航线与大洋" },
    { "name": "咆哮四十度", "des": "南纬四十度上无遮无拦的西风带，帆船回程的高速公路。", "symbolSize": 40, "category": "航线与大洋" },
    { "name": "马尼拉大帆船", "des": "1565至1815年往返阿卡普尔科与马尼拉的商船，白银换丝绸的海上丝路。", "symbolSize": 50, "category": "航线与大洋" },
    { "name": "西北通道", "des": "北美北缘通往太平洋的设想水道，冻海之下的四百年执念。", "symbolSize": 40, "category": "航线与大洋" },
    { "name": "信风与环流", "des": "可预测的风系与洋流，大帆船时代的全球导航说明书。", "symbolSize": 40, "category": "航线与大洋" },
    { "name": "卡拉维尔帆船", "des": "轻快浅吃水的三角帆船，逆风调戗的探航利器。", "symbolSize": 40, "category": "船与技术" },
    { "name": "卡拉克大帆船", "des": "高舷重炮的三桡货舰，东方航线上的浮动城堡。", "symbolSize": 40, "category": "船与技术" },
