    { "name": "火绳枪与火炮", "des": "旧大陆的军事代差，殖民征服与技术威慑的硬通货。", "symbolSize": 40, "category": "船与技术" },
    { "name": "坏血病与柠檬汁", "des": "远航的头号杀手，以柠檬汁与酸橙汁写就的治愈简史。", "symbolSize": 40, "category": "船与技术" },
