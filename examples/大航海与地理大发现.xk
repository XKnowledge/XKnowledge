    { "name": "磁罗经", "des": "自中国经阿拉伯传入欧洲的指南针，配上方位刻度盘的海上命脉。", "symbolSize": 40, "category": "船与技术" },
    { "name": "星盘", "des": "以星辰高度定纬度的黄铜圆盘，航海天文学的入门神器。", "symbolSize": 40, "category": "船与技术" },
