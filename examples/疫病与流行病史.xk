{
  "version": 2,
  "title": "疫病与流行病史",
  "description": "与人类缠斗千年的看不见的对手：雅典的修昔底德、伦敦的水泵把手、日内瓦的根除宣言——每一次大疫都是对社会的压力测试，也逼出公共卫生的一级级台阶。",
  "nodes": [
    { "name": "疫病与流行病史", "des": "与人类厮杀千年的看不见的敌人：每一场大疫，都是一次社会与医学的压力测试。", "symbolSize": 70, "category": "疫病与流行病史" },
    { "name": "古代瘟疫", "des": "有文字记载的最早几次大疫：解释世界的神话退场，观察世界的医学登场。", "symbolSize": 50, "category": "古代瘟疫" },
    { "name": "雅典大瘟疫", "des": "公元前430年瘟疫随围城而至，修昔底德以身历者的冷静写下第一部疫病观察记录。", "symbolSize": 40, "category": "古代瘟疫" },
    { "name": "安东尼瘟疫", "des": "公元165年军团自东方带回的瘟疫，掏空了罗马黄金时代的人口与士气。", "symbolSize": 40, "category": "古代瘟疫" },
    { "name": "查士丁尼瘟疫", "des": "541年鼠疫首次世界级登场，拜占庭复兴梦碎，第一次大流行绵延两百年。", "symbolSize": 40, "category": "古代瘟疫" },
    { "name": "麻风病院", "des": "中世纪的活隔离区：病人摇铃自示，一座病院就是一套社会的排除机制。", "symbolSize": 40, "category": "古代瘟疫" },
    { "name": "汗热病", "des": "都铎英格兰的神秘杀手，来得凶去得快，病因至今成谜。", "symbolSize": 40, "category": "古代瘟疫" },
    { "name": "斑疹伤寒", "des": "虱子传播的战争热：监狱、饥荒与行军营，哪里拥挤哪里死。", "symbolSize": 40, "category": "古代瘟疫" },
    { "name": "黑死病", "des": "1347年起的三年，欧洲每三人死一人：一场改写文明走向的大疫。", "symbolSize": 50, "category": "黑死病" },
    { "name": "鼠疫杆菌", "des": "1894年香港，耶尔森与北里柴三郎在显微镜下揪出真凶。", "symbolSize": 40, "category": "黑死病" },
    { "name": "鼠蚤人链条", "des": "跳蚤被菌栓堵住胃，饥饿驱它疯狂叮咬，疫就这样跳到人身上。", "symbolSize": 40, "category": "黑死病" },
    { "name": "卡法商船", "des": "1347年热那亚商船驶出克里米亚，把瘟疫卸在西西里的港口。", "symbolSize": 40, "category": "黑死病" },
    { "name": "三年死三成", "des": "1347到1351，欧洲约三分之一人口蒸发，尸车铃声响过街巷。", "symbolSize": 40, "category": "黑死病" },
    { "name": "鸟嘴医生", "des": "蜡袍、手套与香料填满的鸟嘴面具，绝望时代发明的防护服。", "symbolSize": 40, "category": "黑死病" },
    { "name": "鞭笞与替罪", "des": "鞭笞派血染苦路，犹太社区惨遭屠戮，恐惧总要寻找出口。", "symbolSize": 40, "category": "黑死病" },
    { "name": "伍连德防疫", "des": "1911年东北肺鼠疫，口罩、隔离与火化三管齐下，近代防疫第一场胜仗。", "symbolSize": 40, "category": "黑死病" },
    { "name": "第三次大流行", "des": "1855年起自云南、1894年爆于香港，鼠疫搭上轮船周游世界。", "symbolSize": 40, "category": "黑死病" },
    { "name": "天花歼灭战", "des": "人类第一次、也是至今唯一一次彻底消灭一种人类疾病。", "symbolSize": 50, "category": "天花歼灭战" },
    { "name": "天花之毒", "des": "三成死亡率与一脸麻子：与人类缠斗三千年的烈性病毒。", "symbolSize": 40, "category": "天花歼灭战" },
    { "name": "人痘接种", "des": "以毒攻毒的东方智慧，吹鼻种痘比牛痘早了数百年。", "symbolSize": 40, "category": "天花歼灭战" },
    { "name": "蒙塔古夫人", "des": "从奥斯曼宫廷带回种痘术，欧洲上层社会从此争相效仿。", "symbolSize": 40, "category": "天花歼灭战" },
    { "name": "琴纳与牛痘", "des": "1796年挤奶女工手臂上的牛痘浆，乡村医生改写了免疫史。", "symbolSize": 40, "category": "天花歼灭战" },
    { "name": "冷链长征", "des": "牛痘苗跨越山海的保存与运送，根除战的隐形后勤线。", "symbolSize": 40, "category": "天花歼灭战" },
    { "name": "叉式针", "des": "双尖叉针一蘸一刺，一分钱成本的根除功臣。", "symbolSize": 40, "category": "天花歼灭战" },
    { "name": "十年根除计划", "des": "1967年世卫强化计划，冷战对手在病毒面前并肩。", "symbolSize": 40, "category": "天花歼灭战" },
    { "name": "最后一例", "des": "1977年索马里的阿里·马奥·马林，自然界最后一例天花。", "symbolSize": 40, "category": "天花歼灭战" },
    { "name": "根除宣布", "des": "1980年5月8日日内瓦，人类首次送别一种疾病。", "symbolSize": 40, "category": "天花歼灭战" },
    { "name": "标本库之争", "des": "亚特兰大与新西伯利亚的冷冻柜，销毁与否至今悬而未决。", "symbolSize": 40, "category": "天花歼灭战" },
    { "name": "霍乱七次大流行", "des": "从恒河三角洲出发的七次全球浪潮，城市供水史的严酷考官。", "symbolSize": 50, "category": "霍乱七次大流行" },
    { "name": "霍乱弧菌", "des": "恒河故土的古老地方病，随朝圣人流与商船走向世界。", "symbolSize": 40, "category": "霍乱七次大流行" },
    { "name": "七次大流行", "des": "1817年起七度席卷全球，前六次古典生物型，第七次换装埃尔托。", "symbolSize": 40, "category": "霍乱七次大流行" },
    { "name": "宽街水泵与霍乱地图", "des": "1854年伦敦，斯诺把疫死标上地图，摘掉的是水泵把手，立起的是流行病学。", "symbolSize": 40, "category": "霍乱七次大流行" },
    { "name": "巴泽尔杰特下水道", "des": "大恶臭与霍乱逼出的千余公里伦敦下水道，现代市政的起点。", "symbolSize": 40, "category": "霍乱七次大流行" },
    { "name": "科赫认菌", "des": "1883年埃及疫区，科赫认出逗号状的霍乱弧菌。", "symbolSize": 40, "category": "霍乱七次大流行" },
    { "name": "汉堡对照实验", "des": "1892年汉堡喝生水、邻城滤水，一场天然对照实验判了水源的罪。", "symbolSize": 40, "category": "霍乱七次大流行" },
    { "name": "口服补液盐", "des": "糖盐水的廉价配方，达卡实验室救回数百万脱水儿童。", "symbolSize": 40, "category": "霍乱七次大流行" },
    { "name": "白色瘟疫结核", "des": "慢性的白色瘟疫：被浪漫化的痨病，直到显微镜揭开真相。", "symbolSize": 50, "category": "白色瘟疫结核" },
    { "name": "白色瘟疫", "des": "苍白的脸颊与消瘦的身形，一度被文艺审美美化的绝症。", "symbolSize": 40, "category": "白色瘟疫结核" },
    { "name": "科赫发现结核菌", "des": "1882年染色法让结核杆菌现形，一夜之间痨病变成细菌感染。", "symbolSize": 40, "category": "白色瘟疫结核" },
    { "name": "疗养院运动", "des": "高山、静卧与营养，一座疗养院就是一整套生活方式。", "symbolSize": 40, "category": "白色瘟疫结核" },
    { "name": "卡介苗", "des": "卡介二氏十三年连续传代减毒，1921年首次种进婴儿手臂。", "symbolSize": 40, "category": "白色瘟疫结核" },
    { "name": "链霉素", "des": "1943年从土壤链霉菌中筛出，第一个对抗结核的抗生素。", "symbolSize": 40, "category": "白色瘟疫结核" },
    { "name": "耐药结核", "des": "疗程半途而废养出超级菌，DOTS督导化疗全程盯人。", "symbolSize": 40, "category": "白色瘟疫结核" },
    { "name": "大流感世纪", "des": "1918年起的一百年：病毒基因重排不断推出新的全球疫情。", "symbolSize": 50, "category": "大流感世纪" },
    { "name": "1918大流感", "des": "三波流行感染全球五亿人，死亡人数超过刚刚打完的世界大战。", "symbolSize": 40, "category": "大流感世纪" },
    { "name": "西班牙流感之名", "des": "中立国西班牙如实报道，却让一场全球疫情背了百年地名。", "symbolSize": 40, "category": "大流感世纪" },
    { "name": "W形死亡曲线", "des": "寻常流感杀老幼，这一株让青壮年死于自己的免疫风暴。", "symbolSize": 40, "category": "大流感世纪" },
    { "name": "冻土追凶", "des": "阿拉斯加永冻土里的遗体，世纪末测序复原凶手的基因组。", "symbolSize": 40, "category": "大流感世纪" },
    { "name": "亚洲流感", "des": "1957年H2N2全球传播，疫苗在疫情中赶制问世。", "symbolSize": 40, "category": "大流感世纪" },
    { "name": "香港流感", "des": "1968年H3N2，温和一击却仍带走百万生命。", "symbolSize": 40, "category": "大流感世纪" },
    { "name": "1976猪流感事件", "des": "美国全民疫苗与罕见的副作用，一次过度反应的公开教训。", "symbolSize": 40, "category": "大流感世纪" },
    { "name": "2009年H1N1", "des": "四十年后的首场流感大流行，病毒是1918那株的远房子孙。", "symbolSize": 40, "category": "大流感世纪" },
    { "name": "禽流感阴影", "des": "H5N1高致死而低传播，悬在禽类与人类头顶的达摩克利斯剑。", "symbolSize": 40, "category": "大流感世纪" },
    { "name": "新发疫病时代", "des": "全球化与生态挤压之下，新病原敲门的速度越来越快。", "symbolSize": 50, "category": "新发疫病时代" },
    { "name": "人畜共患溢出", "des": "七成新发传染病源自动物，森林边界的每一次接触都是抽签。", "symbolSize": 40, "category": "新发疫病时代" },
    { "name": "艾滋病", "des": "1981年首份病例报告，一场重塑公共卫生与社会观念的慢疫。", "symbolSize": 40, "category": "新发疫病时代" },
    { "name": "埃博拉", "des": "1976年扎伊尔河畔现身，丝状病毒凶猛却燃得快。", "symbolSize": 40, "category": "新发疫病时代" },
    { "name": "SARS", "des": "2003年香港一家酒店的电梯，把冠状病毒送上世界头条。", "symbolSize": 40, "category": "新发疫病时代" },
    { "name": "MERS", "des": "2012年沙特骆驼圈里的冠状病毒，中东呼吸综合征。", "symbolSize": 40, "category": "新发疫病时代" },
    { "name": "新冠疫情", "des": "2019年冬自武汉始发，全球化时代的第一场冠状病毒大流行。", "symbolSize": 40, "category": "新发疫病时代" },
    { "name": "X疾病", "des": "为下一个未知病原预留的编号，提醒人类名单还没有写完。", "symbolSize": 40, "category": "新发疫病时代" },
    { "name": "防疫体系演变", "des": "从隔离一船人到了解整个病毒基因组：防疫的千年升级史。", "symbolSize": 50, "category": "防疫体系演变" },
    { "name": "隔离四十天", "des": "威尼斯拉撒罗岛四十天留观，quarantine的词源。", "symbolSize": 40, "category": "防疫体系演变" },
    { "name": "海港检疫", "des": "升起黄旗的检疫锚地，国境线的第一道防线。", "symbolSize": 40, "category": "防疫体系演变" },
    { "name": "巴斯德疫苗谱系", "des": "炭疽与狂犬疫苗相继问世，实验室正式加入防疫阵线。", "symbolSize": 40, "category": "防疫体系演变" },
    { "name": "疫苗技术平台", "des": "灭活、减毒、亚单位、载体到mRNA，越走越快的赛道。", "symbolSize": 40, "category": "防疫体系演变" },
    { "name": "免疫规划EPI", "des": "1974年世卫扩大免疫规划，一针一针缝起群体免疫。", "symbolSize": 40, "category": "防疫体系演变" },
    { "name": "国际卫生条例", "des": "从鼠疫公约到IHR2005，全球警报网的法律骨架。", "symbolSize": 40, "category": "防疫体系演变" },
    { "name": "监测网络", "des": "流感哨点与GISAID基因库，病毒基因组实时共享。", "symbolSize": 40, "category": "防疫体系演变" },
    { "name": "反疫苗暗流", "des": "1998年一篇造假论文点燃疑虑，信任比病毒更难防。", "symbolSize": 40, "category": "防疫体系演变" },
    { "name": "瘟疫重塑世界", "des": "瘟疫从不只杀死人：它改写劳动、城市、帝国与文学。", "symbolSize": 50, "category": "瘟疫重塑世界" },
    { "name": "黑死病与劳工", "des": "人少则贵，农奴制松动，大疫意外推动了欧洲社会转型。", "symbolSize": 40, "category": "瘟疫重塑世界" },
    { "name": "天花与美洲", "des": "旧大陆病毒随帆而至，没有免疫的美洲诸帝国在瘟疫中崩塌。", "symbolSize": 40, "category": "瘟疫重塑世界" },
    { "name": "伤寒与大军", "des": "1812年侵俄，斑疹伤寒比俄军先动手，拿破仑大军溃于疫。", "symbolSize": 40, "category": "瘟疫重塑世界" },
    { "name": "疫病与城市", "des": "霍乱逼出下水道、滤水厂与公园，公共卫生重塑城市。", "symbolSize": 40, "category": "瘟疫重塑世界" },
    { "name": "十日谈", "des": "十个青年避疫乡间讲了一百个故事，文学从至暗中开出的花。", "symbolSize": 40, "category": "瘟疫重塑世界" },
    { "name": "鸟嘴面具节", "des": "威尼斯狂欢节上纸糊的鸟嘴，恐惧的符号变成奇观。", "symbolSize": 40, "category": "瘟疫重塑世界" }
  ],
