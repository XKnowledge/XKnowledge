定价权的转移。","symbolSize":45,"category":"石化产品树"},{"name":"两次石油危机","des":"1973 与 1979：西方经济的休克课。","symbolSize":40,"category":"石化产品树"},{"name":"石油美元体系","des":"布雷顿森林后的循环：油元回流美国。","symbolSize":30,"category":"石化产品树"},{"name":"大陆架钻井","des":"1947 年 Kerr-McGee 首座海上平台。","symbolSize":35,"category":"石油秩序"},{"name":"深水与超深水","des":"三千米的浮式生产：深海油田工程。","symbolSize":35,"category":"石油秩序"},{"name":"深水地平线事故","des":"2010 墨西哥湾漏油：深水的代价。","symbolSize":30,"category":"石油秩序"},{"name":"水平井与压裂","des":"页岩革命的工程技术组合。","symbolSize":40,"category":"石油秩序"},{"name":"页岩革命","des":"美国油气独立的十几年逆袭。","symbolSize":45,"category":"石油秩序"},{"name":"能源转型中的石化","des":"燃料需求见顶与化工需求延续。","symbolSize":30,"category":"石油秩序"}],"links":[{"source":"石油与石化工业","target":"德雷克井","name":"起点","des":"机械钻探定义现代工业。"},{"source":"石油与石化工业","target":"标准石油","name":"秩序","des":"第一代垄断秩序。"},{"source":"石油与石化工业","target":"OPEC","name":"秩序","des":"第二代产油国秩序。"},{"source":"石油与石化工业","target":"乙烯裂解","name":"深化","des":"从燃料到材料。"},{"source":"石油与石化工业","target":"页岩革命","name":"当代","des":"供给版图的再改写。"},{"source":"油苗与早期利用","target":"缅甸与巴库油井","name":"先声","des":"手工采油的产业雏形。"},{"source":"德雷克井","target":"缅甸与巴库油井","name":"替代","des":"机械钻探碾压手工井。"},{"source":"德雷克井","target":"石油城","name":"催生","des":"油潮镇随井喷涌现。"},{"source":"煤油灯时代","target":"德雷克井","name":"需求","des":"照明是第一驱动力。"},{"source":"洛克菲勒","target":"标准石油","name":"缔造","des":"1870 克利夫兰起步。"},{"source":"标准石油","target":"反托拉斯拆分","name":"结局","des":"1911 一分为三十四。"},{"source":"反托拉斯拆分","target":"七姊妹","name":"孵化","des":"拆出的公司构成巨头。"},{"source":"诺贝尔兄弟石油","target":"标准石油","name":"对手","des":"巴库与宾州的较量。"},{"source":"皇家荷兰壳牌","target":"诺贝尔兄弟石油","name":"对手","des":"油轮对铁路的胜利。"},{"source":"煤油灯时代","target":"热裂化","name":"转折","des":"汽车时代重写产品结构。"},{"source":"热裂化","target":"Houdry 催化裂化","name":"升级","des":"催化取代热过程。"},{"source":"Houdry 催化裂化","target":"流化催化裂化","name":"跃迁","des":"流化床解决连续化。"},{"source":"催化重整","target":"流化催化裂化","name":"并列","des":"炼厂两大核心装置。"},{"source":"加氢处理","target":"流化催化裂化","name":"配套","des":"清洁化时代的新标准。"},{"source":"乙烯裂解","target":"流化催化裂化","nam