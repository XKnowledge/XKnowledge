{"version":2,"title":"茶","description":"一片叶子的六次变身：六大茶类、山头风土、工艺链，以及茶叶贸易与战争搅动的世界史。","nodes":[{"name":"茶","des":"南方之嘉木，一叶入水而醒：自茶树植物学、制茶工艺至饮茶文化，六大茶类同出一源的大学问。","symbolSize":70,"category":"茶"},{"name":"茶树与源流","des":"从澜沧江流域的野生乔木到杯中芽叶，云南为茶树起源与分化中心，一部物种驯化史。","symbolSize":50,"category":"茶"},{"name":"绿茶与黄茶","des":"不发酵抢先锁鲜，蒸青炒青的保鲜竞赛。","symbolSize":50,"category":"茶"},{"name":"白茶","des":"微发酵茶：不炒不揉，全凭萎凋与日晒成茶，毫香蜜韵的极简主义。","symbolSize":55,"category":"茶"},{"name":"乌龙茶","des":"半发酵茶：做青摇出绿叶红镶边，兼得绿茶之鲜与红茶之甜，又名青茶。","symbolSize":55,"category":"茶"},{"name":"红茶","des":"全发酵茶：红汤红叶、香甜醇厚，自武夷山沿海路风靡欧洲下午茶的东方树叶。","symbolSize":55,"category":"茶"},{"name":"黑茶与普洱","des":"后发酵的时间之茶：渥堆借微生物之力转化滋味，越陈越香，边销西域的主力。","symbolSize":55,"category":"茶"},{"name":"山头风土","des":"一山一味的风土密码，从正岩坑涧到名山名寨。","symbolSize":50,"category":"茶"},{"name":"工艺链","des":"从青叶到成茶的标准工序，每一步都是风味开关。","symbolSize":50,"category":"茶"},{"name":"冲泡与品鉴","des":"器为茶之父，水为茶之母，工夫茶的完整仪轨。","symbolSize":50,"category":"茶"},{"name":"茶树","des":"山茶科常绿木本，嫩芽叶经工艺成茶，野生古树可逾千年。","symbolSize":40,"category":"茶树与源流"},{"name":"澜沧江流域","des":"云南的江河谷地，世界公认茶树起源与驯化中心。","symbolSize":40,"category":"茶树与源流"},{"name":"古茶树","des":"澜沧江畔的千年乔木，活着的驯化史档案。","symbolSize":40,"category":"茶树与源流"},{"name":"大叶种与中小叶种","des":"两套叶形与内含物基因，普洱与龙井的分野。","symbolSize":40,"category":"茶树与源流"},{"name":"陆羽《茶经》","des":"公元八世纪问世的世界第一部茶学专著，三卷十章，从种到饮的唐代全书。","symbolSize":60,"category":"茶树与源流"},{"name":"罢团改散","des":"洪武年间一纸诏令罢龙团改贡叶茶，碾末之饮让位于散茶瀹泡，今日冲泡之始。","symbolSize":40,"category":"茶树与源流"},{"name":"点茶与抹茶","des":"宋人研膏茶末入盏、沸水环回击拂，雪沫乳花咬盏为上；东渡日本成为茶道源头。","symbolSize":50,"category":"茶树与源流"},{"name":"西湖龙井","des":"杭州狮峰龙井群山的扁形绿茶，色翠香郁味甘形美四绝，豆香兰韵的绿茶门面。","symbolSize":40,"category":"绿茶与黄茶"},{"name":"洞庭碧螺春","des":"太湖洞庭东西山的螺形嫩绿茶，茶果间作养出满身花果香，一嫩三鲜的吓煞人香。","symbolSize":40,"category":"绿茶与黄茶"},{"name":"黄山毛峰","des":"黄山高峰云雾间的白毫芽茶，形似雀舌、鱼叶金黄，名山与名茶相得益彰。","symbolSize":40,"category":"绿茶与黄茶"},{"name":"信阳毛尖","des":"北纬三十二度的名优绿茶，细圆紧直的板栗香。","symbolSize":40,"category":"绿茶与黄茶"},{"name":"六安瓜片","des":"皖西大别山片茶，唯一无芽无梗、单取叶片制成，拉老火火功的极致。","symbolSize":40,"category":"绿茶与黄茶"},{"name":"太平猴魁","des":"两叶抱一芽的柿大茶种，尖茶魁首。","symbolSize":40,"category":"绿茶与黄茶"},{"name":"恩施玉露","des":"唐代蒸青的活化石，日本煎茶的亲戚。","symbolSize":40,"category":"绿茶与黄茶"},{"name":"安吉白茶","des":"名为白茶实为绿茶，白化新品种春芽玉白，高氨低酚，鲜爽近于鸡汤。","symbolSize":40,"category":"绿茶与黄茶"},{"name":"君山银针","des":"洞庭湖君山岛的黄茶芽尖，金镶玉、三起三落，闷黄后的甜香。","symbolSize":40,"category":"绿茶与黄茶"},{"name":"蒙顶黄芽","des":"蒙顶山千年贡茶园，闷黄工艺的川派黄茶。","symbolSize":40,"category":"绿茶与黄茶"},{"name":"白毫银针","des":"福鼎太姥山单芽制成，满披白毫如银似雪，汤色杏黄，白茶中的塔尖。","symbolSize":40,"category":"白茶"},{"name":"白牡丹","des":"一芽一二叶，灰绿夹银白，花香最盛的白茶。","symbolSize":40,"category":"白茶"},{"name":"寿眉与贡眉","des":"大叶粗枝的口粮白茶，陈年后煮出枣香。","symbolSize":40,"category":"白茶"},{"name":"三年药七年宝","des":"白茶收藏俗谚，缓慢氧化换来的药香陈香。","symbolSize":40,"category":"白茶"},{"name":"福鼎与政和","des":"两大白茶产区，日光萎凋与室内阴干的南北两派。","symbolSize":40,"category":"白茶"},{"name":"武夷岩茶","des":"武夷山丹霞岩谷间的风土乌龙，岩骨花香，讲究山场与火功的乌龙之王。","symbolSize":50,"category":"乌龙茶"},{"name":"大红袍","des":"自九龙窠崖壁母树繁衍而来的名丛，岩茶之王，焦糖香与岩韵的图腾。","symbolSize":40,"category":"乌龙茶"},{"name":"肉桂与水仙","des":"香不过肉桂，醇不过水仙，岩茶双主干。","symbolSize":40,"category":"乌龙茶"},{"name":"安溪铁观音","des":"闽南乌龙名品，美如观音重如铁，兰花香与观音韵，七泡犹有余香。","symbolSize":40,"category":"乌龙茶"},{"name":"凤凰单丛","des":"潮州凤凰山乌龙，一树一香、单株采制，蜜兰黄栀诸香竞秀的香型博物馆。","symbolSize":40,"category":"乌龙茶"},{"name":"冻顶乌龙","des":"台湾南投的传统球形乌龙，焙火醇和的中庸之美。","symbolSize":40,"category":"乌龙茶"},{"name":"台湾高山茶","des":"千米高山的梨山阿里山，冷冽高山气的青翠乌龙。","symbolSize":40,"category":"乌龙茶"},{"name":"东方美人","des":"小绿叶蝉叮咬后的蜜香传奇，又名膨风茶。","symbolSize":40,"category":"乌龙茶"},{"name":"包种茶","des":"台北文山的轻发酵条形乌龙，最接近绿茶的清香。","symbolSize":40,"category":"乌龙茶"},{"name":"正山小种","des":"武夷桐木关所出的世界红茶鼻祖，松烟香、桂圆汤，四百年老手艺曾风靡英伦。","symbolSize":50,"category":"红茶"},{"name":"祁门红茶","des":"安徽祁门工夫红茶，似花似果似蜜的祁门香，世界三大高香之一。","symbolSize":40,"category":"红茶"},{"name":"滇红","des":"云南大叶种红茶，金毫显露、浓强鲜爽，冬日里自有满盏暖意。","symbolSize":40,"category":"红茶"},{"name":"CTC红碎茶","des":"压碎撕裂卷曲的工业化红茶，茶包与奶茶的原料。","symbolSize":40,"category":"红茶"},{"name":"大吉岭红茶","des":"喜马拉雅山麓庄园茶，麝香葡萄香的「茶中香槟」。","symbolSize":40,"category":"红茶"},{"name":"阿萨姆红茶","des":"布拉马普特拉河谷，麦芽香的浓烈奶茶底。","symbolSize":40,"category":"红茶"},{"name":"锡兰红茶","des":"斯里兰卡高地红茶，明亮涩感的英式拼配主力；叶锈病毁掉咖啡园后茶取而代之，成就锡兰之名。","symbolSize":40,"category":"红茶"},{"name":"云南普洱茶","des":"澜沧江畔的云南大叶种晒青毛茶，生熟分途、越陈越香，一饼好茶足以传世。","symbolSize":50,"category":"黑茶与普洱"},{"name":"生普","des":"蒸压成饼自然陈化，苦涩渐化的时间胶囊。","symbolSize":40,"category":"黑茶与普洱"},{"name":"熟普与渥堆","des":"一九七三年人工渥堆，洒水堆置借微生物与湿热之力速成陈味，红浓陈醇，黑茶之钥。","symbolSize":50,"category":"黑茶与普洱"},{"name":"越陈越香","des":"普洱的价值信条，把仓储写进定价公式。","symbolSize":40,"category":"黑茶与普洱"},{"name":"干仓与湿仓","des":"仓储两派，慢陈化与速醇化的风味赌局。","symbolSize":40,"category":"黑茶与普洱"},{"name":"六堡茶","des":"广西梧州的箩筐陈茶，槟榔香与侨销船运史。","symbolSize":40,"category":"黑茶与普洱"},{"name":"安化黑茶","des":"湖南雪峰山的千两茶与茯砖，资水边的黑茶重镇。","symbolSize":40,"category":"黑茶与普洱"},{"name":"金花菌","des":"茯砖砖心的冠突散囊菌，黄花茂盛的品质标志。","symbolSize":40,"category":"黑茶与普洱"},{"name":"藏茶与边销","des":"川藏茶马古道的酥油茶底，边疆民族的日常。","symbolSize":40,"category":"黑茶与普洱"},{"name":"三坑两涧","des":"慧苑坑牛栏坑大坑口加流香悟源，正岩核心山场。","symbolSize":40,"category":"山头风土"},{"name":"老班章","des":"布朗山系的霸王，苦退甘涌的山头之王。","symbolSize":40,"category":"山头风土"},{"name":"冰岛","des":"勐库西半山的冰糖甜，临沧茶区头牌。","symbolSize":40,"category":"山头风土"},{"name":"易武","des":"香柔水甜的古典茶区，贡茶古道的起点。","symbolSize":40,"category":"山头风土"},{"name":"勐海","des":"茶厂时代的工艺重镇，熟茶发酵的摇篮。","symbolSize":40,"category":"山头风土"},{"name":"景迈山","des":"千年万亩古茶林，二〇二三年入选世界遗产。","symbolSize":40,"category":"山头风土"},{"name":"昔归","des":"澜沧江畔的忙麓山，低海拔的菌香兰韵。","symbolSize":40,"category":"山头风土"},{"name":"采摘标准","des":"自茶树采下鲜叶，单芽、一芽一叶到开面采，标准多在一芽一二叶——原料的第一道定价。","symbolSize":40,"category":"工艺链"},{"name":"萎凋","des":"鲜叶摊晾缓缓失水，青气渐散花香初透，走水与发酵的起点，白茶红茶以此立身。","symbolSize":50,"category":"工艺链"},{"name":"做青","des":"摇青与晾青交替，叶缘碰撞而氧化，摇出香气、晾出韵味，乌龙半发酵的核心机密。","symbolSize":50,"category":"工艺链"},{"name":"杀青","des":"以高温钝化酶活性，一举阻断氧化，青翠定格、存绿止酵，绿茶命门之所系。","symbolSize":50,"category":"工艺链"},{"name":"揉捻","des":"揉搓使叶卷曲成形并破坏细胞，茶汁附着叶表，塑形兼促氧化，滋味由此倾出。","symbolSize":40,"category":"工艺链"},{"name":"发酵","des":"多酚酶促氧化的红变，红茶色香味的生成炉。","symbolSize":40,"category":"工艺链"},{"name":"闷黄","des":"趁热堆闷，湿热中叶内物质缓缓转化，黄汤黄叶，黄茶独有的轻发酵一步。","symbolSize":40,"category":"工艺链"},{"name":"焙火","des":"炭火慢焙提香增醇，文火出清雅、武火出醇厚，岩茶风骨由此炼成。","symbolSize":40,"category":"工艺链"},{"name":"窨制花茶","des":"鲜花与茶坯层层相叠，茶吸花香、花增茶味，一吐一吸间的合香之术，茉莉花茶的七窨功夫。","symbolSize":40,"category":"工艺链"},{"name":"拼配","des":"产区与等级的调和艺术，稳定风味的配方学。","symbolSize":40,"category":"工艺链"},{"name":"盖碗","des":"一盖一碗一托，三才合一：观色闻香啜饮三用兼具，白瓷不夺香的万能茶器。","symbolSize":40,"category":"冲泡与品鉴"},{"name":"紫砂壶","des":"宜兴黄龙山泥料所制双气孔陶壶，透气蓄香、一壶侍一茶，伺茶养壶，壶随人老。","symbolSize":50,"category":"冲泡与品鉴"},{"name":"潮州工夫茶","des":"潮汕闽南的冲泡法度：孟臣壶若琛杯，高冲低斟、关公巡城韩信点兵，把饮茶过成完整仪式。","symbolSize":50,"category":"冲泡与品鉴"},{"name":"公道杯与闻香杯","des":"分汤均一不偏不倚的公道杯，与细高聚香的闻香杯，台式茶席的分汤聚香双件。","symbolSize":40,"category":"冲泡与品鉴"},{"name":"茶水比与出汤","des":"百毫升盖碗投茶五克上下的浓淡分寸，与快一秒则薄、迟一秒则苦的出汤时机。","symbolSize":40,"category":"冲泡与品鉴"},{"name":"水温适配","des":"嫩茶怕烫、老茶嫌温：名优绿茶八十度，乌龙普洱非沸水不醒，八十到一百度全看茶性脸色。","symbolSize":40,"category":"冲泡与品鉴"},{"name":"回甘与生津","des":"苦味化开后喉间徐徐泛甘、舌底鸣泉如潮，先苦后甜，好茶滋味的深层结构。","symbolSize":40,"category":"冲泡与品鉴"},{"name":"岩韵","des":"武夷岩茶的落骨之感，香中有骨、咽后留韵，只可意会的风味印记。","symbolSize":40,"category":"冲泡与品鉴"},{"name":"观音韵","des":"兰香入水喉底留凉，铁观音的身份印记。","symbolSize":40,"category":"冲泡与品鉴"},{"name":"冷后浑","des":"红茶冷却的乳凝现象，内质丰厚的侧写。","symbolSize":40,"category":"冲泡与品鉴"},{"name":"茶氨酸与茶多酚","des":"儿茶素类统称茶多酚，涩感与回甘之源、发酵转化的全部底物；与茶氨酸构成鲜爽与苦涩的天平。","symbolSize":40,"category":"冲泡与品鉴"},{"name":"茶马互市","des":"以茶易马，中原王朝与草原边地千年博弈的杠杆。","symbolSize":50,"category":"茶叶贸易与战争"},{"name":"万里茶道","des":"从武夷山下梅村直抵恰克图的南方茶叶干线，晋商纵贯大陆，与海路一道把茶送进欧洲茶杯。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"恰克图口岸","des":"1727年条约开的中俄商埠，草原上瞬间长出的茶都。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"广州十三行","des":"清朝唯一通商窗口，行商垄断茶叶出口近百年。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"东印度公司茶叶垄断","des":"特许状撑起的贸易帝国，茶叶税最终引爆革命。","symbolSize":50,"category":"茶叶贸易与战争"},{"name":"凯瑟琳王后","des":"葡萄牙公主1662年嫁入英国宫廷，把饮茶变成宫廷时尚。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"下午茶","des":"贝德福德公爵夫人以一盏茶填补午后的漫长空档。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"波士顿倾茶事件","des":"1773年夜色里三百余箱茶倾入海港，独立战争的引信。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"白银与鸦片战争","des":"买茶白银外流的失衡，最终以鸦片与炮舰强行找平。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"武夷茶外销","des":"武夷茶经海路登陆欧洲，烟熏香征服英伦的下午。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"福琼窃茶","des":"罗伯特·福琼乔装深入武夷山，把茶种与制茶师送进印度。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"阿萨姆种植园","des":"1838年土生茶树制成首批伦敦拍品，改写世界茶业版图。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"立顿","des":"格拉斯哥杂货店起家，锡兰茶园直供，让茶变成大众消费品。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"袋泡茶专利","des":"1908年沙利文的丝绸样品袋，一场意外的便利革命。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"千利休","des":"侘茶宗匠，和敬清寂与一期一会由他定型立宗。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"日本茶道","des":"一碗茶里的禅意宇宙，动静之间皆是修行。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"俄国茶炊","des":"铜壶炭火终日不熄，茶炊是俄国家庭房间的中心。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"酥油茶","des":"茶入高原打成酥油茶，热量与礼仪都在一碗之中。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"茶与禁酒运动","des":"英国戒酒会以茶代酒，茶会成为清醒生活的旗帜。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"中国新茶饮","des":"奶茶店门前排起长队，新式茶饮重写年轻人的茶定义。","symbolSize":40,"category":"茶叶贸易与战争"},{"name":"神农尝茶","des":"“神农尝百草，日遇七十二毒，得荼而解之”，传说是茶史的第一行笔墨。","symbolSize":40,"category":"源流与传播"},{"name":"陆羽","des":"复州竟陵人，字鸿渐，弃儒冠而事茶，以一部《茶经》定茶之品格，尊为茶圣。","symbolSize":50,"category":"源流与传播"},{"name":"卢仝","des":"唐代诗人，号玉川子，一曲《七碗茶歌》自喉吻润写到乘风归，后世尊为茶仙。","symbolSize":40,"category":"源流与传播"},{"name":"煎茶法","des":"唐代饮法：炙茶碾罗成末，候汤三沸投末而煎，陆羽为之定制二十四件茶器。","symbolSize":40,"category":"源流与传播"},{"name":"斗茶","des":"宋人较茶之戏：汤色以白为贵，水痕以晚为高，胜负只在毫厘之间。","symbolSize":40,"category":"源流与传播"},{"name":"茶百戏","des":"又称分茶，以茶筅或汤匙使沫饽幻出山水花鸟，是顷刻消散的盏中丹青。","symbolSize":40,"category":"源流与传播"},{"name":"径山茶宴","des":"杭州径山寺以茶宴宾的完整仪轨，随东渡僧传入日本，茶道之源流之一。","symbolSize":40,"category":"源流与传播"},{"name":"荣西","des":"日本僧人，两度入宋求禅，携茶种归国植于背振山，著《吃茶养生记》。","symbolSize":40,"category":"源流与传播"},{"name":"茶马古道","des":"以茶易马的千年商道，自滇川蜿蜒入藏，马帮与背夫把茶驮过横断山脉。","symbolSize":50,"category":"源流与传播"},{"name":"绿茶","des":"不发酵茶：杀青锁住青翠，清汤绿叶，鲜爽为本，中华产量最大的茶类。","symbolSize":55,"category":"六大茶类谱系"},{"name":"黄茶","des":"轻发酵茶：闷黄造就黄汤黄叶，滋味转甘醇，六大茶类中最清瘦的一支。","symbolSize":55,"category":"六大茶类谱系"},{"name":"发酵程度","des":"以茶多酚氧化深浅为刻度的一条隐形轴，六大茶类沿轴排开，各安其位。","symbolSize":60,"category":"六大茶类谱系"},{"name":"陈椽","des":"二十世纪茶学名家，执教于安徽农学院，一九七九年确立六大茶类分类法。","symbolSize":40,"category":"六大茶类谱系"},{"name":"酶促氧化","des":"多酚氧化酶催化儿茶素氧化的过程，发酵一词的化学本体，红汤红叶之母。","symbolSize":40,"category":"六大茶类谱系"},{"name":"绿叶红镶边","des":"做青时叶缘碰撞氧化变红、叶心犹青的印记，乌龙茶叶底上的身份证。","symbolSize":40,"category":"六大茶类谱系"},{"name":"炒青","des":"铁锅翻炒杀青之法，火候直接炒进茶里，香高味醇，明代散茶的技术心脏。","symbolSize":40,"category":"制茶工艺链"},{"name":"干燥","des":"以烘焙蒸发余水、固定品质与香气，茶的样子在最后一炉火上定音。","symbolSize":40,"category":"制茶工艺链"},{"name":"蒸压成型","des":"蒸汽回软茶叶紧压为饼为砖，缩体防潮以便远运，边销茶的古老智慧。","symbolSize":40,"category":"制茶工艺链"},{"name":"茉莉花茶","des":"茶引花香、花增茶味，以福州窨制技艺为正宗，是老北京钟爱的香片。","symbolSize":40,"category":"产区与名茶"},{"name":"审评","des":"以外形、汤色、香气、滋味、叶底五因子评茶论级，把口感折成分数。","symbolSize":50,"category":"品鉴与风味"},{"name":"鲜爽","des":"氨基酸带来的鲜灵口感，如初春鸡汤般的清鲜，春茶与名优绿茶的本色。","symbolSize":40,"category":"品鉴与风味"},{"name":"山场","des":"微观风土之名：坑涧阴阳、岩土厚薄，同一香型因山场而身价迥异。","symbolSize":40,"category":"品鉴与风味"},{"name":"高山云雾","des":"高山漫射光足、昼夜温差大，氨基酸得以累积，云雾出好茶其理在此。","symbolSize":40,"category":"品鉴与风味"},{"name":"明前","des":"清明之前采制的头拨嫩芽，芽叶初萌而量少，明前茶贵如金的时令之约。","symbolSize":40,"category":"品鉴与风味"},{"name":"兰花香","des":"茶香中的清雅上品，幽长如空谷之兰，铁观音与凤凰单丛皆以此争胜。","symbolSize":40,"category":"品鉴与风味"},{"name":"陈化","des":"成茶在岁月中缓慢氧化、滋味重构的过程，仓储由此成为第二重工艺。","symbolSize":50,"category":"品鉴与风味"},{"name":"喉韵","des":"茶汤过喉之后的甘润与回味，深而持久，是掂量茶底厚薄的一把尺。","symbolSize":40,"category":"品鉴与风味"},{"name":"建盏","des":"建阳窑黑釉茶盏，兔毫油滴垂釉流纹，黑釉衬雪白，宋人斗茶至爱。","symbolSize":40,"category":"器具与冲泡"},{"name":"煮茶","des":"茶入壶中直接烹煮，取其浓烈温暖，黑茶老茶尤宜，边地奶茶同其风。","symbolSize":40,"category":"器具与冲泡"},{"name":"择水","des":"水为茶之母：山水上、江水中、井水下，选好水是好茶的一半功课。","symbolSize":40,"category":"器具与冲泡"},{"name":"茶仓","des":"藏茶之所：温度、湿度、避光、隔味四事，仓的好坏写进茶的陈化。","symbolSize":40,"category":"器具与冲泡"}],"links":[{"source":"茶","target":"茶树与源流","name":"本源","des":"一片叶子从澜沧江出发的物种旅程。"},{"source":"茶","target":"绿茶与黄茶","name":"存鲜","des":"高温快锁的鲜，最多人的第一口茶。"},{"source":"茶","target":"白茶","name":"尚简","des":"不炒不揉，最接近叶子本来的样子。"},{"source":"茶","target":"乌龙茶","name":"做青","des":"半发酵的摇摆艺术，香气的最高音。"},{"source":"茶","target":"红茶","name":"全酵","des":"红汤红叶，从武夷山走向世界的下午。"},{"source":"茶","target":"黑茶与普洱","name":"藏陈","des":"后发酵的时间之茶，越存越醇。"},{"source":"茶","target":"工艺链","name":"铸型","des":"六大茶类的分野，全在工序的取舍。"},{"source":"茶","target":"冲泡与品鉴","name":"落杯","des":"器与水与手法，好茶的最后一程。"},{"source":"茶树与源流","target":"茶树","name":"起笔","des":"嫩芽叶是唯一被饮用的部位。"},{"source":"茶树","target":"澜沧江流域","name":"扎根","des":"云贵的江河谷地是它的摇篮。"},{"source":"澜沧江流域","target":"古茶树","name":"留证","des":"千年乔木至今仍在发芽，驯化的活档案。"},{"source":"茶树","target":"大叶种与中小叶种","name":"分型","des":"叶形与内含物两套基因，茶类版图的分界。"},{"source":"大叶种与中小叶种","target":"云南普洱茶","name":"用大","des":"大叶种内质厚，撑得起生熟普洱的骨架。"},{"source":"大叶种与中小叶种","target":"西湖龙井","name":"用小","des":"中小叶种细秀，芽茶香韵的来源。"},{"source":"茶树与源流","target":"陆羽《茶经》","name":"立典","des":"一部唐代全书，让饮茶有了学问。"},{"source":"点茶与抹茶","target":"罢团改散","name":"被替","des":"明初一纸诏令，碾茶击拂让位散茶冲泡。"},{"source":"陆羽《茶经》","target":"潮州工夫茶","name":"遗风","des":"煎茶古礼的形制，在工夫茶席上留了下来。"},{"source":"绿茶与黄茶","target":"西湖龙井","name":"门面","des":"炒锅里的扁形茶，豆香的第一名片。"},{"source":"绿茶与黄茶","target":"洞庭碧螺春","name":"同源","des":"太湖东西山，果茶间养的螺旋细芽。"},{"source":"绿茶与黄茶","target":"黄山毛峰","name":"云雾","des":"高山园的白毫芽，徽州的山场气。"},{"source":"绿茶与黄茶","target":"信阳毛尖","name":"北界","des":"茶区北缘的名优茶，板栗香的北方答卷。"},{"source":"绿茶与黄茶","target":"六安瓜片","name":"单叶","des":"唯一无芽无梗的绿茶，拉老火出高香。"},{"source":"绿茶与黄茶","target":"太平猴魁","name":"尖魁","des":"柿大茶种的大叶尖茶，两叶抱一芽。"},{"source":"绿茶与黄茶","target":"恩施玉露","name":"蒸青","des":"唐代蒸青的活化石，与日本煎茶同源。"},{"source":"恩施玉露","target":"点茶与抹茶","name":"同谱","des":"蒸青一脉，宋茶东渡前的共同祖先。"},{"source":"绿茶与黄茶","target":"安吉白茶","name":"白化","des":"名为白茶实为绿茶，氨基酸的鲜爽冠军。"},{"source":"安吉白茶","target":"白茶","name":"对照","des":"同一个白字，工艺谱系上两个世界。"},{"source":"绿茶与黄茶","target":"君山银针","name":"入黄","des":"黄茶第一名片，闷黄后的甜熟香。"},{"source":"绿茶与黄茶","target":"蒙顶黄芽","name":"古贡","des":"蒙顶山千年贡茶园，闷黄工艺的川派。"},{"source":"君山银针","target":"闷黄","name":"独门","des":"湿热堆闷的一步，黄叶黄汤的来源。"},{"source":"蒙顶黄芽","target":"闷黄","name":"同艺","des":"同一门手艺，在川湘两地各自传灯。"},{"source":"白茶","target":"白毫银针","name":"塔尖","des":"只采肥壮单芽，春天的头一波。"},{"source":"白茶","target":"白牡丹","name":"花香","des":"一芽一二叶，开盏如初绽。"},{"source":"白茶","target":"寿眉与贡眉","name":"口粮","des":"粗枝大叶产量大，煮着喝的老白茶。"},{"source":"白茶","target":"福鼎与政和","name":"两派","des":"一个日晒一个阴干，南北两种白茶性格。"},{"source":"白茶","target":"三年药七年宝","name":"藏陈","des":"俗谚里的陈化路线图，从鲜爽走到药香。"},{"source":"三年药七年宝","target":"寿眉与贡眉","name":"宜陈","des":"粗老叶内含物足，最经得起岁月。"},{"source":"白毫银针","target":"萎凋","name":"全程","des":"白茶没有杀青，萎凋就是它的全部前半生。"},{"source":"乌龙茶","target":"武夷岩茶","name":"岩骨","des":"丹霞山场与焙火合力，风土最重的乌龙。"},{"source":"武夷岩茶","target":"大红袍","name":"图腾","des":"九龙窠母树，半壁江山的传说。"},{"source":"武夷岩茶","target":"肉桂与水仙","name":"双柱","des":"一香一醇，岩茶货架的两根顶梁柱。"},{"source":"乌龙茶","target":"安溪铁观音","name":"闽南","des":"兰花香观音韵，清香型的球形经典。"},{"source":"乌龙茶","target":"凤凰单丛","name":"香谱","des":"蜜兰黄枝芝兰各立门户，单株采制的博物馆。"},{"source":"乌龙茶","target":"冻顶乌龙","name":"传统","des":"中焙火的球形老派，台茶的经典味。"},{"source":"乌龙茶","target":"台湾高山茶","name":"高冷","des":"千米以上的梨山阿里山，冷冽青翠的高山气。"},{"source":"乌龙茶","target":"东方美人","name":"蜜酿","des":"茶小绿叶蝉叮出的蜜香，虫咬做媒的传奇。"},{"source":"乌龙茶","target":"包种茶","name":"清香","des":"发酵最轻的乌龙，条形清扬的台北味。"},{"source":"乌龙茶","target":"做青","name":"机芯","des":"摇晾交替的半发酵，乌龙一切香气的开关。"},{"source":"红茶","target":"正山小种","name":"鼻祖","des":"桐木关四百年松烟，世界红茶的起点。"},{"source":"正山小种","target":"祁门红茶","name":"传艺","des":"制法北传安徽，祁门香另立高峰。"},{"source":"红茶","target":"祁门红茶","name":"高香","des":"似花似果似蜜，伦敦市场的大牌。"},{"source":"红茶","target":"滇红","name":"浓强","des":"大叶种的金毫，浓汤的甜厚底色。"},{"source":"滇红","target":"云南普洱茶","name":"同源","des":"同一片大叶种园，两条工艺路线。"},{"source":"红茶","target":"CTC红碎茶","name":"工业","des":"压碎撕裂卷曲，茶包时代的原料革命。"},{"source":"红茶","target":"大吉岭红茶","name":"庄园","des":"喜马拉雅山麓的庄园制，头摘的青涩花果香。"},{"source":"红茶","target":"阿萨姆红茶","name":"麦芽","des":"河谷平原的浓烈，奶茶的第一块底料。"},{"source":"红茶","target":"锡兰红茶","name":"高地","des":"海拔分带的斯里兰卡，英式早餐茶的主力。"},{"source":"红茶","target":"冷后浑","name":"验质","des":"冷后乳凝，是内质厚实的侧写。"},{"source":"黑茶与普洱","target":"云南普洱茶","name":"主角","des":"大叶种晒青毛茶，生熟两条时间线。"},{"source":"云南普洱茶","target":"生普","name":"原味","des":"蒸压成饼自然陈化，苦涩交给岁月。"},{"source":"云南普洱茶","target":"熟普与渥堆","name":"提速","des":"一九七三年人工渥堆，把三十年缩成几十天。"},{"source":"生普","target":"熟普与渥堆","name":"对照","des":"一个以年为单位，一个以天为单位。"},{"source":"云南普洱茶","target":"越陈越香","name":"信条","des":"存茶的价值叙事，把仓储写进定价公式。"},{"source":"越陈越香","target":"干仓与湿仓","name":"分派","des":"快慢两条陈化路的赌局。"},{"source":"黑茶与普洱","target":"六堡茶","name":"侨销","des":"梧州箩筐茶，下南洋的船舱味。"},{"source":"黑茶与普洱","target":"安化黑茶","name":"千两","des":"花卷千两茶与茯砖，资水边的重镇。"},{"source":"安化黑茶","target":"金花菌","name":"发花","des":"茯砖发花是关卡，金花茂盛才算合格。"},{"source":"黑茶与普洱","target":"藏茶与边销","name":"千年","des":"以茶治边的古道贸易，酥油茶的底料。"},{"source":"藏茶与边销","target":"澜沧江流域","name":"起运","des":"边茶从河谷茶区出发运往高原。"},{"source":"山头风土","target":"三坑两涧","name":"正岩","des":"慧苑牛栏大坑口，岩茶山场的至高地。"},{"source":"三坑两涧","target":"武夷岩茶","name":"定义","des":"岩骨花香四个字，由这三坑两涧写就。"},{"source":"山头风土","target":"老班章","name":"霸气","des":"布朗山茶气最足的名寨，苦退甘涌。"},{"source":"山头风土","target":"冰岛","name":"甜柔","des":"勐库的冰糖甜，与老班章并称双雄。"},{"source":"山头风土","target":"易武","name":"柔香","des":"贡茶古道的起点，香扬水柔。"},{"source":"山头风土","target":"勐海","name":"坊间","des":"茶厂与发酵池重镇，熟茶工艺的摇篮。"},{"source":"勐海","target":"熟普与渥堆","name":"定型","des":"渥堆工艺在此试制定型，勐海味成行业标杆。"},{"source":"山头风土","target":"景迈山","name":"古林","des":"千年万亩古茶林，茶林共生的世界遗产。"},{"source":"山头风土","target":"昔归","name":"低纬","des":"澜沧江边的忙麓山，低海拔的兰韵奇迹。"},{"source":"老班章","target":"生普","name":"原料","des":"名寨古树大多做生普，山头叙事的主角。"},{"source":"工艺链","target":"采摘标准","name":"起点","des":"原料的第一道定价，采工的手上功夫。"},{"source":"工艺链","target":"萎凋","name":"失水","des":"走水与发酵的开场，除绿茶外几乎都有。"},{"source":"萎凋","target":"白茶","name":"主场","des":"白茶不炒不揉，萎凋便是一切。"},{"source":"工艺链","target":"做青","name":"摇香","des":"乌龙的独门工序，绿叶红镶边在此成形。"},{"source":"工艺链","target":"杀青","name":"定性","des":"一锅高温定绿止酵，六大茶类的岔路口。"},{"source":"工艺链","target":"揉捻","name":"塑形","des":"条索与细胞破碎率，滋味溶出的伏笔。"},{"source":"工艺链","target":"发酵","name":"变红","des":"多酚氧化红变，红茶色香的生成炉。"},{"source":"工艺链","target":"闷黄","name":"转甜","des":"黄茶独有一步，湿热微发酵的甜熟。"},{"source":"工艺链","target":"焙火","name":"定香","des":"炭火慢炖的收尾，香气结构的定型。"},{"source":"焙火","target":"武夷岩茶","name":"火功","des":"岩茶的火功层次，从轻火到足火的口味谱。"},{"source":"焙火","target":"冻顶乌龙","name":"中庸","des":"传统冻顶的中焙火，醇和口感的来源。"},{"source":"工艺链","target":"窨制花茶","name":"借香","des":"茶坯吸花吐香，七窨一提的茉莉功夫。"},{"source":"工艺链","target":"拼配","name":"调和","des":"产区等级的配方学，大厂风味的稳定器。"},{"source":"冲泡与品鉴","target":"盖碗","name":"通用","des":"不夺香不闷叶，试茶的第一器。"},{"source":"冲泡与品鉴","target":"紫砂壶","name":"养壶","des":"双气孔呼吸，一壶侍一茶的讲究。"},{"source":"紫砂壶","target":"潮州工夫茶","name":"上席","des":"孟臣壶配若琛杯，工夫茶的标配。"},{"source":"冲泡与品鉴","target":"公道杯与闻香杯","name":"分香","des":"均汤与聚香，台式茶席的双件。"},{"source":"冲泡与品鉴","target":"茶水比与出汤","name":"分寸","des":"克数与秒表，浓淡的量化功夫。"},{"source":"冲泡与品鉴","target":"水温适配","name":"看茶","des":"绿茶八十度，乌龙沸水，各按其性。"},{"source":"冲泡与品鉴","target":"回甘与生津","name":"尺子","des":"苦后回甘舌底鸣泉，好茶的硬指标。"},{"source":"回甘与生津","target":"老班章","name":"例证","des":"班章之霸，就霸在苦尽甘来的力度。"},{"source":"冲泡与品鉴","target":"岩韵","name":"意会","des":"山场落在喉底的骨感，只可意会。"},{"source":"岩韵","target":"三坑两涧","name":"出处","des":"正岩坑涧的茶，韵最沉最厚。"},{"source":"冲泡与品鉴","target":"观音韵","name":"品种","des":"兰香入水喉底留凉，铁观音的身份码。"},{"source":"观音韵","target":"安溪铁观音","name":"署名","des":"有观音韵才配叫正味铁观音。"},{"source":"冲泡与品鉴","target":"茶氨酸与茶多酚","name":"底牌","des":"鲜与涩的天平，滋味的化学账本。"},{"source":"茶氨酸与茶多酚","target":"安吉白茶","name":"偏鲜","des":"白化品种氨基酸高，鲜得像高汤。"},{"source":"茶马互市","target":"万里茶道","name":"演进","des":"从边茶互市到跨国商路，晋商把茶卖到西伯利亚。"},{"source":"万里茶道","target":"恰克图口岸","name":"抵达","des":"1727年条约开埠，恰克图成了草原上的茶都。"},{"source":"万里茶道","target":"武夷茶外销","name":"起运","des":"武夷山的茶在晋商与行商手中分海陆两路流向世界。"},{"source":"广州十三行","target":"东印度公司茶叶垄断","name":"对接","des":"行商与公司大班在广州议价，白银随茶船回流。"},{"source":"凯瑟琳王后","target":"东印度公司茶叶垄断","name":"带火","des":"宫廷示范在先，公司进口在后，饮茶自上而下流行。"},{"source":"凯瑟琳王后","target":"下午茶","name":"先声","des":"王后的午后茶点，两百年后由公爵夫人定型成俗。"},{"source":"下午茶","target":"武夷茶外销","name":"主角","des":"英伦下午的茶杯里，泡着的多是武夷红茶。"},{"source":"东印度公司茶叶垄断","target":"波士顿倾茶事件","name":"激化","des":"公司获准直销美洲，茶税旧怨一夜引爆。"},{"source":"波士顿倾茶事件","target":"武夷茶外销","name":"装箱","des":"倒进海港的茶叶，大半正是来自武夷山的红茶。"},{"source":"武夷茶外销","target":"白银与鸦片战争","name":"失衡","des":"英国买茶付银如流水，贸易的天平日渐倾斜。"},{"source":"白银与鸦片战争","target":"广州十三行","name":"终结","des":"战后五口通商，十三行的垄断烟消云散。"},{"source":"福琼窃茶","target":"阿萨姆种植园","name":"并进","des":"中国茶种与阿萨姆土种，共同撑起英属印度茶业。"},{"source":"阿萨姆种植园","target":"锡兰红茶","name":"南下","des":"锡兰咖啡园毁于叶锈病，阿萨姆的种苗跨海南下。"},{"source":"阿萨姆种植园","target":"大吉岭红茶","name":"同源","des":"同一场在印度种茶的运动，交出的两个高地答案。"},{"source":"大吉岭红茶","target":"立顿","name":"供货","des":"立顿买下茶园直供柜台，把庄园装进杂货铺。"},{"source":"立顿","target":"袋泡茶专利","name":"大众化","des":"从散茶到茶包，一杯快茶占领超市货架。"},{"source":"袋泡茶专利","target":"中国新茶饮","name":"对照","des":"茶包是便利的胜利，新茶饮把茶拉回体验经济。"},{"source":"千利休","target":"日本茶道","name":"定型","des":"侘茶美学由利休推向极致，一期一会自此立宗。"},{"source":"俄国茶炊","target":"万里茶道","name":"消化","des":"晋商运来的砖茶，在铜茶炊里煮成俄国的日常。"},{"source":"酥油茶","target":"茶马互市","name":"起源","des":"边茶入藏打成酥油茶，高原的一日从这里开始。"},{"source":"茶与禁酒运动","target":"下午茶","name":"借力","des":"戒酒会以茶会代酒会，下午茶成了清醒的旗帜。"},{"source":"武夷茶外销","name":"所用即","target":"武夷岩茶","des":"「Bohea」风靡欧洲三百年，茶箱里装的正是武夷岩茶一脉。"},{"source":"波士顿倾茶事件","name":"所倾是","target":"正山小种","des":"1773 年倾入港湾的茶箱，大半是正山小种一脉的武夷红茶。"},{"source":"阿萨姆种植园","name":"育成","target":"阿萨姆红茶","des":"东印度公司在阿萨姆砍林开园，育成浓强鲜爽的英式早餐茶主力。"},{"source":"日本茶道","name":"远承","target":"点茶与抹茶","des":"荣西携宋茶东渡，千利休一脉把宋代点茶法完整封存进茶碗。"},{"source":"茶马互市","name":"大宗是","target":"藏茶与边销","des":"以茶易马千年，输往边疆的大宗正是紧压成砖的藏茶与边销茶。"},{"source":"中国新茶饮","name":"底茶是","target":"窨制花茶","des":"茉莉奶绿、栀子绿妍，新式茶饮的底色仍是窨制花茶的手艺。"},{"source":"茶","name":"掀动","target":"白银与鸦片战争","des":"一叶通商失衡成祸，茶叶税最终撬开近代中国的国门。"},{"source":"茶树与源流","target":"茶","name":"溯源","des":"茶自滇藏交界的原始丛林一路走来，化草木为文明。"},{"source":"神农尝茶","target":"茶","name":"传说","des":"神农得荼解毒的传说，为茶进入人间写下开头。"},{"source":"陆羽","target":"陆羽《茶经》","name":"著述","des":"隐居苕溪著成三卷十章，一人定千秋茶事。"},{"source":"陆羽《茶经》","target":"茶","name":"奠基","des":"世界第一部茶学专著出世，茶自此有学可循。"},{"source":"陆羽","target":"煎茶法","name":"定型","des":"定二十四器、辨三沸之水，唐代煎饮由此成法。"},{"source":"卢仝","target":"茶","name":"咏茶","des":"七碗茶歌把茶饮写到乘风欲仙，诗与茶相互成全。"},{"source":"卢仝","target":"陆羽","name":"嗣响","des":"茶圣立说于前，茶仙咏叹于后，唐代茶事双璧。"},{"source":"煎茶法","target":"点茶与抹茶","name":"演化","des":"唐煎宋点，研末入盏代替投末入锅，风气随世而移。"},{"source":"点茶与抹茶","target":"斗茶","name":"支撑","des":"斗茶以点茶比高下，汤花咬盏是胜负手筋。"},{"source":"茶百戏","target":"点茶与抹茶","name":"衍生","des":"分茶使汤面幻化丹青，点茶技艺的极致余绪。"},{"source":"建盏","target":"斗茶","name":"应运","des":"黑釉衬得雪白汤花，斗茶之风养出建盏名窑。"},{"source":"荣西","target":"点茶与抹茶","name":"承习","des":"入宋习禅，携茶种与点茶法东归日本。"},{"source":"径山茶宴","target":"荣西","name":"启蒙","des":"日僧多于径山求法，茶宴仪轨随禅东渡。"},{"source":"径山茶宴","target":"点茶与抹茶","name":"行茶","des":"茶宴以点茶待客，仪式与茶汤一同输出。"},{"source":"荣西","target":"茶","name":"东传","des":"《吃茶养生记》开日本茶道之先声。"},{"source":"茶马古道","target":"茶","name":"传播","des":"以茶易马千年不绝，茶随马蹄进入雪域高原。"},{"source":"万里茶道","target":"茶","name":"西渐","des":"万里茶道与海上茶船，把东方树叶送进欧洲茶杯。"},{"source":"罢团改散","target":"点茶与抹茶","name":"取代","des":"罢造龙团改贡叶茶，碾末之饮让位于瀹泡。"},{"source":"神农尝茶","target":"陆羽《茶经》","name":"载于","des":"“茶之为饮，发乎神农氏”，开篇即引此传说。"},{"source":"茶马古道","target":"黑茶与普洱","name":"边销","des":"紧压砖茶耐储好运，经古道源源输往藏区。"},{"source":"云南普洱茶","target":"茶马古道","name":"驮运","des":"普洱府因茶而设，贡茶与边销皆自此启程。"},{"source":"茶树与源流","target":"云南普洱茶","name":"同源","des":"澜沧江流域的古茶树，是普洱茶最老的家底。"},{"source":"茶树与源流","target":"滇红","name":"同源","des":"云南大叶种自原生林走来，成就浓强的滇红。"},{"source":"祁门红茶","target":"万里茶道","name":"远销","des":"祁门香一度是欧洲下午茶的宠儿。"},{"source":"正山小种","target":"万里茶道","name":"远销","des":"松烟香的小种经海路风行英伦，调出下午茶。"},{"source":"煮茶","target":"煎茶法","name":"遗风","des":"今日围炉煮茶，犹是唐宋煮饮的余温。"},{"source":"红茶","target":"万里茶道","name":"风行","des":"红汤香甜合欧洲口味，外销自此以红茶为主。"},{"source":"陆羽《茶经》","target":"择水","name":"品第","des":"山水上江水中井下，五之煮定下千年水评。"},{"source":"炒青","target":"罢团改散","name":"支撑","des":"锅炒出香使散茶立得住，改制的技艺前提。"},{"source":"斗茶","target":"审评","name":"先声","des":"宋人较汤色水痕，堪称最早的感官审评。"},{"source":"茶马古道","target":"蒸压成型","name":"驱动","des":"砖饼缩体防潮，正是为长途驮运而生。"},{"source":"茶百戏","target":"斗茶","name":"同场","des":"分茶之技常在斗茶席上一并献演。"},{"source":"绿茶","target":"发酵程度","name":"不发酵","des":"杀青即止氧化，青翠在锅温中定格。"},{"source":"白茶","target":"发酵程度","name":"微发酵","des":"不炒不揉只经萎凋，氧化浅尝辄止。"},{"source":"黄茶","target":"发酵程度","name":"轻发酵","des":"闷黄促成轻转化，滋味向甘醇靠拢。"},{"source":"乌龙茶","target":"发酵程度","name":"半发酵","des":"做青摇晾之间，氧化停在青红交界。"},{"source":"红茶","target":"发酵程度","name":"全发酵","des":"酶促氧化充分进行，红汤红叶定型。"},{"source":"黑茶与普洱","target":"发酵程度","name":"后发酵","des":"渥堆之后仍借微生物缓慢接力转化。"},{"source":"陈椽","target":"茶","name":"分类","des":"以发酵程度为纲，六大茶类分类法一锤定音。"},{"source":"茶氨酸与茶多酚","target":"酶促氧化","name":"底物","des":"儿茶素等待氧化，发酵的戏份全由它担纲。"},{"source":"酶促氧化","target":"发酵程度","name":"机理","des":"发酵一词的化学本体，一切谱系的幕后。"},{"source":"发酵程度","target":"茶","name":"主轴","des":"一条从零到全的隐形轴，串起六大茶类。"},{"source":"做青","target":"绿叶红镶边","name":"造就","des":"叶缘碰撞氧化变红，叶心犹青，印记分明。"},{"source":"绿叶红镶边","target":"乌龙茶","name":"印记","des":"看叶底如验明正身，半发酵的身份证。"},{"source":"杀青","target":"酶促氧化","name":"阻断","des":"高温钝化氧化酶，青翠与鲜爽得以保全。"},{"source":"酶促氧化","target":"红茶","name":"炼成","des":"儿茶素转为茶黄素茶红素，红汤由此而来。"},{"source":"发酵程度","target":"陈化","name":"延伸","des":"发酵止于初制，转化却可在岁月里续写。"},{"source":"采摘标准","target":"萎凋","name":"入制","des":"鲜叶离树，先在摊放中交出水分。"},{"source":"萎凋","target":"做青","name":"铺垫","des":"适度失水叶质变软，摇青方经得起碰撞。"},{"source":"做青","target":"乌龙茶","name":"定型","des":"摇出香气晾出韵味，乌龙风骨由此养成。"},{"source":"杀青","target":"绿茶","name":"定青","des":"一锅高温锁住翠色，绿茶的命门工序。"},{"source":"炒青","target":"杀青","name":"隶属","des":"锅炒是杀青主流之法，火候即风味。"},{"source":"杀青","target":"揉捻","name":"接续","des":"杀青定色之后，揉捻随即塑形出汁。"},{"source":"揉捻","target":"干燥","name":"衔接","des":"成形之后进烘焙，水分退场品质定型。"},{"source":"闷黄","target":"黄茶","name":"专属","des":"一道闷黄，改写了绿茶的色谱与滋味。"},{"source":"闷黄","target":"君山银针","name":"塑造","des":"金镶玉的芽头与三起三落，皆从闷黄来。"},{"source":"熟普与渥堆","target":"黑茶与普洱","name":"点睛","des":"湿热与菌酵同工，速成黑茶的醇厚陈韵。"},{"source":"萎凋","target":"白茶","name":"独任","des":"不炒不揉全凭萎凋，日晒就是全部工艺。"},{"source":"萎凋","target":"红茶","name":"铺陈","des":"充分萎凋为发酵备好底物，甜香自此萌发。"},{"source":"干燥","target":"窨制花茶","name":"备坯","des":"茶坯须干透才吸得进花香，先焙后窨。"},{"source":"焙火","target":"乌龙茶","name":"提香","des":"文火慢炖出熟香，岩骨与音韵借火而成。"},{"source":"窨制花茶","target":"茉莉花茶","name":"产出","des":"三窨一提甚至九窨，花香入骨方成香片。"},{"source":"蒸压成型","target":"云南普洱茶","name":"成饼","des":"蒸软紧压为七子饼，圆茶自此可以远行。"},{"source":"蒸压成型","target":"黑茶与普洱","name":"成砖","des":"茯砖青砖由此而出，金花亦生于砖内。"},{"source":"明前","target":"采摘标准","name":"时令","des":"清明前头拨芽叶，采茶人争的就是这几天。"},{"source":"熟普与渥堆","target":"陈化","name":"速成","des":"渥堆以数十天追出岁月味，是陈化的快进键。"},{"source":"六安瓜片","target":"采摘标准","name":"独法","des":"扳片去芽去梗，单取叶片，采法独树一帜。"},{"source":"正山小种","target":"焙火","name":"熏焙","des":"过红锅后松柴明火熏焙，松烟香由此入骨。"},{"source":"西湖龙井","target":"绿茶","name":"归属","des":"狮峰龙井色翠香郁，扁炒青的巅峰之作。"},{"source":"洞庭碧螺春","target":"绿茶","name":"归属","des":"洞庭东西山螺形嫩茶，花果香源自间作。"},{"source":"黄山毛峰","target":"绿茶","name":"归属","des":"高山云雾所出毛峰，形似雀舌绿泛象牙。"},{"source":"六安瓜片","target":"绿茶","name":"归属","des":"无芽无梗单片成茶，绿茶中的独行侠。"},{"source":"安吉白茶","target":"绿茶","name":"名实","des":"名字带白却是绿茶，白化品种的美丽误会。"},{"source":"白毫银针","target":"白茶","name":"归属","des":"福鼎太姥山单芽白茶，满披白毫如银。"},{"source":"君山银针","target":"黄茶","name":"归属","des":"洞庭君山金镶玉，黄茶芽茶的极致代表。"},{"source":"武夷岩茶","target":"乌龙茶","name":"归属","des":"闽北乌龙重水求韵，岩骨花香的门派。"},{"source":"大红袍","target":"武夷岩茶","name":"归属","des":"九龙窠母树的名丛，岩茶之王的血统。"},{"source":"安溪铁观音","target":"乌龙茶","name":"归属","des":"闽南乌龙代表，兰花香七泡有余。"},{"source":"凤凰单丛","target":"乌龙茶","name":"归属","des":"潮州乌龙一树一香，单株采制的极致。"},{"source":"祁门红茶","target":"红茶","name":"归属","des":"祁门香高鲜甜，世界三大高香红茶。"},{"source":"滇红","target":"红茶","name":"归属","des":"大叶种金毫浓强，滇红以力度见长。"},{"source":"云南普洱茶","target":"黑茶与普洱","name":"归属","des":"熟普经渥堆归入黑茶，生普归属尚有争鸣。"},{"source":"西湖龙井","target":"明前","name":"抢鲜","des":"明前龙井贵如金，一年一等的等待。"},{"source":"武夷岩茶","target":"岩韵","name":"独有","des":"岩骨花香入口方知，岩茶独占的风味词。"},{"source":"武夷岩茶","target":"山场","name":"讲究","des":"三坑两涧各擅其胜，同岩不同场价悬殊。"},{"source":"凤凰单丛","target":"山场","name":"看山","des":"乌岽高山老丛难得，山头即身价的通行证。"},{"source":"安溪铁观音","target":"兰花香","name":"标志","des":"观音韵以兰花香为旗，幽长而清正。"},{"source":"凤凰单丛","target":"兰花香","name":"香型","des":"蜜兰香单丛兰香带蜜，香型谱系之首。"},{"source":"安吉白茶","target":"鲜爽","name":"印证","des":"高氨低酚的品种禀赋，鲜爽度冠绝绿茶。"},{"source":"云南普洱茶","target":"陈化","name":"越陈","des":"生熟皆可陈放，越陈越香的价值主张。"},{"source":"黄山毛峰","target":"高山云雾","name":"产自","des":"黄山峰谷云雾滋养，名山出好茶的注脚。"},{"source":"白茶","target":"陈化","name":"经年","des":"一年茶三年药七年宝，白茶也讲陈放。"},{"source":"云南普洱茶","target":"茶仓","name":"依托","des":"干仓慢养湿仓速成，仓即是第二重工艺。"},{"source":"白毫银针","target":"萎凋","name":"全凭","des":"单芽全凭日光萎凋，毫香蜜韵不事雕琢。"},{"source":"审评","target":"茶","name":"法度","des":"五因子评茶，把口感折成可较的分数。"},{"source":"山场","target":"岩韵","name":"孕育","des":"坑涧风土写进茶汤，方有落骨之韵。"},{"source":"高山云雾","target":"鲜爽","name":"滋养","des":"漫射光促氨基酸累积，高处茶更鲜。"},{"source":"回甘与生津","target":"喉韵","name":"递进","des":"甘意再往深处走，便成喉间的余韵。"},{"source":"茶氨酸与茶多酚","target":"回甘与生津","name":"伏笔","des":"先涩后甘的曲线，是儿茶素埋的伏笔。"},{"source":"茶仓","target":"陈化","name":"承载","des":"温湿光气四事，全由茶仓一手掌管。"},{"source":"绿茶","target":"鲜爽","name":"本色","des":"杀青保住茶氨酸，鲜爽是绿茶的底色。"},{"source":"茶水比与出汤","target":"回甘与生津","name":"左右","des":"迟一秒苦涩压场，回甘生津皆失其所。"},{"source":"公道杯与闻香杯","target":"兰花香","name":"聚香","des":"细杯拢香于鼻端，幽香无所遁形。"},{"source":"紫砂壶","target":"乌龙茶","name":"宜泡","des":"双气孔透气蓄香，乌龙重汤尤宜砂壶。"},{"source":"紫砂壶","target":"潮州工夫茶","name":"器具","des":"小壶聚香蓄韵，功夫茶席上的主角。"},{"source":"盖碗","target":"潮州工夫茶","name":"器具","des":"掀盖闻香刮沫啜饮，一碗走遍六大茶类。"},{"source":"盖碗","target":"审评","name":"标准","des":"白瓷盖碗不偏不倚，审评席的标准器。"},{"source":"公道杯与闻香杯","target":"潮州工夫茶","name":"匀汤","des":"先入公道再分盏，一席茶浓淡如一。"},{"source":"公道杯与闻香杯","target":"潮州工夫茶","name":"闻香","des":"高杯拢香低杯品汤，闽南茶席的搭配。"},{"source":"水温适配","target":"绿茶","name":"宜凉","des":"八十度上下温柔以待，嫩芽经不起滚烫。"},{"source":"水温适配","target":"茶水比与出汤","name":"节拍","des":"温度定快慢，汤色浓淡随之起落。"},{"source":"潮州工夫茶","target":"茶水比与出汤","name":"讲究","des":"高冲低斟快出汤，快慢之间见真章。"},{"source":"潮州工夫茶","target":"乌龙茶","name":"相伴","des":"乌龙香高韵厚，催出这一套小巧功夫。"},{"source":"潮州工夫茶","target":"水温适配","name":"沸水","des":"非沸水不足以发乌龙之香，高冲激香。"},{"source":"煮茶","target":"黑茶与普洱","name":"宜煮","des":"老黑茶烹煮更醇厚，边地奶茶同其源。"},{"source":"罢团改散","target":"紫砂壶","name":"催生","des":"瀹泡散茶兴起，壶与盏随之改朝换代。"},{"source":"罢团改散","target":"潮州工夫茶","name":"源起","des":"散茶瀹泡向下深耕，便是后来的功夫茶。"},{"source":"建盏","target":"点茶与抹茶","name":"绝配","des":"兔毫盏衬雪白汤花，点茶家什以此为上。"},{"source":"水温适配","target":"云南普洱茶","name":"宜沸","des":"熟普老茶非沸水不能尽其味，且经得起煮。"},{"source":"绿茶","name":"属于","target":"绿茶与黄茶","des":"杀青即止氧化的不发酵一支，与黄茶同居绿茶与黄茶类目。"},{"source":"黄茶","name":"属于","target":"绿茶与黄茶","des":"闷黄促成轻转化的黄汤黄叶，与绿茶并立一类。"},{"source":"茶马古道","name":"源头是","target":"茶马互市","des":"以茶易马的市易千年不绝，马帮踩出了横断山间的古道。"},{"source":"陈化","name":"主张即","target":"越陈越香","des":"岁月里的缓慢氧化重构滋味，「越陈越香」正是陈化的价值主张。"},{"source":"茶仓","name":"分为","target":"干仓与湿仓","des":"温湿光气四事的仓储分野，干仓慢养湿仓速成。"},{"source":"山场","name":"细化","target":"山头风土","des":"坑涧阴阳、岩土厚薄——山场是山头风土落到武夷的具体名目。"},{"source":"审评","name":"法度用于","target":"冲泡与品鉴","des":"五因子评茶的法度，正是日常冲泡品鉴的标准化版本。"},{"source":"发酵","name":"本体是","target":"酶促氧化","des":"茶工艺里的「发酵」一词，化学本体是多酚氧化酶催化的氧化。"},{"source":"蒸压成型","name":"为着","target":"藏茶与边销","des":"砖饼缩体防潮耐运，紧压本为边销长途而生的智慧。"},{"source":"煮茶","name":"同源","target":"酥油茶","des":"边地奶茶与围炉煮茶同其风：茶入釜久煮，取其浓烈温暖。"}]}