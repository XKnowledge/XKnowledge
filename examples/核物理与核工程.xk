{"version":2,"nodes":[{"name":"核物理","des":"研究原子核结构、放射性与核力的学科：从发现到工程应用的百年。","symbolSize":65,"category":"核物理发现史"},{"name":"贝克勒尔","des":"1896 年铀盐使底片感光：放射性的偶然发现。","symbolSize":35,"category":"核物理发现史"},{"name":"居里夫妇","des":"钋与镭的分离：放射性研究的双人实验室。","symbolSize":45,"category":"核物理发现史"},{"name":"卢瑟福","des":"α、β、γ 射线分类与核式原子模型：核物理之父。","symbolSize":45,"category":"核物理发现史"},{"name":"人工放射性","des":"1934 年约里奥-居里夫妇以 α 粒子制造新核素。","symbolSize":30,"category":"核物理发现史"},{"name":"查德威克","des":"1932 年发现中子：核科学的关键钥匙。","symbolSize":35,"category":"核物理发现史"},{"name":"费米","des":"中子慢化与首座反应堆：罗马到芝加哥的传奇。","symbolSize":45,"category":"核物理发现史"},{"name":"哈恩与斯特拉斯曼","des":"1938 年化学鉴定出钡：裂变的实验确认。","symbolSize":40,"category":"核物理发现史"},{"name":"迈特纳与弗里施","des":"流亡中的物理解释：核分裂与能量释放。","symbolSize":35,"category":"核物理发现史"},{"name":"核裂变","des":"重核分裂成两块并释放中子与能量：每核子约 2 亿电子伏。","symbolSize":50,"category":"裂变与链式反应"},{"name":"链式反应","des":"中子增殖的自持反应：k≥1 的临界条件。","symbolSize":45,"category":"裂变与链式反应"},{"name":"临界质量","des":"维持链式所需的最少裂变材料：铀 235 约 52 千克。","symbolSize":30,"category":"裂变与链式反应"},{"name":"曼哈顿计划","des":"1942-46 的绝密工程：十三万人与两座城的赌注。","symbolSize":50,"category":"裂变与链式反应"},{"name":"CP-1 反应堆","des":"1942 年 12 月 2 日芝加哥自持链式：人类第一堆。","symbolSize":30,"category":"裂变与链式反应"},{"name":"洛斯阿拉莫斯","des":"沙漠台地上的 Y 基地：奥本海默主持的武器实验室。","symbolSize":30,"category":"裂变与链式反应"},{"name":"广岛与长崎","des":"1945 年 8 月的两枚原子弹：核武器的首次实战。","symbolSize":35,"category":"裂变与链式反应"},{"name":"原子弹","des":"枪式与内爆式两种起爆设计：小男孩与胖子。","symbolSize":40,"category":"核武器时代"},{"name":"氢弹","des":"泰勒-乌拉姆构型的聚变增强武器：百万吨级当量。","symbolSize":40,"category":"核武器时代"},{"name":"核军备竞赛","des":"美苏万枚弹头的对峙：相互确保摧毁的平衡。","symbolSize":35,"category":"核武器时代"},{"name":"核试验","des":"从大气到地下的试验史：内华达与新地岛。","symbolSize":30,"category":"核武器时代"},{"name":"不扩散条约","des":"1968 年 NPT：防扩散与和平利用的双轨契约。","symbolSize":25,"category":"核武器时代"},{"name":"核反应堆","des":"自持链式反应的受控装置：人类第五种能量来源。","symbolSize":55,"category":"反应堆谱系"},{"name":"压水堆","des":"轻水冷却加慢化的主力堆型：全球核电的大半。","symbolSize":35,"category":"反应堆谱系"},{"name":"沸水堆","des":"直接产汽的轻水堆：福岛一号机组所属。","symbolSize":30,"category":"反应堆谱系"},{"name":"石墨堆","des":"石墨慢化气冷与 RBMK：切尔诺贝利的设计谱系。","symbolSize":30,"category":"反应堆谱系"},{"name":"快中子堆","des":"无慢化燃烧增殖：闭式燃料循环的关键。","symbolSize":25,"category":"反应堆谱系"},{"name":"球床堆","des":"包覆颗粒燃料的高温气冷堆：中国石岛湾示范。","symbolSize":25,"category":"反应堆谱系"},{"name":"熔盐堆","des":"液态燃料堆型：钍基与四代堆的候选。","symbolSize":25,"category":"反应堆谱系"},{"name":"核燃料循环","des":"铀矿-浓缩-元件-后处理-处置的全链条。","symbolSize":35,"category":"反应堆谱系"},{"name":"三里岛事故","des":"1979 年美国堆芯熔化：无伤亡但终结核电扩张。","symbolSize":25,"category":"核安全与事故"},{"name":"切尔诺贝利事故","des":"1986 年 RBMK 失控爆炸：核民用的最深创伤。","symbolSize":40,"category":"核安全与事故"},{"name":"福岛事故","des":"2011 年海啸后的全厂断电：三代事故的另一课。","symbolSize":35,"category":"核安全与事故"},{"name":"辐射防护","des":"剂量、屏蔽与 ALARA 原则。","symbolSize":30,"category":"核安全与事故"},{"name":"核安全文化","des":"组织与个人对安全的持续关切：INSAG 提出的核心概念。","symbolSize":25,"category":"核安全与事故"},{"name":"核聚变","des":"轻核聚合释放能量：太阳的机制与终极能源之梦。","symbolSize":50,"category":"聚变工程"},{"name":"托卡马克","des":"苏联发明的环形磁约束：聚变的主流路线。","symbolSize":40,"category":"聚变工程"},{"name":"ITER","des":"三十五国共建的实验堆：目标是 Q=10 的等离子体自持。","symbolSize":35,"category":"聚变工程"},{"name":"惯性约束聚变","des":"NIF 2022 年首次点火：激光压缩的燃料靶丸。","symbolSize":30,"category":"聚变工程"},{"name":"劳森判据","des":"温度、密度与约束时间的乘积门槛：聚变点火的标尺。","symbolSize":25,"category":"聚变工程"},{"name":"核医学","des":"PET 与放疗：同位素的诊疗两面。","symbolSize":30,"category":"核的应用"},{"name":"核动力舰船","des":"从鹦鹉螺号到航母：海上数十年无需换料。","symbolSize":25,"category":"核的应用"},{"name":"同位素应用","des":"测年、探伤与示踪：从考古到工业。","symbolSize":25,"category":"核的应用"}],"links":[{"source":"核物理","target":"核裂变","name":"核心","des":"裂变的发现重塑物理与政治。"},{"source":"核物理","target":"核反应堆","name":"工程","des":"受控裂变的能源利用。"},{"source":"核物理","target":"核聚变","name":"前沿","des":"受控聚变的能源长梦。"},{"source":"核物理","target":"卢瑟福","name":"奠基","des":"核模型与射线分类。"},{"source":"贝克勒尔","target":"居里夫妇","name":"接力","des":"感光现象成为可测科学。"},{"source":"居里夫妇","target":"人工放射性","name":"传承","des":"女儿女婿延续家族发现。"},{"source":"卢瑟福","target":"查德威克","name":"门下","des":"卡文迪许实验室的师承。"},{"source":"查德威克","targe