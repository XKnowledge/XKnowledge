{"version":2,"title":"毒理学","description":"剂量决定毒药：从帕拉塞尔苏斯的箴言到现代解毒剂，一门关于剂量效应与毒物谱系的交叉科学。","nodes":[{"name":"毒理学","des":"研究毒物与生物体有害相互作用的科学，剂量是它的第一律。","symbolSize":70,"category":"学科基石"},{"name":"帕拉塞尔苏斯","des":"十六世纪炼金医士，毒理学之祖。","symbolSize":50,"category":"学科基石"},{"name":"剂量决定论","des":"万物皆毒，剂量使其为毒或为药。","symbolSize":50,"category":"学科基石"},{"name":"奥尔菲拉","des":"西班牙裔法国医师，现代毒理学之父。","symbolSize":40,"category":"学科基石"},{"name":"毒学通论","des":"1815年第一部系统毒理学专著。","symbolSize":40,"category":"学科基石"},{"name":"毒物","des":"以小剂量即致损害的外源物质。","symbolSize":50,"category":"学科基石"},{"name":"毒物谱系","des":"醇醛氰化物、农药鼠药、药物滥用诸门类。","symbolSize":40,"category":"毒物谱系"},{"name":"毒性","des":"物质造成损害的固有能力。","symbolSize":40,"category":"学科基石"},{"name":"外源化学物","des":"人体外来的化学品大军，毒理学的检阅对象。","symbolSize":40,"category":"学科基石"},{"name":"毒代动力学","des":"毒物的吸收分布代谢排泄之旅。","symbolSize":50,"category":"剂量与效应"},{"name":"毒效学","des":"毒物如何抵达靶点并施害。","symbolSize":40,"category":"剂量与效应"},{"name":"吸收","des":"经呼吸道消化道皮肤三关入血。","symbolSize":40,"category":"剂量与效应"},{"name":"生物利用度","des":"入血比例决定实际威力。","symbolSize":40,"category":"剂量与效应"},{"name":"分布","des":"血流与亲和力导引毒物落户器官。","symbolSize":40,"category":"剂量与效应"},{"name":"代谢转化","des":"肝脏两相反应：活化或减毒。","symbolSize":40,"category":"剂量与效应"},{"name":"Ⅰ相反应","des":"氧化还原水解，细胞色素领唱。","symbolSize":40,"category":"剂量与效应"},{"name":"Ⅱ相反应","des":"葡萄糖醛酸化等结合增溶促排。","symbolSize":40,"category":"剂量与效应"},{"name":"生物活化","des":"代谢反而更毒：对硫磷变对氧磷。","symbolSize":40,"category":"剂量与效应"},{"name":"排泄","des":"肾胆汁呼气三出口。","symbolSize":40,"category":"剂量与效应"},{"name":"细胞色素P450","des":"代谢酶超级家族，药物与毒物共用的化工厂。","symbolSize":40,"category":"剂量与效应"},{"name":"酶诱导","des":"久服令酶增产，耐受与相互作用的根源。","symbolSize":40,"category":"剂量与效应"},{"name":"剂量效应曲线","des":"S形曲线上的阈值与斜率。","symbolSize":40,"category":"剂量与效应"},{"name":"LD50","des":"半数致死剂量，急性毒力的标尺。","symbolSize":50,"category":"剂量与效应"},{"name":"NOAEL","des":"未观察到有害作用的剂量，安全评价起点。","symbolSize":40,"category":"剂量与效应"},{"name":"安全系数","des":"动物到人外推的一百倍保险。","symbolSize":40,"category":"剂量与效应"},{"name":"靶器官","des":"毒物偏爱的受害者：肝肾神经。","symbolSize":40,"category":"剂量与效应"},{"name":"蓄积毒性","des":"半衰期长的毒物在体内攒局。","symbolSize":40,"category":"剂量与效应"},{"name":"急性中毒","des":"一次大剂量的闪电战。","symbolSize":40,"category":"中毒类型"},{"name":"慢性中毒","des":"小剂量长期围困，水俣病的剧本。","symbolSize":40,"category":"中毒类型"},{"name":"亚慢性毒性","des":"介于急慢之间的九十天战役。","symbolSize":40,"category":"中毒类型"},{"name":"致突变","des":"损伤DNA的隐患，艾姆斯试验的靶。","symbolSize":40,"category":"中毒类型"},{"name":"致癌性","des":"化学致癌的启动促行进展三幕。","symbolSize":40,"category":"中毒类型"},{"name":"致畸性","des":"沙利度胺留给世纪的教训。","symbolSize":40,"category":"中毒类型"},{"name":"生殖毒性","des":"殃及生育与后代的全谱损害。","symbolSize":40,"category":"中毒类型"},{"name":"免疫毒性","des":"过敏与自免的双重变奏。","symbolSize":40,"category":"中毒类型"},{"name":"神经毒性","des":"铅汞锰对神经系统的定向打击。","symbolSize":40,"category":"中毒类型"},{"name":"腐蚀毒","des":"强酸强碱，烧灼局部。","symbolSize":40,"category":"毒物谱系"},{"name":"金属毒","des":"砷汞铅镉铊，古典与现代的毒星。","symbolSize":50,"category":"毒物谱系"},{"name":"砷","des":"继承之毒，米氏线的标志物。","symbolSize":40,"category":"毒物谱系"},{"name":"汞","des":"水俣市的甲基汞，猎帽人的狂怒。","symbolSize":40,"category":"毒物谱系"},{"name":"铅","des":"罗马管道与汽油时代的神经毒。","symbolSize":40,"category":"毒物谱系"},{"name":"铊","des":"投毒案新宠，一夜脱发的元素。","symbolSize":40,"category":"毒物谱系"},{"name":"镉","des":"痛痛病的骨痛元凶。","symbolSize":40,"category":"毒物谱系"},{"name":"氰化物","des":"线粒体的断路器，苦杏仁之吻。","symbolSize":40,"category":"毒物谱系"},{"name":"一氧化碳","des":"无色无味，与血红蛋白的致命拥抱。","symbolSize":40,"category":"毒物谱系"},{"name":"甲醇","des":"假酒之祸，甲酸毁视神经。","symbolSize":40,"category":"毒物谱系"},{"name":"农药","des":"有机磷氨基甲酸酯百草枯三族。","symbolSize":50,"category":"毒物谱系"},{"name":"有机磷","des":"胆碱酯酶的劫持者，汗泪瞳缩齐发。","symbolSize":40,"category":"毒物谱系"},{"name":"百草枯","des":"除草剂，肺纤维化的单程票。","symbolSize":40,"category":"毒物谱系"},{"name":"灭鼠药","des":"毒鼠强与抗凝剂的暗影。","symbolSize":40,"category":"毒物谱系"},{"name":"药物滥用","des":"阿片兴奋剂镇静剂的三重浪潮。","symbolSize":40,"category":"毒物谱系"},{"name":"阿片类","des":"呼吸抑制的快感陷阱。","symbolSize":40,"category":"毒物谱系"},{"name":"合成毒品","des":"冰毒摇头丸与实验室新精神活性物。","symbolSize":40,"category":"毒物谱系"},{"name":"动植物毒素","des":"蛇毒河豚毒蓖麻毒的自然兵器库。","symbolSize":40,"category":"毒物谱系"},{"name":"蛇毒","des":"神经毒与血循毒两大家族。","symbolSize":40,"category":"毒物谱系"},{"name":"河豚毒素","des":"阻钠通道，无解毒期的极致鲜味。","symbolSize":40,"category":"毒物谱系"},{"name":"蓖麻毒素","des":"蛋白质合成抑制剂，信件的暗器。","symbolSize":40,"category":"毒物谱系"},{"name":"肉毒毒素","des":"天然毒物之最，美容亦医学。","symbolSize":40,"category":"毒物谱系"},{"name":"霉菌毒素","des":"黄曲霉毒素与肝的慢性对话。","symbolSize":40,"category":"毒物谱系"},{"name":"解毒剂","des":"与毒物赛跑的特效药们。","symbolSize":50,"category":"解毒与救治"},{"name":"螯合疗法","des":"二巯基丙醇抓取金属离子的钳。","symbolSize":40,"category":"解毒与救治"},{"name":"依地酸钙钠","des":"铅中毒的排铅主力。","symbolSize":40,"category":"解毒与救治"},{"name":"普鲁士蓝","des":"铊的肠道陷阱。","symbolSize":40,"category":"解毒与救治"},{"name":"亚甲蓝","des":"高铁血红蛋白血症的还原剂。","symbolSize":40,"category":"解毒与救治"},{"name":"羟钴胺","des":"氰化物的清道夫，结合为维生素B12。","symbolSize":40,"category":"解毒与救治"},{"name":"纳洛酮","des":"阿片过量的秒级逆转剂。","symbolSize":40,"category":"解毒与救治"},{"name":"阿托品","des":"有机磷中毒的对抗剂。","symbolSize":40,"category":"解毒与救治"},{"name":"解磷定","des":"复活被抑制的胆碱酯酶。","symbolSize":40,"category":"解毒与救治"},{"name":"抗蛇毒血清","des":"马血清中的抗体军团。","symbolSize":40,"category":"解毒与救治"},{"name":"活性炭","des":"吸附万物的古老洗胃接班人。","symbolSize":40,"category":"解毒与救治"},{"name":"血液净化","des":"透析灌流置换的体外排毒。","symbolSize":40,"category":"解毒与救治"},{"name":"毒物分析","des":"色谱质谱追踪体液中的痕量凶手。","symbolSize":50,"category":"分析与评价"},{"name":"气相色谱质谱联用","des":"挥发毒物的指纹仪。","symbolSize":40,"category":"分析与评价"},{"name":"液相色谱质谱联用","des":"热不稳定毒物的主力机型。","symbolSize":40,"category":"分析与评价"},{"name":"免疫筛查","des":"快筛试纸的初步圈定。","symbolSize":40,"category":"分析与评价"},{"name":"中毒急救","des":"稳定生命体征优先于寻毒。","symbolSize":40,"category":"分析与评价"},{"name":"临床毒理学","des":"中毒诊治的床旁学科。","symbolSize":40,"category":"分析与评价"},{"name":"法医毒理学","des":"死后检材为法庭作证。","symbolSize":40,"category":"分析与评价"},{"name":"环境毒理学","des":"污染物与生态的健康账本。","symbolSize":40,"category":"分析与评价"},{"name":"食品毒理学","des":"从农田到餐桌的风险审计。","symbolSize":40,"category":"分析与评价"},{"name":"风险评估","des":"危害鉴定剂量反应暴露评估与表征四步。","symbolSize":50,"category":"分析与评价"},{"name":"ADTI","des":"每日允许摄入量，一生的安全线。","symbolSize":40,"category":"分析与评价"},{"name":"三段生殖试验","des":"生殖发育毒性的标准套餐。","symbolSize":40,"category":"分析与评价"},{"name":"动物实验替代","des":"三维培养与器官芯片的新浪潮。","symbolSize":40,"category":"分析与评价"},{"name":"水俣病","des":"甲基汞污染的世纪公害。","symbolSize":40,"category":"公害事件"},{"name":"痛痛病","des":"镉污染稻田的骨之悲歌。","symbolSize":40,"category":"公害事件"},{"name":"四日市哮喘","des":"硫氧化物烟雾的肺之殇。","symbolSize":40,"category":"公害事件"},{"name":"切尔诺贝利","des":"放射性落下灰的长期毒理样本。","symbolSize":40,"category":"公害事件"},{"name":"沙利度胺事件","des":"1950年代止吐药致万例海豹肢。","symbolSize":40,"category":"公害事件"},{"name":"二噁英","des":"塞维索与橙剂中的世纪之毒。","symbolSize":40,"category":"公害事件"},{"name":"毒物癖好史","des":"从米特拉达梯万能解毒方到宫廷试毒者。","symbolSize":40,"category":"公害事件"}],"links":[{"source":"毒理学","target":"帕拉塞尔苏斯","name":"尊祖","des":"剂量名句出自其口。"},{"source":"帕拉塞尔苏斯","target":"剂量决定论","name":"立言","des":"万物皆毒，唯剂量分药毒。"},{"source":"剂量决定论","target":"毒物","name":"定义","des":"小剂量致害是毒物的身份。"},{"source":"毒物","target":"毒性","name":"属性","des":"损害能力的强弱之分。"},{"source":"奥尔菲拉","target":"毒学通论","name":"著成","des":"1815年系统化毒物分类。"},{"source":"毒学通论","target":"毒理学","name":"奠基","des":"化学检验进入毒案。"},{"source":"奥尔菲拉","target":"法医毒理学","name":"开路","des":"法庭上的砷检测先驱。"},{"source":"外源化学物","target":"毒物","name":"来源","des":"药物农药环境物皆在其中。"},{"source":"毒代动力学","target":"毒理学","name":"半壁","des":"毒物在体内的来龙去脉。"},{"source":"毒效学","target":"毒理学","name":"另半","des":"抵达靶点后的为非作歹。"},{"source":"吸收","target":"毒代动力学","name":"第一步","des":"呼吸道消化道皮肤三途径。"},{"source":"生物利用度","target":"吸收","name":"量化","des":"入血分数。"},{"source":"分布","target":"靶器官","name":"导向","des":"血流量与亲和决定落户。"},{"source":"代谢转化","target":"毒代动力学","name":"转枢","des":"肝为化工厂。"},{"source":"Ⅰ相反应","target":"代谢转化","name":"首相","des":"氧化还原水解。"},{"source":"Ⅱ相反应","target":"代谢转化","name":"次相","des":"结合增溶。"},{"source":"细胞色素P450","target":"Ⅰ相反应","name":"主唱","des":"三百余酶的超级家族。"},{"source":"酶诱导","target":"细胞色素P450","name":"调节","des":"底物诱导酶量增产。"},{"source":"生物活化","target":"代谢转化","name":"反转","des":"代谢产物更毒的陷阱。"},{"source":"排泄","target":"毒代动力学","name":"出口","des":"肾胆汁呼气。"},{"source":"剂量效应曲线","target":"剂量决定论","name":"图形化","des":"S形曲线具象化名言。"},{"source":"LD50","target":"剂量效应曲线","name":"锚点","des":"曲线上最著名的刻度。"},{"source":"NOAEL","target":"剂量效应曲线","name":"下限","des":"未见有害剂量。"},{"source":"安全系数","target":"NOAEL","name":"外推","des":"动物到人的百倍折算。"},{"source":"蓄积毒性","target":"慢性中毒","name":"机制","des":"入大于出则攒毒。"},{"source":"急性中毒","target":"毒理学","name":"类型","des":"一次大剂量的急症。"},{"source":"慢性中毒","target":"毒理学","name":"类型","des":"低剂量长暴露。"},{"source":"亚慢性毒性","target":"慢性中毒","name":"过渡","des":"九十天重复染毒。"},{"source":"致突变","target":"致癌性","name":"前奏","des":"DNA损伤启动癌变。"},{"source":"致畸性","target":"生殖毒性","name":"归属","des":"发育毒性的突出部。"},{"source":"免疫毒性","target":"毒理学","name":"分支","des":"超敏与免疫抑制。"},{"source":"神经毒性","target":"靶器官","name":"靶向","des":"铅汞锰的靶点。"},{"source":"金属毒","target":"毒物谱系","name":"主族","des":"古典投毒的主力。"},{"source":"砷","target":"金属毒","name":"代表","des":"米氏线与皮肤角化。"},{"source":"汞","target":"金属毒","name":"代表","des":"蒸汽与甲基汞两副面孔。"},{"source":"铅","target":"金属毒","name":"代表","des":"儿童神经发育的头号威胁。"},{"source":"铊","target":"金属毒","name":"新贵","des":"脱发与末梢神经炎。"},{"source":"镉","target":"金属毒","name":"代表","des":"肾损伤与骨软化。"},{"source":"腐蚀毒","target":"毒物谱系","name":"一族","des":"局部灼伤为主。"},{"source":"氰化物","target":"毒物谱系","name":"极速","des":"呼吸链四型复合物抑制剂。"},{"source":"一氧化碳","target":"毒物谱系","name":"隐形","des":"与血红蛋白亲和力二百四十倍。"},{"source":"甲醇","target":"毒物谱系","name":"假酒","des":"代谢为甲酸致盲。"},{"source":"农药","target":"毒物谱系","name":"大宗","des":"自杀与误服的高发品。"},{"source":"有机磷","target":"农药","name":"主力","des":"胆碱能危象。"},{"source":"百草枯","target":"农药","name":"恶名","des":"无解毒药的肺纤维化。"},{"source":"灭鼠药","target":"农药","name":"近亲","des":"毒鼠强与抗凝剂。"},{"source":"药物滥用","target":"临床毒理学","name":"常态","des":"急诊中毒的主流。"},{"source":"阿片类","target":"药物滥用","name":"浪潮","des":"芬太尼时代的危机。"},{"source":"合成毒品","target":"药物滥用","name":"变体","des":"新精神活性物质层出。"},{"source":"动植物毒素","target":"毒物谱系","name":"天然","des":"蛇蜂藻菌的化学军备。"},{"source":"蛇毒","target":"动植物毒素","name":"大类","des":"神经毒血循毒混合毒。"},{"source":"河豚毒素","targe