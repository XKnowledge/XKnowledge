{
  "version": 2,
  "title": "造纸与印刷",
  "description": "从蔡伦的沤麻到王选的激光照排：造纸术西传的一千年、雕版与活字的分岔、古腾堡的铅字与胶印王国，知识复制的全部技术史。",
  "nodes": [
    { "name": "造纸与印刷", "des": "让知识脱离唯一原件的两大发明：纸承载，印刷复制。从手工抄写到按需印刷的一千九百年，是一场不断降低阅读门槛的漫长革命。", "symbolSize": 70, "category": "纸前时代" },
    { "name": "简牍与帛书", "des": "竹木为纸、丝帛为贵：先秦到汉代的书写载体，笨重与昂贵的两难。", "symbolSize": 40, "category": "纸前时代" },
    { "name": "莎草纸", "des": "尼罗河芦苇剖片压层的古埃及书写物，地中海文明用了三千年。", "symbolSize": 40, "category": "纸前时代" },
    { "name": "羊皮纸", "des": "鞣制兽皮的书写面，耐用可刮改，一部圣经要吃掉一羊群。", "symbolSize": 40, "category": "纸前时代" },
    { "name": "贝叶经", "des": "棕榈叶晒压切边成册的南亚与东南亚经典，随佛法东传的经页。", "symbolSize": 40, "category": "纸前时代" },
    { "name": "造纸术", "des": "把植物纤维打散再悬浮抄成薄层的技术，信息载体的价格从此跳水。", "symbolSize": 50, "category": "造纸术诞生" },
    { "name": "灞桥纸与西汉古纸", "des": "考古出土的西汉麻纸说明纸的萌芽早于蔡伦，但「蔡侯纸」完成了定型与推广。", "symbolSize": 40, "category": "造纸术诞生" },
    { "name": "蔡伦", "des": "105 年奏上「用树肤、麻头及敝布、鱼网以为纸」的宦官，造纸术的定型者与推广人。", "symbolSize": 50, "category": "造纸术诞生" },
    { "name": "造纸原料", "des": "麻、树皮、破布与渔网到竹与稻草：纤维的选择决定纸的性格。", "symbolSize": 40, "category": "造纸术诞生" },
    { "name": "抄纸与纸帘", "des": "竹帘入浆、荡料成箔、覆帘落纸——千年来造纸的核心动作全在一帘之间。", "symbolSize": 40, "category": "造纸术诞生" },
    { "name": "宣纸", "des": "青檀皮配沙田稻草的泾县名纸，墨分五色的书画载体，纸寿千年。", "symbolSize": 40, "category": "造纸术诞生" },
    { "name": "怛罗斯之战", "des": "751 年唐朝与阿拔斯的中亚会战，被俘唐匠相传把造纸术带进撒马尔罕——技术史上最著名的一场败仗。", "symbolSize": 50, "category": "造纸西传" },
    { "name": "撒马尔罕纸", "des": "河中地区的造纸中心，产量与品质让纸沿丝路反向倾销回唐朝。", "symbolSize": 40, "category": "造纸西传" },
    { "name": "巴格达造纸", "des": "793 年前后哈里发都城建纸坊，纸取代羊皮成为阿拉伯学术革命的底座。", "symbolSize": 40, "category": "造纸西传" },
    { "name": "法布里亚诺", "des": "1276 年建坊的意大利纸镇，发明水力打浆锤、动物胶施胶与水印。", "symbolSize": 40, "category": "造纸西传" },
    { "name": "水印", "des": "纸帘上凸线留下的透光商标，纸的名片与防伪起点。", "symbolSize": 40, "category": "造纸西传" },
    { "name": "雕版印刷", "des": "整页反刻上版、敷墨覆纸刷印，中国人发明的批量复制术。", "symbolSize": 50, "category": "雕版印刷" },
    { "name": "金刚经", "des": "868 年王玠为二亲造的卷首画与经文，有明确纪年的最早完整雕版印刷品。", "symbolSize": 40, "category": "雕版印刷" },
    { "name": "无垢净光大陀罗尼经", "des": "约 8 世纪初新罗印行的咒经，现存最早的印刷文字实物。", "symbolSize": 40, "category": "雕版印刷" },
    { "name": "印刷与佛教", "des": "抄经积德的信仰需求是印刷术最早的发动机，从经咒到整部大藏经。", "symbolSize": 40, "category": "雕版印刷" },
    { "name": "饾版与拱花", "des": "分色套印的小版拼盘与无墨压印的凸纹，雕版时代的彩色巅峰。", "symbolSize": 40, "category": "雕版印刷" },
    { "name": "毕昇", "des": "北宋庆历年间发明胶泥活字的布衣，沈括《梦溪笔谈》为他留下了发明证书。", "symbolSize": 50, "category": "活字革命" },
    { "name": "泥活字", "des": "刻字烧陶、排版敷墨、拆版再用——活字思想的第一次落地。", "symbolSize": 40, "category": "活字革命" },
    { "name": "王祯转轮排字", "des": "1298 年木活字配转轮排字盘，人坐轮旁「以字就人」，还顺手印了一部县志。", "symbolSize": 40, "category": "活字革命" },
    { "name": "铜活字", "des": "明代无锡华氏会通馆的金属活字印书，中国活字应用的高光时刻。", "symbolSize": 40, "category": "活字革命" },
    { "name": "直指心体要节", "des": "1377 年韩国清州兴德寺金属活字印本，现存最古金属活字书。", "symbolSize": 40, "category": "活字革命" },
    { "name": "古腾堡", "des": "1450 年前后在美因茨把铸字合金、手摇压床与油墨拼成系统的人，西方印刷业的引爆点。", "symbolSize": 50, "category": "古腾堡革命" },
    { "name": "铅活字铸造", "des": "钢刻字冲打铜模、铅锡锑合金浇字，可互换零件思想在文字上的实现。", "symbolSize": 40, "category": "古腾堡革命" },
    { "name": "手摇印刷机", "des": "借葡萄酒压床改造的螺旋压印机，一小时240张的稳定出品。", "symbolSize": 40, "category": "古腾堡革命" },
    { "name": "古腾堡圣经", "des": "约 1455 年印成的 42 行圣经，两栏哥特体、印刷品质第一次媲美手抄本。", "symbolSize": 40, "category": "古腾堡革命" },
    { "name": "印刷与宗教改革", "des": "路德的小册子借印刷机二十年席卷欧洲，活字成为新教的骑兵。", "symbolSize": 40, "category": "古腾堡革命" },
    { "name": "印刷与科学革命", "des": "从哥白尼到牛顿，统一的图版与数据让错误无处藏身——科学变成可复算的事业。", "symbolSize": 40, "category": "古腾堡革命" },
    { "name": "版权的诞生", "des": "1710 年安妮法令首次承认作者权利，印刷利益链上的第一次立法分账。", "symbolSize": 40, "category": "古腾堡革命" },
    { "name": "斯坦霍普铁印机", "des": "1800 年铁制机架取代木身，整版铸铁印刷机时代的开场。", "symbolSize": 40, "category": "机械化印刷" },
    { "name": "科尼希蒸汽印刷机", "des": "1814 年 11 月 29 日《泰晤士报》以蒸汽滚筒印刷，报纸从此赶得上新闻。", "symbolSize": 40, "category": "机械化印刷" },
    { "name": "轮转印刷机", "des": "1847 年霍氏轮转机让版台改滚筒，卷筒纸跑起来，每小时数万张。", "symbolSize": 40, "category": "机械化印刷" },
    { "name": "莱诺铸排机", "des": "1886 年默根塔勒的整行铸排机，键盘一敲一行铅字，爱迪生口中的第八大奇迹。", "symbolSize": 40, "category": "机械化印刷" },
    { "name": "莫诺铸排机", "des": "单字铸排的另一种答案，纸带打孔让排版与铸字异地并行。", "symbolSize": 40, "category": "机械化印刷" },
    { "name": "报业黄金时代", "des": "蒸汽机加铸排机喂出的百万发行量，大众传播的第一个盛世。", "symbolSize": 40, "category": "机械化印刷" },
    { "name": "平装书革命", "des": "1935 年企鹅六便士平装把书价打到一包烟，知识大众化的最后一公里。", "symbolSize": 40, "category": "机械化印刷" },
    { "name": "石印术", "des": "1796 年塞内菲尔德发现的油水相拒原理，石版上的画直通纸面。", "symbolSize": 50, "category": "图像与平版" },
    { "name": "胶印", "des": "1904 年前后橡皮布转印的间接印刷，今天书籍与包装的主力工艺。", "symbolSize": 40, "category": "图像与平版" },
    { "name": "网目调印刷", "des": "1880 年代以大小网点模拟灰阶，照片从此进得了报纸。", "symbolSize": 40, "category": "图像与平版" },
    { "name": "铜版雕刻", "des": "推刀直刻凹版的精细线条，钞票与有价证券的防伪担当。", "symbolSize": 40, "category": "图像与平版" },
    { "name": "丢勒与北方版画", "des": "1498 年《启示录》木刻组画让版画第一次成为独立艺术。", "symbolSize": 40, "category": "图像与平版" },
    { "name": "丝网印刷", "des": "刮板推墨过网孔的孔版印刷，从招牌到沃霍尔的玛丽莲。", "symbolSize": 40, "category": "图像与平版" },
    { "name": "汉字印刷难题", "des": "数万字符对上几十字母：西方铸排机的钥匙打不开汉字的大门。", "symbolSize": 40, "category": "汉字照排" },
    { "name": "王选", "des": "748 工程主持者，以轮廓加参数的汉字字形信息压缩让计算机认得汉字，「当代毕昇」。", "symbolSize": 50, "category": "汉字照排" },
    { "name": "激光照排", "des": "1980 年代国产激光照排系统横扫全国报社，中文出版从铅与火跃入光与电。", "symbolSize": 50, "category": "汉字照排" },
    { "name": "桌面出版", "des": "1985 年 PostScript 与 PageMaker 让排版搬上个人电脑，设计室的一人革命。", "symbolSize": 40, "category": "汉字照排" },
    { "name": "数字印刷", "des": "静电与喷墨的按需印刷：一册起印、张张可变，仓库时代的终结者。", "symbolSize": 40, "category": "汉字照排" },
    { "name": "电子纸", "des": "电泳墨滴的双稳态显示，最像纸的屏幕，纸的最强对手兼模仿者。", "symbolSize": 40, "category": "汉字照排" }
  ],
