{
  "version": 2,
  "title": "自行车与摩托车",
  "description": "两个轮子上的自由：从木马行走机、高轮车到安全自行车，从戴姆勒骨架车到日本四强——人力与机动的双线进化，变速、悬挂与骑行文化的完整谱系。",
  "nodes": [
    { "name": "自行车与摩托车", "des": "两个轮子上的自由：从木马行走机到碳纤与电喷，人力与机动的双线进化。", "symbolSize": 70, "category": "自行车与摩托车" },
    { "name": "两轮前史", "des": "没有脚踏的两轮启蒙：从滑行木马到蹦跳的高轮，勇气先于工程。", "symbolSize": 50, "category": "两轮前史" },
    { "name": "德赖斯行走机", "des": "一八一七年木轮转向车，贵族的滑行玩具与马车挑战。", "symbolSize": 40, "category": "两轮前史" },
    { "name": "麦克米伦踏板传说", "des": "相传一八三九年苏格兰工匠已在后轮装踏板，史学公案一桩。", "symbolSize": 40, "category": "两轮前史" },
    { "name": "米肖脚踏前轮", "des": "一八六〇年代曲柄装上前轮，蹬一圈走一圈。", "symbolSize": 40, "category": "两轮前史" },
    { "name": "高轮车", "des": "前轮巨大后轮如橘，速度换勇气的维多利亚风尚。", "symbolSize": 40, "category": "两轮前史" },
    { "name": "高轮车事故", "des": "前轮栽面的摔法有了专属英文词，安全诉求催生变革。", "symbolSize": 40, "category": "两轮前史" },
    { "name": "骑行俱乐部热潮", "des": "大西洋两岸的轮社与竞速，自行车文化的第一波。", "symbolSize": 40, "category": "两轮前史" },
    { "name": "安全自行车", "des": "一八八五年定型的经典：链条、菱形架与充气胎三件套。", "symbolSize": 50, "category": "安全自行车" },
    { "name": "罗弗安全车", "des": "斯塔利一八八五年的两轮车架，现代自行车的直系祖先。", "symbolSize": 40, "category": "安全自行车" },
    { "name": "链条传动", "des": "蹬踏与驱动轮解耦，速度与安全从此兼得。", "symbolSize": 40, "category": "安全自行车" },
    { "name": "邓禄普充气胎", "des": "一八八八年兽医为儿子三轮车装气胎，颠簸化轻盈。", "symbolSize": 40, "category": "安全自行车" },
    { "name": "轮胎工业的起点", "des": "充气胎专利长成轮胎巨头，自行车喂大了汽车工业。", "symbolSize": 40, "category": "安全自行车" },
    { "name": "菱形车架与辐条轮", "des": "两三角结构与张紧辐条，钢管理论的百年教科书。", "symbolSize": 40, "category": "安全自行车" },
    { "name": "女式车与裙摆", "des": "斜梁裙型车架与灯笼裤，自行车与女性解放的世纪联动。", "symbolSize": 40, "category": "安全自行车" },
    { "name": "自行车技术", "des": "变速、刹车与悬挂：一辆车上的百年零件军备竞赛。", "symbolSize": 50, "category": "自行车技术" },
    { "name": "车架材料", "des": "钢铝钛碳逐代轻量化，骑乘感与刚度的材料学。", "symbolSize": 40, "category": "自行车技术" },
    { "name": "外变速系统", "des": "拨链器换挡，飞轮塔轮从三速卷到十二速。", "symbolSize": 40, "category": "自行车技术" },
    { "name": "内变速花鼓", "des": "行星齿轮藏进后毂，免维护的城市通勤方案。", "symbolSize": 40, "category": "自行车技术" },
    { "name": "刹车演进", "des": "轮闸、侧拉夹器到碟刹，制动力与泥水的搏斗。", "symbolSize": 40, "category": "自行车技术" },
