    { "name": "电子变速与功率计", "des": "无线换挡与踩踏功率直读，数据化的骑行时代。", "symbolSize": 40, "category": "自行车技术" },
    { "name": "车型谱系", "des": "通勤竞速山野各归其位：现代自行车的分科。", "symbolSize": 50, "category": "车型谱系" },
    { "name": "公路车", "des": "弯把细胎轻装，铺装路面上的速度机器。", "symbolSize": 40, "category": "车型谱系" },
    { "name": "山地车", "des": "一九七〇年代塔马尔帕斯山下坡青年，宽胎避震的山林物种。", "symbolSize": 40, "category": "车型谱系" },
    { "name": "砾石车", "des": "公路几何加宽胎容错，铺装与土路通吃的折中新种。", "symbolSize": 40, "category": "车型谱系" },
    { "name": "折叠车", "des": "一九七〇年代布瑞顿钢架折拢，地铁通勤的伴侣。", "symbolSize": 40, "category": "车型谱系" },
    { "name": "旅行车与城市车", "des": "蝴蝶把驼包货架，长途跋涉与街巷日常的载重设计。", "symbolSize": 40, "category": "车型谱系" },
    { "name": "场地车与死飞", "des": "固定齿轮无刹车间，场地竞速与街头文化的两副面孔。", "symbolSize": 40, "category": "车型谱系" },
