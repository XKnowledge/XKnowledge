    { "name": "首批量产摩托", "des": "一八九四年希尔德布兰德双缸量产，机动两轮商品化。", "symbolSize": 40, "category": "摩托车诞生" },
    { "name": "离合与换挡机构", "des": "离合器与变速箱逐步上车，动力与操控的握手。", "symbolSize": 40, "category": "摩托车诞生" },
