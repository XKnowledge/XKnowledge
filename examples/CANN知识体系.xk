{"version":2,"nodes":[{"name":"CANN","des":"昇腾计算架构，上承深度学习框架、下驱昇腾芯片的异构计算底座，全栈自研。","symbolSize":70,"category":"总体架构"},{"name":"异构计算架构","des":"CPU管逻辑与调度、NPU管大规模并行的分工模式，CANN一切设计的出发点。","symbolSize":40,"category":"总体架构"},{"name":"昇腾AI处理器","des":"达芬奇架构的昇腾系列芯片，310主打推理，910系列主打训练。","symbolSize":60,"category":"总体架构"},{"name":"软硬件栈","des":"芯片、驱动、CANN、框架、应用的五层纵队，层层向上负责。","symbolSize":40,"category":"总体架构"},{"name":"算子库","des":"CANN内置的数百个预编译高性能算子，框架与开发者开箱即用。","symbolSize":50,"category":"总体架构"},{"name":"MindSpore","des":"华为自研深度学习框架，与CANN同源协同、软硬联合优化。","symbolSize":50,"category":"总体架构"},{"name":"torch_npu","des":"PyTorch昇腾适配插件，存量模型低成本迁移NPU的首选通道。","symbolSize":50,"category":"总体架构"},{"name":"大模型训练","des":"千亿参数千卡集群的长稳训练，断点续训与通信优化是生命线。","symbolSize":50,"category":"总体架构"},{"name":"端边云协同","des":"从Atlas 200到Atlas 900，端边云共用同一套CANN软件栈。","symbolSize":40,"category":"总体架构"},{"name":"达芬奇架构","des":"昇腾AI Core的微架构，Cube、Vector、Scalar三件套立体作战。","symbolSize":60,"category":"硬件体系"},{"name":"AI Core","des":"达芬奇核心，一颗芯片里成百上千个，是真正执行算子的计算单元。","symbolSize":60,"category":"硬件体系"},{"name":"AI CPU","des":"承接AI Core不擅长的算子与控制逻辑的通用处理器核。","symbolSize":40,"category":"硬件体系"},{"name":"Cube单元","des":"矩阵乘专精单元，一个周期吞吐16×16×16的fp16立方计算，大算力发动机。","symbolSize":40,"category":"硬件体系"},{"name":"Vector单元","des":"向量单元，逐元素运算、比较、激活函数的流水线主力。","symbolSize":40,"category":"硬件体系"},{"name":"Scalar单元","des":"标量单元，算地址、控分支，AI Core里的大脑皮层。","symbolSize":40,"category":"硬件体系"},{"name":"MTE","des":"Memory Transfer Engine，专职在片上片下搬运数据的DMA引擎。","symbolSize":40,"category":"硬件体系"},{"name":"存储层次","des":"从寄存器到HBM的多级金字塔，容量与速度永远在跷跷板两端。","symbolSize":40,"category":"硬件体系"},{"name":"Unified Buffer","des":"片上统一缓冲，Vector计算输入输出的落脚点，LocalTensor的家。","symbolSize":40,"category":"硬件体系"},{"name":"HBM","des":"高带宽显存，大模型权重与激活数据的安身之所。","symbolSize":50,"category":"硬件体系"},{"name":"昇腾系列硬件","des":"Atlas 200/300/800/900产品家族，端边云全场景覆盖。","symbolSize":50,"category":"硬件体系"},{"name":"集合通信","des":"AllReduce、AllGather等多卡协同原语，分布式训练的骨架。","symbolSize":40,"category":"硬件体系"},{"name":"多核并行","des":"把一个大算子拆给多个AI Core同时干活的分而治之策略。","symbolSize":40,"category":"硬件体系"},{"name":"AscendCL","des":"昇腾计算语言接口，C风格API，资源管理、推理与算子调用的统一入口。","symbolSize":60,"category":"编程接口"},{"name":"Runtime","des":"运行时系统，管内存、流与任务下发，贴着硬件的最后一层软件。","symbolSize":50,"category":"编程接口"},{"name":"Device管理","des":"SetDevice/GetDevice，先选卡再干活的第一步。","symbolSize":40,"category":"编程接口"},{"name":"Context","des":"上下文容器，封装设备、流与内存的运行环境。","symbolSize":40,"category":"编程接口"},{"name":"Stream","des":"任务队列，同流内串行、异流间并行的调度轨道。","symbolSize":50,"category":"编程接口"},{"name":"Event","des":"事件插桩，跨流依赖与耗时统计的精准哨点。","symbolSize":40,"category":"编程接口"},{"name":"内存管理","des":"Host与Device两侧内存的申请、拷贝与释放，一字节都要精打细算。","symbolSize":40,"category":"编程接口"},{"name":"Host与Device同步","des":"Synchronize等待语义，CPU与NPU干完活的握手仪式。","symbolSize":40,"category":"编程接口"},{"name":"模型推理","des":"LoadFromFile、Execute、Unload的离线模型推理三段式。","symbolSize":50,"category":"编程接口"},{"name":"单算子调用","des":"aclopExecute系列，不建模直接喂张量给单个算子。","symbolSize":40,"category":"编程接口"},{"name":"Aclnn","des":"单算子高级API，算子库的标准调用形态，接口名以aclnn开头。","symbolSize":50,"category":"编程接口"},{"name":"媒体预处理","des":"VPC、VDEC、VENC图像视频预处理加速通道，视觉任务的前菜。","symbolSize":40,"category":"编程接口"},{"name":"Ascend C","des":"原生算子开发语言，C++语法糖衣下的芯片编程，一套代码多代硬件兼容。","symbolSize":60,"category":"算子开发"},{"name":"Kernel函数","des":"算子的设备侧入口，__aicore__标注，每个AI Core各跑一份。","symbolSize":40,"category":"算子开发"},{"name":"GlobalTensor","des":"全局张量，住在HBM里的算子输入与输出。","symbolSize":40,"category":"算子开发"},{"name":"LocalTensor","des":"局部张量，搬进片上Buffer参与计算的主力数据形态。","symbolSize":40,"category":"算子开发"},{"name":"TPipe","des":"片上内存管家，统一规划各Buffer的容量与生命周期。","symbolSize":40,"category":"算子开发"},{"name":"TQue","des":"数据队列，EnQue与DeQue一唱一和完成搬运和计算的接力。","symbolSize":40,"category":"算子开发"},{"name":"TBuf","des":"临时缓冲，给中间变量一个不用排队的位置。","symbolSize":40,"category":"算子开发"},{"name":"DataCopy","des":"搬运原语，Global与Local之间往返的班车，算子性能第一关。","symbolSize":40,"category":"算子开发"},{"name":"Tiling","des":"切分艺术，按片上容量把大张量切成小块分给各核，性能的第一道门槛。","symbolSize":50,"category":"算子开发"},{"name":"矢量算子","des":"逐元素计算类算子，Vector单元的看家本领。","symbolSize":40,"category":"算子开发"},{"name":"矩阵算子","des":"Matmul一族，Cube单元的主场，大模型算力的主消耗。","symbolSize":40,"category":"算子开发"},{"name":"核间同步","des":"SyncAll集体对齐，多核协作时谁也不能提前离场。","symbolSize":40,"category":"算子开发"},{"name":"双缓冲","des":"Ping-Pong流水，一份搬运一份计算，时间利用率翻倍的诀窍。","symbolSize":40,"category":"算子开发"},{"name":"算子开发流程","des":"工程创建、算子实现、编译部署、精度与性能验证四步走。","symbolSize":40,"category":"算子开发"},{"name":"ATC","des":"昇腾张量编译器，把ONNX/Caffe模型翻译成硬件可执行的OM文件。","symbolSize":50,"category":"编译与执行"},{"name":"图引擎GE","des":"Graph Engine，计算图的解析、优化与调度中枢。","symbolSize":50,"category":"编译与执行"},{"name":"算子融合","des":"图编译时多个小算子合成一个大算子，省下往返访存的开销。","symbolSize":40,"category":"编译与执行"},{"name":"OM模型","des":"离线模型格式，ATC的编译产物，部署推理的标准载荷。","symbolSize":40,"category":"编译与执行"},{"name":"Ascend IR","des":"算子统一中间表达，屏蔽硬件代际差异的承重层。","symbolSize":40,"category":"编译与执行"},{"name":"图优化","des":"常量折叠、公共子表达式消除等编译期瘦身术。","symbolSize":40,"category":"编译与执行"},{"name":"算子调度","des":"执行分流器，决定算子跑在AI Core还是AI CPU。","symbolSize":40,"category":"编译与执行"},{"name":"动态Shape","des":"输入维度可变的执行模式，编译期分档应对运行时变化。","symbolSize":40,"category":"编译与执行"},{"name":"HCCL","des":"华为集合通信库，多卡AllReduce的高性能软件实现。","symbolSize":50,"category":"生态与工具"},{"name":"Profiler","des":"性能分析工具，时间线、算子耗时、带宽利用率一屏尽览。","symbolSize":50,"category":"生态与工具"},{"name":"精度比对","des":"整网逐层数值对齐，揪出精度问题的CT机。","symbolSize":40,"category":"生态与工具"},{"name":"日志系统","des":"分级日志，故障定位的第一现场，INFO到ERROR层层留痕。","symbolSize":40,"category":"生态与工具"},{"name":"MindStudio","des":"昇腾开发IDE，算子开发、模型迁移、性能调优一站式工作台。","symbolSize":40,"category":"生态与工具"},{"name":"模型迁移","des":"GPU到昇腾的搬家路径：语法适配、精度验证、性能调优三步走。","symbolSize":40,"category":"生态与工具"},{"name":"MindSpeed","des":"对齐Megatron的昇腾大模型加速库，成熟配方直接复用。","symbolSize":40,"category":"生态与工具"},{"name":"昇腾社区","des":"版本、文档、示例与问答的官方集散地。","symbolSize":40,"category":"生态与工具"}],"links":[{"source":"CANN","target":"昇腾AI处理器","name":"异构调度","des":"屏蔽硬件差异，把框架的计算图翻译成芯片指令流。"},{"source":"CANN","target":"异构计算架构","name":"设计基石","des":"按CPU与NPU分工协作的模式组织整套软件栈。"},{"source":"CANN","target":"算子库","name":"核心资产","des":"内置数百个高性能算子，覆盖主流网络结构，随版本持续扩充。"},{"source":"CANN","target":"MindSpore","name":"原生底座","des":"为框架提供图编译、算子与运行时的全链路支撑。"},{"source":"CANN","target":"torch_npu","name":"适配通道","des":"PyTorch调用经插件转投CANN算子与运行时。"},{"source":"异构计算架构","target":"昇腾AI处理器","name":"host与device","des":"CPU负责调度与逻辑，NPU负责大规模张量计算。"},{"source":"软硬件栈","target":"CANN","name":"中间层","des":"CANN居中，向上隔离框架差异，向下屏蔽芯片细节。"},{"source":"软硬件栈","target":"昇腾AI处理器","name":"栈基","des":"芯片与驱动位于栈底，是一切软件的落点。"},{"source":"大模型训练","target":"集合通信","name":"梯度同步","des":"每轮反向传播后靠AllReduce等原语同步梯度。"},{"source":"大模型训练","target":"HBM","name":"显存门槛","des":"千亿参数能否放下，先看显存容量与带宽。"},{"source":"端边云协同","target":"昇腾系列硬件","name":"产品形态","des":"一套CANN软件栈跑遍端边云全家族硬件。"},{"source":"CANN","target":"大模型训练","name":"集群使能","des":"提供断点续训、通信优化与长稳运行保障。"},{"source":"CANN","target":"端边云协同","name":"一次开发","des":"同一套接口与算子能力贯穿端边云部署。"},{"source":"昇腾AI处理器","target":"达芬奇架构","name":"核心微架构","des":"达芬奇架构定义了AI Core的计算范式。"},{"source":"达芬奇架构","target":"AI Core","name":"物理载体","des":"微架构以AI Core为单元成规模复制。"},{"source":"AI Core","target":"Cube单元","name":"矩阵引擎","des":"大规模矩阵乘的吞吐担当。"},{"source":"AI Core","target":"Vector单元","name":"向量引擎","des":"逐元素计算与规约的流水线。"},{"source":"AI Core","target":"Scalar单元","name":"标量引擎","des":"地址计算与分支控制的指挥中枢。"},{"source":"AI Core","target":"MTE","name":"搬运引擎","des":"计算单元只管算，数据进出全靠MTE。"},{"source":"AI Core","target":"存储层次","name":"片上配套","des":"算得快不快，一半看数据放得近不近。"},{"source":"存储层次","target":"Unified Buffer","name":"中间层","des":"数据先落脚UB，再进计算单元。"},{"source":"存储层次","target":"HBM","name":"容量层","des":"片上放不下的权重与激活全在显存。"},{"source":"MTE","target":"HBM","name":"数据来源","des":"从HBM向片上Buffer搬运是算子的第一个动作。"},{"source":"昇腾系列硬件","target":"昇腾AI处理器","name":"内核","des":"板卡与服务器的心脏都是昇腾芯片。"},{"source":"集合通信","target":"昇腾系列硬件","name":"互联底座","des":"多卡训练依托卡间与节点间高速互联。"},{"source":"昇腾AI处理器","target":"AI CPU","name":"协同兜底","des":"不适合AI Core的算子与系统任务交给AI CPU。"},{"source":"多核并行","target":"AI Core","name":"分而治之","des":"一个大任务切成N份，N个核同时开工。"},{"source":"多核并行","target":"Tiling","name":"前置工序","des":"先按核数与容量切好块，才能各干各的。"},{"source":"AscendCL","target":"Runtime","name":"底层支撑","des":"C接口的语义最终由运行时承接执行。"},{"source":"AscendCL","target":"Device管理","name":"初始化第一步","des":"用卡先声明，资源随设备绑定。"},{"source":"AscendCL","target":"Context","name":"环境封装","des":"上下文把设备、流、内存打包管理。"},{"source":"AscendCL","target":"Stream","name":"任务轨道","des":"任务挂到流上，随流依次推进。"},{"source":"Context","target":"Device管理","name":"挂靠设备","des":"上下文绑定在具体设备之上。"},{"source":"Context","target":"Stream","name":"归属关系","des":"流创建在上下文里，销毁顺序不能颠倒。"},{"source":"Stream","target":"Event","name":"插桩同步","des":"事件插进流里标记时间点与依赖。"},{"source":"Event","target":"Host与Device同步","name":"细粒度等待","des":"从全流等待细化为等待到指定位置。"},{"source":"AscendCL","target":"内存管理","name":"显存操作","des":"Host与Device两侧内存一手抓。"},{"source":"内存管理","target":"Host与Device同步","name":"拷贝伴随等待","des":"跨侧拷贝之后通常要同步再取结果。"},{"source":"AscendCL","target":"模型推理","name":"推理主链路","des":"加载、执行、卸载三段式走完整个推理。"},{"source":"模型推理","target":"OM模型","name":"加载对象","des":"LoadFromFile吃进去的正是OM文件。"},{"source":"AscendCL","target":"单算子调用","name":"免建模执行","des":"不搭整网，直接喂张量给单个算子。"},{"source":"单算子调用","target":"Aclnn","name":"标准形态","des":"aclnn接口是单算子执行的主流入口。"},{"source":"AscendCL","target":"媒体预处理","name":"视觉专用","des":"图像缩放解码与视频编解码走专用通道。"},{"source":"Device管理","target":"昇腾AI处理器","name":"管的是NPU","des":"SetDevice选中的就是一块昇腾卡。"},{"source":"Runtime","target":"昇腾AI处理器","name":"直接对话","des":"运行时把任务翻译成硬件可执行的队列指令。"},{"source":"端边云协同","target":"AscendCL","name":"统一接口","des":"端边云三类设备共用同一套AscendCL。"},{"source":"Aclnn","target":"算子库","name":"调用入口","des":"每个库算子都对应一套aclnn接口。"},{"source":"Ascend C","target":"Kernel函数","name":"入口函数","des":"算子实现从写kernel函数起步。"},{"source":"Kernel函数","target":"GlobalTensor","name":"输入输出","des":"从全局张量读数据、写结果。"},{"source":"Kernel函数","target":"LocalTensor","name":"计算载体","des":"数据搬进片上才够得着计算单元。"},{"source":"Kernel函数","target":"Tiling","name":"首要入参","des":"tiling决定每个核拿到哪一块。"},{"source":"TPipe","target":"TQue","name":"队列分配","des":"管家发放带队列语义的buffer。"},{"source":"TPipe","target":"TBuf","name":"临时分配","des":"中间变量走免排队的快速通道。"},{"source":"TQue","target":"LocalTensor","name":"装载形态","des":"DeQue出来的就是可用的局部张量。"},{"source":"DataCopy","target":"GlobalTensor","name":"搬运对象","des":"从全局张量往片上搬数据。"},{"source":"DataCopy","target":"LocalTensor","name":"落点","des":"搬进片上等待计算单元取用。"},{"source":"TQue","target":"DataCopy","name":"同步配对","des":"EnQue前须搬完，DeQue后才能算。"},{"source":"矢量算子","target":"Vector单元","name":"硬件映射","des":"逐元素指令流在Vector单元执行。"},{"source":"矩阵算子","target":"Cube单元","name":"硬件映射","des":"Matmul指令流由Cube单元吞吐。"},{"source":"双缓冲","target":"TQue","name":"流水实现","des":"两份buffer轮流进队出队。"},{"source":"双缓冲","target":"MTE","name":"搬算重叠","des":"一份在搬、一份在算，谁也不闲着。"},{"source":"核间同步","target":"多核并行","name":"集体对齐","des":"多核协作场景谁也不许提前离场。"},{"source":"算子开发流程","target":"Ascend C","name":"开发语言","des":"四步流程以Ascend C为实现语言。"},{"source":"算子开发流程","target":"Profiler","name":"性能验收","des":"写完先看耗时，搬运占比是重点。"},{"source":"Ascend C","target":"Ascend IR","name":"编译路径","des":"源码经Ascend IR编译成硬件指令。"},{"source":"LocalTensor","target":"Unified Buffer","name":"物理位置","des":"局部张量实际住在片上UB里。"},{"source":"GlobalTensor","target":"HBM","name":"物理位置","des":"全局张量实际存放在显存里。"},{"source":"矩阵算子","target":"大模型训练","name":"算力大头","des":"训练算力九成消耗在矩阵乘。"},{"source":"Aclnn","target":"Ascend C","name":"产物接口","des":"Ascend C自定义算子编译部署后也生成aclnn接口。"},{"source":"ATC","target":"OM模型","name":"编译产物","des":"模型优化后落盘成om离线文件。"},{"source":"ATC","target":"图引擎GE","name":"依托GE","des":"借GE完成图解析、优化与算子编排。"},{"source":"图引擎GE","target":"算子融合","name":"图级收益","des":"融合是图优化中收益最大的一招。"},{"source":"图引擎GE","target":"图优化","name":"编译期瘦身","des":"折叠常量、消除冗余，图越小跑得越快。"},{"source":"算子融合","target":"昇腾AI处理器","name":"适配硬件","des":"大颗粒融合算子更贴合达芬奇的立方计算。"},{"source":"Ascend IR","target":"算子调度","name":"执行属性","des":"IR里标注了算子跑在AI Core还是AI CPU。"},{"source":"算子调度","target":"AI Core","name":"主力去处","des":"张量计算默认上AI Core。"},{"source":"算子调度","target":"AI CPU","name":"兜底去处","des":"难以向量化的算子交给AI CPU。"},{"source":"动态Shape","target":"ATC","name":"分档编译","des":"编译期按shape档位预生成多套内核。"},{"source":"动态Shape","target":"OM模型","name":"多档产物","des":"一份OM内含多个档位应对输入变化。"},{"source":"ATC","target":"Ascend IR","name":"中间表达","des":"模型算子统一转成IR再编译。"},{"source":"算子库","target":"Ascend IR","name":"算子载体","des":"内置算子以Ascend IR形态交付与演进。"},{"source":"HCCL","target":"集合通信","name":"软件实现","des":"把通信原语的性能榨到互联带宽极限。"},{"source":"HCCL","target":"大模型训练","name":"通信底座","des":"训练集群的梯度同步全靠HCCL支撑。"},{"source":"Profiler","target":"模型推理","name":"瓶颈定位","des":"时间线暴露算子耗时与流水空隙。"},{"source":"精度比对","target":"模型迁移","name":"迁移验收","des":"搬家先对齐精度，再谈性能优化。"},{"source":"MindStudio","target":"Ascend C","name":"开发利器","des":"IDE内置算子工程脚手架与一键部署。"},{"source":"MindStudio","target":"Profiler","name":"集成分析","des":"耗时数据在IDE里可视化呈现。"},{"source":"模型迁移","target":"torch_npu","name":"首选路径","des":"PyTorch应用经torch_npu低成本搬家。"},{"source":"MindSpeed","target":"大模型训练","name":"加速配方","des":"Megatron的并行策略在昇腾上即插即用。"},{"source":"MindSpeed","target":"torch_npu","name":"构建基座","des":"加速库构建在torch_npu适配层之上。"},{"source":"昇腾社区","target":"CANN","name":"资料集散","des":"版本、文档、示例与问答一站获取。"},{"source":"日志系统","target":"CANN","name":"全局观测","des":"运行轨迹与异常全程分级留痕。"},{"source":"模型迁移","target":"ATC","name":"转换桥梁","des":"迁移时配ATC把ONNX转成OM部署。"},{"source":"媒体预处理","target":"昇腾系列硬件","name":"专用加速","des":"视觉前处理有专属硬件单元加持。"},{"source":"Runtime","target":"Stream","name":"队列实现","des":"流的创建与推进由运行时维护。"},{"source":"Runtime","target":"内存管理","name":"显存代理","des":"申请释放最终由运行时对接驱动。"},{"source":"MindStudio","target":"模型迁移","name":"迁移向导","des":"IDE把迁移步骤固化成向导与脚本。"},{"source":"算子开发流程","target":"精度比对","name":"精度对齐","des":"新算子先对基线数值再上性能。"},{"source":"图优化","target":"OM模型","name":"固化成果","des":"优化成果在编译期固化进OM。"},{"source":"Tiling","target":"存储层次","name":"容量依据","des":"切块大小由片上Buffer容量决定。"},{"source":"异构计算架构","target":"Host与Device同步","name":"分工边界","des":"两侧各干各的，边界处需要握手。"}],"title":"CANN知识体系","description":"从达芬奇架构到Ascend C算子开发的昇腾计算全景图"}