{"version":2,"nodes":[{"name":"舞蹈史","des":"从文艺复兴宫廷的礼仪奇观到足尖、赤足与街角的身体革命：五百年舞蹈艺术的纵横脉络。","symbolSize":70,"category":"芭蕾史"},{"name":"宫廷芭蕾","des":"文艺复兴意大利的宫廷余兴，随凯瑟琳·德·美第奇嫁入法国，诗乐舞一体的贵族礼仪艺术。","symbolSize":40,"category":"芭蕾史"},{"name":"皇后喜剧芭蕾","des":"1581年巴黎为皇家婚礼而演的鸿篇巨制，宫廷芭蕾的奠基之作。","symbolSize":40,"category":"芭蕾史"},{"name":"路易十四","des":"1653年亲演《夜之芭蕾》的太阳王，1661年敕建皇家舞蹈学院，把芭蕾升格为国家事业。","symbolSize":50,"category":"芭蕾史"},{"name":"皇家舞蹈学院","des":"1661年路易十四敕建，厘定术语与教学规程，芭蕾自此有了统一语言与师范体系。","symbolSize":40,"category":"芭蕾史"},{"name":"博尚","des":"学院核心与国王舞蹈教师，规范五位脚与基本手位，芭蕾语汇沿用至今的总设计师。","symbolSize":40,"category":"芭蕾史"},{"name":"吕利","des":"佛罗伦萨裔的法国宫廷作曲家，首创歌剧芭蕾体裁，与莫里哀合作喜剧芭蕾，掌王室乐正数十年。","symbolSize":40,"category":"芭蕾史"},{"name":"诺维尔","des":"1760年《舞蹈与舞剧书信集》提倡情节芭蕾，主张舞蹈讲戏甩掉面具，剧场舞蹈的启蒙者。","symbolSize":40,"category":"芭蕾史"},{"name":"浪漫主义芭蕾","des":"19世纪巴黎的白裙与月光，仙凡恋的超自然题材，足尖与薄纱定型的黄金时代。","symbolSize":50,"category":"芭蕾史"},{"name":"玛丽·塔里奥尼","des":"1832年《仙女》首开足尖技巧的传奇，轻盈如雾的空中舞者，浪漫芭蕾的第一图腾。","symbolSize":50,"category":"芭蕾史"},{"name":"仙女","des":"1832年巴黎歌剧院首演，塔里奥尼父女的杰作，足尖技术与白色纱裙的开山之作。","symbolSize":40,"category":"芭蕾史"},{"name":"吉赛尔","des":"1841年首演，村女痴恋而亡化幽灵反护情敌，亚当作曲，浪漫主义悲情叙事的顶峰。","symbolSize":40,"category":"芭蕾史"},{"name":"古典芭蕾","des":"彼季帕在帝俄宫廷铸成的鼎盛范式，双人舞结构与大型群舞排场，交响化的舞蹈建筑学。","symbolSize":50,"category":"芭蕾史"},{"name":"彼季帕","des":"侨居彼得堡数十年的法国编导，《睡美人》《天鹅湖》定本缔造者，古典芭蕾之父。","symbolSize":50,"category":"芭蕾史"},{"name":"柴可夫斯基","des":"为三大舞剧谱写交响化音乐，让芭蕾音乐从伴舞升为灵魂，舞剧作曲的天花板。","symbolSize":50,"category":"芭蕾史"},{"name":"天鹅湖","des":"1877年莫斯科首演失利，1895年彼季帕与伊万诺夫彼得堡定本，奥杰塔双人舞永为经典。","symbolSize":40,"category":"芭蕾史"},{"name":"睡美人","des":"1890年马林斯基剧院首演，彼季帕编舞的百科全书，古典大双人舞的巅峰范本。","symbolSize":40,"category":"芭蕾史"},{"name":"胡桃夹子","des":"1892年首演的两幕圣诞童话，糖果仙子钢片琴一响，岁末档期百年不衰。","symbolSize":40,"category":"芭蕾史"},{"name":"佳吉列夫俄罗斯芭蕾舞团","des":"1909年佳吉列夫率俄国明星登陆巴黎，集毕加索、科克托、萨蒂于一台，现代主义的移动策展。","symbolSize":50,"category":"芭蕾史"},{"name":"福金","des":"佳吉列夫舞团首任首席编导，《仙女们》让萧邦乐曲起舞，主张舞蹈为表达而非炫技的改革派。","symbolSize":40,"category":"芭蕾史"},{"name":"尼金斯基","des":"佳吉列夫团的传奇巨星，腾空惊人，《牧神午后》与《春之祭》以内八字顿步颠覆古典审美。","symbolSize":50,"category":"芭蕾史"},{"name":"春之祭","des":"1913年香榭丽舍剧院首演即酿骚动，斯特拉文斯基的节奏与尼金斯基的顿步，现代主义的爆点。","symbolSize":40,"category":"芭蕾史"},{"name":"苏联芭蕾","des":"十月革命后承帝俄家底转向戏剧芭蕾，莫斯科大剧院与基洛夫并峙，交响芭蕾后起争锋。","symbolSize":40,"category":"芭蕾史"},{"name":"乌兰诺娃","des":"列宁格勒培养的苏联芭蕾之神，《罗密欧与朱丽叶》戏诗兼备，访华演出影响深远。","symbolSize":40,"category":"芭蕾史"},{"name":"巴兰钦","des":"佳吉列夫团出身的格鲁吉亚人，赴美缔造NYCB，无情节交响芭蕾开新古典一派，作品逾四百部。","symbolSize":50,"category":"芭蕾史"},{"name":"纽约城市芭蕾舞团","des":"1948年巴兰钦与科斯坦创立，以速度、结构与音乐性立身，美国芭蕾的旗舰。","symbolSize":40,"category":"芭蕾史"},{"name":"英国皇家芭蕾","des":"1931年德·瓦卢瓦奠基塞德勒斯威尔斯，1956年获皇家封号，英式戏剧芭蕾重镇。","symbolSize":40,"category":"芭蕾史"},{"name":"阿什顿","des":"英式芭蕾的缔造者，《乡村一月》等长剧缠绵见性，为芳婷与努里耶夫量身排戏。","symbolSize":40,"category":"芭蕾史"},{"name":"玛戈·芳婷","des":"英国芭蕾第一名伶，与努里耶夫的世纪搭档跨越年龄与冷战，优雅的代名词。","symbolSize":40,"category":"芭蕾史"},{"name":"努里耶夫","des":"1961年自基洛夫剧团叛逃西方的鞑靼天才，重启男舞者的地位，兼以编导复排古典。","symbolSize":40,"category":"芭蕾史"},{"name":"罗兰·佩蒂","des":"马赛芭蕾当家人，《卡门》《年轻人与死神》把芭蕾拉入现代戏剧与流行文化。","symbolSize":40,"category":"芭蕾史"},{"name":"贝雅","des":"布鲁塞尔二十世纪芭蕾舞团主持，玄学倾向的编导，《波莱罗》一柱追光万人围观。","symbolSize":40,"category":"芭蕾史"},{"name":"红色娘子军","des":"1964年北京首演，娘子军连的枪舞与足尖并用，中国芭蕾民族化的第一声。","symbolSize":40,"category":"芭蕾史"},{"name":"白毛女","des":"1965年上海舞蹈学校首演，民歌与戏曲唱段入舞剧，与《娘子军》并称民族芭蕾双璧。","symbolSize":40,"category":"芭蕾史"},{"name":"现代舞","des":"20世纪初自欧美两端对古典芭蕾的反叛，赤足、呼吸与重心的解放，舞蹈回到表达本身。","symbolSize":50,"category":"现代舞与舞蹈剧场"},{"name":"邓肯","des":"赤足披希腊束袍起舞的美国人，从自然与酒神精神找灵感，自由舞与现代舞的精神源头。","symbolSize":50,"category":"现代舞与舞蹈剧场"},{"name":"圣丹尼斯","des":"受东方启发的独舞家，《罗陀》等作编织异域幻境，美国现代舞的先行者。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"泰德·肖恩","des":"美国现代舞的男性先驱，与圣丹尼斯共创丹尼肖恩学校，晚年组建全男班舞团。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"丹尼肖恩","des":"1915年建于洛杉矶的舞校与舞团，格蕾姆、韩芙莉、坎宁安皆出其门，美国现代舞的摇篮。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"玛莎·格蕾姆","des":"以呼吸为引擎创收缩与释放技术，《阿帕拉契亚之春》把美国现代舞推向巅峰。","symbolSize":50,"category":"现代舞与舞蹈剧场"},{"name":"韩芙莉","des":"格蕾姆同门，以倒地与回升的重心弧线立技术，《水的研究》见简洁的抽象。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"拉班","des":"匈牙利裔理论家，创拉班舞谱与力效理论，把动作分析升为科学，现代舞的理论之父。","symbolSize":50,"category":"现代舞与舞蹈剧场"},{"name":"拉班舞谱","des":"1928年问世的动作记谱体系，以方向符号与力效记录舞蹈，比美五线谱的立体书写。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"魏格曼","des":"拉班弟子，戴面具伴打击乐起舞的旗手，无音乐舞蹈与独舞剧场的先行者。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"德国表现舞蹈","des":"魏玛时代的Ausdruckstanz，重内心表现轻学院技术，与美式现代舞并峙的中欧路径。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"坎宁安","des":"格蕾姆团出身的革新者，掷签定序的偶然舞蹈与躯干技术，与凯奇共拆舞蹈旧结构。","symbolSize":50,"category":"现代舞与舞蹈剧场"},{"name":"后现代舞蹈","des":"1960年代纽约的反叛接力，日常动作、任务与即兴皆可入舞，解散舞蹈的既有定义。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"贾德森舞蹈剧院","des":"1962年起纽约贾德森教堂的实验聚会，伊冯娜·瑞纳宣言在册，后现代舞蹈的策源地。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"特丽莎·布朗","des":"积累编舞与墙壁绳索上的重力实验，把纯动作推到极简，后现代的白衣祭司。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"皮娜·鲍什","des":"1973年执掌乌帕塔尔舞蹈剧场，问题先于动作，哭与笑直接上台，重塑当代剧场。","symbolSize":50,"category":"现代舞与舞蹈剧场"},{"name":"舞蹈剧场","des":"Tanztheater：歌唱、说话、土与水皆入舞，皮娜把舞蹈与戏剧的边界彻底打开。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"穆勒咖啡馆","des":"1978年皮娜的自传性杰作，旋转玻璃门与歇斯底里的拥抱，反复重演的镇团之作。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"比尔·T·琼斯","des":"非裔编导，与艾滋年代短兵相接，《仍然在此》与逝者共舞，当代舞台的良知之声。","symbolSize":40,"category":"现代舞与舞蹈剧场"},{"name":"中国古典舞","des":"1950年代从戏曲身段与武术提炼、借芭蕾基训框架新建的舞种，东方身体美学的学科化。","symbolSize":50,"category":"中国古典舞与民族舞"},{"name":"戏曲身段","des":"京昆手眼身法步的程式宝库，云手山膀趟马卧鱼，中国古典舞取之不尽的母语库。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"身韵","des":"1980年代李正一、唐满城提炼的提沉冲靠含腆移与拧倾圆曲，古典舞从戏曲脱胎的内核。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"孙颖","des":"以文献与画像石复活古舞的学者型编导，创汉唐古典舞学派，《踏歌》一曲千年。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"汉唐古典舞","des":"孙颖从汉代画像与唐代遗韵重建的支派，斜塔重心与松胯之态，别树一帜的古典想象。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"丝路花雨","des":"1979年兰州首演，反弹琵琶的英娘复活敦煌壁画，新时期中国舞剧的报春花。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"敦煌舞","des":"自莫高窟壁画姿态整理的舞派，S形三道弯与手姿千变，敦煌学的身体分支。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"中国民族民间舞","des":"从乡土歌舞整理入院校的大学科，田野采集与课堂教材化并举，各民族舞台艺术的汇流。","symbolSize":50,"category":"中国古典舞与民族舞"},{"name":"戴爱莲","des":"侨居英国的华侨舞者，1946年边疆音乐舞蹈大会首展民族舞，中国民族民间舞学科奠基人。","symbolSize":50,"category":"中国古典舞与民族舞"},{"name":"贾作光","des":"从上海投奔内蒙古的编导，《牧马舞》《雁舞》奠定蒙古族舞蹈范式，人民舞蹈家。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"藏族舞蹈","des":"锅庄、弦子、堆谐三大系，屈伸颤膝重心下沉，松胯弓腰的高原体态自成体系。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"蒙古族舞蹈","des":"安代舞的炽烈与顶碗舞的沉稳，抖肩压腕马步绕臂，草原骑姿的身体记忆。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"维吾尔族舞蹈","des":"赛乃姆的灵动与刀郎的浑厚，扬眉动目移颈翻腕，西域乐舞的活化石。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"朝鲜族舞蹈","des":"长鼓击节鹤步轻盈，古格里长短的呼吸起伏，鹤柳并茂的延边风韵。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"傣族孔雀舞","des":"三道弯体态与手型模拟孔雀，毛相、刀美兰到杨丽萍的舞台化传承谱系。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"杨丽萍","des":"以《雀之灵》把孔雀舞化入云端，后以《云南映象》复活原生态歌舞的自家舞者。","symbolSize":50,"category":"中国古典舞与民族舞"},{"name":"雀之灵","des":"1986年全国舞蹈比赛夺魁的独舞，指尖与臂膀的孔雀开屏，一个时代的屏幕记忆。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"秧歌","des":"东北秧歌的浪、胶州秧歌的扭断腰、海阳秧歌的拈怪，汉族民间舞的最大种群。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"花鼓灯","des":"淮河岸边的兰花与鼓架子，溜起意得、风流洒脱的即兴对舞，汉族民间舞活态样本。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"中国舞剧","des":"从《宝莲灯》到民族芭蕾再到世纪之交大潮，东西语汇百年融汇的舞台史诗。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"只此青绿","des":"2021年周莉亚、韩真编导的舞蹈诗剧，青绿腰刷屏，宋画美学与古典身韵的破圈之作。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"永不消逝的电波","des":"2018年上海歌舞团的谍战舞剧，光影蒙太奇式叙事与舞蹈剧场手法，主旋律爆款。","symbolSize":40,"category":"中国古典舞与民族舞"},{"name":"社交舞","des":"从宫廷对舞、方块舞到舞厅双人舞的大流脉，拥抱位与即兴引带，社交本身即舞蹈。","symbolSize":50,"category":"社交舞与国标"},{"name":"华尔兹","des":"3/4拍旋转的圆舞，维也纳舞厅风暴的源头，拥抱位曾被视为伤风败俗，终成欧洲的舞蹈方言。","symbolSize":40,"category":"社交舞与国标"},{"name":"探戈","des":"19世纪末布宜诺斯艾利斯港区的庶民之舞，切分顿步与凝视，忧郁与傲慢的双人对话。","symbolSize":40,"category":"社交舞与国标"},{"name":"狐步舞","des":"以百老汇明星哈利·福克斯命名的滑行舞，快步舞从中分化，标准舞的骨架。","symbolSize":40,"category":"社交舞与国标"},{"name":"摩登舞","des":"华尔兹、探戈、狐步、快步、维也纳华尔兹五支，礼服长裙闭位持握的标准舞系。","symbolSize":40,"category":"社交舞与国标"},{"name":"拉丁舞","des":"伦巴、恰恰、桑巴、斗牛、牛仔五支，髋部律动与开式能量，拉美与伊比利亚的热情身体。","symbolSize":40,"category":"社交舞与国标"},{"name":"伦巴","des":"古巴起源的爱情之舞，慢而缠绵的髋部律动，拉丁舞中的抒情诗。","symbolSize":40,"category":"社交舞与国标"},{"name":"恰恰","des":"1950年代风行的古巴舞，紧凑俏皮的踏步与髋部弹动，派对里的糖果。","symbolSize":40,"category":"社交舞与国标"},{"name":"桑巴","des":"巴西狂欢节的灵魂，弹跳与骨盆摆动，狂欢节游行与舞厅的双重生命。","symbolSize":40,"category":"社交舞与国标"},{"name":"斗牛舞","des":"源自西班牙斗牛仪式的戏剧之舞，男如斗牛士女似斗篷，拉丁五支的表演性之最。","symbolSize":40,"category":"社交舞与国标"},{"name":"牛仔舞","des":"美国西部摇摆舞的拉丁化，弹跳腾跃与甩转，拉丁五支的欢乐终章。","symbolSize":40,"category":"社交舞与国标"},{"name":"黑池舞蹈节","des":"1920年起英格兰黑池冬季花园的年度盛典，国标舞世界的温布尔登。","symbolSize":40,"category":"社交舞与国标"},{"name":"国际标准舞","des":"英式规范化的摩登与拉丁十支舞竞技体系，分级考牌与赛场规则的世界语。","symbolSize":40,"category":"社交舞与国标"},{"name":"国标舞入华","des":"1980年代随改革开放登陆，先舞厅后赛场，如今体育舞蹈专业遍布艺术院校。","symbolSize":40,"category":"社交舞与国标"},{"name":"街舞","des":"1970年代从街区派对到剧场与奥运，freestyle与battle为魂的城市舞蹈总称。","symbolSize":50,"category":"街舞与当代舞台"},{"name":"嘻哈文化","des":"1970年代布朗克斯的DJ、MC、涂鸦与霹雳舞四大元素，街舞的文化母体。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"霹雳舞","des":"Breaking：摇滚步、地板排腿、大风车与冻结，B-boy的地板竞技，街舞的奠基舞种。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"Rock Steady Crew","des":"1979年纽约成立的B-boy传奇团体，1983年借电影《闪电舞》名扬世界。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"霹雳舞入奥运","des":"2024年巴黎奥运首次设项，B-girl与B-boy同台竞技，街头文化登堂入室。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"锁舞","des":"Locking：唐纳德·坎贝尔创于1970年代，funk律动中的急停锁点与喜剧表情。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"震感舞","des":"Popping：肌肉快速收缩的机器人美学，加州弗雷斯诺起源的电流与木偶。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"甩舞","des":"Waacking：1970年代洛杉矶同志酒吧的甩臂与造型，迪斯科年代的隐秘锋芒。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"浩室舞","des":"House：芝加哥浩室音乐孕育的脚步律动，footwork与loft里的即兴狂欢。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"爵士舞","des":"非洲散居动律经爵士乐时代成形，踢踏、剧场爵士到街头，百老汇的身体方言。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"鲍勃·福斯","des":"爵士帽与白手套的百老汇编导，《芝加哥》《歌厅》内收的性感与棱角式编舞签名。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"芝加哥","des":"1975年首演的黑色歌舞剧，杀手名媛与媒体马戏，2002年电影版横扫奥斯卡。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"K-pop编舞","des":"韩流工业的精密切分位编舞，1M等舞室带起全球翻跳潮，urban风潮的引擎。","symbolSize":40,"category":"街舞与当代舞台"},{"name":"舞蹈美学","des":"动作何以载情：模仿论、表现论与形式论的百年争执，舞蹈作为艺术的哲学辩护。","symbolSize":40,"category":"舞蹈理论与媒介"},{"name":"拉班动作分析","des":"以身体、空间、力效、形态四维解析动作的观察语言，训练、治疗与排练通用。","symbolSize":40,"category":"舞蹈理论与媒介"},{"name":"舞蹈人类学","des":"把舞蹈放回仪式与社群脉络的学科，从非洲鼓语到萨满跳神，文化中的身体研究。","symbolSize":40,"category":"舞蹈理论与媒介"},{"name":"舞蹈影像","des":"镜头作为编舞者：从录像时代到多媒体舞台，舞蹈与影像互为语法的身体书写。","symbolSize":40,"category":"舞蹈理论与媒介"},{"name":"舞者身体训练","des":"从把杆基训、交叉训练到损伤防护与生涯管理，身体既是乐器也是战场。","symbolSize":40,"category":"舞蹈理论与媒介"},{"name":"编舞法","des":"动机发展、时空间力组织与即兴到结构的路径，编舞从师徒口传到可教的方法论。","symbolSize":40,"category":"舞蹈理论与媒介"},{"name":"威廉·福赛斯","des":"法兰克福芭蕾的解构者，即兴技术与数字工具重写古典语汇，当代芭蕾的分水岭。","symbolSize":40,"category":"舞蹈理论与媒介"},{"name":"陶身体剧场","des":"陶冶2008年创立，以数位系列与圆运动体系著称，重复到极限的身体哲学。","symbolSize":40,"category":"舞蹈理论与媒介"}],"links":[{"source":"宫廷芭蕾","target":"舞蹈史","name":"起点","des":"文艺复兴宫廷的礼仪奇观。"},{"source":"皇后喜剧芭蕾","target":"宫廷芭蕾","name":"奠基","des":"1581年巴黎的鸿篇首演。"},{"source":"路易十四","target":"宫廷芭蕾","name":"亲演","des":"1653年《夜之芭蕾》的太阳王。"},{"source":"路易十四","target":"皇家舞蹈学院","name":"敕建","des":"1661年把芭蕾升为国家事业。"},{"source":"博尚","target":"皇家舞蹈学院","name":"主持","des":"厘定五位脚与基本手位。"},{"source":"皇家舞蹈学院","target":"舞蹈史","name":"制度化","des":"术语与教学自此标准化。"},{"source":"吕利","target":"路易十四","name":"御用","des":"掌王室音乐，创歌剧芭蕾。"},{"source":"吕利","target":"诺维尔","name":"先导","des":"歌剧芭蕾为情节芭蕾铺路。"},{"source":"诺维尔","target":"舞蹈史","name":"理论","des":"《舞蹈与舞剧书信集》倡情节芭蕾。"},{"source":"诺维尔","target":"浪漫主义芭蕾","name":"先声","des":"舞蹈讲戏的主张百年后开花。"},{"source":"浪漫主义芭蕾","target":"舞蹈史","name":"流派","des":"白裙与足尖的黄金时代。"},{"source":"玛丽·塔里奥尼","target":"仙女","name":"首演","des":"1832年巴黎歌剧院的轻盈传奇。"},{"source":"仙女","target":"浪漫主义芭蕾","name":"开山","des":"足尖技术与白纱裙由此定型。"},{"source":"玛丽·塔里奥尼","target":"浪漫主义芭蕾","name":"图腾","des":"空中舞者成为第一偶像。"},{"source":"吉赛尔","target":"浪漫主义芭蕾","name":"顶峰","des":"1841年人鬼情未了的悲情叙事。"},{"source":"古典芭蕾","target":"浪漫主义芭蕾","name":"继起","des":"中心从巴黎移至帝俄宫廷。"},{"source":"彼