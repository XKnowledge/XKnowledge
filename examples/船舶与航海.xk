{
  "version": 2,
  "title": "船舶与航海",
  "description": "从福船与克拉克到集装箱巨轮：帆装类型学、船体结构、导航术与经度之战，人类把文明装进船舱的六千年。",
  "nodes": [
    { "name": "船舶与航海", "des": "人类把文明装进船舱的六千年：从独木舟到集装箱巨轮，每一次远航都是对浮力、风与星辰的一次重新计算。", "symbolSize": 70, "category": "船体与结构" },
    { "name": "船体结构", "des": "龙骨、肋骨与壳板搭起的受力骨架，船是漂浮的梁，也是移动的建筑。", "symbolSize": 50, "category": "船体与结构" },
    { "name": "龙骨", "des": "沿船底纵贯的脊梁，铺设船体的第一根骨头，抗弯与稳性的根基。", "symbolSize": 40, "category": "船体与结构" },
    { "name": "水密隔舱", "des": "以横舱壁把船底分成互不通水的格子，中国的古老发明，让破舱不再等于沉船。", "symbolSize": 40, "category": "船体与结构" },
    { "name": "舵", "des": "汉代中国已用平衡舵操船，欧洲中世纪末才装上尾舵——方向这件事领先了一千年。", "symbolSize": 40, "category": "船体与结构" },
    { "name": "稳性与浮性", "des": "重心与浮心的拉锯：船既要立得稳，又要摆得回来，倾覆与复原的力学天平。", "symbolSize": 40, "category": "船体与结构" },
    { "name": "造船材料演进", "des": "木→铁→钢→铝合金与复合材料的四次换血，材料每升一级，船就大一圈。", "symbolSize": 40, "category": "船体与结构" },
    { "name": "干舷与载重线", "des": "船舷上的普利姆索尔线：吃水到此为止，贪婪装货的百年血案换来的六道刻度。", "symbolSize": 40, "category": "船体与结构" },
    { "name": "帆船", "des": "借风而行几千年的水上机器，帆装类型学是它自己的生物分类学。", "symbolSize": 50, "category": "帆装类型学" },
    { "name": "横帆与纵帆", "des": "横帆吃信风适于远洋，纵帆逆风机动擅长近海——两条演化路线的分工。", "symbolSize": 40, "category": "帆装类型学" },
    { "name": "单桅纵帆船", "des": "一桅一主帆加前帆的灵巧船型，今天休闲帆船的默认形态。", "symbolSize": 40, "category": "帆装类型学" },
    { "name": "斯库纳纵帆船", "des": "两桅以上的纵帆快船，操帆人少、转向灵活，北美海岸的勤务主力。", "symbolSize": 40, "category": "帆装类型学" },
    { "name": "卡拉维尔帆船", "des": "葡萄牙人的浅吃水探险船，三角帆与横帆混装，贴着非洲海岸一点点南下。", "symbolSize": 40, "category": "帆装类型学" },
    { "name": "克拉克帆船", "des": "高耸船楼的重货商船，大西洋贸易的驼队，也是海盗梦里的宝库。", "symbolSize": 40, "category": "帆装类型学" },
    { "name": "盖伦帆船", "des": "克拉克瘦身降重心的改良战商两用船，西班牙珍宝舰队的标准像。", "symbolSize": 40, "category": "帆装类型学" },
    { "name": "全帆装船", "des": "三桅以上全部横帆的满装风车，风帆时代的极速与极盛。", "symbolSize": 40, "category": "帆装类型学" },
    { "name": "飞剪式帆船", "des": "尖瘦船首的运茶快船，帆船时代最后的骄傲，与汽船赛跑着退出历史。", "symbolSize": 40, "category": "帆装类型学" },
    { "name": "索具与帆桁", "des": "静索定桅、动索控帆，一艘全帆装船的绳索是几公里长的神经网络。", "symbolSize": 40, "category": "帆装类型学" },
    { "name": "中国帆船", "des": "硬帆与平底的传统船系，以水密隔舱和平衡舵领先世界，泉州与广州是它的港口史诗。", "symbolSize": 50, "category": "中国帆船" },
    { "name": "福船", "des": "尖底吃深的南方海船，水密隔舱的受益者，海上丝路的的主力船型。", "symbolSize": 40, "category": "中国帆船" },
    { "name": "沙船", "des": "平底浅吃水的北方船型，滩涂不怕搁浅，长江口与漕运的老黄牛。", "symbolSize": 40, "category": "中国帆船" },
    { "name": "广船", "des": "岭南三桅海船，材坚骨硬，下南洋航线上的广东名片。", "symbolSize": 40, "category": "中国帆船" },
    { "name": "郑和宝船", "des": "永乐年间下西洋的巨型帅船，尺度至今争论不休，但木帆船时代的巅峰没有争议。", "symbolSize": 40, "category": "中国帆船" },
    { "name": "郑和下西洋", "des": "1405-1433 年七次远航的国家级航海工程，两万人的船队比哥伦布早八十七年出发。", "symbolSize": 40, "category": "中国帆船" },
    { "name": "蒸汽船", "des": "锅炉与明轮上船之后，风不再是唯一的动力，船期第一次可以印刷成时刻表。", "symbolSize": 50, "category": "动力革命" },
    { "name": "克莱蒙特号", "des": "富尔顿 1807 年在哈德逊河开通的班轮，蒸汽商船的第一次正经营运。", "symbolSize": 40, "category": "动力革命" },
    { "name": "明轮与螺旋桨", "des": "明轮怕浪、螺旋桨藏在水下，一场泰晤士河拔河赛把胜负拖进历史。", "symbolSize": 40, "category": "动力革命" },
    { "name": "大东方号", "des": "布鲁内尔 1858 年的六桅铁船，载客四千的早产巨兽，铺下了第一条大西洋电缆。", "symbolSize": 40, "category": "动力革命" },
    { "name": "汽轮机上船", "des": "帕森斯把蒸汽轮机装上小艇突袭 1897 年阅舰式，34 节航速惊动全场舰队。", "symbolSize": 40, "category": "动力革命" },
    { "name": "柴油机船", "des": "内燃机带来更高的热效率和更远的续航，二十世纪商船的通用心脏。", "symbolSize": 40, "category": "动力革命" },
    { "name": "核动力船舶", "des": "几年不换燃料的破冰船与舰船，动力与续航的极端答案。", "symbolSize": 40, "category": "动力革命" },
    { "name": "电力推进与吊舱", "des": "电动机直接驱动可回转的吊舱推进器，船第一次不需要舵和轴系。", "symbolSize": 40, "category": "动力革命" },
    { "name": "航海术", "des": "在无特征的海面上回答「我在哪、往哪走」的整套手艺。", "symbolSize": 50, "category": "导航术" },
    { "name": "天文导航", "des": "以太阳与恒星的高度角定纬度，天球是最古老的 GPS 卫星。", "symbolSize": 40, "category": "导航术" },
    { "name": "星盘与十字测天杆", "des": "量天测角的早期仪器，摇摇晃晃的甲板上只能信大概。", "symbolSize": 40, "category": "导航术" },
    { "name": "六分仪", "des": "1757 年定型的测角神器，镜与刻度弧把天体高度读到角分级，海员的传家宝。", "symbolSize": 40, "category": "导航术" },
    { "name": "航海罗盘", "des": "宋代中国先记下磁针指南，欧洲装上方位卡后，阴天黑夜的航行才有了方向感。", "symbolSize": 40, "category": "导航术" },
    { "name": "航位推算", "des": "从已知点用航向加航速累积位置，算错一节洋流就偏出几十海里的粗账。", "symbolSize": 40, "category": "导航术" },
    { "name": "航海图与波特兰海图", "des": "以港口为中心、恒向线织网的中世纪海图，羊毛与罗盘玫瑰的合谋。", "symbolSize": 40, "category": "导航术" },
    { "name": "测深与铅锤", "des": "系绳铅锤涂上牛油捞底泥，深度加底质，古代海员的指纹识别。", "symbolSize": 40, "category": "导航术" },
    { "name": "雷达与AIS", "des": "雷达看回波、AIS 报身份，雾夜与拥挤水道里的现代千里眼。", "symbolSize": 40, "category": "导航术" },
    { "name": "经度问题", "des": "纬度看太阳、经度看钟表：一座准到秒的船钟，值两万英镑的生死悬赏。", "symbolSize": 50, "category": "经度之战" },
    { "name": "月角距法", "des": "用月亮当天空的指针，算到星星的位置推经度——纯天文的解法，胜在笨重而可靠。", "symbolSize": 40, "category": "经度之战" },
    { "name": "约翰·哈里森", "des": "木匠出身的钟表匠，用四十年和五台钟表回答了牛顿都悲观的问题。", "symbolSize": 50, "category": "经度之战" },
    { "name": "H4航海钟", "des": "1761 年试航牙买加误差仅数秒的怀表式钟，机械航海的登顶之作。", "symbolSize": 40, "category": "经度之战" },
    { "name": "航海天文钟", "des": "从哈里森到批量生产的船钟：每一条远洋船上都有一只不许走错的心跳。", "symbolSize": 40, "category": "经度之战" },
    { "name": "风系与航线", "des": "信风、西风带与赤道无风带，帆船时代的公交通道全部由大气环流规划。", "symbolSize": 40, "category": "风与航线" },
    { "name": "季风航线", "des": "印度洋上冬夏换向的信风，养出了从阿拉伯到泉州的整条贸易链条。", "symbolSize": 40, "category": "风与航线" },
    { "name": "好望角航线", "des": "绕过风暴角直通印度洋，欧洲船第一次闻到胡椒的产地味。", "symbolSize": 40, "category": "风与航线" },
    { "name": "环球航行", "des": "麦哲伦-埃尔卡诺船队 1519-1522 年用三年证明海是连通的，二百六十人出发十八人回家。", "symbolSize": 40, "category": "风与航线" },
    { "name": "西北与东北航道", "des": "欧亚与北美高纬度的冰间捷径，帆船时代的执念，全球变暖时代的新生意。", "symbolSize": 40, "category": "风与航线" },
    { "name": "集装箱革命", "des": "麦克莱恩 1956 年把卡车上吊箱搬上船，全球贸易成本骤降的真正引擎。", "symbolSize": 50, "category": "现代船舶" },
    { "name": "巴拿马型", "des": "运河船闸的尺寸反过来规定船的宽窄：海运标准化的最直白注脚。", "symbolSize": 40, "category": "现代船舶" },
    { "name": "超级油轮", "des": "三十万吨级的海上油库， VLCC 与 ULCC，把原油运费压到近乎忽略。", "symbolSize": 40, "category": "现代船舶" },
    { "name": "LNG船", "des": "零下 163 度的薄膜冷库，造船业皇冠上的明珠，殷瓦钢焊接的极限工艺。", "symbolSize": 40, "category": "现代船舶" },
    { "name": "球鼻艏", "des": "水线下前伸的球形鼻，与船波互相抵消，省油一成的流体力学魔法。", "symbolSize": 40, "category": "现代船舶" },
    { "name": "邮轮", "des": "从跨洋班轮到海上度假村，客运船在飞机夺走航线后的华丽转行。", "symbolSize": 40, "category": "现代船舶" },
    { "name": "船舶设计现代化", "des": "拖曳水池、计算流体力学与结构有限元，造船从放样直觉走进数字孪生。", "symbolSize": 40, "category": "现代船舶" },
    { "name": "泰坦尼克号", "des": "1912 年的永不沉没之船撞冰山沉没，一千五百人的代价重写了海上安全规则。", "symbolSize": 50, "category": "海难与安全" },
    { "name": "SOLAS公约", "des": "泰坦尼克之后签下的海上人命安全公约，救生艇、水密门与无线电值守的全球底线。", "symbolSize": 40, "category": "海难与安全" },
    { "name": "救生设备", "des": "救生艇、救生筏与浸水服：全员撤离能力是船舶设计的硬指标。", "symbolSize": 40, "category": "海难与安全" },
    { "name": "国际海事组织", "des": "海上联合国的立法机构，公约与规则的集散地。", "symbolSize": 40, "category": "海难与安全" },
    { "name": "现代航运体系", "des": "船级社、港口国监督与船员公约：一张覆盖全球的航运治理网。", "symbolSize": 40, "category": "海难与安全" }
  ],
