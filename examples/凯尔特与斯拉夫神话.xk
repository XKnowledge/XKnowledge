    { "source": "库丘林", "target": "阿尔斯特故事圈", "name": "主角", "des": "战犬之怒是整个故事圈的引擎。" },
    { "source": "康纳尔王", "target": "阿尔斯特故事圈", "name": "舞台中心", "des": "王庭与红枝骑士是故事的发生地。" },
    { "source": "康纳尔王", "target": "库丘林", "name": "庇护", "des": "国王收养了少年英雄于宫廷。" },
    { "source": "摩瑞甘", "target": "库丘林", "name": "拒爱", "des": "女神示爱遭拒，此后处处与英雄为敌。" },
    { "source": "库丘林之死", "target": "库丘林", "name": "终局", "des": "绑立石上，至死不倒。" },
    { "source": "摩瑞甘", "target": "库丘林之死", "name": "乌鸦", "des": "仇敌见乌鸦落于英雄肩头，方信他已死。" },
    { "source": "德希丽", "target": "康纳尔王", "name": "强婚与逃亡", "des": "国王欲纳为妃，女子夜遁，战火因此延烧三国。" },
    { "source": "芬恩·麦克库尔", "target": "菲安那骑士团", "name": "首领", "des": "猎人诗人统领的精锐猎团。" },
    { "source": "智慧鲑鱼", "target": "芬恩·麦克库尔", "name": "拇指之知", "des": "吮一口烫伤的拇指，真相尽知。" },
    { "source": "芬恩·麦克库尔", "target": "奥辛", "name": "父子", "des": "老英雄最疼爱的诗人之子。" },
