{
  "version": 2,
  "title": "凯尔特与斯拉夫神话",
  "description": "从爱尔兰的仙丘到黑海的橡林，两个前基督教欧洲的口传世界：图哈德达南的神族与化外之民的异界，雷神佩伦的雷霆与家宅精灵的炉火，在基督教的晨光降临后退入民间故事的褶皱。",
  "nodes": [
    { "name": "凯尔特与斯拉夫神话", "des": "欧洲最西北与最东端的两大口传体系，一边是精灵与异界的凯尔特世界，一边是雷神与家宅之灵的斯拉夫原野，都未留下自己的经书，都在基督教化后转入民俗的暗河。", "symbolSize": 70, "category": "图哈德达南神族" },
    { "name": "凯尔特神话", "des": "从不列颠群岛到高卢的口传世界，没有经书与神庙，神谱活在吟游诗人的舌尖，最终由修道院抄本与民间精灵传说两层载体流传至今。", "symbolSize": 60, "category": "图哈德达南神族" },
    { "name": "图哈德达南", "des": "达努女神的部族，乘雾登陆爱尔兰的第五批居民，败于人类先祖米尔后退入地下坟丘，成了后世的精灵之民。", "symbolSize": 50, "category": "图哈德达南神族" },
    { "name": "达努女神", "des": "神族之母，名字意为「流」，部族以她为名，自身却几乎不留故事，是凯尔特母神信仰留下的最深的影子。", "symbolSize": 40, "category": "图哈德达南神族" },
    { "name": "达格达", "des": "「善神」兼丰饶之主，持一柄大到能拖出壕沟的巨棒，一口永不空的魔锅，粗鄙而慷慨，是神族里父亲般的存在。", "symbolSize": 60, "category": "图哈德达南神族" },
    { "name": "摩瑞甘", "des": "战争与命运的三相女神，在战场上化作乌鸦掠过，既挑动战火又预言结局，洗濯阵亡者的征袍是她最著名的身影。", "symbolSize": 50, "category": "图哈德达南神族" },
    { "name": "卢格", "des": "「长手」之多能神，一人身兼木匠、铁匠、诗人与战士诸艺，以子弟身份率神族决战混沌，萨温时节的集会以他为名。", "symbolSize": 50, "category": "图哈德达南神族" },
    { "name": "布里吉德", "des": "火、诗歌与工艺的女神，达格达之女，圣火与圣泉皆归于她，基督教化后化身为圣布里吉德，信仰几乎无缝续存。", "symbolSize": 40, "category": "图哈德达南神族" },
    { "name": "努阿达", "des": "神族首任王，战役中失臂而依例让位，装上银手重获王权，「银手努阿达」成了残而不失其位的不朽象征。", "symbolSize": 40, "category": "图哈德达南神族" },
    { "name": "马南南", "des": "海洋之神与异界渡口的守卫，驾马车驰于海面如行平地，他的迷雾与海市是凡人抵达彼岸之境的必经之门。", "symbolSize": 40, "category": "图哈德达南神族" },
    { "name": "郭伊纽", "des": "神族锻造师与战力担当，怒刃与其锻造的无坚不摧之枪皆出其手，传说连奥格姆字母也归功于这位臂力惊人的神。", "symbolSize": 40, "category": "图哈德达南神族" },
    { "name": "迪安·凯赫特", "des": "神族医神，与儿女同施「检伤之泉」，阵亡者浸泉一夜即复活重列战阵，是神话里最早的战地医疗体系。", "symbolSize": 40, "category": "图哈德达南神族" },
    { "name": "弗摩里安族", "des": "自深海而来的混沌巨人族，独眼、独足或羊首人身，是秩序神族的天敌，其邪眼之王令众生闻风胆寒。", "symbolSize": 50, "category": "图哈德达南神族" },
    { "name": "布雷斯", "des": "神族与弗摩里人的混血，仪表完美却吝啬刻薄，短暂的统治以苛税与羞辱告终，成了「明君」的反面教材。", "symbolSize": 40, "category": "图哈德达南神族" },
    { "name": "巴洛尔", "des": "弗摩里族的邪眼之王，目光所及无不焦土，眼睑需数人撬开，最终死于外孙卢格之手，预言的闭环严丝合缝。", "symbolSize": 40, "category": "图哈德达南神族" },
    { "name": "莫伊图拉之战", "des": "秩序与混沌的总决战，卢格以投石索击穿巴洛尔邪眼，神族惨胜，山海从此各归其位。", "symbolSize": 40, "category": "图哈德达南神族" },
    { "name": "异界", "des": "凯尔特信仰的核心观念：与人间叠合的另一重时空间，快乐与青春永驻，而时间法则残酷地不对等——那里一年，人间百载。", "symbolSize": 50, "category": "异界与精灵谱系" },
    { "name": "提尔纳诺格", "des": "「青春之乡」，西海之上的异界之岛，无病无老无死，是最著名的彼岸乐土，也是英雄奥辛一去三百年的地方。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "化外之民", "des": "居于坟丘与荒野的精灵部族，退入地下的旧神族后裔，既施援手也索敬奉，冒犯他们的人家会遭厄运缠身。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "仙丘", "des": "精灵的居所——青草覆盖的古坟冢，白雾缭绕时内有宫室与乐舞，是异界在人间最直接的入口。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "米迪尔", "des": "异界王子，达格达之子，迎娶美女伊塔因后又遭夺妻，跨过三次转世寻回爱人，痴心与神通同样绵长。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "伊塔因", "des": "以美貌闻名的女神，遭妒化为蝴蝶随风飘零，转世为人间公主后再嫁仙丘，命途如蝶翼般辗转。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "银枝", "des": "银白树枝结金苹果，摇动时患者痊愈、伤者止痛，是异界向凡人发出的邀约信物，持枝者将受邀入境。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "异界禁忌", "des": "彼岸的规矩：不可携带泥土、不可食异界之果、不可回头张望，破戒者或被永远留下，或如奥辛般瞬间老去。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "报丧女妖", "des": "梳着银梳、夜半哀哭的精灵女子，哭声预告族中死讯，只附于古老家族，是爱尔兰最家喻户晓的精灵。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "无头骑士", "des": "腋夹头颅的死亡信使，夜驰于乡道，一声喊出姓名者即死，是美国「沉睡谷」传说的直接祖先。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "矮妖", "des": "红衣绿帽的独居鞋匠精灵，鞋匠锤声可循，藏有金币的陶罐藏于彩虹尽头，被捉时以三愿换自由。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "水马", "des": "湖泊与激流中的变形马灵，背脊倒生、黏人拖溺，苏格兰高地至今立牌警示游人提防水边的美马。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "海豹女", "des": "脱下海豹皮即成绝色女子，皮被藏起便留居人间为妻，寻回皮的那天，她必义无反顾地重返大海。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "普卡", "des": "夜行变形精灵，化黑马驮人狂奔或化山羊预言丰歉，亦正亦邪，英语「吓唬」一词由它得名。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "调包婴孩", "des": "精灵偷走人类婴孩、留下面色蜡黄的替身，以蛋壳与草药试探真伪，是旧时解释病婴的民间答案。", "symbolSize": 40, "category": "异界与精灵谱系" },
    { "name": "库丘林", "des": "阿尔斯特的战神之子，少年持犬名、成年持魔枪，暴怒时周身扭曲如神魔附体，是凯尔特最烈的英雄悲剧。", "symbolSize": 60, "category": "凯尔特英雄史诗" },
    { "name": "阿尔斯特故事圈", "des": "以康纳尔宫廷为中心的英雄故事群，红枝骑士的荣耀、诅咒与倾覆，被称为爱尔兰的《伊利亚特》。", "symbolSize": 50, "category": "凯尔特英雄史诗" },
    { "name": "康纳尔王", "des": "阿尔斯特之王，红枝骑士的领袖，宫廷即英雄故事的舞台，一生的荣耀最终被悲剧的诅咒尽数收走。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "德希丽", "des": "「爱尔兰的海伦」，未嫁先见凶兆的绝色女子，强婚与逃亡引发三国战火，自尽前唱出的哀歌传诵至今。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "库丘林之死", "des": "英雄的终点：遭盟友围攻身负死伤，自绑于立石保持站姿赴死，仇敌许久不敢近前，直到乌鸦落上肩头。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "芬恩·麦克库尔", "des": "猎人、诗人与战士的合体，菲安那骑士团的首领，尝智慧鲑鱼之脂而得千里通明，是爱尔兰民间最亲民的英雄。", "symbolSize": 50, "category": "凯尔特英雄史诗" },
    { "name": "菲安那骑士团", "des": "护卫爱尔兰王的精锐猎团，入团须通过诗歌与武艺的双重考验，其兴衰故事自成一部「骑士团故事圈」。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "智慧鲑鱼", "des": "食智慧榛果的鲑鱼，烤制时芬恩吮吸拇指烫伤处，从此拇指含于口中即可获知真相，是「拇指之知」的来历。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "奥辛", "des": "芬恩之子，诗人骑士，随金发公主娜姆旅居青春之乡三百年，思乡落地瞬间白头，向圣帕特里克唱尽旧世界。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "娜姆", "des": "提尔纳诺格的金发公主，骑白马踏海而来带走奥辛，赠马的叮嘱只有一句：双足不可沾爱尔兰的土。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "马比诺吉昂", "des": "威尔士中世纪故事集，四大分支勾连成网，神的儿女在其中渐成英雄，是凯尔特神话的威尔士另一支源头。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "皮威尔与里安农", "des": "首分支：王子误入异界王国赢得宝座，返回后迎娶会唱歌唤鸟的王后里安农，冤屈与和解贯穿其一生。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "布兰文", "des": "威尔士公主远嫁爱尔兰，受辱致两国倾覆，哥哥的巨型身躯横渡海峡充当桥梁，史称「不列颠的三次浩劫」之一。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "圭迪昂", "des": "马比诺吉昂的巫师英雄，吟唱攻城、偷猪拐人、造花成妇，以魔法与计谋推动各分支的走向。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "布洛德薇丝", "des": "以橡花、荆豆与草坪所造之妻，被造出却未曾被问意愿，背叛之后遭罚化为猫头鹰，永夜独鸣。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "特里斯坦与伊索尔德", "des": "康沃尔骑士与爱尔兰公主的禁恋，误饮情药而不能回头，悲剧内核早于圆桌故事，是凯尔特禁恋母题的巅峰。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "亚瑟王", "des": "从凯尔特战士歌谣里的抗撒克逊首领，长成圆桌与圣杯的中心，是凯尔特英雄传统在中世纪浪漫化后的最大遗产。", "symbolSize": 40, "category": "凯尔特英雄史诗" },
    { "name": "德鲁伊", "des": "凯尔特的祭司、法官与学者阶层，执掌献祭、天文与口传知识，白袍执金镰收割槲寄生是其最经典的剪影。", "symbolSize": 50, "category": "德鲁伊与节祭" },
    { "name": "斐里德", "des": "接替德鲁伊的诗人阶层，以韵律背诵族谱与故事，地位仅次于王，直到十七世纪仍是盖尔语社会的记忆中枢。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "萨温节", "des": "凯尔特年的岁首，11 月 1 日前夜，生者与异界之间的门扉大开，亡灵与精灵成群还乡，是万圣节的直系祖先。", "symbolSize": 50, "category": "德鲁伊与节祭" },
    { "name": "万圣节前夜", "des": "萨温节基督教化后的名字，诸圣节的前夜，南瓜灯、化装与「不给糖就捣蛋」皆由精灵还乡的旧俗演变而来。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "因贝克节", "des": "2 月 1 日的初春节祭，母羊泌乳、大地解冻，献祭火与诗歌女神布里吉德，今日爱尔兰仍过圣布里吉德节。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "贝尔坦节", "des": "5 月 1 日的夏日之门，驱畜群穿行双篝火以净疫祈福，山间点起的贝尔坦篝火至今仍在爱丁堡年年复燃。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "卢格纳萨节", "des": "8 月 1 日的收获节庆，以多能神卢格为名，集市、比武与初熟献祭同场，是凯尔特四节中最热闹的一日。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "槲寄生", "des": "橡树上的白果寄生枝，德鲁伊以金镰割下、白牛承接，视其为万灵药与避邪圣物，砍伐须在特定月相与时辰。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "柳人", "des": "柳条编成的巨型人像，传说中盛满活人献祭于火，凯撒笔下的记载令罗马人也为之战栗，真实规模至今存疑。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "三相女神", "des": "凯尔特信仰对「三」的执念：少女、母亲与老妪同体，摩瑞甘三姐妹、布里吉德三艺皆是这一观念的显形。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "奥格姆字母", "des": "刻在石缘与木杖上的早期爱尔兰文字，每字数道刻痕，以神郭伊纽命名，至今存留四百余块铭文石碑。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "纽格莱奇墓", "des": "比金字塔更古老的通道墓，冬至清晨阳光沿甬道精准射入墓室十七分钟，是异界观与天文历法叠合的巨石见证。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "圣帕特里克", "des": "5 世纪的爱尔兰传教士，与德鲁伊斗法显圣的传说层层堆叠，神话并未被他终结，而是经他之手被抄本收留。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "修道院抄录", "des": "基督教修士以文字笔录口传神话，动机存疑却功不可没——凯尔特诸神因此免于湮灭，换上神谱的衣装活到今天。", "symbolSize": 40, "category": "德鲁伊与节祭" },
    { "name": "斯拉夫神话", "des": "从波罗的海到黑海的森林与原野间流传的信仰体系，雷神与家宅之灵各司其职，未曾写下经文，在第九世纪受洗后散入民俗。", "symbolSize": 60, "category": "斯拉夫神谱" },
    { "name": "佩伦", "des": "雷霆与战争至高神，鹰目银髯，执斧驾石车行于橡树之巅，誓言「以佩伦之名」至今仍在斯拉夫语言中回响。", "symbolSize": 60, "category": "斯拉夫神谱" },
    { "name": "维列斯", "des": "冥界、牲畜、财富与诗的守护者，蟒蛇形体的神，居于世界树根部与水底，与雷神的争斗是斯拉夫神话的主轴。", "symbolSize": 50, "category": "斯拉夫神谱" },
    { "name": "佩伦与维列斯之争", "des": "雷神追击偷牛的蛇神，闪电即投掷的斧钺，雷雨过后「维列斯的蹄印」——泥洼——遍布原野，是秩序与混沌的永恒拉锯。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "罗德", "des": "造物与家族繁衍的至高之父，织出生命之线，与命运女神罗莎尼察同受家宅供奉，是家祖崇拜的神格化源头。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "罗莎尼察", "des": "命运与产妇的护佑女神，常成双出现，在新生儿枕边织定其一生的运势，民间以蜂蜜与面包敬奉。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "斯瓦罗格", "des": "天火与锻造之神，以神钳自天上夹出第一柄犁铧与第一柄宝剑，是冶铁时代信仰投射到天穹的匠神。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "达日博格", "des": "太阳神，「白光的赐予者」，斯瓦罗格之子，乘金色马车昼行天空，东斯拉夫人自称为「达日博格的子孙」。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "莫科什", "des": "大地、纺织与女性劳作的守护女神，湿手纺线、干手织布，基辅万神殿中唯一的女神，至今活在「莫科什婆婆」的乡野形象里。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "亚里洛", "des": "春之生机的神格，白衣白马穿行田野唤醒草木，盛大春祭之后又被仪式性地哀葬，死而复生年复一年。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "玛列娜", "des": "冬与死亡的女神，亚里洛的对偶，稻草扎成她的偶人在初春焚烧或沉河，送走寒冬的仪式至今留存于乡野。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "基辅万神殿", "des": "公元 980 年弗拉基米尔大公在基辅山冈立起的六神神像，佩伦居首，是斯拉夫异教唯一一次「官方认证」。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "受洗与神像沉河", "des": "988 年罗斯受洗，佩伦神像被鞭笞后抛入第聂伯河，沿岸民众沿河呼喊旧神之名，送了最后一程。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "双重信仰", "des": "「正教的十字与家宅的精灵各拜各的」，斯拉夫世界在受洗后数百年间圣像与咒术并行的独特宗教景观。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "雷神与以利亚", "des": "佩伦未亡，只是改名——先知以利亚乘火马雷霆车升天，民间顺势把雷神的雷霆、橡树与斧钺全都转赠给他。", "symbolSize": 40, "category": "斯拉夫神谱" },
    { "name": "多莫沃伊", "des": "住在灶台后面的家宅精灵，蓬毛小老头，善则护宅安畜，怒则夜里掐人脖颈，迁居时须以旧灶火引他同行。", "symbolSize": 50, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "家祖崇拜", "des": "斯拉夫信仰的底层：祖灵护佑后代、后人敬献饭食，罗德与罗莎尼察是其在神谱上的投影，多莫沃伊是其在家中现形的子孙。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "莱希", "des": "森林之主，绿须右翻的外衣穿反即人非人，可任意改变身高，牧狼护林，迷路者把鞋左右换穿方能逃出他的领域。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "沃佳诺伊", "des": "水塘与河湾的老水灵，绿须覆面、鱼尾带鳞，坐镇磨坊水轮旁，磨坊主定期献猪供奉，否则他掀闸毁磨。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "波列维克", "des": "正午时分现身麦田的田野精灵，从脚到头不一的怪身高，护田也惩怠惰，农人午间在田头留一撮麦穗与清水敬他。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "卢萨卡", "des": "溺亡少女化成的水中女魂，芦苇间梳着她未及梳完的长发，歌声勾人入水，也偶有报恩救人的温柔传说。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "薇拉", "des": "山巅与泽地的美丽精灵，善歌舞、通医术，激怒时以风暴回应，与南斯拉夫的维拉同名同源。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "正午女妖", "des": "烈日正午在麦田游荡的女灵，遇之者被灼热的问题逼问到疯癫，农人被告诫：正午莫下地，睡意是她的同谋。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "芭芭雅嘎", "des": "鸡腿木屋里的食人老妖婆，篱笆缀满骷髅，既吞噬闯入者也试炼勇者，赠人以火种与指点，是生死门槛的守门者。", "symbolSize": 50, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "科谢伊", "des": "「不死的」枯瘦巫王，死亡藏于针、针藏于蛋、蛋藏于鸭、鸭藏于兔、兔藏于箱、箱悬于橡树——套娃式的死亡迷宫。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "火鸟", "des": "羽翼发光的金鸟，一根燃焰的羽毛足以照亮整座宫殿，它的追寻永远引来灾祸与机缘并行的连环冒险。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "伊凡王子", "des": "俄罗斯故事里最年轻的王子，两个兄长精明却平庸，憨直的他带着一根羽毛出发，反而走完所有奇迹。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "灰狼", "des": "会说话的狼灵助手，驮着伊凡穿行三重王国，吃掉的马匹化为永久的坐骑，是故事里比主角更可靠的盟友。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "瓦西丽萨", "des": "「美丽的」孤女，带着母亲的布娃娃深入黑森林借火，在芭芭雅嘎的磨坊里完成筛谷、分种、纺线的三重试炼。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" },
    { "name": "库帕拉之夜", "des": "夏至前夜的水火之祭：少女放花环卜姻缘，恋人跃过篝火寻蕨花，是萨温节在斯拉夫世界的姊妹节日。", "symbolSize": 40, "category": "斯拉夫精怪与家宅信仰" }
  ],
  "links": [
    { "source": "凯尔特与斯拉夫神话", "target": "凯尔特神话", "name": "西翼", "des": "不列颠群岛与高卢的精灵世界。" },
    { "source": "凯尔特与斯拉夫神话", "target": "斯拉夫神话", "name": "东翼", "des": "森林与原野上的雷神与家宅之灵。" },
    { "source": "凯尔特与斯拉夫神话", "target": "修道院抄录", "name": "西翼载体", "des": "凯尔特神话靠修道院抄本传世。" },
