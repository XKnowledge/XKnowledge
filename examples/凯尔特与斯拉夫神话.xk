    { "source": "凯尔特神话", "target": "马比诺吉昂", "name": "威尔士支流", "des": "同一神话大树的不列颠分枝。" },
    { "source": "凯尔特神话", "target": "亚瑟王", "name": "后世流变", "des": "凯尔特战士传统浪漫化的终点。" },
    { "source": "凯尔特神话", "target": "萨温节", "name": "岁时中枢", "des": "以岁首节祭为轴的凯尔特年轮。" },
    { "source": "图哈德达南", "target": "达努女神", "name": "命名", "des": "「达努女神的部族」——母亲之名覆盖全族。" },
    { "source": "达格达", "target": "图哈德达南", "name": "首领", "des": "执棒掌锅的父神，神族的主心骨。" },
    { "source": "达格达", "target": "布里吉德", "name": "父女", "des": "火与诗的女神出自丰饶之主。" },
    { "source": "达格达", "target": "郭伊纽", "name": "锻器", "des": "神族三神器皆出锻造师之炉。" },
    { "source": "摩瑞甘", "target": "达格达", "name": "伴侣", "des": "战争女神与丰饶之主的结合。" },
    { "source": "摩瑞甘", "target": "三相女神", "name": "显形", "des": "摩瑞甘三姐妹即三相观念的代表。" },
    { "source": "布里吉德", "target": "三相女神", "name": "显形", "des": "诗歌、锻造与医道三艺亦是三相。" },
    { "source": "卢格", "target": "图哈德达南", "name": "入列", "des": "萨温集会上一技压群匠，赢得席位。" },
    { "source": "卢格", "target": "布雷斯", "name": "接替", "des": "暴君被逐，多能神临危受命。" },
    { "source": "卢格", "target": "巴洛尔", "name": "外孙弑祖", "des": "预言说巴洛尔将死于外孙之手，他囚女防患，终未逃过。" },
    { "source": "努阿达", "target": "图哈德达南", "name": "首任王", "des": "银手之王是神族王统的开端。" },
    { "source": "郭伊纽", "target": "努阿达", "name": "银手", "des": "医神续骨、锻师造手，王权失而复得。" },
    { "source": "迪安·凯赫特", "target": "努阿达", "name": "医治", "des": "断臂之王在他的检伤之泉里重获战斗力。" },
    { "source": "马南南", "target": "图哈德达南", "name": "海界守护", "des": "海上迷雾与海市是他的防线。" },
    { "source": "马南南", "target": "异界", "name": "渡口", "des": "赴异界者须经海神的领海。" },
    { "source": "弗摩里安族", "target": "布雷斯", "name": "血统", "des": "半神半魔的混血国王出自两个敌对阵营。" },
    { "source": "布雷斯", "target": "图哈德达南", "name": "苛政", "des": "在位期间的神族受尽课税与羞辱。" },
    { "source": "布雷斯", "target": "努阿达", "name": "让位与复辟", "des": "银手王残缺让位，复原后重执王柄。" },
    { "source": "巴洛尔", "target": "弗摩里安族", "name": "邪眼之王", "des": "混沌巨人的最强统帅。" },
    { "source": "莫伊图拉之战", "target": "图哈德达南", "name": "决战一方", "des": "神族倾巢而出。" },
    { "source": "莫伊图拉之战", "target": "弗摩里安族", "name": "决战一方", "des": "深海混沌部族压境。" },
    { "source": "卢格", "target": "莫伊图拉之战", "name": "统帅", "des": "投石索掷出的石子终结了邪眼。" },
    { "source": "巴洛尔", "target": "莫伊图拉之战", "name": "邪眼", "des": "眼睑撬开的瞬间，目光烧向自家军阵。" },
    { "source": "达格达", "target": "莫伊图拉之战", "name": "巨棒", "des": "一棒九人，拖地成壕。" },
    { "source": "摩瑞甘", "target": "莫伊图拉之战", "name": "预言", "des": "战前吟唱胜负，战后宣告和平。" },
    { "source": "图哈德达南", "target": "化外之民", "name": "退居地下", "des": "败于人类先祖后，神族退入坟丘成为精灵。" },
    { "source": "异界", "target": "提尔纳诺格", "name": "乐土", "des": "西海青春之乡是异界最耀眼的别名。" },
    { "source": "异界", "target": "化外之民", "name": "居民", "des": "彼岸世界由旧神后裔栖居。" },
    { "source": "化外之民", "target": "仙丘", "name": "居所", "des": "青草坟冢之下别有宫室。" },
    { "source": "仙丘", "target": "纽格莱奇墓", "name": "原型", "des": "五千年前巨石时代的通道墓是仙丘想象的源头。" },
    { "source": "异界", "target": "银枝", "name": "信物", "des": "持银枝者即受彼岸之邀。" },
    { "source": "异界", "target": "异界禁忌", "name": "规则", "des": "入境享乐易，全身而退还难。" },
    { "source": "米迪尔", "target": "异界", "name": "王子", "des": "彼岸王庭的贵胄，达格达血脉。" },
    { "source": "米迪尔", "target": "伊塔因", "name": "三世寻妻", "des": "妒妇化她为蝶，他跨过两次转世把她寻回。" },
    { "source": "达格达", "target": "米迪尔", "name": "父子", "des": "异界王子出自丰饶之主。" },
    { "source": "达格达", "target": "异界", "name": "宝锅", "des": "永不空的大锅是异界丰饶的缩影。" },
    { "source": "报丧女妖", "target": "化外之民", "name": "出身", "des": "哀哭的预言者出自精灵部族。" },
    { "source": "报丧女妖", "target": "德希丽", "name": "哀歌", "des": "绝色女子赴死前的长歌与其呼应，皆以歌声预告死亡。" },
    { "source": "无头骑士", "target": "异界", "name": "死亡信使", "des": "夜驰的骇人骑士来自彼岸的差遣。" },
    { "source": "矮妖", "target": "化外之民", "name": "鞋匠", "des": "独居的精灵匠人，锤声可循。" },
    { "source": "水马", "target": "异界", "name": "水中之门", "des": "湖泊激流是彼岸在人间开口的地方。" },
    { "source": "海豹女", "target": "异界", "name": "海界", "des": "脱皮变形的女子来自海底彼岸。" },
    { "source": "普卡", "target": "异界", "name": "夜行", "des": "变形精灵巡行于两界边缘。" },
