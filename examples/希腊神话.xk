{
  "version": 2,
  "nodes": [
    { "name": "希腊神话", "des": "从卡俄斯的虚空到奥林匹斯的雷火，神与英雄的谱系在此铺展，本图一切叙事由此生发。", "symbolSize": 70, "category": "创世与泰坦世家" },
    { "name": "卡俄斯", "des": "最先存在的虚空，无父无母、无边无形，夜与冥暗自其中悄然分离，万物之先的黑暗。", "symbolSize": 40, "category": "创世与泰坦世家" },
    { "name": "盖亚", "des": "大地母神，独自诞下天空与海洋，再与天空生出泰坦诸神，是全部神谱向下铺展的根。", "symbolSize": 60, "category": "创世与泰坦世家" },
    { "name": "乌拉诺斯", "des": "最古老的天空之神，盖亚之子亦成其配偶，惧怕子女篡位，将他们尽数压回大地母腹。", "symbolSize": 50, "category": "创世与泰坦世家" },
    { "name": "蓬托斯", "des": "不经交合而成于盖亚的沧海本体，孕育海中诸怪与海中老人，是波塞冬王国的古老地基。", "symbolSize": 40, "category": "创世与泰坦世家" },
    { "name": "尼克斯", "des": "黑夜女神，自卡俄斯直接而生，诞下命运、死亡、复仇与欺骗，连宙斯也对她礼让三分。", "symbolSize": 40, "category": "创世与泰坦世家" },
    { "name": "厄洛斯", "des": "原始爱欲，创世最初的推动之力，令大地与天空相拥相合，诸神与万物由此得以繁衍。", "symbolSize": 40, "category": "创世与泰坦世家" },
    { "name": "克罗诺斯", "des": "泰坦之王，以镰刀阉父夺位，又惧同样的预言而吞噬亲生儿女，终被幼子宙斯锁入深渊。", "symbolSize": 60, "category": "创世与泰坦世家" },
    { "name": "瑞亚", "des": "泰坦之后，不忍儿女接连被吞，以襁褓裹石瞒过丈夫，救下日后执掌雷霆的幼子宙斯。", "symbolSize": 40, "category": "创世与泰坦世家" },
    { "name": "普罗米修斯", "des": "先知先觉的泰坦后裔，以芦苇秆盗天火予凡人，被锁于高加索山崖，受鹰啄肝之刑万载。", "symbolSize": 50, "category": "创世与泰坦世家" },
    { "name": "潘多拉", "des": "诸神合力造出的第一个女人，携魔盒降临人间，盒盖开启灾祸四散，唯希望留于盒底。", "symbolSize": 40, "category": "创世与泰坦世家" },
    { "name": "阿特拉斯", "des": "泰坦巨神，巨灵之战败后被罚立于大地西极，以疲惫双肩永远扛起整个旋转的天穹。", "symbolSize": 40, "category": "创世与泰坦世家" },
    { "name": "独眼巨人", "des": "额生独目的三位锻造巨匠，为父所憎囚于地底，宙斯的雷霆与波塞冬的三叉戟皆出其手。", "symbolSize": 40, "category": "创世与泰坦世家" },
    { "name": "塔耳塔洛斯", "des": "比冥府更深的无底深渊，与卡俄斯同样古老，战败的泰坦被锁于其中，为惩罚之极。", "symbolSize": 40, "category": "创世与泰坦世家" },
    { "name": "宙斯", "des": "推翻父神而王天下，执掌雷霆与秩序，情缘遍及神界人间，整座奥林匹斯的绝对中枢。", "symbolSize": 60, "category": "奥林匹斯神廷" },
    { "name": "赫拉", "des": "天后与婚姻的守护神，忠贞于用情不专的夫君，以绵长而冷酷的报复令诸情敌胆寒。", "symbolSize": 50, "category": "奥林匹斯神廷" },
    { "name": "波塞冬", "des": "海洋之主，三叉戟搅动风暴与地震，性情倔强好胜，常与诸神争城夺地而对簿神廷。", "symbolSize": 50, "category": "奥林匹斯神廷" },
    { "name": "哈得斯", "des": "冥界之主，沉默寡言的隐形者，掳得春之少女为后，静坐于亡者国度的玄铁王座。", "symbolSize": 50, "category": "奥林匹斯神廷" },
    { "name": "得墨忒耳", "des": "谷物与丰饶女神，女儿被掳后悲恸令大地颗粒无收，人间四季的轮转由她的哀乐而定。", "symbolSize": 40, "category": "奥林匹斯神廷" },
    { "name": "赫斯提亚", "des": "灶火女神，婉拒波塞冬与阿波罗的求婚而终身守贞，万家炉火即她的神座，最为温良。", "symbolSize": 40, "category": "奥林匹斯神廷" },
    { "name": "雅典娜", "des": "自宙斯头颅中全副武装而生，掌智慧、工艺与正义之战，以一株橄榄树赢得雅典之名。", "symbolSize": 50, "category": "奥林匹斯神廷" },
    { "name": "阿波罗", "des": "光明、预言、音乐与医药之神，银弓金琴，德尔斐神谕由他发布，风姿为神界之冠。", "symbolSize": 50, "category": "奥林匹斯神廷" },
    { "name": "阿尔忒弥斯", "des": "狩猎与月亮女神，携银弓纵马于山野，守护少女与幼兽，贞洁凛然而不可侵犯。", "symbolSize": 40, "category": "奥林匹斯神廷" },
    { "name": "阿瑞斯", "des": "嗜血战神，狂吼于沙场的莽勇化身，勇气有余而谋略不足，连雅典娜也屡屡挫其锋。", "symbolSize": 40, "category": "奥林匹斯神廷" },
    { "name": "阿佛洛狄忒", "des": "自海沫诞生的爱与美之神，一条金腰带宽解万般抗拒，连众神也难逃她的箭矢。", "symbolSize": 50, "category": "奥林匹斯神廷" },
    { "name": "赫菲斯托斯", "des": "跛足的锻造之神，火山即其炉灶，神兵利器与自动侍女皆出其手，丑夫而得配美妻。", "symbolSize": 40, "category": "奥林匹斯神廷" },
    { "name": "赫尔墨斯", "des": "众神信使，足生双翼，兼司商旅、雄辩与窃术，出生当日便偷走阿波罗的牛群。", "symbolSize": 40, "category": "奥林匹斯神廷" },
    { "name": "狄俄尼索斯", "des": "葡萄酒与狂欢之神，自宙斯腿中二次降生，所到之处迷醉、戏剧与解放一路并行。", "symbolSize": 40, "category": "奥林匹斯神廷" },
    { "name": "塞墨勒", "des": "忒拜公主，受赫拉化作的老乳母诱骗，求看神之真容而殒于雷霆之焰，遗腹即酒神。", "symbolSize": 40, "category": "奥林匹斯神廷" },
    { "name": "珀耳塞福涅", "des": "春之少女，被哈得斯掳为冥后，每年往返于阴阳两界，大地的枯荣随她脚步起落。", "symbolSize": 40, "category": "奥林匹斯神廷" },
    { "name": "赫拉克勒斯", "des": "宙斯与凡人之子，半神中的最强者，以十二功绩赎尽疯癫之罪，焚身之后位列仙班。", "symbolSize": 60, "category": "英雄与功绩" },
    { "name": "十二功绩", "des": "懦弱之王所命的种种死役，从尼米亚狮子到冥府三头犬，英雄以十年光阴步步走完。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "忒修斯", "des": "雅典王子，自愿加入贡童之列入迷宫屠牛怪，后统一阿提卡，雅典政制的传说源头。", "symbolSize": 50, "category": "英雄与功绩" },
    { "name": "珀耳修斯", "des": "宙斯与达那厄之子，借铜盾倒影斩下美杜莎，又从海怪爪下救出公主，功成而立国。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "达那厄", "des": "被神谕禁锢于铜塔的公主，宙斯化金雨穿窗而入，事后母子被装入木箱抛入大海。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "伊阿宋", "des": "阿尔戈号船长，率群雄远征科尔基斯求取金羊毛，功成而情变，晚景凄凉收场。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "金羊毛", "des": "金羊之皮，钉于圣树由不眠之龙看守，象征王权与远方的荣耀，诸路英雄竞逐之物。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "美狄亚", "des": "科尔基斯的巫术公主，痴爱异乡人而背叛父国，被弃之后亲手复仇，烈焰归于灰烬。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "俄狄浦斯", "des": "解开斯芬克斯之谜的忒拜之王，却不知早已弑父娶母，成为命运反讽的极致标本。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "安提戈涅", "des": "俄狄浦斯之女，违抗王命以尘土葬兄，以一死对抗强权，悲剧伦理的第一人。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "喀戎", "des": "贤明的半人马，通医术、弓马与礼乐，阿喀琉斯与伊阿宋皆出其门，师道之典范。", "symbolSize": 50, "category": "英雄与功绩" },
    { "name": "阿塔兰忒", "des": "善跑的女猎手，立誓终身不嫁，随月神逐猎于山野，是卡吕冬猎场上唯一的女性。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "俄耳甫斯", "des": "琴声能动草木顽石与冥王的歌者，下冥府寻妻，将出幽冥却功败于回头一望。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "阿斯克勒庇俄斯", "des": "喀戎门下学医的医神，医术精到能令亡者还阳，触怒生死之序，死于雷霆而升为星辰。", "symbolSize": 40, "category": "英雄与功绩" },
    { "name": "美杜莎", "des": "戈耳工三妖中唯一的可死者，目光所及皆化为顽石，死后首级仍被用作兵刃。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "弥诺陶洛斯", "des": "牛首人身的怪物，藏于克里特迷宫深处，以雅典贡来的童男童女为食，殁于忒修斯。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "许德拉", "des": "勒尔纳沼泽的九头蛇，斩一首生两首，毒血无药可解，终被火烙颈项而除去。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "刻耳柏洛斯", "des": "把守冥府之门的三头巨犬，生人勿进、亡魂勿出，曾被赫拉克勒斯徒手擒上阳间。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "斯芬克斯", "des": "狮身人面的谜之怪物，盘踞忒拜城外道旁，谜底被道破之日即坠崖自尽之时。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "塞壬", "des": "以歌声诱杀水手的海妖，栖于礁石鸣唱至白骨成堆，奥德修斯缚身听完而幸存。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "喀迈拉", "des": "狮首羊身蛇尾的喷火怪物，口吐烈焰为祸小亚细亚，混合形体怪物的鼻祖。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "波吕斐摩斯", "des": "牧羊于西西里的食人独眼巨人，被奥德修斯灌醉刺瞎，投石咆哮而终无所获。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "尼米亚狮子", "des": "刀枪不入的巨狮，列十二功绩之首，被徒手扼毙后剥皮，成为英雄终身的战甲。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "拉冬", "des": "守卫赫斯珀里得斯金苹果园的百首巨龙，不眠不倦盘于圣树，终丧命于英雄之计。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "塔洛斯", "des": "青铜铸就的守岛巨人，每日绕克里特巡行三周，投石逐船，命门在脚踝一孔。", "symbolSize": 40, "category": "怪物与异兽" },
    { "name": "阿喀琉斯", "des": "刀枪不入的忒提斯之子，希腊第一勇士，因怒罢战、因友复出，史诗的灵魂人物。", "symbolSize": 60, "category": "特洛伊战云" },
    { "name": "阿喀琉斯之踵", "des": "母亲倒提浸河时被手握住的脚踵，全身唯一未沾神水之处，英雄的命门所在。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "奥德修斯", "des": "伊萨卡之王，木马计的策划者，十年漂流十年归途，狡黠与坚忍即是他的铠甲。", "symbolSize": 50, "category": "特洛伊战云" },
    { "name": "珀涅罗珀", "des": "奥德修斯之妻，以织了又拆的寿布拖住百名求婚者，成为忠贞守候的代名词。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "阿伽门农", "des": "迈锡尼王与联军统帅，献女换得风向逆转，凯旋之日却死于浴池与妻子之剑。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "墨涅拉俄斯", "des": "斯巴达之王，海伦之夫，失妻而召集希腊群雄，十年血战皆为夺回王后一人。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "赫克托耳", "des": "特洛伊的长子与城防支柱，为家国而战至最后一刻，殁后尸身被拖绕城三圈。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "帕里斯", "des": "特洛伊王子，三女神争金苹果时的裁判，携海伦渡海而去，十年战火的引线。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "海伦", "des": "宙斯与勒达之女，人间绝色，她一人的去留令希腊千帆竞发，两座文明厮杀十年。", "symbolSize": 50, "category": "特洛伊战云" },
    { "name": "金苹果", "des": "刻着献给最美者的金果，三女神相争不下，一场裁决埋下屠城十年的伏笔。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "卡珊德拉", "des": "受阿波罗赐真预言又被诅咒无人信的公主，眼睁睁看着城破，预言句句成真。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "帕特罗克洛斯", "des": "阿喀琉斯的挚友，披其铠甲上阵以挽危局，殁于城下，一死唤醒英雄之怒。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "特洛伊木马", "des": "奥德修斯的空腹巨马，藏勇士于腹中献于城门，破城之夜自内应声而开。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "埃涅阿斯", "des": "阿佛洛狄忒与凡人之子，背负老父、携家神逃出火城，传说中罗马人的先祖。", "symbolSize": 40, "category": "特洛伊战云" },
    { "name": "冥府", "des": "亡者的国度，五条冥河环绕，哈得斯与珀耳塞福涅坐镇的幽暗王国，生者止步。", "symbolSize": 40, "category": "冥府与命运" },
    { "name": "卡戎", "des": "形容枯槁的冥河摆渡人，唯收船资方肯渡亡魂，口中含一枚钱币成为希腊葬俗。", "symbolSize": 40, "category": "冥府与命运" },
    { "name": "斯堤克斯", "des": "环绕冥界的神圣之河，诸神凭它起誓，誓词一出不复更改，虽宙斯亦不敢轻违。", "symbolSize": 40, "category": "冥府与命运" },
    { "name": "塔纳托斯", "des": "死亡的人格化身，夜神之子，无声无息地降临，将生命引渡入门后永暗。", "symbolSize": 40, "category": "冥府与命运" },
    { "name": "极乐净土", "des": "冥府深处的至福之地，义人与大英雄死后安居于此，永享宴饮、日光与歌。", "symbolSize": 40, "category": "冥府与命运" },
    { "name": "摩伊赖", "des": "命运三女神，一人纺线、一人量长、一人挥剪，命数既定，宙斯亦难令其改手。", "symbolSize": 40, "category": "冥府与命运" },
    { "name": "厄里倪厄斯", "des": "蛇发执鞭的复仇三女神，闻血腥而动，追索弑亲之罪，直至罪人疯狂方肯罢休。", "symbolSize": 40, "category": "冥府与命运" },
    { "name": "缪斯", "des": "九位文艺女神，宙斯与记忆女神之女，诗史、歌舞与天文各司其一，灵感之源。", "symbolSize": 40, "category": "冥府与命运" },
    { "name": "宁芙", "des": "山川林泉间的精灵少女，居于水畔、洞穴与树心，温柔多情而未必从一而终。", "symbolSize": 40, "category": "冥府与命运" },
    { "name": "赫卡忒", "des": "魔法与岔路的女神，双手执火炬照彻三岔路口，冥府与人间皆立有她的祭坛。", "symbolSize": 40, "category": "冥府与命运" },
    { "name": "弥诺斯", "des": "生为克里特之王，立法如铁，死后出任冥府三判官之首，裁断亡魂的归宿。", "symbolSize": 40, "category": "冥府与命运" }
  ],
  "links": [
    { "source": "希腊神话", "target": "卡俄斯", "name": "源起", "des": "一切谱系自混沌虚空开始，神话的第一页是无边的黑暗。" },
    { "source": "希腊神话", "target": "宙斯", "name": "统摄", "des": "新神秩序的中枢，神谱自他而枝繁叶茂。" },
    { "source": "希腊神话", "target": "赫拉克勒斯", "name": "垂范", "des": "英雄叙事的巅峰，半神赎罪的完整弧线。" },
    { "source": "希腊神话", "target": "特洛伊木马", "name": "传诵", "des": "最脍炙人口的一计，成诗成剧千年不衰。" },
    { "source": "希腊神话", "target": "冥府", "name": "归宿", "des": "神与英雄各自的终章，幽暗深处另有一重人间。" },
    { "source": "卡俄斯", "target": "盖亚", "name": "诞育", "des": "虚空自行裂开，大地母神首先成形，谱系自她展开。" },
    { "source": "卡俄斯", "target": "尼克斯", "name": "诞育", "des": "黑夜与大地同出于混沌，是卡俄斯直接诞下的古老神祇。" },
    { "source": "卡俄斯", "target": "塔耳塔洛斯", "name": "诞育", "des": "深渊与虚空同源而生，比冥府更深的牢狱由此自成。" },
    { "source": "盖亚", "target": "瑞亚", "name": "亲子", "des": "泰坦之后亦是大地亲生之女，噬子的灾殃由此传代。" },
    { "source": "盖亚", "target": "蓬托斯", "name": "亲子", "des": "无需配偶，沧海自成于母腹，海中神怪由此繁衍。" },
    { "source": "乌拉诺斯", "target": "盖亚", "name": "配偶", "des": "天空俯身拥抱大地，十二泰坦与独眼巨人皆所出。" },
    { "source": "盖亚", "target": "克罗诺斯", "name": "亲子", "des": "泰坦中最幼而最狠者，母亲将复仇的希望寄托于他。" },
    { "source": "乌拉诺斯", "target": "克罗诺斯", "name": "亲子", "des": "天空憎恶子女而将其压回母腹，幼子终成其终结者。" },
    { "source": "克罗诺斯", "target": "瑞亚", "name": "配偶", "des": "泰坦兄妹结为夫妻，六位奥林匹斯神祇皆其所生。" },
    { "source": "克罗诺斯", "target": "宙斯", "name": "亲子", "des": "惧怕篡位预言而吞食新生儿，宙斯成了唯一的漏网者。" },
    { "source": "克罗诺斯", "target": "波塞冬", "name": "亲子", "des": "兄长先于宙斯被吞入父腹，多年后方被救出重见天光。" },
    { "source": "克罗诺斯", "target": "哈得斯", "name": "亲子", "des": "长子首先被吞，冥界的幽暗仿佛是腹中岁月的延续。" },
    { "source": "瑞亚", "target": "宙斯", "name": "救护", "des": "以裹布之石瞒过吞子的丈夫，把幼子藏于克里特山洞。" },
    { "source": "普罗米修斯", "target": "阿特拉斯", "name": "兄弟", "des": "同出伊阿佩托斯之门，一个盗火予人，一个扛天受罚。" },
    { "source": "普罗米修斯", "target": "宙斯", "name": "触怒", "des": "盗天火予凡人，挑战新王的秩序，被锁于高加索山崖。" },
    { "source": "宙斯", "target": "潘多拉", "name": "造物", "des": "命诸神合造首位女人，携灾祸之盒下嫁人间作惩罚。" },
    { "source": "潘多拉", "target": "普罗米修斯", "name": "针对", "des": "盗火的回礼是落向人间的灾祸，盒盖一开再难收拾。" },
    { "source": "盖亚", "target": "独眼巨人", "name": "亲子", "des": "独目的三位巨匠为父所憎，自出生便囚于幽暗地底。" },
    { "source": "独眼巨人", "target": "宙斯", "name": "锻兵", "des": "为救主献上雷霆闪电，宙斯的王权自此有了兵器。" },
    { "source": "塔耳塔洛斯", "target": "克罗诺斯", "name": "囚禁", "des": "战败的泰坦之王被锁入深渊，永世不得重见天日。" },
    { "source": "尼克斯", "target": "塔纳托斯", "name": "亲子", "des": "黑夜诞下死亡，母子形影相随，凡人闻之色变。" },
    { "source": "厄洛斯", "target": "盖亚", "name": "促合", "des": "原始爱欲最先推动大地拥抱天空，繁衍由此开端。" },
    { "source": "厄洛斯", "target": "阿佛洛狄忒", "name": "亲子", "des": "后世说他随美神而行，金箭射处情不可逃。" },
    { "source": "乌拉诺斯", "target": "阿佛洛狄忒", "name": "孕育", "des": "断落的肢体入海激起白沫，美神自浪花中诞生。" },
    { "source": "蓬托斯", "target": "波塞冬", "name": "让位", "des": "老海让出沧溟，三叉戟接管全部波涛与暗涌。" },
    { "source": "宙斯", "target": "赫拉", "name": "配偶", "des": "娶姐姐为天后，神圣婚姻却充斥背叛与报复，家庭即战场。" },
    { "source": "宙斯", "target": "波塞冬", "name": "兄弟", "des": "三兄弟分治天海冥，雷霆归天，三叉戟归海，隐盔归冥。" },
    { "source": "宙斯", "target": "哈得斯", "name": "兄弟", "des": "抽签分得幽冥国度，兄弟从此天各一方，各安其位。" },
    { "source": "宙斯", "target": "雅典娜", "name": "亲子", "des": "从头颅中全副而生的女儿，智慧直承父神，最为钟爱。" },
    { "source": "宙斯", "target": "阿波罗", "name": "亲子", "des": "与勒托所生之子，银弓与神谕皆是父神权柄的延伸。" },
    { "source": "宙斯", "target": "阿尔忒弥斯", "name": "亲子", "des": "孪生姊弟生于得洛斯岛，光明与狩猎各领一方。" },
    { "source": "宙斯", "target": "赫尔墨斯", "name": "亲子", "des": "信使出生当日偷走阿波罗牛群，机敏深得父心。" },
    { "source": "宙斯", "target": "狄俄尼索斯", "name": "亲子", "des": "将未足月的胎儿缝入腿中，酒神两度降生于父体。" },
    { "source": "宙斯", "target": "塞墨勒", "name": "情缘", "des": "化为凡人相会，却因天后之计以真容显现，公主殒于雷焰。" },
    { "source": "塞墨勒", "target": "狄俄尼索斯", "name": "亲子", "des": "母亲死于雷霆之焰，胎儿被宙斯救入腿中养至足月。" },
    { "source": "赫拉", "target": "塞墨勒", "name": "报复", "des": "化作老乳母诱其求看神之真容，借雷霆除去情敌。" },
    { "source": "赫拉", "target": "赫菲斯托斯", "name": "亲子", "des": "传为赫拉独自所生，因丑陋跛足被掷下奥林匹斯。" },
    { "source": "赫菲斯托斯", "target": "阿佛洛狄忒", "name": "配偶", "des": "跛足匠神与美神的错配婚约，婚床早已名存实亡。" },
    { "source": "阿佛洛狄忒", "target": "阿瑞斯", "name": "私情", "des": "美神与战神私通被网于床笫，成为奥林匹斯的笑谈。" },
    { "source": "赫菲斯托斯", "target": "阿瑞斯", "name": "网擒", "des": "以无形之网当场罩住私通二人，当众出尽其丑。" },
    { "source": "阿瑞斯", "target": "雅典娜", "name": "不敌", "des": "莽勇敌不过智谋，特洛伊城下再败于女神之手。" },
    { "source": "阿波罗", "target": "阿尔忒弥斯", "name": "孪生", "des": "日月双生的神姊神弟，银弓对金弓，狩猎对预言。" },
    { "source": "雅典娜", "target": "波塞冬", "name": "争城", "des": "为雅典归属相争，橄榄树胜过咸泉，城名由此而定。" },
    { "source": "赫尔墨斯", "target": "哈得斯", "name": "引魂", "des": "灵魂向导持双翼杖引亡者下行，是冥府的常客信使。" },
    { "source": "宙斯", "target": "缪斯", "name": "亲子", "des": "与记忆女神连寝九夜，得九女分掌人间文艺。" },
    { "source": "阿波罗", "target": "缪斯", "name": "统领", "des": "缪斯之主携琴领九女，帕纳索斯山即其居所。" },
    { "source": "瑞亚", "target": "赫斯提亚", "name": "亲子", "des": "长女甘守炉火不问权柄，人间万家灶即其神殿。" },
    { "source": "瑞亚", "target": "得墨忒耳", "name": "亲子", "des": "谷物女神承母亲大地之性，掌人间丰歉枯荣。" },
    { "source": "瑞亚", "target": "赫拉", "name": "亲子", "des": "幼女被吞前被藏于大洋深处，长大后归来助弟复仇。" },
    { "source": "得墨忒耳", "target": "珀耳塞福涅", "name": "母女", "des": "春之少女是母亲全部的牵挂，被掳后大地随之凋零。" },
    { "source": "哈得斯", "target": "珀耳塞福涅", "name": "劫娶", "des": "裂开大地掳走采花的少女，冥府自此有了王后。" },
    { "source": "阿佛洛狄忒", "target": "埃涅阿斯", "name": "亲子", "des": "爱与美之神与凡人所生，火中背父而逃的罗马先祖。" },
    { "source": "赫卡忒", "target": "珀耳塞福涅", "name": "相伴", "des": "寻人路上持炬相随，自此成为冥后贴身的伴侣。" },
    { "source": "塞壬", "target": "珀耳塞福涅", "name": "侍从", "des": "未能护住少女旧主，被罚化作礁石上的歌者。" },
    { "source": "宁芙", "target": "阿尔忒弥斯", "name": "侍从", "des": "山林水泽的精灵随月神出猎，是荒野的呼吸。" },
    { "source": "宁芙", "target": "狄俄尼索斯", "name": "抚育", "des": "幼年酒神藏于山谷，由宁芙们抚养看护长大。" },
    { "source": "阿尔忒弥斯", "target": "阿塔兰忒", "name": "庇护", "des": "女猎手随从月神左右，卡吕冬猎场一箭扬名。" },
    { "source": "阿尔忒弥斯", "target": "阿伽门农", "name": "索祭", "des": "猎神锁住风向索其长女为祭，统帅挥刀处悲剧已定。" },
    { "source": "喀戎", "target": "阿喀琉斯", "name": "授业", "des": "半人马名师教其医术琴弓与战阵，英雄师门第一人。" },
    { "source": "喀戎", "target": "伊阿宋", "name": "授业", "des": "幼年伊阿宋在山洞中养大，习驭舟、弓马与方略。" },
    { "source": "喀戎", "target": "阿斯克勒庇俄斯", "name": "授业", "des": "传授医术于半人马洞中，门生精到能令亡者还阳。" },
    { "source": "宙斯", "target": "阿斯克勒庇俄斯", "name": "惩罚", "des": "起死回生乱了生死之序，一记雷霆终结医神人世。" },
    { "source": "宙斯", "target": "赫拉克勒斯", "name": "亲子", "des": "化作安菲特律翁之形夜会其母，种下最强半神。" },
    { "source": "赫拉", "target": "赫拉克勒斯", "name": "迫害", "des": "天后终生追杀夫之私生子，十二苦役多出自其手笔。" },
    { "source": "赫拉克勒斯", "target": "十二功绩", "name": "完成", "des": "为赎疯癫中所杀亲人之罪，俯首服苦役于懦弱之王。" },
    { "source": "十二功绩", "target": "尼米亚狮子", "name": "首役", "des": "第一役徒手扼毙刀枪不入的巨狮，狮皮自此为战甲。" },
    { "source": "十二功绩", "target": "许德拉", "name": "再战", "des": "九头蛇斩一首生两首，以火烙颈方得斩尽杀绝。" },
    { "source": "十二功绩", "target": "刻耳柏洛斯", "name": "终役", "des": "末役下冥府徒手擒三头犬，吓得国王躲进铜瓮。" },
    { "source": "十二功绩", "target": "拉冬", "name": "取果", "des": "借替扛天穹之计换取金苹果，巨龙命丧百首之间。" },
    { "source": "赫拉克勒斯", "target": "阿特拉斯", "name": "代劳", "des": "替巨神扛天以换金苹果，事毕险被永远留在山下。" },
    { "source": "拉冬", "target": "阿特拉斯", "name": "毗邻", "des": "金苹果圣园设在扛天者近旁，百首巨龙盘于树下。" },
    { "source": "赫拉克勒斯", "target": "伊阿宋", "name": "同征", "des": "最强半神随阿尔戈号远征，中途弃桨去寻爱人。" },
    { "source": "伊阿宋", "target": "金羊毛", "name": "求取", "des": "为夺回被篡夺的王位，率群雄远航至科尔基斯。" },
    { "source": "美狄亚", "target": "金羊毛", "name": "祝咒", "des": "咒语哄睡守园的不眠之龙，金羊毛方到英雄之手。" },
    { "source": "阿佛洛狄忒", "target": "美狄亚", "name": "施咒", "des": "令公主情迷异乡客，一念之叛自此不可回头。" },
    { "source": "美狄亚", "target": "伊阿宋", "name": "相助", "des": "以巫术破火牛与龙牙武士之阵，只换一句婚誓。" },
    { "source": "美狄亚", "target": "塔洛斯", "name": "击杀", "des": "窥破铜人脚踝命门，一帖药剂令其命血流失殆尽。" },
    { "source": "弥诺斯", "target": "塔洛斯", "name": "守土", "des": "青铜巨人日巡海岛三周，为克里特充当海上长城。" },
    { "source": "弥诺斯", "target": "弥诺陶洛斯", "name": "豢养", "des": "王后与神牛之裔成了国耻，遂建迷宫将其藏于内。" },
    { "source": "忒修斯", "target": "弥诺陶洛斯", "name": "斩杀", "des": "循线团入迷宫深处，一剑屠牛怪，沿线索全身而退。" },
    { "source": "波塞冬", "target": "忒修斯", "name": "亲子", "des": "传说兼具埃勾斯与海王血脉，海路赴雅典试炼重重。" },
    { "source": "忒修斯", "target": "冥府", "name": "受困", "des": "欲掳冥后反被缚于遗忘之椅，终被赫拉克勒斯救出。" },
    { "source": "赫拉克勒斯", "target": "忒修斯", "name": "挚友", "des": "两位最强英雄惺惺相惜，并肩远征阿玛宗之邦。" },
    { "source": "阿塔兰忒", "target": "忒修斯", "name": "同猎", "des": "卡吕冬猎场同逐巨猪，她一箭先中而名动希腊。" },
    { "source": "宙斯", "target": "达那厄", "name": "情缘", "des": "神谕禁锢的公主，金雨穿窗而入，生下斩妖之子。" },
    { "source": "达那厄", "target": "珀耳修斯", "name": "亲子", "des": "母子被锁入木箱抛于大海，漂至塞里福斯岛上。" },
    { "source": "珀耳修斯", "target": "美杜莎", "name": "斩杀", "des": "借雅典娜铜盾之倒影近身，镰刀一挥取其首级。" },
    { "source": "雅典娜", "target": "珀耳修斯", "name": "资助", "des": "赠磨亮的铜盾以照妖影，另有飞鞋与神镰相助。" },
    { "source": "俄狄浦斯", "target": "斯芬克斯", "name": "破解", "des": "谜底是人，怪物坠崖自尽，忒拜以王位与寡后相酬。" },
    { "source": "俄狄浦斯", "target": "安提戈涅", "name": "父女", "des": "失明老王由幼女牵行流亡，她是父亲唯一的领路人。" },
    { "source": "阿波罗", "target": "俄耳甫斯", "name": "授业", "des": "父授琴艺于歌者，弦声能令顽石垂泪、猛兽俯首。" },
    { "source": "缪斯", "target": "俄耳甫斯", "name": "亲子", "des": "歌者之母执史诗之笔，琴艺与歌喉自有渊源。" },
    { "source": "俄耳甫斯", "target": "狄俄尼索斯", "name": "传习", "des": "俄耳甫斯秘仪承酒神一脉，狂欢之外另有幽径。" },
    { "source": "俄耳甫斯", "target": "冥府", "name": "下临", "des": "琴声打动冥王冥后，亡妻获准随他重返人间。" },
    { "source": "金苹果", "target": "帕里斯", "name": "裁决", "des": "赫拉、雅典娜与美神各许厚礼，王子把果子判给了爱。" },
    { "source": "阿佛洛狄忒", "target": "帕里斯", "name": "许诺", "des": "以人间第一美人相许，赢得金果也赢得千秋骂名。" },
    { "source": "赫拉", "target": "金苹果", "name": "竞逐", "des": "许以亚细亚王权换取金果，落选后记恨特洛伊。" },
    { "source": "雅典娜", "target": "金苹果", "name": "竞逐", "des": "许以战无不胜的英名，仍敌不过一句爱的承诺。" },
    { "source": "帕里斯", "target": "海伦", "name": "劫夺", "des": "借美神之诺带走斯巴达王后，希腊千帆自此追来。" },
    { "source": "海伦", "target": "墨涅拉俄斯", "name": "配偶", "des": "斯巴达之王与绝色王后，一场婚变空置婚床十年。" },
    { "source": "墨涅拉俄斯", "target": "阿伽门农", "name": "兄弟", "des": "兄弟分掌斯巴达与迈锡尼，失妻者求兄起兵复仇。" },
    { "source": "阿伽门农", "target": "阿喀琉斯", "name": "失和", "des": "夺其战利品女俘，第一勇士怒而罢战，战局倾危。" },
    { "source": "阿喀琉斯", "target": "帕特罗克洛斯", "name": "挚友", "des": "挚友披其铠甲上阵挽危局，战死唤醒英雄之怒。" },
    { "source": "赫克托耳", "target": "帕特罗克洛斯", "name": "击杀", "des": "特洛伊支柱一矛刺倒冒名的英雄，却引来死神。" },
    { "source": "阿喀琉斯", "target": "赫克托耳", "name": "复仇", "des": "绕城三圈追杀，拖尸泄愤，终以王者之礼归还。" },
    { "source": "斯堤克斯", "target": "阿喀琉斯", "name": "浸洗", "des": "母亲倒提婴儿浸入神河，被手握住的脚踵成了死角。" },
    { "source": "帕里斯", "target": "阿喀琉斯之踵", "name": "命中", "des": "一箭借阿波罗之力，正中不死英雄唯一的破绽。" },
    { "source": "阿波罗", "target": "帕里斯", "name": "指引", "des": "神明亲引致命一箭，城墙下清算旧日的胜负。" },
    { "source": "阿波罗", "target": "卡珊德拉", "name": "诅咒", "des": "拒爱之后，真预言与无人信的诅咒一同落下。" },
    { "source": "奥德修斯", "target": "特洛伊木马", "name": "献策", "des": "献空心巨马之计藏勇士入城，十年僵局一夜而破。" },
    { "source": "特洛伊木马", "target": "卡珊德拉", "name": "识破", "des": "先知一眼看穿腹中伏兵，誓言无人肯信，城门自开。" },
    { "source": "赫克托耳", "target": "埃涅阿斯", "name": "同袍", "des": "城破之夜各奔命运，一死一逃，帝国自流亡开始。" },
    { "source": "奥德修斯", "target": "珀涅罗珀", "name": "配偶", "des": "十年漂流十年守望，织了又拆的寿布骗过求婚者。" },
    { "source": "奥德修斯", "target": "波吕斐摩斯", "name": "刺瞎", "des": "自称“无人”灌醉巨人，烧瞎独眼后藏身羊腹脱险。" },
    { "source": "波塞冬", "target": "波吕斐摩斯", "name": "亲子", "des": "巨人之父闻独眼被刺，怒涛追讨伊萨卡人十年。" },
    { "source": "波吕斐摩斯", "target": "独眼巨人", "name": "隶属", "des": "独目巨人一族最放浪的一个，牧羊于西西里海滨。" },
    { "source": "奥德修斯", "target": "塞壬", "name": "聆听", "des": "依吩咐缚身于桅杆，成了听遍魔歌的幸存听众。" },
    { "source": "波塞冬", "target": "奥德修斯", "name": "阻归", "des": "因刺瞎爱子之眼，十年归路布满风暴与愤怒。" },
    { "source": "哈得斯", "target": "冥府", "name": "统治", "des": "与珀耳塞福涅共治幽暗王国，亡者尽归其册。" },
    { "source": "冥府", "target": "斯堤克斯", "name": "环绕", "des": "神河九曲环绕冥土，誓言与亡魂皆由此而渡。" },
    { "source": "卡戎", "target": "斯堤克斯", "name": "摆渡", "des": "朽船往来于神河两岸，口中钱币是唯一的船资。" },
    { "source": "卡戎", "target": "俄耳甫斯", "name": "放行", "des": "琴声一响，船夫破例载活人渡过冥河。" },
    { "source": "塔纳托斯", "target": "冥府", "name": "引渡", "des": "死亡的化身无声降临，将生命领入永暗之门。" },
    { "source": "摩伊赖", "target": "宙斯", "name": "制衡", "des": "纺锤量定神人命数，雷霆之主亦常无奈认账。" },
    { "source": "摩伊赖", "target": "尼克斯", "name": "亲子", "des": "命运是黑夜最古老的女儿，纺锤早在混沌中转动。" },
    { "source": "厄里倪厄斯", "target": "尼克斯", "name": "亲子", "des": "黑夜诞下的复仇之女，闻血腥即振翅而起。" },
    { "source": "厄里倪厄斯", "target": "俄狄浦斯", "name": "追索", "des": "弑父娶母的血罪难逃，老王流亡路上有影随行。" },
    { "source": "弥诺斯", "target": "冥府", "name": "判官", "des": "生前为王死后判亡魂，三判官之首铁面无私。" },
    { "source": "极乐净土", "target": "冥府", "name": "毗邻", "des": "幽暗国度里的至福角落，唯义人与大英雄可入。" },
    { "source": "极乐净土", "target": "赫拉克勒斯", "name": "终归", "des": "凡躯焚尽毒血之后，英雄长居至福之野与神同席。" },
    { "source": "赫卡忒", "target": "冥府", "name": "出入", "des": "持炬穿行于三岔路口与幽冥，两界皆有祭坛。" },
    { "source": "喀迈拉", "target": "许德拉", "name": "同源", "des": "同出厄喀德那之门，一个喷火，一个九首藏毒。" },
    { "source": "许德拉", "target": "刻耳柏洛斯", "name": "同源", "des": "怪姊妹分踞沼泽与冥门，皆为英雄途中的死劫。" },
    { "source": "喀迈拉", "target": "刻耳柏洛斯", "name": "同源", "des": "喷火怪与守门犬一母所出，各踞一方为祸人间。" },
    { "source": "波塞冬", "target": "美杜莎", "name": "亵渎", "des": "神殿内的冒犯触怒雅典娜，诅咒使其美发化作蛇群。" }
  ],
  "title": "希腊神话",
  "description": "从卡俄斯的虚空到特洛伊的火光，神与英雄的亲缘、冲突与命运。"
}
