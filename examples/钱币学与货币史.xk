{"version":2,"nodes":[{"name":"钱币学与货币史","des":"从海贝到数字人民币：钱的形状史，也是一部信用的技术史。","symbolSize":70,"category":"货币起源"},{"name":"以物易物的局限","des":"双重巧合难遇难求：想要我的羊的人未必有我要的盐。","symbolSize":40,"category":"货币起源"},{"name":"商品货币","des":"牛羊、盐与贝壳轮流上岗，被公认的中介先当钱用。","symbolSize":40,"category":"货币起源"},{"name":"货贝与朋","des":"海贝十枚为一朋，商周时期的硬通货与赏赐重器。","symbolSize":40,"category":"货币起源"},{"name":"铜贝","des":"商代晚期用青铜仿铸的海贝，公认最早的金属铸币之一。","symbolSize":40,"category":"货币起源"},{"name":"布币","des":"从农具镈演变而来的铲形铜币，三晋周地的田野记忆。","symbolSize":40,"category":"货币起源"},{"name":"刀币","des":"燕齐之地的刀形铜币，刀尖上挂着齐国的渔盐富强。","symbolSize":40,"category":"货币起源"},{"name":"圜钱","des":"圆形圆孔再变方孔，战国晚期胜出的终局形制。","symbolSize":40,"category":"货币起源"},{"name":"蚁鼻钱","des":"楚地的贝形铜币，俗称鬼脸钱，南方另起一灶的货币体系。","symbolSize":40,"category":"货币起源"},{"name":"金属称量货币","des":"郢爰金版与青铜块，交易先过秤后付款的时代。","symbolSize":40,"category":"货币起源"},{"name":"吕底亚琥珀金币","des":"约前七世纪小亚细亚的金银合金打制币，西方铸币的起点。","symbolSize":50,"category":"货币起源"},{"name":"雅典猫头鹰德拉克马","des":"戴盔雅典娜与站立的猫头鹰，古典时代地中海的通行证。","symbolSize":40,"category":"货币起源"},{"name":"秦半两","des":"天圆地方：始皇一统币制，方孔圆钱沿用两千年。","symbolSize":50,"category":"中国铸币"},{"name":"汉五铢","des":"从汉武帝到唐初七百余年的长寿钱，中国铸币的标尺。","symbolSize":50,"category":"中国铸币"},{"name":"王莽改制","des":"托古改制的四番币制实验，金错刀一枚值五千。","symbolSize":40,"category":"中国铸币"},{"name":"开元通宝","des":"武德四年始铸，宝文取代铢两，积十钱为一两的十进制。","symbolSize":50,"category":"中国铸币"},{"name":"年号钱","des":"自汉兴钱起皇帝年号登上钱文，掌心一部编年史。","symbolSize":40,"category":"中国铸币"},{"name":"御书钱","des":"皇帝亲书钱文，宋徽宗瘦金体大观通宝是公认巅峰。","symbolSize":40,"category":"中国铸币"},{"name":"对钱","des":"篆楷成对同铸，北宋钱监里的书法双人舞。","symbolSize":40,"category":"中国铸币"},{"name":"咸丰大钱","des":"太平天国战事烧钱，当百当千把通胀直接铸上面额。","symbolSize":40,"category":"中国铸币"},{"name":"翻砂铸钱","des":"母钱压出砂型，一炉炉浇出标准化的一母千子。","symbolSize":40,"category":"中国铸币"},{"name":"钱监","des":"官营铸币工场与衙门，铜料、产量与私铸的猫鼠游戏。","symbolSize":40,"category":"中国铸币"},{"name":"铁钱","des":"四川铁钱重得压垮商旅，却为纸币备好了理由。","symbolSize":40,"category":"中国铸币"},{"name":"交子","des":"益州商人的存款凭券，北宋诞生的世界最早纸币。","symbolSize":50,"category":"纸币革命"},{"name":"钱引","des":"交子收归官办后的改名，贬值之路也从此启程。","symbolSize":40,"category":"纸币革命"},{"name":"会子","des":"南宋临安的官办纸币，金融发明在江南的第二次实验。","symbolSize":40,"category":"纸币革命"},{"name":"大明宝钞","des":"一贯拟米一石，滥发到几乎无人肯收的明代纸币。","symbolSize":40,"category":"纸币革命"},{"name":"银两制","des":"称重量辨成色的碎银世界，戥子是店铺的标配。","symbolSize":40,"category":"纸币革命"},{"name":"银锭与元宝","des":"五十两的马蹄银，储藏、纳税与馈赠皆宜的硬资产。","symbolSize":40,"category":"纸币革命"},{"name":"一条鞭法","des":"张居正把赋役折银征收，白银登堂入室成财政主角。","symbolSize":40,"category":"纸币革命"},{"name":"机制币","des":"光绪龙洋到袁大头，机器银元终结千年翻砂。","symbolSize":40,"category":"纸币革命"},{"name":"废两改元","des":"1933年两元并轨，称银剪银的旧账彻底关张。","symbolSize":40,"category":"纸币革命"},{"name":"法币与金圆券","des":"1935年法币改革，1948年金圆券十个月葬送信用。","symbolSize":40,"category":"纸币革命"},{"name":"人民币","des":"1948年在石家庄诞生，终结乱世币制的人民的货币。","symbolSize":40,"category":"纸币革命"},{"name":"罗马铸币","des":"第纳里乌斯一路减重劣化，帝国的信誉跟着缩水。","symbolSize":40,"category":"西方铸币"},{"name":"索里达金币","des":"拜占庭稳定发行七百年的金币，中世纪的美金。","symbolSize":40,"category":"西方铸币"},{"name":"第纳尔与迪拉姆","des":"阿拉伯的金币与银币体系，丝路与印度洋的通货。","symbolSize":40,"category":"西方铸币"},{"name":"LSD体系","des":"镑、先令、便士的十二进制，从查理曼用到1971年。","symbolSize":40,"category":"西方铸币"},{"name":"塔勒与dollar词源","des":"约阿希姆斯塔尔的大银币，thalers慢慢读成dollars。","symbolSize":40,"category":"西方铸币"},{"name":"八里亚尔银币","des":"西班牙八里亚尔，最早的全球货币，俗称双柱银元。","symbolSize":50,"category":"西方铸币"},{"name":"剪边与齿边","des":"剪铰钱边的老手艺，逼出了硬币边缘的防伪齿纹。","symbolSize":40,"category":"西方铸币"},{"name":"牛顿与皇家铸币厂","des":"造币厂总监牛顿重整币制，顺便把伪币犯送上绞架。","symbolSize":40,"category":"西方铸币"},{"name":"金几尼与沙弗林","des":"几尼与沙弗林，英镑金币的先后两代名片。","symbolSize":40,"category":"西方铸币"},{"name":"铸币税","des":"面值减去成本的差额，君主最古老的融资魔术。","symbolSize":40,"category":"本位与制度"},{"name":"格雷欣法则","des":"劣币驱逐良币：足值钱被熔被藏，轻钱满天飞。","symbolSize":50,"category":"本位与制度"},{"name":"金银复本位","des":"金银法定比价各说各话，套利者笑纳差价。","symbolSize":40,"category":"本位与制度"},{"name":"银本位","des":"中国与印度的白银之锚，银价一动天下震颤。","symbolSize":40,"category":"本位与制度"},{"name":"经典金本位","des":"1821年英国恢复兑现，英镑挂钩黄金的百年纪律。","symbolSize":50,"category":"本位与制度"},{"name":"金本位自动调节","des":"休谟的价格铸币流动机制，贸易失衡靠黄金搬运自愈。","symbolSize":40,"category":"本位与制度"},{"name":"特里芬难题","des":"世界要美元就得容忍美国逆差，逆差又伤美元信用。","symbolSize":40,"category":"本位与制度"},{"name":"布雷顿森林体系","des":"1944年确立美元挂黄金、各国钉住美元的秩序。","symbolSize":50,"category":"本位与制度"},{"name":"尼克松冲击","des":"1971年8月15日兑换窗口关闭，美元与黄金离婚。","symbolSize":40,"category":"本位与制度"},{"name":"浮动汇率与法币时代","des":"货币脱锚之后，价值全押在国家信用与央行报表上。","symbolSize":40,"category":"本位与制度"},{"name":"恶性通胀名录","des":"魏玛推车买面包，津巴布韦印出万亿面额。","symbolSize":40,"category":"本位与制度"},{"name":"大莱卡与信用卡","des":"1950年大莱俱乐部宴请结账，信用卡时代开席。","symbolSize":40,"category":"现代货币形态"},{"name":"磁条与EMV芯片","des":"磁条被克隆怕了，芯片加密码全球换装。","symbolSize":40,"category":"现代货币形态"},{"name":"旅行支票","des":"运通旅行支票，跨境携带信用的百年安全垫。","symbolSize":40,"category":"现代货币形态"},{"name":"SWIFT与电子转账","des":"环球银行报文网络，看不见的钱在光缆里奔跑。","symbolSize":40,"category":"现代货币形态"},{"name":"网上银行","des":"银行搬进浏览器，转账第一次不用排队拿号。","symbolSize":40,"category":"现代货币形态"},{"name":"M-Pesa","des":"肯尼亚的手机存款转账系统，普惠金融的非洲奇迹。","symbolSize":40,"category":"现代货币形态"},{"name":"移动支付","des":"二维码一扫，钱包与找零一起退休。","symbolSize":50,"category":"现代货币形态"},{"name":"央行数字货币","des":"数字人民币与巴哈马沙元，法币长出数字分身。","symbolSize":40,"category":"现代货币形态"},{"name":"Libra计划","des":"脸书2019年的发币宏图，各国围剿下偃旗息鼓。","symbolSize":40,"category":"现代货币形态"},{"name":"电子红包","des":"2014年除夕微信红包奇袭，扫码支付一夜启蒙。","symbolSize":40,"category":"现代货币形态"},{"name":"钱币学","des":"以货币实物为史料的学问，方孔与齿边皆是档案。","symbolSize":50,"category":"钱币收藏"},{"name":"版别学","des":"同年同文的钱里找细微差别，毫米与笔画定身份。","symbolSize":40,"category":"钱币收藏"},{"name":"母钱","des":"雕母铸母层层下传，砂模里的祖辈与子孙。","symbolSize":40,"category":"钱币收藏"},{"name":"生坑与传世古","des":"入土的锈与传世的包浆，两种时间的皮肤。","symbolSize":40,"category":"钱币收藏"},{"name":"锈色辨伪","des":"真锈入骨假锈浮皮，看锈是辨伪第一课。","symbolSize":40,"category":"钱币收藏"},{"name":"评级公司","des":"PCGS与NGC装盒打分，品相被换算成分数。","symbolSize":40,"category":"钱币收藏"},{"name":"冠字号与荧光版别","des":"纸币的号码与油墨荧光，收藏界的微观宇宙。","symbolSize":40,"category":"钱币收藏"},{"name":"错版币炒作","des":"倒水印、折白、漏印，被故事讲出天价的小概率。","symbolSize":40,"category":"钱币收藏"},{"name":"花钱","des":"不流通的压胜钱，吉语与神煞铸成的民俗史。","symbolSize":40,"category":"钱币收藏"},{"name":"流通纪念币","des":"为事件而生的法定货币，群众收藏的入口。","symbolSize":40,"category":"钱币收藏"},{"name":"窖藏出土","des":"陶罐里的千年积蓄，一出土就是一部编年史。","symbolSize":40,"category":"钱币收藏"},{"name":"假币鉴别","des":"听声、看边齿、量比重，三招老经验对付新假币。","symbolSize":40,"category":"钱币收藏"},{"name":"清代泉学","des":"金石学余脉，乾嘉学者把古钱研究做成专学。","symbolSize":40,"category":"钱币收藏"}],"links":[{"source":"钱币学与货币史","target":"吕底亚琥珀金币","name":"起点","des":"西方铸币的故事从琥珀金小豆开始。"},{"source":"钱币学与货币史","target":"秦半两","name":"一统","des":"方孔圆钱随郡县制铺向天下。"},{"source":"钱币学与货币史","target":"交子","name":"首创","des":"成都商人的存券成了世界最早纸币。"},{"source":"钱币学与货币史","target":"八里亚尔银币","name":"环流","des":"大帆船把银元送进每一座贸易港。"},{"source":"钱币学与货币史","target":"经典金本位","name":"立制","des":"黄金给货币立下百年纪律。"},{"source":"钱币学与货币史","target":"移动支付","name":"转身","des":"钱又一次改换了自己的外形。"},{"source":"钱币学与货币史","target":"钱币学","name":"玩赏","des":"离开流通的钱变成史料与藏品。"},{"source":"以物易物的局限","target":"商品货币","name":"催生","des":"双重巧合难遇难求，只好选个中介。"},{"source":"商品货币","target":"货贝与朋","name":"取材","des":"海贝小而稀，成了最早的计价物。"},{"source":"货贝与朋","target":"铜贝","name":"仿制","des":"真贝不够，青铜照模浇铸。"},{"source":"金属称量货币","target":"布币","name":"演化","des":"从过秤付款到按枚点数的一跃。"},{"source":"布币","target":"刀币","name":"并立","des":"铲形与刀形，三晋与燕齐各执一端。"},{"source":"布币","target":"圜钱","name":"汇流","des":"圆钱终胜，形制之争落下帷幕。"},{"source":"刀币","target":"圜钱","name":"归圆","des":"战国晚期圆形钱一统天下形制。"},{"source":"蚁鼻钱","target":"铜贝","name":"同源","des":"楚地鬼脸钱也是贝币一脉。"},{"source":"吕底亚琥珀金币","target":"雅典猫头鹰德拉克马","name":"示范","des":"琥珀金打样，猫头鹰后来居上。"},{"source":"雅典猫头鹰德拉克马","target":"罗马铸币","name":"传薪","des":"银币标准与打制工艺西传罗马。"},{"source":"以物易物的局限","target":"货贝与朋","name":"选定","des":"牛羊盐贝竞逐，贝胜出。"},{"source":"商品货币","target":"金属称量货币","name":"转身","des":"牛羊让位给可切可存的青铜。"},{"source":"圜钱","target":"秦半两","name":"定型","des":"圆钱方孔由秦推行至天下。"},{"source":"蚁鼻钱","target":"秦半两","name":"归统","des":"楚币随国灭并入半两体系。"},{"source":"吕底亚琥珀金币","target":"钱币学","name":"开题","des":"西方钱币史从这枚小豆讲起。"},{"source":"秦半两","target":"汉五铢","name":"接续","des":"半两减重混乱后五铢立秤。"},{"source":"王莽改制","target":"汉五铢","name":