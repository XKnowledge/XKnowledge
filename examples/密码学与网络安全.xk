{"version":2,"nodes":[{"name":"密码学与网络安全","des":"从凯撒的位移到后量子时代：保护信息的科学与攻防对抗的工程。","symbolSize":70,"category":"密码学基础"},{"name":"密码学","des":"构造与分析保密算法的数学科学。","symbolSize":50,"category":"密码学基础"},{"name":"明文与密文","des":"加密前后的消息形态。","symbolSize":30,"category":"密码学基础"},{"name":"密钥","des":"密码系统的秘密参数：算法公开、密钥保密。","symbolSize":40,"category":"密码学基础"},{"name":"柯克霍夫原则","des":"系统即使公开，只要密钥保密便仍安全。","symbolSize":30,"category":"密码学基础"},{"name":"凯撒密码","des":"字母位移三位的古典替换密码。","symbolSize":30,"category":"密码学基础"},{"name":"频率分析","des":"用字母频率指纹破译替换密码。","symbolSize":30,"category":"密码学基础"},{"name":"恩尼格玛","des":"二战德军的转子密码机，布莱切利园的破译改变历史。","symbolSize":40,"category":"密码学基础"},{"name":"香农","des":"信息论之父：保密系统的通信理论。","symbolSize":40,"category":"密码学基础"},{"name":"一次一密","des":"密钥与消息等长且只用一次：唯一完善保密的方案。","symbolSize":30,"category":"密码学基础"},{"name":"计算安全","des":"破译代价超过收益：实用安全的分界线。","symbolSize":30,"category":"密码学基础"},{"name":"随机数生成","des":"熵源决定密钥质量：密码学的地基。","symbolSize":30,"category":"密码学基础"},{"name":"隐写术","des":"隐藏消息存在本身：密码学的姊妹艺术。","symbolSize":30,"category":"密码学基础"},{"name":"对称加密","des":"加解密同一把钥匙：快速的主体算法。","symbolSize":50,"category":"对称与非对称"},{"name":"DES","des":"1977年标准的56位分组密码，已成历史。","symbolSize":30,"category":"对称与非对称"},{"name":"AES","des":"现行分组密码标准：无处不在的加密主力。","symbolSize":50,"category":"对称与非对称"},{"name":"分组密码模式","des":"ECB、CBC到GCM：模式决定安全边界。","symbolSize":30,"category":"对称与非对称"},{"name":"流密码","des":"逐比特加密的密钥流：RC4与ChaCha20。","symbolSize":30,"category":"对称与非对称"},{"name":"非对称加密","des":"公钥加密私钥解密：革命性的密钥分发。","symbolSize":50,"category":"对称与非对称"},{"name":"RSA","des":"基于大整数分解难题的公钥算法。","symbolSize":50,"category":"对称与非对称"},{"name":"大整数分解","des":"两个大素数相乘容易、分解极难。","symbolSize":30,"category":"对称与非对称"},{"name":"Diffie-Hellman","des":"公钥思想的先声：素不相知的双方协商密钥。","symbolSize":40,"category":"对称与非对称"},{"name":"离散对数","des":"指数容易求、对数极难：另一块数学基石。","symbolSize":30,"category":"对称与非对称"},{"name":"椭圆曲线密码","des":"更短密钥同级安全：移动时代的公钥。","symbolSize":40,"category":"对称与非对称"},{"name":"混合加密","des":"公钥传钥、对称跑量：两全其美的组合。","symbolSize":30,"category":"对称与非对称"},{"name":"哈希函数","des":"任意输入到固定摘要的单向指纹。","symbolSize":50,"category":"哈希与认证"},{"name":"SHA系列","des":"SHA-256与SHA-3：现行哈希标准家族。","symbolSize":30,"category":"哈希与认证"},{"name":"MD5","des":"已被碰撞攻破的教训教材。","symbolSize":30,"category":"哈希与认证"},{"name":"抗碰撞性","des":"难以找到同指纹的两个输入。","symbolSize":30,"category":"哈希与认证"},{"name":"生日攻击","des":"2 的 n/2 次尝试找碰撞的捷径。","symbolSize":30,"category":"哈希与认证"},{"name":"加盐哈希","des":"口令存储的正确姿势：加盐与慢哈希。","symbolSize":30,"category":"哈希与认证"},{"name":"HMAC","des":"带密钥的哈希：消息认证码。","symbolSize":30,"category":"哈希与认证"},{"name":"数字签名","des":"私钥签名、公钥验证：不可抵赖的电子手迹。","symbolSize":50,"category":"哈希与认证"},{"name":"数字证书","des":"绑定身份与公钥的签名文件。","symbolSize":40,"category":"哈希与认证"},{"name":"PKI","des":"公钥基础设施：证书签发与信任链。","symbolSize":40,"category":"哈希与认证"},{"name":"TLS","des":"HTTPS 的安全协议：握手机制。","symbolSize":50,"category":"哈希与认证"},{"name":"前向保密","des":"私钥泄露不回溯旧会话。","symbolSize":30,"category":"哈希与认证"},{"name":"网络安全","des":"攻防对抗的工程学：检测、防御与响应。","symbolSize":50,"category":"网络攻防"},{"name":"漏洞","des":"软件的裂缝：从bug到战场。","symbolSize":40,"category":"网络攻防"},{"name":"漏洞利用","des":"把裂缝变成入口的代码。","symbolSize":30,"category":"网络攻防"},{"name":"SQL注入","des":"应用层的经典注入：拼出来的灾难。","symbolSize":30,"category":"网络攻防"},{"name":"XSS","des":"浏览器里的脚本注入。","symbolSize":30,"category":"网络攻防"},{"name":"DDoS","des":"以洪水耗尽资源：分布式拒绝服务。","symbolSize":40,"category":"网络攻防"},{"name":"钓鱼攻击","des":"假冒身份的诱饵工程。","symbolSize":40,"category":"网络攻防"},{"name":"社会工程学","des":"攻人而非攻机：最薄弱的环节是人。","symbolSize":30,"category":"网络攻防"},{"name":"勒索软件","des":"加密你的数据再勒索：WannaCry 的教训。","symbolSize":40,"category":"网络攻防"},{"name":"僵尸网络","des":"傀儡军团的火力平台。","symbolSize":30,"category":"网络攻防"},{"name":"APT","des":"高级持续性威胁：国家级的长线渗透。","symbolSize":30,"category":"网络攻防"},{"name":"中间人攻击","des":"冒充双方的窃听者。","symbolSize":30,"category":"网络攻防"},{"name":"重放攻击","des":"重发合法报文以骗过验证。","symbolSize":30,"category":"网络攻防"},{"name":"渗透测试","des":"授权的模拟攻击：红队演练。","symbolSize":40,"category":"网络攻防"},{"name":"入侵检测","des":"IDS 与 IPS：网络流量里的哨兵。","symbolSize":30,"category":"网络攻防"},{"name":"防火墙","des":"边界的门卫：按规则放行。","symbolSize":40,"category":"网络攻防"},{"name":"侧信道攻击","des":"从时间与功耗读出密钥。","symbolSize":30,"category":"网络攻防"},{"name":"供应链攻击","des":"log4j 与 SolarWinds：从源头投毒。","symbolSize":30,"category":"网络攻防"},{"name":"CIA三要素","des":"保密性、完整性、可用性：安全的三角。","symbolSize":40,"category":"安全体系"},{"name":"零信任","des":"永不信任、持续验证：无边界的新范式。","symbolSize":40,"category":"安全体系"},{"name":"最小权限","des":"只给完成任务所需的最少权限。","symbolSize":30,"category":"安全体系"},{"name":"纵深防御","des":"多层冗余的防线：不押注单点。","symbolSize":30,"category":"安全体系"},{"name":"多因素认证","des":"你知、你有、你是的三重证明。","symbolSize":40,"category":"安全体系"},{"name":"端到端加密","des":"只有两端可读：Signal 式的私聊。","symbolSize":40,"category":"前沿技术"},{"name":"Tor","des":"洋葱路由：层层剥离的匿名网络。","symbolSize":30,"category":"前沿技术"},{"name":"区块链","des":"哈希串联的分布式账本。","symbolSize":50,"category":"前沿技术"},{"name":"比特币","des":"中本聪的创世：去中心化的电子现金。","symbolSize":40,"category":"前沿技术"},{"name":"零知识证明","des":"证明我知道而不泄露我知道什么。","symbolSize":40,"category":"前沿技术"},{"name":"同态加密","des":"密文上的直接计算：可用而不可见。","symbolSize":30,"category":"前沿技术"},{"name":"差分隐私","des":"加噪声的统计：苹果与人口普查的隐私术。","symbolSize":30,"category":"前沿技术"},{"name":"量子计算威胁","des":"Shor 算法：现行公钥密码的终结者。","symbolSize":30,"category":"前沿技术"},{"name":"后量子密码","des":"抗量子算法的标准化迁移。","symbolSize":40,"category":"前沿技术"},{"name":"安全开发","des":"SDL 与左移：安全融进代码。","symbolSize":30,"category":"安全体系"},{"name":"等保与合规","des":"等保2.0、ISO 27001 与个人信息保护法。","symbolSize":30,"category":"安全体系"},{"name":"安全运营","des":"SOC、监测与应急响应的日常。","symbolSize":30,"category":"安全体系"},{"name":"维吉尼亚密码","des":"用密钥词循环切换多张替换表的多表密码，曾被称为不可破译，三百年后仍倒在统计脚下。","symbolSize":40,"category":"密码学基础"},{"name":"三重DES","des":"对DES连做三遍加密以续命的过渡方案，换来安全余量，代价是三倍的时间与64位分组先天缺陷。","symbolSize":40,"category":"对称与非对称"},{"name":"RC4","des":"曾被HTTPS与WEP广泛采用的流密码，密钥流统计偏差屡屡被利用，2015年被标准正式除名。","symbolSize":40,"category":"对称与非对称"},{"name":"ChaCha20","des":"基于加减异或移位运算的高性能流密码，纯软件实现即可跑赢AES，移动端与TLS的常客。","symbolSize":40,"category":"对称与非对称"},{"name":"ECDH","des":"椭圆曲线版的Diffie-Hellman密钥协商，密钥短运算快，是现代TLS与前向保密的中坚。","symbolSize":40,"category":"对称与非对称"},{"name":"默克尔树","des":"哈希逐层归并成根的树形结构，改动任何一片叶子都会牵动整棵树，轻量验证海量数据。","symbolSize":40,"category":"哈希与认证"},{"name":"Kerberos","des":"基于对称密钥与票据的网络认证协议，可信第三方居中担保身份，Windows域的守门人。","symbolSize":50,"category":"哈希与认证"},{"name":"PGP","des":"1991年问世的个人邮件加密软件，以信任网取代中心化CA，把密码学交到普通人手中。","symbolSize":40,"category":"哈希与认证"},{"name":"Signal协议","des":"双棘轮算法驱动的加密消息协议，逐条消息换钥，前向保密与崩塌恢复兼备，端到端加密的事实标杆。","symbolSize":40,"category":"哈希与认证"},{"name":"SSH","des":"加密远程登录与文件传输的协议，运维工程师每天推开服务器大门的那把安全钥匙。","symbolSize":40,"category":"哈希与认证"},{"name":"IPsec","des":"在网络层加密并认证IP数据包的协议族，构建VPN隧道的技术根基。","symbolSize":40,"category":"哈希与认证"},{"name":"WPA2","des":"以AES-CCMP取代WEP的WiFi保护标准，守护无线网络十余年，KRACK攻击曾撼动其根基。","symbolSize":40,"category":"哈希与认证"},{"name":"DNSSEC","des":"为DNS记录逐级签名的扩展体系，让域名解析结果可被验证，堵住冒名应答的旧洞。","symbolSize":40,"category":"哈希与认证"},{"name":"证书透明度","des":"把所有已签发证书记入公开日志的机制，任何人可审计，让CA滥签无处遁形。","symbolSize":40,"category":"哈希与认证"},{"name":"网络钓鱼","des":"伪装成可信站点或邮件骗取口令的欺诈，再强的密码学也防不住用户亲手交出钥匙。","symbolSize":40,"category":"网络攻防"},{"name":"Shor算法","des":"量子计算机上多项式时间分解大数与求离散对数的算法，RSA与ECC的理论终结者。","symbolSize":40,"category":"网络攻防"},{"name":"Heartbleed","des":"2014年OpenSSL心跳扩展的越界读取漏洞，无声滴漏服务器内存与私钥，震惊整个互联网。","symbolSize":40,"category":"网络攻防"},{"name":"彩虹表","des":"预计算口令哈希链的庞大查找表，以空间换时间攻破未加盐的口令数据库。","symbolSize":40,"category":"网络攻防"},{"name":"暴力破解","des":"穷举一切可能密钥或口令的蛮力攻击，密钥长度与慢哈希决定它是否可行。","symbolSize":40,"category":"网络攻防"}],"links":[{"source":"密码学","target":"密码学与网络安全","name":"支柱","des":"加密算法的科学。"},{"source":"凯撒密码","target":"密码学","name":"起点","des":"替换密码的鼻祖。"},{"source":"凯撒密码","target":"明文与密文","name":"演示","des":"三个字母的位移。"},{"source":"频率分析","target":"凯撒密码","name":"破解","des":"字母频率的指纹。"},{"source":"恩尼格玛","target":"密码学","name":"历史节点","des":"机械加密与机器破译的开端。"},{"source":"香农","target":"密码学","name":"奠基","des":"信息论视角的保密理论。"},{"source":"一次一密","target":"香农","name":"证明","des":"唯一完善保密的方案。"},{"source":"计算安全","target":"一次一密","name":"对比","des":"理论与实用的分界。"},{"source":"随机数生成","target":"一次