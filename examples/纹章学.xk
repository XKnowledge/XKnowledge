{"version":2,"nodes":[{"name":"纹章学","des":"盾牌上的家谱：从中世纪比武场到现代国徽与商标的图案识别系统。","symbolSize":70,"category":"起源与制度"},{"name":"比武场的认脸术","des":"十二世纪头盔封脸：盾上的图案成了骑士的身份证。","symbolSize":40,"category":"起源与制度"},{"name":"纹章官","des":"herald：比武场边的唱名人，后来成了谱系与纹章的登记官。","symbolSize":40,"category":"起源与制度"},{"name":"英国纹章院","des":"1484年特许设立：英格兰纹章至今仍由它授予登记。","symbolSize":40,"category":"起源与制度"},{"name":"里昂纹章院","des":"苏格兰最高法庭之一：私用纹章在这里真会被起诉。","symbolSize":40,"category":"起源与制度"},{"name":"加拿大纹章局","des":"1988年设立：英语世界最年轻的官方授予机构。","symbolSize":40,"category":"起源与制度"},{"name":"纹章的法语","des":"gules、azure、rampant：术语被法语统治，与诺曼征服有关。","symbolSize":40,"category":"起源与制度"},{"name":"纹章的继承法","des":"英格兰认血统、苏格兰认授予：同姓未必同盾。","symbolSize":40,"category":"起源与制度"},{"name":"盾形画布","des":"escutcheon：一切纹章的核心画布，形制随时代与国别微变。","symbolSize":40,"category":"盾面语法"},{"name":"菱形女盾","des":"lozenge：女性不佩剑，纹章画在菱形上。","symbolSize":40,"category":"盾面语法"},{"name":"盾面分割","des":"横切竖切斜切：per fess、per pale，一刀下去定构图。","symbolSize":40,"category":"盾面语法"},{"name":"四分法","des":"quartering：父母家系各占一角，家谱在盾上开枝散叶。","symbolSize":40,"category":"盾面语法"},{"name":"以盾为本的左右","des":"dexter与sinister：纹章的左右以盾自身为准，与观者相反。","symbolSize":40,"category":"盾面语法"},{"name":"区别标记","des":"cadency：父子的盾只差一个小记号，兄弟各贴各的标签。","symbolSize":40,"category":"盾面语法"},{"name":"长子横条","des":"label：盾顶三条下垂小横条，长子在世时的标记。","symbolSize":40,"category":"盾面语法"},{"name":"婚姻并列","des":"impalement：夫妇两盾并列一盾，两家门第合璧。","symbolSize":40,"category":"盾面语法"},{"name":"提香法则","des":"金属不上金属、颜色不上颜色：九成纹章都守的配色铁律。","symbolSize":50,"category":"色彩法则"},{"name":"金属色","des":"金or与银argent：黄与白在纹章里是贵金属。","symbolSize":40,"category":"色彩法则"},{"name":"五色系","des":"红gules、蓝azure、黑sable、绿vert、紫purpure。","symbolSize":40,"category":"色彩法则"},{"name":"毛皮纹","des":"貂纹ermine与松鼠纹vair：把皮草穿在盾上。","symbolSize":40,"category":"色彩法则"},{"name":"色彩的语义","des":"红言勇气、蓝言忠诚：纹章色被赋予的道德词典。","symbolSize":40,"category":"色彩法则"},{"name":"耶路撒冷十字","des":"金十字架银底：金属压金属的最著名破戒。","symbolSize":40,"category":"色彩法则"},{"name":"普通图记","des":"ordinaries：横带、竖带、斜带、十字等大块几何构图。","symbolSize":40,"category":"图记谱系"},{"name":"纹章十字","des":"从希腊十字到百合饰十字：数百种变体的十字家族。","symbolSize":40,"category":"图记谱系"},{"name":"斜带","des":"bend：右上到左下的斜条，曾被讹传为私生子标记。","symbolSize":40,"category":"图记谱系"},{"name":"山形纹","des":"chevron：屋顶人字梁，军衔与校徽的常客。","symbolSize":40,"category":"图记谱系"},{"name":"鸢尾花","des":"fleur-de-lis：法兰西王权签名，也撒遍欧洲纹章。","symbolSize":50,"category":"图记谱系"},{"name":"都铎玫瑰","des":"红白玫瑰合一：结束玫瑰战争的王朝广告。","symbolSize":40,"category":"图记谱系"},{"name":"圆饼图记","des":"roundel：圆饼记号，金饼bezant源自拜占庭金币。","symbolSize":40,"category":"图记谱系"},{"name":"平民图记","des":"马刺、犁铧、磨盘：市民与行会纹章里的烟火气。","symbolSize":40,"category":"图记谱系"},{"name":"纹章狮","des":"纹章第一动物：从英格兰到苏格兰到挪威，狮满欧洲。","symbolSize":50,"category":"动物寓言"},{"name":"行走狮与直立狮","des":"passant三只行走，rampant后足人立：姿态即身份。","symbolSize":40,"category":"动物寓言"},{"name":"双头鹰","des":"一头望东一头望西：拜占庭留给帝国们的遗产。","symbolSize":50,"category":"动物寓言"},{"name":"单头鹰","des":"德意志联邦之鹰与波兰白鹰：鹰族的西支与东支。","symbolSize":40,"category":"动物寓言"},{"name":"狮鹫","des":"鹰首狮身：力量与警觉双修的守门神兽。","symbolSize":40,"category":"动物寓言"},{"name":"独角兽","des":"系着锁链的纯洁兽：苏格兰的扶盾兽。","symbolSize":40,"category":"动物寓言"},{"name":"鹿猪熊","des":"森林三贵族：德语区城市纹章的主力图记。","symbolSize":40,"category":"动物寓言"},{"name":"鱼与海兽","des":"渔村港市的户口：水产纹章自成一脉。","symbolSize":40,"category":"动物寓言"},{"name":"姿态术语库","des":"couchant、salient、regardant：动物纹章的动词变位表。","symbolSize":40,"category":"动物寓言"},{"name":"头盔与冠","des":"骑士盔到贵族冠：盔式开口与羽饰标记等级。","symbolSize":40,"category":"纹章全身"},{"name":"披风","des":"mantling：从盔后披下的斗篷残影，常画成被剑撕碎的样子。","symbolSize":40,"category":"纹章全身"},{"name":"扶盾者","des":"supporters：盾两侧的人兽，等级制度的活化石。","symbolSize":40,"category":"纹章全身"},{"name":"铭言带","des":"motto scroll：盾下的绶带，家训一句话。","symbolSize":40,"category":"纹章全身"},{"name":"冠冕等级","des":"公侯伯子男：coronet上珍珠银球的数目皆有谱。","symbolSize":40,"category":"纹章全身"},{"name":"嘉德纹章","des":"蓝袜带环绕的王室大纹章：英格兰荣誉体系的顶点。","symbolSize":40,"category":"纹章全身"},{"name":"英格兰三狮","des":"理查一世的三个金行走狮：今天还印在英格兰球衣上。","symbolSize":50,"category":"家族与国家纹章"},{"name":"法兰西鸢尾","des":"圣路易时代的净化符号：无数蓝底金鸢尾的王旗。","symbolSize":40,"category":"家族与国家纹章"},{"name":"城堡与狮子","des":"卡斯蒂利亚的城堡与莱昂的狮子：西班牙国徽的两大件。","symbolSize":40,"category":"家族与国家纹章"},{"name":"帝国鹰脉","des":"罗马鹰到神圣罗马双头鹰：帝位正统的图腾传递。","symbolSize":40,"category":"家族与国家纹章"},{"name":"俄罗斯双头鹰","des":"1472年迎娶拜占庭公主后启用，1993年重登国徽。","symbolSize":40,"category":"家族与国家纹章"},{"name":"奥地利之鹰","des":"双头改单头、锤镰换镰锤：断喙之鹰的国徽浮沉。","symbolSize":40,"category":"家族与国家纹章"},{"name":"美国国徽","des":"1782年定稿：秃鹰执箭与橄榄枝，金字塔上全视之眼。","symbolSize":50,"category":"家族与国家纹章"},{"name":"城市纹章","des":"巴黎的船、汉堡的城门：中世纪市镇的自我介绍。","symbolSize":40,"category":"家族与国家纹章"},{"name":"大学纹章","des":"牛津摊开的书、剑桥的貂皮底：学袍上的门第。","symbolSize":40,"category":"家族与国家纹章"},{"name":"行会纹章","des":"伦敦同业公会的工具箱：从裁缝到金匠各执一盾。","symbolSize":40,"category":"家族与国家纹章"},{"name":"香港殖民纹章","des":"1997年随政权交接落幕：纹章也是主权的注脚。","symbolSize":40,"category":"家族与国家纹章"},{"name":"保时捷盾徽","des":"符腾堡的鹿角与斯图加特市跃马：纹章直译成商标。","symbolSize":40,"category":"现代生命"},{"name":"法拉利跃马","des":"王牌飞行员座机上的黑马遗赠：恩佐把它漆上黄底。","symbolSize":40,"category":"现代生命"},{"name":"宝马蓝白","des":"巴伐利亚州旗色：圆形分成四象限的「螺旋桨」传说。","symbolSize":40,"category":"现代生命"},{"name":"星巴克塞壬","des":"双尾美人鱼：纹章学里的经典母题上了咖啡杯。","symbolSize":40,"category":"现代生命"},{"name":"军徽与部队徽","des":"中队徽章与臂章：现代军队的微型纹章系统。","symbolSize":40,"category":"现代生命"},{"name":"城市品牌复兴","des":"市徽重绘与城市视觉系统：纹章学的当代还魂。","symbolSize":40,"category":"现代生命"},{"name":"护照上的纹章","des":"国徽印上护照、货币与政府门楣：最日常的国家符号。","symbolSize":40,"category":"现代生命"},{"name":"同姓同徽陷阱","des":"商场里「你的姓氏家徽」多是噱头：纹章属于家系不属于姓氏。","symbolSize":40,"category":"现代生命"}],"links":[{"source":"纹章学","target":"比武场的认脸术","name":"出生地","des":"学科诞生于骑士文化的黄金年代。"},{"source":"纹章学","target":"提香法则","name":"铁律","des":"配色法则是纹章识别系统的底层逻辑。"},{"source":"纹章学","target":"纹章狮","name":"主角","des":"百兽之王霸占了半数欧洲纹章。"},{"source":"纹章学","target":"英格兰三狮","name":"国徽","des":"最著名的国家纹章样本。"},{"source":"纹章学","target":"美国国徽","name":"新大陆","des":"无贵族的美国照样继承了纹章语法。"},{"source":"纹章学","target":"保时捷盾徽","name":"今生","des":"盾形徽记活在今天的车头与杯身。"},{"source":"纹章学","target":"纹章官","name":"从业者","des":"先有唱名人，后有登记官，再有学问。"},{"source":"比武场的认脸术","target":"纹章官","name":"唱名","des":"认旗识君的职能催生了纹章官职业。"},{"source":"纹章官","target":"英国纹章院","name":"建院","des":"流浪的纹章官最终在伦敦落籍办公。"},{"source":"英国纹章院","target":"纹章的继承法","name":"执掌","des":"血统登记与授予裁定由纹章院说了算。"},{"source":"里昂纹章院","target":"纹章的继承法","name":"更严","des":"苏格兰把私用纹章当刑事案件办理。"},{"source":"英国纹章院","target":"加拿大纹章局","name":"分店","des":"加拿大先请英国授予，后自设纹章局。"},{"source":"纹章官","target":"纹章的法语","name":"行话","des":"诺曼官话随纹章官的册子传遍欧洲。"},{"source":"纹章的继承法","target":"区别标记","name":"细则","des":"继承规则细化到每个儿子的记号。"},{"source":"区别标记","target":"长子横条","name":"长子","des":"三横条是长子专属的临时身份牌。"},{"source":"纹章的继承法","target":"四分法","name":"并账","des":"家系合并让盾面越分越碎。"},{"source":"四分法","target":"盾面分割","name":"延续","des":"分割线既是刀法也是家谱学。"},{"source":"盾形画布","target":"盾面分割","name":"下刀","des":"画布备好，分割定构图骨架。"},{"source":"盾形画布","target":"菱形女盾","name":"女版","des":"无剑可佩的女性用菱形画布。"},{"source":"菱形女盾","target":"婚姻并列","name":"出嫁","des":"婚姻让菱形盾与夫盾并成一盾。"},{"source":"婚姻并列","target":"四分法","name":"变体","des":"并列与四分是两家合璧的两种写法。"},{"source":"以盾为本的左右","target":"盾形画布","name":"坐标","des":"方位描述一切以盾自身为基准。"},{"source":"提香法则","target":"金属色","name":"第一类","des":"金银两色构成法则的一极。"},{"source":"提香法则","target":"五色系","name":"第二类","des":"红蓝黑绿紫构成法则的另一极。"},{"source":"提香法则","target":"毛皮纹","name":"例外","des":"两属的毛皮纹是法则的润滑剂。"},{"source":"耶路撒冷十字","target":"提香法则","name":"破戒","des":"王位至高，配色铁律也为之让路。"},{"source":"五色系","target":"色彩的语义","name":"释义","des":"每种颜色都被写进道德词典。"},{"source":"普通图记","target":"纹章十字","name":"大宗","des":"十字是普通图记里最大的家族。"},{"source":"普通图记","target":"斜带","name":"成员","des":"斜带是横竖带之外的第三刀。"},{"source":"普通图记","target":"山形纹","name":"成员","des":"人字梁从屋顶走上盾面与肩章。"},{"source":"圆饼图记","target":"普通图记","name":"小件","des":"圆饼属于次级图记的常见款。"},{"source":"鸢尾花","target":"法兰西鸢尾","name":"成名","des":"一朵花从圣徒符号升为王权签名。"},{"source":"都铎玫瑰","target":"英格兰三狮","name":"续章","des":"都铎把红白玫瑰缝上英格兰盾徽。"},{"source":"平民图记","target":"行会纹章","name":"入城","des":"工具与手艺上了盾，行会有了自己的徽。"},{"source":"纹章狮","target":"行走狮与直立狮","name":"变姿","des":"同是狮，走卧立跳各有术语。"},{"source":"英格兰三狮","target":"行走狮与直立狮","name":"用姿","des":"三狮取passant行走式，红舌红爪。"},{"source":"行走狮与直立狮","target":"姿态术语库","name":"词典","des":"姿态词汇量足以写一本小字典。"},{"source":"双头鹰","target":"帝国鹰脉","name":"正统","des":"帝国继承人凭双头鹰认祖归宗。"},{"source":"帝国鹰脉","target":"俄罗斯双头鹰","name":"东传","des":"莫斯科自封第三罗马接走双头鹰。"},{"source":"帝国鹰脉","target":"奥地利之鹰","name":"西守","des":"哈布斯堡与双头鹰绑定七百年。"},{"source":"双头鹰","target":"单头鹰","name":"同宗","des":"单头双头都是罗马军团的鹰旗后裔。"},{"source":"俄罗斯双头鹰","target":"奥地利之鹰","name":"两鹰","des":"东西两帝各执一鹰互争正统。"},{"source":"狮鹫","target":"纹章狮","name":"混血","des":"鹰首借了狮身，两强合一。"},{"source":"独角兽","target":"扶盾者","name":"上岗","des":"锁链独角兽是苏格兰王徽的扶盾兽。"},{"source":"鹿猪熊","target":"城市纹章","name":"进城","des":"森林动物是德语区市徽常客。"},{"source":"鱼与海兽","target":"城市纹章","name":"临水","des":"渔港城市把渔获画上盾面。"},{"source":"头盔与冠","target":"披风","name":"相连","des":"披风从头盔后缘垂落下来。"},{"source":"披风","target":"比武场的认脸术","name":"残影","des":"披风被剑撕碎的画法纪念比武场。"},{"source":"扶盾者","target":"冠冕等级","name":"门槛","des":"能请得起扶盾者是爵位的证明。"},{"source":"铭言带","target":"嘉德纹章","name":"配言","des":"嘉德环下悬着王室格言。"},{"source":"冠冕等级","target":"嘉德纹章","name":"顶层","des":"嘉德体系是英格兰荣誉的金字塔尖。"},{"source":"英格兰三狮","target":"嘉德纹章","name":"入环","des":"三狮盾被蓝袜带环绕成大纹章。"},{"source":"法兰西鸢尾","target":"城堡与狮子","name":"并邻","des":"鸢尾与城堡狮子同属王家纹章语汇。"},{"source":"城堡与狮子","target":"四分法","name":"拼盘","des":"西班牙国徽是四分法的教科书案例。"},{"source":"美国国徽","target":"单头鹰","name":"借鹰","des":"秃鹰执盾，欧式纹章语汇新大陆造句。"},{"source":"美国国徽","target":"铭言带","name":"铭言","des":"鹰喙衔着合众为一的绶带。"},{"source":"城市纹章","target":"大学纹章","name":"同源","des":"大学徽常从城市纹章借料。"},{"source":"大学纹章","target":"英国纹章院","name":"颁授","des":"古老大学的纹章多有官方授予文书。"},{"source":"行会纹章","target":"平民图记","name":"图谱","des":"行会盾面就是一部工具图谱。"},{"source":"香港殖民纹章","target":"城市纹章","name":"类目","des":"殖民城市纹章是城市纹章的特辑。"},{"source":"保时捷盾徽","target":"城市纹章","name":"直译","des":"斯图加特市徽跃马直接进了车标。"},{"source":"法拉利跃马","target":"保时捷盾徽","name":"同马","des":"两匹跃马同源斯图加特，各奔前程。"},{"source":"宝马蓝白","target":"城市纹章","name":"借色","des":"蓝白格来自巴伐利亚州旗色。"},{"source":"星巴克塞壬","target":"姿态术语库","name":"母题","des":"双尾塞壬是纹章古籍里的老住户。"},{"source":"军徽与部队徽","target":"嘉德纹章","name":"语法","des":"部队徽章沿用绶带、星芒等纹章语法。"},{"source":"城市品牌复兴","target":"城市纹章","name":"重绘","des":"老市徽被简化重绘进城市视觉系统。"},{"source":"城市品牌复兴","target":"纹章学","name":"还魂","des":"老纹章被简化重绘，回到当代人的视野。"},{"source":"护照上的纹章","target":"美国国徽","name":"落地","des":"国徽印在护照封面上天天出境。"},{"source":"同姓同徽陷阱","target":"纹章的继承法","name":"普法","des":"纹章跟家系走，姓氏商店的图谱不可信。"},{"source":"盾面分割","target":"普通图记","name":"近亲","des":"一刀分盾与成块占盾，同为盾面构图的基本语法。"},{"source":"城市纹章","target":"平民图记","name":"取材","des":"市镇的自我介绍，一半取自犁铧磨盘的烟火词汇。"}],"title":"纹章学","description":"盾牌上的家谱：从中世纪比武场到现代国徽与商标的图案识别系统。"}