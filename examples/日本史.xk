{
  "version": 2,
  "nodes": [
    { "name": "绳文时代", "des": "公元前万余年至前三世纪的狩猎采集时代，绳纹陶器与贝冢记录着列岛最早的生活。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "弥生时代", "des": "水稻耕作与金属器自大陆传入，农耕村落兴起，贫富分化与部落国家雏形初现。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "古坟时代", "des": "三至七世纪畿内大和势力扩张的时代，前方后圆坟遍布列岛，骑马文物陆续渡来。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "邪马台国", "des": "《魏志倭人传》所载二世纪的早期国家，三十余国共推女王，位置至今成谜。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "卑弥呼", "des": "邪马台国女王，事鬼道以惑众，遣使魏廷受亲魏倭王金印。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "大和政权", "des": "起于奈良盆地的畿内联盟，逐步统一列岛，氏姓制度与出使南朝并行。", "symbolSize": 50, "category": "古代国家形成" },
    { "name": "佛教传入", "des": "六世纪中叶自百济传入，苏我氏与物部氏的崇废之争，终以飞鸟佛教生根。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "圣德太子", "des": "推古朝摄政，遣使通隋、兴隆佛法，为律令国家奠基的先驱。", "symbolSize": 50, "category": "古代国家形成" },
    { "name": "十七条宪法", "des": "604年太子所颁官人训诫，以儒佛义理定君臣之序，日本最早的施政纲领。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "遣隋使", "des": "推古朝五度遣使，国书日出处天子致日落处天子，争对等之名。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "遣唐使", "des": "630至894年间十余批次的官派使团，典章、佛法与技术由此渡海而来。", "symbolSize": 50, "category": "古代国家形成" },
    { "name": "大化改新", "des": "645年乙巳之变后孝德朝的改革，公地公民、班田收授，仿唐制立中央集权。", "symbolSize": 50, "category": "古代国家形成" },
    { "name": "律令制", "des": "以大宝令与养老令为骨架的官制法典体系，二官八省一台的东亚式国家。", "symbolSize": 50, "category": "古代国家形成" },
    { "name": "奈良时代", "des": "710至794年平城京的时代，遣唐使全盛、国史修撰与佛教国家化的年代。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "平安时代", "des": "794至1185年平安京的四百年，国风文化烂熟，也见证了律令的瓦解与武家的抬头。", "symbolSize": 50, "category": "古代国家形成" },
    { "name": "古事记", "des": "712年成书的最早史书，从神话记至推古朝，国学尊为直通古道的圣典。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "万叶集", "des": "二十卷和歌总集，从天皇挽歌到防人东歌，奈良时代的情感百科。", "symbolSize": 40, "category": "古代国家形成" },
    { "name": "摄关政治", "des": "藤原氏以外戚垄断摄政关白，与天皇共治却架空天皇的宫廷政治。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "庄园制", "des": "贵族寺社广占不输不入的私有地产，侵蚀公地，孕育了武装的庄官阶层。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "武士", "des": "以骑射为业的在地军事贵族，从庄园护卫成长为国家的实际主宰。", "symbolSize": 50, "category": "武家崛起" },
    { "name": "武士道", "des": "忠于主君、惜名轻死的武家伦理，江户儒学化后成为士族的精神宪章。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "平清盛", "des": "首位登上权力顶峰的武家栋梁，平氏一门公卿化，骄满招覆。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "源平合战", "des": "1180至1185年源氏平氏争夺天下的战争，坛之浦一役平氏灭门。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "源赖朝", "des": "镰仓幕府开创者，流放蛰居二十年后举兵，以关东为基业统御全国武士。", "symbolSize": 50, "category": "武家崛起" },
    { "name": "镰仓幕府", "des": "1192至1333年日本首个武家政权，御恩奉公的主从网络取代律令官制。", "symbolSize": 50, "category": "武家崛起" },
    { "name": "北条执权", "des": "北条氏世代以执权之职掌幕府实权，得宗专制与御内人的双重政治。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "元日战争", "des": "1274与1281年两度击退元军东征，神风传说的背后是恩赏破产。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "建武新政", "des": "后醍醐天皇亲政的复古实验，两年而败，却是南朝正朔之始。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "足利尊氏", "des": "背弃建武新政而另开幕府的武家领袖，南北朝分立的始作俑者。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "室町幕府", "des": "1338至1573年的足利政权，将军权威依赖守护大名平衡而终告瓦解。", "symbolSize": 50, "category": "武家崛起" },
    { "name": "南北朝", "des": "1336至1392年吉野与京都两天皇并立的对立时代，观应扰乱更使武家内讧。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "足利义满", "des": "三代将军，合一南北朝，建金阁而开勘合贸易，足利政权的极盛期。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "倭寇", "des": "十四至十六世纪出没于东亚海域的武装海商集团，成员中日朝混杂。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "勘合贸易", "des": "室町与明朝以勘合符验控制的朝贡贸易，生丝换铜钱的官方航路。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "应仁之乱", "des": "1467年起畿内十年大战，两军对峙京都化为焦土，战国时代由此开启。", "symbolSize": 40, "category": "武家崛起" },
    { "name": "战国大名", "des": "以下克上自立的领国领主，检地、刀狩与家臣团改组铸成一国一城。", "symbolSize": 50, "category": "战国与统一" },
    { "name": "武田信玄", "des": "甲斐之虎，风林火山旗号下以骑马军团纵横信浓，上洛途中病殁。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "上杉谦信", "des": "越后之龙，自许毗沙门天化身，义之名分下五度决战川中岛。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "织田信长", "des": "以尾张一隅起步的天下布武者，铁炮、乐市与火烧比睿山的革命者。", "symbolSize": 60, "category": "战国与统一" },
    { "name": "桶狭间之战", "des": "1560年雨中奇袭，今川义元授首，信长自此跃入争霸主战场。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "长筱之战", "des": "1575年织田德川联军以铁炮三段击破武田骑马军团，战史的分水岭。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "一向一揆", "des": "净土真宗门徒的武装起义，以石山本愿寺为中心对抗信长达十年。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "本能寺之变", "des": "1582年明智光秀夜袭，天下人信长殒命火中，历史急转直下。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "丰臣秀吉", "des": "自草履取起的天下人，统一列岛、总无事令与太阁检地的设计者。", "symbolSize": 60, "category": "战国与统一" },
    { "name": "太阁检地", "des": "以石高统一丈量全国的清账运动，一地一作人与赋役体系的基石。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "刀狩令", "des": "1588年没收农民武器的法令，兵农分离的关键一步。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "文禄庆长之役", "des": "1592与1597年两度渡海侵朝，庆长之役中秀吉殁而全线撤兵。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "德川家康", "des": "人质半生、隐忍成王的江户开创者，以等待熬死两代天下人的竹千代。", "symbolSize": 60, "category": "战国与统一" },
    { "name": "关原之战", "des": "1600年东西军天下分目的一战，小早川倒戈定局，德川霸权确立。", "symbolSize": 50, "category": "战国与统一" },
    { "name": "大坂之阵", "des": "1614至1615年冬夏两役，丰臣氏灭亡，元和偃武开启太平。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "沙勿略", "des": "1549年抵鹿儿岛的耶稣会传教士，将天主教与南蛮器物一并带入。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "南蛮贸易", "des": "与葡萄牙西班牙的海上贸易，铁炮、烟草与蛋糕交换日本的白银。", "symbolSize": 40, "category": "战国与统一" },
    { "name": "江户幕府", "des": "1603至1867年德川政权，两百余年的太平与锁国，世界最大级的都市治理。", "symbolSize": 60, "category": "江户时代" },
    { "name": "幕藩体制", "des": "将军直辖与二百六十藩并立的国家结构，石高知行与参勤交代的控驭术。", "symbolSize": 50, "category": "江户时代" },
    { "name": "参勤交代", "des": "大名隔年江户驻府的轮替制度，妻质于人，财耗于路。", "symbolSize": 40, "category": "江户时代" },
    { "name": "锁国", "des": "1630年代禁教与贸易管制并举的国策，仅留长崎一窗与两蕃贸易。", "symbolSize": 50, "category": "江户时代" },
    { "name": "德川吉宗", "des": "八代将军，享保改革的主持人，享保改革令名与米价一样起落。", "symbolSize": 40, "category": "江户时代" },
    { "name": "享保改革", "des": "将军亲政、上米令与新田开发的幕政重振，江户三改革之首。", "symbolSize": 40, "category": "江户时代" },
    { "name": "元禄文化", "des": "元禄年间以大阪町人为中心的文化高潮，人形净琉璃与浮世草子烂熟。", "symbolSize": 40, "category": "江户时代" },
    { "name": "松尾芭蕉", "des": "俳圣，奥之细道的纪行与不易流行之说，把俳谐提升为艺术。", "symbolSize": 40, "category": "江户时代" },
    { "name": "化政文化", "des": "化成天保年间江户町人的文化第二波，读本、合卷与狂歌并盛。", "symbolSize": 40, "category": "江户时代" },
    { "name": "浮世绘", "des": "庶民的浮世之绘，役者绘、美人绘与名所绘，雕与拓的分工工房。", "symbolSize": 50, "category": "江户时代" },
    { "name": "葛饰北斋", "des": "画狂老人，富岳三十六景与神奈川冲浪里，影响印象派的浮世绘巨匠。", "symbolSize": 40, "category": "江户时代" },
    { "name": "国学", "des": "契冲到宣长的学问谱系，以文献实证直契日本古道的复古之学。", "symbolSize": 40, "category": "江户时代" },
    { "name": "本居宣长", "des": "国学的集大成者，四十年成《古事记传》，物哀论的发现者。", "symbolSize": 40, "category": "江户时代" },
    { "name": "兰学", "des": "经荷兰语研习西方学术的学问，解剖学译业与《兰学阶梯》的师承网。", "symbolSize": 40, "category": "江户时代" },
    { "name": "黑船来航", "des": "1853年佩里率四艘黑船叩关浦贺，两百年锁国体制一夕瓦解。", "symbolSize": 50, "category": "幕末与明治" },
    { "name": "尊王攘夷", "des": "尊王室、逐外夷的激进的浪潮，从樱田门到下关炮台的时代口号。", "symbolSize": 40, "category": "幕末与明治" },
    { "name": "吉田松阴", "des": "松下村塾的青年导师，野山狱中论天下，门生半数成维新元勋。", "symbolSize": 40, "category": "幕末与明治" },
    { "name": "坂本龙马", "des": "土佐脱藩浪士，海援队的传奇，船中八策促成大政奉还的枢纽。", "symbolSize": 50, "category": "幕末与明治" },
    { "name": "西乡隆盛", "des": "萨摩的巨人，戊辰战争的军略家，征韩论争后败于西南战争。", "symbolSize": 50, "category": "幕末与明治" },
    { "name": "大政奉还", "des": "1867年庆喜奉还政权于天皇，幕府三百年和平落幕。", "symbolSize": 50, "category": "幕末与明治" },
    { "name": "戊辰战争", "des": "1868至1869年新政府军的统一战争，鸟羽伏见到箱馆五棱郭。", "symbolSize": 40, "category": "幕末与明治" },
    { "name": "明治维新", "des": "十九世纪后半的建国工程，富国强兵、文明开化与中央集权三位一体。", "symbolSize": 70, "category": "幕末与明治" },
    { "name": "岩仓使节团", "des": "1871至1873年半元老历访欧美十二国，条约改正未成而取回制度范本。", "symbolSize": 40, "category": "幕末与明治" },
    { "name": "废藩置县", "des": "1871年一举废除二百六十藩，华族士族授爵，郡县制贯通列岛。", "symbolSize": 40, "category": "幕末与明治" },
    { "name": "殖产兴业", "des": "官营模范工厂与劝业政策，从富冈制丝到铁路电信的产业移植。", "symbolSize": 40, "category": "幕末与明治" },
    { "name": "文明开化", "des": "剪发脱刀与牛肉锅的时代风潮，明六社与新闻纸的启蒙空气。", "symbolSize": 40, "category": "幕末与明治" },
    { "name": "学制", "des": "1872年颁布的近代教育法典，强迫教育起步，师范学校网络铺开。", "symbolSize": 40, "category": "幕末与明治" },
    { "name": "自由民权运动", "des": "1874至1880年代争取国会与宪法的国民运动，立志社与国会期成同盟。", "symbolSize": 40, "category": "幕末与明治" },
    { "name": "大日本帝国宪法", "des": "1889年钦定宪法，天皇总揽统治权而设帝国议会，普鲁士式的骨架。", "symbolSize": 50, "category": "幕末与明治" },
    { "name": "日清战争", "des": "1894至1895年甲午之战，马关条约得台湾而跻身列强行列。", "symbolSize": 40, "category": "幕末与明治" },
    { "name": "日俄战争", "des": "1904至1905年对俄开战，对马海战大捷，首胜欧洲列强的亚洲国家。", "symbolSize": 50, "category": "幕末与明治" },
    { "name": "大正民主", "des": "大正年间政党政治与普选运动的高潮，普通选举法1925年实现。", "symbolSize": 40, "category": "近现代" },
    { "name": "军部政治", "des": "统帅权独立坐大的军部干政，从干政到主政的滑落过程。", "symbolSize": 40, "category": "近现代" },
    { "name": "九一八事变", "des": "1931年关东军自炸南满铁路而夺东北，国际联盟调查不果。", "symbolSize": 40, "category": "近现代" },
    { "name": "日中战争", "des": "1937年卢沟桥事变起的长战争，战线越拉越长而胜机日消。", "symbolSize": 40, "category": "近现代" },
    { "name": "太平洋战争", "des": "1941至1945年对美英的总体战，从真珠湾到败战的四年。", "symbolSize": 50, "category": "近现代" },
    { "name": "广岛与长崎", "des": "1945年8月两颗原子弹，人类战争史上首次核攻击。", "symbolSize": 40, "category": "近现代" },
    { "name": "战后改革", "des": "占领下的五大改革指令，财阀解体、农地改革与公职追放。", "symbolSize": 40, "category": "近现代" },
    { "name": "和平宪法", "des": "1947年施行的新宪法，主权在民、象征天皇与永远放弃战争的第九条。", "symbolSize": 50, "category": "近现代" },
    { "name": "日美安保条约", "des": "1951年缔结、1960年改定的同盟轴心，基地与保护的交换。", "symbolSize": 40, "category": "近现代" },
    { "name": "朝鲜战争特需", "des": "1950年起联合国军的日本采购，为战后经济输的第一管血。", "symbolSize": 40, "category": "近现代" },
    { "name": "高速增长", "des": "1955至1973年神武景气以来的奇迹增长，所得倍增计划与三神器。", "symbolSize": 50, "category": "近现代" },
    { "name": "东京奥运会", "des": "1964年的亚洲首届奥运，新干线开通与国家形象的重生典礼。", "symbolSize": 40, "category": "近现代" },
    { "name": "广场协议", "des": "1985年五国汇率的协调干预，日元自此急升而出口承压。", "symbolSize": 40, "category": "近现代" },
    { "name": "泡沫经济", "des": "1980年代末地价股价的双双狂涨，银座的夜与卖掉东京买美国的狂言。", "symbolSize": 40, "category": "近现代" },
    { "name": "失去的十年", "des": "1990年代泡沫破灭后的长期停滞，银行坏账与通缩的漫长隧道。", "symbolSize": 40, "category": "近现代" },
    { "name": "冲绳返还", "des": "1972年施政权归还日本，基地问题延续至今。", "symbolSize": 40, "category": "近现代" }
