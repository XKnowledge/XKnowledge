{"version":2,"nodes":[{"name":"音名","des":"C、D、E、F、G、A、B，七个字母为乐音定下的身份证。","symbolSize":40,"category":"音程"},{"name":"唱名","des":"do、re、mi、fa、sol、la、si，音阶各音级的人声化称呼。","symbolSize":40,"category":"音程"},{"name":"八度","des":"频率比为二比一的音程，翻过一个循环又遇同名音。","symbolSize":50,"category":"音程"},{"name":"半音","des":"键盘上相邻两键的距离，西方乐理最小的音程单位。","symbolSize":50,"category":"音程"},{"name":"全音","des":"两个半音合成的距离，音阶搭建的基本砖块。","symbolSize":40,"category":"音程"},{"name":"音数","des":"音程所含全音的数目，判定大小纯增减的标尺。","symbolSize":40,"category":"音程"},{"name":"大三度","des":"含两个全音的三度音程，和声明亮色彩的源头。","symbolSize":50,"category":"音程"},{"name":"小三度","des":"含一全一半的三度音程，和声暗淡色彩的源头。","symbolSize":50,"category":"音程"},{"name":"纯五度","des":"仅次于纯八度的协和音程，撑起三和弦的骨架。","symbolSize":50,"category":"音程"},{"name":"三全音","des":"三个全音的音程，中世纪号称\"音乐中的魔鬼\"。","symbolSize":50,"category":"音程"},{"name":"协和音程","des":"听起来融洽安定的音程，纯四五八度与大小三六度。","symbolSize":40,"category":"音程"},{"name":"十二平均律","des":"把一个八度均分为十二个相等半音的律制，现代音乐的底层坐标。","symbolSize":70,"category":"音阶与调式"},{"name":"大调音阶","des":"全全半全全全半的七声排列，色彩明朗，调性音乐的默认模式。","symbolSize":50,"category":"音阶与调式"},{"name":"自然小调","des":"全半全全半全全的七声排列，与大调同主相对的暗色镜像。","symbolSize":50,"category":"音阶与调式"},{"name":"和声小调","des":"升高第七级的小调，换来一个坚决导向主音的导音。","symbolSize":40,"category":"音阶与调式"},{"name":"五声音阶","des":"省去半音关系的五个音，中国风与民谣旋律的宠儿。","symbolSize":40,"category":"音阶与调式"},{"name":"布鲁斯音阶","des":"小调五声加入降五音蓝调音，忧郁与摇摆的化学配方。","symbolSize":40,"category":"音阶与调式"},{"name":"中古调式","des":"伊奥尼亚、多利亚等教会调式，比大小调更古老的七种味道。","symbolSize":40,"category":"音阶与调式"},{"name":"升号调","des":"调号中带升号的调，沿五度圈顺时针每站添一个升号。","symbolSize":40,"category":"音阶与调式"},{"name":"降号调","des":"调号中带降号的调，沿五度圈逆时针每站添一个降号。","symbolSize":40,"category":"音阶与调式"},{"name":"三和弦","des":"三个音按三度叠置而成的和弦，和声大厦的最小承重单元。","symbolSize":50,"category":"和弦"},{"name":"大三和弦","des":"下方大三度叠上方小三度，明亮安定，是大调之\"家\"。","symbolSize":70,"category":"和弦"},{"name":"小三和弦","des":"下方小三度叠上方大三度，温柔内敛，是小调之\"家\"。","symbolSize":50,"category":"和弦"},{"name":"增三和弦","des":"两个大三度叠置，五度被撑大，悬浮而不安。","symbolSize":40,"category":"和弦"},{"name":"减三和弦","des":"两个小三度叠置，五度被压小，紧张而想逃。","symbolSize":40,"category":"和弦"},{"name":"七和弦","des":"三和弦之上再叠一个三度而成，四音结构让张力升级。","symbolSize":50,"category":"和弦"},{"name":"大七和弦","des":"大三和弦上加一个大七度，朦胧梦幻的都市夜色。","symbolSize":40,"category":"和弦"},{"name":"属七和弦","des":"大三和弦上加一个小七度，和声引擎，最急切解决的和弦。","symbolSize":70,"category":"和弦"},{"name":"挂留和弦","des":"三音被二音或四音取代的和弦，悬而未决的中性感。","symbolSize":40,"category":"和弦"},{"name":"和弦转位","des":"根音离开低音部的排列方式，让低声部走出旋律线。","symbolSize":40,"category":"和弦"},{"name":"和弦外音","des":"经过音、倚音等和弦结构之外的音，旋律的调味料。","symbolSize":40,"category":"和弦"},{"name":"调号","des":"谱号后方的升降号，一纸预先公告，划定全曲的调性领地。","symbolSize":50,"category":"调性与转调"},{"name":"五度圈","des":"以纯五度为一步串起十二个调的圆环，乐理的万能罗盘。","symbolSize":50,"category":"调性与转调"},{"name":"关系大小调","des":"共享同一调号的大小调，如 C 大调与 a 小调，一号两户。","symbolSize":40,"category":"调性与转调"},{"name":"同主音大小调","des":"主音相同的大小调，如 C 大调与 c 小调，同院两种脸色。","symbolSize":40,"category":"调性与转调"},{"name":"属调","des":"上方纯五度处的调，最亲近的邻居家，转调的首选去处。","symbolSize":40,"category":"调性与转调"},{"name":"下属调","des":"下方纯五度处的调，与属调一左一右守在主调身旁。","symbolSize":40,"category":"调性与转调"},{"name":"近关系调","des":"调号相差不超过一个升降号的调，互相串门最顺畅。","symbolSize":40,"category":"调性与转调"},{"name":"转调","des":"调中心从一调迁往另一调，音乐叙事中的换景。","symbolSize":50,"category":"调性与转调"},{"name":"离调","des":"短暂造访他调又立刻返回，像和声的一次深呼吸。","symbolSize":40,"category":"调性与转调"},{"name":"移调","des":"把乐曲整体平移到另一调高，形状不变、位置改变。","symbolSize":40,"category":"调性与转调"},{"name":"拍号","des":"谱表开头的分数：分母定拍单位，分子定每小节拍数。","symbolSize":50,"category":"节奏节拍"},{"name":"四四拍","des":"每小节四拍、强弱次强弱，流行音乐的默认律动。","symbolSize":40,"category":"节奏节拍"},{"name":"三四拍","des":"每小节三拍、强弱弱，圆舞曲摇曳起伏的骨架。","symbolSize":40,"category":"节奏节拍"},{"name":"八六拍","des":"每小节两大拍、各含三小拍的复合律动，摇曳又前行。","symbolSize":40,"category":"节奏节拍"},{"name":"音符时值","des":"全音符、二分音符、四分音符等，记录音长短的度量衡。","symbolSize":40,"category":"节奏节拍"},{"name":"附点音符","des":"音符加附点，时值延长一半，把重量悄悄挪后。","symbolSize":40,"category":"节奏节拍"},{"name":"切分音","des":"重音落在意想不到的弱位，把规整律动拧出摇摆。","symbolSize":40,"category":"节奏节拍"},{"name":"三连音","des":"把单位拍均分为三份，与二等分秩序唱反调的活力。","symbolSize":40,"category":"节奏节拍"},{"name":"休止符","des":"记录静默的时值符号，此时无声胜有声。","symbolSize":40,"category":"节奏节拍"},{"name":"速度术语","des":"Allegro、Adagio 等意大利语标记，为音乐定脉搏快慢。","symbolSize":40,"category":"节奏节拍"},{"name":"主和弦","des":"建立在第一级上的中心和弦，一切引力的归宿，进行的起点与终点。","symbolSize":70,"category":"和声进行"},{"name":"属和弦","des":"建立在第五级上的和弦，张力最强、归心似箭的和弦。","symbolSize":50,"category":"和声进行"},{"name":"下属和弦","des":"建立在第四级上的和弦，主与属之间的色彩中转站。","symbolSize":50,"category":"和声进行"},{"name":"功能和声","des":"把和弦按 T、S、D 三种功能组织的体系，调性音乐的语法书。","symbolSize":50,"category":"和声进行"},{"name":"正格终止","des":"属和弦进行到主和弦的收束，一锤定音的句号。","symbolSize":40,"category":"和声进行"},{"name":"变格终止","des":"下属和弦进行到主和弦的收束，教堂阿门式的温柔尾声。","symbolSize":40,"category":"和声进行"},{"name":"复正格终止","des":"K46—属—主的完整终止式，古典收束的满配形态。","symbolSize":40,"category":"和声进行"},{"name":"卡农进行","des":"源自帕赫贝尔卡农的一串和弦套路，流行金曲的万能模板。","symbolSize":40,"category":"和声进行"},{"name":"四五三六进行","des":"IV–V–iii–vi 的和弦循环，Axel F 与无数流行曲的隐形骨架。","symbolSize":40,"category":"和声进行"}],"links":[{"source":"全音","target":"半音","name":"等于","des":"一个全音的宽度，等于两个半音相加。"},{"source":"半音","target":"八度","name":"铺满","des":"十二个半音恰好铺满一个八度。"},{"source":"八度","target":"音名","name":"循环","des":"音名用满七个字母后，从 C 开始新的一轮。"},{"source":"音名","target":"唱名","name":"对应","des":"固定唱名法中 C 唱 do、D 唱 re，一一相认。"},{"source":"半音","target":"音数","name":"折算","des":"音数以半音为最小记账单位，记 0.5。"},{"source":"音数","target":"大三度","name":"判定","des":"音数 2 为大三度，音数 1.5 为小三度。"},{"source":"大三度","target":"小三度","name":"相差","des":"同为三度只差半音，明与暗就此分野。"},{"source":"大三度","target":"纯五度","name":"叠出","des":"大三度再叠一个小三度，就是纯五度。"},{"source":"纯五度","target":"协和音程","name":"归属","des":"纯五度协和安分，属完全协和之列。"},{"source":"三全音","target":"协和音程","name":"背离","des":"三全音刺耳难融，是不协和的极端代表。"},{"source":"大调音阶","target":"自然小调","name":"相对","des":"同主音上全半排布不同，一明一暗。"},{"source":"自然小调","target":"和声小调","name":"改造","des":"升高第七级，补出一个导向主音的导音。"},{"source":"五声音阶","target":"大调音阶","name":"裁剪","des":"去掉第四、七级，七声减为五声。"},{"source":"布鲁斯音阶","target":"五声音阶","name":"衍生","des":"小调五声骨架里掺入蓝音而成。"},{"source":"中古调式","target":"大调音阶","name":"演化","des":"伊奥尼亚调式就是大调的老名字。"},{"source":"中古调式","target":"自然小调","name":"收纳","des":"爱奥尼亚即自然小调，多利亚同属暗色。"},{"source":"升号调","target":"降号调","name":"互补","des":"七升与五降在圈的对面等音相逢。"},{"source":"三和弦","target":"大三和弦","name":"分化","des":"三度叠置出的第一种基本型，色彩明亮。"},{"source":"三和弦","target":"小三和弦","name":"分化","des":"三度叠置出的另一种基本型，色彩柔和。"},{"source":"大三和弦","target":"增三和弦","name":"拉伸","des":"五音升高半音，协和被撑成悬浮。"},{"source":"小三和弦","target":"减三和弦","name":"压缩","des":"五音降低半音，柔和被压成紧张。"},{"source":"七和弦","target":"三和弦","name":"扩展","des":"在三和弦顶上再叠一个三度而成。"},{"source":"大七和弦","target":"七和弦","name":"隶属","des":"大三和弦为底，戴上大七度的帽子。"},{"source":"属七和弦","target":"七和弦","name":"隶属","des":"大三和弦为底，压上小七度的砝码。"},{"source":"挂留和弦","target":"三和弦","name":"替换","des":"三音被四音或二音取代，色彩悬置。"},{"source":"和弦转位","target":"三和弦","name":"重排","des":"低音换人坐镇，和弦身份不变。"},{"source":"和弦外音","target":"三和弦","name":"环绕","des":"经过音、倚音贴着结构音装饰。"},{"source":"减三和弦","target":"七和弦","name":"升格","des":"再叠一个三度，即成减七或半减七。"},{"source":"关系大小调","target":"调号","name":"共享","des":"同一调号里住着大调与小调两户人家。"},{"source":"同主音大小调","target":"关系大小调","name":"对照","des":"一个共享调号，一个共享主音。"},{"source":"五度圈","target":"属调","name":"顺行","des":"顺时针走一步，就是属调。"},{"source":"五度圈","target":"下属调","name":"逆行","des":"逆时针走一步，就是下属调。"},{"source":"属调","target":"下属调","name":"对望","des":"分居主调左右两侧的一对近邻。"},{"source":"近关系调","target":"属调","name":"收录","des":"属调与下属调都是最近的近关系调。"},{"source":"近关系调","target":"下属调","name":"收录","des":"调号只差一个升降号的邻居。"},{"source":"转调","target":"离调","name":"对照","des":"离调是短访，转调是正式迁居。"},{"source":"移调","target":"转调","name":"区别","des":"移调整体平移不改结构，转调更换中心。"},{"source":"转调","target":"近关系调","name":"借助","des":"转调多先在近关系调之间往返。"},{"source":"五度圈","target":"调号","name":"编排","des":"升降号沿五度圈逐站递增。"},{"source":"拍号","target":"四四拍","name":"示例","des":"4/4：四分音符为一拍，每小节四拍。"},{"source":"拍号","target":"三四拍","name":"示例","des":"3/4：圆舞曲的标配拍号。"},{"source":"拍号","target":"八六拍","name":"示例","des":"6/8：复合拍，两大拍各含三小拍。"},{"source":"附点音符","target":"八六拍","name":"支撑","des":"6/8 的律动单位是附点四分音符。"},{"source":"音符时值","target":"附点音符","name":"延长","des":"一个附点让原时值延长一半。"},{"source":"音符时值","target":"休止符","name":"对偶","des":"每种时值都有对应的静默符号。"},{"source":"附点音符","target":"切分音","name":"挤压","des":"附点把重量悄悄挪到弱拍上。"},{"source":"切分音","target":"四四拍","name":"扰动","des":"在规整的四拍律动里错位落重音。"},{"source":"三连音","target":"音符时值","name":"均分","des":"把时值三等分，打破二等分的秩序。"},{"source":"休止符","target":"切分音","name":"合谋","des":"弱位休止把悬念推给下一拍。"},{"source":"速度术语","target":"拍号","name":"搭档","des":"拍号定结构，术语定快慢。"},{"source":"八六拍","target":"三四拍","name":"对照","des":"6/8 是两个三拍组，3/4 是三个两拍组。"},{"source":"主和弦","target":"属和弦","name":"吸引","des":"属和弦归心似箭，被主和弦牢牢吸引。"},{"source":"下属和弦","target":"属和弦","name":"推进","des":"S 到 D，冲向终止前的最后助跑。"},{"source":"主和弦","target":"下属和弦","name":"铺垫","des":"离开主和弦的第一步常走向下属。"},{"source":"功能和声","target":"主和弦","name":"归类","des":"主和弦是 T（中心）功能的化身。"},{"source":"功能和声","target":"属和弦","name":"归类","des":"属和弦是 D（动力）功能的核心。"},{"source":"功能和声","target":"下属和弦","name":"归类","des":"下属和弦是 S（色彩）功能的核心。"},{"source":"正格终止","target":"主和弦","name":"落定","des":"V–I 收束，终点稳稳落在主和弦。"},{"source":"变格终止","target":"下属和弦","name":"出自","des":"IV–I 的教会收束，自带阿门余韵。"},{"source":"复正格终止","target":"正格终止","name":"加强","des":"K46 先行预备，终止式的满配形态。"},{"source":"卡农进行","target":"功能和声","name":"根植","des":"固定套路的背后，是 T–S–D 的功能逻辑。"},{"source":"四五三六进行","target":"卡农进行","name":"同源","des":"IV–V–iii–vi 可视作卡农进行的轮转切片。"},{"source":"复正格终止","target":"属和弦","name":"途经","des":"K46 之后必经属和弦，再奔向主。"},{"source":"十二平均律","target":"半音","name":"定义","des":"八度十二等分，每一份就是一个半音。"},{"source":"三全音","target":"布鲁斯音阶","name":"催生","des":"降五音蓝音的躁动，正来自三全音。"},{"source":"十二平均律","target":"五度圈","name":"闭合","des":"十二等分让五度圈首尾相衔成环。"},{"source":"调号","target":"升号调","name":"书写","des":"升号沿五度圈顺时针逐一登记入号。"},{"source":"调号","target":"降号调","name":"书写","des":"降号沿五度圈逆时针逐一登记入号。"},{"source":"大调音阶","target":"关系大小调","name":"配对","des":"C 大调与 a 小调共用同一批音。"},{"source":"大三度","target":"大三和弦","name":"垫底","des":"下方大三度，奠定明亮基调。"},{"source":"小三度","target":"大三和弦","name":"封顶","des":"上方小三度，收拢成大三家。"},{"source":"小三度","target":"小三和弦","name":"垫底","des":"下方小三度，奠定暗淡基调。"},{"source":"大三度","target":"小三和弦","name":"封顶","des":"上方大三度，收拢成小三家。"},{"source":"纯五度","target":"三和弦","name":"立架","des":"根音到五音以五度立骨，增减为变体。"},{"source":"三全音","target":"属七和弦","name":"内藏","des":"属七的三音到七音，正是一个三全音。"},{"source":"三全音","target":"减三和弦","name":"内含","des":"减三和弦的根音到五音即三全音。"},{"source":"大调音阶","target":"三和弦","name":"派生","des":"音阶每一级上叠三度，得各级三和弦。"},{"source":"和声小调","target":"属七和弦","name":"配备","des":"升高七级后，五级恰好是属七结构。"},{"source":"布鲁斯音阶","target":"属七和弦","name":"共生","des":"在属七和声上滑唱小调蓝音，味道即蓝调。"},{"source":"中古调式","target":"挂留和弦","name":"呼应","des":"sus 近似四度叠置，自带多利亚古风。"},{"source":"大三和弦","target":"主和弦","name":"充当","des":"大调的主和弦，正是一个大三和弦。"},{"source":"小三和弦","target":"主和弦","name":"充当","des":"小调的主和弦，正是一个小三和弦。"},{"source":"大三和弦","target":"下属和弦","name":"充当","des":"大调的下属和弦也是大三和弦。"},{"source":"属七和弦","target":"属和弦","name":"强化","des":"属功能加上七音，动力加倍。"},{"source":"属七和弦","target":"主和弦","name":"解决","des":"三音上行、七音下行，尘埃落定。"},{"source":"挂留和弦","target":"属和弦","name":"铺垫","des":"属七挂四先悬后解，期待感拉满。"},{"source":"和弦转位","target":"复正格终止","name":"支撑","des":"K46 实为主和弦的第二转位。"},{"source":"转调","target":"功能和声","name":"重组","des":"新调确立，T–S–D 的座次随之重排。"},{"source":"转调","target":"正格终止","name":"巩固","des":"进入新调后，常用正格终止盖章确认。"},{"source":"属调","target":"属和弦","name":"命名","des":"属调的主和弦，正是原调的属和弦。"},{"source":"下属调","target":"下属和弦","name":"命名","des":"下属调的主和弦，即原调的下属和弦。"},{"source":"离调","target":"属七和弦","name":"借用","des":"临时属七把和声拽向目标和弦。"},{"source":"四四拍","target":"四五三六进行","name":"承载","des":"流行套路在 4/4 律动上循环往复。"},{"source":"三连音","target":"布鲁斯音阶","name":"调味","des":"shuffle 律动以三连音为底色。"}],"title":"乐理基础","description":"音程、和弦到和声进行的基础乐理图"}