{
  "version": 2,
  "nodes": [
    { "name": "印度河文明", "des": "前2600至前1900年青铜时代的城市文明，印章文字未解，与两河遥有贸易。", "symbolSize": 50, "category": "吠陀与早期文明" },
    { "name": "摩亨佐达罗", "des": "印度河文明代表都邑，网格街衢与全城排水，古代城市规划的孤例。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "哈拉帕", "des": "印度河北岸的另一座重镇，先摩亨佐达罗而发现，遂以之命名全文明。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "雅利安人迁徙", "des": "前二千纪自西北门户分批进入的印欧游牧族群，带来马、铁与吠陀颂诗。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "吠陀时代", "des": "前1500至前600年，部落到王国的漫长过渡，祭祀与史诗共同定型的年代。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "吠陀", "des": "梨俱、娑摩、夜柔、阿闼婆四部本集，口传千年而不易一音的圣典。", "symbolSize": 50, "category": "吠陀与早期文明" },
    { "name": "种姓制度", "des": "婆罗门、刹帝利、吠舍、首陀罗的瓦尔纳体系，职业与通婚的千年网格。", "symbolSize": 60, "category": "吠陀与早期文明" },
    { "name": "十六雄国", "des": "前六世纪佛陀时代的列国竞争格局，共和国与君主国并立争雄。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "摩揭陀", "des": "恒河中游的强国，王舍城与华氏城相继为都，统一印度的起点。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "难陀王朝", "des": "前四世纪摩揭陀的强权，首度整备恒河平原，却亡于旃陀罗笈多。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "亚历山大东征", "des": "前326年马其顿军抵印度河，部下拒进而回师，留下希腊化世界的东缘。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "旃陀罗笈多", "des": "孔雀王朝开创者，赶走西北希腊驻军，晚年传位苦修耆那教。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "孔雀王朝", "des": "前322至前185年首个次大陆帝国，华氏城的官僚与密探系统闻于《政事论》。", "symbolSize": 50, "category": "吠陀与早期文明" },
    { "name": "阿育王", "des": "羯陵伽血战后幡然皈依佛法的皇帝，石敕刻法、遣使弘教，印度史上第一圣王。", "symbolSize": 60, "category": "吠陀与早期文明" },
    { "name": "贵霜帝国", "des": "一至三世纪横跨中亚与北印的骑马者帝国，丝路中介与犍陀罗艺术的赞助者。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "迦腻色伽", "des": "贵霜名王，佛教第四次结集的护持者，金币与佛塔的时代。", "symbolSize": 40, "category": "吠陀与早期文明" },
    { "name": "笈多王朝", "des": "320至550年印度古典黄金时代，梵语文学、数学与神庙艺术的巅峰。", "symbolSize": 50, "category": "古典与中世纪王朝" },
    { "name": "超日王", "des": "笈多盛世之主，抵御匈奴、奖掖诗学，九宝传说的主人。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "戒日王", "des": "七世纪初北印最后的雄主，曲女城无遮大会的东道，与玄奘相知。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "玄奘", "des": "629年西行求法的三藏法师，十七年五万里的取经与译经事业。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "拉杰普特", "des": "自诩刹帝利血统的北印武士集团，城堡与殉节的传奇，德里苏丹的劲敌。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "朱罗王朝", "des": "南印的海上帝国，海军远征东南亚，坦贾武尔大神庙冠绝南印。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "德里苏丹国", "des": "1206至1526年五个王朝相继的突厥-阿富汗政权，伊斯兰统治北印三百年。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "维查耶那加尔", "des": "1336至1646年德干高原的印度教帝国，与巴赫马尼苏丹长期对峙。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "巴布尔", "des": "失国五次的费尔干纳王，1526年帕尼帕特以火器立莫卧儿帝业。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "莫卧儿帝国", "des": "1526至1857年，成吉思汗与帖木儿双重血统的印度帝国，泰姬陵的主人。", "symbolSize": 60, "category": "古典与中世纪王朝" },
    { "name": "阿克巴", "des": "莫卧儿真正奠基者，废除人丁税、创神圣信仰，宽容政治的典范。", "symbolSize": 50, "category": "古典与中世纪王朝" },
    { "name": "奥朗则布", "des": "帝国极盛亦趋衰之主，南征毕生而宗教高压，死后帝国瓦解。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "泰姬陵", "des": "沙贾汗为慕塔芝玛哈所建的陵寺，白大理石的莫卧儿绝唱。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "马拉塔", "des": "希瓦吉起兵的德干山民联盟，十八世纪几乎接替莫卧儿的霸权。", "symbolSize": 40, "category": "古典与中世纪王朝" },
    { "name": "婆罗门教", "des": "吠陀祭祀传统成形的早期印度教形态，以吠陀天启、祭祀万能、婆罗门至上为纲。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "奥义书", "des": "吠陀末期的哲学集成，梵我如一与轮回解脱的追问，印度思想的内核。", "symbolSize": 50, "category": "宗教与思想" },
    { "name": "业与轮回", "des": "行为必有回响的因果律与生死流转观，印度诸教共享的世界观底座。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "达摩", "des": "事物的法则与本分的义务，随语境流转为教法、正法与规律。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "沙门思潮", "des": "前六世纪反婆罗门权威的求道者运动，佛教与耆那教皆自其间涌出。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "释迦牟尼", "des": "迦毗罗卫的太子悉达多，菩提树下觉悟四圣谛，鹿野苑初转法轮。", "symbolSize": 60, "category": "宗教与思想" },
    { "name": "佛教", "des": "以觉悟与解脱为标的的宗教，经北传与南传两脉广被亚洲。", "symbolSize": 60, "category": "宗教与思想" },
    { "name": "耆那教", "des": "大雄所立的严格不害之教，天衣与白衣两派，禁欲至微尘。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "印度教", "des": "从吠陀根干生长的庞然体系，无创教者亦无统一教会，却贯穿十亿人的生活。", "symbolSize": 60, "category": "宗教与思想" },
    { "name": "湿婆", "des": "毁灭与再生的舞王，瑜伽之主与林伽崇拜的焦点。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "毗湿奴", "des": "护持宇宙之神，罗摩与黑天皆其化身，虔信运动的主神。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "商羯罗", "des": "八世纪不二论吠檀多宗师，云游辩经重整教派，寿止三十二。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "虔诚派运动", "des": "中世纪以歌颂直爱神明的灵性浪潮，绕开祭司的平民信仰复兴。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "古鲁那纳克", "des": "十五世纪旁遮普的锡克教初祖，在印度教与伊斯兰之间走出第三条路。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "锡克教", "des": "十师传承的一神教，五K与金庙，尚武而重平等。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "瑜伽", "des": "从奥义书到《瑜伽经》的修持之学，身与心的印度技术。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "恒河", "des": "自喜马拉雅奔流的圣河，洗罪之浴与撒灰之葬，文明的轴线。", "symbolSize": 40, "category": "宗教与思想" },
    { "name": "梵语", "des": "吠陀的雅语与古典文化的通用语，屈折繁复，欧洲语言学的钥匙。", "symbolSize": 50, "category": "语言与古典学艺" },
    { "name": "巴利语", "des": "上座部佛教三藏所用的中介语，佛陀说法的亲切回声。", "symbolSize": 40, "category": "语言与古典学艺" },
    { "name": "俗语", "des": "与梵语并行的口语诸种，耆那教经与民间文学的载体。", "symbolSize": 40, "category": "语言与古典学艺" },
    { "name": "泰米尔语", "des": "达罗毗荼语的古典代表，两千年不断的桑伽姆文学传统。", "symbolSize": 40, "category": "语言与古典学艺" },
    { "name": "波你尼", "des": "公元前五世纪的语法圣手，八篇书以四千偈穷尽梵语的生成规则。", "symbolSize": 40, "category": "语言与古典学艺" },
    { "name": "迦梨陀娑", "des": "笈多宫廷的梵语诗圣，《沙恭达罗》与《云使》的作者。", "symbolSize": 40, "category": "语言与古典学艺" },
    { "name": "摩诃婆罗多", "des": "十万颂的世界最长史诗，俱卢之战的悲剧与正法之问。", "symbolSize": 50, "category": "语言与古典学艺" },
    { "name": "薄伽梵歌", "des": "嵌于大战正中的七百偈哲学插章，行动瑜伽的经典宣言。", "symbolSize": 40, "category": "语言与古典学艺" },
    { "name": "罗摩衍那", "des": "蚁垤仙人的二万四千颂史诗，罗摩救妻的正统叙事，东南亚的文艺母题。", "symbolSize": 40, "category": "语言与古典学艺" },
    { "name": "那烂陀", "des": "比哈尔的佛学大学，九藏书、九级僧院，玄奘与义净的母校。", "symbolSize": 40, "category": "语言与古典学艺" },
    { "name": "阿旃陀石窟", "des": "德干悬崖上的佛教石窟群，笈多壁画是印度绘画的最高遗存。", "symbolSize": 40, "category": "语言与古典学艺" },
    { "name": "阿耶波多", "des": "476年生的数学天文家，地球自转说与正弦表的作者。", "symbolSize": 40, "category": "语言与古典学艺" },
    { "name": "零与十进制", "des": "位值记法与零号的印度发明，经阿拉伯世界改写全人类的算术。", "symbolSize": 50, "category": "语言与古典学艺" },
    { "name": "东印度公司", "des": "1600年获特许的贸易公司，两百年间由商栈长成主权者。", "symbolSize": 50, "category": "殖民与独立" },
    { "name": "普拉西之战", "des": "1757年克莱武以少胜多的关键一战，孟加拉的财富自此易手。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "孟加拉", "des": "恒河三角洲的富庶之邦，殖民经济的第一个抽血口。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "殖民地经济", "des": "原料出口与手工毁灭并行的依附结构，铁路为提取而铺设。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "1857年大起义", "des": "涂油子弹引发的士兵与王公联合反英，失败后公司被撤、王室直辖。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "英属印度", "des": "1858至1947年王冠直辖的殖民国家，省邦分治与文官统治的机器。", "symbolSize": 50, "category": "殖民与独立" },
    { "name": "印度国民大会党", "des": "1885年成立的全国性政党，从精英请愿走到群众运动的独立旗舰。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "甘地", "des": "南非归来的圣雄，以盐与纺轮为武器，二十世纪非暴力的化身。", "symbolSize": 70, "category": "殖民与独立" },
    { "name": "非暴力不合作", "des": "坚持真理的斗争哲学，不合作与公民抗命的双翼。", "symbolSize": 50, "category": "殖民与独立" },
    { "name": "食盐进军", "des": "1930年甘地率众徒步三百八十公里到海边煮盐，帝国法律的荒诞暴露无遗。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "印度穆斯林联盟", "des": "1906年成立的穆斯林政治组织，从合作走向分治诉求。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "真纳", "des": "律师出身的联盟领袖，巴基斯坦国的总建筑师。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "两个民族理论", "des": "印度教徒与穆斯林为两个民族的政治论断，分治的理论引擎。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "蒙巴顿方案", "des": "1947年仓促的权力移交方案，以宗教划界切分次大陆。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "印巴分治", "des": "史上最大规模的强迫迁移，千万人流徙、百万人罹难的双重悲剧。", "symbolSize": 50, "category": "殖民与独立" },
    { "name": "阿姆倍伽尔", "des": "不可接触者出身的法学博士，宪法起草委员会主席，贱民解放的旗手。", "symbolSize": 50, "category": "殖民与独立" },
    { "name": "尼赫鲁", "des": "国大党领袖与首任总理，议会民主、世俗主义与计划经济的守护者。", "symbolSize": 50, "category": "殖民与独立" },
    { "name": "印度宪法", "des": "1950年生效的世界最长成文宪法，普选、世俗与基本权利的框架。", "symbolSize": 50, "category": "殖民与独立" },
    { "name": "不结盟运动", "des": "万隆精神孕育的第三世界外交集团，尼赫鲁为其奠基人之一。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "五年计划", "des": "尼赫鲁时代的计划经济骨架，重工业优先与进口替代。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "克什米尔", "des": "分治遗留的土邦争端，停火线两侧的七十年对峙。", "symbolSize": 40, "category": "殖民与独立" },
    { "name": "印巴战争", "des": "1947、1965、1971与1999年卡吉尔的四次兵戎相见。", "symbolSize": 40, "category": "现代印度" },
    { "name": "核试验", "des": "1974年微笑佛陀与1998年的连续核试，事实核国家的宣言。", "symbolSize": 40, "category": "现代印度" },
    { "name": "语言邦", "des": "1956年依语言重组邦界，印度联邦的民主缝合术。", "symbolSize": 40, "category": "现代印度" },
    { "name": "绿色革命", "des": "1960年代起的高产良种与灌溉运动，从饥荒之国到粮食自给。", "symbolSize": 40, "category": "现代印度" },
    { "name": "经济自由化", "des": "1991年危机逼出的改革开放，牌照统制让位于市场。", "symbolSize": 50, "category": "现代印度" },
    { "name": "IT产业", "des": "千年之交崛起的软件外包引擎，服务全球的办公室革命。", "symbolSize": 40, "category": "现代印度" },
    { "name": "班加罗尔", "des": "德干高原的花园之城，印度的软件之都。", "symbolSize": 40, "category": "现代印度" },
    { "name": "印度理工学院", "des": "1951年起创办的工程师摇篮，全球科技业的印度军团源头。", "symbolSize": 40, "category": "现代印度" },
    { "name": "宝莱坞", "des": "孟买的印地语电影工业，年产千部、观众二十亿的梦幻工厂。", "symbolSize": 40, "category": "现代印度" },
    { "name": "泰戈尔", "des": "孟加拉文艺复兴的殿军，以《吉檀迦利》膺诺奖的亚洲第一人。", "symbolSize": 50, "category": "现代印度" }
  ],
