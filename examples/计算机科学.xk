{"version":2,"nodes":[{"name":"数组","des":"连续内存中按下标存放的同型元素序列，随机访问飞快，插入删除要搬移。","symbolSize":40,"category":"数据结构"},{"name":"链表","des":"节点靠指针串成的序列，插删只改指针，访问必须逐个跳跃。","symbolSize":40,"category":"数据结构"},{"name":"栈","des":"后进先出的单开口线性表，函数调用与括号匹配的第一利器。","symbolSize":40,"category":"数据结构"},{"name":"队列","des":"先进先出的双开口线性表，缓冲与排队的天然形态。","symbolSize":40,"category":"数据结构"},{"name":"哈希表","des":"以哈希函数把键散列进桶数组，平均 O(1) 存取的查找支柱。","symbolSize":70,"category":"数据结构"},{"name":"二叉搜索树","des":"左子树小、右子树大的有序二叉树，中序遍历即得升序。","symbolSize":40,"category":"数据结构"},{"name":"平衡树","des":"用旋转把左右高度差摁在常数内的搜索树，AVL 与红黑树是代表。","symbolSize":40,"category":"数据结构"},{"name":"堆","des":"父节点恒不劣于子节点的完全二叉树，优先队列的标准骨架。","symbolSize":40,"category":"数据结构"},{"name":"B树","des":"为磁盘而生的多路平衡搜索树，节点大而树身矮，省 IO 次数。","symbolSize":40,"category":"数据结构"},{"name":"图","des":"顶点加边的数学结构，一切关系网络的通用建模语言。","symbolSize":50,"category":"数据结构"},{"name":"Trie","des":"以字符为边的多叉树，公共前缀共享路径，查词如顺藤摸瓜。","symbolSize":40,"category":"数据结构"},{"name":"跳表","des":"给有序链表叠加多级索引，以概率分层换二分般的跳跃查找。","symbolSize":40,"category":"数据结构"},{"name":"哈希函数","des":"把任意键压成定长地址的映射，均匀性决定哈希表的生死。","symbolSize":40,"category":"数据结构"},{"name":"优先队列","des":"不按先来后到、按优先级出队的抽象类型，永远先吐最紧的。","symbolSize":40,"category":"数据结构"},{"name":"邻接表","des":"每个顶点挂一条邻居链表的存图法，稀疏图的省内存之选。","symbolSize":40,"category":"数据结构"},{"name":"布隆过滤器","des":"多位哈希联合判存在：说不存在必不存在，说存在可能误报。","symbolSize":40,"category":"数据结构"},{"name":"快速排序","des":"选基准分区再递归，平均 O(n log n) 的原地排序实践之王。","symbolSize":50,"category":"算法"},{"name":"归并排序","des":"对半排好再合并，稳定且最坏仍 O(n log n)，外部排序主力。","symbolSize":40,"category":"算法"},{"name":"堆排序","des":"建堆后反复取堆顶，原地且最坏 O(n log n) 的稳妥派。","symbolSize":40,"category":"算法"},{"name":"二分查找","des":"每比较一次淘汰一半候选，O(log n) 的前提是有序。","symbolSize":50,"category":"算法"},{"name":"深度优先搜索","des":"一条路走到黑、无路再回头的图遍历，回溯与割边的母体。","symbolSize":50,"category":"算法"},{"name":"广度优先搜索","des":"从近到远逐层扩散的遍历，无权图中首次到达即最短。","symbolSize":50,"category":"算法"},{"name":"Dijkstra","des":"每次敲定当前最近的顶点，求单源最短路，要求边权非负。","symbolSize":50,"category":"算法"},{"name":"动态规划","des":"拆成重叠子问题并记住答案，空间换时间的不二心法。","symbolSize":50,"category":"算法"},{"name":"贪心算法","des":"每步只取当下最优，有时恰好通向全局最优，有时谬以千里。","symbolSize":40,"category":"算法"},{"name":"分治","des":"分割、递归、合并三步曲，快排与归并共同的母题。","symbolSize":40,"category":"算法"},{"name":"回溯","des":"深搜试探、碰壁即退，解空间中有序的穷举与悔棋。","symbolSize":40,"category":"算法"},{"name":"KMP","des":"失配时按前缀函数滑移模式串，主串指针永不回头。","symbolSize":40,"category":"算法"},{"name":"拓扑排序","des":"把依赖关系排成线性序列，有向无环图的专属操作。","symbolSize":40,"category":"算法"},{"name":"最小生成树","des":"以 n-1 条边连通全部顶点且总权最小的生成树。","symbolSize":40,"category":"算法"},{"name":"双指针","des":"两个下标协同推进，把嵌套循环压成一次线性扫描。","symbolSize":40,"category":"算法"},{"name":"递归","des":"函数调用自身求解，大问题化小的第一直觉。","symbolSize":40,"category":"算法"},{"name":"大O记号","des":"描述函数增长率的渐近上界，抹去常数只看量级。","symbolSize":50,"category":"计算理论"},{"name":"时间复杂度","des":"运行时间随输入规模增长的阶数，算法快慢的通用标尺。","symbolSize":70,"category":"计算理论"},{"name":"空间复杂度","des":"算法额外占用的内存随输入规模增长的阶，空间账本。","symbolSize":40,"category":"计算理论"},{"name":"图灵机","des":"无限纸带加读写头的假想机器，一切可计算性的基准模型。","symbolSize":50,"category":"计算理论"},{"name":"可计算性","des":"研究哪些问题存在算法解，为计算能力画出边界。","symbolSize":40,"category":"计算理论"},{"name":"停机问题","des":"判定任意程序会否终止的问题，被证明不可判定。","symbolSize":40,"category":"计算理论"},{"name":"P与NP问题","des":"多项式可解与多项式可验证是否同一世界，千禧年悬赏难题。","symbolSize":50,"category":"计算理论"},{"name":"NP完全","des":"NP 中最难的一族问题，其一有多项式解则全线失守。","symbolSize":40,"category":"计算理论"},{"name":"状态机","des":"有限状态随事件迁移的模型，协议与电路的共同语言。","symbolSize":40,"category":"计算理论"},{"name":"正则表达式","des":"描述正则语言的紧凑模式串，与有限自动机等价。","symbolSize":40,"category":"计算理论"},{"name":"丘奇-图灵论题","des":"直觉上可计算的都可由图灵机计算，计算的定义性假设。","symbolSize":40,"category":"计算理论"},{"name":"归约","des":"把一个问题改装成另一个问题的桥梁，证明难度的钥匙。","symbolSize":40,"category":"计算理论"},{"name":"形式语言","des":"按文法规则生成符号串的体系，乔姆斯基谱系分层。","symbolSize":40,"category":"计算理论"},{"name":"旅行商问题","des":"走遍所有城市再回到起点的最短回路，NP 完全的代言人。","symbolSize":40,"category":"计算理论"},{"name":"布尔逻辑","des":"与或非构成的代数体系，硬件电路与查询条件的共同根基。","symbolSize":40,"category":"计算理论"},{"name":"进程","des":"程序的一次运行实例，操作系统资源分配的基本单位。","symbolSize":70,"category":"操作系统"},{"name":"线程","des":"进程内独立执行的流，CPU 调度的基本单位。","symbolSize":50,"category":"操作系统"},{"name":"调度","des":"决定下一个占用 CPU 的是谁，公平与吞吐的平衡术。","symbolSize":40,"category":"操作系统"},{"name":"死锁","des":"互相持有对方所需资源而永久僵持的环形等待。","symbolSize":50,"category":"操作系统"},{"name":"互斥锁","des":"同一时刻只放一个执行流进临界区的最基础锁具。","symbolSize":40,"category":"操作系统"},{"name":"虚拟内存","des":"给每个进程一套独立连续地址空间的抽象，隔离与扩容兼得。","symbolSize":50,"category":"操作系统"},{"name":"分页","des":"把地址空间切成固定大小的页，按需装入物理页框。","symbolSize":40,"category":"操作系统"},{"name":"页面置换算法","des":"内存已满时决定牺牲哪一页，LRU 是教科书答案。","symbolSize":40,"category":"操作系统"},{"name":"文件系统","des":"把磁盘块组织成文件与目录树的命名存储体系。","symbolSize":40,"category":"操作系统"},{"name":"系统调用","des":"用户程序请求内核服务的唯一正规入口。","symbolSize":50,"category":"操作系统"},{"name":"中断","des":"硬件打断 CPU 当前工作请求处理的信号，事件驱动之源。","symbolSize":40,"category":"操作系统"},{"name":"上下文切换","des":"保存旧执行流现场、恢复新执行流现场的换人开销。","symbolSize":40,"category":"操作系统"},{"name":"信号量","des":"计数器配等待队列，P/V 操作撑起同步与互斥。","symbolSize":40,"category":"操作系统"},{"name":"页缓存","des":"内核在内存里暂存磁盘数据的缓冲，读写的加速带。","symbolSize":40,"category":"操作系统"},{"name":"内核","des":"掌管硬件并为上层程序服务的操作系统核心。","symbolSize":40,"category":"操作系统"},{"name":"OSI模型","des":"网络互连的七层概念蓝图，分层解耦的教学宪法。","symbolSize":40,"category":"计算机网络"},{"name":"TCP/IP","des":"事实上的互联网协议族，四层结构承载全球通信。","symbolSize":50,"category":"计算机网络"},{"name":"IP协议","des":"为主机编址并尽力而为转发数据包的网络层基石。","symbolSize":40,"category":"计算机网络"},{"name":"TCP","des":"面向连接、可靠按序的传输层旗舰，互联网的托底者。","symbolSize":70,"category":"计算机网络"},{"name":"UDP","des":"无连接、不保序的轻量传输，省去寒暄只求快。","symbolSize":40,"category":"计算机网络"},{"name":"三次握手","des":"SYN、SYN-ACK、ACK 三报文敲定 TCP 连接的开场礼。","symbolSize":40,"category":"计算机网络"},{"name":"DNS","des":"把域名翻译成 IP 地址的分布式目录服务。","symbolSize":40,"category":"计算机网络"},{"name":"HTTP","des":"浏览器与服务器间请求与响应的应用层通用语。","symbolSize":40,"category":"计算机网络"},{"name":"HTTPS","des":"在 HTTP 外层加 TLS，加密信道兼验证身份。","symbolSize":40,"category":"计算机网络"},{"name":"路由","des":"为分组逐跳选择穿越网络路径的转发决策。","symbolSize":40,"category":"计算机网络"},{"name":"NAT","des":"在边界改写地址与端口，让私网共享一个公网 IP。","symbolSize":40,"category":"计算机网络"},{"name":"以太网","des":"以帧和 MAC 编址统治局域网的链路层标准。","symbolSize":40,"category":"计算机网络"},{"name":"MAC地址","des":"烧录在网卡里的链路层地址，本地网段的门牌号。","symbolSize":40,"category":"计算机网络"},{"name":"交换机","des":"按 MAC 地址表在端口间转发帧的局域网枢纽。","symbolSize":40,"category":"计算机网络"},{"name":"拥塞控制","des":"TCP 感知网络拥堵自动降速再爬升的自愈机制。","symbolSize":40,"category":"计算机网络"},{"name":"分组交换","des":"数据切成分组各自寻路转发的交换方式，互联网的基因。","symbolSize":40,"category":"计算机网络"},{"name":"关系模型","des":"以元组与属性组织数据的二维表体系，建立在集合论之上。","symbolSize":40,"category":"数据库"},{"name":"SQL","des":"声明式数据库语言：说清要什么，无需交代怎么拿。","symbolSize":70,"category":"数据库"},{"name":"事务","des":"一组操作要么全部生效、要么全然未发生的执行单元。","symbolSize":40,"category":"数据库"},{"name":"ACID","des":"原子、一致、隔离、持久，可靠事务的四字箴言。","symbolSize":50,"category":"数据库"},{"name":"索引","des":"以空间换时间的查找捷径，查询提速的第一杠杆。","symbolSize":40,"category":"数据库"},{"name":"B+树","des":"内节点当路标、叶子串成有序链表的多路树，磁盘 IO 的驯服者。","symbolSize":50,"category":"数据库"},{"name":"主键","des":"唯一标识表中一行且不许为空的列，行的身份证。","symbolSize":40,"category":"数据库"},{"name":"外键","des":"引用他表主键的约束，替数据库看守引用完整性。","symbolSize":40,"category":"数据库"},{"name":"范式","des":"逐级消除冗余与更新异常的表结构设计规范。","symbolSize":40,"category":"数据库"},{"name":"隔离级别","des":"事务间互不见的程度，从读未提交到串行化逐级加严。","symbolSize":40,"category":"数据库"},{"name":"连接查询","des":"按匹配条件把多张表横向拼成一个结果集的操作。","symbolSize":40,"category":"数据库"},{"name":"视图","des":"以查询语句定义的虚拟表，简化访问兼作安全幕布。","symbolSize":40,"category":"数据库"},{"name":"事务日志","des":"先写日志再改数据，崩溃恢复的救命底账。","symbolSize":40,"category":"数据库"},{"name":"MVCC","des":"保留多版本快照让读写互不阻塞，高并发读的常胜法。","symbolSize":40,"category":"数据库"},{"name":"C 语言","des":"以贴近硬件的控制力铸就操作系统与嵌入式领域的基石，五十余年历久弥新。","symbolSize":70,"category":"编程语言"},{"name":"C++","des":"在 C 之上叠加面向对象与模板，以零开销抽象追求性能与表达力兼得。","symbolSize":50,"category":"编程语言"},{"name":"Java","des":"一次编写、到处运行的企业级常青树，以严谨生态深耕后端近三十年。","symbolSize":50,"category":"编程语言"},{"name":"Python","des":"以近乎伪代码的简洁语法和海量第三方库，成为数据科学与 AI 时代的通用语。","symbolSize":50,"category":"编程语言"},{"name":"JavaScript","des":"浏览器里唯一天生的语言，又借 Node.js 逆袭服务端，使用者最多的编程语言。","symbolSize":50,"category":"编程语言"},{"name":"TypeScript","des":"JavaScript 的类型化超集，为动态脚本披上静态类型的铠甲。","symbolSize":50,"category":"编程语言"},{"name":"Go","des":"做足减法的云原生语言，以 goroutine 与通道把并发送进寻常代码。","symbolSize":50,"category":"编程语言"},{"name":"Rust","des":"以所有权系统在编译期锁死内存错误，无垃圾回收亦能内存安全。","symbolSize":50,"category":"编程语言"},{"name":"Swift","des":"苹果平台的当家语言，安全而现代，ARC 管内存、actor 管并发。","symbolSize":40,"category":"编程语言"},{"name":"Kotlin","des":"JetBrains 出品的 JVM 现代语言，简洁且空安全，Android 官方首选。","symbolSize":40,"category":"编程语言"},{"name":"C#","des":"微软 .NET 旗舰，LINQ 与 async/await 的首创者，企业开发主力之一。","symbolSize":40,"category":"编程语言"},{"name":"Ruby","des":"为程序员的幸福感而生，万物皆对象，Rails 与优雅 DSL 是其名片。","symbolSize":40,"category":"编程语言"},{"name":"Haskell","des":"纯函数式的学院派旗舰，惰性求值与单子思想持续输出给工业界。","symbolSize":40,"category":"编程语言"},{"name":"PHP","des":"全球大半网站的动力源，语法随版本演进，生态深厚而行事低调。","symbolSize":40,"category":"编程语言"},{"name":"面向对象","des":"以封装、继承、多态拆解复杂度，近三十年软件工业的主流组织哲学。","symbolSize":70,"category":"编程范式"},{"name":"函数式编程","des":"以纯函数与不可变数据把计算还厽数学求值，将副作用拒之门外。","symbolSize":50,"category":"编程范式"},{"name":"响应式编程","des":"以数据流与变化传播为核心，把零散事件编成可组合的河流。","symbolSize":50,"category":"编程范式"},{"name":"过程式","des":"以过程与函数按步骤组织指令，自顶向下分解问题的传统正道。","symbolSize":40,"category":"编程范式"},{"name":"声明式","des":"只说做什么、不问怎么做，SQL 与正则是它最亲切的面孔。","symbolSize":40,"category":"编程范式"},{"name":"泛型编程","des":"算法面向抽象类型书写一次，即适配万千具体类型，STL 为典范。","symbolSize":40,"category":"编程范式"},{"name":"面向切面","des":"把日志、事务等横切关注点从业务中抽离织入，代码不再满身补丁。","symbolSize":40,"category":"编程范式"},{"name":"事件驱动","des":"程序随事件而至而动，图形界面与网络服务普遍遵循的节拍器。","symbolSize":40,"category":"编程范式"},{"name":"逻辑编程","des":"只陈述事实与规则，把求解过程交给推理引擎，Prolog 的世界观。","symbolSize":40,"category":"编程范式"},{"name":"结构化编程","des":"以顺序、选择、循环三种结构取代 goto，编程首次有了纪律。","symbolSize":40,"category":"编程范式"},{"name":"元编程","des":"用代码生成代码，宏与反射让语言学会自我改造。","symbolSize":40,"category":"编程范式"},{"name":"惰性求值","des":"不到万不得已不求值，Haskell 的默认策略，可定义无限结构。","symbolSize":40,"category":"编程范式"},{"name":"面向协议编程","des":"以协议约定能力而非以继承传递血统，Swift 倡导的另一条路。","symbolSize":40,"category":"编程范式"},{"name":"编译器","des":"把高级语言翻译成机器指令的翻译官，程序员与硅晶之间的桥梁。","symbolSize":50,"category":"运行时与编译"},{"name":"解释器","des":"边翻译边执行，即时反馈是其魅力，Python 与 Ruby 的引擎室。","symbolSize":50,"category":"运行时与编译"},{"name":"JIT 编译","des":"先解释执行再对热点代码即时编译，兼顾启动速度与峰值性能。","symbolSize":50,"category":"运行时与编译"},{"name":"JVM","des":"Java 虚拟机，字节码执行的工业标准，近三十年性能打磨的结晶。","symbolSize":50,"category":"运行时与编译"},{"name":"LLVM","des":"模块化的编译器基础设施，Clang、Rust、Swift 共用的强大后端。","symbolSize":50,"category":"运行时与编译"},{"name":"垃圾回收","des":"运行时自动追踪并回收闲置内存，程序员从此告别手动释放。","symbolSize":70,"category":"运行时与编译"},{"name":"字节码","des":"介于源码与机器码之间的中间指令，跨平台理想的秘密所在。","symbolSize":40,"category":"运行时与编译"},{"name":"AOT 编译","des":"运行之前编译完毕，以安装时的开销换启动时的干脆利落。","symbolSize":40,"category":"运行时与编译"},{"name":"引用计数","des":"数着指向对象的指针，归零即回收，却难解循环引用之结。","symbolSize":40,"category":"运行时与编译"},{"name":"虚拟机","des":"以软件模拟的计算机，让同一份字节码跑遍不同硬件。","symbolSize":40,"category":"运行时与编译"},{"name":"链接器","des":"把编译产物拼装成可执行文件，C/C++ 世界里看不见的装配工。","symbolSize":40,"category":"运行时与编译"},{"name":"CLR","des":".NET 公共语言运行时，C# 的家，泛型具体化是其与 JVM 的分野。","symbolSize":40,"category":"运行时与编译"},{"name":"V8","des":"Chrome 与 Node.js 的 JavaScript 引擎，JIT 技术的急先锋。","symbolSize":40,"category":"运行时与编译"},{"name":"WebAssembly","des":"浏览器里的二进制指令格式，C/C++/Rust 通往前端的新大陆。","symbolSize":40,"category":"运行时与编译"},{"name":"类型系统","des":"给值贴上类别标签并检查组合的合法性，程序正确性的第一道防线。","symbolSize":50,"category":"类型系统"},{"name":"静态类型","des":"编译期即验明正身，错误扼杀在运行之前，大型工程的压舱石。","symbolSize":70,"category":"类型系统"},{"name":"动态类型","des":"类型附着于值而非变量，灵活奔放，运行时方见真章。","symbolSize":50,"category":"类型系统"},{"name":"类型推断","des":"编译器代写类型标注，静态安全与简洁语法两全其美。","symbolSize":50,"category":"类型系统"},{"name":"泛型","des":"类型亦可参数化，一份算法适配万千类型而无损类型安全。","symbolSize":50,"category":"类型系统"},{"name":"强类型","des":"不偷偷转换类型，越界即报错，规矩虽多而陷阱甚少。","symbolSize":40,"category":"类型系统"},{"name":"弱类型","des":"乐于隐式转换类型，加号串联数字与字符串的玄学之源。","symbolSize":40,"category":"类型系统"},{"name":"结构化类型","des":"形状对得上即是一家人，TypeScript 的鸭子式静态检查。","symbolSize":40,"category":"类型系统"},{"name":"名义类型","des":"名字不对纵使结构相同也认生，Java 与 Swift 的严谨做派。","symbolSize":40,"category":"类型系统"},{"name":"可空类型","des":"把没有也写成一种类型，向空指针这桩十亿美元错误宣战。","symbolSize":40,"category":"类型系统"},{"name":"代数数据类型","des":"以积与和自由组合类型，Maybe 与 Either 皆出此门，建模的乐高。","symbolSize":40,"category":"类型系统"},{"name":"鸭子类型","des":"不问它是什么，只问它会不会叫，动态语言的处世哲学。","symbolSize":40,"category":"类型系统"},{"name":"渐进类型","des":"在动态与静态之间自由取舍，类型注解可加可不加的中间路线。","symbolSize":40,"category":"类型系统"},{"name":"类型擦除","des":"编译之后泛型参数如数抹去，Java 与运行时的一场无奈交易。","symbolSize":40,"category":"类型系统"},{"name":"协程","des":"用户态调度的轻量执行流，可挂起可恢复，以同步写法收获异步效能。","symbolSize":70,"category":"并发模型"},{"name":"async/await","des":"用看似同步的代码编排异步流程，自 C# 首创后风靡各语言。","symbolSize":50,"category":"并发模型"},{"name":"Actor 模型","des":"每个 Actor 独占状态、以消息通信，Erlang 亿级并发的看家本领。","symbolSize":40,"category":"并发模型"},{"name":"CSP 模型","des":"通信顺序进程：不靠共享内存，而以通信达成同步，Go 的哲学源头。","symbolSize":40,"category":"并发模型"},{"name":"通道","des":"类型化的并发安全队列，数据在协程之间流动的高速水渠。","symbolSize":40,"category":"并发模型"},{"name":"管道","des":"Unix 哲学的精髓，一个程序的输出直接流进下一个程序的输入。","symbolSize":40,"category":"并发模型"},{"name":"竞态条件","des":"结果取决于执行时序的微妙缺陷，并发世界最阴险的陷阱。","symbolSize":40,"category":"并发模型"},{"name":"锁","des":"并发访问共享资源的门票机制，顺序拿错便可能互等成死锁。","symbolSize":40,"category":"并发模型"},{"name":"互斥器","des":"一次只放一个线程进入的锁，互斥之名即其全部使命。","symbolSize":40,"category":"并发模型"},{"name":"软件事务内存","des":"以数据库式乐观事务管理共享内存访问，免锁并发的另一条路。","symbolSize":40,"category":"并发模型"},{"name":"绿色线程","des":"由语言运行时而非内核调度的线程，goroutine 的技术底色。","symbolSize":40,"category":"并发模型"},{"name":"内存模型","des":"规定多线程下读写与重排可见性的契约，数据竞争的裁决法庭。","symbolSize":40,"category":"并发模型"},{"name":"事件循环","des":"单线程轮询事件队列的调度心脏，Node.js 高并发的引擎室。","symbolSize":40,"category":"并发模型"},{"name":"包管理器","des":"一声命令拉齐全部依赖，npm、Cargo、pip 时代的工程起点。","symbolSize":50,"category":"生态与工程"},{"name":"框架","des":"骨架先行、填空即用，控制反转让框架反过来调用你的代码。","symbolSize":50,"category":"生态与工程"},{"name":"版本控制","des":"记录每一次变更的时光机，Git 让协作与回退皆从容。","symbolSize":50,"category":"生态与工程"},{"name":"标准库","des":"随语言自带的工具箱，Python 自带电池的美誉由此而来。","symbolSize":40,"category":"生态与工程"},{"name":"DSL","des":"为特定领域量身定制的语言，SQL、正则与 CSS 皆是日常老友。","symbolSize":40,"category":"生态与工程"},{"name":"单元测试","des":"以最小粒度验证代码行为，重构与回归时的保险网。","symbolSize":40,"category":"生态与工程"},{"name":"Lint","des":"静态扫描代码异味与风格偏差，便宜而有效的第一道质检。","symbolSize":40,"category":"生态与工程"},{"name":"构建工具","des":"从 Make 到 Gradle，把编译、打包、组装交给机器的流水线。","symbolSize":40,"category":"生态与工程"},{"name":"开源协议","des":"MIT、Apache、GPL 各有分寸，开源世界的法律边界。","symbolSize":40,"category":"生态与工程"},{"name":"语义化版本","des":"主版本、次版本、修订号，把升级预期写进数字的契约。","symbolSize":40,"category":"生态与工程"},{"name":"CI/CD","des":"每次提交自动构建、测试、部署，让发布从仪式变成日常。","symbolSize":40,"category":"生态与工程"},{"name":"REPL","des":"输入即求值即反馈的交互循环，探索式编程的沙盘。","symbolSize":40,"category":"生态与工程"},{"name":"调试器","des":"断点、单步、查看现场，与缺陷周旋的头号武器。","symbolSize":40,"category":"生态与工程"},{"name":"GitHub","des":"全球最大的代码托管平台，开源运动的事实中心。","symbolSize":40,"category":"生态与工程"}],"links":[{"source":"数组","target":"链表","name":"对照","des":"连续与离散两种存法，定下随机访问与插删的取舍。"},{"source":"栈","target":"队列","name":"对照","des":"后进先出与先进先出，两种出入纪律各司其职。"},{"source":"哈希表","target":"数组","name":"基于","des":"底层以数组作桶，键经散列落到具体下标。"},{"source":"哈希函数","target":"哈希表","name":"定址","des":"键先经哈希函数压成下标，再入桶存取。"},{"source":"链表","target":"跳表","name":"叠层","des":"在有序链表上叠加多级索引，才有跳跃查找。"},{"source":"二叉搜索树","target":"平衡树","name":"催生","des":"BST 最坏退化成链表，旋转平衡应运而生。"},{"source":"平衡树","target":"B树","name":"推广","des":"二叉改多叉、按块分叉，迁就磁盘读取习性。"},{"source":"堆","target":"优先队列","name":"实现","des":"小顶堆出堆顶即最小元，是优先队列的标准实现。"},{"source":"堆","target":"数组","name":"存于","des":"完全二叉树按层序隐式存进数组，无需指针。"},{"source":"图","target":"邻接表","name":"存为","des":"每个顶点挂一条邻居链，稀疏图最省内存。"},{"source":"邻接表","target":"数组","name":"依托","des":"表头是数组，数组每格再串邻居链表。"},{"source":"布隆过滤器","target":"哈希函数","name":"复用","des":"多个哈希函数联合投票，才敢断言不存在。"},{"source":"快速排序","target":"分治","name":"遵循","des":"每轮分区把大数组拆成两段小问题。"},{"source":"归并排序","target":"分治","name":"遵循","des":"对半切开、各自排好，再合并成一路。"},{"source":"动态规划","target":"分治","name":"接棒","des":"子问题重叠时分治重复计算，DP 记答案接棒。"},{"source":"递归","target":"归并排序","name":"驱动","des":"自顶向下不断二分，递归到单元再回头合并。"},{"source":"动态规划","target":"递归","name":"记忆化","des":"给递归加上备忘录，重复子问题只算一次。"},{"source":"深度优先搜索","target":"回溯","name":"推广","des":"深搜加撤销与候选生成，即成回溯法。"},{"source":"Dijkstra","target":"贪心算法","name":"基于","des":"每轮敲定当前最近的未定顶点，是贪心策略。"},{"source":"Dijkstra","target":"广度优先搜索","name":"退化为","des":"边权全为 1 时，Dijkstra 就是逐层 BFS。"},{"source":"最小生成树","target":"贪心算法","name":"基于","des":"Kruskal 取短边、Prim 长树，皆为贪心。"},{"source":"拓扑排序","target":"深度优先搜索","name":"借力","des":"深搜完成顺序的逆序恰是一个拓扑序。"},{"source":"双指针","target":"二分查找","name":"借意","des":"双指针在线性结构上模拟二分的收缩步伐。"},{"source":"贪心算法","target":"动态规划","name":"对照","des":"贪心每步不回头，DP 保留所有子问题答案。"},{"source":"大O记号","target":"时间复杂度","name":"刻画","des":"用渐近上界描述运行时间的增长阶。"},{"source":"时间复杂度","target":"空间复杂度","name":"权衡","des":"时间与空间常可互换，鱼与熊掌的抉择。"},{"source":"图灵机","target":"可计算性","name":"界定","des":"图灵机算得出的，才叫可计算。"},{"source":"停机问题","target":"可计算性","name":"反例","des":"停机不可判定，为可计算性划出天花板。"},{"source":"图灵机","target":"停机问题","name":"催生","des":"对角线论证证明没有通用停机判定器。"},{"source":"P与NP问题","target":"NP完全","name":"包含","des":"NP 完全是 NP 中最难的一小撮。"},{"source":"NP完全","target":"归约","name":"证明","des":"把已知难题归约过来，即证新问题同样难。"},{"source":"归约","target":"P与NP问题","name":"回答","des":"任一 NPC 问题有多项式解，P 即等于 NP。"},{"source":"旅行商问题","target":"NP完全","name":"属于","des":"其判定版本是最早一批被证明的 NPC 问题。"},{"source":"状态机","target":"正则表达式","name":"等价","des":"有限自动机与正则表达式表达同一族语言。"},{"source":"形式语言","target":"状态机","name":"对应","des":"乔姆斯基 3 型文法恰是有限自动机。"},{"source":"丘奇-图灵论题","target":"图灵机","name":"注解","des":"一切直觉可计算的都落在图灵机的能力圈内。"},{"source":"形式语言","target":"图灵机","name":"对齐","des":"0 型文法与图灵机生成同一类语言。"},{"source":"布尔逻辑","target":"状态机","name":"构造","des":"组合逻辑加状态寄存器，即拼出时序电路。"},{"source":"进程","target":"线程","name":"包含","des":"一个进程可挂多个线程，共享同一地址空间。"},{"source":"调度","target":"进程","name":"编排","des":"从就绪进程里挑下一个上 CPU 的幸运儿。"},{"source":"调度","target":"上下文切换","name":"引发","des":"换了人选就得换现场，调度必付切换成本。"},{"source":"线程","target":"上下文切换","name":"触发","des":"线程让出 CPU 前先存现场，回来再恢复。"},{"source":"互斥锁","target":"死锁","name":"诱因","des":"交叉持锁又互相等待，便锁成死结。"},{"source":"信号量","target":"互斥锁","name":"泛化","des":"互斥锁可视作只取 0 和 1 的二元信号量。"},{"source":"虚拟内存","target":"分页","name":"实现于","des":"主流做法是分页：切页、映射、按需调入。"},{"source":"分页","target":"页面置换算法","name":"配合","des":"页框不够时由置换算法决定请谁出局。"},{"source":"页面置换算法","target":"虚拟内存","name":"服务于","des":"置换策略的好坏直接决定缺页代价。"},{"source":"文件系统","target":"页缓存","name":"借道","des":"读写文件先过页缓存，热门数据不必碰盘。"},{"source":"内核","target":"系统调用","name":"提供","des":"系统调用是内核向用户程序开放的服务窗口。"},{"source":"系统调用","target":"中断","name":"实现于","des":"软陷入本质上就是一种受控中断。"},{"source":"中断","target":"调度","name":"触发","des":"时钟中断定期叫醒调度器重新选人。"},{"source":"进程","target":"虚拟内存","name":"隔离","des":"每个进程独享一套虚拟地址空间，互不越界。"},{"source":"OSI模型","target":"TCP/IP","name":"对照","des":"七层理论蓝图与四层工程实现的相互映照。"},{"source":"TCP/IP","target":"IP协议","name":"包含","des":"IP 是整个协议族的网络层基石。"},{"source":"TCP","target":"IP协议","name":"基于","des":"TCP 段封装进 IP 包，交给 IP 送达对端。"},{"source":"UDP","target":"IP协议","name":"基于","des":"UDP 同样借 IP 传包，只是不操心可靠。"},{"source":"TCP","target":"三次握手","name":"始于","des":"SYN、SYN-ACK、ACK 三步敲定连接。"},{"source":"TCP","target":"拥塞控制","name":"内含","des":"拥塞窗口随丢包与超时自适应伸缩。"},{"source":"HTTP","target":"TCP","name":"基于","des":"HTTP 报文交由 TCP 可靠信道护送。"},{"source":"HTTPS","target":"HTTP","name":"封装","des":"HTTP 原封不动，外层多套一圈 TLS。"},{"source":"DNS","target":"HTTP","name":"先行","des":"发请求前先问 DNS：这个域名住哪个 IP。"},{"source":"DNS","target":"UDP","name":"多用","des":"传统查询走 UDP 53 端口，一来一回图快。"},{"source":"IP协议","target":"MAC地址","name":"衔接","des":"靠 ARP 把下一跳 IP 翻译成 MAC 才能封帧。"},{"source":"路由","target":"IP协议","name":"转发","des":"按目的 IP 查表选下一跳，逐站接力。"},{"source":"NAT","target":"IP协议","name":"改写","des":"出口处改写 IP 与端口，私网集体隐身。"},{"source":"以太网","target":"MAC地址","name":"编址","des":"帧按 MAC 地址在本地链路投递。"},{"source":"交换机","target":"以太网","name":"组网","des":"交换机互联各网段，织成星型以太网。"},{"source":"交换机","target":"MAC地址","name":"查表","des":"按 MAC 地址表把帧精准发往端口。"},{"source":"分组交换","target":"IP协议","name":"实践","des":"IP 网络是分组交换思想最大的实践场。"},{"source":"OSI模型","target":"以太网","name":"归属","des":"以太网居于 OSI 的链路层与物理层。"},{"source":"关系模型","target":"SQL","name":"语言化","des":"SQL 是关系代数披上了可执行的语法外衣。"},{"source":"关系模型","target":"主键","name":"要求","des":"表中的每个元组都得有唯一标识。"},{"source":"外键","target":"主键","name":"引用","des":"外键指着别家主键，表间关系由此建立。"},{"source":"事务","target":"ACID","name":"保证","des":"四条性质合起来，才配叫可靠事务。"},{"source":"ACID","target":"隔离级别","name":"细化","des":"隔离性按强弱分四级，越强越不互相干扰。"},{"source":"隔离级别","target":"MVCC","name":"实现","des":"快照隔离靠多版本实现读写互不阻塞。"},{"source":"索引","target":"B+树","name":"采用","des":"主流数据库索引几乎都落地为 B+ 树。"},{"source":"范式","target":"关系模型","name":"规范","des":"逐级消除冗余与异常，把表磨得更规矩。"},{"source":"连接查询","target":"主键","name":"依托","des":"主外键是连接最自然的匹配条件。"},{"source":"视图","target":"SQL","name":"定义于","des":"视图就是一条起好名字的查询语句。"},{"source":"事务日志","target":"ACID","name":"兑现","des":"先写日志再改数据，崩溃后原子与持久有据可查。"},{"source":"SQL","target":"索引","name":"命中","des":"优化器决定走不走索引、走哪一个。"},{"source":"SQL","target":"连接查询","name":"表达","des":"JOIN 子句把多张表横向拼成宽结果。"},{"source":"MVCC","target":"事务","name":"服务","des":"并发事务各读各的快照，互不打扰。"},{"source":"堆排序","target":"堆","name":"取材","des":"建堆再反复取堆顶，天然长在堆结构上。"},{"source":"二分查找","target":"数组","name":"要求","des":"要下标直达又要有序，只有数组两者兼得。"},{"source":"深度优先搜索","target":"栈","name":"借助","des":"显式栈或调用栈替深搜记住回头路。"},{"source":"广度优先搜索","target":"队列","name":"借助","des":"队列保证一层放完才放下一层。"},{"source":"递归","target":"栈","name":"依赖","des":"函数调用栈本身就是栈结构的应用。"},{"source":"深度优先搜索","target":"图","name":"遍历","des":"沿边一头扎到底，无路可走再回头换道。"},{"source":"广度优先搜索","target":"图","name":"遍历","des":"从源点逐层向外染，染到即记录距离。"},{"source":"Dijkstra","target":"图","name":"作用于","des":"在边权非负的图上求单源最短路。"},{"source":"Dijkstra","target":"堆","name":"加速于","des":"小顶堆把每轮选最近点降到对数代价。"},{"source":"拓扑排序","target":"图","name":"前提","des":"只有有向无环图才排得出拓扑序。"},{"source":"最小生成树","target":"图","name":"作用于","des":"在带权连通图上挑出总权最小的连边集。"},{"source":"双指针","target":"数组","name":"游走于","des":"两个下标在数组两端或同侧协同推进。"},{"source":"跳表","target":"二分查找","name":"逼近","des":"多级索引让链表摸到二分的效率。"},{"source":"Trie","target":"KMP","name":"结合","des":"Trie 骨架加失配指针，即成 AC 自动机。"},{"source":"时间复杂度","target":"快速排序","name":"标注","des":"平均 O(n log n)，最坏退化 O(n²)。"},{"source":"时间复杂度","target":"二分查找","name":"标注","des":"每轮折半，O(log n) 稳定不飘。"},{"source":"时间复杂度","target":"动态规划","name":"标注","des":"子问题数乘单个子问题代价，即总复杂度。"},{"source":"大O记号","target":"Dijkstra","name":"标注","des":"堆优化后为 O((V+E)logV)。"},{"source":"空间复杂度","target":"动态规划","name":"权衡","des":"滚动数组可把 DP 表压到一维。"},{"source":"时间复杂度","target":"哈希表","name":"标注","des":"平均 O(1) 存取，最坏 O(n) 的退化赌注。"},{"source":"旅行商问题","target":"图","name":"巡行于","des":"在带权完全图上找最短哈密顿回路。"},{"source":"状态机","target":"TCP","name":"建模","des":"TCP 连接生命周期就是一张状态迁移图。"},{"source":"布尔逻辑","target":"SQL","name":"支撑","des":"WHERE 里的 AND、OR、NOT 即布尔表达式。"},{"source":"调度","target":"优先队列","name":"应用","des":"就绪队列按优先级取下一个上 CPU 者。"},{"source":"页面置换算法","target":"哈希表","name":"实现于","des":"LRU 常用哈希表加双向链表做到 O(1)。"},{"source":"分页","target":"Trie","name":"形似","des":"多级页号逐级索引，如字符树按位寻径。"},{"source":"死锁","target":"图","name":"建模","des":"资源分配图有环是死锁的必要形态。"},{"source":"系统调用","target":"TCP/IP","name":"入口","des":"应用经 socket 调用步入内核协议栈。"},{"source":"系统调用","target":"UDP","name":"经由","des":"收发 UDP 数据报同样走套接字调用。"},{"source":"B+树","target":"B树","name":"演化","des":"数据全落叶子并串成链表，范围查询更顺手。"},{"source":"索引","target":"哈希表","name":"另有","des":"哈希索引等值快，却不支持范围扫描。"},{"source":"B+树","target":"页缓存","name":"贴近","des":"节点大小对齐页，让每次 IO 物有所值。"},{"source":"事务日志","target":"文件系统","name":"承载","des":"日志终究要以文件形式落进文件系统。"},{"source":"死锁","target":"事务","name":"复现","des":"锁等待环是数据库里死锁的经典现场。"},{"source":"归并排序","target":"链表","name":"亲和","des":"归并在链表上合并无需额外空间，是首选。"},{"source":"拓扑排序","target":"邻接表","name":"存于","des":"邻接表是拓扑排序最常用的输入形态。"},{"source":"时间复杂度","target":"归并排序","name":"标注","des":"最坏情况仍是 O(n log n)，稳定不退化。"},{"source":"空间复杂度","target":"递归","name":"计入","des":"递归深度就是调用栈的空间账单。"},{"source":"文件系统","target":"B树","name":"取材","des":"文件系统索引多用 B 树家族对抗磁盘慢速。"},{"source":"中断","target":"状态机","name":"驱动","des":"中断处理按状态机组织各步流转。"},{"source":"交换机","target":"队列","name":"缓冲","des":"端口输出队列暂存排队待发的帧。"},{"source":"路由","target":"图","name":"抽象为","des":"网络拓扑即带权图，路由是图上选路问题。"},{"source":"事务","target":"互斥锁","name":"借用","des":"两阶段锁用互斥思想给事务排座位。"},{"source":"SQL","target":"图灵机","name":"逼近","des":"加上递归 CTE，SQL 便图灵完备。"},{"source":"索引","target":"二分查找","name":"呼应","des":"B+ 树叶页内按键二分定位记录。"},{"source":"三次握手","target":"状态机","name":"演绎","des":"从 SYN_SENT 到 ESTABLISHED 的经典迁移。"},{"source":"贪心算法","target":"调度","name":"现身","des":"最短作业优先正是贪心在调度中的身影。"},{"source":"C 语言","target":"过程式","name":"践行","des":"以函数与结构体直书机器逻辑，过程式编程的教科书范本。"},{"source":"C++","target":"面向对象","name":"融合","des":"在 C 之上引入类与虚函数，又不止于面向对象。"},{"source":"C++","target":"泛型编程","name":"催生","des":"模板与 STL 把泛型编程从论文推向工业。"},{"source":"Java","target":"面向对象","name":"深耕","des":"一切皆类的纯粹路线，企业开发的默认组织方式。"},{"source":"Java","target":"面向切面","name":"孕育","des":"AspectJ 以 Java 为宿主，把 AOP 带入主流视野。"},{"source":"JavaScript","target":"函数式编程","name":"师承","des":"诞生时自 Scheme 带回闭包与一等函数。"},{"source":"JavaScript","target":"事件驱动","name":"绑定","des":"浏览器交互模型即其宿命，回调是一切的起点。"},{"source":"Ruby","target":"面向对象","name":"信奉","des":"整数亦是对象，Smalltalk 式的彻头彻尾。"},{"source":"SQL","target":"声明式","name":"示范","des":"只描述想要什么数据，求解路径交给优化器。"},{"source":"Haskell","target":"函数式编程","name":"化身","des":"纯度与惰性一以贯之，函数式活的标准像。"},{"source":"Swift","target":"面向协议编程","name":"倡导","des":"协议扩展优先于继承，值语义唱主角。"},{"source":"Go","target":"过程式","name":"恪守","des":"没有类与继承，组合与过程式直来直去。"},{"source":"C#","target":"响应式编程","name":"孵化","des":"Rx 扩展源自 .NET，观察者模式的数据流升华。"},{"source":"C 语言","target":"链接器","name":"伴随","des":"编译单元各成目标文件，链接方成可执行整体。"},{"source":"C++","target":"LLVM","name":"编译到","des":"Clang 前端配 LLVM 后端，当代主流工具链。"},{"source":"Java","target":"字节码","name":"编译为","des":"源码先落成字节码，换取跨平台的中间形态。"},{"source":"Java","target":"JVM","name":"运行于","des":"虚拟机逐条执行字节码，热点代码交予 JIT。"},{"source":"Python","target":"解释器","name":"执行于","des":"CPython 逐条解释执行，即时反馈是天性。"},{"source":"JavaScript","target":"V8","name":"驰骋于","des":"V8 为其提速，浏览器与 Node 皆成疆场。"},{"source":"Rust","target":"LLVM","name":"编译到","des":"借用检查通过后，交 LLVM 生成机器码。"},{"source":"Rust","target":"WebAssembly","name":"远征","des":"无需垃圾回收即可进浏览器，WASM 生态的主力。"},{"source":"Swift","target":"LLVM","name":"构建于","des":"其作者 Chris Lattner 亦是 LLVM 之父。"},{"source":"Swift","target":"AOT 编译","name":"采纳","des":"发布前全部编译完毕，启动快而体积可控。"},{"source":"Swift","target":"引用计数","name":"采用","des":"ARC 在编译期插入释放调用，无 GC 亦安心。"},{"source":"Kotlin","target":"字节码","name":"编译为","des":"与 Java 产出同种字节码，互操作浑然一体。"},{"source":"C#","target":"CLR","name":"运行于","des":"编译为 IL 中间语言，由 CLR 加载执行。"},{"source":"Ruby","target":"虚拟机","name":"执行于","des":"自 1.9 起由 YARV 虚拟机执行字节码。"},{"source":"Go","target":"垃圾回收","name":"配备","des":"并发三色标记，微秒级停顿的当代答卷。"},{"source":"Go","target":"AOT 编译","name":"坚持","des":"一键编译出静态二进制，部署不过一次拷贝。"},{"source":"PHP","target":"解释器","name":"执行于","des":"Zend 引擎解释执行，OPcache 再加一层缓存。"},{"source":"TypeScript","target":"JavaScript","name":"编译为","des":"类型层编译即擦除，输出的仍是地道 JavaScript。"},{"source":"Java","target":"静态类型","name":"恪守","des":"编译期类型检查严密，泛型却止步于擦除。"},{"source":"Java","target":"类型擦除","name":"受限于","des":"历史包袱所致，泛型信息不入字节码。"},{"source":"Java","target":"名义类型","name":"沿用","des":"类型以声明处的名字相认，结构相同也不认。"},{"source":"Python","target":"动态类型","name":"标榜","des":"变量只是名字，类型永远跟着值走。"},{"source":"Python","target":"鸭子类型","name":"身体力行","des":"调用前不查类型，能叫会游便是鸭子。"},{"source":"Python","target":"渐进类型","name":"补充","des":"type hints 可选标注，mypy 静态把关。"},{"source":"TypeScript","target":"静态类型","name":"披挂","des":"类型层编译即擦除，开发期全副武装。"},{"source":"TypeScript","target":"结构化类型","name":"采行","des":"形状匹配即类型匹配，与 JSON 亲和无间。"},{"source":"Go","target":"静态类型","name":"坚守","des":"无继承、接口隐式实现，类型系统极简。"},{"source":"Go","target":"泛型","name":"引入","des":"1.18 版姗姗来迟的参数化类型，久候而必要。"},{"source":"Rust","target":"静态类型","name":"严守","des":"类型系统与所有权交织，编译器铁面无私。"},{"source":"Rust","target":"代数数据类型","name":"倚重","des":"enum 即和类型，match 强制穷尽分支。"},{"source":"Swift","target":"可空类型","name":"内置","des":"Optional 把 nil 关进类型的笼子。"},{"source":"Kotlin","target":"可空类型","name":"区分","des":"类型自带问号，空指针风险显式可见。"},{"source":"C#","target":"泛型","name":"具体化","des":"reified 泛型运行时仍在，与 Java 的分野。"},{"source":"Haskell","target":"类型推断","name":"示范","des":"Hindley-Milner 推断，类型签名即文档。"},{"source":"Haskell","target":"代数数据类型","name":"织就","des":"data 声明与模式匹配浑然一体。"},{"source":"C 语言","target":"弱类型","name":"纵容","des":"指针强转畅通无阻，自由与危险同在。"},{"source":"Java","target":"线程","name":"内建","des":"最早把线程写进语言的主流选手，虚拟线程续新篇。"},{"source":"Java","target":"内存模型","name":"立约","des":"happens-before 规则厘清多线程可见性。"},{"source":"Go","target":"CSP 模型","name":"内建","des":"勿以共享内存通信，信条直接刻进语言。"},{"source":"Go","target":"协程","name":"轻启","des":"go 一词即起一条 goroutine，百万并发不夸张。"},{"source":"Go","target":"通道","name":"借道","des":"chan 收发数据，select 多路复用。"},{"source":"Go","target":"绿色线程","name":"内建","des":"goroutine 由运行时做 M:N 调度。"},{"source":"Rust","target":"竞态条件","name":"驯服","des":"借用检查让数据竞争止步于编译期。"},{"source":"JavaScript","target":"事件循环","name":"寄身","des":"单线程轮询任务队列，异步皆由此出。"},{"source":"Swift","target":"async/await","name":"引入","des":"5.5 版进入语言，结构化并发一并到位。"},{"source":"Swift","target":"Actor 模型","name":"采纳","des":"actor 隔离可变状态，Swift 并发三支柱之一。"},{"source":"Kotlin","target":"协程","name":"主打","des":"suspend 函数挂起恢复，Android 并发首选。"},{"source":"C#","target":"async/await","name":"首创","des":"2012 年 C# 5.0 首发，业界竞相效仿。"},{"source":"Haskell","target":"软件事务内存","name":"提供","des":"GHC 内置 STM，以事务组合处理共享状态。"},{"source":"JavaScript","target":"包管理器","name":"养出","des":"npm 坐拥数百万包，史上最大的软件复用市场。"},{"source":"Rust","target":"包管理器","name":"钦定","des":"Cargo 生而标配，构建测试依赖一体承载。"},{"source":"PHP","target":"包管理器","name":"倚靠","des":"Composer 终结了手动拷贝类库的年代。"},{"source":"Python","target":"标准库","name":"自带","des":"人称自带电池，从正则到压缩一应俱全。"},{"source":"Go","target":"标准库","name":"倚仗","des":"net/http 一个包便能起一个 Web 服务。"},{"source":"Ruby","target":"框架","name":"成名于","des":"Rails 把这门小语言推上 Web 舞台中央。"},{"source":"Ruby","target":"DSL","name":"钟爱","des":"Rake 与 RSpec 尽显内部 DSL 的表现力。"},{"source":"Ruby","target":"元编程","name":"精于","des":"开放类与 method_missing，DSL 背后的魔术。"},{"source":"SQL","target":"DSL","name":"归入","des":"领域特定语言最成功的代表作之一。"},{"source":"C 语言","target":"Lint","name":"孕生","des":"1979 年 lint 为查 C 程序缺陷而生，沿用其名至今。"},{"source":"Java","target":"构建工具","name":"托付","des":"Maven 定下的坐标体系成了行业通货。"},{"source":"Python","target":"REPL","name":"相伴","des":"交互式探索是数据科学的第一现场。"},{"source":"调试器","target":"C 语言","name":"结缘","des":"GDB 与 C 的组合训练了几代系统程序员。"},{"source":"响应式编程","target":"事件驱动","name":"承接","des":"把零散事件编组为可组合的数据流。"},{"source":"逻辑编程","target":"声明式","name":"隶属","des":"只给事实与规则，求解交给推理引擎。"},{"source":"结构化编程","target":"面向对象","name":"铺垫","des":"先有顺序分支循环的纪律，后有对象封装。"},{"source":"过程式","target":"结构化编程","name":"依循","des":"以三种控制结构书写过程，告别 goto。"},{"source":"惰性求值","target":"函数式编程","name":"隶属","des":"需要时才求值，Haskell 将其设为默认。"},{"source":"泛型编程","target":"泛型","name":"仰仗","des":"泛型是工具，泛型编程是思想。"},{"source":"元编程","target":"DSL","name":"造就","des":"内部 DSL 多半出自元编程之手。"},{"source":"函数式编程","target":"单元测试","name":"裨益","des":"纯函数无副作用，测试就是断言输入输出。"},{"source":"框架","target":"面向对象","name":"惯用","des":"从 Spring 到 Django，骨架皆以类搭成。"},{"source":"DSL","target":"声明式","name":"同源","des":"DSL 多取声明式：只说目的，不问过程。"},{"source":"Actor 模型","target":"事件驱动","name":"呼应","des":"收到消息才行动，天生的事件式。"},{"source":"编译器","target":"解释器","name":"对照","des":"一个先译后执，一个边译边执，是光谱而非对立。"},{"source":"编译器","target":"字节码","name":"产出","des":"Java 与 Kotlin 编译器的直接产物。"},{"source":"字节码","target":"虚拟机","name":"栖身","des":"虚拟机逐条解释或即时编译执行字节码。"},{"source":"JVM","target":"虚拟机","name":"属于","des":"至今最成功的工业级字节码虚拟机。"},{"source":"CLR","target":"虚拟机","name":"属于","des":"与 JVM 同类，IL 指令集的另一帝国。"},{"source":"JIT 编译","target":"字节码","name":"消费","des":"热点字节码升级为机器码，越跑越快。"},{"source":"JIT 编译","target":"解释器","name":"嫁接","des":"先解释摸底，再对热点代码动刀。"},{"source":"垃圾回收","target":"引用计数","name":"涵盖","des":"追踪与计数是自动内存回收的两大流派。"},{"source":"LLVM","target":"编译器","name":"重塑","des":"把编译器拆成可复用的模块化基础设施。"},{"source":"链接器","target":"编译器","name":"接力","des":"把目标文件拼装成可执行文件的最后一棒。"},{"source":"WebAssembly","target":"字节码","name":"形似","des":