{
  "version": 2,
  "nodes": [
    { "name": "西方绘画史", "des": "从圣像的金色背景到现成品的挑衅，近七百年间画布上发生的，是一场观念的接力。", "symbolSize": 70, "category": "文艺复兴与绘画的觉醒" },
    { "name": "文艺复兴", "des": "古典出土、透视立规、解剖人体，佛罗伦萨的画坊把神像画成人，把人画成中心。", "symbolSize": 60, "category": "文艺复兴与绘画的觉醒" },
    { "name": "蛋彩画", "des": "蛋黄调和矿物颜料的旧媒介，干得快、色域窄，油画兴起前统御欧洲画坊数百年。", "symbolSize": 40, "category": "文艺复兴与绘画的觉醒" },
    { "name": "乔托", "des": "斯克罗维尼礼拜堂的湿壁画让圣像有了重量与哀恸，近代绘画自他起笔。", "symbolSize": 50, "category": "文艺复兴与绘画的觉醒" },
    { "name": "透视法", "des": "以消失点把三维空间压进平面的几何约定，阿尔贝蒂著书立说，画坊奉为律令。", "symbolSize": 55, "category": "文艺复兴与绘画的觉醒" },
    { "name": "马萨乔", "des": "二十七岁早夭的天才，《三位一体》让墙面开出一间有深度的礼拜堂。", "symbolSize": 40, "category": "文艺复兴与绘画的觉醒" },
    { "name": "波提切利", "des": "《春》与《维纳斯的诞生》以回旋的线描写异教神话，忧郁清冷，自成一格。", "symbolSize": 40, "category": "文艺复兴与绘画的觉醒" },
    { "name": "达·芬奇", "des": "画家、解剖者与工程发明家，《最后的晚餐》与《蒙娜丽莎》立于两端。", "symbolSize": 60, "category": "文艺复兴与绘画的觉醒" },
    { "name": "晕涂法", "des": "以数十层近乎透明的罩染调匀明暗，轮廓溶进雾里，蒙娜丽莎的微笑由此生成。", "symbolSize": 40, "category": "文艺复兴与绘画的觉醒" },
    { "name": "米开朗基罗", "des": "自认雕刻家，却画满西斯廷天顶，充盈的肌肉把神的故事压成人间伟力。", "symbolSize": 50, "category": "文艺复兴与绘画的觉醒" },
    { "name": "拉斐尔", "des": "把达·芬奇的柔和与米氏的雄强调成秀雅秩序，《雅典学院》是理想国的画像。", "symbolSize": 50, "category": "文艺复兴与绘画的觉醒" },
    { "name": "威尼斯画派", "des": "潟湖城邦以色彩立国，油彩上了帆布，世俗的欢愉与光的氤氲取代苦行。", "symbolSize": 40, "category": "文艺复兴与绘画的觉醒" },
    { "name": "提香", "des": "近一世纪的漫长画涯，以肉感的色彩与奔放的笔意把油画推向古典时代的顶峰。", "symbolSize": 55, "category": "文艺复兴与绘画的觉醒" },
    { "name": "扬·凡·艾克", "des": "尼德兰画师，精制油性媒介至可层层罩染，《阿尔诺芬尼夫妇像》细如法律文书。", "symbolSize": 40, "category": "文艺复兴与绘画的觉醒" },
    { "name": "油画", "des": "以亚麻油调和颜料的技法改良，慢干、可叠、色层深，此后五百年画布的主宰。", "symbolSize": 40, "category": "文艺复兴与绘画的觉醒" },
    { "name": "巴洛克", "des": "反宗教改革时代的戏剧风格：对角线、强光与动感，把观者卷进画面的旋涡。", "symbolSize": 55, "category": "巴洛克与洛可可" },
    { "name": "卡拉瓦乔", "des": "把圣徒画成街头脚夫的亡命者，光影如刀，《召唤圣马太》一锤定音。", "symbolSize": 55, "category": "巴洛克与洛可可" },
    { "name": "明暗对照法", "des": "让强光从浓黑中劈出形体的画法，舞台化的照明，巴洛克最具辨识度的腔调。", "symbolSize": 50, "category": "巴洛克与洛可可" },
    { "name": "鲁本斯", "des": "佛兰德斯的外交官画家，肉感翻涌的构图兼收威尼斯与卡拉瓦乔，画坊如工厂。", "symbolSize": 50, "category": "巴洛克与洛可可" },
    { "name": "伦勃朗", "des": "从名誉的顶峰跌进破产的暗部，《夜巡》之后，光只为人的脸与良心存在。", "symbolSize": 55, "category": "巴洛克与洛可可" },
    { "name": "委拉斯开兹", "des": "马德里宫廷的冷静之眼，《宫娥》以镜与门层层设谜，被后世奉画家中的画家。", "symbolSize": 40, "category": "巴洛克与洛可可" },
    { "name": "维米尔", "des": "代尔夫特的沉默画师，存世三十余幅，窗边的一角光线写尽日常的神圣。", "symbolSize": 50, "category": "巴洛克与洛可可" },
    { "name": "荷兰画派", "des": "市民共和国的绘画：不画神坛画市场、静物与风车，买画的人挂满自家墙壁。", "symbolSize": 40, "category": "巴洛克与洛可可" },
    { "name": "普桑", "des": "长居罗马的法国画师，以考古的严谨与理性的构图，成为古典一路的远祖。", "symbolSize": 40, "category": "巴洛克与洛可可" },
    { "name": "素描与色彩之争", "des": "十七世纪法国画坛的公案：素描是骨骼，色彩是血肉，两派相争二百年。", "symbolSize": 40, "category": "巴洛克与洛可可" },
    { "name": "洛可可", "des": "摄政时代的室内欢愉：粉绿与金、贝壳曲线，把巴洛克的宏大换成脂粉的轻盈。", "symbolSize": 40, "category": "巴洛克与洛可可" },
    { "name": "华托", "des": "《发舟西苔岛》的作者，画郊游与喜剧角色，欢愉底下沉着挥不去的忧郁。", "symbolSize": 40, "category": "巴洛克与洛可可" },
    { "name": "弗拉戈纳尔", "des": "《秋千》里飞起一只鞋，粉绿的调子与放肆的笔法，把贵族游戏推向艳丽末路。", "symbolSize": 40, "category": "巴洛克与洛可可" },
    { "name": "学院与沙龙", "des": "法兰西学院立规范，年度沙龙定生死，荣耀与嘲笑都在这间法庭宣判。", "symbolSize": 50, "category": "新古典与浪漫之争" },
    { "name": "大卫", "des": "大革命的宫廷画家，《荷拉斯兄弟之誓》以古罗马的骨骼支撑现代的激情。", "symbolSize": 55, "category": "新古典与浪漫之争" },
    { "name": "新古典主义", "des": "以考古的姿态复归希腊罗马，线条为骨、教化为任，革命与帝国都用它发声。", "symbolSize": 50, "category": "新古典与浪漫之争" },
    { "name": "马拉之死", "des": "浴室里的殉难者被画成一幅圣殇，时政新闻第一次取得祭坛画的庄严。", "symbolSize": 40, "category": "新古典与浪漫之争" },
    { "name": "安格尔", "des": "线条的苦行僧，毕生捍卫素描高于色彩，《大宫女》多出的椎骨即是宣言。", "symbolSize": 50, "category": "新古典与浪漫之争" },
    { "name": "浪漫主义", "des": "激情、废墟与风暴，色彩压过线条，个体的感受第一次成为绘画的立法者。", "symbolSize": 50, "category": "新古典与浪漫之争" },
    { "name": "热里科", "des": "为画沉船剃发明志，存世之作不多，三十二岁坠马而亡，浪漫派的第一声号角。", "symbolSize": 40, "category": "新古典与浪漫之争" },
    { "name": "梅杜萨之筏", "des": "以真实海难为题的历史巨构，尸体与幸存者在同一张筏上争夺天光。", "symbolSize": 40, "category": "新古典与浪漫之争" },
    { "name": "德拉克洛瓦", "des": "浪漫派的统帅，《自由引导人民》之外，日记里的色彩理论同样流传后世。", "symbolSize": 55, "category": "新古典与浪漫之争" },
    { "name": "自由引导人民", "des": "三色旗与街垒第一次入画，寓言与新闻合一，浪漫主义抢下历史的头版。", "symbolSize": 40, "category": "新古典与浪漫之争" },
    { "name": "哥雅", "des": "宫廷画师与黑暗的目击者，从织毯样式画到黑色绘画，理性沉睡生出怪物。", "symbolSize": 50, "category": "新古典与浪漫之争" },
    { "name": "现实主义", "des": "“画我所见”的宣言，题材从英雄降到石工与拾穗者，粗粝本身成为道德。", "symbolSize": 50, "category": "现实主义与印象派" },
    { "name": "库尔贝", "des": "奥尔南的自大个子，办个人画展拒官方勋章，把《石工》的重量扛进沙龙。", "symbolSize": 55, "category": "现实主义与印象派" },
    { "name": "米勒", "des": "巴比松的农民画家，《拾穗者》与《晚钟》让弯腰的劳作有了圣像的庄重。", "symbolSize": 40, "category": "现实主义与印象派" },
    { "name": "巴比松画派", "des": "枫丹白露林边落户的风景画家，对着橡树与耕地写生，风景第一次独立发声。", "symbolSize": 40, "category": "现实主义与印象派" },
    { "name": "马奈", "des": "穿上现代的黑衣袍，《草地上的午餐》惹来哄笑，却把绘画领出神话的门。", "symbolSize": 55, "category": "现实主义与印象派" },
    { "name": "奥林匹亚", "des": "提香式斜卧换成巴黎妓女的直视，1865年沙龙的嘘声成了现代的授勋礼。", "symbolSize": 40, "category": "现实主义与印象派" },
    { "name": "落选者沙龙", "des": "1863年为落选作品另开的棚屋，嘲笑声反而成全了印象派的成人礼。", "symbolSize": 50, "category": "现实主义与印象派" },
    { "name": "印象派", "des": "走出画室捕捉光色的瞬间，八次联展顶着讥讽的名号，现代绘画的起点站。", "symbolSize": 60, "category": "现实主义与印象派" },
    { "name": "莫奈", "des": "追光的苦行者，从《日出·印象》到睡莲池，一生只画同一件事：光的变化。", "symbolSize": 55, "category": "现实主义与印象派" },
    { "name": "日出·印象", "des": "勒阿弗尔港晨雾中的一笔船影，被记者借去讥讽，反倒命名了整个画派。", "symbolSize": 40, "category": "现实主义与印象派" },
    { "name": "户外写生", "des": "带着新发明的管装颜料出门，直面天光作画，印象派方法论的第一块基石。", "symbolSize": 40, "category": "现实主义与印象派" },
    { "name": "光学混色", "des": "相邻纯色在视网膜上自行调合的原理，把调色盘的活计交给观看者的眼睛。", "symbolSize": 40, "category": "现实主义与印象派" },
    { "name": "雷诺阿", "des": "把光斑落在舞会与秋千上，画人间的欢愉，红润的裸体与阳光是他的签名。", "symbolSize": 40, "category": "现实主义与印象派" },
    { "name": "德加", "des": "自称独立画家却张罗联展，赛马场、洗衣妇与舞女，视角常来自钥匙孔。", "symbolSize": 40, "category": "现实主义与印象派" },
    { "name": "毕沙罗", "des": "八次印象派联展全勤的长者，团队的和事佬，塞尚与高更都受过他的点拨。", "symbolSize": 40, "category": "现实主义与印象派" },
    { "name": "后印象派", "des": "后人的追认之名：塞尚的结构、梵高的燃烧、高更的平涂，从光色折返内心。", "symbolSize": 55, "category": "后印象与现代萌芽" },
    { "name": "塞尚", "des": "“以圆柱体、球体与圆锥看自然”，把绘画从模仿转向构造，现代艺术之父。", "symbolSize": 55, "category": "后印象与现代萌芽" },
    { "name": "梵高", "des": "十年画涯两千幅，向日葵与麦田的火焰色，生前只卖出一幅画的赤子。", "symbolSize": 55, "category": "后印象与现代萌芽" },
    { "name": "星月夜", "des": "圣雷米疗养院铁窗外的夜空，柏树如黑焰直立，星与月卷进同一个漩涡。", "symbolSize": 40, "category": "后印象与现代萌芽" },
    { "name": "高更", "des": "弃股票经纪人生远走塔希提，以平涂与蛮色追问《我们从何处来》。", "symbolSize": 50, "category": "后印象与现代萌芽" },
    { "name": "修拉", "des": "以科学头脑作画，《大碗岛的星期天》用数万色点两年缀成，三十一岁早逝。", "symbolSize": 40, "category": "后印象与现代萌芽" },
    { "name": "点彩法", "des": "将纯色排成小点交由眼睛调合的画法，印象派的激情被改写成光学演算。", "symbolSize": 40, "category": "后印象与现代萌芽" },
    { "name": "浮世绘", "des": "日本版画的平涂、轮廓与俯瞰构图，经包装纸与商店漂进巴黎，重塑西方构图。", "symbolSize": 40, "category": "后印象与现代萌芽" },
    { "name": "象征主义", "des": "反写实的诗性暗流：绘画不求再现世界，而求暗示理念与梦的褶皱。", "symbolSize": 40, "category": "后印象与现代萌芽" },
    { "name": "纳比派", "des": "高更身后巴黎的先知们，把绘画当装饰的宗教，平色块与边框皆是仪式。", "symbolSize": 40, "category": "后印象与现代萌芽" },
    { "name": "劳特累克", "des": "贵族出身的侏儒画师，混迹蒙马特，为红磨坊画的海报把广告抬进艺术。", "symbolSize": 40, "category": "后印象与现代萌芽" },
    { "name": "野兽派", "des": "1905年秋季沙龙的一间展室，纯色直陈不受自然管束，批评家惊呼野兽。", "symbolSize": 50, "category": "二十世纪先锋派" },
    { "name": "马蒂斯", "des": "色彩的建筑师，《舞蹈》以五个人体转出节律，自称艺术该像一把安乐椅。", "symbolSize": 55, "category": "二十世纪先锋派" },
    { "name": "立体主义", "des": "把物拆成多视面再拼回画面的语法，空间自文艺复兴以来首次被改写。", "symbolSize": 55, "category": "二十世纪先锋派" },
    { "name": "毕加索", "des": "蓝色、粉色、黑人时期到立体主义，一生换尽语法，《格尔尼卡》为世纪作证。", "symbolSize": 60, "category": "二十世纪先锋派" },
    { "name": "亚维农少女", "des": "1907年的五个裸女，面孔如面具、形体如碎玻璃，现代艺术的分水岭。", "symbolSize": 40, "category": "二十世纪先锋派" },
    { "name": "表现主义", "des": "桥社与蓝骑士两支德意志力量，颜色直接呐喊，画出焦虑时代的心电图。", "symbolSize": 50, "category": "二十世纪先锋派" },
    { "name": "康定斯基", "des": "听色彩如闻音乐的俄国人，《构成》系列一步步退出物象，抽象绘画由此立说。", "symbolSize": 50, "category": "二十世纪先锋派" },
    { "name": "达达主义", "des": "大战废墟里的反艺术运动：拼贴、偶发与无意义的嘲讽，把破坏本身当创作。", "symbolSize": 50, "category": "二十世纪先锋派" },
    { "name": "杜尚", "des": "下棋的挑战者，《下楼梯的裸女》之后转身离去，一件小便池改写艺术的定义。", "symbolSize": 55, "category": "二十世纪先锋派" },
    { "name": "现成品", "des": "拾来的日常物经选择与签名即成艺术，制作让位于挑选，观念自此登堂。", "symbolSize": 40, "category": "二十世纪先锋派" },
    { "name": "超现实主义", "des": "以弗洛伊德为导师，自动书写与梦境拼贴，让潜意识在画布上值夜班。", "symbolSize": 50, "category": "二十世纪先锋派" },
    { "name": "达利", "des": "自我推销的天才，偏执狂批判法把梦境画成照片般的清晰，胡子上翘。", "symbolSize": 50, "category": "二十世纪先锋派" },
    { "name": "抽象表现主义", "des": "战后纽约的行动绘画，颜料的滴洒即画家在场的记录，美国第一次执掌牛耳。", "symbolSize": 50, "category": "二十世纪先锋派" },
    { "name": "波洛克", "des": "把画布铺在地上滴洒颜料的西部牛仔，行动本身即内容，四十四岁殁于车祸。", "symbolSize": 50, "category": "二十世纪先锋派" },
    { "name": "波普艺术", "des": "汤罐、明星与连环画入画，消费社会的货架搬进美术馆，冷面而响亮。", "symbolSize": 50, "category": "二十世纪先锋派" },
    { "name": "沃霍尔", "des": "丝网印的玛丽莲与金宝汤罐，“每个人都能成名十五分钟”，工厂即画坊。", "symbolSize": 50, "category": "二十世纪先锋派" }
  ],
  "links": [
    { "source": "乔托", "target": "西方绘画史", "name": "开启", "des": "被后世追认为第一位现代画家，人性自此住进圣像。" },
    { "source": "西方绘画史", "target": "文艺复兴", "name": "开篇", "des": "古典出土与财富汇流佛罗伦萨，画家的手眼在十五世纪一齐醒来。" },
    { "source": "西方绘画史", "target": "印象派", "name": "革命", "des": "拒绝与接纳的拉锯中，画什么与怎么画的主导权就此易手。" },
    { "source": "西方绘画史", "target": "立体主义", "name": "裂变", "des": "一九〇七年之后，绘画不再承诺再现所见的世界。" },
    { "source": "西方绘画史", "target": "波普艺术", "name": "余波", "des": "画布与商品橱窗的界线，在二十世纪下半叶悄悄消融。" },
    { "source": "文艺复兴", "target": "透视法", "name": "孕育", "des": "把三维世界压进平面的几何约定，成为画坊的必修功课。" },
    { "source": "马萨乔", "target": "透视法", "name": "运用", "des": "《三位一体》把消失点钉上墙面，空间第一次可以丈量。" },
    { "source": "乔托", "target": "马萨乔", "name": "影响", "des": "相隔近百年，壁画里的体积感与人性一脉接棒。" },
    { "source": "达·芬奇", "target": "透视法", "name": "精研", "des": "补入空气透视，远山淡进蓝雾，几何之外另有气氛。" },
    { "source": "达·芬奇", "target": "晕涂法", "name": "创立", "des": "以薄如呼吸的层层罩染，让轮廓溶进光雾。" },
    { "source": "达·芬奇", "target": "米开朗基罗", "name": "对擂", "des": "安吉里亚与卡希纳同厅打擂，两件未完成皆成传说。" },
    { "source": "米开朗基罗", "target": "拉斐尔", "name": "竞争", "des": "梵蒂冈相邻的壁画工程，雄强形体对上秀雅秩序。" },
    { "source": "拉斐尔", "target": "文艺复兴", "name": "集大成", "des": "融汇两家之长，均衡与秀雅成为后世学院的标准像。" },
    { "source": "波提切利", "target": "文艺复兴", "name": "别调", "des": "以《春》的清冷线描写神话，古典题材重回画布。" },
    { "source": "波提切利", "target": "蛋彩画", "name": "坚守", "des": "坦培拉的硬边笔性，正合他梦中维纳斯的冷光。" },
    { "source": "扬·凡·艾克", "target": "油画", "name": "改良", "des": "精制油性媒介层层罩染，颜料从此有了宝石的釉面。" },
    { "source": "油画", "target": "蛋彩画", "name": "取代", "des": "慢干的可改写性胜过快干的爽利，旧媒介渐退居二线。" },
    { "source": "油画", "target": "威尼斯画派", "name": "助推", "des": "油彩上了帆布，色彩浓丽的传统在潟湖边生根。" },
    { "source": "提香", "target": "威尼斯画派", "name": "领衔", "des": "漫长生涯把色彩与笔意推到古典技艺的极限。" },
    { "source": "提香", "target": "巴洛克", "name": "启迪", "des": "晚年指下的粗野笔触，早把巴洛克的血性泄了底。" },
    { "source": "文艺复兴", "target": "巴洛克", "name": "转场", "des": "庄严的均衡让位于戏剧的瞬间，反宗教改革需要动感。" },
    { "source": "卡拉瓦乔", "target": "巴洛克", "name": "开创", "des": "把圣徒拖进酒馆暗巷，定格戏剧性瞬间的全新规范。" },
    { "source": "卡拉瓦乔", "target": "明暗对照法", "name": "极致", "des": "强光劈开黑暗如舞台追灯，人称暴烈的明暗。" },
    { "source": "明暗对照法", "target": "伦勃朗", "name": "传灯", "des": "外光内暗翻作内光外暗，光从人脸与良心升起。" },
    { "source": "委拉斯开兹", "target": "卡拉瓦乔", "name": "私淑", "des": "借暗巷画手的直视感，宫廷御容因此不媚。" },
    { "source": "委拉斯开兹", "target": "马奈", "name": "启发", "des": "《宫娥》率直的目光，两百年后震醒巴黎画家。" },
    { "source": "伦勃朗", "target": "荷兰画派", "name": "领衔", "des": "从民兵像到犹太老人，市民共和国的人间剧场。" },
    { "source": "维米尔", "target": "荷兰画派", "name": "别调", "des": "代尔夫特窗边一角静默，以珍珠色写日常的神学。" },
    { "source": "维米尔", "target": "光学混色", "name": "先声", "des": "暗箱里散焦的高光，两百年后成了点彩的伏笔。" },
    { "source": "鲁本斯", "target": "巴洛克", "name": "定调", "des": "翻涌的肉色与对角线构图，把巴洛克写成欢乐颂。" },
    { "source": "鲁本斯", "target": "提香", "name": "仰承", "des": "遍临威尼斯真迹，把肉感色彩铸成外交辞令。" },
    { "source": "普桑", "target": "素描与色彩之争", "name": "领衔", "des": "奉素描为骨骼的古典一方，举他为旗帜。" },
    { "source": "素描与色彩之争", "target": "鲁本斯", "name": "推重", "des": "对立阵营举色彩为魂，鲁本斯是现世的神祇。" },
    { "source": "普桑", "target": "新古典主义", "name": "遥启", "des": "考古的严谨与理性的构图，隔世纪成了革命画家的祖训。" },
    { "source": "洛可可", "target": "鲁本斯", "name": "化用", "des": "抽掉鲁本斯肉感中的神性，只剩脂粉的欢愉。" },
    { "source": "华托", "target": "洛可可", "name": "开风", "des": "发舟西苔岛的忧郁郊游，剪下洛可可的第一张票根。" },
    { "source": "弗拉戈纳尔", "target": "洛可可", "name": "收梢", "des": "《秋千》的粉绿调子，把贵族游戏推向轻艳的末路。" },
    { "source": "荷兰画派", "target": "现实主义", "name": "先声", "des": "不加美化的市民与田舍，为写实宣言预演两百年。" },
    { "source": "学院与沙龙", "target": "大卫", "name": "造就", "des": "罗马奖的磨砺与游学的规训，也埋下决裂的种子。" },
    { "source": "大卫", "target": "新古典主义", "name": "立极", "des": "《荷拉斯兄弟之誓》的硬直线条，把古典变成革命口号。" },
    { "source": "大卫", "target": "马拉之死", "name": "描绘", "des": "浴缸里的殉难者，为革命供奉了第一幅现代圣像。" },
    { "source": "大卫", "target": "安格尔", "name": "师承", "des": "弟子接过线条的信仰，把老师的革命冷却成秩序。" },
    { "source": "安格尔", "target": "拉斐尔", "name": "皈依", "des": "自称拉斐尔最忠实的信徒，线条高于色彩终生不改。" },
    { "source": "安格尔", "target": "学院与沙龙", "name": "掌门", "des": "长期执掌罗马的法兰西学院，素描训练是不二法门。" },
    { "source": "新古典主义", "target": "学院与沙龙", "name": "合流", "des": "规范变作评分标准，官方趣味有了执行机构。" },
    { "source": "热里科", "target": "大卫", "name": "门墙", "des": "出身大卫一系的画室，目光却转向沉船与疯人。" },
    { "source": "热里科", "target": "梅杜萨之筏", "name": "铸成", "des": "剃发闭关，对着真人尸骸与船模造出怒涛。" },
    { "source": "梅杜萨之筏", "target": "浪漫主义", "name": "揭幕", "des": "沙龙一役震动欧洲，浪漫主义就此登上正席。" },
    { "source": "热里科", "target": "德拉克洛瓦", "name": "提携", "des": "同门后进在筏上做模特，日后执浪漫派帅印。" },
    { "source": "德拉克洛瓦", "target": "浪漫主义", "name": "执旗", "des": "色彩即激情的宣言，与新古典缠斗整整一生。" },
    { "source": "德拉克洛瓦", "target": "自由引导人民", "name": "描绘", "des": "三色旗插上街垒，浪漫主义抢下历史的头版。" },
    { "source": "德拉克洛瓦", "target": "安格尔", "name": "论战", "des": "素描派与色彩派的旧案，在沙龙重审三十年。" },
    { "source": "哥雅", "target": "浪漫主义", "name": "先声", "des": "农神食子与黑色绘画，画尽理性时代的黑夜。" },
    { "source": "哥雅", "target": "德拉克洛瓦", "name": "启发", "des": "版画里的狞厉想象，被浪漫派的狮子一口吞下。" },
    { "source": "哥雅", "target": "马奈", "name": "先导", "des": "裸体的玛哈直视观者，为奥林匹亚递去目光。" },
    { "source": "库尔贝", "target": "现实主义", "name": "立旗", "des": "“画我所见”的自白与《石工》的粗粝，主义有了宣言。" },
    { "source": "米勒", "target": "现实主义", "name": "躬耕", "des": "《拾穗者》与《晚钟》，把土地的重量还给绘画。" },
    { "source": "米勒", "target": "巴比松画派", "name": "栖身", "des": "枫丹白露林边的农舍，产出现代最早的乡民圣像。" },
    { "source": "巴比松画派", "target": "户外写生", "name": "先行", "des": "背画箱进林子直面天光，写生取代闭门造景。" },
    { "source": "库尔贝", "target": "学院与沙龙", "name": "决裂", "des": "自办个展、拒领勋章，声称不属于任何官方画派。" },
    { "source": "马奈", "target": "奥林匹亚", "name": "描绘", "des": "借提香的斜卧让妓女直视巴黎，丑闻反成加冕。" },
    { "source": "马奈", "target": "落选者沙龙", "name": "参展", "des": "《草地上的午餐》在被拒之棚揭幕，笑骂中现代登场。" },
    { "source": "落选者沙龙", "target": "印象派", "name": "成军", "des": "官方的拒绝把叛逆者赶进同一顶帐篷，从此结盟。" },
    { "source": "马奈", "target": "印象派", "name": "尊为", "des": "被尊为印象派之父，却始终拒绝与他们同挂一室。" },
    { "source": "莫奈", "target": "印象派", "name": "押阵", "des": "八次联展来去之间，他是场内的定海针与活招牌。" },
    { "source": "日出·印象", "target": "印象派", "name": "命名", "des": "记者的讥讽脱口而出，画派从此顶着绰号行走。" },
    { "source": "莫奈", "target": "日出·印象", "name": "绘成", "des": "勒阿弗尔港的晨雾里，一笔船影定下画派的名分。" },
    { "source": "莫奈", "target": "户外写生", "name": "践行", "des": "成串画布追逐同一草垛的光，写生推到苦行的地步。" },
    { "source": "印象派", "target": "光学混色", "name": "依循", "des": "色彩并置的学说成了画法，调色板搬到视网膜上。" },
    { "source": "雷诺阿", "target": "印象派", "name": "参展", "des": "光斑落上舞会的裙裾，欢乐是他给时代的注脚。" },
    { "source": "德加", "target": "印象派", "name": "同盟", "des": "自称独立的画家，却把联展张罗成自己的剧场。" },
    { "source": "德加", "target": "马奈", "name": "知交", "des": "同代的都市观察者，在沙龙与咖啡馆互为镜子。" },
    { "source": "毕沙罗", "target": "印象派", "name": "全勤", "des": "八次联展一场不落，年长的定盘星与和事佬。" },
    { "source": "毕沙罗", "target": "塞尚", "name": "扶掖", "des": "劝年轻人直面自然作画，师友之间情同父子。" },
    { "source": "浮世绘", "target": "莫奈", "name": "东渐", "des": "北斋与广重的平涂版式，挂满吉维尼的餐厅。" },
    { "source": "学院与沙龙", "target": "落选者沙龙", "name": "逼出", "des": "三千落选作品另棚展出，嘲笑声反成成人礼。" },
    { "source": "德拉克洛瓦", "target": "印象派", "name": "遗泽", "des": "并置的纯色碎笔被接手，色彩开始自己呼吸。" },
    { "source": "塞尚", "target": "后印象派", "name": "居首", "des": "从印象派内部反向突围，把光色重新铸成结构。" },
    { "source": "塞尚", "target": "立体主义", "name": "启发", "des": "“以圆柱体、球体看自然”的遗嘱，孵出立体主义。" },
    { "source": "塞尚", "target": "毕加索", "name": "施洗", "des": "圣维克托尔山的体块，成了拆解形体的语法书。" },
    { "source": "梵高", "target": "星月夜", "name": "绘成", "des": "病房铁窗外的夜空，柏树扭成火焰与漩涡。" },
    { "source": "梵高", "target": "表现主义", "name": "引爆", "des": "燃烧的笔触与颜色，被德国青年直接接上火种。" },
    { "source": "米勒", "target": "梵高", "name": "遥启", "des": "拾穗者的背影，被他一遍遍临成自己的圣像。" },
    { "source": "高更", "target": "象征主义", "name": "相通", "des": "综合主义的平涂与轮廓，把绘画从写实引向意念。" },
    { "source": "高更", "target": "纳比派", "name": "遗风", "des": "蓬塔旺的教诲被巴黎弟子接走，神秘继续生长。" },
    { "source": "修拉", "target": "点彩法", "name": "创立", "des": "两年的《大碗岛》把色彩直觉改写成光学公式。" },
    { "source": "点彩法", "target": "光学混色", "name": "演算", "des": "纯色小点交由视网膜调合，感觉让位给公式。" },
    { "source": "浮世绘", "target": "梵高", "name": "临摹", "des": "追临广重的雨桥，东方的线与西方的色合流。" },
    { "source": "浮世绘", "target": "劳特累克", "name": "借镜", "des": "平色块与流利轮廓，直接改写了海报设计。" },
    { "source": "劳特累克", "target": "后印象派", "name": "侧翼", "des": "蒙马特的声色加日本式线条，广告走进艺术。" },
    { "source": "后印象派", "target": "野兽派", "name": "转进", "des": "解放了的颜色与线条，顺流而下就是野兽的领地。" },
    { "source": "象征主义", "target": "超现实主义", "name": "伏脉", "des": "梦与隐喻的合法化，为超现实预留了入口。" },
    { "source": "马蒂斯", "target": "野兽派", "name": "执旗", "des": "颜色脱离描写的差事，红与绿只为画面燃烧。" },
    { "source": "马蒂斯", "target": "毕加索", "name": "竞逐", "des": "半世纪的对望与敬意，二十世纪最长的双人对话。" },
    { "source": "毕加索", "target": "亚维农少女", "name": "绘成", "des": "五个裸女的碎裂面孔，现代艺术在此拐弯。" },
    { "source": "亚维农少女", "target": "立体主义", "name": "破土", "des": "断裂的面孔与躯体，次年长成系统的画法。" },
    { "source": "毕加索", "target": "立体主义", "name": "创立", "des": "与布拉克把物拆成多视面，执行塞尚的遗嘱。" },
    { "source": "康定斯基", "target": "表现主义", "name": "出发", "des": "蓝骑士的旗帜下，色彩先一步挣脱物象。" },
    { "source": "野兽派", "target": "康定斯基", "name": "递进", "des": "色彩的彻底解放，让人敢问颜色能否独立成画。" },
    { "source": "康定斯基", "target": "抽象表现主义", "name": "先声", "des": "音乐式即兴与点线面的理论，跨洋播下种子。" },
    { "source": "杜尚", "target": "达达主义", "name": "同谋", "des": "不入任何团体，却是所有反叛者共认的教父。" },
    { "source": "杜尚", "target": "现成品", "name": "提交", "des": "一九一七年把小便池签上化名送展，地基被抽走。" },
    { "source": "现成品", "target": "波普艺术", "name": "铺路", "des": "日常物即艺术的逻辑，几十年后兑现成产业。" },
    { "source": "达达主义", "target": "超现实主义", "name": "演变", "des": "巴黎的达达放下破坏，转身勘察梦境。" },
    { "source": "达利", "target": "超现实主义", "name": "入列", "des": "偏执狂批判法把梦境画成照片般的清晰。" },
    { "source": "超现实主义", "target": "抽象表现主义", "name": "渡洋", "des": "自动主义随流亡画家登陆纽约，化成行动绘画。" },
    { "source": "波洛克", "target": "抽象表现主义", "name": "领衔", "des": "画布铺地、滴洒颜料，身体与颜料直接相搏。" },
    { "source": "抽象表现主义", "target": "波普艺术", "name": "反动", "des": "崇高与宏大之后，年轻一代反手拥抱商品图像。" },
    { "source": "沃霍尔", "target": "波普艺术", "name": "定型", "des": "丝网印的汤罐与玛丽莲，把消费时代印成圣像。" },
    { "source": "毕加索", "target": "杜尚", "name": "并峙", "des": "形式革命与观念革命两条路，现代艺术的双峰。" },
    { "source": "毕沙罗", "target": "高更", "name": "点拨", "des": "劝他放下股票经纪的营生，专心画眼前的光。" },
    { "source": "马奈", "target": "库尔贝", "name": "并称", "des": "同为官方眼中的粗野派，彼此却互不服气。" },
    { "source": "提香", "target": "油画", "name": "挥洒", "des": "以阔笔直接堆叠罩染，油彩的表现力写到极致。" },
    { "source": "莫奈", "target": "雷诺阿", "name": "同窗", "des": "格莱尔画室的同窗，并肩画下青蛙塘的光。" }
  ],
  "title": "西方绘画史",
  "description": "从乔托的湿壁画到杜尚的小便池，画布上七百年的观念接力、师承与决裂。"
