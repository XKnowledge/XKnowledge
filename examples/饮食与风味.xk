ce":"烘焙度","target":"醇厚度","name":"深压","des":"深烘压酸增苦口感转向厚重。"},{"source":"烘焙度","target":"研磨度","name":"相应","des":"烘得越深豆越脆研磨须随之放粗。"},{"source":"意式咖啡机","target":"意式浓缩","name":"加压","des":"一九零一年贝泽拉首倡蒸汽加压。"},{"source":"意式浓缩","target":"研磨度","name":"极细","des":"细粉压实成饼方经得起九帕压力。"},{"source":"意式浓缩","target":"克丽玛","name":"浮面","des":"高压把油脂与气乳成金褐色沫。"},{"source":"意式浓缩","target":"醇厚度","name":"质感","des":"油脂与胶感在高压下愈发缠绵。"},{"source":"虹吸壶","target":"精品咖啡运动","name":"东瀛","des":"日本喫茶店的虹吸台昭和的余温。"},{"source":"拿铁","target":"意式浓缩","name":"底座","des":"浓缩兑大量蒸奶奶泡厚而柔顺。"},{"source":"卡布奇诺","target":"意式浓缩","name":"底座","des":"浓缩奶泡奶液三分而立的格局。"},{"source":"拿铁","target":"卡布奇诺","name":"近亲","des":"奶泡厚薄之别定两杯的性格。"},{"source":"拉花","target":"拿铁","name":"点睛","des":"倾壶画叶奶泡的张力即画布。"},{"source":"拉花","target":"卡布奇诺","name":"同框","des":"卡布的经典奶泡也是拉花最早的画布。"},{"source":"手冲","target":"研磨度","name":"中粗","des":"滴滤宜中度偏粗三分钟内见分晓。"},{"source":"手冲","target":"粉水比","name":"秤量","des":"一比十五上下秤与壶是手冲戒尺。"},{"source":"粉水比","target":"金杯准则","name":"落点","des":"浓度介于百分之一二浓淡的分寸。"},{"source":"萃取率与浓度","target":"金杯准则","name":"双轴","des":"萃取十八至二十二与浓度互为经纬。"},{"source":"金杯准则","target":"手冲","name":"指导","des":"按图调参浓淡苦酸皆有据可依。"},{"source":"研磨度","target":"萃取率与浓度","name":"节流","des":"粉之粗细定水流快慢与溶出多寡。"},{"source":"杯测","target":"风味轮","name":"语汇","des":"啜吸之间以轮上词为风味命名。"},{"source":"杯测","target":"精品咖啡运动","name":"裁判","des":"竞赛与采购定价皆凭杯测说话。"},{"source":"精品咖啡运动","target":"手冲","name":"奉为","des":"第三波把手冲奉为品鉴产地的仪式。"},{"source":"精品咖啡运动","target":"瑰夏","name":"图腾","des":"一杯天价瑰夏第三波的旗帜。"},{"source":"精品咖啡运动","target":"处理法","name":"深耕","des":"微批次与实验处理因精品而盛。"},{"source":"精品咖啡运动","target":"烘焙","name":"改浅","des":"为产地让路烘焙整体转向浅段。"},{"source":"速溶咖啡","target":"越南","name":"取材","des":"速溶大厂的罗豆大半采自越南高原。"},{"source":"风味轮","target":"酸质","name":"首环","des":"果酸柑橘苹果最先展开的一环。"},{"source":"耶加雪菲","target":"酸质","name":"代言","des":"柑橘茉莉的亮酸产地的活招牌。"},{"source":"酸质","target":"手冲","name":"主场","des":"干净萃取最衬明亮的果酸。"},{"source":"意式咖啡机","target":"拿铁","name":"赋能","des":"蒸汽棒与稳定压力把奶咖送上日常。"},{"source":"茶树原产地","target":"茶学","name":"溯源","des":"茶自滇藏交界的原始丛林一路走来，化草木为文明。"},{"source":"神农尝茶","target":"茶学","name":"传说","des":"神农得荼解毒的传说，为茶进入人间写下开头。"},{"source":"陆羽","target":"茶经","name":"著述","des":"隐居苕溪著成三卷十章，一人定千秋茶事。"},{"source":"茶经","target":"茶学","name":"奠基","des":"世界第一部茶学专著出世，茶自此有学可循。"},{"source":"陆羽","target":"煎茶法","name":"定型","des":"定二十四器、辨三沸之水，唐代煎饮由此成法。"},{"source":"卢仝","target":"茶学","name":"咏茶","des":"七碗茶歌把茶饮写到乘风欲仙，诗与茶相互成全。"},{"source":"卢仝","target":"陆羽","name":"嗣响","des":"茶圣立说于前，茶仙咏叹于后，唐代茶事双璧。"},{"source":"煎茶法","target":"点茶","name":"演化","des":"唐煎宋点，研末入盏代替投末入锅，风气随世而移。"},{"source":"点茶","target":"斗茶","name":"支撑","des":"斗茶以点茶比高下，汤花咬盏是胜负手筋。"},{"source":"茶百戏","target":"点茶","name":"衍生","des":"分茶使汤面幻化丹青，点茶技艺的极致余绪。"},{"source":"建盏","target":"斗茶","name":"应运","des":"黑釉衬得雪白汤花，斗茶之风养出建盏名窑。"},{"source":"荣西","target":"点茶","name":"承习","des":"入宋习禅，携茶种与点茶法东归日本。"},{"source":"径山茶宴","target":"荣西","name":"启蒙","des":"日僧多于径山求法，茶宴仪轨随禅东渡。"},{"source":"径山茶宴","target":"点茶","name":"行茶","des":"茶宴以点茶待客，仪式与茶汤一同输出。"},{"source":"荣西","target":"茶学","name":"东传","des":"《吃茶养生记》开日本茶道之先声。"},{"source":"茶马古道","target":"茶学","name":"传播","des":"以茶易马千年不绝，茶随马蹄进入雪域高原。"},{"source":"茶路西行","target":"茶学","name":"西渐","des":"万里茶道与海上茶船，把东方树叶送进欧洲茶杯。"},{"source":"明代散茶","target":"点茶","name":"取代","des":"罢造龙团改贡叶茶，碾末之饮让位于瀹泡。"},{"source":"神农尝茶","target":"茶经","name":"载于","des":"“茶之为饮，发乎神农氏”，开篇即引此传说。"},{"source":"茶马古道","target":"黑茶","name":"边销","des":"紧压砖茶耐储好运，经古道源源输往藏区。"},{"source":"云南普洱","target":"茶马古道","name":"驮运","des":"普洱府因茶而设，贡茶与边销皆自此启程。"},{"source":"茶树原产地","target":"云南普洱","name":"同源","des":"澜沧江流域的古茶树，是普洱茶最老的家底。"},{"source":"茶树原产地","target":"滇红","name":"同源","des":"云南大叶种自原生林走来，成就浓强的滇红。"},{"source":"祁门红茶","target":"茶路西行","name":"远销","des":"祁门香一度是欧洲下午茶的宠儿。"},{"source":"正山小种","target":"茶路西行","name":"远销","des":"松烟香的小种经海路风行英伦，调出下午茶。"},{"source":"煮茶","target":"煎茶法","name":"遗风","des":"今日围炉煮茶，犹是唐宋煮饮的余温。"},{"source":"红茶","target":"茶路西行","name":"风行","des":"红汤香甜合欧洲口味，外销自此以红茶为主。"},{"source":"茶经","target":"择水","name":"品第","des":"山水上江水中井下，五之煮定下千年水评。"},{"source":"炒青","target":"明代散茶","name":"支撑","des":"锅炒出香使散茶立得住，改制的技艺前提。"},{"source":"斗茶","target":"审评","name":"先声","des":"宋人较汤色水痕，堪称最早的感官审评。"},{"source":"茶马古道","target":"蒸压成型","name":"驱动","des":"砖饼缩体防潮，正是为长途驮运而生。"},{"source":"茶百戏","target":"斗茶","name":"同场","des":"分茶之技常在斗茶席上一并献演。"},{"source":"绿茶","target":"发酵程度","name":"不发酵","des":"杀青即止氧化，青翠在锅温中定格。"},{"source":"白茶","target":"发酵程度","name":"微发酵","des":"不炒不揉只经萎凋，氧化浅尝辄止。"},{"source":"黄茶","target":"发酵程度","name":"轻发酵","des":"闷黄促成轻转化，滋味向甘醇靠拢。"},{"source":"乌龙茶","target":"发酵程度","name":"半发酵","des":"做青摇晾之间，氧化停在青红交界。"},{"source":"红茶","target":"发酵程度","name":"全发酵","des":"酶促氧化充分进行，红汤红叶定型。"},{"source":"黑茶","target":"发酵程度","name":"后发酵","des":"渥堆之后仍借微生物缓慢接力转化。"},{"source":"陈椽","target":"茶学","name":"分类","des":"以发酵程度为纲，六大茶类分类法一锤定音。"},{"source":"茶多酚","target":"酶促氧化","name":"底物","des":"儿茶素等待氧化，发酵的戏份全由它担纲。"},{"source":"酶促氧化","target":"发酵程度","name":"机理","des":"发酵一词的化学本体，一切谱系的幕后。"},{"source":"发酵程度","target":"茶学","name":"主轴","des":"一条从零到全的隐形轴，串起六大茶类。"},{"source":"做青","target":"绿叶红镶边","name":"造就","des":"叶缘碰撞氧化变红，叶心犹青，印记分明。"},{"source":"绿叶红镶边","target":"乌龙茶","name":"印记","des":"看叶底如验明正身，半发酵的身份证。"},{"source":"杀青","target":"酶促氧化","name":"阻断","des":"高温钝化氧化酶，青翠与鲜爽得以保全。"},{"source":"酶促氧化","target":"红茶","name":"炼成","des":"儿茶素转为茶黄素茶红素，红汤由此而来。"},{"source":"发酵程度","target":"陈化","name":"延伸","des":"发酵止于初制，转化却可在岁月里续写。"},{"source":"采青","target":"萎凋","name":"入制","des":"鲜叶离树，先在摊放中交出水分。"},{"source":"萎凋","target":"做青","name":"铺垫","des":"适度失水叶质变软，摇青方经得起碰撞。"},{"source":"做青","target":"乌龙茶","name":"定型","des":"摇出香气晾出韵味，乌龙风骨由此养成。"},{"source":"杀青","target":"绿茶","name":"定青","des":"一锅高温锁住翠色，绿茶的命门工序。"},{"source":"炒青","target":"杀青","name":"隶属","des":"锅炒是杀青主流之法，火候即风味。"},{"source":"杀青","target":"揉捻","name":"接续","des":"杀青定色之后，揉捻随即塑形出汁。"},{"source":"揉捻","target":"干燥","name":"衔接","des":"成形之后进烘焙，水分退场品质定型。"},{"source":"闷黄","target":"黄茶","name":"专属","des":"一道闷黄，改写了绿茶的色谱与滋味。"},{"source":"闷黄","target":"君山银针","name":"塑造","des":"金镶玉的芽头与三起三落，皆从闷黄来。"},{"source":"渥堆","target":"黑茶","name":"点睛","des":"湿热与菌酵同工，速成黑茶的醇厚陈韵。"},{"source":"萎凋","target":"白茶","name":"独任","des":"不炒不揉全凭萎凋，日晒就是全部工艺。"},{"source":"萎凋","target":"红茶","name":"铺陈","des":"充分萎凋为发酵备好底物，甜香自此萌发。"},{"source":"干燥","target":"窨制","name":"备坯","des":"茶坯须干透才吸得进花香，先焙后窨。"},{"source":"焙火","target":"乌龙茶","name":"提香","des":"文火慢炖出熟香，岩骨与音韵借火而成。"},{"source":"焙火","target":"武夷岩茶","name":"火功","des":"火功轻重分出清香与足火，岩茶的第二命。"},{"source":"窨制","target":"茉莉花茶","name":"产出","des":"三窨一提甚至九窨，花香入骨方成香片。"},{"source":"蒸压成型","target":"云南普洱","name":"成饼","des":"蒸软紧压为七子饼，圆茶自此可以远行。"},{"source":"蒸压成型","target":"黑茶","name":"成砖","des":"茯砖青砖由此而出，金花亦生于砖内。"},{"source":"明前","target":"采青","name":"时令","des":"清明前头拨芽叶，采茶人争的就是这几天。"},{"source":"渥堆","target":"陈化","name":"速成","des":"渥堆以数十天追出岁月味，是陈化的快进键。"},{"source":"六安瓜片","target":"采青","name":"独法","des":"扳片去芽去梗，单取叶片，采法独树一帜。"},{"source":"正山小种","target":"焙火","name":"熏焙","des":"过红锅后松柴明火熏焙，松烟香由此入骨。"},{"source":"西湖龙井","target":"绿茶","name":"归属","des":"狮峰龙井色翠香郁，扁炒青的巅峰之作。"},{"source":"碧螺春","target":"绿茶","name":"归属","des":"洞庭东西山螺形嫩茶，花果香源自间作。"},{"source":"黄山毛峰","target":"绿茶","name":"归属","des":"高山云雾所出毛峰，形似雀舌绿泛象牙。"},{"source":"六安瓜片","target":"绿茶","name":"归属","des":"无芽无梗单片成茶，绿茶中的独行侠。"},{"source":"安吉白茶","target":"绿茶","name":"名实","des":"名字带白却是绿茶，白化品种的美丽误会。"},{"source":"白毫银针","target":"白茶","name":"归属","des":"福鼎太姥山单芽白茶，满披白毫如银。"},{"source":"君山银针","target":"黄茶","name":"归属","des":"洞庭君山金镶玉，黄茶芽茶的极致代表。"},{"source":"武夷岩茶","target":"乌龙茶","name":"归属","des":"闽北乌龙重水求韵，岩骨花香的门派。"},{"source":"大红袍","target":"武夷岩茶","name":"归属","des":"九龙窠母树的名丛，岩茶之王的血统。"},{"source":"安溪铁观音","target":"乌龙茶","name":"归属","des":"闽南乌龙代表，兰花香七泡有余。"},{"source":"凤凰单丛","target":"乌龙茶","name":"归属","des":"潮州乌龙一树一香，单株采制的极致。"},{"source":"正山小种","target":"红茶","name":"鼻祖","des":"桐木关红茶之源，世界红茶自它起步。"},{"source":"祁门红茶","target":"红茶","name":"归属","des":"祁门香高鲜甜，世界三大高香红茶。"},{"source":"滇红","target":"红茶","name":"归属","des":"大叶种金毫浓强，滇红以力度见长。"},{"source":"云南普洱","target":"黑茶","name":"归属","des":"熟普经渥堆归入黑茶，生普归属尚有争鸣。"},{"source":"西湖龙井","target":"明前","name":"抢鲜","des":"明前龙井贵如金，一年一等的等待。"},{"source":"武夷岩茶","target":"岩韵","name":"独有","des":"岩骨花香入口方知，岩茶独占的风味词。"},{"source":"武夷岩茶","target":"山场","name":"讲究","des":"三坑两涧各擅其胜，同岩不同场价悬殊。"},{"source":"凤凰单丛","target":"山场","name":"看山","des":"乌岽高山老丛难得，山头即身价的通行证。"},{"source":"安溪铁观音","target":"兰花香","name":"标志","des":"观音韵以兰花香为旗，幽长而清正。"},{"source":"凤凰单丛","target":"兰花香","name":"香型","des":"蜜兰香单丛兰香带蜜，香型谱系之首。"},{"source":"安吉白茶","target":"鲜爽","name":"印证","des":"高氨低酚的品种禀赋，鲜爽度冠绝绿茶。"},{"source":"云南普洱","target":"陈化","name":"越陈","des":"生熟皆可陈放，越陈越香的价值主张。"},{"source":"黄山毛峰","target":"高山云雾","name":"产自","des":"黄山峰谷云雾滋养，名山出好茶的注脚。"},{"source":"白茶","target":"陈化","name":"经年","des":"一年茶三年药七年宝，白茶也讲陈放。"},{"source":"云南普洱","target":"茶仓","name":"依托","des":"干仓慢养湿仓速成，仓即是第二重工艺。"},{"source":"白毫银针","target":"萎凋","name":"全凭","des":"单芽全凭日光萎凋，毫香蜜韵不事雕琢。"},{"source":"审评","target":"茶学","name":"法度","des":"五因子评茶，把口感折成可较的分数。"},{"source":"山场","target":"岩韵","name":"孕育","des":"坑涧风土写进茶汤，方有落骨之韵。"},{"source":"高山云雾","target":"鲜爽","name":"滋养","des":"漫射光促氨基酸累积，高处茶更鲜。"},{"source":"回甘","target":"生津","name":"相伴","des":"甘自苦回，津随甘生，如泉徐来舌底。"},{"source":"回甘","target":"喉韵","name":"递进","des":"甘意再往深处走，便成喉间的余韵。"},{"source":"茶多酚","target":"回甘","name":"伏笔","des":"先涩后甘的曲线，是儿茶素埋的伏笔。"},{"source":"茶仓","target":"陈化","name":"承载","des":"温湿光气四事，全由茶仓一手掌管。"},{"source":"绿茶","target":"鲜爽","name":"本色","des":"杀青保住茶氨酸，鲜爽是绿茶的底色。"},{"source":"出汤","target":"回甘","name":"左右","des":"迟一秒苦涩压场，回甘生津皆失其所。"},{"source":"闻香杯","target":"兰花香","name":"聚香","des":"细杯拢香于鼻端，幽香无所遁形。"},{"source":"紫砂壶","target":"乌龙茶","name":"宜泡","des":"双气孔透气蓄香，乌龙重汤尤宜砂壶。"},{"source":"紫砂壶","target":"功夫茶","name":"器具","des":"小壶聚香蓄韵，功夫茶席上的主角。"},{"source":"盖碗","target":"功夫茶","name":"器具","des":"掀盖闻香刮沫啜饮，一碗走遍六大茶类。"},{"source":"盖碗","target":"审评","name":"标准","des":"白瓷盖碗不偏不倚，审评席的标准器。"},{"source":"公道杯","target":"功夫茶","name":"匀汤","des":"先入公道再分盏，一席茶浓淡如一。"},{"source":"闻香杯","target":"功夫茶","name":"闻香","des":"高杯拢香低杯品汤，闽南茶席的搭配。"},{"source":"水温","target":"绿茶","name":"宜凉","des":"八十度上下温柔以待，嫩芽经不起滚烫。"},{"source":"水温","target":"出汤","name":"节拍","des":"温度定快慢，汤色浓淡随之起落。"},{"source":"功夫茶","target":"出汤","name":"讲究","des":"高冲低斟快出汤，快慢之间见真章。"},{"source":"功夫茶","target":"乌龙茶","name":"相伴","des":"乌龙香高韵厚，催出这一套小巧功夫。"},{"source":"功夫茶","target":"水温","name":"沸水","des":"非沸水不足以发乌龙之香，高冲激香。"},{"source":"煮茶","target":"黑茶","name":"宜煮","des":"老黑茶烹煮更醇厚，边地奶茶同其源。"},{"source":"明代散茶","target":"紫砂壶","name":"催生","des":"瀹泡散茶兴起，壶与盏随之改朝换代。"},{"source":"明代散茶","target":"功夫茶","name":"源起","des":"散茶瀹泡向下深耕，便是后来的功夫茶。"},{"source":"建盏","target":"点茶","name":"绝配","des":"兔毫盏衬雪白汤花，点茶家什以此为上。"},{"source":"水温","target":"云南普洱","name":"宜沸","des":"熟普老茶非沸水不能尽其味，且经得起煮。"},{"source":"烹饪与风味科学","target":"饮食与风味","name":"汇入","des":"从母酱到发酵，风味科学的主干道。"},{"source":"咖啡","target":"饮食与风味","name":"汇入","des":"从埃塞俄比亚高原到杯中风味轮的环球旅程。"},{"source":"茶学","target":"饮食与风味","name":"汇入","des":"从陆羽《茶经》到六大茶类的东方谱系。"}],"title":"饮食与风味","description":"咖啡、茶与烹饪三条风味之路：从产地风土到杯盏餐桌的感官科学。"}