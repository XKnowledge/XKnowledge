{"version":2,"nodes":[{"name":"参考系","des":"判定物体运动时所选的参照标准，动与静全由它说了算。","symbolSize":40,"category":"运动学"},{"name":"质点","des":"忽略大小与形状的理想化物体，物理学迈出的第一步抽象。","symbolSize":40,"category":"运动学"},{"name":"位移","des":"从初位置指向末位置的有向线段，只问首尾不问路径。","symbolSize":40,"category":"运动学"},{"name":"速度","des":"位置随时间的变化率，刻画运动快慢与方向的矢量。","symbolSize":50,"category":"运动学"},{"name":"加速度","des":"速度变化量与所用时间之比，描述速度变化快慢的矢量。","symbolSize":50,"category":"运动学"},{"name":"匀变速直线运动","des":"加速度恒定不变的直线运动，v-t 图像是一条倾斜直线。","symbolSize":40,"category":"运动学"},{"name":"自由落体运动","des":"初速度为零只受重力的匀加速下落，伽利略以此推翻重快轻慢。","symbolSize":40,"category":"运动学"},{"name":"抛体运动","des":"只受重力作用下的曲线运动，可分解为水平匀速与竖直匀变速。","symbolSize":40,"category":"运动学"},{"name":"圆周运动","des":"轨迹为圆周的运动，描述转动世界最基本的理想模型。","symbolSize":40,"category":"运动学"},{"name":"角速度","des":"转过角度与所用时间之比，度量转动快慢的物理量。","symbolSize":40,"category":"运动学"},{"name":"向心加速度","des":"始终指向圆心的加速度，只改变速度方向不改变速度大小。","symbolSize":40,"category":"运动学"},{"name":"线速度","des":"经过弧长与所用时间之比，沿圆周切线方向指示快慢。","symbolSize":40,"category":"运动学"},{"name":"相对运动","des":"相对不同参考系的运动彼此关联，速度矢量可叠加换算。","symbolSize":40,"category":"运动学"},{"name":"力","des":"物体间的相互作用，改变物体运动状态或使物体发生形变。","symbolSize":50,"category":"动力学"},{"name":"重力","des":"由地球吸引而产生，方向竖直向下，大小随纬度海拔微变。","symbolSize":40,"category":"动力学"},{"name":"弹力","des":"发生弹性形变的物体因要恢复原状而对接触物体产生的力。","symbolSize":40,"category":"动力学"},{"name":"摩擦力","des":"接触面间阻碍相对运动或相对运动趋势的力，分静与动。","symbolSize":40,"category":"动力学"},{"name":"惯性","des":"物体保持原有运动状态的属性，大小仅由质量量度。","symbolSize":40,"category":"动力学"},{"name":"牛顿第一定律","des":"不受外力时物体保持静止或匀速直线运动，又称惯性定律。","symbolSize":50,"category":"动力学"},{"name":"牛顿第二定律","des":"F=ma，物体的加速度与合外力成正比、与质量成反比。","symbolSize":70,"category":"动力学"},{"name":"牛顿第三定律","des":"作用力与反作用力等大反向，同生同灭，作用在不同物体上。","symbolSize":40,"category":"动力学"},{"name":"受力分析","des":"按重力、弹力、摩擦力的顺序逐一排查物体所受的力。","symbolSize":40,"category":"动力学"},{"name":"万有引力定律","des":"任意两物体相互吸引，F=GMm/r²，把天地运动纳入同一规律。","symbolSize":70,"category":"动力学"},{"name":"开普勒定律","des":"关于行星椭圆轨道、面积速率与周期关系的三定律，源自第谷的观测数据。","symbolSize":40,"category":"动力学"},{"name":"第一宇宙速度","des":"7.9 km/s，卫星贴地圆轨道环绕所需的最小发射速度。","symbolSize":40,"category":"动力学"},{"name":"人造卫星","des":"达到环绕速度后绕地球运行的人造天体，轨道越高环绕越慢。","symbolSize":40,"category":"动力学"},{"name":"超重与失重","des":"加速度向上视重增大为超重，向下为失重，a=g 时完全失重。","symbolSize":40,"category":"动力学"},{"name":"功","des":"力与沿力方向位移的乘积 W=Flcosα，力在空间上的积累。","symbolSize":50,"category":"功和能"},{"name":"功率","des":"功与所用时间之比 P=W/t，机器做功快慢的标尺。","symbolSize":40,"category":"功和能"},{"name":"重力做功","des":"只与起点终点高度差有关、与路径无关，是重力势能变化的量度。","symbolSize":40,"category":"功和能"},{"name":"动能","des":"物体因运动而具有的能量，大小为 mv²/2，恒为正值。","symbolSize":40,"category":"功和能"},{"name":"势能","des":"由相互作用及相对位置决定的能量，蓄势待发的能量家族。","symbolSize":40,"category":"功和能"},{"name":"重力势能","des":"mgh，由物体与地球的相对高度决定，零势能面可自行选取。","symbolSize":40,"category":"功和能"},{"name":"弹性势能","des":"储存在发生形变物体中的能量，由劲度系数与形变量共同决定。","symbolSize":40,"category":"功和能"},{"name":"机械能","des":"动能与势能的总和，宏观机械运动的能量总账。","symbolSize":40,"category":"功和能"},{"name":"动能定理","des":"合外力做的功等于物体动能的变化量，功与动能的结算公式。","symbolSize":50,"category":"功和能"},{"name":"机械能守恒定律","des":"只有重力或弹力做功时，动能与势能相互转化而总量保持不变。","symbolSize":50,"category":"功和能"},{"name":"能量守恒定律","des":"能量不会凭空产生或消灭，只会从一种形式转化为另一种形式。","symbolSize":70,"category":"功和能"},{"name":"功能关系","des":"功是能量转化的量度，做了多少功便有多少能量发生转化。","symbolSize":40,"category":"功和能"},{"name":"摩擦生热","des":"滑动摩擦力与相对路程之积转化为内能，机械能的散逸出口。","symbolSize":40,"category":"功和能"},{"name":"动量","des":"质量与速度的乘积 p=mv，度量机械运动强弱并沿矢量传递。","symbolSize":50,"category":"动量与碰撞"},{"name":"冲量","des":"力与作用时间的乘积 I=Ft，力在时间上的积累。","symbolSize":40,"category":"动量与碰撞"},{"name":"动量定理","des":"合外力的冲量等于动量的变化量，力在时间积累上的结算式。","symbolSize":50,"category":"动量与碰撞"},{"name":"动量守恒定律","des":"系统不受外力或外力矢量和为零时，总动量保持不变。","symbolSize":70,"category":"动量与碰撞"},{"name":"碰撞","des":"物体间短时间强烈相互作用的过程，内力远大于外力。","symbolSize":40,"category":"动量与碰撞"},{"name":"弹性碰撞","des":"碰后形变完全恢复、动能无损失，动量与动能双守恒。","symbolSize":40,"category":"动量与碰撞"},{"name":"非弹性碰撞","des":"碰后形变不完全恢复，部分动能转化为内能。","symbolSize":40,"category":"动量与碰撞"},{"name":"完全非弹性碰撞","des":"碰后合为一体共同运动，动能损失最大的碰撞。","symbolSize":40,"category":"动量与碰撞"},{"name":"反冲","des":"系统内一部分向后喷出、其余部分向前加速的现象。","symbolSize":40,"category":"动量与碰撞"},{"name":"火箭原理","des":"持续高速喷气获得反冲推力，动量守恒写就的航天引擎。","symbolSize":40,"category":"动量与碰撞"},{"name":"爆炸","des":"内力瞬间释放能量的过程，各部分总动量依然守恒。","symbolSize":40,"category":"动量与碰撞"},{"name":"缓冲","des":"延长作用时间以减小冲击力，安全气囊的物理内核。","symbolSize":40,"category":"动量与碰撞"},{"name":"牛顿摆","des":"一球撞入一球飞出的摆阵，动量与动能传递的活教具。","symbolSize":40,"category":"动量与碰撞"},{"name":"电荷","des":"物体的带电属性，同种相斥异种相吸，电荷量代数和守恒。","symbolSize":50,"category":"静电场"},{"name":"元电荷","des":"最小电荷量单位 e=1.6×10⁻¹⁹ C，任何电荷量都是它的整数倍。","symbolSize":40,"category":"静电场"},{"name":"点电荷","des":"忽略大小和形状的理想化带电体，与质点一脉相承的抽象。","symbolSize":40,"category":"静电场"},{"name":"库仑定律","des":"真空中两点电荷间 F=kq₁q₂/r²，与引力定律同形的平方反比律。","symbolSize":70,"category":"静电场"},{"name":"电场","des":"电荷周围存在的特殊物质，传递电力的媒介，超距观念的终结者。","symbolSize":50,"category":"静电场"},{"name":"电场强度","des":"试探电荷所受电场力与电荷量之比 E=F/q，描述场的力的性质。","symbolSize":40,"category":"静电场"},{"name":"电场线","des":"形象描绘电场的曲线，疏密示强弱、切线示方向，永不相交。","symbolSize":40,"category":"静电场"},{"name":"电势","des":"电势能与电荷量之比，描述电场能的性质的标量。","symbolSize":40,"category":"静电场"},{"name":"电势差","des":"电场中两点电势之差 U_AB，电压表读数背后的物理本体。","symbolSize":40,"category":"静电场"},{"name":"等势面","des":"电势相等的点构成的面，沿它移动电荷电场力不做功。","symbolSize":40,"category":"静电场"},{"name":"电势能","des":"电荷在电场中因位置而储存的能量，与重力势能同构。","symbolSize":40,"category":"静电场"},{"name":"电容","des":"电容器储存电荷的本领 C=Q/U，比值定义法的又一典范。","symbolSize":40,"category":"静电场"},{"name":"电容器","des":"两极板相对而立蓄存电荷的元件，充放电之间吞吐能量。","symbolSize":40,"category":"静电场"},{"name":"带电粒子在电场中运动","des":"电场力驱动下的加速与偏转，匀强场中轨迹是抛物线。","symbolSize":40,"category":"静电场"},{"name":"磁场","des":"磁体与电流周围存在的特殊物质，对运动电荷和电流施力。","symbolSize":50,"category":"磁场与电磁感应"},{"name":"磁感应强度","des":"垂直于磁场放置的通电导线所受之力与 IL 之比，磁场的定量名片。","symbolSize":40,"category":"磁场与电磁感应"},{"name":"磁感线","des":"描绘磁场的闭合曲线，外部由 N 极指向 S 极，疏密示强弱。","symbolSize":40,"category":"磁场与电磁感应"},{"name":"安培力","des":"磁场对通电导线的作用力，方向由左手定则裁决。","symbolSize":40,"category":"磁场与电磁感应"},{"name":"洛伦兹力","des":"磁场对运动电荷的作用力 f=qvB，方向总垂直于速度。","symbolSize":40,"category":"磁场与电磁感应"},{"name":"带电粒子在磁场中运动","des":"洛伦兹力充当向心力，带电粒子在匀强磁场中做匀速圆周运动。","symbolSize":40,"category":"磁场与电磁感应"},{"name":"磁通量","des":"穿过线圈的磁感应强度与有效面积之积 Φ=BS，电磁感应的钥匙孔。","symbolSize":40,"category":"磁场与电磁感应"},{"name":"电磁感应","des":"磁通量变化激发感应电动势，打开磁生电时代的伟大闸门。","symbolSize":50,"category":"磁场与电磁感应"},{"name":"法拉第电磁感应定律","des":"感应电动势与磁通量变化率成正比 E=nΔΦ/Δt，电气时代的基石。","symbolSize":70,"category":"磁场与电磁感应"},{"name":"楞次定律","des":"感应电流总要阻碍磁通量的变化，来拒去留的方向法则。","symbolSize":40,"category":"磁场与电磁感应"},{"name":"自感","des":"因自身电流变化而引发的电磁感应，线圈里的电磁惯性。","symbolSize":40,"category":"磁场与电磁感应"},{"name":"交变电流","des":"大小和方向随时间周期性变化的电流，正弦式为其标准波形。","symbolSize":40,"category":"磁场与电磁感应"},{"name":"变压器","des":"利用互感现象改变交流电压的装置，理想时功率收支相抵。","symbolSize":40,"category":"磁场与电磁感应"},{"name":"麦克斯韦电磁理论","des":"变化的磁场生电场、变化的电场生磁场，预言电磁波并统一光与电磁。","symbolSize":40,"category":"磁场与电磁感应"}],"links":[{"source":"位移","target":"参考系","name":"定义于","des":"位置变化须相对参考系而言，先选系后谈运动。"},{"source":"速度","target":"位移","name":"定义自","des":"位移与所用时间之比，运动快慢由此可量。"},{"source":"加速度","target":"速度","name":"定义自","des":"速度变化量与时间之比，变化快慢有了刻度。"},{"source":"匀变速直线运动","target":"加速度","name":"表征于","des":"加速度恒定是它的身份证，v-t 图为直线。"},{"source":"自由落体运动","target":"匀变速直线运动","name":"归于","des":"初速为零加速度为 g，最纯粹的匀加速。"},{"source":"抛体运动","target":"匀变速直线运动","name":"分解为","des":"竖直分运动匀加速，水平分运动匀速。"},{"source":"角速度","target":"圆周运动","name":"描述","des":"单位时间转过的角度，转得快慢一眼可读。"},{"source":"线速度","target":"圆周运动","name":"描述","des":"单位时间经过的弧长，沿切线方向指向前方。"},{"source":"向心加速度","target":"圆周运动","name":"表征","des":"始终指向圆心，只改变方向不改变快慢。"},{"source":"角速度","target":"线速度","name":"换算为","des":"v=ωr，同轴转动半径越大线速度越大。"},{"source":"相对运动","target":"参考系","name":"依托","des":"速度的叠加与换算皆相对参考系而言。"},{"source":"抛体运动","target":"质点","name":"主体是","des":"不计自转与形状，抛体方可当作质点处理。"},{"source":"相对运动","target":"速度","name":"叠加","des":"伽利略速度变换，相对速度是矢量之差。"},{"source":"向心加速度","target":"加速度","name":"特化于","des":"圆周运动中加速度的专案，方向时刻指向圆心。"},{"source":"重力","target":"力","name":"属于","des":"地球施与的吸引力分量，力的家族一员。"},{"source":"弹力","target":"力","name":"属于","des":"形变物体恢复原状所施，力的家族一员。"},{"source":"摩擦力","target":"力","name":"属于","des":"接触面上阻碍相对运动的力，力的家族一员。"},{"source":"牛顿第一定律","target":"惯性","name":"揭示","des":"不受力时运动状态不变，惯性从此登上舞台。"},{"source":"牛顿第二定律","target":"力","name":"联结","des":"合外力是产生加速度的原因，因果一式相通。"},{"source":"牛顿第三定律","target":"力","name":"配对","des":"作用力与反作用力成对出现，异体而同生死。"},{"source":"受力分析","target":"力","name":"清点","des":"按重力弹力摩擦力的次序逐一排查登记。"},{"source":"受力分析","target":"牛顿第二定律","name":"服务于","des":"摸清合力后代入 F=ma，解题链条就此接通。"},{"source":"重力","target":"万有引力定律","name":"源于","des":"地面所受重力是万有引力的主要分量。"},{"source":"开普勒定律","target":"万有引力定律","name":"铺垫","des":"行星运动观测律在前，引力理论水到渠成。"},{"source":"第一宇宙速度","target":"万有引力定律","name":"源于","des":"引力充当向心力，解出 7.9 km/s 的门槛。"},{"source":"人造卫星","target":"第一宇宙速度","name":"起跑于","des":"达此速度方能贴地环绕，越高反而越慢。"},{"source":"功率","target":"功","name":"定义自","des":"功与时间之比，做功快慢的秒表读数。"},{"source":"重力做功","target":"重力势能","name":"量度","des":"做多少功，重力势能就变多少，与路径无关。"},{"source":"重力势能","target":"势能","name":"归属于","des":"因高度而蓄的势能，零势面可任选。"},{"source":"弹性势能","target":"势能","name":"归属于","des":"因形变而蓄的势能，与重力势能同族不同源。"},{"source":"动能","target":"机械能","name":"汇入","des":"机械能总账中随速度起舞的一半。"},{"source":"势能","target":"机械能","name":"汇入","des":"机械能总账中随位置沉淀的一半。"},{"source":"动能定理","target":"功","name":"架桥于","des":"合外力功是因，动能变化是果，一桥贯通。"},{"source":"动能定理","target":"动能","name":"架桥于","des":"末态减初态动能，功的账户即时结算。"},{"source":"机械能守恒定律","target":"能量守恒定律","name":"隶属于","des":"机械能内部分工转化，总能量纹丝不动。"},{"source":"机械能守恒定律","target":"机械能","name":"看护","des":"只有重力弹力做功时，总账数字不变。"},{"source":"功能关系","target":"能量守恒定律","name":"连接","des":"功为转化量度，守恒律由此可对账。"},{"source":"摩擦生热","target":"能量守恒定律","name":"印证","des":"消失的机械能并未蒸发，只是改姓内能。"},{"source":"动量定理","target":"冲量","name":"联结","des":"合外力冲量是因，动量变化是果。"},{"source":"动量定理","target":"动量","name":"联结","des":"冲量多大动量就变多大，矢量同向。"},{"source":"碰撞","target":"动量守恒定律","name":"遵循","des":"内力远大于外力，系统总动量几乎不变。"},{"source":"碰撞","target":"弹性碰撞","name":"分为","des":"形变完全恢复的一支，动能分毫无损。"},{"source":"碰撞","target":"非弹性碰撞","name":"分为","des":"形变部分保留的一支，动能有所折损。"},{"source":"非弹性碰撞","target":"完全非弹性碰撞","name":"包含","des":"碰后合体共速，动能损失最惨烈的极端。"},{"source":"反冲","target":"动量守恒定律","name":"体现","des":"内部喷排双向抵消，总动量原地不动。"},{"source":"火箭原理","target":"反冲","name":"依托","des":"高速喷气换反冲推力，逐级抛壳减质量。"},{"source":"爆炸","target":"动量守恒定律","name":"遵循","des":"内力骤起外力不及，碎片总动量照旧守恒。"},{"source":"缓冲","target":"动量定理","name":"演绎","des":"动量变化一定时，延长时间即摊薄冲击力。"},{"source":"牛顿摆","target":"动量守恒定律","name":"演示","des":"一球撞入一球飞出，动量如数移交。"},{"source":"牛顿摆","target":"弹性碰撞","name":"演示","des":"钢球间近弹性碰撞，动能几乎全额转账。"},{"source":"元电荷","target":"电荷","name":"量度","des":"电荷量只能是元电荷的整数倍，无半份电荷。"},{"source":"库仑定律","target":"点电荷","name":"描述","des":"真空中两点电荷间的平方反比作用力。"},{"source":"电荷","target":"电场","name":"激发","des":"电荷所在之处，四周空间随之带上电场。"},{"source":"电场强度","target":"电场","name":"定义自","des":"F/q 比值定义，场强是场自身的属性。"},{"source":"电场线","target":"电场","name":"描绘","des":"疏密与切线把看不见的场画在纸上。"},{"source":"电场线","target":"等势面","name":"垂直于","des":"场线处处与等势面正交，指向电势降落方向。"},{"source":"电势差","target":"电势","name":"定义自","des":"两点电势之差，电流奔跑的落差源头。"},{"source":"等势面","target":"电势","name":"图示","des":"等势面密处场强大，电势分布一目了然。"},{"source":"电容","target":"电容器","name":"量度","des":"C=Q/U，容纳电荷本领的出厂指标。"},{"source":"带电粒子在电场中运动","target":"电场强度","name":"受驱于","des":"qE 即合力，加速度随场强即刻生效。"},{"source":"电容器","target":"电场","name":"锚定","des":"两板间的电场正是它储存能量的仓库。"},{"source":"电势能","target":"电势差","name":"取决于","des":"电场力做功 qU，电势能随之增减。"},{"source":"电场强度","target":"库仑定律","name":"源自","des":"点电荷场强 E=kQ/r²，由库仑定律导出。"},{"source":"磁感应强度","target":"磁场","name":"描述","des":"F/IL 比值定义，磁场强弱有了刻度。"},{"source":"磁感线","target":"磁场","name":"描绘","des":"闭合曲线从 N 出 S 进，疏密示强弱。"},{"source":"安培力","target":"磁场","name":"源自","des":"通电导线在磁场中受力，左手定则定方向。"},{"source":"洛伦兹力","target":"磁场","name":"源自","des":"磁场对运动电荷的作用，方向垂直 v 与 B。"},{"source":"洛伦兹力","target":"安培力","name":"累积为","des":"无数运动电荷所受力的宏观总和。"},{"source":"带电粒子在磁场中运动","target":"洛伦兹力","name":"受制于","des":"力总垂直速度，速率不变方向常变。"},{"source":"电磁感应","target":"磁通量","name":"源于","des":"磁通一变电动势即生，闸门就此打开。"},{"source":"法拉第电磁感应定律","target":"电磁感应","name":"量化","des":"E=nΔΦ/Δt，变化率决定电动势大小。"},{"source":"楞次定律","target":"电磁感应","name":"裁决","des":"感应电流总反抗磁通变化，来拒去留。"},{"source":"自感","target":"电磁感应","name":"特例于","des":"自己的电流改自己的磁通，线圈生出电磁惯性。"},{"source":"交变电流","target":"电磁感应","name":"生成于","des":"线圈在磁场中匀速旋转，正弦电动势涌出。"},{"source":"变压器","target":"交变电流","name":"依托","des":"互感升降电压，直流它拒之门外。"},{"source":"麦克斯韦电磁理论","target":"法拉第电磁感应定律","name":"升华于","des":"实验发现升为方程组，场论由此立起。"},{"source":"磁通量","target":"磁感应强度","name":"定义于","des":"Φ=BS cosθ，B 与面积的几何对话。"},{"source":"牛顿第二定律","target":"加速度","name":"联结","des":"力的效果即时兑现为加速度，因果一式贯通。"},{"source":"超重与失重","target":"加速度","name":"判据","des":"加速度上下定向，视重随之增减。"},{"source":"向心加速度","target":"牛顿第二定律","name":"代入","des":"圆周方向套用 F=ma，向心力由此落地。"},{"source":"人造卫星","target":"圆周运动","name":"绕行于","des":"引力充当向心力，卫星沿轨道画圆。"},{"source":"万有引力定律","target":"向心加速度","name":"供给","des":"天体环绕所需的向心加速度由引力支付。"},{"source":"自由落体运动","target":"牛顿第二定律","name":"例证","des":"重力下的匀加速，F=ma 的天然实验。"},{"source":"功","target":"力","name":"定义自","des":"W=Flcosα，力沿位移的空间积累。"},{"source":"功率","target":"速度","name":"关联","des":"P=Fv，牵引力与速度的瞬时乘积。"},{"source":"重力","target":"重力势能","name":"搬运","des":"重力做正功势能减少，二者账目相通。"},{"source":"弹力","target":"弹性势能","name":"搬运","des":"弹力做功与弹性势能变化等量反向。"},{"source":"摩擦力","target":"摩擦生热","name":"催生","des":"相对滑动一段路程，内能便热一分。"},{"source":"牛顿第二定律","target":"动能定理","name":"推导出","des":"F=ma 沿位移积分，即得动能定理。"},{"source":"动量定理","target":"牛顿第二定律","name":"积分自","des":"F=ma 两侧同乘时间，冲量式应声而出。"},{"source":"动量守恒定律","target":"牛顿第三定律","name":"源于","des":"内力成对等大反向，系统总动量不动。"},{"source":"冲量","target":"力","name":"定义自","des":"I=Ft，力在时间上的积累效果。"},{"source":"火箭原理","target":"牛顿第三定律","name":"反哺","des":"向后喷气向前受力，作用反作用现场直播。"},{"source":"动量","target":"速度","name":"定义自","des":"p=mv，速度再乘上质量才是冲击力道。"},{"source":"动量","target":"动能","name":"互补于","des":"矢量对标量，时间积累对空间积累。"},{"source":"弹性碰撞","target":"动能","name":"保全","des":"碰撞前后动能分毫不损，双守恒齐飞。"},{"source":"完全非弹性碰撞","target":"动能","name":"损失","des":"碰后共速，动能损失最大而动量无恙。"},{"source":"动量定理","target":"动能定理","name":"对照","des":"一个积时间一个积空间，力学两把尺。"},{"source":"冲量","target":"功","name":"对照","des":"时间积累对空间积累，作用效果的两种账。"},{"source":"爆炸","target":"动能","name":"转化出","des":"化学能转作碎片动能，总能量依然守恒。"},{"source":"库仑定律","target":"万有引力定律","name":"类比于","des":"同为平方反比，形式惊人相似。"},{"source":"点电荷","target":"质点","name":"类比","des":"同为忽略形状大小的理想化抽象。"},{"source":"功","target":"电势能","name":"结算","des":"电场力做功 qU，等于电势能减少量。"},{"source":"电势能","target":"重力势能","name":"并列于","des":"同为位置储能，重力场电场同构。"},{"source":"带电粒子在电场中运动","target":"抛体运动","name":"类比","des":"恒力偏转如平抛，轨迹同为抛物线。"},{"source":"带电粒子在电场中运动","target":"牛顿第二定律","name":"求解于","des":"qE=ma，电学情境套力学方程。"},{"source":"电场","target":"磁场","name":"对偶于","des":"一有源一无源，一有头尾一闭合，互补成对。"},{"source":"电容器","target":"交变电流","name":"通交流","des":"反复充放电，交流看似穿隙而过。"},{"source":"麦克斯韦电磁理论","target":"电场","name":"统一","des":"变化的磁场也生电场，两种场结为一体。"},{"source":"带电粒子在磁场中运动","target":"带电粒子在电场中运动","name":"对照于","des":"一个沿场加速，一个绕场画圆。"},{"source":"带电粒子在磁场中运动","target":"圆周运动","name":"归于","des":"洛伦兹力专职向心力，粒子匀速画圆。"},{"source":"带电粒子在磁场中运动","target":"向心加速度","name":"借助","des":"qvB=mv²/r，向心加速度即时到账。"},{"source":"楞次定律","target":"能量守恒定律","name":"体现","des":"反抗做功换来电能，能量账目分毫不差。"},{"source":"电磁感应","target":"机械能","name":"转化","des":"发电机借感应把机械能变成电能。"},{"source":"变压器","target":"能量守恒定律","name":"遵循","des":"理想变压器输入输出功率相等。"},{"source":"洛伦兹力","target":"动能","name":"不做功","des":"力总垂直速度，对动能分文不动。"},{"source":"安培力","target":"力","name":"隶属于","des":"电磁世界的力，在力学家族中登记在册。"},{"source":"洛伦兹力","target":"力","name":"隶属于","des":"与安培力同宗，都是磁场施与的力。"},{"source":"磁感应强度","target":"电场强度","name":"类比","des":"都用比值定义，各述磁场电场的力的性质。"},{"source":"磁感线","target":"电场线","name":"对照","des":"一闭合无端，一起止于电荷，画风即场源。"},{"source":"牛顿第一定律","target":"牛顿第二定律","name":"特例于","des":"合外力为零时加速度为零，第二定律取零即回归第一定律。"}],"title":"物理力学与电磁","description":"牛顿力学到电磁感应的物理概念网络"}