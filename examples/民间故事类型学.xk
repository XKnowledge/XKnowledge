{"version":2,"title":"民间故事类型学","description":"给全世界的故事上户口：从阿尔奈的索引到普罗普的解剖刀，ATU 编号、母题流变与东亚类型学的完整谱系。","nodes":[{"name":"民间故事类型学","des":"让口耳相传的故事变得可以比较、编号与追踪的学问。","symbolSize":70,"category":"民间故事类型学"},{"name":"学科奠基者","des":"几个人用索引与解剖刀，把讲故事变成一门科学。","symbolSize":50,"category":"民间故事类型学"},{"name":"ATU 分类体系","des":"阿尔奈起步、汤普森扩编、乌特修订的世界故事总户口簿。","symbolSize":50,"category":"民间故事类型学"},{"name":"故事形态学","des":"普罗普对神奇故事的结构手术，功能的固定语法。","symbolSize":50,"category":"民间故事类型学"},{"name":"母题研究","des":"把故事拆成最小构件，再追踪构件的迁徙路线。","symbolSize":50,"category":"民间故事类型学"},{"name":"经典故事类型","des":"几个编号背后站着全人类的口传记忆。","symbolSize":50,"category":"民间故事类型学"},{"name":"流派与方法","des":"从芬兰学派到表演理论，研究故事的各种姿势。","symbolSize":50,"category":"民间故事类型学"},{"name":"中国与东亚类型学","des":"当 ATU 框架遇上东亚的故事大地，既对接又错位。","symbolSize":50,"category":"民间故事类型学"},{"name":"阿尔奈","des":"芬兰民俗学家，一九一〇年编出第一份故事类型索引，AT 之 A。","symbolSize":40,"category":"学科奠基者"},{"name":"斯蒂斯·汤普森","des":"美国民俗学家，两度扩充阿尔奈索引并另著母题索引，AT 之 T。","symbolSize":40,"category":"学科奠基者"},{"name":"汉斯-约尔格·乌特","des":"德国学者，二〇〇四年修订出 ATU 索引，类型学的新守夜人。","symbolSize":40,"category":"学科奠基者"},{"name":"弗拉基米尔·普罗普","des":"俄国民俗学家，从一百个神奇故事里抽出三十一项功能。","symbolSize":40,"category":"学科奠基者"},{"name":"阿克塞尔·奥尔里克","des":"丹麦民俗学家，归纳口传叙事的史诗法则，讲述的普遍规律。","symbolSize":40,"category":"学科奠基者"},{"name":"阿兰·邓迪斯","des":"美国民俗学家，把母题拆成母题素，推动民俗的释义研究。","symbolSize":40,"category":"学科奠基者"},{"name":"编号体系","des":"动物到程式的五段区划，给每个故事情节一个全球通行的门牌。","symbolSize":40,"category":"ATU 分类体系"},{"name":"动物故事 ATU 1-299","des":"野兽与人在故事里平起平坐，狐与狼的老戏台。","symbolSize":40,"category":"ATU 分类体系"},{"name":"神奇故事 ATU 300-749","des":"魔法助手与不可能任务，童话故事的主城区。","symbolSize":40,"category":"ATU 分类体系"},{"name":"宗教故事 ATU 750-849","des":"神的奖惩与因果报应，天堂地狱的通俗剧。","symbolSize":40,"category":"ATU 分类体系"},{"name":"传奇故事 ATU 850-999","des":"国王与公主的世俗奇闻，不含魔力的趣闻区。","symbolSize":40,"category":"ATU 分类体系"},{"name":"愚人故事 ATU 1200-1349","des":"笨人笨事的连环笑料，按民族与职业分档的笑话柜。","symbolSize":40,"category":"ATU 分类体系"},{"name":"程式故事 ATU 2000-2399","des":"连环套与圈套的纯形式游戏，最小情节的排列组合。","symbolSize":40,"category":"ATU 分类体系"},{"name":"《故事形态学》1928","des":"普罗普的解剖报告，故事研究从搜集走向结构的转折点。","symbolSize":40,"category":"故事形态学"},{"name":"三十一项功能","des":"离家禁令违禁加害搏斗胜利归来，功能的固定清单。","symbolSize":40,"category":"故事形态学"},{"name":"功能顺序不变律","des":"功能出现的先后次序始终如一，故事的深层层级。","symbolSize":40,"category":"故事形态学"},{"name":"七个角色圈","des":"反派供宝者助手公主派遣者英雄伪英雄，按功能划分的出场名单。","symbolSize":40,"category":"故事形态学"},{"name":"神奇故事","des":"普罗普给自己划定的解剖对象，以加害或缺失开端的魔法故事。","symbolSize":40,"category":"故事形态学"},{"name":"结构主义先声","des":"普罗普比列维-斯特劳斯早一步，给叙事研究装上结构透镜。","symbolSize":40,"category":"故事形态学"},{"name":"行动元模型","des":"格雷马斯把七个角色圈压缩成三对行动元，结构的再抽象。","symbolSize":40,"category":"故事形态学"},{"name":"汤普森母题索引","des":"六大卷字母编号的母题百科全书，从神话到诡计的零件库。","symbolSize":40,"category":"母题研究"},{"name":"母题与类型","des":"类型是完整情节，母题是可拆装的构件，两级编目的分工。","symbolSize":40,"category":"母题研究"},{"name":"母题素","des":"邓迪斯借音位学思路对母题的结构化改造，情节的最小单位。","symbolSize":40,"category":"母题研究"},{"name":"母题传播路径","des":"同一母题在地图上的分布与迁徙，故事旅行的脚印。","symbolSize":40,"category":"母题研究"},{"name":"变异与稳定件","des":"口头流传中骨架不变血肉常新，稳定件与浮动件的分工。","symbolSize":40,"category":"母题研究"},{"name":"灰姑娘 ATU 510A","des":"全球逾千异文的受虐孤女传奇，最早文本见于唐代《叶限》。","symbolSize":40,"category":"经典故事类型"},{"name":"小红帽 ATU 333","des":"佩罗的训诫版与格林的猎人选边，一个故事的两种童年观。","symbolSize":40,"category":"经典故事类型"},{"name":"蓝胡子 ATU 312","des":"禁室与好奇的妻子，民间故事最著名的婚姻警报。","symbolSize":40,"category":"经典故事类型"},{"name":"青蛙王子 ATU 440","des":"被承诺解除的变形，动物新郎的温和版本。","symbolSize":40,"category":"经典故事类型"},{"name":"睡美人 ATU 410","des":"百年沉睡与苏醒后的第二重历险，两幕结构的古老童话。","symbolSize":40,"category":"经典故事类型"},{"name":"白雪公主 ATU 709","des":"魔镜毒苹果与玻璃棺，母女竞争的千古戏码。","symbolSize":40,"category":"经典故事类型"},{"name":"糖果屋 ATU 327A","des":"被遗弃森林与饼干小屋，饥荒年代的生存寓言。","symbolSize":40,"category":"经典故事类型"},{"name":"穿靴子的猫 ATU 545B","des":"以诡计为少主赢下一切的猫助手，骗术的正当化。","symbolSize":40,"category":"经典故事类型"},{"name":"大拇指 ATU 700","des":"一寸小人的智慧闯关，以小胜大的经典母题。","symbolSize":40,"category":"经典故事类型"},{"name":"狼与七只小羊 ATU 123","des":"伪装者与识破术，动物版的敲门恐怖剧。","symbolSize":40,"category":"经典故事类型"},{"name":"三只小猪 ATU 124","des":"房子牢度竞赛，勤劳与侥幸的对赌。","symbolSize":40,"category":"经典故事类型"},{"name":"两兄弟 ATU 303","des":"双男主的长篇复合型，一个类型装下半部故事学。","symbolSize":40,"category":"经典故事类型"},{"name":"野天鹅 ATU 451","des":"沉默织荨麻衣救兄的妹妹，牺牲与解除魔法。","symbolSize":40,"category":"经典故事类型"},{"name":"蛇郎 ATU 433C","des":"蛇变男子与婚姻考验，中国大地上的兽夫故事。","symbolSize":40,"category":"经典故事类型"},{"name":"田螺姑娘 ATU 400C","des":"报恩的异类妻子，江南水田里的天降帮手。","symbolSize":40,"category":"经典故事类型"},{"name":"历史地理法","des":"芬兰学派的看家本领，从异文分布反推故事的原乡与迁徙。","symbolSize":40,"category":"流派与方法"},{"name":"单源论与多源论","des":"一次发明四处传播，还是多地各自发芽，故事起源的两大假设。","symbolSize":40,"category":"流派与方法"},{"name":"心理学派","des":"从荣格原型到贝特尔海姆，把故事读成心灵的成长剧本。","symbolSize":40,"category":"流派与方法"},{"name":"表演理论","des":"理查德·鲍曼带队，从文本转向情境，故事活在讲述现场。","symbolSize":40,"category":"流派与方法"},{"name":"口程式理论","des":"帕里与洛德在口头史诗里发现的程式创作，吟游诗人的语法。","symbolSize":40,"category":"流派与方法"},{"name":"故事地理学","des":"把类型编号铺上地图，空间分布里的文化信息。","symbolSize":40,"category":"流派与方法"},{"name":"数字人文路径","des":"类型数据库与网络分析，老索引的新算力。","symbolSize":40,"category":"流派与方法"},{"name":"艾伯华类型","des":"一九三七年德文版《中国民间故事类型》，为中国故事自立门户。","symbolSize":40,"category":"中国与东亚类型学"},{"name":"丁乃通索引","des":"一九七八年以 AT 框架整理中国故事，中西对接的桥梁工程。","symbolSize":40,"category":"中国与东亚类型学"},{"name":"钟敬文","des":"中国民俗学的奠基人，故事研究与学科建制的前辈。","symbolSize":40,"category":"中国与东亚类型学"},{"name":"刘守华","des":"《中国民间故事史》的作者，本土故事学的通史书写者。","symbolSize":40,"category":"中国与东亚类型学"},{"name":"中国民间文学三套集成","des":"八十年代起的全国普查，县县有卷的故事大库。","symbolSize":40,"category":"中国与东亚类型学"},{"name":"《叶限》","des":"唐代段成式《酉阳杂俎》所记，世界最早的灰姑娘文本。","symbolSize":40,"category":"中国与东亚类型学"},{"name":"日本昔话研究","des":"关敬吾《日本昔话通观》为代表，昔话与 ATU 的长期对读。","symbolSize":40,"category":"中国与东亚类型学"},{"name":"东亚类型的错位","des":"本土型在 ATU 框架里找不到座位，类型学的地方性难题。","symbolSize":40,"category":"中国与东亚类型学"}],"links":[{"source":"民间故事类型学","target":"学科奠基者","name":"立门","des":"几个人把讲故事变成学问。"},{"source":"民间故事类型学","target":"ATU 分类体系","name":"编目","des":"给全世界故事上户口。"},{"source":"民间故事类型学","target":"故事形态学","name":"解剖","des":"从情节到结构的深挖。"},{"source":"民间故事类型学","target":"母题研究","name":"拆件","des":"故事的最小零件库。"},{"source":"民间故事类型学","target":"经典故事类型","name":"样本","des":"编号背后的口传记忆。"},{"source":"民间故事类型学","target":"流派与方法","name":"分野","des":"研究故事的各种姿势。"},{"source":"民间故事类型学","target":"中国与东亚类型学","name":"在地","des":"框架与地方故事的对接。"},{"source":"学科奠基者","target":"阿尔奈","name":"首创","des":"第一份类型索引出自他手。"},{"source":"学科奠基者","target":"斯蒂斯·汤普森","name":"扩编","des":"两度扩充，AT 之 T。"},{"source":"学科奠基者","target":"汉斯-约尔格·乌特","name":"修订","des":"ATU 的新一代守夜人。"},{"source":"学科奠基者","target":"弗拉基米尔·普罗普","name":"另辟","des":"别人编目，他解剖。"},{"source":"学科奠基者","target":"阿克塞尔·奥尔里克","name":"立法","des":"口传叙事的史诗法则。"},{"source":"学科奠基者","target":"阿兰·邓迪斯","name":"释义","des":"把民俗当作活的交流来读。"},{"source":"阿尔奈","target":"ATU 分类体系","name":"奠基","des":"一九一〇年的第一块基石。"},{"source":"斯蒂斯·汤普森","target":"ATU 分类体系","name":"扩编","des":"把芬兰索引做成世界标准。"},{"source":"汉斯-约尔格·乌特","target":"ATU 分类体系","name":"新修","des":"二〇〇四年的全面修订版。"},{"source":"斯蒂斯·汤普森","target":"汤普森母题索引","name":"另著","des":"类型之外再编一套零件目录。"},{"source":"弗拉基米尔·普罗普","target":"故事形态学","name":"开创","des":"一本小书掀起结构革命。"},{"source":"阿兰·邓迪斯","target":"母题素","name":"改造","des":"借音位学刀法重切母题。"},{"source":"ATU 分类体系","target":"编号体系","name":"骨架","des":"五段区划的门牌系统。"},{"source":"ATU 分类体系","target":"动物故事 ATU 1-299","name":"一区","des":"狐与狼的老戏台。"},{"source":"ATU 分类体系","target":"神奇故事 ATU 300-749","name":"二区","des":"魔法与任务的主城区。"},{"source":"ATU 分类体系","target":"宗教故事 ATU 750-849","name":"三区","des":"因果报应的通俗剧。"},{"source":"ATU 分类体系","target":"传奇故事 ATU 850-999","name":"四区","des":"不带魔力的世俗奇闻。"},{"source":"ATU 分类体系","target":"愚人故事 ATU 1200-1349","name":"五区","des":"按职业分档的笑话柜。"},{"source":"ATU 分类体系","target":"程式故事 ATU 2000-2399","name":"六区","des":"连环套的形式游戏。"},{"source":"动物故事 ATU 1-299","target":"狼与七只小羊 ATU 123","name":"归档","des":"伪装与识破的动物剧。"},{"source":"动物故事 ATU 1-299","target":"三只小猪 ATU 124","name":"归档","des":"房子牢度的对赌。"},{"source":"神奇故事 ATU 300-749","target":"灰姑娘 ATU 510A","name":"归档","des":"主城区的头号住户。"},{"source":"神奇故事 ATU 300-749","target":"蓝胡子 ATU 312","name":"归档","des":"禁室传说的户口在此。"},{"source":"神奇故事 ATU 30