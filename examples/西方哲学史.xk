{
  "version": 2,
  "title": "西方哲学史",
  "description": "从古希腊到现代的人物师承、流派论战与核心概念网络",
  "nodes": [
    { "name": "泰勒斯", "des": "西方第一位哲学家：万物本原是水，哲学从此与神话分家。", "symbolSize": 50, "category": "古希腊哲学" },
    { "name": "毕达哥拉斯", "des": "万物皆数，宇宙是按比例和谐的乐器，还相信灵魂转世。", "symbolSize": 50, "category": "古希腊哲学" },
    { "name": "赫拉克利特", "des": "万物皆流，人不能两次踏进同一条河，火与逻各斯主宰世界。", "symbolSize": 50, "category": "古希腊哲学" },
    { "name": "巴门尼德", "des": "存在不生不灭不动，变化只是感官的幻觉，理性派的极端。", "symbolSize": 50, "category": "古希腊哲学" },
    { "name": "德谟克利特", "des": "万物由原子与虚空构成，古代最大胆也最超前的猜测之一。", "symbolSize": 50, "category": "古希腊哲学" },
    { "name": "苏格拉底", "des": "把哲学从天上拉回人间，专问什么是美德，自称精神的助产士。", "symbolSize": 65, "category": "古希腊哲学" },
    { "name": "柏拉图", "des": "创办学园四十载，说感官世界不过是完美理念投下的影子。", "symbolSize": 65, "category": "古希腊哲学" },
    { "name": "亚里士多德", "des": "百科全书式的学者，创立形式逻辑：吾爱吾师，吾更爱真理。", "symbolSize": 65, "category": "古希腊哲学" },
    { "name": "智者学派", "des": "收费授徒教辩术，宣称人是万物的尺度，掀起相对主义风潮。", "symbolSize": 40, "category": "古希腊哲学" },
    { "name": "理念论", "des": "真正的实在是永恒完美的理念，眼前万物只是摹本与影子。", "symbolSize": 55, "category": "古希腊哲学" },
    { "name": "四因说", "des": "以质料、形式、动力、目的四种原因解释事物为何如此。", "symbolSize": 45, "category": "古希腊哲学" },
    { "name": "助产术", "des": "不给答案只靠层层追问，让对方自己把真理生出来。", "symbolSize": 40, "category": "古希腊哲学" },
    { "name": "原子论", "des": "世界等于原子加虚空，一切变化只是微粒的聚散离合。", "symbolSize": 45, "category": "古希腊哲学" },
    { "name": "奥古斯丁", "des": "把柏拉图主义嫁接进基督教，《忏悔录》开内省哲学先河。", "symbolSize": 55, "category": "中世纪与理性主义" },
    { "name": "阿奎那", "des": "用亚里士多德重建神学，主张信仰与理性最终并不冲突。", "symbolSize": 55, "category": "中世纪与理性主义" },
    { "name": "经院哲学", "des": "修道院里的哲学，用逻辑为信仰辩护，精细到争论针尖上的天使。", "symbolSize": 45, "category": "中世纪与理性主义" },
    { "name": "五路证明", "des": "从运动、因果、偶然、等级与秩序推论上帝存在的五条路。", "symbolSize": 40, "category": "中世纪与理性主义" },
    { "name": "本体论证明", "des": "安瑟尔谟的奇思：最完美者不能缺少存在，故其必然存在。", "symbolSize": 40, "category": "中世纪与理性主义" },
    { "name": "笛卡尔", "des": "近代哲学之父：普遍怀疑一切之后，发现疑不掉的只有我在怀疑。", "symbolSize": 65, "category": "中世纪与理性主义" },
    { "name": "我思故我在", "des": "怀疑本身无可怀疑，思维的存在成了全部知识的第一块基石。", "symbolSize": 55, "category": "中世纪与理性主义" },
    { "name": "心身二元论", "des": "心灵是思维实体，身体是广延实体，二者如何互动成了世纪难题。", "symbolSize": 45, "category": "中世纪与理性主义" },
    { "name": "唯理论", "des": "知识的地基是天赋观念与理性演绎，像几何从公理推出世界。", "symbolSize": 45, "category": "中世纪与理性主义" },
    { "name": "斯宾诺莎", "des": "磨镜片为生的哲学家，用几何体例写《伦理学》，主张神即自然。", "symbolSize": 55, "category": "中世纪与理性主义" },
    { "name": "莱布尼茨", "des": "微积分与二进制的发明者之一，称我们活在一切可能世界中最好的。", "symbolSize": 55, "category": "中世纪与理性主义" },
    { "name": "单子论", "des": "宇宙由无数没有窗户的精神单子构成，靠前定和谐保持同步。", "symbolSize": 45, "category": "中世纪与理性主义" },
    { "name": "培根", "des": "喊出知识就是力量，主张用系统归纳代替空谈，经验主义先声。", "symbolSize": 55, "category": "经验主义与启蒙" },
    { "name": "霍布斯", "des": "《利维坦》作者：自然状态下人对人是狼，秩序靠契约建立。", "symbolSize": 50, "category": "经验主义与启蒙" },
    { "name": "洛克", "des": "《人类理解论》论白板心灵，同时是自由主义与分权学说之父。", "symbolSize": 55, "category": "经验主义与启蒙" },
    { "name": "白板说", "des": "心灵出生时是一张白纸，一切观念来自经验留下的字迹。", "symbolSize": 45, "category": "经验主义与启蒙" },
    { "name": "贝克莱", "des": "把经验论推到极致的爱尔兰主教：物不过是观念的集合。", "symbolSize": 50, "category": "经验主义与启蒙" },
    { "name": "存在即被感知", "des": "离开知觉谈物质只是抽象空话，被看见事物才谈得上存在。", "symbolSize": 45, "category": "经验主义与启蒙" },
    { "name": "休谟", "des": "把经验论问到底的怀疑者：因果、自我与归纳统统经不起追问。", "symbolSize": 60, "category": "经验主义与启蒙" },
    { "name": "印象与观念", "des": "知觉分两档：直接感受的印象，与印象褪色后的拷贝观念。", "symbolSize": 40, "category": "经验主义与启蒙" },
    { "name": "卢梭", "des": "人生而自由，却无往不在枷锁之中：契约、公意与回归自然。", "symbolSize": 55, "category": "经验主义与启蒙" },
    { "name": "伏尔泰", "des": "启蒙领袖与犀利笔杆，把洛克与牛顿的思想带回法国。", "symbolSize": 50, "category": "经验主义与启蒙" },
    { "name": "孟德斯鸠", "des": "《论法的精神》提出三权分立，自由属于权力受划分的国家。", "symbolSize": 45, "category": "经验主义与启蒙" },
    { "name": "归纳法", "des": "从大量个别观察概括普遍规律，培根梦想中的新工具。", "symbolSize": 45, "category": "经验主义与启蒙" },
    { "name": "社会契约论", "des": "国家源于人们的相约而非神授，现代政治的奠基性图纸。", "symbolSize": 50, "category": "经验主义与启蒙" },
    { "name": "康德", "des": "一生未出柯尼斯堡，却完成认识论的哥白尼式革命，汇通两大流派。", "symbolSize": 70, "category": "德国古典哲学" },
    { "name": "哥白尼式革命", "des": "不是认识符合对象，而是对象符合我们的先天认识形式。", "symbolSize": 50, "category": "德国古典哲学" },
    { "name": "先验范畴", "des": "因果、实体等概念并非来自经验，反而是经验可能的条件。", "symbolSize": 45, "category": "德国古典哲学" },
    { "name": "二律背反", "des": "理性越界即自相矛盾：世界既有限又无限，自由与必然并立。", "symbolSize": 45, "category": "德国古典哲学" },
    { "name": "物自体", "des": "刺激感官产生经验的那个东西本身，永远在认识边界之外。", "symbolSize": 45, "category": "德国古典哲学" },
    { "name": "费希特", "des": "把批判哲学推进为绝对自我的科学学：自我设定自身与非我。", "symbolSize": 50, "category": "德国古典哲学" },
    { "name": "谢林", "des": "自然哲学天才：自然是可见的精神，精神是不可见的自然。", "symbolSize": 50, "category": "德国古典哲学" },
    { "name": "黑格尔", "des": "辩证法集大成者：真理是全体，精神在历史中逐步认识自己。", "symbolSize": 65, "category": "德国古典哲学" },
    { "name": "绝对精神", "des": "世界即精神的自我展开，艺术、宗教、哲学是它自认识的三阶。", "symbolSize": 50, "category": "德国古典哲学" },
    { "name": "辩证法", "des": "在正反合的螺旋中前进，矛盾不是错误而是发展的动力。", "symbolSize": 55, "category": "德国古典哲学" },
    { "name": "叔本华", "des": "康德的继承者兼叛徒：世界的本质不是理性而是盲目的意志。", "symbolSize": 55, "category": "德国古典哲学" },
    { "name": "生存意志", "des": "欲求即匮乏，匮乏即痛苦，人生在痛苦与无聊之间摆荡。", "symbolSize": 45, "category": "德国古典哲学" },
    { "name": "克尔凯郭尔", "des": "存在主义之父：反对宏大体系，坚守那个个体的抉择与信仰。", "symbolSize": 55, "category": "现象学与存在主义" },
    { "name": "信仰之跃", "des": "理性走到悬崖为止，信仰纵身一跃，亚伯拉罕献子即是极致。", "symbolSize": 40, "category": "现象学与存在主义" },
    { "name": "尼采", "des": "宣告上帝已死，重估一切价值，吁人自我超越成为超人。", "symbolSize": 65, "category": "现象学与存在主义" },
    { "name": "权力意志", "des": "生命的第一冲动不是求生，而是求强：超越并塑造自身。", "symbolSize": 50, "category": "现象学与存在主义" },
    { "name": "永恒轮回", "des": "假如这一生无限重演且分毫不差，你还愿意再来一遍吗？", "symbolSize": 45, "category": "现象学与存在主义" },
    { "name": "胡塞尔", "des": "现象学创始人：回到事物本身，为一切科学寻找可靠起点。", "symbolSize": 60, "category": "现象学与存在主义" },
    { "name": "回到事物本身", "des": "悬置理论与成见，让事物如其所是地向意识自身显现。", "symbolSize": 45, "category": "现象学与存在主义" },
    { "name": "海德格尔", "des": "重提被遗忘的存在问题，剖析此在的沉沦、操心与向死而生。", "symbolSize": 65, "category": "现象学与存在主义" },
    { "name": "此在", "des": "对人的哲学命名：那个必须为自己如何存在拿主意的存在者。", "symbolSize": 45, "category": "现象学与存在主义" },
    { "name": "萨特", "des": "存在主义旗手：人被判定为自由，一切责任无处推卸。", "symbolSize": 60, "category": "现象学与存在主义" },
    { "name": "存在先于本质", "des": "人没有预定本性，先存在、先选择，然后才把自己造就出来。", "symbolSize": 50, "category": "现象学与存在主义" },
    { "name": "加缪", "des": "《局外人》与《西西弗神话》作者：必须想象西西弗是幸福的。", "symbolSize": 50, "category": "现象学与存在主义" },
    { "name": "荒诞", "des": "人渴求意义而世界沉默不语，这场永恒对峙就是荒诞。", "symbolSize": 45, "category": "现象学与存在主义" },
    { "name": "弗雷格", "des": "数理逻辑奠基人，发明量词与谓词演算，终生是耶拿的教授。", "symbolSize": 60, "category": "分析哲学与现代转向" },
    { "name": "罗素", "des": "逻辑学家与公共知识分子，一生奔走于数学基础与反战之间。", "symbolSize": 60, "category": "分析哲学与现代转向" },
    { "name": "罗素悖论", "des": "由一切不包含自身的集合组成的集合，包含自己吗？", "symbolSize": 40, "category": "分析哲学与现代转向" },
    { "name": "维特根斯坦", "des": "前后期各写一部经典，说前一本是梯子，爬上去就得扔掉。", "symbolSize": 65, "category": "分析哲学与现代转向" },
    { "name": "图像论", "des": "命题是事实的逻辑图像：凡可说的都能说清，其余应沉默。", "symbolSize": 45, "category": "分析哲学与现代转向" },
    { "name": "语言游戏", "des": "词语的意义在于用法，语言如下棋，规则扎根于生活形式。", "symbolSize": 50, "category": "分析哲学与现代转向" },
    { "name": "石里克", "des": "维也纳学派领袖，把哲学重定义为对科学语言的逻辑澄清。", "symbolSize": 45, "category": "分析哲学与现代转向" },
    { "name": "证实原则", "des": "一句话若有意义，就必须可能被经验证实，形而上学成废话。", "symbolSize": 45, "category": "分析哲学与现代转向" },
    { "name": "卡尔纳普", "des": "学圈里的工程师：以逻辑构造世界，主张物理语言统一科学。", "symbolSize": 50, "category": "分析哲学与现代转向" },
    { "name": "蒯因", "des": "《经验主义的两个教条》作者：知识作为整体面对经验法庭。", "symbolSize": 50, "category": "分析哲学与现代转向" },
    { "name": "语言转向", "des": "哲学问题其实是语言问题，分析语言即可消解千年老题。", "symbolSize": 50, "category": "分析哲学与现代转向" },
    { "name": "摹状词理论", "des": "把名字拆成限定摹状词分析，金山悖论之类的谜题应声而解。", "symbolSize": 45, "category": "分析哲学与现代转向" },
    { "name": "逻辑原子主义", "des": "世界由原子事实拼成，语言由原子命题拼成，两两对应。", "symbolSize": 40, "category": "分析哲学与现代转向" }
  ],
  "links": [
    { "source": "泰勒斯", "target": "赫拉克利特", "name": "影响", "des": "从水到火：万物的本原，从安静的东西换成了永燃的流变。" },
    { "source": "赫拉克利特", "target": "巴门尼德", "name": "论战", "des": "一切皆流，还是纹丝不动？两条路线贯穿整部希腊哲学史。" },
    { "source": "毕达哥拉斯", "target": "柏拉图", "name": "影响", "des": "数与和谐的神秘信念，悄悄写进了理念论的基因。" },
    { "source": "巴门尼德", "target": "柏拉图", "name": "影响", "des": "永恒不动的存在，被改造成永恒完美的理念。" },
    { "source": "德谟克利特", "target": "原子论", "name": "创立", "des": "不可再分的原子在虚空中聚散，生灭无需目的与神意。" },
    { "source": "苏格拉底", "target": "柏拉图", "name": "师承", "des": "老师饮下民主判决的毒酒，学生把他的诘问铸成体系。" },
    { "source": "柏拉图", "target": "亚里士多德", "name": "师承", "des": "学园里走出百科全书：吾爱吾师，吾更爱真理。" },
    { "source": "苏格拉底", "target": "助产术", "name": "创立", "des": "母亲是助产婆，他只负责提问，让对话者自己生出真理。" },
    { "source": "柏拉图", "target": "理念论", "name": "创立", "des": "洞穴里的囚徒只看见影子，哲学是转身走向洞口的太阳。" },
    { "source": "亚里士多德", "target": "四因说", "name": "提出", "des": "一座雕像为什么存在？质料、形式、动力、目的四因到场。" },
    { "source": "苏格拉底", "target": "智者学派", "name": "论战", "des": "收费教辩术的智慧贩子，遇上了自称牛虻的免费提问者。" },
    { "source": "亚里士多德", "target": "理念论", "name": "批判", "des": "形式离不开具体事物，老师把影子当成了独立实物。" },
    { "source": "柏拉图", "target": "奥古斯丁", "name": "影响", "des": "经由新柏拉图主义搭桥，理念世界搬进了基督教的天国。" },
    { "source": "亚里士多德", "target": "阿奎那", "name": "继承", "des": "失传的手稿经阿拉伯回流，亚氏哲学成了神学的新教科书。" },
    { "source": "莱布尼茨", "target": "亚里士多德", "name": "继承", "des": "两千年前的三段论，在他手里开始变成可以计算的推理。" },
    { "source": "尼采", "target": "苏格拉底", "name": "批判", "des": "理性等于乐观：尼采认定苏格拉底是希腊悲剧之死的元凶。" },
    { "source": "克尔凯郭尔", "target": "苏格拉底", "name": "继承", "des": "他自比哥本哈根的苏格拉底，用反讽把人逼回个体自身。" },
    { "source": "亚里士多德", "target": "康德", "name": "继承", "des": "范畴表的老家在亚里士多德，康德给它换了先验的地基。" },
    { "source": "赫拉克利特", "target": "辩证法", "name": "影响", "des": "黑格尔自认把赫拉克利特的流变命题尽数收进了逻辑学。" },
    { "source": "巴门尼德", "target": "黑格尔", "name": "影响", "des": "思维与存在的同一：黑格尔说真正的哲学始于巴门尼德。" },
    { "source": "柏拉图", "target": "黑格尔", "name": "影响", "des": "理念自我运动起来，就成了绝对精神：理念论的两千年回响。" },
    { "source": "弗雷格", "target": "亚里士多德", "name": "超越", "des": "三段论垄断逻辑两千年，谓词演算一举接管推理全域。" },
    { "source": "奥古斯丁", "target": "阿奎那", "name": "继承", "des": "柏拉图路线与亚里士多德路线，在基督教神学内部合流。" },
    { "source": "阿奎那", "target": "五路证明", "name": "创立", "des": "从运动、因果到秩序，五条小路都通往第一个推动者。" },
    { "source": "阿奎那", "target": "本体论证明", "name": "批判", "des": "上帝存在要从经验世界推证，不能光靠概念游戏。" },
    { "source": "笛卡尔", "target": "我思故我在", "name": "提出", "des": "普遍怀疑退到最后一块礁石：怀疑这件事本身疑不掉。" },
    { "source": "笛卡尔", "target": "心身二元论", "name": "创立", "des": "灵魂在松果腺里轻推身体，交互点成了后世笑谈。" },
    { "source": "笛卡尔", "target": "斯宾诺莎", "name": "影响", "des": "接过几何学方法，却把两个实体合并成了唯一的神即自然。" },
    { "source": "斯宾诺莎", "target": "心身二元论", "name": "批判", "des": "心灵与身体是同一实体的两面，根本无需跨界的交互。" },
    { "source": "莱布尼茨", "target": "笛卡尔", "name": "批判", "des": "广延守恒守不住运动的量，动量之外还得算上活力。" },
    { "source": "莱布尼茨", "target": "单子论", "name": "创立", "des": "单子没有窗户，全靠上帝预先调好了彼此的同步。" },
    { "source": "笛卡尔", "target": "唯理论", "name": "奠基", "des": "以清晰明白的观念为公理，像几何一样演绎整座大厦。" },
    { "source": "斯宾诺莎", "target": "唯理论", "name": "发展", "des": "《伦理学》通篇按几何方式展开：定义、公理、命题、证明。" },
    { "source": "莱布尼茨", "target": "唯理论", "name": "发展", "des": "推理即计算的构想，把唯理论的理想推到符号化门口。" },
    { "source": "奥古斯丁", "target": "笛卡尔", "name": "影响", "des": "我错故我在——这句老话在一千二百年后的我思中复活。" },
    { "source": "笛卡尔", "target": "本体论证明", "name": "运用", "des": "完满者若缺存在便不完满，笛卡尔重新捡起了安瑟尔谟。" },
    { "source": "阿奎那", "target": "经院哲学", "name": "集大成", "des": "信仰与理性的大综合做到极致，身后百年都在注解他。" },
    { "source": "笛卡尔", "target": "经院哲学", "name": "批判", "des": "清算教科书里的亚里士多德，哲学在怀疑的废墟上重建。" },
    { "source": "笛卡尔", "target": "洛克", "name": "论战", "des": "天赋观念遭到白纸论的正面迎击，论战绵延两百年。" },
    { "source": "唯理论", "target": "白板说", "name": "论战", "des": "观念天生，还是后天印上？近代认识论的总战场。" },
    { "source": "莱布尼茨", "target": "罗素", "name": "影响", "des": "把推理变成计算的梦两百年后兑现，罗素还为他著书立说。" },
    { "source": "康德", "target": "唯理论", "name": "综合", "des": "先天综合判断如何可能？独断论与怀疑论在此握手言和。" },
    { "source": "康德", "target": "本体论证明", "name": "批判", "des": "存在不是谓词：一百枚想象的金币不因存在而多一枚。" },
    { "source": "笛卡尔", "target": "康德", "name": "影响", "des": "问题从世界是什么，变成我如何认识世界：笛卡尔是推门人。" },
    { "source": "奥古斯丁", "target": "卢梭", "name": "影响", "des": "两本《忏悔录》相隔千年，向内解剖自己的目光一脉相承。" },
    { "source": "培根", "target": "归纳法", "name": "创立", "des": "蚂蚁只搬运，蜘蛛只吐丝，蜜蜂采花又酿蜜：经验要加工。" },
    { "source": "洛克", "target": "白板说", "name": "提出", "des": "心灵是一张白纸，一切字迹都由经验写上，无需天赋。" },
    { "source": "洛克", "target": "贝克莱", "name": "影响", "des": "顺洛克的思路走到底，物质实体成了可扔掉的假设。" },
    { "source": "贝克莱", "target": "存在即被感知", "name": "提出", "des": "物是观念的稳定集合，桌子存在，因为它被持续感知。" },
    { "source": "洛克", "target": "休谟", "name": "影响", "des": "经验论的接力棒传到苏格兰，一直冲到怀疑论的悬崖边。" },
    { "source": "休谟", "target": "印象与观念", "name": "提出", "des": "印象是原稿，观念是复印件：无印象的观念一律非法。" },
    { "source": "休谟", "target": "归纳法", "name": "批判", "des": "看过一万只白天鹅，也保证不了下一只：因果只是习惯。" },
    { "source": "霍布斯", "target": "社会契约论", "name": "奠基", "des": "为逃出狼对狼的自然状态，人们把权利交给利维坦。" },
    { "source": "洛克", "target": "社会契约论", "name": "发展", "des": "政府是契约的产物，背约即可被人民撤换。" },
    { "source": "卢梭", "target": "社会契约论", "name": "发展", "des": "公意高于众意，主权在民，且永远不可转让。" },
    { "source": "卢梭", "target": "伏尔泰", "name": "论战", "des": "卢梭寄来论不平等，伏尔泰回信：读罢令人想四肢着地。" },
    { "source": "洛克", "target": "孟德斯鸠", "name": "影响", "des": "分权的构想被改造成立法、行政、司法的三足鼎立。" },
    { "source": "洛克", "target": "伏尔泰", "name": "影响", "des": "《哲学书简》把洛克与牛顿带回法国，巴黎为之震动。" },
    { "source": "培根", "target": "霍布斯", "name": "影响", "des": "给培根当过秘书的霍布斯，把经验论引向彻底的唯物论。" },
    { "source": "休谟", "target": "卢梭", "name": "论战", "des": "休谟好心搭救落难友人，换来一纸绝交与满城风言。" },
    { "source": "休谟", "target": "康德", "name": "唤醒", "des": "是休谟把康德从独断论的迷梦中唤醒，批判哲学由此诞生。" },
    { "source": "卢梭", "target": "康德", "name": "影响", "des": "康德书房只挂一幅肖像：教他敬重每一个普通人的卢梭。" },
    { "source": "休谟", "target": "证实原则", "name": "影响", "des": "休谟之叉先挑明：观念关系与事实之外，尽可付之一炬。" },
    { "source": "康德", "target": "哥白尼式革命", "name": "提出", "des": "不是认识绕对象转，而是对象向我们的认识形式显现。" },
    { "source": "康德", "target": "二律背反", "name": "提出", "des": "理性一旦越界，正反双方都能自证：世界既有限又无限。" },
    { "source": "康德", "target": "物自体", "name": "设定", "des": "现象有边界，边界那头的它本身只可思而不可知。" },
    { "source": "康德", "target": "先验范畴", "name": "提出", "des": "因果与实体是经验的语法，没有它们直观只是杂多。" },
    { "source": "康德", "target": "费希特", "name": "影响", "des": "学生嫌二元论不彻底，把整个世界塞进绝对自我的设定。" },
    { "source": "费希特", "target": "谢林", "name": "影响", "des": "自我哲学让位于自然哲学：自然是可见的精神。" },
    { "source": "谢林", "target": "黑格尔", "name": "影响", "des": "图宾根同窗先后成名，又在《精神现象学》序言分道。" },
    { "source": "康德", "target": "黑格尔", "name": "继承", "des": "静态的先验框架，被改写成精神在历史中自我运动的剧本。" },
    { "source": "黑格尔", "target": "绝对精神", "name": "创立", "des": "逻辑、自然、精神三段展开，绝对在哲学里照见自己。" },
    { "source": "黑格尔", "target": "辩证法", "name": "集大成", "des": "矛盾不是待清除的错误，而是让思想前进的发动机。" },
    { "source": "康德", "target": "叔本华", "name": "影响", "des": "叔本华以康德嫡传自居，只把物自体换成了意志。" },
    { "source": "叔本华", "target": "黑格尔", "name": "论战", "des": "同一时段对台开课，听众全挤去了黑格尔那一边。" },
    { "source": "叔本华", "target": "生存意志", "name": "创立", "des": "世界的底牌不是理性，而是一团盲目求存的欲求。" },
    { "source": "叔本华", "target": "物自体", "name": "改造", "des": "物自体不可知？叔本华回答：它在，它就是意志。" },
    { "source": "二律背反", "target": "辩证法", "name": "启发", "des": "理性的自相矛盾，被黑格尔从病根改写成了动力。" },
    { "source": "叔本华", "target": "尼采", "name": "影响", "des": "旧书摊翻开作为意志和表象的世界，少年尼采一见倾心。" },
    { "source": "克尔凯郭尔", "target": "黑格尔", "name": "批判", "des": "体系解释了一切，唯独解释不了如何做一个活着的个体。" },
    { "source": "康德", "target": "胡塞尔", "name": "继承", "des": "先验问题在现象学中重启：意识如何合法地构造对象。" },
    { "source": "尼采", "target": "康德", "name": "批判", "des": "柯尼斯堡的中国人：尼采嫌其道德律背后藏着隐秘的怨恨。" },
    { "source": "海德格尔", "target": "黑格尔", "name": "对话", "des": "《存在与时间》绕不开黑格尔，否定性与时间性暗中角力。" },
    { "source": "罗素", "target": "黑格尔", "name": "批判", "des": "背叛新黑格尔主义的初恋，回到坚硬而个别的实在。" },
    { "source": "克尔凯郭尔", "target": "信仰之跃", "name": "提出", "des": "理性把人带到悬崖为止，信仰纵身一跃，悬在深不可测的海面上。" },
    { "source": "尼采", "target": "权力意志", "name": "提出", "des": "生命不只是求生存，更要求超越，把自己锻造得更强。" },
    { "source": "尼采", "target": "永恒轮回", "name": "提出", "des": "此生若一分不差地无限重演，你还愿意再来一遍吗？" },
    { "source": "胡塞尔", "target": "回到事物本身", "name": "提出", "des": "悬置一切理论成见，让事物如其所是地向意识显现。" },
    { "source": "胡塞尔", "target": "海德格尔", "name": "师承", "des": "得意门生接掌教席，却在《存在与时间》里另起炉灶。" },
    { "source": "海德格尔", "target": "此在", "name": "提出", "des": "人的存在是去存在：操心、沉沦，并向死而生。" },
    { "source": "海德格尔", "target": "萨特", "name": "影响", "des": "《存在与虚无》直接建在《存在与时间》的地基上。" },
    { "source": "萨特", "target": "存在先于本质", "name": "提出", "des": "人没有出厂设置，先存在、先选择，然后才被造就成什么。" },
    { "source": "萨特", "target": "加缪", "name": "论战", "des": "一九五二年关于反抗与革命的笔战，二十年友谊当场破裂。" },
    { "source": "加缪", "target": "荒诞", "name": "阐发", "des": "巨石注定滚落，西西弗仍把它推上山：必须想象他幸福。" },
    { "source": "克尔凯郭尔", "target": "萨特", "name": "影响", "des": "个体、抉择与焦虑，存在主义的火种由他提前点燃。" },
    { "source": "尼采", "target": "海德格尔", "name": "影响", "des": "两卷尼采讲稿，把他读作西方形而上学的完成者。" },
    { "source": "尼采", "target": "加缪", "name": "影响", "des": "直面虚无的诊断书传到加缪手里，治疗由荒诞接棒。" },
    { "source": "弗雷格", "target": "胡塞尔", "name": "影响", "des": "一篇批评心理主义的书评，促成了《逻辑研究》的转向。" },
    { "source": "卡尔纳普", "target": "海德格尔", "name": "批判", "des": "无如何无着？语法错觉制造出的伪陈述而已。" },
    { "source": "弗雷格", "target": "罗素", "name": "影响", "des": "概念文字被罗素奉为里程碑，两人书信切磋多年。" },
    { "source": "罗素", "target": "罗素悖论", "name": "发现", "des": "一封寄给弗雷格的信：集合论的大厦裂了地基。" },
    { "source": "罗素", "target": "维特根斯坦", "name": "师承", "des": "剑桥的天才门徒，罗素说遇见他是最幸运的智力奇遇。" },
    { "source": "弗雷格", "target": "维特根斯坦", "name": "影响", "des": "《逻辑哲学论》序言开列的致谢只有两个名字。" },
    { "source": "维特根斯坦", "target": "图像论", "name": "提出", "des": "命题是事实的逻辑图像，对不可说的应当沉默。" },
    { "source": "维特根斯坦", "target": "语言游戏", "name": "提出", "des": "放弃图像改讲棋局：词语的意义在于它的用法。" },
    { "source": "图像论", "target": "语言游戏", "name": "转折", "des": "前期的梯子被自己一脚踢开，哲学回到日常语言。" },
    { "source": "维特根斯坦", "target": "石里克", "name": "影响", "des": "学圈奉《逻辑哲学论》为圣经，石里克逐句研读。" },
    { "source": "石里克", "target": "卡尔纳普", "name": "领导", "des": "维也纳学派的常任主席与核心干将，双星并耀。" },
    { "source": "石里克", "target": "证实原则", "name": "捍卫", "des": "一个命题的意义，就是证实它的方法。" },
    { "source": "罗素", "target": "摹状词理论", "name": "提出", "des": "金山不存在却意有所指？拆开限定摹状词，谜题蒸发。" },
    { "source": "罗素", "target": "逻辑原子主义", "name": "创立", "des": "世界由原子事实拼装，语言与事实逐点对应。" },
    { "source": "逻辑原子主义", "target": "图像论", "name": "呼应", "des": "同一理想的两个版本：事实与命题一一配对成图。" },
    { "source": "弗雷格", "target": "语言转向", "name": "奠基", "des": "追问思想的真，先得追问句子的真：哲学换上逻辑的工具箱。" },
    { "source": "卡尔纳普", "target": "蒯因", "name": "师承", "des": "哈佛讲席上的旁听生，学成后却拆掉了老师的两大教条。" },
    { "source": "蒯因", "target": "证实原则", "name": "批判", "des": "两个教条一文釜底抽薪，还原论应声倒地。" },
    { "source": "维特根斯坦", "target": "卡尔纳普", "name": "影响", "des": "《逻辑哲学论》成了学圈的共识纲领，卡尔纳普深受洗礼。" },
    { "source": "德谟克利特", "target": "巴门尼德", "name": "回应", "des": "为保住万物流变，他引入不存在的虚空，绕开存在不动的困局。" },
    { "source": "亚里士多德", "target": "原子论", "name": "批判", "des": "逐条批驳原子与虚空，详尽的转述反而让学说流传后世。" }
  ]
