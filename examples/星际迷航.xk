{
  "version": 2,
  "title": "星际迷航",
  "description": "「宇宙，最后的边疆」：从 2063 年的第一次接触到 32 世纪的联邦，瓦肯逻辑、克林贡荣誉与博格同化共同织成的星际关系网。",
  "nodes": [
    { "name": "星际迷航", "des": "1966 年开播的乌托邦太空歌剧：人类走出核战废墟，以好奇心代替敌意探索银河，半个多世纪里长成一代人的科技预言与道德实验室。", "symbolSize": 70, "category": "银河全景" },
    { "name": "星际联邦", "des": "行星联合体 UFP，一百五十个成员世界共享的和平同盟：没有货币、没有匮乏，凭宪章与探索精神运转的星际乌托邦。", "symbolSize": 50, "category": "联邦与星际舰队" },
    { "name": "星际舰队", "des": "联邦的探索与防卫力量，旗舰永远姓企业：一半是海军，一半是科学院，偶尔还要客串外交使团。", "symbolSize": 50, "category": "联邦与星际舰队" },
    { "name": "星舰学院", "des": "星际舰队军官的摇篮，旧金山总部的那句「Ex Astris, Scientia」——从星辰中来，知识。", "symbolSize": 40, "category": "联邦与星际舰队" },
    { "name": "最高指导原则", "des": "联邦的第一铁律：不得干预尚未实现曲速飞行的原生文明，一条理想主义者亲手写的、每季都要痛苦执行一次的戒律。", "symbolSize": 40, "category": "联邦与星际舰队" },
    { "name": "31区", "des": "宪章之外的黑手套，自称保卫联邦的影子机构：乌托邦的地下管道，光鲜原则的黑色注脚。", "symbolSize": 40, "category": "联邦与星际舰队" },
    { "name": "阿尔及隆条约", "des": "与罗慕伦划定的中立区条约，一纸停战换来百年冷和平，越界即战争。", "symbolSize": 40, "category": "联邦与星际舰队" },
    { "name": "基托玛协议", "des": "普拉西斯灾变后联邦与克林贡的历史性和约，把百年宿敌变成了并肩作战的盟友。", "symbolSize": 40, "category": "联邦与星际舰队" },
    { "name": "企业号NX-01", "des": "人类第一艘曲速五级星舰，2151 年启航，在瓦肯人的不放心中替联邦蹚出了所有第一脚。", "symbolSize": 40, "category": "舰船谱系" },
    { "name": "企业号NCC-1701", "des": "宪法级星舰，科克与斯波克的传奇座舰，船体改了三次，编号与精神一脉未断。", "symbolSize": 50, "category": "舰船谱系" },
    { "name": "企业号A", "des": "科克解职后再获的新船，老班组的第二站，改装未半就急着去救同伴了。", "symbolSize": 40, "category": "舰船谱系" },
    { "name": "企业号D", "des": "银河级旗舰，带着一千多船员与家眷巡航，舰体分离是它的绝技，全息甲板是它的灵魂。", "symbolSize": 50, "category": "舰船谱系" },
    { "name": "企业号E", "des": "主权级战舰，皮卡德的中后期座驾，在001星区之战里顶着博格立方体杀出一条时间线。", "symbolSize": 40, "category": "舰船谱系" },
    { "name": "航海家号", "des": "被守护者阵列抛到七万光年外的无畏级星舰，珍妮薇的「长途」：预计七十五年的回家路。", "symbolSize": 50, "category": "舰船谱系" },
    { "name": "深空九号", "des": "卡达西人废弃的采矿站，联邦接管后成为虫洞口的十字路口，银河政治的风暴眼。", "symbolSize": 40, "category": "舰船谱系" },
    { "name": "发现号", "des": "以孢子位移引擎跨界的试验舰，从战争工具跳到三十一世纪，一路都在问「我是谁」。", "symbolSize": 40, "category": "舰船谱系" },
    { "name": "挑战号", "des": "DS9 的专属战舰，一艘「纯为战斗而生」的纤小型炮舰，自治领战争的首席王牌。", "symbolSize": 40, "category": "舰船谱系" },
    { "name": "人类", "des": "走出第三次世界大战的年轻种族，靠一枚火箭与一手好牌加入星海，成了联邦的黏合剂。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "瓦肯人", "des": "苏瑞克改革后的逻辑民族，绿血、尖耳、七年级的婚姻，用压抑情感换来了高于情感的文明。", "symbolSize": 50, "category": "种族与宿敌" },
    { "name": "罗慕伦人", "des": "拒绝逻辑之路、出走星海的瓦肯分离派，隐形战鸟与阴谋诡计的罗马帝国翻版。", "symbolSize": 50, "category": "种族与宿敌" },
    { "name": "克林贡人", "des": "卡拉斯统一前的武士民族，荣誉即货币，死亡即入职，从联邦死敌打成生死盟友只用了一代人的时间。", "symbolSize": 50, "category": "种族与宿敌" },
    { "name": "安多利人", "des": "蓝皮触角的战斗民族，「安多利人的荣誉」，联邦四位创始成员里最好斗的一位。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "泰拉人", "des": "猪鼻的固执商谈高手，四位创始成员之一，谈判桌上从不让步，也从不撒谎。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "佛瑞吉人", "des": "大耳朵的贸易民族，获取规则二百八十五条，利润即信仰，女性曾连穿衣的资格都要争取。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "卡达西人", "des": "军国主义的文艺复兴民族，占领贝久五十年的压迫者，也是自治领战争里最后反噬的那张牌。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "贝久人", "des": "虔诚的幸存者民族，五十年的抵抗运动换来自由，耳朵上戴着宗教的耳环。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "贝久虫洞", "des": "通往伽马象限的稳定虫洞，贝久人眼中的「天上神殿」，银河政治与商业的咽喉要道。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "先知", "des": "栖居于虫洞的非线性存在，时间对它们是同时的，贝久信仰的神，也是西斯科命运的执笔人。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "特里尔人", "des": "与共生体结合的种族，一代代宿主继承同一段记忆，一个人既是自己也是九代人。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "博格", "des": "集体意识的半机械蜂巢，「抵抗是徒劳的」——它们不征服，只同化，整个银河的噩梦。", "symbolSize": 50, "category": "种族与宿敌" },
    { "name": "博格女王", "des": "蜂巢的集中表达，集权与诱惑的具象，对数据与皮卡德都怀有不该有的兴趣。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "Q连续体", "des": "全能的顽神维度，把整个银河当作沙盘，人类是他们养在培养皿里的重点观察对象。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "变形人创始者", "des": "被固体伤害过千次的液态种族，建立自治领以秩序自保，「凡是固体皆是威胁」。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "詹哈达", "des": "创始者基因改造出的战斗种族，出生即成军，视白素为口粮、战死为荣耀，忠诚写在基因里。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "可汗·努尼恩·辛格", "des": "优生战争的遗腹子，最完美也最骄傲的强化人，被流放十五年后带着「地狱之门」回来了。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "古尔·杜卡特", "des": "贝久占领期最后的长官，卡达西的「开明暴君」，野心、魅力与疯狂在他身上等比例生长。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "苏瑞克", "des": "两千年前引导瓦肯人放下情绪的哲学王，山洞里的钟声至今仍在逻辑之路上回响。", "symbolSize": 40, "category": "种族与宿敌" },
    { "name": "Q", "des": "连续体派来的第一位「朋友」，弹指间移动星系，对人类既审判又着迷，最好的反派与最坏的老师。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "乔纳森·阿彻", "des": "企业号NX-01 的首任舰长，人类的第一代深空舰长，所有外交事故与突破都始于他的螺旋桨式直觉。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "特波尔", "des": "首位长期服役于人类星舰的瓦肯人，NX-01 的科学与理智担当，芝麻油配薄饼的隐藏爱好者。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "科克", "des": "詹姆斯·T·科克，星际舰队史上最年轻的舰长，靠直觉打破计算机算不出的僵局，也打破了不少最高指导原则。", "symbolSize": 60, "category": "历代主角团" },
    { "name": "斯波克", "des": "半瓦肯半人类的大副，逻辑与情感一生拔河，「繁荣昌盛」的手势成了整个亚文化的接头暗号。", "symbolSize": 60, "category": "历代主角团" },
    { "name": "麦考伊", "des": "「我是个医生，不是个……」——嘴上骂斯波克铁皮脑袋，手术刀永远先为朋友落下。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "乌胡拉", "des": "通讯官尼尤塔·乌胡拉，主舱室里的第四把椅子，电视史上第一次跨种族之吻的一半。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "斯科提", "des": "轮机长蒙哥马利·斯科提，「给我一小时」总能用二十分钟变出奇迹的奇迹工程师。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "苏鲁", "des": "舵手光武·苏鲁，冷静的剑术爱好者，掌着企业号每一次迫降与甩尾。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "切科夫", "des": "最年轻的领航员，把苏格兰口音的荣誉感错装在了俄国口音里，永远争先。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "克里斯托弗·派克", "des": "企业号的前任舰长，斯波克两代人的上级，为救学员重伤后与塔拉萨号同化于维格。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "皮卡德", "des": "让-吕克·皮卡德，考古出身的外交家舰长，莎士比亚与格雷伯爵茶，把「让它如此」说成银河通行证。", "symbolSize": 60, "category": "历代主角团" },
    { "name": "威廉·赖克", "des": "企业号D 的大副，爵士长号与进攻性登舰战术，拒绝自己的舰长职务拒绝了七年。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "数据", "des": "正电子脑仿生人，全舰最强的脑子在学最简单的事：口哨、打喷嚏、理解幽默，人性是他一生的课题。", "symbolSize": 50, "category": "历代主角团" },
    { "name": "沃尔夫", "des": "首位毕业于星舰学院的克林贡军官，企业号D 与 DS9 的双料安全官，荣誉的活教材。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "迪安娜·特洛伊", "des": "半贝塔赞的共情顾问，感受得到舰桥上每一丝情绪，「我感觉到……敌意，舰长」。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "乔迪·拉福吉", "des": "戴着 VISR 目镜的盲人轮机长，看见的世界比别人亮，修好的机器比坏掉的多。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "珍妮薇", "des": "凯瑟琳·珍妮薇，航海家号舰长，七万光年外的联邦原则代言人，咖啡，黑的，一往无前。", "symbolSize": 50, "category": "历代主角团" },
    { "name": "全息医生", "des": "紧急医疗全息程序 EMH-1，被长期超期使用成了首席船医，「请把紧急全息程序关掉」是他的自由宣言。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "九之七", "des": "博格编号「三之九的第三附属」——被同化二十年的地球女孩，航海家号上重新学做人的前博格。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "西斯科", "des": "DS9 站长本杰明·西斯科，沃尔夫359 的鳏夫、贝久人的「使者」、自治领战争的统帅，最像凡人的神选之人。", "symbolSize": 50, "category": "历代主角团" },
    { "name": "基拉·内瑞斯", "des": "贝久抵抗军出身的副站长，占领岁月磨出的锋利与忠诚，从恨卡达西人学到与之并肩。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "奥多", "des": "站上的安全官，被遗弃的变形人幼体，秩序的信徒，最终发现自己的同胞是战争另一方的主宰。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "夸克", "des": "DS9 的佛瑞吉酒保，规则漏洞的活字典，唯利是图却一次次在关键时刻站对了边。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "达克斯", "des": "特里尔共生体与历代宿主的合称，三百岁的记忆装在年轻躯壳里，DS9 的科学与酒量担当。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "迈克尔·伯纳姆", "des": "被瓦肯人收养的人类女孩，斯波克的义姐，发现号的主角，一场兵变开启了整条时间线的分流。", "symbolSize": 40, "category": "历代主角团" },
    { "name": "曲速引擎", "des": "以正反物质湮灭扭曲时空的推进系统，分级以曲速墙为界——超不用一年，跨过就是另一个物理学。", "symbolSize": 50, "category": "科技设定" },
    { "name": "传送器", "des": "把人拆成信息再原样拼回的奇迹，配「海森堡补偿器」使用，麦考伊医生一生拒绝配合。", "symbolSize": 40, "category": "科技设定" },
    { "name": "复制机", "des": "物质重组的产物，从衬衣到牛排无所不造，联邦「后稀缺」的物质基础，珍妮薇的咖啡供应商。", "symbolSize": 40, "category": "科技设定" },
    { "name": "全息甲板", "des": "光子与力场编织的虚拟世界，长周末的头号去处，也是十几次舰员失踪案的案发地。", "symbolSize": 40, "category": "科技设定" },
    { "name": "三录仪", "des": "手持的科学万用仪，扫描一切、分析一切、在关键十秒给出剧情需要的读数。", "symbolSize": 40, "category": "科技设定" },
    { "name": "相位枪", "des": "舰队的制式武器，从击晕到汽化一档不多，安全锁定保护的是持枪者的人性。", "symbolSize": 40, "category": "科技设定" },
    { "name": "护盾", "des": "偏导力场的军用形态，开战前第一句永远是「护盾开到最大」。", "symbolSize": 40, "category": "科技设定" },
    { "name": "通用翻译器", "des": "实时破解一切语言的装置，第一次接触时的破冰锤，偶尔也会翻出一场外交事故。", "symbolSize": 40, "category": "科技设定" },
    { "name": "心灵融合", "des": "瓦肯人的意识对接术，指尖抵上对方的脸，思想便不再有墙——斯波克的标志性绝技。", "symbolSize": 40, "category": "科技设定" },
    { "name": "第三次世界大战", "des": "二十一世纪中叶的自毁高峰，六亿人死于核火，文明退到废墟，也退到了转折点前夜。", "symbolSize": 40, "category": "时间线与冲突" },
    { "name": "泽弗拉姆·柯克伦", "des": "废墟里的醉汉工程师，修出了人类第一艘曲速船，动机只是「钱、酒和安静的岛」却改写了历史。", "symbolSize": 40, "category": "时间线与冲突" },
    { "name": "第一次接触", "des": "2063 年 4 月 5 日，凤凰号的曲速尾迹引来瓦肯探测船，人类第一次听见「Live long and prosper」。", "symbolSize": 40, "category": "时间线与冲突" },
    { "name": "罗慕伦战争", "des": "2161 年前的地球-罗慕伦战争，打到最后双方连一面都没见过，战后联邦在废墟上签字成立。", "symbolSize": 40, "category": "时间线与冲突" },
    { "name": "基托玛会议", "des": "2293 年普拉西斯灾变后的和会，克林贡与联邦化敌为友，「没有人能预见历史的走向」。", "symbolSize": 40, "category": "时间线与冲突" },
    { "name": "沃尔夫359战役", "des": "博格立方体碾过联邦舰队的一夜，三十九舰三十九舰地损失，西斯科的妻子长眠于此。", "symbolSize": 40, "category": "时间线与冲突" },
    { "name": "001星区之战", "des": "博格二次入侵地球的决战，企业号E 违令参战，并顺着敌人的时间漩涡追回了 2063 年。", "symbolSize": 40, "category": "时间线与冲突" },
    { "name": "自治领战争", "des": "伽马象限的自治领穿过虫洞发动的银河大战，联邦-克林贡-罗慕伦第一次同壕，卡达西最后反水。", "symbolSize": 40, "category": "时间线与冲突" },
    { "name": "吉恩·罗登贝瑞", "des": "泛美航空坠机的幸存警察改行的编剧，用一部「马车夫西部片换太空皮」的剧集，给了电视一个更好的未来。", "symbolSize": 50, "category": "作品系列" },
    { "name": "《原初系列》", "des": "1966-1969 的原点：三年航程、七十九集、一次被砍与一场写信救剧的粉丝运动，后世一切的下集预告。", "symbolSize": 40, "category": "作品系列" },
    { "name": "电影系列", "des": "从 1979 年的「慢速移动一号」到与可汗的怒吼、与神的对话、与和平的握手，老班组的六次银幕远征。", "symbolSize": 40, "category": "作品系列" },
    { "name": "《下一代》", "des": "1987 年的再生之作，皮卡德的 Diplomacy 与数据的求知欲，把冷战的预感演成了冷战结束后的和解。", "symbolSize": 40, "category": "作品系列" },
    { "name": "《深空九号》", "des": "1993 年的空间站剧集，最不像星际迷航的星际迷航：战争、宗教、占领与占领后遗症，系列最深的暗面。", "symbolSize": 40, "category": "作品系列" },
    { "name": "《航海家号》", "des": "1995 年的归途剧：一艘船、两个船员群体、七万光年，把联邦原则放到了无人监督的极端测试场。", "symbolSize": 40, "category": "作品系列" },
    { "name": "《进取号》", "des": "2001 年的前传剧集，曲速五级的处女航时代，人类如何在瓦肯的注视下学会长大。", "symbolSize": 40, "category": "作品系列" },
    { "name": "《发现号》", "des": "2017 年开启的流媒体时代剧集，从战争阴云跳到三十二世纪，一路在争议中重新校准系列的坐标。", "symbolSize": 40, "category": "作品系列" },
    { "name": "《皮卡德》", "des": "2020 年的晚年剧，退休上将的最后一场仗：罗慕伦救难、合成人权利与博格的最终和解。", "symbolSize": 40, "category": "作品系列" },
    { "name": "《奇异新世界》", "des": "2022 年的返本归真之作，派克时代的企业号，一集一个星球的老式探索故事。", "symbolSize": 40, "category": "作品系列" },
    { "name": "星际迷航的文化影响", "des": "从翻盖手机到平板电脑的预言史，第一艘航天飞机以企业号命名，极客的语言与理想主义的上限。", "symbolSize": 40, "category": "作品系列" }
