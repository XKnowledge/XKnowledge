{
  "version": 2,
  "nodes": [
    { "name": "留里克", "des": "862年受邀入主诺夫哥罗德的瓦良格王公，留里克王朝与罗斯国家的传说起点。", "symbolSize": 40, "category": "罗斯与蒙古" },
    { "name": "基辅罗斯", "des": "九至十三世纪以东欧平原为体的东斯拉夫国家，联姻欧洲王室的水上强国。", "symbolSize": 50, "category": "罗斯与蒙古" },
    { "name": "雅罗斯拉夫", "des": "基辅罗斯盛期大公，编《罗斯法典》、建圣索菲亚，诸女远嫁欧洲王室。", "symbolSize": 40, "category": "罗斯与蒙古" },
    { "name": "弗拉基米尔受洗", "des": "988年大公率基辅民众入第聂伯河受洗，拜占庭信仰定为国教。", "symbolSize": 50, "category": "罗斯与蒙古" },
    { "name": "东正教", "des": "拜占庭一系的正教信仰，圣像与圣礼的精神世界，俄罗斯国家的黏合剂。", "symbolSize": 50, "category": "罗斯与蒙古" },
    { "name": "金帐汗国", "des": "拔都后王统治罗斯诸公国两个多世纪的蒙古政权，贡赋与册封的笼头。", "symbolSize": 40, "category": "罗斯与蒙古" },
    { "name": "亚历山大·涅夫斯基", "des": "涅瓦河与楚德湖冰面两败强敌的大公，屈贡蒙古以保罗斯的务实圣王。", "symbolSize": 40, "category": "罗斯与蒙古" },
    { "name": "诺夫哥罗德", "des": "北方的商业共和城邦，市民会议可聘可罢王公，1478年方并入莫斯科。", "symbolSize": 40, "category": "罗斯与蒙古" },
    { "name": "莫斯科公国", "des": "莫斯科河畔的小邦以替汗收贡起家，四百年间兼并罗斯、长成帝国。", "symbolSize": 50, "category": "罗斯与蒙古" },
    { "name": "伊凡三世", "des": "迎娶拜占庭公主、双头鹰为徽，1480年乌格拉河迫退蒙古的大帝。", "symbolSize": 50, "category": "罗斯与蒙古" },
    { "name": "第三罗马", "des": "君士坦丁堡陷落后的自我加冕：罗马-新罗马-莫斯科的正统谱系。", "symbolSize": 40, "category": "罗斯与蒙古" },
    { "name": "伊凡四世", "des": "雷帝，首位加冕沙皇，灭喀山汗国，晚年特辖制的恐怖统治。", "symbolSize": 50, "category": "沙皇俄国" },
    { "name": "沙皇", "des": "源自凯撒的君主尊号，1547至1721年俄国君主的正式称谓。", "symbolSize": 50, "category": "沙皇俄国" },
    { "name": "特辖制", "des": "雷帝划特辖区、建特辖军诛戮贵族，红色恐怖的先行者。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "空位时期", "des": "1598至1613年的王朝断绝与大饥荒、外患与僭王迭起的乱世。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "罗曼诺夫王朝", "des": "1613至1917年三百年王朝，从米哈伊尔到尼古拉二世的帝国全史。", "symbolSize": 60, "category": "沙皇俄国" },
    { "name": "教会分裂", "des": "尼康礼法改革引发的旧礼仪派裂教，改礼之争撕裂信仰共同体。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "彼得大帝", "des": "游学西欧、剪须改历、迁都建港的改造者，把俄国拖入近代的皇帝。", "symbolSize": 60, "category": "沙皇俄国" },
    { "name": "大北方战争", "des": "1700至1721年对瑞典二十一年战争，波尔塔瓦一役定霸波罗的海。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "圣彼得堡", "des": "1703年彼得在涅瓦河口沼泽营建的帝都，面向欧洲的窗口。", "symbolSize": 50, "category": "沙皇俄国" },
    { "name": "叶卡捷琳娜二世", "des": "德意志出身的开明女皇，瓜分波兰、南拓黑海，书信与情人一样多。", "symbolSize": 50, "category": "沙皇俄国" },
    { "name": "瓜分波兰", "des": "1772、1793、1795年三度与普奥分食波兰立陶宛，东欧地图重画。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "哥萨克东进", "des": "叶尔马克翻乌拉尔以来，哥萨克与皮毛商两个世纪直抵太平洋。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "普加乔夫起义", "des": "1773至1775年假称彼得三世的顿河哥萨克大起义，农奴战争的最后怒潮。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "1812年卫国战争", "des": "拿破仑六十万大军入俄，焦土与严冬之后是攻入巴黎的哥萨克。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "十二月党人", "des": "1825年枢密院广场兵谏的贵族军官，俄宪政理想的第一滴血。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "克里米亚战争", "des": "1853至1856年对英法土的败仗，塞瓦斯托波尔的围城戳破帝国神话。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "亚历山大二世", "des": "解放者沙皇，废除农奴制、推行地方自治，终死于民意党炸弹。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "农奴解放", "des": "1861年二一九法令，两千三百万农奴获自由而赎买缠身。", "symbolSize": 50, "category": "沙皇俄国" },
    { "name": "日俄战争", "des": "1904至1905年远东的惨败，对马海峡的覆灭震动朝野。", "symbolSize": 40, "category": "沙皇俄国" },
    { "name": "血腥星期日", "des": "1905年1月冬宫广场请愿群众遭枪击，沙皇小父亲的神话一朝崩塌。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "1905年革命", "des": "罢工、兵变与苏维埃的总爆发，十月诏书与六三体制的拉锯。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "苏维埃", "des": "工人士兵代表会议，1905年初现、1917年成型的权力胚胎。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "斯托雷平改革", "des": "首相斯托雷平的土地改革与六三体制，被大战腰斩的稳定尝试。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "第一次世界大战", "des": "1914年的参战令帝国透支，前线溃败与后方饥荒互相加速。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "二月革命", "des": "1917年3月彼得堡的面包骚动推翻三百年王朝。", "symbolSize": 50, "category": "革命与内战" },
    { "name": "临时政府", "des": "二月之后的自由派政府，战争与土地两大悬案上步步失分。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "列宁", "des": "流亡归来的革命工程师，建党、夺权与新经济政策的灵活铁腕。", "symbolSize": 60, "category": "革命与内战" },
    { "name": "四月提纲", "des": "《论无产阶级在这次革命中的任务》，全部政权归苏维埃的宣言。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "十月革命", "des": "1917年11月7日阿芙乐尔号炮响，布尔什维克一夜夺权。", "symbolSize": 60, "category": "革命与内战" },
    { "name": "布尔什维克", "des": "多数派之名、先锋队之实，职业革命家组织的夺权机器。", "symbolSize": 50, "category": "革命与内战" },
    { "name": "契卡", "des": "捷尔任斯基掌管的肃反委员会，红色恐怖的机关与克格勃的远祖。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "托洛茨基", "des": "十月起义的总指挥、红军缔造者，晚年被逐而殒命墨西哥。", "symbolSize": 50, "category": "革命与内战" },
    { "name": "红军", "des": "从赤卫队到五百万大军的内战胜利者，工人农民的革命武装。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "白军", "des": "高尔察克、邓尼金与弗兰格尔的反布尔什维克武装，外援而无根。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "俄国内战", "des": "1918至1922年红白对峙与外国干涉，饥荒与伤寒夺命千万。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "战时共产主义", "des": "余粮征集与全面国有化的应急体制，喀琅施塔得的警钟将其终结。", "symbolSize": 40, "category": "革命与内战" },
    { "name": "苏联", "des": "1922年成立的苏维埃社会主义共和国联盟，计划与动员的超级实验。", "symbolSize": 60, "category": "苏联体系" },
    { "name": "新经济政策", "des": "1921年粮食税取代余粮征集，市场回潮的十年喘息。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "斯大林", "des": "从总书记到绝对权威，工业化与恐怖、胜利与饥荒集于一身。", "symbolSize": 60, "category": "苏联体系" },
    { "name": "五年计划", "des": "1928年起的指令性工业化，马格尼托哥尔斯克的钢与第聂伯的电。", "symbolSize": 50, "category": "苏联体系" },
    { "name": "集体化", "des": "消灭富农、全盘集体化，拖拉机站的另一面是饥馑。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "乌克兰大饥荒", "des": "1932至1933年征购与封锁之下的饥馑，数百万罹难的至暗年份。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "大清洗", "des": "1937至1938年的顶点，党政军与知识界的恐怖绞肉机。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "古拉格", "des": "劳动改造营管理总局，劳改营群岛的经济与死亡双重账本。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "苏德互不侵犯条约", "des": "1939年8月的莫洛托夫-里宾特洛甫条约与秘密议定书。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "卫国战争", "des": "1941至1945年反法西斯的总体战，两千七百万亡灵换来的胜利。", "symbolSize": 60, "category": "苏联体系" },
    { "name": "斯大林格勒战役", "des": "1942至1943年伏尔加河畔的绞肉机，第二次世界大战的转折点。", "symbolSize": 50, "category": "苏联体系" },
    { "name": "库尔斯克会战", "des": "1943年7月史上最大规模坦克会战，德军东线的最后攻势。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "柏林战役", "des": "1945年4至5月攻克柏林，国会大厦上的红旗。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "冷战", "des": "1947至1991年两大阵营的对峙，核阴影下的半个世纪。", "symbolSize": 50, "category": "苏联体系" },
    { "name": "华约", "des": "1955年针对北约成立的东方军事同盟，布拉格之春的执行者。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "经互会", "des": "社会主义阵营的内部市场体系，卢布区与计划对接的骨架。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "科罗廖夫", "des": "从劳改营到总设计师的航天奇才，卫星与东方号的幕后推手。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "加加林", "des": "1961年4月12日乘东方号绕地一周，进入太空的第一人。", "symbolSize": 50, "category": "苏联体系" },
    { "name": "赫鲁晓夫", "des": "玉米与楼房的改革者，秘密报告的清算者，古巴摊牌的赌徒。", "symbolSize": 50, "category": "苏联体系" },
    { "name": "秘密报告", "des": "1956年二十大《关于个人崇拜及其后果》，一夜祛魅斯大林。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "古巴导弹危机", "des": "1962年十三天的核对峙，最接近末日的时刻。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "勃列日涅夫", "des": "十八年的稳定与僵化，勋章与干部终身制的掌舵人。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "停滞时代", "des": "1970年代起的体制性迟滞，石油红利掩盖下的失速。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "阿富汗战争", "des": "1979至1989年的山地泥潭，帝国末期最深的失血创口。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "中苏交恶", "des": "1960年代论战公开化直至珍宝岛兵戎，社会主义阵营的断裂带。", "symbolSize": 40, "category": "苏联体系" },
    { "name": "戈尔巴乔夫", "des": "末代总书记，改革与公开性的启动者，目睹帝国散场的诺贝尔和平奖得主。", "symbolSize": 60, "category": "改革与解体" },
    { "name": "改革", "des": "经济重构与加速战略，拆旧轨而新轨未成的冒进手术。", "symbolSize": 40, "category": "改革与解体" },
    { "name": "公开性", "des": "言禁渐开的舆论解冻，档案与历史一并见光。", "symbolSize": 40, "category": "改革与解体" },
    { "name": "新思维", "des": "人道社会主义与全人类共同家园的外交哲学。", "symbolSize": 40, "category": "改革与解体" },
    { "name": "切尔诺贝利", "des": "1986年4月26日的核事故，体制谎言与代价的总暴露。", "symbolSize": 40, "category": "改革与解体" },
    { "name": "东欧剧变", "des": "1989年阵营诸国的多米诺，柏林墙倒下的那年秋冬。", "symbolSize": 40, "category": "改革与解体" },
    { "name": "八一九政变", "des": "1991年保守派的孤注一掷，坦克上的演讲反成就叶利钦。", "symbolSize": 40, "category": "改革与解体" },
    { "name": "叶利钦", "des": "站上坦克的俄罗斯总统，联盟解体的推手与休克疗法的开方人。", "symbolSize": 50, "category": "改革与解体" },
    { "name": "别洛韦日协议", "des": "1991年12月8日俄乌白三巨头林中废约，苏联的法律终结。", "symbolSize": 40, "category": "改革与解体" },
    { "name": "苏联解体", "des": "1991年12月25日红旗降下，十五个共和国各奔前程。", "symbolSize": 60, "category": "改革与解体" },
    { "name": "独联体", "des": "苏联继承国的松散联合体，分家后的过渡架构。", "symbolSize": 40, "category": "改革与解体" },
    { "name": "俄罗斯联邦", "des": "联盟法统与核武库的继承者，后苏联空间的主体。", "symbolSize": 50, "category": "改革与解体" },
    { "name": "普希金", "des": "俄国文学之父，从抒情诗到《叶甫盖尼·奥涅金》的现代俄语缔造者。", "symbolSize": 50, "category": "文学与思想" },
    { "name": "果戈理", "des": "以《钦差大臣》与《死魂灵》讽刺俄国灵魂的漫画圣手。", "symbolSize": 40, "category": "文学与思想" },
    { "name": "托尔斯泰", "des": "雅斯纳亚·波良纳的伯爵，《战争与和平》与道德自讼的精神巨人。", "symbolSize": 50, "category": "文学与思想" },
    { "name": "陀思妥耶夫斯基", "des": "从刑场赦免到赌债缠身，《卡拉马佐夫兄弟》的灵魂拷问者。", "symbolSize": 50, "category": "文学与思想" },
    { "name": "契诃夫", "des": "行医写作两不误的短篇小说之王，戏剧留白的一代宗师。", "symbolSize": 40, "category": "文学与思想" },
    { "name": "白银时代", "des": "十九与二十世纪之交的现代主义高潮，象征派与阿克梅派的星光。", "symbolSize": 40, "category": "文学与思想" },
    { "name": "巡回展览画派", "des": "把画架搬向人民的现实主义画派，列宾的伏尔加与苏里科夫的历史。", "symbolSize": 40, "category": "文学与思想" },
    { "name": "柴可夫斯基", "des": "天鹅湖与悲怆的作者，把俄国音乐送上世界舞台的旋律大师。", "symbolSize": 40, "category": "文学与思想" },
    { "name": "安德烈·鲁布廖夫", "des": "十五世纪圣像画圣手，《三位一体》的静穆至美。", "symbolSize": 40, "category": "文学与思想" },
    { "name": "斯拉夫派与西方派", "des": "俄国往何处去的百年论战，本土道路与欧洲道路的两极。", "symbolSize": 40, "category": "文学与思想" },
    { "name": "萨哈罗夫", "des": "氢弹功臣转身人权斗士，物理学家良心的二十年流放与回归。", "symbolSize": 40, "category": "文学与思想" }
  ],
