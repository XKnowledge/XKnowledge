{
  "version": 2,
  "title": "超级英雄漫画宇宙",
  "description": "从 1938 年 Action Comics 第一期到多元宇宙的坍缩重组：漫威与 DC 双雄、创作者群像、宿敌对与大事件交织的披风编年史。",
  "nodes": [
    { "name": "超级英雄漫画宇宙", "des": "美式漫画八十年的主干道：超人撕开天幕之后，英雄、宿敌、团队与多元宇宙在两家出版社的竞争中长成一座互相引用的现代神话库。", "symbolSize": 70, "category": "全景" },
    { "name": "钢铁侠", "des": "托尼·斯塔克：军火商在洞穴里用一箱废料造出盔甲赎罪，「我就是钢铁侠」——天才、花花公子与自毁式责任感的合金。", "symbolSize": 60, "category": "漫威英雄" },
    { "name": "美国队长", "des": "史蒂夫·罗杰斯：布鲁克林瘦子被血清成完美士兵，冰封七十年醒来仍是那个站直了挨打也不还手会先摇人的老实人——「我可以打一整天」。", "symbolSize": 60, "category": "漫威英雄" },
    { "name": "蜘蛛侠", "des": "彼得·帕克：被放射性蜘蛛咬伤的皇后区少年，「能力越大，责任越大」——超级英雄史上最沉重的遗言与最青春的身体。", "symbolSize": 50, "category": "漫威英雄" },
    { "name": "雷神托尔", "des": "阿斯加德的神明之子，雷霆之锤的主人：北欧神话在漫威宇宙里成了科学与魔法的混血。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "绿巨人浩克", "des": "布鲁斯·班纳：伽马事故把愤怒具象成绿色巨兽——「我们不会喜欢的那个家伙」，学者与怪物的同体战争。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "黑寡妇", "des": "娜塔莎·罗曼诺夫：红房培养的顶级间谍，没有超能力的复仇者——用一辈子的赎罪换取一个红色印记的清白。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "鹰眼", "des": "克林特·巴顿：马戏团出身的神箭手，普通人体质的复仇者——楼顶烤肉和带娃的日常英雄。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "奇异博士", "des": "斯蒂芬·斯特兰奇：断手的外科医生在卡玛泰姬学会魔法，至尊法师与时间宝石的守夜人。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "黑豹", "des": "特查拉：瓦坎达的国王与守护者，振金之国的黑豹——超级英雄史上第一位主流黑人王者。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "惊奇队长", "des": "卡罗尔·丹弗斯：空军飞行员融合克里科技成为宇宙级战力，漫威宇宙的门面级女英雄。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "蚁人", "des": "斯科特·朗：出狱的电气工程师，缩小与放大的量子领域常客——最接地气的复仇者。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "猩红女巫", "des": "旺达·马克西莫夫：混沌魔法的化身，改写过整个现实的悲伤母亲——「再无变种人」由她说出。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "幻视", "des": "贾维斯的躯体、心灵宝石的宿主：想理解人性的合成人，额头那颗黄石头是所有人的靶心。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "金刚狼", "des": "罗根：艾德曼合金骨架与自愈因子的变种人，X武器计划的幸存者——雪茄、爪子与一百三十年的记忆。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "X教授", "des": "查尔斯·泽维尔：地表最强心灵感应者，天才少年学院的轮椅导师——人类与变种人共存的梦想家。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "万磁王", "des": "埃里克·兰谢尔：奥斯维辛幸存的磁力大师，X教授的旧友与永恒对手——从同胞身上学会了不再祈求宽恕。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "死侍", "des": "韦德·威尔逊：话痨雇佣兵，知道自己活在漫画里的「嘴炮佣兵」——打破第四面墙是武器，也是诊断书。", "symbolSize": 40, "category": "漫威英雄" },
    { "name": "复仇者联盟", "des": "「复仇者，集合！」——1963 年由斯坦·李与科比共创的地球最强战队：从内斗起家，以团结传世。", "symbolSize": 50, "category": "漫威阵营与事件" },
    { "name": "X战警", "des": "天才少年学院的变种人战队：以「被憎恨与惧怕的少数派」成为漫画史上最持久的平权寓言。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "神盾局", "des": "国土战略防御攻击与后勤保障局：间谍、飞艇与眼罩局长的全球秩序维护者。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "尼克·弗瑞", "des": "独眼局长：复仇者计划的设计师，「复仇者倡议」六个字的发起人。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "九头蛇", "des": "「砍掉一个头，还会长出两个」：渗透神盾局七十年的纳粹余孽组织。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "冬兵巴基", "des": "巴基·巴恩斯：美国队长的挚友，坠落被俘后洗脑成九头蛇的冬日战士——七十年后认出了那张盾。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "灭霸", "des": "泰坦的疯狂泰坦：为「资源平衡」收集六颗宝石、一个响指抹去半个宇宙——爱得扭曲、想得自洽的宇宙级灾难。", "symbolSize": 60, "category": "漫威阵营与事件" },
    { "name": "无限宝石", "des": "空间、心灵、现实、力量、时间、灵魂：大爆炸的六道残响，集齐者的手套即宇宙的权限面板。", "symbolSize": 50, "category": "漫威阵营与事件" },
    { "name": "无限传奇", "des": "漫威电影宇宙前三阶段二十三部电影的总名：从钢铁侠的第一副盔甲到响指与终局。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "洛基", "des": "诡计之神：阿斯加德的养子、复联初战的始作俑者——从反派熬成了最受爱戴的悲剧王子。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "内战", "des": "2006-07 的注册法案大分裂：钢铁侠对美国队长，同一面盾的两半——友军相残的政治寓言。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "M氏家族", "des": "旺达低语「再无更多变种人」：一句改写现实的话，让变种人口从百万骤减到一九九。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "奥创", "des": "「世上没有神，只有我」：失控的人工智能，和平主义的终极怪物——造物主打不过自己的造物。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "银河护卫队", "des": "一帮宇宙废柴的合唱团：星爵、卡魔拉、德拉克斯、火箭与格鲁特——把家庭片藏在太空歌剧里。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "星爵", "des": "彼得·奎尔：半地球半天神的混血，随身听与舞步是他对抗宇宙的方式。", "symbolSize": 40, "category": "漫威阵营与事件" },
    { "name": "超人", "des": "克拉克·肯特/卡尔-艾尔：氪星遗孤、堪萨斯农夫之子——1938 年从 Action Comics 第一期起飞，定义了「超级英雄」这个词的一切。", "symbolSize": 60, "category": "DC英雄" },
    { "name": "蝙蝠侠", "des": "布鲁斯·韦恩：小巷里的两声枪响之后，用一生与家产把自己锻造成哥谭的夜——「我即是黑夜」。", "symbolSize": 60, "category": "DC英雄" },
    { "name": "神奇女侠", "des": "戴安娜：天堂岛的亚马逊公主，真言套索与守护银镯——女权先驱马斯顿笔下的第一位主流女英雄。", "symbolSize": 50, "category": "DC英雄" },
    { "name": "闪电侠", "des": "巴里·艾伦：被闪电与化学品同时击中的鉴证科警察，神速力的第一跑者——也跑出过一条错误的时间线。", "symbolSize": 40, "category": "DC英雄" },
    { "name": "海王", "des": "亚瑟·库瑞：灯塔看守与亚特兰蒂斯女王之子，两大洋的王座继承人。", "symbolSize": 40, "category": "DC英雄" },
    { "name": "绿灯侠", "des": "哈尔·乔丹：测试飞行员，「无所畏惧」的意志化身，绿灯军团队正区守灯人。", "symbolSize": 40, "category": "DC英雄" },
    { "name": "钢骨", "des": "维克多·斯通：运动员之子被父的科技救回，半人半机械的正义联盟创始成员。", "symbolSize": 40, "category": "DC英雄" },
    { "name": "沙赞", "des": "比利·巴特森：一句咒语在大男孩与超级英雄间切换——「所罗门的智慧，赫拉克勒斯的力量……」。", "symbolSize": 40, "category": "DC英雄" },
    { "name": "正义联盟", "des": "DC 的最强战队：超人与蝙蝠侠为首的七巨头，世界末日的最后一道防线。", "symbolSize": 50, "category": "DC英雄" },
    { "name": "罗宾", "des": "迪克·格雷森：初代罗宾，马戏团坠索的遗孤——从蝙蝠侠的影子下走成独立的夜翼。", "symbolSize": 40, "category": "DC英雄" },
    { "name": "阿尔弗雷德", "des": "韦恩庄园的管家：养育了两代蝙蝠侠的绅士，哥谭唯一不变的灯。", "symbolSize": 40, "category": "DC英雄" },
    { "name": "小丑", "des": "「一个糟糕的日子」：无名者跌进化学池，成为混乱的传道者——超级英雄史上最完美的反派，没有起源就是起源。", "symbolSize": 60, "category": "DC反派与哥谭" },
    { "name": "莱克斯·卢瑟", "des": "大都会的「慈善家」：人类天才对超人的憎恨与证明——「为什么他有那些能力？」。", "symbolSize": 40, "category": "DC反派与哥谭" },
    { "name": "哈莉·奎茵", "des": "哈琳·昆泽尔：阿卡姆的心理医生爱上病人，从「小丑女」长成独立的混乱女王。", "symbolSize": 40, "category": "DC反派与哥谭" },
    { "name": "猫女", "des": "瑟琳娜·凯尔：猫形盗贼与蝙蝠侠一生的暧昧对手——哥谭灰色地带的化身。", "symbolSize": 40, "category": "DC反派与哥谭" },
    { "name": "双面人", "des": "哈维·登特：哥谭的光明骑士毁于一瓶酸，从此把正义交给一枚硬币。", "symbolSize": 40, "category": "DC反派与哥谭" },
    { "name": "谜语人", "des": "爱德华·尼格玛：留下谜题的犯罪艺术家，「谜语人的谜语」是他强迫症的自白。", "symbolSize": 40, "category": "DC反派与哥谭" },
    { "name": "企鹅人", "des": "奥斯瓦尔德·科波特：伞尖藏刀的黑市之王，哥谭 underworld 的老派绅士。", "symbolSize": 40, "category": "DC反派与哥谭" },
    { "name": "贝恩", "des": "圣普里希拉监狱的产儿，毒液强化的战略家——唯一把蝙蝠侠「折断」过的男人。", "symbolSize": 40, "category": "DC反派与哥谭" },
    { "name": "哥谭市", "des": "韦恩夫妇倒下的城市：高犯罪率与新艺术建筑的阴郁都市，蝙蝠侠与其全部敌人的舞台与病灶。", "symbolSize": 50, "category": "DC反派与哥谭" },
    { "name": "阿卡姆疯人院", "des": "哥谭的精神病院兼反派旅馆：旋转门式的收容制度，越狱是常客的节日。", "symbolSize": 40, "category": "DC反派与哥谭" },
    { "name": "大都会", "des": "「大都会」：日报星球与摩天楼的希望之城，超人头顶的应许之地。", "symbolSize": 40, "category": "DC反派与哥谭" },
    { "name": "达克赛德", "des": "天启星的新神，反生命方程式的追寻者：DC 宇宙的终极黑暗，正义联盟的天花板对手。", "symbolSize": 40, "category": "DC反派与哥谭" },
    { "name": "多元宇宙", "des": "并行地球的无限集合：正史、终极、黑暗与无数「如果」——超级英雄故事的自我扩容机制与重启急救包。", "symbolSize": 50, "category": "多元宇宙与大事件" },
    { "name": "地球616", "des": "漫威主宇宙的编号：一切正史的默认地址，「616」从编辑部的玩笑变成官方门牌。", "symbolSize": 40, "category": "多元宇宙与大事件" },
    { "name": "终极宇宙1610", "des": "2000 年开垦的现代重启线：年轻化的复仇者与更暗的世界——迈尔斯的出生地，后来坍进了斗界。", "symbolSize": 40, "category": "多元宇宙与大事件" },
    { "name": "迈尔斯·莫拉莱斯", "des": "终极宇宙的第二代蜘蛛侠：布鲁克林的非裔拉丁裔少年，接过彼得的名号与责任。", "symbolSize": 40, "category": "多元宇宙与大事件" },
    { "name": "无限地球危机", "des": "1985 年的 DC 五十周年大事件：反监视者吞噬多元，无数平行地球合并为一个——漫画史上第一次「宇宙重启」。", "symbolSize": 40, "category": "多元宇宙与大事件" },
    { "name": "闪点", "des": "巴里逆时间救母的连锁灾难：一条支线现实改写整个 DC 宇宙——「新52」的起点。", "symbolSize": 40, "category": "多元宇宙与大事件" },
    { "name": "秘密战争2015", "des": "多元宇宙崩解成斗界：毁灭博士以上帝姿态重组世界，漫威宇宙的全盘洗牌局。", "symbolSize": 40, "category": "多元宇宙与大事件" },
    { "name": "守望者", "des": "阿兰·摩尔 1986 年的解构史诗：退役英雄、冷战时钟与章鱼式的谎——唯一登上《时代》百佳的超英漫画。", "symbolSize": 50, "category": "多元宇宙与大事件" },
    { "name": "黑暗骑士归来", "des": "弗兰克·米勒 1986 年的老年蝙蝠侠：五十岁的义警复出、与超人决斗——超级英雄漫画「成人化」的引爆点。", "symbolSize": 50, "category": "多元宇宙与大事件" },
    { "name": "三代蜘蛛侠同框", "des": "《英雄无归》的银幕奇迹：托比、安德鲁与汤姆三代替彼得跨多元宇宙同框——影院变演唱会的一夜。", "symbolSize": 40, "category": "多元宇宙与大事件" },
    { "name": "斯坦·李", "des": "Excelsior！漫威Method 的推销员总编：与科比批量铸造六十年代英雄宇宙，客串 cameo 成了半个世纪的彩蛋传统。", "symbolSize": 60, "category": "创作者与出版史" },
    { "name": "杰克·科比", "des": "「国王」：画遍两个宇宙的男人——美国队长、神奇四侠、雷神、绿巨人与新神族的共同父亲，被低估稿酬的一代宗师。", "symbolSize": 50, "category": "创作者与出版史" },
    { "name": "史蒂夫·迪特科", "des": "隐士般的线条大师：蜘蛛侠与奇异博士的共同创造者，坚定的个人主义信徒。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "比尔·芬格", "des": "蝙蝠侠真正的共同缔造者：写了大部分早期故事却半个世纪拿不到署名——迟到数十年的正名。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "鲍勃·凯恩", "des": "蝙蝠侠的官方署名者：名字印了八十年，贡献的份额至今仍是出版史公案。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "杰里·西格尔与乔·舒斯特", "des": "超人的创造者：克里夫兰的两个少年把内裤外穿的男人卖掉版权，换来一生的心碎与迟来的年金。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "威廉·莫尔顿·马斯顿", "des": "神奇女侠的创造者：测谎仪发明者、女权心理学家——真言套索是他学术的漫画化。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "阿兰·摩尔", "des": "沼泽怪物的巫师、守望者的先知：把超级英雄当文学材料的大作家，与主流漫画社决裂三十年。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "弗兰克·米勒", "des": "《黑暗骑士归来》与《罪恶之城》的作者：黑色电影笔法重写超英语法的关键一支笔。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "黄金时代", "des": "1938-1956：超人起飞、爱国英雄参战、销量百万的纸浆狂欢——以麦卡锡时代的围剿告终。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "白银时代", "des": "1956-1970：闪电侠重启掀起的科幻复兴，白银的火箭、彩虹变身与平行地球。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "青铜时代", "des": "1970-1985：反文化风潮与「relevant comics」，毒品、贫困与越战进入四色世界。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "黑暗时代", "des": "1986 起：《守望者》与《黑暗骑士归来》同年出版，反英雄、道德灰域与成人叙事接管主流。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "漫画准则管理局", "des": "1954 年的自我审查机构：「comics code」印章净化了二十年，也间接催生了地下漫画的反抗。", "symbolSize": 40, "category": "创作者与出版史" },
    { "name": "超级士兵血清", "des": "从瘦弱到完美的美国神话：科学与国家意志合铸的身体——美队的起点，也是许多悲剧的配方。", "symbolSize": 40, "category": "超能力来源体系" },
    { "name": "伽马辐射", "des": "科学事故的绿色分支：班纳的浩克、 Leader 的巨脑——伽马炸弹把愤怒写进了 DNA。", "symbolSize": 40, "category": "超能力来源体系" },
    { "name": "变种X基因", "des": "天生的下一阶段人类：X 基因在青春期觉醒——少数派寓言的生物学基础。", "symbolSize": 40, "category": "超能力来源体系" },
    { "name": "科技战甲", "des": "凡人版的超能力：钢铁侠的盔甲、钢骨的义体、蚁人的头盔——钱包与头脑即上限。", "symbolSize": 40, "category": "超能力来源体系" },
    { "name": "神话血统", "des": "旧神的新工作：阿斯加德的雷神、亚马逊的戴安娜——神话人物直接入职超英体系。", "symbolSize": 40, "category": "超能力来源体系" },
    { "name": "神速力", "des": "闪电侠背后的超自然力场：所有极速者的能源库与归宿，时间线的红移由它解释。", "symbolSize": 40, "category": "超能力来源体系" },
    { "name": "情感光谱", "des": "意志是绿、愤怒是红、恐惧是黄：宇宙被情绪点灯——绿灯军团的能量论基础。", "symbolSize": 40, "category": "超能力来源体系" },
    { "name": "变异蜘蛛咬伤", "des": "科学展览上的一只放射性蜘蛛：爬墙、蜘蛛感应与吐丝——皇后区少年的成人礼。", "symbolSize": 40, "category": "超能力来源体系" },
    { "name": "氪星生理", "des": "黄太阳下的氪星人体：飞行、热视线与刀枪不入——弱点的名字叫氪石。", "symbolSize": 40, "category": "超能力来源体系" },
    { "name": "漫威电影宇宙", "des": "2008 年从《钢铁侠》起步的工业奇迹：二十三部电影的长篇连续剧，把漫画的连续宇宙搬进了影院。", "symbolSize": 50, "category": "影视改编" },
