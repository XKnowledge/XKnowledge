{"version":2,"nodes":[{"name":"统计学","des":"在不确定性中提取规律的科学：从数据的描述、推断到因果与预测。","symbolSize":70,"category":"描述统计"},{"name":"描述统计","des":"用图表与指标概括数据：集中趋势、离散程度与分布形态。","symbolSize":50,"category":"描述统计"},{"name":"总体与样本","des":"推断统计的基本框架：以部分推断整体。","symbolSize":40,"category":"描述统计"},{"name":"数据类型","des":"定类、定序、定距、定比：测量层次决定统计方法。","symbolSize":30,"category":"描述统计"},{"name":"均值","des":"最常用的集中趋势量数，对极端值敏感。","symbolSize":40,"category":"描述统计"},{"name":"中位数与众数","des":"抗极端值的替代位置量数。","symbolSize":30,"category":"描述统计"},{"name":"方差与标准差","des":"对均值的偏离度量：离散程度的标准量数。","symbolSize":50,"category":"描述统计"},{"name":"分位数与箱线图","des":"五数概括与图形化：中位数、四分位与离群点。","symbolSize":30,"category":"描述统计"},{"name":"分布形态","des":"偏度与峰度：分布的左右倾斜与高低胖瘦。","symbolSize":30,"category":"描述统计"},{"name":"相关系数","des":"线性关系的强度量数，从负一到正一。","symbolSize":40,"category":"描述统计"},{"name":"异常值","des":"偏离主体的极端观测：信号或噪声。","symbolSize":30,"category":"描述统计"},{"name":"辛普森悖论","des":"分组与合并的关联方向可能反转。","symbolSize":40,"category":"描述统计"},{"name":"均值回归","des":"高尔顿的发现：极端值的后代向均值回落。","symbolSize":30,"category":"描述统计"},{"name":"数据可视化","des":"图形优先于表格：眼睛是最好的统计学家。","symbolSize":30,"category":"描述统计"},{"name":"概率","des":"不确定性事件的量化度量。","symbolSize":50,"category":"概率论基础"},{"name":"条件概率","des":"在已知信息下的概率更新。","symbolSize":40,"category":"概率论基础"},{"name":"独立性","des":"一个事件不改变另一个事件的概率。","symbolSize":30,"category":"概率论基础"},{"name":"随机变量","des":"把随机结果数量化的数学对象。","symbolSize":40,"category":"概率论基础"},{"name":"期望","des":"长期平均值的数学预言。","symbolSize":40,"category":"概率论基础"},{"name":"二项分布","des":"n 次独立试验中成功次数的分布。","symbolSize":30,"category":"概率论基础"},{"name":"泊松分布","des":"稀有事件计数的分布：电话呼入与放射性衰变。","symbolSize":30,"category":"概率论基础"},{"name":"正态分布","des":"钟形曲线：68-95-99.7 法则无处不在。","symbolSize":60,"category":"概率论基础"},{"name":"中心极限定理","des":"大量独立作用之和趋于正态：抽样推断的理论基石。","symbolSize":50,"category":"概率论基础"},{"name":"大数定律","des":"频率趋近概率、均值趋近期望的保证。","symbolSize":40,"category":"概率论基础"},{"name":"贝叶斯定理","des":"由果溯因的更新规则：P(H|E) 的桥梁。","symbolSize":50,"category":"概率论基础"},{"name":"蒙特卡洛方法","des":"用随机模拟逼近解析无法企及的量。","symbolSize":30,"category":"概率论基础"},{"name":"概率公理化","des":"柯尔莫哥洛夫以测度论为概率奠基。","symbolSize":30,"category":"概率论基础"},{"name":"抽样调查","des":"以科学抽取的样本推断总体。","symbolSize":40,"category":"抽样与估计"},{"name":"随机抽样","des":"每个个体等概率入样：代表性的保证。","symbolSize":30,"category":"抽样与估计"},{"name":"分层抽样","des":"按层分配样本：提高精度的设计。","symbolSize":30,"category":"抽样与估计"},{"name":"抽样偏差","des":"系统性偏离总体的样本：统计的头号陷阱。","symbolSize":40,"category":"抽样与估计"},{"name":"幸存者偏差","des":"只统计了活下来的：轰炸机装甲的故事。","symbolSize":30,"category":"抽样与估计"},{"name":"标准误","des":"样本统计量自身的波动：标准差除以根号 n。","symbolSize":40,"category":"抽样与估计"},{"name":"置信区间","des":"点估计加减边际：参数的合理范围。","symbolSize":50,"category":"抽样与估计"},{"name":"点估计","des":"用一个数值猜测参数。","symbolSize":30,"category":"抽样与估计"},{"name":"无偏性","des":"估计量期望等于真值：长期赌得公平。","symbolSize":30,"category":"抽样与估计"},{"name":"自助法","des":"bootstrap：以重抽样近似抽样分布。","symbolSize":30,"category":"抽样与估计"},{"name":"假设检验","des":"用数据裁决主张：证伪精神的数据版。","symbolSize":50,"category":"假设检验"},{"name":"原假设","des":"默认成立、待被推翻的主张。","symbolSize":30,"category":"假设检验"},{"name":"p值","des":"在原假设为真时观测到更极端结果的概率。","symbolSize":50,"category":"假设检验"},{"name":"显著性水平","des":"预先设定的裁决阈值，常取0.05。","symbolSize":40,"category":"假设检验"},{"name":"两类错误","des":"弃真与取伪：鱼与熊掌的统计版本。","symbolSize":40,"category":"假设检验"},{"name":"统计功效","des":"正确检出真实效应的概率。","symbolSize":40,"category":"假设检验"},{"name":"t检验","des":"小样本均值比较的经典工具。","symbolSize":40,"category":"假设检验"},{"name":"卡方检验","des":"分类数据的拟合优度与独立性检验。","symbolSize":40,"category":"假设检验"},{"name":"方差分析","des":"ANOVA：多组均值的同时比较。","symbolSize":30,"category":"假设检验"},{"name":"多重比较","des":"检验越多越易显著：窥视数据的代价。","symbolSize":30,"category":"假设检验"},{"name":"效应量","des":"显著不等于重要：差异的实际大小。","symbolSize":30,"category":"假设检验"},{"name":"可重复性危机","des":"p 值操纵与发表偏倚对科学的反噬。","symbolSize":40,"category":"假设检验"},{"name":"女士品茶","des":"费希尔的经典案例：八杯奶茶的实验设计课。","symbolSize":30,"category":"假设检验"},{"name":"回归分析","des":"用模型刻画变量间关系的统计家族。","symbolSize":50,"category":"回归与因果"},{"name":"最小二乘法","des":"使残差平方和最小的参数估计。","symbolSize":50,"category":"回归与因果"},{"name":"线性回归","des":"一条直线的模型：统计建模的 Hello World。","symbolSize":50,"category":"回归与因果"},{"name":"多元回归","des":"多个自变量同时进入模型。","symbolSize":40,"category":"回归与因果"},{"name":"逻辑回归","des":"分类任务的对数几率模型。","symbolSize":30,"category":"回归与因果"},{"name":"过拟合","des":"模型背熟了噪声：训练好、预测差的陷阱。","symbolSize":40,"category":"回归与因果"},{"name":"交叉验证","des":"留出数据检验模型：样本外的成绩单。","symbolSize":40,"category":"回归与因果"},{"name":"相关与因果","des":"相关不等于因果：统计学的第一诫。","symbolSize":40,"category":"回归与因果"},{"name":"随机对照试验","des":"RCT：随机化切断混杂的因果金标准。","symbolSize":50,"category":"回归与因果"},{"name":"混杂变量","des":"同时影响因果双方的第三变量。","symbolSize":30,"category":"回归与因果"},{"name":"反事实","des":"因果的对照基准：如果当初没有。","symbolSize":30,"category":"回归与因果"},{"name":"主成分分析","des":"PCA：无监督降维的经典。","symbolSize":30,"category":"回归与因果"},{"name":"聚类分析","des":"无监督的分组：物以类聚的算法版。","symbolSize":30,"category":"回归与因果"},{"name":"时间序列分析","des":"带时间结构的数据：趋势、季节与噪声。","symbolSize":30,"category":"回归与因果"},{"name":"贝叶斯推断","des":"用后验不断更新信念的推断范式。","symbolSize":40,"category":"应用与前沿"},{"name":"先验与后验","des":"信念的更新前后：数据介入的前与后。","symbolSize":30,"category":"应用与前沿"},{"name":"最大似然估计","des":"选使数据最可能的参数：频率派的核心方法。","symbolSize":40,"category":"应用与前沿"},{"name":"MCMC","des":"马尔可夫链蒙特卡洛：复杂后验的采样器。","symbolSize":30,"category":"应用与前沿"},{"name":"频率派与贝叶斯","des":"概率是长期频率还是信念度：两种哲学的百年之争。","symbolSize":40,"category":"应用与前沿"},{"name":"费希尔","des":"显著性检验、最大似然与实验设计之父。","symbolSize":40,"category":"应用与前沿"},{"name":"高尔顿","des":"回归一词的发明者，优生学的历史污点。","symbolSize":30,"category":"应用与前沿"},{"name":"卡尔·皮尔逊","des":"卡方检验与积差相关系数的奠基人。","symbolSize":30,"category":"应用与前沿"},{"name":"高斯","des":"数学王子：以正态分布论证最小二乘的误差理论。","symbolSize":30,"category":"应用与前沿"},{"name":"统计学史","des":"从国势学、政治算术到推断统计的三百年。","symbolSize":30,"category":"应用与前沿"},{"name":"质量控制","des":"休哈特控制图：统计走进工厂。","symbolSize":30,"category":"应用与前沿"},{"name":"盖洛普调查","des":"1936年用科学抽样战胜百万样本的《文学文摘》。","symbolSize":30,"category":"应用与前沿"},{"name":"A/B测试","des":"互联网的随机对照试验：按钮颜色的科学。","symbolSize":30,"category":"应用与前沿"},{"name":"机器学习与统计","des":"统计学习的现代名字：