{"version":2,"nodes":[{"name":"希腊城邦","des":"散落于爱琴海岸的小型主权公民共同体，西方政治文明的母体。","symbolSize":50,"category":"古典文明"},{"name":"雅典民主","des":"公民大会与陪审法庭的直接民主，经梭伦至克里斯提尼奠基、伯里克利臻于极盛，后世民主制度的源头。","symbolSize":50,"category":"古典文明"},{"name":"梭伦改革","des":"公元前594年的解负令与等级权利制，雅典民主的第一块踏脚石。","symbolSize":40,"category":"古典文明"},{"name":"伯里克利","des":"雅典黄金时代的掌舵人，公民大会全盛期的实际领导人。","symbolSize":40,"category":"古典文明"},{"name":"伯罗奔尼撒战争","des":"前431至前404年雅典与斯巴达的争霸拉锯，希腊世界由盛转衰的转折。","symbolSize":40,"category":"古典文明"},{"name":"亚历山大帝国","des":"前336至前323年东征建立的跨洲大帝国，希腊文明东传至中亚与印度河。","symbolSize":50,"category":"古典文明"},{"name":"希腊化时代","des":"希腊文明与东方文明交融互渗的三百年，亚历山大城为其学术中心。","symbolSize":40,"category":"古典文明"},{"name":"罗马共和国","des":"前509年起执政官、元老院与公民大会并立的混合政体，共和理念的策源地。","symbolSize":50,"category":"古典文明"},{"name":"布匿战争","des":"前264至前146年罗马与迦太基的三次地中海霸权之争，迦太基的毁灭成就罗马霸业。","symbolSize":40,"category":"古典文明"},{"name":"凯撒","des":"征服高卢、渡过卢比孔河，引领罗马由共和国走向帝制的过渡人物。","symbolSize":50,"category":"古典文明"},{"name":"奥古斯都","des":"屋大维，凯撒遇刺后内战的胜者，以元首之名创立帝制的开国者。","symbolSize":50,"category":"古典文明"},{"name":"罗马帝国","des":"前27年开启的地中海大一统帝国，极盛时环地中海而治，古典文明的集大成载体。","symbolSize":70,"category":"古典文明"},{"name":"罗马和平","des":"奥古斯都至安东尼王朝约两百年的安定繁荣，道路、法律与商贸的黄金时代。","symbolSize":40,"category":"古典文明"},{"name":"罗马法","des":"从《十二铜表法》到《民法大全》的成文法体系，后世大陆法系的祖先。","symbolSize":50,"category":"古典文明"},{"name":"基督教兴起","des":"公元一世纪诞生于罗马行省犹太地，由受迫害教派终成国教，重塑欧洲精神世界。","symbolSize":50,"category":"古典文明"},{"name":"戴克里先","des":"创立四帝共治、稳住三世纪危机的改革者皇帝，帝国转型的关键人物。","symbolSize":40,"category":"古典文明"},{"name":"西罗马灭亡","des":"476年末代皇帝被废，日耳曼诸王国取而代之的旧新更替，中世纪的开端。","symbolSize":50,"category":"古典文明"},{"name":"法兰克王国","des":"日耳曼诸王国中最强的一支，由克洛维皈依到加洛林崛起，法德两国的共同胚胎。","symbolSize":50,"category":"中世纪"},{"name":"查理曼","des":"公元800年加冕称帝、一统西欧大部的法兰克君主，后世尊为欧洲之父。","symbolSize":50,"category":"中世纪"},{"name":"封建制度","des":"以封君封臣与采邑为纽带的层级权利义务网络，中世纪欧洲的社会基本框架。","symbolSize":50,"category":"中世纪"},{"name":"神圣罗马帝国","des":"962年奥托一世开创的帝国政体，既是一种帝国理念又是松散的诸侯联合。","symbolSize":40,"category":"中世纪"},{"name":"十字军东征","des":"1096至1291年间的系列东征地中海东岸行动，宗教旗帜下的东西方大碰撞与大交流。","symbolSize":40,"category":"中世纪"},{"name":"维京时代","des":"八至十一世纪北欧人劫掠、经商与殖民的海上扩张，重塑欧洲沿海格局。","symbolSize":40,"category":"中世纪"},{"name":"叙任权之争","des":"教皇与皇帝围绕主教任命权的百年角力，教俗权力博弈的核心剧目。","symbolSize":40,"category":"中世纪"},{"name":"黑死病","des":"1347至1353年夺走欧洲三分之一人口的大瘟疫，中世纪晚期社会结构的强力摇撼者。","symbolSize":50,"category":"中世纪"},{"name":"百年战争","des":"1337至1453年英格兰与法兰西的百年缠斗，两国民族意识的催化剂。","symbolSize":40,"category":"中世纪"},{"name":"经院哲学","des":"信仰寻求理性论证的学术形态，托马斯·阿奎那的体系为其顶峰，中世纪大学的课堂正统。","symbolSize":40,"category":"中世纪"},{"name":"大学兴起","des":"自博洛尼亚、巴黎到牛津，十二世纪起获得自治的学者共同体，近现代大学的制度祖先。","symbolSize":40,"category":"中世纪"},{"name":"拜占庭","des":"以君士坦丁堡为都延续千年的东部帝国，为西方守护并传递古典学问。","symbolSize":40,"category":"中世纪"},{"name":"大宪章","des":"1215年英格兰贵族逼迫约翰王签署的权利文件，未经同意不征税为其内核，宪政的远源。","symbolSize":50,"category":"中世纪"},{"name":"城市兴起","des":"十一世纪起的商业市镇与市民自治，中世纪版图中崛起的第三等级。","symbolSize":40,"category":"中世纪"},{"name":"君士坦丁堡陷落","des":"1453年奥斯曼攻陷拜占庭都城，中世纪的终点与开辟新航路的推手。","symbolSize":40,"category":"中世纪"},{"name":"文艺复兴","des":"十四世纪起自意大利兴起，以复兴古典、发现人的尊严为旗帜的大变革，欧洲近代的序幕。","symbolSize":70,"category":"文艺复兴与大航海"},{"name":"人文主义","des":"以人为中心而非以神为中心，肯定世俗生活与个体价值，文艺复兴的精神主调。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"美第奇家族","des":"佛罗伦萨的银行家与政治家族，文艺复兴最大的赞助人，把财富织进艺术。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"达·芬奇","des":"画家、解剖学家与工程师于一身的全才，全人理想的最佳化身。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"米开朗基罗","des":"西斯廷天顶画与大卫像的缔造者，雕塑绘画双绝的英雄气质典范。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"拉斐尔","des":"盛期文艺复兴的和谐与优雅，《雅典学院》式的古典范式。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"印刷革命","des":"十五世纪中古腾堡活字印刷，知识复制成本骤降一个量级，宗教改革之前的信息革命。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"宗教改革","des":"1517年起以因信称义直挑战教皇权威的大变革，基督教世界由一统走向多元。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"马丁·路德","des":"1517年张贴《九十五条论纲》点燃宗教改革风暴的维滕贝格神学家。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"加尔文","des":"日内瓦宗教改革的设计师，预定论与入世禁欲深刻影响新教伦理。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"哥伦布","des":"1492年向西横渡大西洋抵达美洲的热那亚航海家，两个半球文明大汇合的开端。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"麦哲伦","des":"其船队于1519至1522年完成首次环球航行，以实践证明地球为球体。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"大航海时代","des":"十五世纪末开启的海外扩张浪潮，欧洲从世界边缘走向世界中心。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"日心说","des":"1543年哥白尼提出以太阳为中心的宇宙图景，中世纪世界观的第一个缺口。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"价格革命","des":"十六世纪美洲白银涌入欧洲引发的物价腾贵，大商业时代的货币前奏。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"威斯特伐利亚和约","des":"1648年终结三十年战争的合约体系，主权国家间秩序的现代起点。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"英国革命","des":"1640年起围绕王权边界的内战与动荡，近代政治革命的序幕。","symbolSize":40,"category":"革命时代"},{"name":"光荣革命","des":"1688年不流血的改朝换代，议会至上就此定局。","symbolSize":50,"category":"革命时代"},{"name":"君主立宪","des":"《权利法案》后国王统而不治、议会至上的政体，近代宪政的模板。","symbolSize":50,"category":"革命时代"},{"name":"启蒙运动","des":"十八世纪以理性为武器、以自由平等进步为蓝图的思想高潮。","symbolSize":50,"category":"革命时代"},{"name":"伏尔泰","des":"以批判教会与倡导宽容闻名的启蒙旗手，一个时代的精神领袖。","symbolSize":40,"category":"革命时代"},{"name":"孟德斯鸠","des":"《论法的精神》提出三权分立，为近代宪制提供结构设计。","symbolSize":40,"category":"革命时代"},{"name":"卢梭","des":"《社会契约论》与人民主权学说的提出者，法国大革命最激进的思想源头。","symbolSize":50,"category":"革命时代"},{"name":"美国独立","des":"1776年《独立宣言》建国，启蒙思想的第一次大规模落地实践。","symbolSize":40,"category":"革命时代"},{"name":"法国大革命","des":"1789年摧毁旧制度的革命，自由平等博爱响彻欧洲，近代史的分水岭。","symbolSize":70,"category":"革命时代"},{"name":"攻占巴士底狱","des":"1789年7月14日巴黎民众攻陷王家监狱，革命爆发的象征。","symbolSize":40,"category":"革命时代"},{"name":"拿破仑","des":"自革命中崛起、加冕称帝的军政强人，以征服传播革命的成果。","symbolSize":50,"category":"革命时代"},{"name":"拿破仑法典","des":"1804年颁布，确立法律面前人人平等与私有财产保护，随战火传遍欧洲。","symbolSize":40,"category":"革命时代"},{"name":"维也纳体系","des":"1815年后列强协调与均势的国际安排，维持欧洲近一个世纪无全欧大战。","symbolSize":40,"category":"革命时代"},{"name":"彼得大帝改革","des":"世纪之交的全面西化，俄罗斯以强制手段跨入欧洲强国的竞技场。","symbolSize":40,"category":"革命时代"},{"name":"工业革命","des":"十八世纪六十年代起自英国，机器代手工、工厂代作坊，近代经济增长的发令枪。","symbolSize":70,"category":"工业与帝国时代"},{"name":"珍妮纺纱机","des":"1765年哈格里夫斯的多元纺机，纺织技术革命的第一件产品。","symbolSize":40,"category":"工业与帝国时代"},{"name":"瓦特蒸汽机","des":"十八世纪七十年代分离冷凝器的改良，工厂时代的通用动力。","symbolSize":50,"category":"工业与帝国时代"},{"name":"铁路时代","des":"1825年首条运营铁路起，轨道与蒸汽编织大陆市场。","symbolSize":40,"category":"工业与帝国时代"},{"name":"城市化","des":"人口向工业城市聚集的大迁移，曼彻斯特的繁华与贫民窟的阴影并存。","symbolSize":40,"category":"工业与帝国时代"},{"name":"宪章运动","des":"十九世纪三四十年代英国工人争取普选权的请愿运动，大众政治的序曲。","symbolSize":40,"category":"工业与帝国时代"},{"name":"马克思主义","des":"马克思与恩格斯对资本主义的批判与解放纲领，工人运动的思想旗帜。","symbolSize":50,"category":"工业与帝国时代"},{"name":"1848年革命","des":"席卷欧陆的革命浪潮，民族之春失败却成为民族统一的转折点。","symbolSize":40,"category":"工业与帝国时代"},{"name":"意大利统一","des":"以撒丁王国为中心于1870年完成，亚平宁半岛民族国家的诞生。","symbolSize":40,"category":"工业与帝国时代"},{"name":"德意志统一","des":"1871年由铁血三战完成，欧洲列强格局最大的一次变局。","symbolSize":50,"category":"工业与帝国时代"},{"name":"俾斯麦","des":"设计三场王朝战争、编织同盟体系的普鲁士宰相，德意志帝国首任首相。","symbolSize":50,"category":"工业与帝国时代"},{"name":"第二次工业革命","des":"十九世纪七十年代起德美领跑的电气与内燃机时代，钢铁化工电力的飞跃。","symbolSize":40,"category":"工业与帝国时代"},{"name":"殖民扩张","des":"十九世纪末列强瓜分亚非的狂潮，世界体系完成与矛盾积累并存。","symbolSize":40,"category":"工业与帝国时代"},{"name":"同盟体系","des":"俾斯麦之后列强互保条约织成的密网，战争传导的链条。","symbolSize":40,"category":"工业与帝国时代"},{"name":"第一次世界大战","des":"1914至1918年列强总体战，四大帝国终结，欧洲文明深受重创。","symbolSize":50,"category":"世界大战与冷战"},{"name":"凡尔赛体系","des":"1919年对战败国的严厉处置与秩序重排，被称为二十年停战。","symbolSize":40,"category":"世界大战与冷战"},{"name":"国际联盟","des":"1920年成立的首个国际集体安全组织，理想主义的首次尝试与受挫。","symbolSize":40,"category":"世界大战与冷战"},{"name":"大萧条","des":"1929年爆发的世界经济危机，繁荣崩塌与政治动荡的经济根源。","symbolSize":40,"category":"世界大战与冷战"},{"name":"第二次世界大战","des":"1939至1945年由欧洲蔓延至全球的大战，近代史上最大的动荡，战后欧洲地位彻底改变。","symbolSize":50,"category":"世界大战与冷战"},{"name":"雅尔塔体系","des":"1945年战后大国安排，两极格局的秩序基础。","symbolSize":40,"category":"世界大战与冷战"},{"name":"冷战","des":"1947至1991年近半世纪的大国对峙，不诉诸直接战争的抗衡与割据。","symbolSize":50,"category":"世界大战与冷战"},{"name":"北约","des":"1949年成立的跨大西洋集体防御组织，西方阵营的硬骨架。","symbolSize":40,"category":"世界大战与冷战"},{"name":"华约","des":"1955年成立的东方阵营军事同盟，与北约对峙 counterpart，1991年解散。","symbolSize":40,"category":"世界大战与冷战"},{"name":"欧洲一体化","des":"自煤钢联营至欧盟的联合实验，欧洲对战争教训的回答。","symbolSize":50,"category":"世界大战与冷战"},{"name":"柏林墙倒塌","des":"1989年11月分隔象征的崩塌，冷战在欧洲落幕，德国统一随之而来。","symbolSize":40,"category":"世界大战与冷战"}],"links":[{"source":"希腊城邦","target":"雅典民主","name":"孕育","des":"城邦小国寡民的规模是直接民主的前提。"},{"source":"梭伦改革","target":"雅典民主","name":"奠基","des":"解负令与等级权利开启公民参政传统。"},{"source":"伯里克利","target":"雅典民主","name":"完善","des":"公民大会与陪审法庭全速运转，民主的黄金时代。"},{"source":"伯罗奔尼撒战争","target":"希腊城邦","name":"削弱","des":"二十七年拉锯耗尽各邦，为马其顿崛起让路。"},{"source":"伯罗奔尼撒战争","target":"雅典民主","name":"动摇","des":"战败与寡头政变交替冲击民主秩序。"},{"source":"希腊城邦","target":"罗马共和国","name":"滋养","des":"希腊政治思想为罗马早期制度提供养分。"},{"source":"亚历山大帝国","target":"希腊化时代","name":"开启","des":"东征之后希腊与东方文明大交融。"},{"source":"希腊化时代","target":"罗马帝国","name":"汇入","des":"罗马逐步吸纳希腊化诸国并继承其学统。"},{"source":"布匿战争","target":"罗马共和国","name":"成就霸业","des":"战胜迦太基使罗马成为地中海霸主。"},{"source":"凯撒","target":"罗马共和国","name":"终结","des":"渡过卢比孔河，内战埋葬共和政体。"},{"source":"凯撒","target":"奥古斯都","name":"铺路","des":"养子与政治继承人完成帝制过渡。"},{"source":"奥古斯都","target":"罗马帝国","name":"开创","des":"前27年以元首之名立两百年帝制。"},{"source":"奥古斯都","target":"罗马和平","name":"开启","des":"奥古斯都时代为两百年繁荣起笔。"},{"source":"罗马帝国","target":"罗马和平","name":"支撑","des":"统一秩序、道路与法律托起帝国盛世。"},{"source":"罗马法","target":"罗马帝国","name":"巩固","des":"成文法与法学家是庞大专域的治理工具。"},{"source":"罗马和平","target":"罗马法","name":"成熟","des":"法学家的黄金时代在和平中展开。"},{"source":"基督教兴起","target":"罗马帝国","name":"扎根","des":"由受迫害教派终成国教，改变帝国精神底色。"},{"source":"戴克里先","target":"罗马帝国","name":"稳定","des":"四帝共治与体制改革应对三世纪危机。"},{"source":"西罗马灭亡","target":"罗马帝国","name":"终结","des":"476年西部末帝被废，帝国秩序落幕。"},{"source":"拜占庭","target":"罗马法","name":"保存","des":"查士丁尼《民法大全》留存古典法学。"},{"source":"拜占庭","target":"君士坦丁堡陷落","name":"终结于","des":"1453年千年帝国在都城落幕。"},{"source":"基督教兴起","target":"拜占庭","name":"伴随","des":"东部帝国守护正统信仰与古典学问。"},{"source":"基督教兴起","target":"经院哲学","name":"演变为","des":"信仰寻求理性论证，沉淀为课堂学问。"},{"source":"西罗马灭亡","target":"法兰克王国","name":"让位于","des":"日耳曼诸王国代之而起，法兰克最强。"},{"source":"西罗马灭亡","target":"封建制度","name":"孕育","des":"帝国崩解与日耳曼习俗熔合出生封建网络。"},{"source":"法兰克王国","target":"封建制度","name":"成型","des":"加洛林的采邑分封层级固化为