{"version":2,"nodes":[{"name":"儿童文学","des":"以儿童为本位的文学类型：从道德教化到「童心至上」的两百年观念史。","symbolSize":65,"category":"教谕时代"},{"name":"《世界图解》","des":"夸美纽斯 1658：第一本带插图的儿童教科书。","symbolSize":30,"category":"教谕时代"},{"name":"纽伯瑞","des":"1744 年伦敦书商：商业化儿童出版的开创者。","symbolSize":45,"category":"教谕时代"},{"name":"伊索寓言的儿童化","des":"古典寓言改写为课本与童书：教谕时代的标配读物。","symbolSize":25,"category":"教谕时代"},{"name":"爱丽丝·梦游仙境","des":"1865：无教化之游乐，儿童本位的分水岭。","symbolSize":55,"category":"黄金时代"},{"name":"刘易斯·卡罗尔","des":"牛津数学家的荒诞诗学：为利德尔姐妹讲故事。","symbolSize":45,"category":"黄金时代"},{"name":"《汤姆·索亚历险记》","des":"1876：顽童叙事与美国童书的独立宣言。","symbolSize":35,"category":"黄金时代"},{"name":"马克·吐温","des":"密西西比河畔的少年美国：汤姆与哈克之父。","symbolSize":40,"category":"黄金时代"},{"name":"《小妇人》","des":"1868：四姐妹的成长，家庭小说的温度。","symbolSize":30,"category":"黄金时代"},{"name":"《金银岛》","des":"1883：少年冒险小说的航海罗盘。","symbolSize":30,"category":"黄金时代"},{"name":"安徒生","des":"「写给孩子的」作家童话开创者（民间童话层见「童话体系」图谱）。","symbolSize":40,"category":"黄金时代"},{"name":"《绿野仙踪》","des":"1900：美国自有童话的翡翠城。","symbolSize":35,"category":"世纪转折"},{"name":"《彼得·潘》","des":"1904 舞台剧与 1911 小说：永无乡与拒绝长大。","symbolSize":35,"category":"世纪转折"},{"name":"《柳林风声》","des":"1908：泰晤士河畔四兽的田园牧歌。","symbolSize":30,"category":"世纪转折"},{"name":"《小熊维尼》","des":"1926：百亩森林的英伦温情。","symbolSize":30,"category":"世纪转折"},{"name":"A.A.米尔恩","des":"以儿子克里斯托弗·罗宾与玩具为原型的父亲作者。","symbolSize":25,"category":"世纪转折"},{"name":"比阿特丽克斯·波特","des":"1902《彼得兔的故事》：自费出版的绘本革命起点。","symbolSize":45,"category":"绘本革命"},{"name":"彼得兔","des":"蓝外套的麦格雷戈园小兔：小开本图文一体。","symbolSize":30,"category":"绘本革命"},{"name":"伦道夫·凯迪克","des":"维多利亚插画大家，凯迪克奖以其命名。","symbolSize":25,"category":"绘本革命"},{"name":"苏斯博士","des":"有限词汇的节奏狂欢：《戴帽子的猫》重塑识字启蒙。","symbolSize":40,"category":"绘本革命"},{"name":"《好饿的毛毛虫》","des":"艾瑞·卡尔 1969：拼贴与洞洞书的经典。","symbolSize":30,"category":"绘本革命"},{"name":"《野兽国》","des":"桑达克 1963：承认孩子有愤怒的图画书里程碑。","symbolSize":35,"category":"绘本革命"},{"name":"莫里斯·桑达克","des":"「孩子知道的一切我都画」：绘本的心理深度。","symbolSize":40,"category":"绘本革命"},{"name":"《小王子》","des":"1943：飞行员写给大人的孩子书，全球译本三百余种。","symbolSize":45,"category":"国际童书时代"},{"name":"圣埃克苏佩里","des":"飞行员作家：沙漠、玫瑰与 B-612。","symbolSize":35,"category":"国际童书时代"},{"name":"长袜子皮皮","des":"1945：力大无穷的叛逆女孩，解放儿童的天性宣言。","symbolSize":35,"category":"国际童书时代"},{"name":"阿斯特丽德·林格伦","des":"瑞典童书女王：皮皮与吵闹村。","symbolSize":45,"category":"国际童书时代"},{"name":"《夏洛的网》","des":"1952：蜘蛛与猪的友谊，怀特的田园挽歌。","symbolSize":35,"category":"国际童书时代"},{"name":"E.B.怀特","des":"《精灵鼠小弟》与《天鹅喇叭》：散文家写童话。","symbolSize":30,"category":"国际童书时代"},{"name":"托芙·扬松","des":"姆明谷：北欧哲学的童话乌托邦。","symbolSize":30,"category":"国际童书时代"},{"name":"国际安徒生奖","des":"1956 年设立的「小诺贝尔奖」：作家与插画家双轨。","symbolSize":35,"category":"国际童书时代"},{"name":"《纳尼亚传奇》","des":"1950-56 七部曲：狮子、女巫与魔衣橱的英国童年。","symbolSize":35,"category":"国际童书时代"},{"name":"叶圣陶","des":"1923《稻草人》：中国现代童话的开端。","symbolSize":35,"category":"中国儿童文学"},{"name":"《稻草人》","des":"「给中国的童话开了一条自己创作的路」。","symbolSize":30,"category":"中国儿童文学"},{"name":"张天翼","des":"《宝葫芦的秘密》与《大林和小林》：讽刺童话。","symbolSize":30,"category":"中国儿童文学"},{"name":"郑渊洁","des":"皮皮鲁与鲁西西：一个人撑起的《童话大王》月刊。","symbolSize":35,"category":"中国儿童文学"},{"name":"曹文轩","des":"《草房子》：国际安徒生奖首位中国得主。","symbolSize":30,"category":"中国儿童文学"},{"name":"纽伯瑞奖","des":"1922 年美国图书馆协会奖：儿童文学年度风向标。","symbolSize":35,"category":"奖项与产业"},{"name":"凯迪克奖","des":"1938 年起：美国绘本的最高荣誉。","symbolSize":30,"category":"奖项与产业"},{"name":"YA 青少年文学","des":"从《巧克力战争》到《暮光之城》：介于童书与成人之间的板块。","symbolSize":35,"category":"奖项与产业"},{"name":"哈利·波特现象","des":"1997 年起的全球阅读事件（深入见「哈利波特魔法体系」图谱）。","symbolSize":30,"category":"奖项与产业"},{"name":"绘本教育运动","des":"从伦敦到东京：以图画书重构早期教育的跨世纪运动。","symbolSize":30,"category":"奖项与产业"}],"links":[{"source":"儿童文学","target":"《世界图解》","name":"先声","des":"首本为儿童编的插图教科书。"},{"source":"儿童文学","target":"纽伯瑞","name":"起点","des":"1744 年商业化儿童出版的开端。"},{"source":"儿童文学","target":"爱丽丝·梦游仙境","name":"分水岭","des":"从教化走向本位的游乐。"},{"source":"儿童文学","target":"比阿特丽克斯·波特","name":"绘本","des":"图画书革命的起点。"},{"source":"儿童文学","target":"国际安徒生奖","name":"体系","des":"全球童书的最高荣誉制度。"},{"source":"儿童文学","target":"叶圣陶","name":"中国开端","des":"1923 年的原创童话起点。"},{"source":"伊索寓言的儿童化","target":"纽伯瑞","