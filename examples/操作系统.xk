{"version":2,"nodes":[{"name":"操作系统","des":"管理处理器、内存与设备并为应用提供抽象的常驻软件：硬件之上、应用之下的隐形王座。","symbolSize":70,"category":"内核总论"},{"name":"内核态与用户态","des":"特权级隔离的基本盘：应用碰硬件必须先过系统调用这道安检。","symbolSize":50,"category":"内核总论"},{"name":"系统调用","des":"用户态进入内核的唯一正门，从 read 到 fork 的官设通道。","symbolSize":50,"category":"内核总论"},{"name":"中断与异常","des":"硬件打断 CPU 的两种方式：设备事件与指令故障，内核夺回控制权的抓手。","symbolSize":50,"category":"内核总论"},{"name":"中断处理","des":"上半部急事快办、下半部慢慢收尾，延迟与吞吐的平衡术。","symbolSize":40,"category":"内核总论"},{"name":"时钟与定时器","des":"周期性心跳，调度与超时的总计时员。","symbolSize":40,"category":"内核总论"},{"name":"宏内核","des":"一切塞进一个大内核：性能好、崩溃重，Linux 的选择。","symbolSize":40,"category":"内核总论"},{"name":"微内核","des":"内核只留 IPC 与调度，其余搬去用户态：用性能换可靠，seL4 的洁癖。","symbolSize":40,"category":"内核总论"},{"name":"虚拟机管理程序","des":"在操作系统之下再造一层，把硬件分给多个系统。","symbolSize":40,"category":"内核总论"},{"name":"容器","des":"共享内核的进程级隔离，namespace 加 cgroups 的轻量打包。","symbolSize":40,"category":"内核总论"},{"name":"引导过程","des":"从固件到 bootloader 再到内核解压：开机黑屏背后的接力。","symbolSize":40,"category":"内核总论"},{"name":"进程","des":"资源分配的基本单位：地址空间、句柄与执行现场的捆绑包。","symbolSize":50,"category":"进程与调度"},{"name":"线程","des":"CPU 调度的基本单位，同进程线程共享地址空间各带栈。","symbolSize":50,"category":"进程与调度"},{"name":"进程控制块","des":"内核记账的户口本：状态、寄存器现场与资源清单。","symbolSize":40,"category":"进程与调度"},{"name":"fork与exec","des":"Unix 的生育哲学：复制自己再替换成新程序，组合出一切进程树。","symbolSize":50,"category":"进程与调度"},{"name":"上下文切换","des":"保存旧现场、载入新现场，多任务的心跳代价。","symbolSize":40,"category":"进程与调度"},{"name":"调度器","des":"决定谁下一个上 CPU 的裁判，公平、实时与响应的调和者。","symbolSize":50,"category":"进程与调度"},{"name":"时间片轮转","des":"人人有份的回合制，分时系统的祖传方案。","symbolSize":40,"category":"进程与调度"},{"name":"优先级调度","des":"重要的先跑、平凡的等着，优先级反转是暗礁。","symbolSize":40,"category":"进程与调度"},{"name":"CFS","des":"完全公平调度器：红黑树按虚拟运行时间排队，Linux 主力十余年。","symbolSize":40,"category":"进程与调度"},{"name":"多级反馈队列","des":"按行为动态升降级的队列组，交互与批处理的和事佬。","symbolSize":40,"category":"进程与调度"},{"name":"进程间通信","des":"管道、消息队列与共享内存：进程围墙上的传话窗口。","symbolSize":50,"category":"进程与调度"},{"name":"信号","des":"内核对进程的异步插话，Ctrl+C 就是 SIGINT。","symbolSize":40,"category":"进程与调度"},{"name":"僵尸与孤儿进程","des":"没被收尸的已死进程，父进程的 wait 义务。","symbolSize":40,"category":"进程与调度"},{"name":"协程","des":"用户态的轻量线程，让步式切换免去了内核仲裁。","symbolSize":40,"category":"进程与调度"},{"name":"并发与并行","des":"交错执行与同时执行之分，多核时代并发不再等于假并行。","symbolSize":50,"category":"并发与同步"},{"name":"竞态条件","des":"结果取决于时序的 bug 温床，检查与使用的间隙就是命门。","symbolSize":50,"category":"并发与同步"},{"name":"临界区","des":"一次只许一个执行流进入的代码段，互斥的靶心。","symbolSize":40,"category":"并发与同步"},{"name":"互斥锁","des":"进门上锁的朴素方案，忘了开锁就是死锁剧本第一幕。","symbolSize":50,"category":"并发与同步"},{"name":"信号量","des":"Dijkstra 的 P/V 计数器，互斥与同步通吃的荷兰原产器件。","symbolSize":50,"category":"并发与同步"},{"name":"死锁","des":"互持资源互不相让的僵局：四个必要条件缺一可破。","symbolSize":50,"category":"并发与同步"},{"name":"条件变量","des":"等条件成立再走的等待室，配合互斥锁使用。","symbolSize":40,"category":"并发与同步"},{"name":"读写锁","des":"读共享写独占，多读少写场景的提速阀。","symbolSize":40,"category":"并发与同步"},{"name":"原子操作","des":"不可分割的硬件级原语，CAS 是无锁结构的基石。","symbolSize":40,"category":"并发与同步"},{"name":"内存序","des":"编译器与 CPU 重排指令的自由度，多核正确性的暗坑。","symbolSize":40,"category":"并发与同步"},{"name":"生产者消费者","des":"缓冲区前的一对经典搭档，同步原语的入门考题。","symbolSize":40,"category":"并发与同步"},{"name":"虚拟内存","des":"给每个进程一整片假想的独占内存，隔离与超额分配的世纪发明。","symbolSize":70,"category":"内存管理"},{"name":"分页","des":"内存切成固定页帧，页表把虚拟页翻译到物理帧。","symbolSize":50,"category":"内存管理"},{"name":"页表与多级页表","des":"一层不够叠四层，稀疏地址空间省内存的套娃。","symbolSize":40,"category":"内存管理"},{"name":"TLB","des":"页表翻译的硬件缓存，命中率决定内存子系统的体感。","symbolSize":50,"category":"内存管理"},{"name":"缺页中断","des":"访问不在内存的页时陷入内核，按需调页的发动机。","symbolSize":40,"category":"内存管理"},{"name":"按需调页","des":"用到才装载，程序的冷热页被自动分层。","symbolSize":40,"category":"内存管理"},{"name":"页面置换","des":"内存告急时选谁出局：LRU、时钟算法与工作集的取舍。","symbolSize":50,"category":"内存管理"},{"name":"抖动","des":"缺页率飙升、CPU 忙于换页的瘫痪现场。","symbolSize":40,"category":"内存管理"},{"name":"写时复制","des":"fork 后父子共享物理页，动笔才复制：复制的最高境界是不复制。","symbolSize":40,"category":"内存管理"},{"name":"内存映射","des":"mmap 把文件当数组访问，页缓存与用户空间的直通桥。","symbolSize":40,"category":"内存管理"},{"name":"伙伴系统与slab","des":"内核的两级账房：伙伴系统防碎片，slab 热对象复用。","symbolSize":40,"category":"内存管理"},{"name":"内存分配器","des":"malloc 背后的竞技场：空闲链表、大小分类与碎片治理。","symbolSize":40,"category":"内存管理"},{"name":"交换空间","des":"磁盘做的溢出内存，喘口气与病入膏肓之间。","symbolSize":40,"category":"内存管理"},{"name":"文件","des":"字节流的命名持久化，一切应用的共同语言。","symbolSize":50,"category":"文件系统"},{"name":"inode","des":"文件的身份证：权限、大小与数据块指针；目录只是名字到编号的账本。","symbolSize":50,"category":"文件系统"},{"name":"目录树","des":"单根斜杠开始的命名空间，挂载点让多设备拼成一棵树。","symbolSize":40,"category":"文件系统"},{"name":"虚拟文件系统","des":"内核给一切文件系统立的统一接口，让 proc 与 ext4 同框。","symbolSize":50,"category":"文件系统"},{"name":"日志文件系统","des":"先写日志再改数据，断电崩溃后的快速自愈术。","symbolSize":40,"category":"文件系统"},{"name":"ext家族","des":"Linux 土生土长的主力，从 ext2 到 ext4 的稳扎稳打。","symbolSize":40,"category":"文件系统"},{"name":"NTFS","des":"Windows 的看家文件系统，日志、权限与流一应俱全。","symbolSize":40,"category":"文件系统"},{"name":"FAT","des":"软盘时代的活化石，简单到所有设备都能读懂的通用语。","symbolSize":40,"category":"文件系统"},{"name":"Btrfs与ZFS","des":"写时复制的新一代：快照、校验与池化存储。","symbolSize":40,"category":"文件系统"},{"name":"页缓存","des":"空闲内存拿来缓存文件，读快写懒的全能缓冲池。","symbolSize":40,"category":"文件系统"},{"name":"持久化语义","des":"fsync 何时落盘何时算数，掉电承诺的边界。","symbolSize":40,"category":"文件系统"},{"name":"设备驱动","des":"内核对每种硬件的适配器层，内核崩溃的常驻嫌疑人。","symbolSize":50,"category":"I/O与设备"},{"name":"块设备与字符设备","des":"按块随机访问的磁盘与按流顺序读的终端，两大设备门派。","symbolSize":40,"category":"I/O与设备"},{"name":"DMA","des":"设备与内存直通的数据搬运工，解放 CPU 的外挂双手。","symbolSize":40,"category":"I/O与设备"},{"name":"I/O调度","des":"磁盘请求的排队重排，电梯算法与 SSD 时代的退化。","symbolSize":40,"category":"I/O与设备"},{"name":"中断与轮询","des":"设备通知 CPU 的两种脾气：主动报告与反复张望。","symbolSize":40,"category":"I/O与设备"},{"name":"select与epoll","des":"海量连接的事件守望者，C10K 问题的分水岭。","symbolSize":40,"category":"I/O与设备"},{"name":"RAID","des":"多盘组队的冗余阵列，容量、性能与可靠性的排列组合。","symbolSize":40,"category":"I/O与设备"},{"name":"网络协议栈","des":"内核里的 TCP/IP 实现，另一套环环相扣的状态机。","symbolSize":40,"category":"I/O与设备"},{"name":"Multics","des":"通用时分系统的宏大乌托邦，复杂到难产，却是 Unix 的反面教材。","symbolSize":40,"category":"Unix谱系"},{"name":"Unix","des":"汤普逊与里奇 1969 年的“简化版 Multics”：小而美的工具哲学自此开宗立派。","symbolSize":70,"category":"Unix谱系"},{"name":"C语言","des":"里奇为重写 Unix 造的语言，可移植性的火炬自此点燃。","symbolSize":50,"category":"Unix谱系"},{"name":"肯·汤普逊","des":"Unix 与 B 语言作者，后来的 UTF-8 与 Go 的共同发明人。","symbolSize":40,"category":"Unix谱系"},{"name":"丹尼斯·里奇","des":"C 语言之父，Unix 共同作者，“K&R”的 R。","symbolSize":40,"category":"Unix谱系"},{"name":"BSD","des":"伯克利的 Unix 分支：TCP/IP、vi 与 sockets 的大本营。","symbolSize":50,"category":"Unix谱系"},{"name":"System V","des":"AT&T 的商用主线，与 BSD 展开十年的正统之争。","symbolSize":40,"category":"Unix谱系"},{"name":"POSIX","des":"可移植操作系统接口标准，让“Unix 血统”变成一张可考的证书。","symbolSize":50,"category":"Unix谱系"},{"name":"GNU计划","des":"斯托曼 1983 年发起的自由软件复刻：工具链集齐，只欠内核。","symbolSize":50,"category":"Unix谱系"},{"name":"Linux","des":"托瓦兹 1991 年的业余内核，借 GNU 工具与 GPL 一举补全自由操作系统。","symbolSize":70,"category":"Unix谱系"},{"name":"林纳斯·托瓦兹","des":"Linux 与 Git 的作者，互联网时代最著名的芬兰程序员。","symbolSize":40,"category":"Unix谱系"},{"name":"GPL许可","des":"传染性自由：Linux 内核生态的法律底色。","symbolSize":40,"category":"Unix谱系"},{"name":"GNU Hurd","des":"微内核路线的迟到大作，二十余年仍未毕业的理想主义。","symbolSize":40,"category":"Unix谱系"},{"name":"Minix","des":"塔能鲍姆的教学小系统，启发了 Linux，也吵过著名的架。","symbolSize":40,"category":"Unix谱系"},{"name":"macOS与Darwin","des":"NeXTSTEP 遗风加 BSD 内核：苹果的 Unix 血统证明书。","symbolSize":40,"category":"Unix谱系"},{"name":"Android","des":"Linux 内核之上的移动帝国，按用户量计最大的操作系统分支。","symbolSize":40,"category":"Unix谱系"},{"name":"服务器与云","des":"Linux 一统数据中心与容器生态，看不见的地方皆是企鹅。","symbolSize":40,"category":"Unix谱系"},{"name":"Windows NT","des":"与 Unix 无血缘的另一条主线：混合内核与兼容性的商业奇迹。","symbolSize":40,"category":"Unix谱系"},{"name":"实时系统","des":"截止期限就是法律的系统：迟到等于失败，比如刹车与飞控。","symbolSize":50,"category":"嵌入式与实时"},{"name":"硬实时与软实时","des":"错过期限是否灾难，两种契约的分别。","symbolSize":40,"category":"嵌入式与实时"},{"name":"PREEMPT_RT","des":"给 Linux 内核打实时补丁的工程路径。","symbolSize":40,"category":"嵌入式与实时"},{"name":"FreeRTOS","des":"单片机世界的轻量实时之王，几 KB 内存就能跑。","symbolSize":40,"category":"嵌入式与实时"},{"name":"VxWorks","des":"航天与军工的老牌 RTOS，火星车上跑的就是它。","symbolSize":40,"category":"嵌入式与实时"},{"name":"嵌入式系统","des":"藏在家电、汽车与玩具里的隐形计算机，按数量计的主流形态。","symbolSize":40,"category":"嵌入式与实时"}],"links":[{"source":"操作系统","target":"系统调用","name":"正门","des":"用户态与内核态之间唯一的官道。"},{"source":"操作系统","target":"进程","name":"基本单位","des":"一切调度与资源故事的起点。"},{"source":"操作系统","target":"虚拟内存","name":"世纪发明","des":"隔离与超额分配的基石。"},{"source":"操作系统","target":"Unix","name":"精神源头","des":"现代操作系统的文化共同祖先。"},{"source":"操作系统","target":"文件","name":"共同语言","des":"字节流的持久化抽象。"},{"source":"内核态与用户态","target":"系统调用","name":"守出","des":"特权边界的存在才需要这道门。"},{"source":"系统调用","target":"中断与异常","name":"搭桥于","des":"陷入指令是过门的机制底座。"},{"source":"中断与异常","target":"中断处理","name":"展开为","des":"事件到来后的分诊流程。"},{"source":"时钟与定时器","target":"调度器","name":"打着拍子","des":"没有周期时钟就没有抢占调度。"},{"source":"宏内核","target":"微内核","name":"对照","des":"性能与可靠性的路线之争。"},{"source":"宏内核","target":"Linux","name":"成就于","des":"单内核设计跑赢了大多数对手。"},{"source":"微内核","target":"GNU Hurd","name":"困于","des":"微内核理想主义的最长注脚。"},{"source":"虚拟机管理程序","target":"容器","name":"对照","des":"硬件级隔离与进程级隔离的轻重之别。"},{"source":"容器","target":"Linux","name":"长在","des":"namespace 与 cgroups 皆出自 Linux 内核。"},{"source":"引导过程","target":"操作系统","name":"接生出","des":"固件接力 bootloader 才有内核登台。"},{"source":"进程","target":"线程","name":"分出","des":"执行流从资源包里解绑出来。"},{"source":"进程","target":"进程控制块","name":"记账于","des":"户口本跟着进程一生。"},{"source":"fork与exec","target":"进程","name":"生育","des":"复制再替换，进程树由此展开。"},{"source":"fork与exec","target":"写时复制","name":"省下","des":"父子共享物理页，复制被推迟到动笔。"},{"source":"上下文切换","target":"调度器","name":"执行","des":"换谁上场是裁判的事，怎么换是它的活。"},{"source":"时间片轮转","target":"调度器","name":"属于","des":"最古老的公平方案。"},{"source":"优先级调度","target":"调度器","name":"属于","des":"重要者优先的另一极。"},{"source":"多级反馈队列","target":"调度器","name":"属于","des":"动态升降级的调和方案。"},{"source":"CFS","target":"调度器","name":"实现为","des":"Linux 对公平性的红黑树答卷。"},{"source":"进程间通信","target":"信号","name":"并列","des":"同步传话与异步插话两条路。"},{"source":"进程间通信","target":"并发与并行","name":"服务于","des":"多进程协作的第一课。"},{"source":"僵尸与孤儿进程","target":"fork与exec","name":"副产品","des":"父进程不 wait 