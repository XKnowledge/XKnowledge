{"version":2,"title":"金工与首饰工艺","description":"把贵金属敲成薄如蝉翼的穹顶、拉成发丝般的金丝：范铸与失蜡的分流、錾刻与锤鍱的对话、花丝与珐琅的极致——从司母戊鼎到法贝热彩蛋，人类装饰自己的历史就是一部微型冶金史。","nodes":[{"name":"金工与首饰工艺","des":"以金、银、铜等金属制作器物与饰件的技艺总称：成形、连接、装饰三大工序体系，横跨礼器、首饰、佛造像与日常器用的庞大匠作世界。","symbolSize":70,"category":"金属成形"},{"name":"锻打成形","des":"退火锤打、从碟到罐的渐次成形（raising），一件银壶几十万锤的耐心工程。","symbolSize":50,"category":"金属成形"},{"name":"退火","des":"加热让加工硬化的金属恢复塑性，打一段烧一次，软硬之间的呼吸节奏。","symbolSize":40,"category":"金属成形"},{"name":"锤鍱与敲花","des":"从背面敲出凸起浮雕的 repoussé 与正面修整的 chasing，中国称锤鍱，唐代金银器的当家语言。","symbolSize":50,"category":"金属成形"},{"name":"錾刻","des":"以数百种錾子在金属表面刻线剔地，纹样的工笔系统，金工的 signature 笔触。","symbolSize":50,"category":"金属成形"},{"name":"范铸法","des":"以陶范泥范浇铸成形的青铜时代核心技术，块范合模的古代流水线。","symbolSize":50,"category":"铸造谱系"},{"name":"后母戊鼎","des":"商代 832 公斤的青铜巨鼎，多块陶范合铸的组织工程奇迹。","symbolSize":40,"category":"铸造谱系"},{"name":"失蜡法","des":"以蜡模覆耐火壳、熔蜡浇铸的一次性精密铸造，战国已见，曾侯乙尊盘的繁复无可复制。","symbolSize":50,"category":"铸造谱系"},{"name":"曾侯乙尊盘","des":"战国早期青铜器镂空附件的巅峰，蟠虺缠绕的透空工艺被认定出于失蜡法。","symbolSize":40,"category":"铸造谱系"},{"name":"翻砂铸造","des":"以砂型成形的近代铸造法，从农机件到廉价首饰的工业化路径。","symbolSize":40,"category":"铸造谱系"},{"name":"石膏型铸造","des":"首饰行业标准失蜡工艺：石膏模真空抽气浇铸，一件蜡树出几十件铸件。","symbolSize":40,"category":"铸造谱系"},{"name":"离心铸造","des":"离心力把金属液甩进石膏模细部的设备，细如发丝的花丝头也铸得出来。","symbolSize":40,"category":"铸造谱系"},{"name":"金焊药","des":"低于母材熔点的合金焊料，金银焊各有配方，多焊多次的分段保险。","symbolSize":40,"category":"连接工艺"},{"name":"大焊与小焊","des":"中国传统金工对硬焊软焊的分称，《天工开物》里的温度管理智慧。","symbolSize":40,"category":"连接工艺"},{"name":"错金银","des":"在青铜槽内锤嵌金银丝片的战国绝技，金银错的富丽让铭文变成装饰。","symbolSize":50,"category":"连接工艺"},{"name":"鎏金","des":"金汞齐涂抹加热驱汞的火镀金工艺，青铜器与佛像的千年金身秘方，也是匠人的慢性毒药。","symbolSize":50,"category":"连接工艺"},{"name":"包金与镀金","des":"机械包裹与电化学沉积的两种贴金路线，古今价值的分层术。","symbolSize":40,"category":"连接工艺"},{"name":"掐丝珐琅","des":"以铜丝掐出轮廓填釉烧制的景泰蓝工艺，元代传入、景泰年间得名的宫廷绝技。","symbolSize":50,"category":"珐琅体系"},{"name":"錾胎珐琅","des":"在錾刻凹坑内填釉的工艺，浮雕与釉色共舞的欧洲中世纪主流。","symbolSize":40,"category":"珐琅体系"},{"name":"画珐琅","des":"以釉料手绘再烧的珐琅绘画，康熙朝从欧洲传入的宫廷新宠。","symbolSize":40,"category":"珐琅体系"},{"name":"透明珐琅","des":"无底透明的窗式珐琅 plique-à-jour，烧完后像微型彩色玻璃，新艺术珠宝的挚爱。","symbolSize":40,"category":"珐琅体系"},{"name":"内填珐琅","des":"在雕刻或金属起的格线内填釉，champlevé 的西方中世纪正字法。","symbolSize":40,"category":"珐琅体系"},{"name":"利马珐琅","des":"以金线替代铜丝的纤细掐丝变体，无底线焊接的高难度炫技。","symbolSize":40,"category":"珐琅体系"},{"name":"烧蓝","des":"银饰点蓝烧制的民间说法，中国传统银楼的主力装饰工艺。","symbolSize":40,"category":"珐琅体系"},{"name":"景泰蓝","des":"掐丝珐琅的中国名号，景泰蓝点蓝烧蓝磨光镀金五大工序，燕京八绝之首。","symbolSize":50,"category":"珐琅体系"},{"name":"燕京八绝","des":"景泰蓝、玉雕、牙雕、雕漆、金漆镶嵌、花丝镶嵌、宫毯、京绣的合称，清宫造办处手艺的当代名录。","symbolSize":40,"category":"花丝与细金"},{"name":"花丝镶嵌","des":"以金银拉丝掐纹垒丝焊形的细金工艺，加上镶嵌珠玉的完整体系，中国宫廷珠宝的巅峰。","symbolSize":50,"category":"花丝与细金"},{"name":"拉丝","des":"金银通过孔径递减的丝模拉成发丝，几十次退火的耐心是花丝的地基。","symbolSize":40,"category":"花丝与细金"},{"name":"累丝","des":"把细丝搓绞编织成纹样的技法，一件凤冠用丝数千米。","symbolSize":40,"category":"花丝与细金"},{"name":"金银错与织物纹","des":"花丝中借鉴纺织的编织、辫股、网状结构，金属做的纺织品。","symbolSize":40,"category":"花丝与细金"},{"name":"明定陵凤冠","des":"万历孝端皇后的九龙九凤冠，花丝、点翠、珍珠宝石的集大成实物。","symbolSize":40,"category":"花丝与细金"},{"name":"点翠","des":"以翠鸟羽贴饰的增色工艺，禁采后以烧蓝与丝带替代的伦理转型样本。","symbolSize":40,"category":"花丝与细金"},{"name":"镶嵌工艺","des":"爪镶、包镶、轨道镶、密钉镶的宝石固定体系，光学与力学的合谋。","symbolSize":40,"category":"花丝与细金"},{"name":"何家村窖藏","des":"西安出土的唐代金银器宝库，鸳鸯莲瓣纹金碗与鎏金舞马衔杯壶的盛世证词。","symbolSize":40,"category":"器物谱系"},{"name":"唐代金银器","des":"锤鍱錾刻加掐丝的唐代宫廷金器体系，多曲长杯里萨珊波斯的倒影。","symbolSize":50,"category":"器物谱系"},{"name":"清宫造办处","des":"康熙朝设立的内廷作坊群，如意馆与金玉作汇聚全国名匠的皇家工场。","symbolSize":40,"category":"器物谱系"},{"name":"银楼业","des":"明清民间的银饰产业，老凤祥、庆云楼式的字号体系与婚嫁银的民俗谱系。","symbolSize":40,"category":"器物谱系"},{"name":"法贝热","des":"俄国宫廷珠宝匠的彩蛋系列，1885 至 1917 年的五十余枚帝国彩蛋，金工机械与惊喜的极限。","symbolSize":50,"category":"西方大师"},{"name":"切利尼","des":"文艺复兴金匠本韦努托·切利尼，《切利尼自传》与盐罐都是金工的传奇双证。","symbolSize":40,"category":"西方大师"},{"name":"新艺术珠宝","des":"拉利克与加莱姆以玻璃、珐琅、异形珍珠对抗钻石正统的运动，珠宝从资产回归艺术。","symbolSize":40,"category":"西方大师"},{"name":"卡地亚","des":"从水果锦囊风格的东方情调到豹形系列的现代体系，珠宝大行的风格史。","symbolSize":40,"category":"西方大师"},{"name":"蒂芙尼与六爪镶","des":"1886 年蒂芙尼六爪镶嵌把钻石托起进光，订婚戒指的现代标准像。","symbolSize":40,"category":"西方大师"},{"name":"首饰锯","des":"以细锯条镂割金属板的 jeweler's saw，镂空与锯样的第一工具。","symbolSize":40,"category":"工具与行当"},{"name":"胶板与抬凿","des":"以沥青胶板承托工件錾刻的工位系统，敲花抬凿的稳定后方。","symbolSize":40,"category":"工具与行当"},{"name":"玛瑙压子","des":"以玛瑙头抛压金属表面出镜面光的 burnisher，不用砂纸的最后高光。","symbolSize":40,"category":"工具与行当"},{"name":"金相与火色","des":"看火色判温度的古老技能，金银匠的眼睛就是热电偶。","symbolSize":40,"category":"工具与行当"},{"name":"非遗传承","des":"花丝镶嵌与景泰蓝的国家级非遗名录与大师工作室制度，宫廷手艺的市场化求生。","symbolSize":40,"category":"工具与行当"},{"name":"当代金工工作室","des":"院校金工专业与独立工作室的兴起，手作首饰从行会秘技变个人表达的媒介。","symbolSize":40,"category":"工具与行当"}],"links":[{"source":"金工与首饰工艺","target":"锻打成形","name":"成形主线","des":"一锤一锤从片到器。"},{"source":"金工与首饰工艺","target":"失蜡法","name":"成形支线","des":"蜡模翻铸的精密路线。"},{"source":"金工与首饰工艺","target":"錾刻","name":"装饰主线","des":"表面纹样的工笔语言。"},{"source":"金工与首饰工艺","target":"花丝镶嵌","name":"极致","des":"细金工艺的宫廷巅峰。"},{"source":"金工与首饰工艺","target":"掐丝珐琅","name":"上色","des":"以釉为彩的金属绘画。"},{"source":"锻打成形","target":"退火","name":"伴随","des":"打硬了就烧软再来。"},{"source":"锻打成形","target":"锤鍱与敲花","name":"分支","des":"从器形锤打到浮雕锤鍱。"},{"source":"锤鍱与敲花","target":"唐代金银器","name":"成就","des":"唐金碗的纹样全是锤鍱底子。"},{"source":"錾刻","target":"锤鍱与敲花","name":"前后工序","des":"背敲成形再正面錾修。"},{"source":"錾刻","target":"錾胎珐琅","name":"服务","des":"錾出的凹坑正是填釉的隔间。"},{"source":"范铸法","target":"后母戊鼎","name":"代表作","des":"多范合铸的重量级实证。"},{"source":"失蜡法","target":"曾侯乙尊盘","name":"代表作","des":"透空附饰被公认失蜡所出。"},{"source":"范铸法","target":"失蜡法","name":"并存","des":"块范与熔模两条铸造主线并行。"},{"source":"失蜡法","target":"石膏型铸造","name":"现代化","des":"蜡模思路升级为首饰工业标准。"},{"source":"石膏型铸造","target":"离心铸造","name":"配合","des":"离心力把金属送进最细的枝杈。"},{"source":"范铸法","target":"翻砂铸造","name":"平民化","des":"砂型成为工业时代的日用铸造。"},{"source":"金焊药","target":"大焊与小焊","name":"古今对译","des":"同一温度智慧的中西讲法。"},{"source":"金焊药","target":"花丝镶嵌","name":"必需","des":"千百个焊点全靠焊药接力。"},{"source":"错金银","target":"曾侯乙尊盘","name":"同期高峰","des":"战国金属装饰的两大绝技。"},{"source":"鎏金","target":"唐代金银器","name":"应用","des":"鎏金舞马衔杯壶的盛世金光。"},{"source":"鎏金","target":"包金与镀金","name":"谱系","des":"贴金三代的进化路线。"},{"source":"掐丝珐琅","target":"景泰蓝","name":"即","des":"掐丝珐琅的中国名与代。"},{"source":"錾胎珐琅","target":"内填珐琅","name":"同义","des":"中西命名的同一种工艺。"},{"source":"画珐琅","target":"清宫造办处","name":"落地","des":"康熙朝画珐琅作设于造办处。"},{"source":"透明珐琅","target":"新艺术珠宝","name":"被宠爱","des":"窗式珐琅正合新艺术的植物气质。"},{"source":"利马珐琅","target":"掐丝珐琅","name":"变体","des":"金丝无底的更高难度动作。"},{"source":"烧蓝","target":"掐丝珐琅","name":"民间叫法","des":"银楼体系对点蓝烧制的通称。"},{"source":"景泰蓝","target":"燕京八绝","name":"列于","des":"八绝之首的名分。"},{"source":"花丝镶嵌","target":"燕京八绝","name":"列于","des":"细金工艺的当代名录。"},{"source":"拉丝","target":"累丝","name":"供料","des":"发丝般的丝是编织的原料。"},{"source":"累丝","target":"明定陵凤冠","name":"集大成","des":"凤冠是花丝点翠的巅峰合成。"},{"source":"金银错与织物纹","target":"累丝","name":"同族","des":"编织逻辑贯穿花丝体系。"},{"source":"点翠","target":"明定陵凤冠","name":"同框","des":"翠羽与金丝在冠上相会。"},{"source":"镶嵌工艺","target":"花丝镶嵌","name":"合体","des":"镶嵌与花丝合称一套体系。"},{"source":"镶嵌工艺","target":"蒂芙尼与六爪镶","name":"现代经典","des":"六爪托起钻石的光学工程。"},{"source":"唐代金银器","target":"何家村窖藏","name":"实证","des":"窖藏金银器是唐代工艺的标尺。"},{"source":"清宫造办处","target":"景泰蓝","name":"主产","des":"造办处珐琅作的宫廷出品。"},{"source":"清宫造办处","target":"花丝镶嵌","name":"主产","des":"金玉作的花丝头面成套传世。"},{"source":"银楼业","target":"烧蓝","name":"主力工艺","des":"民间银饰以烧蓝点彩。"},{"source":"法贝热","target":"錾刻","name":"综合","des":"彩蛋集錾刻珐琅机械于一身。"},{"source":"法贝热","target":"透明珐琅","name":"擅用","des":"彩蛋上常见窗式珐琅的透光。"},{"source":"切利尼","target":"錾刻","name":"大师之手","des":"自传里吹嘘的錾工绝技。"},{"source":"新艺术珠宝","target":"透明珐琅","name":"标志工艺","des":"窗珐琅与新艺术互为标签。"},{"source":"卡地亚","target":"镶嵌工艺","name":"系统化","des":"大行的镶嵌车间定义现代标准。"},{"source":"首饰锯","target":"錾刻","name":"分工","des":"锯镂外形、錾做表面。"},{"source":"胶板与抬凿","target":"錾刻","name":"工位","des":"胶板承托让錾刻稳如手术。"},{"source":"玛瑙压子","target":"锻打成形","name":"收光","des":"锤痕最后被玛瑙压平。"},{"source":"金相与火色","target":"退火","name":"判据","des":"看火色决定何时回炉。"},{"source":"金相与火色","target":"鎏金","name":"关键","des":"驱汞温度全凭火色拿捏。"},{"source":"非遗传承","target":"花丝镶嵌","name":"保护","des":"国家级名录续上宫廷细金一脉。"},{"source":"非遗传承","target":"景泰蓝","name":"保护","des":"大师工作室制度维持五大工序。"},{"source":"当代金工工作室","target":"首饰锯","name":"标配","des":"独立工作室从一张锯桌开始。"},{"source":"当代金工工作室","target":"錾胎珐琅","name":"复振","des":"院校把欧洲珐琅技法带回课堂。"},{"source":"花丝镶嵌","target":"累丝","name":"主力工艺","des":"拉丝掐纹垒丝焊形，「花丝」之名由此而来。"}]}