补原理","target":"波粒二象性","name":"诠释","des":"两种面相互斥又互补，实验只能显影其一。"},{"source":"玻尔","target":"哥本哈根诠释","name":"铸就","des":"与海森堡共执正统牛耳三十年。"},{"source":"互补原理","target":"哥本哈根诠释","name":"构成","des":"认识论的核心条款。"},{"source":"概率诠释","target":"哥本哈根诠释","name":"构成","des":"概率语言的正典化。"},{"source":"不确定性原理","target":"哥本哈根诠释","name":"构成","des":"测量的边界即诠释的边界。"},{"source":"波函数坍缩","target":"哥本哈根诠释","name":"属于","des":"正统体系中最富争议的一环。"},{"source":"薛定谔的猫","target":"哥本哈根诠释","name":"诘问","des":"宏观叠加的荒诞感直指诠释软肋。"},{"source":"薛定谔","target":"薛定谔的猫","name":"设计","des":"1935年思想实验里的既死且生。"},{"source":"EPR佯谬","target":"量子力学","name":"挑战","des":"完备性之辩的开山文件。"},{"source":"爱因斯坦","target":"EPR佯谬","name":"主笔","des":"与波多尔斯基、罗森合著的量子力学诉状。"},{"source":"EPR佯谬","target":"量子纠缠","name":"凸显","des":"纠缠从佯谬的论证细节变成主角。"},{"source":"隐变量理论","target":"EPR佯谬","name":"接续","des":"为实在论寻找深层参数的尝试。"},{"source":"玻姆力学","target":"隐变量理论","name":"具体化","des":"一套决定论的量子力学完整方案。"},{"source":"贝尔定理","target":"EPR佯谬","name":"裁定","des":"把哲学争论翻译成可测量的不等式。"},{"source":"贝尔不等式检验","target":"隐变量理论","name":"裁决","des":"定域隐变量出局，量子预言全胜。"},{"source":"贝尔不等式检验","target":"贝尔定理","name":"验证","des":"从思想到实验台的五十年长征。"},{"source":"多世界诠释","target":"哥本哈根诠释","name":"分庭","des":"拒绝坍缩，以分岔宇宙安放一切可能。"},{"source":"爱因斯坦","target":"玻尔-爱因斯坦论战","name":"主演","des":"以直觉为矛，步步紧逼量子力学的根基。"},{"source":"玻尔","target":"玻尔-爱因斯坦论战","name":"主演","des":"以逻辑为盾，一次次守住概率的阵地。"},{"source":"索尔维会议","target":"玻尔-爱因斯坦论战","name":"上演","des":"1927年的交锋成为科学史的经典一幕。"},{"source":"玻尔-爱因斯坦论战","target":"量子纠缠","name":"聚焦","des":"争论从不确定性一路走向幽灵般的超距。"},{"source":"波函数坍缩","target":"测量问题","name":"燃起","des":"坍缩之突兀是测量难题的心脏。"},{"source":"电子双缝实验","target":"测量问题","name":"逼问","des":"观测与否，条纹判若两图。"},{"source":"索末菲","target":"海森堡","name":"指导","des":"慕尼黑时期的博士导师。"},{"source":"索末菲","target":"泡利","name":"指导","des":"为天才少年改博士论文的导师。"},{"source":"索末菲","target":"索末菲椭圆轨道","name":"建构","des":"把玻尔的圆推广成量子化的椭圆族。"},{"source":"玻尔","target":"海森堡","name":"提携","des":"哥本哈根的访问与通信催生矩阵力学。"},{"source":"玻尔","target":"泡利","name":"惠及","des":"汉堡与哥本哈根之间的博士后岁月。"},{"source":"玻尔","target":"玻尔研究所","name":"创立","des":"1921年落成的理论物理圣地。"},{"source":"玻尔研究所","target":"量子力学","name":"滋养","des":"各国青年在此碰撞出量子火花。"},{"source":"海森堡","target":"玻尔研究所","name":"访学","des":"1924至25年驻足哥本哈根。"},{"source":"狄拉克","target":"海森堡","name":"同行","des":"1927年同船赴索尔维会议，一生相敬。"},{"source":"波恩","target":"海森堡","name":"带领","des":"哥廷根时期的导师与合作者。"},{"source":"波恩","target":"约当","name":"合作","des":"三人论文的黄金搭档。"},{"source":"爱因斯坦","target":"德布罗意","name":"赏识","des":"一句盛赞让评审委员会放行了那篇论文。"},{"source":"玻色","target":"爱因斯坦","name":"致信","des":"一封来自达卡的求教信成就一段统计力学佳话。"},{"source":"普朗克","target":"爱因斯坦","name":"举荐","des":"柏林的伯乐，也是量子假说的第一位接棒人。"},{"source":"泡利","target":"索尔维会议","name":"出席","des":"座中最年轻也最锋利的批评者。"},{"source":"金工与首饰工艺","target":"锻打成形","name":"成形主线","des":"一锤一锤从片到器。"},{"source":"金工与首饰工艺","target":"失蜡法","name":"成形支线","des":"蜡模翻铸的精密路线。"},{"source":"金工与首饰工艺","target":"錾刻","name":"装饰主线","des":"表面纹样的工笔语言。"},{"source":"金工与首饰工艺","target":"花丝镶嵌","name":"极致","des":"细金工艺的宫廷巅峰。"},{"source":"金工与首饰工艺","target":"掐丝珐琅","name":"上色","des":"以釉为彩的金属绘画。"},{"source":"锻打成形","target":"退火","name":"伴随","des":"打硬了就烧软再来。"},{"source":"锻打成形","target":"锤鍱与敲花","name":"分支","des":"从器形锤打到浮雕锤鍱。"},{"source":"锤鍱与敲花","target":"唐代金银器","name":"成就","des":"唐金碗的纹样全是锤鍱底子。"},{"source":"錾刻","target":"锤鍱与敲花","name":"前后工序","des":"背敲成形再正面錾修。"},{"source":"錾刻","target":"錾胎珐琅","name":"服务","des":"錾出的凹坑正是填釉的隔间。"},{"source":"范铸法","target":"后母戊鼎","name":"代表作","des":"多范合铸的重量级实证。"},{"source":"失蜡法","target":"曾侯乙尊盘","name":"代表作","des":"透空附饰被公认失蜡所出。"},{"source":"范铸法","target":"失蜡法","name":"并存","des":"块范与熔模两条铸造主线并行。"},{"source":"失蜡法","target":"石膏型铸造","name":"现代化","des":"蜡模思路升级为首饰工业标准。"},{"source":"石膏型铸造","target":"离心铸造","name":"配合","des":"离心力把金属送进最细的枝杈。"},{"source":"范铸法","target":"翻砂铸造","name":"平民化","des":"砂型成为工业时代的日用铸造。"},{"source":"金焊药","target":"大焊与小焊","name":"古今对译","des":"同一温度智慧的中西讲法。"},{"source":"金焊药","target":"花丝镶嵌","name":"必需","des":"千百个焊点全靠焊药接力。"},{"source":"错金银","target":"曾侯乙尊盘","name":"同期高峰","des":"战国金属装饰的两大绝技。"},{"source":"鎏金","target":"唐代金银