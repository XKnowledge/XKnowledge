:40,"category":"危机与保护"},{"name":"栖息地丧失","des":"滩涂围垦抽走了迁飞高速上的服务区。","symbolSize":40,"category":"危机与保护"},{"name":"鸟撞与光害","des":"玻璃幕墙与城市灯光的隐形屠杀，每年数以亿计。","symbolSize":40,"category":"危机与保护"},{"name":"外来入侵","des":"老鼠、猫与鼬上岛，地面巢的末日剧本。","symbolSize":40,"category":"危机与保护"},{"name":"DDT与猛禽","des":"农药让蛋壳变薄，鹰雕几乎绝后。","symbolSize":40,"category":"危机与保护"},{"name":"寂静的春天","des":"卡逊1962年以鸟为名的控诉，现代环保运动的开山。","symbolSize":40,"category":"危机与保护"},{"name":"朱鹮","des":"从陕西七只到上万只的中国拯救传奇。","symbolSize":40,"category":"危机与保护"},{"name":"拉姆萨尔公约","des":"1971年签署的湿地保护国际契约。","symbolSize":40,"category":"危机与保护"}],"links":[{"source":"CANN","target":"昇腾AI处理器","name":"异构调度","des":"屏蔽硬件差异，把框架的计算图翻译成芯片指令流。"},{"source":"CANN","target":"异构计算架构","name":"设计基石","des":"按CPU与NPU分工协作的模式组织整套软件栈。"},{"source":"CANN","target":"算子库","name":"核心资产","des":"内置数百个高性能算子，覆盖主流网络结构，随版本持续扩充。"},{"source":"CANN","target":"MindSpore","name":"原生底座","des":"为框架提供图编译、算子与运行时的全链路支撑。"},{"source":"CANN","target":"torch_npu","name":"适配通道","des":"PyTorch调用经插件转投CANN算子与运行时。"},{"source":"异构计算架构","target":"昇腾AI处理器","name":"host与device","des":"CPU负责调度与逻辑，NPU负责大规模张量计算。"},{"source":"软硬件栈","target":"CANN","name":"中间层","des":"CANN居中，向上隔离框架差异，向下屏蔽芯片细节。"},{"source":"软硬件栈","target":"昇腾AI处理器","name":"栈基","des":"芯片与驱动位于栈底，是一切软件的落点。"},{"source":"大模型训练","target":"集合通信","name":"梯度同步","des":"每轮反向传播后靠AllReduce等原语同步梯度。"},{"source":"大模型训练","target":"HBM","name":"显存门槛","des":"千亿参数能否放下，先看显存容量与带宽。"},{"source":"端边云协同","target":"昇腾系列硬件","name":"产品形态","des":"一套CANN软件栈跑遍端边云全家族硬件。"},{"source":"CANN","target":"大模型训练","name":"集群使能","des":"提供断点续训、通信优化与长稳运行保障。"},{"source":"CANN","target":"端边云协同","name":"一次开发","des":"同一套接口与算子能力贯穿端边云部署。"},{"source":"昇腾AI处理器","target":"达芬奇架构","name":"核心微架构","des":"达芬奇架构定义了AI Core的计算范式。"},{"source":"达芬奇架构","target":"AI Core","name":"物理载体","des":"微架构以AI Core为单元成规模复制。"},{"source":"AI Core","target":"Cube单元","name":"矩阵引擎","des":"大规模矩阵乘的吞吐担当。"},{"source":"AI Core","target":"Vector单元","name":"向量引擎","des":"逐元素计算与规约的流水线。"},{"source":"AI Core","target":"Scalar单元","name":"标量引擎","des":"地址计算与分支控制的指挥中枢。"},{"source":"AI Core","target":"MTE","name":"搬运引擎","des":"计算单元只管算，数据进出全靠MTE。"},{"source":"AI Core","target":"存储层次","name":"片上配套","des":"算得快不快，一半看数据放得近不近。"},{"source":"存储层次","target":"Unified Buffer","name":"中间层","des":"数据先落脚UB，再进计算单元。"},{"source":"存储层次","target":"HBM","name":"容量层","des":"片上放不下的权重与激活全在显存。"},{"source":"MTE","target":"HBM","name":"数据来源","des":"从HBM向片上Buffer搬运是算子的第一个动作。"},{"source":"昇腾系列硬件","target":"昇腾AI处理器","name":"内核","des":"板卡与服务器的心脏都是昇腾芯片。"},{"source":"集合通信","target":"昇腾系列硬件","name":"互联底座","des":"多卡训练依托卡间与节点间高速互联。"},{"source":"昇腾AI处理器","target":"AI CPU","name":"协同兜底","des":"不适合AI Core的算子与系统任务交给AI CPU。"},{"source":"多核并行","target":"AI Core","name":"分而治之","des":"一个大任务切成N份，N个核同时开工。"},{"source":"多核并行","target":"Tiling","name":"前置工序","des":"先按核数与容量切好块，才能各干各的。"},{"source":"AscendCL","target":"Runtime","name":"底层支撑","des":"C接口的语义最终由运行时承接执行。"},{"source":"AscendCL","target":"Device管理","name":"初始化第一步","des":"用卡先声明，资源随设备绑定。"},{"source":"AscendCL","target":"Context","name":"环境封装","des":"上下文把设备、流、内存打包管理。"},{"source":"AscendCL","target":"Stream","name":"任务轨道","des":"任务挂到流上，随流依次推进。"},{"source":"Context","target":"Device管理","name":"挂靠设备","des":"上下文绑定在具体设备之上。"},{"source":"Context","target":"Stream","name":"归属关系","des":"流创建在上下文里，销毁顺序不能颠倒。"},{"source":"Stream","target":"Event","name":"插桩同步","des":"事件插进流里标记时间点与依赖。"},{"source":"Event","target":"Host与Device同步","name":"细粒度等待","des":"从全流等待细化为等待到指定位置。"},{"source":"AscendCL","target":"内存管理","name":"显存操作","des":"Host与Device两侧内存一手抓。"},{"source":"内存管理","target":"Host与Device同步","name":"拷贝伴随等待","des":"跨侧拷贝之后通常要同步再取结果。"},{"source":"AscendCL","target":"模型推理","name":"推理主链路","des":"加载、执行、卸载三段式走完整个推理。"},{"source":"模型推理","target":"OM模型","name":"加载对象","des":"LoadFromFile吃进去的正是OM文件。"},{"source":"AscendCL","target":"单算子调用","name":"免建模执行","des":"不搭整网，直接喂张量给单个算子。"},{"source":"单算子调用","target":"Aclnn","name":"标准形态","des":"aclnn接口是单算子执行的主流入口。"},{"source":"AscendCL","target":"媒体预处理","name":"视觉专用","des":"图像缩放解码与视频编解码走专用通道。"},{"source":"Device管理","target":"昇腾AI处理器","name":"管的是NPU","des":"SetDevice选中的就是一块昇腾卡。"},{"source":"Runtime","target":"昇腾AI处理器","name":"直接对话","des":"运行时把任务翻译成硬件可执行的队列指令。"},{"source":"端边云协同","target":"AscendCL","name":"统一接口","des":"端边云三类设备共用同一套AscendCL。"},{"source":"Aclnn","target":"算子库","name":"调用入口","des":"每个库算子都对应一套aclnn接口。"},{"source":"Ascend C","target":"Kernel函数","name":"入口函数","des":"算子实现从写kernel函数起步。"},{"source":"Kernel函数","target":"GlobalTensor","name":"输入输出","des":"从全局张量读数据、写结果。"},{"source":"Kernel函数","target":"LocalTensor","name":"计算载体","des":"数据搬进片上才够得着计算单元。"},{"source":"Kernel函数","target":"Tiling","name":"首要入参","des":"tiling决定每个核拿到哪一块。"},{"source":"TPipe","target":"TQue","name":"队列分配","des":"管家发放带队列语义的buffer。"},{"source":"TPipe","target":"TBuf","name":"临时分配","des":"中间变量走免排队的快速通道。"},{"source":"TQue","target":"LocalTensor","name":"装载形态","des":"DeQue出来的就是可用的局部张量。"},{"source":"DataCopy","target":"GlobalTensor","name":"搬运对象","des":"从全局张量往片上搬数据。"},{"source":"DataCopy","target":"LocalTensor","name":"落点","des":"搬进片上等待计算单元取用。"},{"source":"TQue","target":"DataCopy","name":"同步配对","des":"EnQue前须搬完，DeQue后才能算。"},{"source":"矢量算子","target":"Vector单元","name":"硬件映射","des":"逐元素指令流在Vector单元执行。"},{"source":"矩阵算子","target":"Cube单元","name":"硬件映射","des":"Matmul指令流由Cube单元吞吐。"},{"source":"双缓冲","target":"TQue","name":"流水实现","des":"两份buffer轮流进队出队。"},{"source":"双缓冲","target":"MTE","name":"搬算重叠","des":"一份在搬、一份在算，谁也不闲着。"},{"source":"核间同步","target":"多核并行","name":"集体对齐","des":"多核协作场景谁也不许提前离场。"},{"source":"算子开发流程","target":"Ascend C","name":"开发语言","des":"四步流程以Ascend C为实现语言。"},{"source":"算子开发流程","target":"Profiler","name":"性能验收","des":"写完先看耗时，搬运占比是重点。"},{"source":"Ascend C","target":"Ascend IR","name":"编译路径","des":"源码经Ascend IR编译成硬件指令。"},{"source":"LocalTensor","target":"Unified Buffer","name":"物理位置","des":"局部张量实际住在片上UB里。"},{"source":"GlobalTensor","target":"HBM","name":"物理位置","des":"全局张量实际存放在显存里。"},{"source":"矩阵算子","target":"大模型训练","name":"算力大头","des":"训练算力九成消耗在矩阵乘。"