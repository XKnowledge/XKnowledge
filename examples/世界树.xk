:"切达","name":"对簿","des":"小村原名与全球名分的拉锯。"},{"source":"风味轮","target":"鲜味与陈年","name":"收录","des":"鲜味是词表里的重音节。"},{"source":"质地谱系","target":"帕玛森","name":"硬极","des":"晶粒砂感是质地谱的终点站。"},{"source":"蜂蜜与果干","target":"蓝纹奶酪","name":"搭档","des":"咸蓝配甜蜜的经典组合。"},{"source":"配酒原则","target":"斯蒂尔顿","name":"样板","des":"蓝纹配波特的老规矩。"},{"source":"乳糖与熟成","target":"鲜奶酪与软质","name":"提醒","des":"越年轻乳糖越高，肠胃自估。"},{"source":"奶酪师","target":"奶酪拼盘","name":"排序","des":"执刀人也负责轻重次序。"},{"source":"黄油","target":"酥油","name":"再熬","des":"黄油慢熬去水即是酥油。"},{"source":"奶油与酸奶油","target":"酸凝乳","name":"借酸","des":"酸奶油是乳酸增稠的近亲。"},{"source":"奶粉与乳清蛋白","target":"乳清奶酪","name":"同源","des":"都从乳清里淘金。"},{"source":"姓氏与谱系学","target":"姓","name":"双元之一","des":"血缘的符号，谱系学的起点。"},{"source":"姓氏与谱系学","target":"氏","name":"双元之一","des":"分支的符号，与姓相对而生成。"},{"source":"姓氏与谱系学","target":"家谱","name":"核心载体","des":"世系之学寄于谱牒。"},{"source":"姓氏与谱系学","target":"宗族","name":"社会组织","des":"姓氏谱牒最终服务于人的组织。"},{"source":"姓氏与谱系学","target":"字辈","name":"命名制度","des":"世代秩序写进每个人的名字。"},{"source":"姓氏与谱系学","target":"家族树","name":"通用图形","des":"树状图是全人类共享的谱系语言。"},{"source":"姓氏与谱系学","target":"基因谱系学","name":"当代新枝","des":"从文献考证走向双重证据。"},{"source":"姓氏与谱系学","target":"姓氏分布与人口","name":"统计视角","des":"人口普查成为新式谱牒。"},{"source":"姓","target":"氏","name":"统属","des":"姓统其祖考之所自出，氏别其子孙之所自分。"},{"source":"姓","target":"图腾起源说","name":"起源假说","des":"古姓用字里藏着氏族图腾的残影。"},{"source":"姓","target":"上古八大姓","name":"最古老名单","des":"八大姓皆从女旁，是母系时代的胎记。"},{"source":"上古八大姓","target":"姬姓","name":"首姓","des":"黄帝之姓居八姓之首。"},{"source":"上古八大姓","target":"姜姓","name":"次姓","des":"炎帝之姓与姬姓并称炎黄。"},{"source":"姬姓","target":"姜姓","name":"世代联姻","des":"姬姜世为婚姻，周室后妃多出姜姓。"},{"source":"姬姓","target":"以国为氏","name":"分封衍氏","des":"周室封建诸侯，国名遂成数百氏。"},{"source":"姬姓","target":"姓氏分布与人口","name":"衍生最多","des":"由姬姓分衍的姓氏数量居诸姓之冠。"},{"source":"氏","target":"封地命氏","name":"主要途径","des":"以采邑为氏最普遍。"},{"source":"氏","target":"以官为氏","name":"途径","des":"先祖职守化作姓氏。"},{"source":"氏","target":"以职业为氏","name":"途径","des":"世传技艺沉淀为名号。"},{"source":"氏","target":"以居地为氏","name":"途径","des":"住址直接入姓。"},{"source":"氏","target":"以字为氏","name":"途径","des":"祖父之字成孙辈之氏。"},{"source":"氏","target":"以谥为氏","name":"途径","des":"身后一字谥号，竟成千年姓氏。"},{"source":"封地命氏","target":"以国为氏","name":"并举","des":"采邑与国名是命氏的两大地理来源。"},{"source":"赐姓","target":"姓","name":"荣宠","des":"天子赐姓，最高规格的身份重铸。"},{"source":"赐姓","target":"门阀士族","name":"笼络","des":"国姓的授予常用于拉拢权臣世家。"},{"source":"《百家姓》","target":"赐姓","name":"国姓开篇","des":"「赵钱孙李」，赵宋国姓居于篇首。"},{"source":"《百家姓》","target":"姓","name":"总目","des":"四百余字押韵成篇，是最流行的姓氏清单。"},{"source":"《通志·氏族略》","target":"以国为氏","name":"分类体系","des":"郑樵以三十二类总括得姓受氏之源。"},{"source":"避讳改姓","target":"避讳制度","name":"株连姓氏","des":"帝王名讳所及，阖族被迫改姓。"},{"source":"避祸改姓","target":"姓","name":"隐姓求存","des":"政治风声里改姓换字，家族史最惊险的一页。"},{"source":"胡姓汉化","target":"复姓消长","name":"化繁为简","des":"独孤改刘、步六孤改陆，复姓大批简化。"},{"source":"复姓消长","target":"姓","name":"长时段趋势","des":"复姓日渐稀少，单姓愈加集中。"},{"source":"大姓现象","target":"姓","name":"集中","des":"「张王李赵遍地刘」，人口向少数姓集中。"},{"source":"姓氏分布与人口","target":"大姓现象","name":"统计实证","des":"人口普查给出了大姓的精确比例。"},{"source":"洪洞大槐树移民","target":"姓氏分布与人口","name":"重塑版图","des":"明初大移民再造了华北姓氏地理。"},{"source":"洪洞大槐树移民","target":"始祖与始迁祖","name":"寻根坐标","des":"亿万族谱把始迁祖指向同一棵槐树。"},{"source":"门阀士族","target":"郡望","name":"身份标签","des":"姓氏与发祥地绑定，郡望即门第通行证。"},{"source":"五姓七望","target":"门阀士族","name":"巅峰集团","des":"崔卢李郑王，连皇室联姻都敢怠慢。"},{"source":"五姓七望","target":"郡望","name":"望号","des":"博陵崔、清河崔皆以郡望自标。"},{"source":"门阀士族","target":"谱牒学","name":"催生","des":"选官稽谱牒，谱学因门阀而显。"},{"source":"五姓七望","target":"谱牒学","name":"垄断谱牒","des":"官修谱局的天平向高门倾斜。"},{"source":"郡望","target":"家谱","name":"谱首署望","des":"旧谱封面多冠郡望，如「陇西堂」。"},{"source":"家谱","target":"谱牒学","name":"研究对象","des":"谱牒之学以千卷家谱为基本材料。"},{"source":"玉牒","target":"家谱","name":"最高规格","des":"皇家谱牒由宗人府专修，称玉牒。"},{"source":"欧阳修谱式","target":"家谱","name":"范式","des":"五世一表的横推式谱法。"},{"source":"苏洵谱式","target":"家谱","name":"范式","des":"垂珠连缀、详略有别的竖连式谱法。"},{"source":"欧阳修谱式","target":"苏洵谱式","name":"并称欧苏","des":"两式并立，为后世千年修谱立法。"},{"source":"苏洵谱式","target":"世系图","name":"宝塔之形","des":"垂珠体世系层层下垂，形如宝塔。"},{"source":"欧阳修谱式","target":"正史列传","name":"宰相世系表","des":"欧阳修修《新唐书》特立宰相世系表，谱法与史法互证。"},{"source":"始祖与始迁祖","target":"家谱","name":"基准点","des":"谱牒的叙事从这两个名字展开。"},{"source":"房支","target":"家谱","name":"枝干结构","des":"房支层层展开，谱牒按房分卷。"},{"source":"昭穆","target":"房支","name":"父子异列","des":"昭穆排序规定了各房支的相对位置。"},{"source":"昭穆","target":"世系图","name":"布列之法","des":"世系图的左右横行依昭穆而定。"},{"source":"昭穆","target":"祠堂","name":"牌位次序","des":"祠内神主依昭穆定位，左昭右穆。"},{"source":"世系图","target":"家谱","name":"骨架","des":"名字蝉联而下的谱之主干。"},{"source":"祠堂","target":"宗族","name":"空间中心","des":"祭祖议事皆聚于祠，一族有一祠。"},{"source":"族田","target":"宗族","name":"经济基础","des":"公产之入撑起宗族的祭祀与赈济。"},{"source":"族田","target":"祠堂","name":"以田供祭","des":"族田租入专供祠祭与修谱之费。"},{"source":"宗族","target":"家谱","name":"合族之书","des":"谱联族人之名，族因谱而聚。"},{"source":"修谱传统","target":"家谱","name":"三十年一修","des":"续修不辍，谱牒才不致断代。"},{"source":"家乘与族规","target":"家谱","name":"谱之半壁","des":"族规家训与世系并列，构成完整谱书。"},{"source":"家乘与族规","target":"宗族","name":"教化","des":"族规束行，宗族以谱书治家。"},{"source":"字辈","target":"字辈诗","name":"载体","des":"辈分用字串成诗句，代代依序取名。"},{"source":"孔氏字辈","target":"字辈诗","name":"御赐之诗","des":"明清皇帝钦赐十字，四姓通天谱共用。"},{"source":"孔氏字辈","target":"宗族","name":"圣裔","des":"孔孟颜曾的宗族组织因字辈而全国一体。"},{"source":"字辈","target":"昭穆","name":"文字化","des":"辈分用字把昭穆次序写进了名字。"},{"source":"字辈诗","target":"修谱传统","name":"入谱","des":"新续字辈由谱局公定，载入谱书。"},{"source":"行第","target":"字辈","name":"前身","des":"伯仲叔季是字辈制度的古老雏形。"},{"source":"行第","target":"名与字","name":"排行入名","des":"长幼座次直接嵌进名字与称呼。"},{"source":"名与字","target":"冠字与笄字","name":"成年取字","des":"男冠女笄，取字即是成丁礼。"},{"source":"号","target":"名与字","name":"第三自我","des":"名字之外更立一号，自表其志。"},{"source":"号","target":"避讳制度","name":"权变","des":"遇讳不便直书时，以字号相代。"},{"source":"避讳制度","target":"国讳","name":"最高一层","des":"帝讳所及，天下共避。"},{"source":"避讳制度","target":"家讳","name":"门内一层","des":"父祖之名，子弟与门生共避。"},{"source":"避讳制度","target":"圣讳","name":"圣人一层","des":"至圣先师之名，改姓以避。"},{"source":"避讳改姓","target":"国讳","name":"极端后果","des":"姓氏与御讳相犯，只好阖族改姓。"},{"source":"单名与双名","target":"避讳制度","name":"二名之讳","des":"单名仅一字更易避讳，汉魏单名之风与此相关。"},{"source":"文献考证","target":"家谱","name":"辨伪存真","des":"以多重史料互勘，替攀附的谱牒动手术。"},{"source":"正史列传","target":"文献考证","name":"一级史料","des":"列传世家的世次记载最为可靠。"},{"source":"方志","target":"文献考证","name":"地方史料","des":"一邑之志补正史之所不及。"},{"source":"墓志铭","target":"文献考证","name":"出土史料","des":"新出墓志常能纠正传世文献。"},{"source":"墓志铭","target":"家谱","name":"互证","des":"志石所记世系与谱牒对读，真伪立见。"},{"source":"墓志铭","target":"门阀士族","name":"必书郡望","des":"唐人墓志开篇多自报郡望，门第心态入石三分。"},{"source":"口述家史","target":"文献考证","name":"活史料","des":"口传记忆补纸面所无，亦需考信。"},{"source":"口述家史","target":"修谱传统","name":"新谱采风","des":"当代修谱以访谈代替旧式谱局采辑。"},{"source":"基因谱系学","target":"Y 染色体追溯","name":"父系路径","des":"父传子、子传孙，千年一脉可验。"},{"source":"基因谱系学","target":"线粒体谱系","name":"母系路径","des":"母女相续的标记走出另一条谱线。"},{"source":"Y 染色体追溯","target":"共同祖先","name":"回溯会合","des":"两条父系的标记回溯到同一人。"},{"source":"线粒体谱系","target":"共同祖先","name":"回溯会合","des":"母系谱线同样会合于远古一人。"},{"source":"共同祖先","target":"家族树","name":"会合点","des":"两棵家族树在某一代悄然相连。"},{"source":"基因谱系学","target":"文献考证","name":"二重证据","des":"纸上世系与血液标记互为印证。"},{"source":"基因谱系学","target":"同姓联宗","name":"验证","des":"同姓是否同宗，一测便知分晓。"},{"source":"同姓联宗","target":"姓","name":"横向联合","des":"同姓者跨越支派认联一宗。"},{"source":"同姓联宗","target":"修谱传统","name":"通谱","des":"联宗的成果常是一部跨省通谱。"},{"source":"攀附与伪谱","target":"家谱","name":"慢性病","des":"始祖必托帝王，世系必接名人。"},{"source":"攀附与伪谱","target":"始祖与始迁祖","name":"伪托","des":"把始祖攀附到将相名臣名下。"},{"source":"谱师职业","target":"攀附与伪谱","name":"职业成因","des":"走村串族的谱师批量套用「名人始祖」模板。"},{"source":"GEDCOM 标准","target":"家谱","name":"数字化","des":"谱牒转为结构化数据，机器可读。"},{"source":"家谱数据库","target":"GEDCOM 标准","name":"交换基础","des":"全球数据库之间靠通用格式互通。"},{"source":"家谱数据库","target":"家谱","name":"云端汇聚","des":"樟木箱里的谱书搬进了检索框。"},{"source":"家谱数据库","target":"基因谱系学","name":"技术合流","des":"文献谱系与检测数据在同一平台接轨。"},{"source":"家族树","target":"家谱","name":"中西同构","des":"谱牒与家族树，同一血缘网的两种画法。"},{"source":"欧洲姓氏起源","target":"职业姓氏","name":"主要来源","des":"登记需求之下，职业率先变成姓氏。"},{"source":"欧洲姓氏起源","target":"父名制","name":"主要来源","des":"「某人之子」渐凝固为固定姓。"},{"source":"欧洲姓氏起源","target":"西班牙双姓制","name":"南欧变体","des":"双姓并行保留了两条血线。"},{"source":"职业姓氏","target":"以职业为氏","name":"异曲同工","des":"东西方不约而同以营生入姓。"},{"source":"父名制","target":"冰岛父名制","name":"活化石","des":"冰岛把父名制原样保留到今天。"},{"source":"父名制","target":"俄罗斯姓名三段","name":"凝固形态","des":"父称居中、姓氏殿后，三段定型。"},{"source":"俄罗斯姓名三段","target":"世界姓名顺序","name":"三段式","des":"名、父称、姓的排列自成一格。"},{"source":"冰岛父名制","target":"世界姓名顺序","name":"无姓之国","des":"没有家族姓，电话簿只好按名排序。"},{"source":"西班牙双姓制","target":"世界姓名顺序","name":"双姓并列","des":"父姓母姓同置，天然双线谱系。"},{"source":"日本苗字","target":"姓","name":"集中授姓","des":"明治一纸令下，全民一夜有姓。"},{"source":"日本苗字","target":"姓氏分布与人口","name":"普及","des":"明治之后姓氏统计才成为可能。"},{"source":"苏格兰氏族","target":"纹章学","name":"格纹徽记","des":"氏族各有专属格子呢纹与徽章。"},{"source":"苏格兰氏族","target":"宗族","name":"东西对照","des":"族长、族地与认同，近似中国的宗族。"},{"source":"纹章学","target":"门阀士族","name":"身份标识","des":"盾徽之于欧洲贵族，如郡望之于门阀。"},{"source":"科恩与利未","target":"基因谱系学","name":"著名验证","des":"祭司后裔体内找到一致父系标记，姓氏与基因互证。"},{"source":"科恩与利未","target":"姓","name":"祭司印记","des":"姓氏直接保存了圣殿时代的职分。"},{"source":"姓氏日","target":"名与字","name":"名字节日","des":"历法为每个名字留出一天。"},{"source":"世界姓名顺序","target":"姓","name":"姓之位置","des":"姓前名后还是名前姓后，各有其文化逻辑。"},{"source":"少数民族姓氏","target":"姓","name":"多元生态","des":"父子连名、哈拉汉译，各自成谱。"},{"source":"少数民族姓氏","target":"家谱","name":"口传谱系","des":"彝苗各族的口传谱系与书面谱牒并行。"},{"source":"避讳制度","target":"家谱","name":"缺笔避讳","des":"谱中遇御讳用字，常以缺笔处理。"},{"source":"玉牒","target":"谱牒学","name":"官修正宗","des":"皇家谱牒的修法为民间修谱之范本。"},{"source":"修谱传统","target":"祠堂","name":"颁谱","des":"新谱告成，族老齐聚祠堂行颁谱礼。"},{"source":"房支","target":"祠堂","name":"各房牌位","des":"祠内神主按房支分列安奉。"},{"source":"名与字","target":"家谱","name":"谱载字号","des":"谱牒于人名之下兼记表字与号。"},{"source":"冰岛父名制","target":"家谱数据库","name":"全民谱库","des":"冰岛全民谱系上网，近亲相遇手机一查便知。"},{"source":"方志","target":"姓氏分布与人口","name":"氏族志","des":"旧志氏族略为今日分布研究提供底本。"},{"source":"洪洞大槐树移民","target":"家谱","name":"谱载祖源","des":"「问我祖先来何处」，答案写进了千万部族谱序言。"},{"source":"欧阳修谱式","target":"修谱传统","name":"范式","des":"欧苏二式为千年修谱立法定式。"},{"source":"攀附与伪谱","target":"门阀士族","name":"攀附高门","des":"伪谱所攀附的对象，多是昔日高门。"},{"source":"威士忌与烈酒","target":"蒸馏原理","name":"共基","des":"一切烈酒都从发酵与蒸馏的基本功开始。"},{"source":"威士忌与烈酒","target":"苏格兰威士忌","name":"标尺","des":"产区与法规的样板，行业话语权的中心。"},{"source":"威士忌与烈酒","target":"世界威士忌","name":"分蘖","des":"学徒们四散落地，各自交卷。"},{"source":"威士忌与烈酒","target":"桶陈工艺","name":"上色","des":"无色的新酒，全靠桶与时间染成琥珀。"},{"source":"威士忌与烈酒","target":"烈酒家族","name":"旁系","des":"葡萄、甘蔗、龙舌兰与谷物各走一路。"},{"source":"威士忌与烈酒","target":"风味与品饮","name":"落杯","des":"从风味轮到配方，品饮的最后一课。"},{"source":"蒸馏原理","target":"发酵醪","name":"前提","des":"没有低度酒液，就没有蒸馏的原料。"},{"source":"发酵醪","target":"壶式蒸馏器","name":"入壶","des":"分批慢蒸的传统线。"},{"source":"发酵醪","target":"塔式蒸馏器","name":"入塔","des":"连续高效的现代线。"},{"source":"壶式蒸馏器","target":"塔式蒸馏器","name":"对照","des":"一个保风味，一个求纯净。"},{"source":"壶式蒸馏器","target":"铜的催化","name":"器壁","des":"铜壁吃掉硫化物，粗辣变柔顺。"},{"source":"蒸馏原理","target":"酒头酒心酒尾","name":"切割","des":"掐头去尾，只取中段酒心。"},{"source":"酒头酒心酒尾","target":"新酒","name":"产出","des":"切割之后，得到无色的新酒。"},{"source":"新酒","target":"桶陈工艺","name":"入桶","des":"白纸入桶，颜色香气全靠桶与时间。"},{"source":"蒸馏原理","target":"稀释与装瓶度数","name":"末笔","des":"从桶强到四十度，加水的最后一步。"},{"source":"苏格兰威士忌","target":"斯佩塞","name":"谷仓","des":"酒厂最密的果甜谷地。"},{"source":"苏格兰威士忌","target":"艾雷岛","name":"海风","des":"泥煤与海盐的重烟要塞。"},{"source":"苏格兰威士忌","target":"高地","name":"拼图","des":"风格跨度最大的辽阔产区。"},{"source":"苏格兰威士忌","target":"低地","name":"清淡","des":"轻柔入口派与谷物基地。"},{"source":"苏格兰威士忌","target":"坎贝尔敦","name":"遗韵","des":"从数十家衰落到三家的半岛余晖。"},{"source":"艾雷岛","target":"泥煤","name":"燃料","des":"烘麦烧泥煤，烟熏印章盖在每滴酒上。"},{"source":"泥煤","target":"泥煤度","name":"度量","des":"苯酚含量把烟熏变成可读数字。"},{"source":"苏格兰威士忌","target":"单一麦芽","name":"宣言","des":"一家酒厂的个性签名。"},{"source":"苏格兰威士忌","target":"调和威士忌","name":"交响","des":"几十种麦芽与谷物的调配艺术。"},{"source":"单一麦芽","target":"调和威士忌","name":"对照","des":"独奏与乐团的市场之争。"},{"source":"格兰菲迪","target":"单一麦芽","name":"点火","des":"一九六三年率先大规模出口，单麦浪潮自此启动。"},{"source":"麦卡伦","target":"雪莉桶","name":"深耕","des":"把雪莉桶做成品牌护城河。"},{"source":"斯佩塞","target":"麦卡伦","name":"一员","des":"斯佩塞河畔的雪莉桶标杆。"},{"source":"拉弗格","target":"艾雷岛","name":"极端","des":"药用烟熏的最重一端。"},{"source":"世界威士忌","target":"