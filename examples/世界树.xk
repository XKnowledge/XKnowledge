rget":"货币乘数","name":"决定","des":"准备金率越低，银行可放贷资金越多，乘数越大。"},{"source":"货币乘数","target":"信用创造","name":"解释","des":"基础货币经多轮存贷派生被成倍放大。"},{"source":"商业银行","target":"信用创造","name":"执行","des":"每笔放贷同时创造等额存款，银行是派生主体。"},{"source":"信用创造","target":"货币供给层次","name":"扩张","des":"派生存款使 M2 远大于基础货币。"},{"source":"中央银行","target":"商业银行","name":"监管","des":"央行维系支付清算并对银行体系监督管理。"},{"source":"商业银行","target":"信用","name":"经营","des":"银行的本质是经营信用风险的中介。"},{"source":"银行挤兑","target":"商业银行","name":"冲击","des":"恐慌性提款可在数日内掏空银行流动性。"},{"source":"存款保险","target":"银行挤兑","name":"防范","des":"限额保障降低储户挤兑动机。"},{"source":"金融危机","target":"银行挤兑","name":"包含","des":"危机的经典剧本：坏消息、恐慌、挤兑、连环倒闭。"},{"source":"货币","target":"信用","name":"基于","des":"现代货币的本质是央行与银行的信用负债。"},{"source":"货币供给层次","target":"货币","name":"统计","des":"M0、M1、M2 从现金到准货币按流动性分层计量。"},{"source":"利率","target":"复利","name":"驱动","des":"利率是复利滚动的速率，微小差异长期放大为鸿沟。"},{"source":"利率","target":"贴现","name":"参照","des":"折现率通常在基准利率之上加风险补偿。"},{"source":"利率","target":"无风险利率","name":"锚定","des":"无风险利率是利率体系中的基准一端。"},{"source":"利率","target":"汇率","name":"影响","des":"高息货币吸引套息资金流入，推升汇率。"},{"source":"债券","target":"利率","name":"反向联动","des":"市场利率上行，存量债券价格下跌。"},{"source":"利率","target":"货币时间价值","name":"体现","des":"市场利率是货币时间价值的集中定价。"},{"source":"股票","target":"一级市场","name":"发行","des":"新股首发在一级市场完成募资。"},{"source":"债券","target":"一级市场","name":"发行","des":"债券发行同样在一级市场募集。"},{"source":"IPO","target":"一级市场","name":"属于","des":"IPO 是一级市场最瞩目的发行活动。"},{"source":"IPO","target":"股票","name":"发行","des":"首次公开发行将公司推向公众市场。"},{"source":"股票","target":"二级市场","name":"流通","des":"发行完毕后股票在场内持续转手。"},{"source":"债券","target":"二级市场","name":"流通","des":"存量债券在二级市场形成连续报价。"},{"source":"交易所","target":"二级市场","name":"组织","des":"交易所提供集中撮合与规则保障。"},{"source":"二级市场","target":"流动性","name":"提供","des":"交易越活跃，资产变现越容易、代价越小。"},{"source":"ETF","target":"基金","name":"属于","des":"ETF 是可在场内交易的开放式指数基金。"},{"source":"ETF","target":"股票指数","name":"跟踪","des":"ETF 力求复制指数的成分与权重。"},{"source":"股票","target":"股票指数","name":"构成","des":"指数由一篮子股票按权重合成。"},{"source":"做空","target":"二级市场","name":"交易","des":"做空依赖二级市场可借券、可买卖。"},{"source":"做空","target":"股票","name":"借入","des":"先借券卖出，后低价买回还券。"},{"source":"期货","target":"金融衍生品","name":"属于","des":"期货是标准化程度最高的衍生品。"},{"source":"期权","target":"金融衍生品","name":"属于","des":"期权买卖的是选择权本身。"},{"source":"互换","target":"金融衍生品","name":"属于","des":"互换交换的是两串未来的现金流。"},{"source":"期权","target":"股票","name":"挂钩","des":"股票期权以个股或指数为标的。"},{"source":"基金","target":"股票","name":"投资","des":"基金以组合方式持有股票等资产。"},{"source":"基金","target":"债券","name":"投资","des":"债券基金专注固定收益资产。"},{"source":"债券","target":"现金流","name":"产生","des":"息票与本金构成一串可预期的现金流。"},{"source":"债券","target":"货币时间价值","name":"基于","des":"债券价格即未来现金流按利率贴现之和。"},{"source":"金融衍生品","target":"对冲","name":"用于","des":"衍生品天然适合建立反向头寸对冲风险。"},{"source":"市盈率","target":"股票","name":"估值","des":"PE 是股票相对估值最常用的标尺。"},{"source":"市净率","target":"股票","name":"估值","des":"PB 常用于银行等重资产行业。"},{"source":"股票","target":"风险","name":"承担","des":"股票求偿顺序靠后，承担剩余风险换取剩余收益。"},{"source":"有效市场假说","target":"ETF","name":"支持","des":"若市场高度有效，低成本指数基金是最优选择。"},{"source":"公司金融","target":"资本预算","name":"涵盖","des":"投资决策：钱投到哪个项目。"},{"source":"公司金融","target":"资本结构","name":"涵盖","des":"融资决策：钱从股权还是债务来。"},{"source":"公司金融","target":"营运资本管理","name":"涵盖","des":"短期决策：日常资金周转。"},{"source":"公司金融","target":"股利政策","name":"涵盖","des":"分配决策：利润留多少、分多少。"},{"source":"公司金融","target":"并购","name":"涵盖","des":"扩张决策：买企业还是建企业。"},{"source":"复利","target":"货币时间价值","name":"体现","des":"利滚利是时间就是价值的最直观形式。"},{"source":"贴现","target":"货币时间价值","name":"源于","des":"贴现把未来价值换算回今天，与复利互逆。"},{"source":"贴现","target":"复利","name":"互逆","des":"复利由现在推未来，贴现由未来折回现在。"},{"source":"净现值","target":"货币时间价值","name":"根植于","des":"NPV 比较的正是不同时点金钱的价值。"},{"source":"内部收益率","target":"货币时间价值","name":"根植于","des":"IRR 本身就是一个时间价值的折算率。"},{"source":"净现值","target":"贴现","name":"依赖","des":"NPV 把各期现金流逐一贴现后加总。"},{"source":"贴现现金流","target":"贴现","name":"依赖","des":"DCF 是贴现思想在企业估值上的集大成。"},{"source":"贴现现金流","target":"净现值","name":"推广","des":"DCF 本质是 NPV 思想从项目到企业的延伸。"},{"source":"资本预算","target":"净现值","name":"应用","des":"NPV 大于零是接受项目的黄金准则。"},{"source":"资本预算","target":"内部收益率","name":"应用","des":"IRR 与门槛利率比较辅助决策。"},{"source":"内部收益率","target":"净现值","name":"平衡","des":"IRR 正是使 NPV 等于零的折现率。"},{"source":"贴现现金流","target":"WACC","name":"折现于","des":"企业自由现金流通常以 WACC 为折现率。"},{"source":"资本结构","target":"WACC","name":"决定","des":"债务与股权的比重直接改变加权资本成本。"},{"source":"MM定理","target":"资本结构","name":"研究","des":"MM 定理是资本结构理论的逻辑起点。"},{"source":"资本结构","target":"杠杆","name":"体现","des":"债务占比越高，财务杠杆越大。"},{"source":"贴现现金流","target":"资本预算","name":"支撑","des":"DCF 是评估长期项目价值的主流方法。"},{"source":"贴现现金流","target":"自由现金流","name":"贴现对象","des":"DCF 的原料是企业未来的自由现金流。"},{"source":"营运资本管理","target":"现金流","name":"守护","des":"管好应收应付与存货，防止现金流断裂。"},{"source":"杠杆","target":"风险","name":"放大","des":"高杠杆在放大收益的同时等比放大风险。"},{"source":"杠杆","target":"ROE","name":"放大","des":"资产回报高于债务成本时，杠杆抬高股东回报。"},{"source":"股利政策","target":"净利润","name":"分配","des":"分红与留存此消彼长，共同瓜分净利润。"},{"source":"风险","target":"系统性风险","name":"分解为","des":"无法通过分散消除的市场性风险。"},{"source":"风险","target":"非系统性风险","name":"分解为","des":"可以通过分散化化解的特质风险。"},{"source":"波动率","target":"风险","name":"量化","des":"标准差把不确定性压缩成一个可比的数字。"},{"source":"Beta系数","target":"系统性风险","name":"衡量","des":"Beta 越大，随市场同涨同跌的幅度越大。"},{"source":"分散化","target":"非系统性风险","name":"消除","des":"持有足够多低相关资产，特质风险近乎归零。"},{"source":"预期收益","target":"风险","name":"补偿","des":"要求更高的预期收益，是承担风险的报酬。"},{"source":"现代组合理论","target":"分散化","name":"基于","des":"组合的风险不是个股风险的简单加总。"},{"source":"现代组合理论","target":"有效边界","name":"推导","des":"优化后的组合集合构成风险收益前沿。"},{"source":"有效边界","target":"预期收益","name":"权衡","des":"沿前沿移动：多一分收益，多一分风险。"},{"source":"CAPM","target":"Beta系数","name":"基于","des":"Beta 决定资产承担多少系统风险。"},{"source":"CAPM","target":"无风险利率","name":"基于","des":"预期收益从无风险利率起算。"},{"source":"CAPM","target":"市场风险溢价","name":"基于","des":"乘上 Beta 便得到个体风险补偿。"},{"source":"市场风险溢价","target":"系统性风险","name":"补偿","des":"市场整体承担系统风险所要求的回报。"},{"source":"VaR","target":"风险","name":"度量","des":"用一个数字回答最坏会亏多少。"},{"source":"对冲","target":"风险","name":"抵消","des":"以相反头寸对冲，把不确定性变成确定。"},{"source":"风险","target":"WACC","name":"抬高","des":"风险越高，投资者要求的折现率越高，估值越低。"},{"source":"有效市场假说","target":"波动率","name":"解释","des":"新信息随机到达使价格波动近似随机游走。"},{"source":"资产负债表","target":"资产","name":"列示","des":"资产的存量与结构。"},{"source":"资产负债表","target":"负债","name":"列示","des":"负债的规模与期限。"},{"source":"资产负债表","target":"所有者权益","name":"列示","des":"资产减负债后的股东净值。"},{"source":"利润表","target":"收入","name":"列示","des":"收入是利润故事的起点。"},{"source":"利润表","target":"净利润","name":"列示","des":"层层扣除后的最终成果。"},{"source":"收入","target":"净利润","name":"转化为","des":"扣除成本费用税负后凝结为净利润。"},{"source":"现金流量表","target":"现金流","name":"记录","des":"按经营、投资、筹资三段还原现金真实进出。"},{"source":"净利润","target":"现金流","name":"调节","des":"利润是观点，现金是事实，两者差异暴露盈利质量。"},{"source":"净利润","target":"ROE","name":"构成","des":"ROE 的分子是当期净利润。"},{"source":"所有者权益","target":"ROE","name":"构成","des":"ROE 的分母是股东投入的净资产。"},{"source":"净利润","target":"ROA","name":"构成","des":"ROA 以净利润比上全部资产。"},{"source":"资产","target":"ROA","name":"构成","des":"资产规模决定回报的分母。"},{"source":"杜邦分析","target":"ROE","name":"分解","des":"ROE 等于利润率乘周转率乘杠杆。"},{"source":"市盈率","target":"净利润","name":"基于","des":"PE 的分母每股收益源自净利润。"},{"source":"市净率","target":"所有者权益","name":"基于","des":"PB 的分母每股净资产源自权益。"},{"source":"自由现金流","target":"现金流量表","name":"源于","des":"FCF 由经营现金流减资本开支推算。"},{"source":"自由现金流","target":"现金流","name":"度量","des":"FCF 是可自由分配给全部出资人的现金流。"},{"source":"流动比率","target":"负债","name":"对照","des":"流动资产覆盖短期负债的程度。"},{"source":"流动比率","target":"营运资本管理","name":"检验","des":"短期偿债指标是营运资本管理的成绩单。"},{"source":"钟表与计时","target":"日晷","name":"光影","des":"最早的计时器借太阳说话。"},{"source":"钟表与计时","target":"机械钟","name":"齿轮化","des":"时间第一次被切成等份。"},{"source":"钟表与计时","target":"擒纵机构","name":"心脏","des":"一切精度的来源。"},{"source":"钟表与计时","target":"石英表","name":"电子化","des":"晶体接管了摆轮。"},{"source":"钟表与计时","target":"原子钟","name":"量子化","des":"时间单位交给原子定义。"},{"source":"日晷","target":"漏刻","name":"接力","des":"阴天与夜晚由水钟顶班。"},{"source":"漏刻","target":"沙漏","name":"干式替补","des":"结冰的北方换沙子来滴。"},{"source":"更香与火钟","target":"漏刻","name":"同类","des":"以消耗速率均分时间的思路一致。"},{"source":"水运仪象台","tar