arget":"风洞必修课","name":"先声","des":"风的教训先响了一次。"},{"source":"银桥事件","target":"桥梁体检制度","name":"立规","des":"一次断裂换来全民体检。"},{"source":"疲劳与腐蚀","target":"健康监测","name":"盯防","des":"传感器对慢性病布哨。"},{"source":"圣水大桥","target":"桥梁体检制度","name":"呼应","des":"亚洲同题的管养之问。"},{"source":"预应力混凝土","target":"连续刚构","name":"成型","des":"预应力撑起墩梁固结。"},{"source":"从熟铁到钢","target":"福斯桥","name":"供材","des":"廉价钢材成就钢桥时代。"},{"source":"明石海峡大桥","target":"海峡宏图","name":"参照","des":"跨海工程的技术标尺。"},{"source":"程阳风雨桥","target":"木桥时代","name":"巅峰","des":"木构桥艺的集大成。"},{"source":"武术与功夫","target":"「武术」与「功夫」词辨","name":"正名","des":"武术是总称，功夫原指造诣，海外反把功夫当成了武术的名字。"},{"source":"武术与功夫","target":"套路","name":"载体","des":"拳种以套路存续身传，一招一式皆是教本。"},{"source":"武术与功夫","target":"中华拳种谱系概览","name":"谱系","des":"拳种林立，常按地域源流粗分南北，各系又开枝散叶。"},{"source":"武术与功夫","target":"门派与师承伦理","name":"传统","des":"技艺依伦理而传，师徒名分是门派的黏合剂。"},{"source":"武术与功夫","target":"武举制度","name":"制度","des":"科举设武科，官方考试塑造了习武的价值坐标。"},{"source":"武术与功夫","target":"内外家之辨","name":"分野","des":"内外家之辨牵动拳史叙事，三百年聚讼不已。"},{"source":"套路","target":"功法与桩功","name":"筑基","des":"练拳先站桩，根基不牢，套路只是空架子。"},{"source":"套路","target":"手眼身法步","name":"要领","des":"演武五要素齐备，方称身法完整。"},{"source":"六合要义","target":"手眼身法步","name":"统摄","des":"内外相合统摄五要，劲整而不散乱。"},{"source":"内外家之辨","target":"黄宗羲《王征南墓志铭》","name":"滥觞","des":"黄宗羲下笔为拳师立传，内家二字自此入史。"},{"source":"中华拳种谱系概览","target":"内外家之辨","name":"框架","des":"谱系叙述常借内外两分法安顿诸拳。"},{"source":"门派与师承伦理","target":"套路","name":"传承","des":"口传身授之外，套路是跨越世代的教本。"},{"source":"武举制度","target":"十八般兵器","name":"考项","des":"武闱试弓马刀石，器械功底是硬指标。"},{"source":"内外家之辨","target":"太极拳源流","name":"内家","des":"太极以内家自居，奉王宗岳论为理论源头。"},{"source":"内外家之辨","target":"形意拳","name":"内家","des":"心意一系亦主静求整，同以内家为号。"},{"source":"内外家之辨","target":"八卦掌","name":"内家","des":"转掌换势归于静功一路，同列内家门墙。"},{"source":"太极拳源流","target":"陈王廷","name":"创拳说","des":"陈家沟武师融拳于导引，被后世视为始祖。"},{"source":"陈王廷","target":"陈长兴","name":"家传","des":"陈氏世代传拳，至十四世陈长兴而拳架益精。"},{"source":"陈长兴","target":"杨露禅","name":"授艺","des":"破族规授艺外姓，成就一代杨无敌。"},{"source":"杨露禅","target":"太极五式分流","name":"开创","des":"进京教拳定下杨式，吴武孙诸式递相分出。"},{"source":"太极拳源流","target":"王宗岳《太极拳论》","name":"奉经","des":"一卷拳论立太极之理，诸式共奉为经典。"},{"source":"太极拳源流","target":"推手","name":"练法","des":"搭手听劲，把套路功夫放进双人对话里检验。"},{"source":"形意拳","target":"姬际可","name":"托始","des":"终南山得谱的传说，把源头系于明末姬龙峰。"},{"source":"姬际可","target":"戴氏心意六合拳","name":"秘传","des":"戴家承心意拳法，一门深藏百余年不外泄。"},{"source":"戴氏心意六合拳","target":"李洛能","name":"授艺","des":"李洛能学于戴氏，终以广开门墙而光大。"},{"source":"李洛能","target":"形意拳","name":"定名","des":"改心意旧称立形意之名，河北一脉自此大兴。"},{"source":"形意拳","target":"五行拳与十二形","name":"体系","des":"五拳为纲、十二形为目，象形而取意。"},{"source":"李洛能","target":"郭云深","name":"门下","des":"郭云深得师真传，崩拳绝艺冠绝一时。"},{"source":"郭云深","target":"五行拳与十二形","name":"精研","des":"半步崩拳，把五行拳一路练到极简。"},{"source":"郭云深","target":"尚云祥","name":"传授","des":"尚云祥得郭氏赏识倾囊，崩拳更上层楼。"},{"source":"八卦掌","target":"董海川","name":"创掌","des":"转掌之艺自肃王府传出，董公成百代宗师。"},{"source":"董海川","target":"程廷华","name":"门下","des":"眼镜程承衣钵，游身八卦名满京华。"},{"source":"孙禄堂","target":"形意拳","name":"入门","des":"孙禄堂先习形意立骨，功夫自此筑基。"},{"source":"孙禄堂","target":"八卦掌","name":"兼修","des":"再从程廷华习转掌，步法里添了一个圆。"},{"source":"孙禄堂","target":"太极拳源流","name":"融汇","des":"又得郝为真太极真传，三家功夫归于一人。"},{"source":"孙禄堂","target":"《拳意述真》","name":"著述","des":"笔录诸家言行，为内家拳理留下津梁。"},{"source":"太极五式分流","target":"推手","name":"共法","des":"诸式套路各异，推手的听劲原理相通。"},{"source":"武术与功夫","target":"少林寺","name":"名刹","des":"天下功夫出少林，古刹是禅武一体的图腾。"},{"source":"少林寺","target":"达摩面壁传说","name":"附会","des":"《易筋经》托名达摩，一场附会千年的美丽误会。"},{"source":"少林寺","target":"十三棍僧救唐王传说","name":"演绎","des":"唐初僧众助唐的史影，长成十三棍僧的传奇。"},{"source":"少林寺","target":"明代僧兵","name":"武备","des":"嘉靖年间应召出征，少林武名达于朝野。"},{"source":"明代僧兵","target":"戚继光《纪效新书》","name":"互证","des":"兵书与僧兵同御倭患，彼此留下注脚。"},{"source":"戚继光《纪效新书》","target":"少林拳法","name":"评述","des":"拳经篇历数各家拳法，少林之名赫然在列。"},{"source":"少林寺","target":"少林拳法","name":"家法","des":"古刹数百年拳风，刚猛朴实的体系一脉相承。"},{"source":"少林拳法","target":"七十二艺与排打功","name":"功技","des":"拳法之外，排打硬功的传统蔚为大观。"},{"source":"中华拳种谱系概览","target":"八极拳","name":"收录","des":"贴身靠撞的刚拳，北方拳系的重镇。"},{"source":"八极拳","target":"李书文","name":"宗师","des":"李书文不出招则已，神枪之名冠绝京津。"},{"source":"李书文","target":"六合大枪","name":"神枪","des":"拳成枪就，大枪是八极门的上乘功课。"},{"source":"八极拳","target":"劈挂拳与翻子拳","name":"互补","des":"八极加劈挂、神鬼都害怕，谚语道尽刚柔相济。"},{"source":"中华拳种谱系概览","target":"查拳与谭腿","name":"收录","des":"回族拳系双璧，长于腿法与舒展整劲。"},{"source":"中华拳种谱系概览","target":"螳螂拳","name":"收录","des":"象形拳的代表，流传于胶东半岛的名拳。"},{"source":"中华拳种谱系概览","target":"通背拳","name":"收录","des":"放长击远、劲由脊发的北方拳系。"},{"source":"通背拳","target":"劈挂拳与翻子拳","name":"近缘","des":"劲路同尚冷弹脆快，历来多有合练之说。"},{"source":"戚继光《纪效新书》","target":"苗刀","name":"收录","des":"辛酉刀法录于兵书，长刀一脉自此有典可循。"},{"source":"武术与功夫","target":"十八般兵器","name":"武备","des":"器械与拳脚互为表里，是武艺的另一半。"},{"source":"十八般兵器","target":"枪术","name":"位列","des":"兵器谱上枪为先，百兵之王由此而来。"},{"source":"十八般兵器","target":"剑术","name":"位列","des":"剑称百兵之君，是武与文的交汇点。"},{"source":"枪术","target":"六合大枪","name":"深造","des":"大杆子是枪术试金石，劲透杆尖方为有成。"},{"source":"六合大枪","target":"形意拳","name":"化枪为拳","des":"心意拳脱胎于大枪，出拳如扎枪一般。"},{"source":"剑术","target":"太极剑","name":"衍生","des":"轻灵剑法化为绵缓，柔性剑自成一家。"},{"source":"太极拳源流","target":"太极剑","name":"配械","des":"拳架既成而后配剑，剑法随身法绵延。"},{"source":"李小龙","target":"双节棍","name":"带火","des":"银幕双节棍一响，西方武馆里人手两节。"},{"source":"十八般兵器","target":"软兵器","name":"另册","des":"奇门软械不入正册，胜在出其不意。"},{"source":"十八般兵器","target":"苗刀","name":"别支","des":"长刀虽非正选，却是近世武库里的名刃。"},{"source":"七十二艺与排打功","target":"铁砂掌","name":"同类","des":"插砂拍打一类的功法，练皮练骨的极限。"},{"source":"点穴传说","target":"武侠文化","name":"演绎","des":"文学把经络学说推向神奇，成了功夫片常客。"},{"source":"武术与功夫","target":"南拳","name":"南派","des":"南拳北腿之说的一半，岭南尚武的门面。"},{"source":"南拳","target":"洪拳","name":"五家","des":"五大家中洪字当先，声势最盛、流传最广。"},{"source":"洪拳","target":"洪熙官传说","name":"托始","des":"清初叙事里走出的创拳英雄，寄寓旧日襟怀。"},{"source":"洪拳","target":"工字伏虎拳","name":"根基","des":"入门第一路，工字步法配伏虎势，根基所在。"},{"source":"工字伏虎拳","target":"黄飞鸿","name":"承传","des":"黄飞鸿以此立基，拳脚狮艺名动佛山。"},{"source":"南拳","target":"咏春拳源流","name":"别支","des":"短桥窄马自成一路，终成南拳的世界名片。"},{"source":"咏春拳源流","target":"五枚师太与严咏春传说","name":"托始","des":"蛇鹤相争的悟拳故事，是咏春的开宗叙事。"},{"source":"咏春拳源流","target":"梁赞","name":"中兴","des":"佛山赞先生定教立谱，咏春自此有法度。"},{"source":"梁赞","target":"陈华顺","name":"授徒","des":"找钱华得真传，再把功夫交给少年叶问。"},{"source":"陈华顺","target":"叶问","name":"授徒","des":"富家少年入门学艺，四十年后宗师香江。"},{"source":"叶问","target":"李小龙","name":"授徒","des":"少年李小龙在港习咏春，埋下日后革命的种子。"},{"source":"武术与功夫","target":"武侠文化","name":"土壤","des":"千年侠义叙事，是功夫片取之不尽的总剧本。"},{"source":"武侠文化","target":"邵氏功夫片","name":"孵化","des":"大厂流水线造就武侠片的黄金年代。"},{"source":"邵氏功夫片","target":"胡金铨《侠女》","name":"高峰","des":"厂牌之外的诗意担当，为中国武侠扬名戛纳。"},{"source":"邵氏功夫片","target":"成龙与功夫喜剧","name":"接续","des":"由硬桥硬马转向谐趣，杂耍喜剧打开新市场。"},{"source":"李小龙","target":"截拳道","name":"创立","des":"融咏春、拳击与剑击于一炉，无法即是法。"},{"source":"李小龙","target":"《龙争虎斗》","name":"主演","des":"遗作横扫全球，功夫热烧到西方街头。"},{"source":"《龙争虎斗》","target":"成龙与功夫喜剧","name":"接棒","des":"巨星身后，谐趣路线接掌功夫片江山。"},{"source":"截拳道","target":"UFC与MMA","name":"先声","des":"不限流派的武学思想，被综合格斗界奉为先驱。"},{"source":"武侠文化","target":"徐克新武侠","name":"变法","des":"特效与吊威亚入场，武侠美学为之一新。"},{"source":"徐克新武侠","target":"黄飞鸿","name":"重塑","des":"李连杰的黄飞鸿，让宗师形象焕然一新。"},{"source":"武侠文化","target":"《卧虎藏龙》","name":"大成","des":"李安竹林一战，武侠片捧回奥斯卡。"},{"source":"叶问","target":"叶问系列电影","name":"原型","des":"银幕宗师开腔，咏春武馆挤满各地弟子。"},{"source":"李连杰与《少林寺》","target":"少林寺","name":"带热","des":"1982 年电影让千年古刹重游人如潮。"},{"source":"《功夫熊猫》","target":"武术与功夫","name":"对话","des":"熊猫阿宝学功夫，西方讲了一个东方故事。"},{"source":"少林寺","target":"少林文化中心","name":"设立","des":"文化中心开到海外，功夫与禅修一并输出。"},{"source":"散打","target":"武术入亚运","name":"入赛","des":"1990 年北京亚运会，武术成为正式项目。"},{"source":"竞技套路体操化探讨","target":"武术入亚运","name":"争鸣","des":"竞技套路如何平衡难度与神意，争论随赛事而来。"},{"source":"武术与功夫","target":"散打","name":"竞技","des":"传统踢打摔技法在擂台规则下的再造。"},{"source":"散打","target":"中国跤与善扑营","name":"滋养","des":"散打的快摔技法多取材于中国跤的架子。"},{"source":"泰拳","target":"K-1踢拳","name":"舞台","des":"八臂艺术登上日本擂台，与踢拳规则相互熔铸。"},{"source":"空手道","target":"K-1踢拳","name":"来源","des":"踢拳本身即是空手道与拳击混血而成。"},{"source":"大山倍达与极真会","target":"空手道","name":"流派","des":"全接触赛制另立门户，重实战而少套路。"},{"source":"跆拳道","target":"空手道","name":"渊源","des":"早期道馆武艺多受空手道影响，后自成体系。"},{"source":"前田光世","target":"巴西柔术","name":"播种","des":"远渡重洋的旅程，让柔种落进南美。"},{"source":"前田光世","target":"格雷西家族","name":"授艺","des":"卡洛斯·格雷西从学于前田，家学自此开篇。"},{"source":"格雷西家族","target":"巴西柔术","name":"发扬","des":"家族百年打磨地面缠斗之技，蔚为大观。"},{"source":"巴西柔术","target":"UFC与MMA","name":"扬名","des":"首届赛事柔术连连奏捷，地面技举世瞩目。"},{"source":"散打","target":"UFC与MMA","name":"聚首","des":"各国站立技与地面技在笼中同台切磋。"},{"source":"套路","target":"竞技套路体操化探讨","name":"争鸣","des":"演武入赛场，艺术与难度如何两全。"},{"source":"武术与功夫","target":"武术与体育科学融合","name":"转译","des":"老拳谱遇上测力台与肌电图，旧学新解。"},{"source":"泰拳","target":"散打","name":"交流","des":"对抗交流赛场上，两种体系互见短长。"},{"source":"跆拳道","target":"武术入亚运","name":"同道","des":"跆拳道先行入奥，为武道竞技化提供参照。"},{"source":"武术与功夫","target":"止戈为武","name":"字源","des":"武字拆解的伦理宣言，是全部武艺的价值底色。"},{"source":"中国跤与善扑营","target":"角抵与手搏","name":"承源","des":"清代官跤传统，遥接先秦角抵的竞技血脉。"},{"source":"武术与功夫","target":"拳会与民团","name":"乡土","des":"近代武术依托拳会与乡团生长，深深扎进乡土秩序。"},{"source":"拳会与民团","target":"国术馆时代","name":"演变","des":"从乡土拳会到国家工程，武术组织形态百年一变。"},{"source":"武举制度","target":"国术馆时代","name":"沿革","des":"武科废而国术馆兴，官方塑造习武价值的两种手腕。"},{"source":"国术馆时代","target":"打擂台","name":"检验","des":"国术擂台赛让各派在台上见了真章。"},{"source":"国术馆时代","target":"竞技武术","name":"转型","des":"体育化的国家工程一脉相承，落到新赛道制。"},{"source":"竞技武术","target":"长拳","name":"母体","des":"新编长拳是竞技套路的底本。"},{"source":"竞技武术","target":"竞技套路体操化探讨","name":"争鸣","des":"高难美新的路线，难度与神意如何两全。"},{"source":"太极拳源流","target":"陈氏太极拳","name":"老架","des":"缠丝劲的源头活水在陈家沟。"},{"source":"陈氏太极拳","target":"杨氏太极拳","name":"传拳","des":"杨露禅学于陈沟改架进京，舒展大架自此成形。"},{"source":"八卦掌","target":"趟泥步","name":"行桩","des":"摩擦而行的圆规脚，走圈的基本功。"},{"source":"形意拳","target":"意拳","name":"改革","des":"王芗斋去套路存站桩，从形意门里走出激进一路。"},{"source":"少林拳法","target":"罗汉拳","name":"看家","des":"一百零八手的完整谱系，少林看家拳。"},{"source":"南拳","target":"蔡李佛","name":"巨族","des":"三家合流的南拳巨族，海内外会馆众多。"},{"source":"咏春拳源流","target":"黐手","name":"独门","des":"搭手感应的双人训练，手臂之间的对话。"},{"source":"推手","target":"黐手","name":"同参","des":"太极与咏春各自发展出搭手听劲，殊途同归。"},{"source":"螳螂拳","target":"象形拳","name":"同列","des":"观虫悟拳的取形会意一族。"},{"source":"象形拳","target":"醉拳","name":"归属","des":"形醉意不醉，象形拳里的浪漫一支。"