"西蒙","target":"有限理性","name":"提出","des":"1947年《管理行为》砍倒完全理性。"},{"source":"有限理性","target":"满意解","name":"导出","des":"算不尽所有方案，够好即收手。"},{"source":"西蒙","target":"管理就是决策","name":"断言","des":"计划、组织、控制皆是决策的别名。"},{"source":"管理就是决策","target":"管理五职能","name":"贯穿","des":"五职能共同的芯是选择。"},{"source":"西蒙","target":"管理决策新科学","name":"写就","des":"1960年文集，预见计算机入局。"},{"source":"管理决策新科学","target":"管理就是决策","name":"佐证","des":"机器再快，决策仍是管理的芯。"},{"source":"有限理性","target":"管理学","name":"立基","des":"管理学最坚实的行为地基由此奠定。"},{"source":"系统学派","target":"管理学","name":"综观","des":"组织是开放系统，局部最优叠不成整体最优。"},{"source":"权变理论","target":"系统学派","name":"承接","des":"把环境变量引入组织设计的方程。"},{"source":"权变理论","target":"科学管理","name":"反驳","des":"没有放之四海的最好办法，只有合不合情境。"},{"source":"管理理论丛林","target":"管理学","name":"盘点","des":"孔茨1961年数出六派，丛林之名流传至今。"},{"source":"管理理论丛林","target":"管理五职能","name":"归宗","des":"孔茨自领管理过程学派，奉法约尔为祖。"},{"source":"德鲁克","target":"管理的实践","name":"写就","des":"1954年成书，管理从此是可教的职业。"},{"source":"管理的实践","target":"管理学","name":"立卷","des":"学科的边界、对象与方法首次系统画出。"},{"source":"管理的实践","target":"目标管理MBO","name":"首倡","des":"以目标代支配，自我控制代外部驱迫。"},{"source":"德鲁克","target":"知识工作者","name":"造词","des":"1959年预言知识取代资本成为主要资源。"},{"source":"知识工作者","target":"管理学","name":"追问","des":"自愿贡献不可强买，管理须换一套文法。"},{"source":"X理论与Y理论","target":"目标管理MBO","name":"铺垫","des":"自我控制的前提是管理者信得过人。"},{"source":"明茨伯格","target":"管理者十角色","name":"提出","des":"1973年《管理工作的本质》，据实观察而立论。"},{"source":"管理者十角色","target":"管理五职能","name":"修正","des":"经理的真实日子碎在口头与人际，不在五职能里。"},{"source":"钱德勒","target":"结构追随战略","name":"论证","des":"1962年《战略与结构》，四家大企业史料作证。"},{"source":"结构追随战略","target":"事业部制","name":"指认","des":"斯隆式分权正是多角化战略的结构答卷。"},{"source":"斯隆","target":"事业部制","name":"首创","des":"1920年代通用汽车多品牌分权，总部握战略财务。"},{"source":"事业部制","target":"科层制","name":"变体","des":"分权的事业部仍是理性科层的骨架。"},{"source":"安索夫","target":"战略管理","name":"奠基","des":"1965年《公司战略》给出概念框架。"},{"source":"安索夫","target":"安索夫矩阵","name":"提出","des":"产品与市场两轴四格定增长路线。"},{"source":"安索夫矩阵","target":"战略管理","name":"供图","des":"增长决策的第一张指北针。"},{"source":"安德鲁斯","target":"SWOT分析","name":"提出","des":"内省长短与外察机会威胁配对成式。"},{"source":"SWOT分析","target":"战略管理","name":"立式","des":"战略即优势乘机会，入门第一课。"},{"source":"安德鲁斯","target":"波特","name":"交接","des":"由内省配对转向外察结构，战略学界的世代更替。"},{"source":"波特","target":"五力模型","name":"提出","des":"1979年哈佛商业评论，五种力合围利润池。"},{"source":"五力模型","target":"竞争战略","name":"服务","des":"行业结构定盈利空间，位置决定命运。"},{"source":"波特","target":"竞争战略","name":"写就","des":"1980年三大通用地板：成本、差异与聚焦。"},{"source":"竞争战略","target":"战略管理","name":"重心","des":"从规划文本转向产业结构与位置之争。"},{"source":"波特","target":"价值链","name":"解剖","des":"1985年把优势拆到每一项活动。"},{"source":"价值链","target":"竞争战略","name":"落地","des":"成本或差异，最终都要落到活动上。"},{"source":"波士顿矩阵","target":"事业部制","name":"应用","des":"多事业公司的资金在此排定优先级。"},{"source":"波士顿矩阵","target":"战略管理","name":"配装","des":"增长份额四象限，现金牛喂明星。"},{"source":"核心竞争力","target":"战略管理","name":"内转","des":"由争位置回到锻根骨，普拉哈拉德与哈默的转向。"},{"source":"核心竞争力","target":"价值链","name":"论战","des":"定位在外，能力在内，两派长期相争。"},{"source":"颠覆式创新","target":"核心竞争力","name":"反噬","des":"昨日的核心能力恰把在位者锁死在旧市场。"},{"source":"克里斯坦森","target":"颠覆式创新","name":"提出","des":"1997年《创新者的窘境》，管理良好反成死因。"},{"source":"颠覆式创新","target":"竞争战略","name":"补壁","des":"结构分析难解新市场外围的奇袭。"},{"source":"蓝海战略","target":"竞争战略","name":"出走","des":"跳出红海争抢，以价值创新另开一桌。"},{"source":"平衡计分卡","target":"目标管理MBO","name":"接续","des":"把目标分置四视角且件件可测。"},{"source":"平衡计分卡","target":"战略管理","name":"落地","des":"战略译成一页地图一串指标。"},{"source":"沙因","target":"组织文化","name":"分层","des":"人工制品、价值观与基本假设三层剥开。"},{"source":"组织文化","target":"管理学","name":"深耕","des":"战略与结构之下，还有第三股决定力量。"},{"source":"组织文化","target":"学习型组织","name":"培土","des":"底层假设不改，五项修炼无根。"},{"source":"圣吉","target":"学习型组织","name":"倡立","des":"1990年《第五项修炼》立起纲领。"},{"source":"学习型组织","target":"五项修炼","name":"载体","des":"五项修炼正是它的修习科目。"},{"source":"五项修炼","target":"系统思考","name":"归宗","des":"第五项统摄其余四项。"},{"source":"系统思考","target":"系统学派","name":"承续","des":"把开放系统论炼成管理者每日的心智。"},{"source":"流程再造","target":"科学管理","name":"百年呼应","des":"同向流程开刀：一个立标准，一个推倒重来。"},{"source":"流程再造","target":"组织文化","name":"依赖","des":"再造多败在文化不改，机器换了人心未换。"},{"source":"科特","target":"变革管理","name":"立论","des":"1996年《领导变革》八步曲，管理应对复杂而领导应对变革。"},{"source":"变革管理","target":"组织文化","name":"攻坚","des":"文化是变革最难的一关，八步里居其半。"},{"source":"情境领导理论","target":"X理论与Y理论","name":"细化","des":"光信Y不够，风格还须随成熟度调档。"},{"source":"情境领导理论","target":"权变理论","name":"归依","des":"风格随情境切换，正是权变观在带人上的落点。"},{"source":"菲德勒权变模型","target":"权变理论","name":"同源","des":"领导效能同样随情境三要素而变。"},{"source":"变革型领导","target":"变革管理","name":"领衔","des":"大变革须唤起超越自利的追随。"},{"source":"贝尔宾团队角色","target":"管理者十角色","name":"对照","des":"一个讲经理之角，一个讲队员之色。"},{"source":"变革管理","target":"战略管理","name":"执行","des":"战略改道必经变革这道窄门。"},{"source":"斯隆","target":"福特","name":"对垒","des":"T型车单一低价对多品牌分层，斯隆证明组织设计可胜产品执念。"},{"source":"非正式组织","target":"组织文化","name":"溯源","des":"派系与规矩是文化在日常的脸面。"},{"source":"福特","target":"流水线生产","name":"建成","des":"1913年移动装配线，底盘装配由十二小时半缩至九十三分钟。"},{"source":"流水线生产","target":"科学管理","name":"放大","des":"泰勒的标准化与分工搬上传送带。"},{"source":"流水线生产","target":"丰田生产方式","name":"反题","des":"大批量库存掩住浪费，丰田反其道把库存抽干。"},{"source":"大野耐一","target":"丰田生产方式","name":"缔造","des":"数十年打磨准时化与自働化两支柱。"},{"source":"丰田生产方式","target":"准时制JIT","name":"内核","des":"需要时按需要的量生产与领取。"},{"source":"大野耐一","target":"看板","name":"悟出","des":"美国超级市场补货启示的拉动信号。"},{"source":"看板","target":"准时制JIT","name":"实现","des":"卡片后拉前工序，库存降到见底以露问题。"},{"source":"精益生产","target":"丰田生产方式","name":"命名","des":"1990年《改变世界的机器》为其正名。"},{"source":"精益生产","target":"供应链管理","name":"延伸","des":"消除浪费的链条从厂内伸向厂外。"},{"source":"戴明","target":"全面质量管理TQM","name":"布道","des":"战后赴日讲学，十四点成质量经营纲领。"},{"source":"戴明","target":"PDCA循环","name":"推广","des":"承休哈特而名扬，世称戴明环。"},{"source":"PDCA循环","target":"全面质量管理TQM","name":"引擎","des":"转一轮上一格，持续改进不停表。"},{"source":"朱兰","target":"全面质量管理TQM","name":"并立","des":"质量三部曲与帕累托聚焦，日本复兴双师之一。"},{"source":"石川馨","target":"全面质量管理TQM","name":"本土化","des":"因果图与QC小组，全员参与的日本版本。"},{"source":"全面质量管理TQM","target":"精益生产","name":"相通","des":"都信浪费可除、改善无涯。"},{"source":"六西格玛","target":"全面质量管理TQM","name":"升级","des":"统计质控加项目制，并与财务问责挂钩。"},{"source":"卓越绩效模式","target":"全面质量管理TQM","name":"制度化"