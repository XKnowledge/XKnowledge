arget":"社会运动","name":"汇入","des":"平权运动一再改写政治的边界。"},{"source":"民粹主义","target":"民主","name":"反噬","des":"以人民之名绕开代议制的双刃剑。"},{"source":"民粹主义","target":"政党体系","name":"冲击","des":"主流政党精英化给民粹留下真空。"},{"source":"熊彼特","target":"民主","name":"重述","des":"民主是精英竞争选票的方法而非人民当家。"},{"source":"达尔","target":"多元政体","name":"提出","des":"多元政体七条件使民主可测量比较。"},{"source":"多元政体","target":"民主","name":"操作化","des":"竞争与参与两维度撑起操作化定义。"},{"source":"达尔","target":"利益集团","name":"考察","des":"《谁统治》以纽黑文证明多头统治。"},{"source":"亨廷顿","target":"第三波民主化","name":"命名","des":"1991年概括1974年葡萄牙以来的浪潮。"},{"source":"第三波民主化","target":"民主化","name":"展开","des":"南欧、拉美与东亚相继转向民主。"},{"source":"民主化","target":"威权主义","name":"转型","des":"转型与威权韧性是当代比较政治主战场。"},{"source":"极权主义","target":"威权主义","name":"递进","des":"极权要重塑人性，威权止于垄断政权。"},{"source":"威权主义","target":"民主","name":"替代","des":"当代非民主统治的主要形态与镜像。"},{"source":"阿伦特","target":"极权主义的起源","name":"著就","des":"1951年追索极权主义的思想根源。"},{"source":"极权主义的起源","target":"极权主义","name":"解剖","des":"原子化群众、意识形态与恐怖的三位一体。"},{"source":"君主制","target":"政体分类","name":"出自","des":"一人统治的正宗与僭主变态。"},{"source":"共和制","target":"政体分类","name":"出自","des":"公共利益导向的多数统治及其变态。"},{"source":"议会制","target":"总统制","name":"对照","des":"融合型与分立型两种行政立法关系。"},{"source":"议会制","target":"政党","name":"依赖","des":"内阁产生于议会多数的信任。"},{"source":"总统制","target":"分权制衡","name":"体现","des":"各自正当性与固定任期互不隶属。"},{"source":"联邦制","target":"单一制","name":"对照","des":"纵向分权与集中授权两种国家结构。"},{"source":"联邦制","target":"现代国家","name":"结构","des":"国家权力的纵向设计成为稳定器。"},{"source":"选举制度","target":"多数制","name":"类型","des":"领先者当选的赢者通吃规则。"},{"source":"选举制度","target":"比例代表制","name":"类型","des":"席位按得票比例分配的规则。"},{"source":"迪韦尔热定律","target":"多数制","name":"归纳","des":"机械与心理因素共同催生两党制。"},{"source":"迪韦尔热定律","target":"政党体系","name":"塑造","des":"选举规则深刻塑造政党数目。"},{"source":"比例代表制","target":"政党体系","name":"温床","des":"多党联合政府的制度温床。"},{"source":"萨托利","target":"政党体系","name":"精研","des":"1976年厘清政党体制的类型学。"},{"source":"政党","target":"政治参与","name":"动员","des":"把散落的诉求汇成执政纲领。"},{"source":"选举制度","target":"政党","name":"塑造","des":"选举规则决定政党竞争的形态。"},{"source":"马克斯·韦伯","target":"官僚制","name":"刻画","des":"法理型支配的非人格化机器。"},{"source":"马克斯·韦伯","target":"合法性","name":"分型","des":"传统、魅力与法理三型正当性。"},{"source":"马克斯·韦伯","target":"现代国家","name":"定义","des":"国家是在疆域内合法垄断暴力者。"},{"source":"官僚制","target":"现代国家","name":"骨架","des":"持续行政使国家摆脱家产制的偶然。"},{"source":"施米特","target":"主权","name":"决断","des":"主权者是决断非常状态之人。"},{"source":"施米特","target":"自由主义","name":"批判","des":"中立化的自由主义无力辨识敌人。"},{"source":"亨廷顿","target":"变化社会中的政治秩序","name":"著就","des":"1968年提出秩序先于发展的命题。"},{"source":"变化社会中的政治秩序","target":"政治参与","name":"失衡","des":"参与扩张超过制度化即生动荡。"},{"source":"变化社会中的政治秩序","target":"政党","name":"药方","des":"强大的政党组织是政治秩序之源。"},{"source":"阿尔蒙德","target":"政治文化","name":"开创","des":"1963年《公民文化》五国比较。"},{"source":"政治文化","target":"政治社会化","name":"传递","des":"政治态度经代际传递而延续。"},{"source":"政治社会化","target":"政治文化","name":"维系","des":"家庭、学校与媒介是政治的课堂。"},{"source":"政治参与","target":"民主","name":"刻度","des":"参与的广度与深度检验民主质量。"},{"source":"利益集团","target":"政治参与","name":"组织化","des":"组织化利益的政策影响通道。"},{"source":"社会运动","target":"政治参与","name":"升级","des":"体制外集体施压的非常规形式。"},{"source":"社会运动","target":"革命","name":"相邻","des":"运动激进化可能通向革命。"},{"source":"斯考切波","target":"革命","name":"重释","des":"1979年《国家与社会革命》的国家中心解释。"},{"source":"革命","target":"现代国家","name":"造就","des":"现代国家既是革命的场域也是其产物。"},{"source":"公共领域","target":"公民社会","name":"场所","des":"辩论空间居于国家与社会之间。"},{"source":"哈贝马斯","target":"公共领域","name":"提出","des":"1962年《公共领域的结构转型》。"},{"source":"哈贝马斯","target":"协商民主","name":"奠基","des":"沟通理性导向审议的政治。"},{"source":"协商民主","target":"民主","name":"深化","des":"先审议后表决的程序性理想。"},{"source":"唐斯","target":"理性选择理论","name":"移植","des":"1957年《民主的经济理论》开其先河。"},{"source":"唐斯","target":"政党","name":"建模","des":"意识形态空间中的中位选民均衡。"},{"source":"奥尔森","target":"理性选择理论","name":"拓展","des":"1965年《集体行动的逻辑》。"},{"source":"奥尔森","target":"利益集团","name":"悖论","des":"搭便车使大集团反而难以组织。"},{"source":"国际关系","target":"政治学","name":"领域","des":"战间期从政治学自立门户的分支。"},{"source":"威斯特伐利亚体系","target":"国际关系","name":"奠基","des":"1648年和约确立主权国家秩序。"},{"source":"威斯特伐利亚体系","target":"主权","name":"制度化","des":"主权国家自此成为秩序的基本单位。"},{"source":"摩根索","target":"国家间政治","name":"著就","des":"1948年权力政治学的教科书范本。"},{"source":"摩根索","target":"现实主义（国际关系）","name":"奠基","des":"六原则以权力界定国家利益。"},{"source":"沃尔兹","target":"结构现实主义","name":"创立","des":"1979年《国际政治理论》立体系层次。"},{"source":"结构现实主义","target":"现实主义（国际关系）","name":"更新","des":"解释层次由人性转向无政府结构。"},{"source":"基欧汉","target":"新自由制度主义","name":"奠基","des":"1984年《霸权之后》以制度解释合作。"},{"source":"新自由制度主义","target":"现实主义（国际关系）","name":"论战","des":"制度能否缓和无政府的困境。"},{"source":"温特","target":"建构主义（国际关系）","name":"创立","des":"1999年《国际政治的社会理论》。"},{"source":"建构主义（国际关系）","target":"现实主义（国际关系）","name":"质疑","des":"观念与身份先于物质性权力。"},{"source":"亨廷顿","target":"文明冲突论","name":"提出","des":"1993年断层线冲突之说掀起论战。"},{"source":"文明冲突论","target":"民主和平论","name":"对峙","des":"文明断层与民主和平两种战后想象。"},{"source":"约瑟夫·奈","target":"软实力","name":"提出","des":"1990年提出权力的第二副面孔。"},{"source":"软实力","target":"全球治理","name":"工具","des":"吸引力成为全球政治的新硬通货。"},{"source":"均势","target":"现实主义（国际关系）","name":"机制","des":"权力平衡是自助体系的稳定器。"},{"source":"安全困境","target":"结构现实主义","name":"派生","des":"一方防御即被他方读作进攻威胁。"},{"source":"联合国","target":"全球治理","name":"平台","des":"1945年集体安全与专门机构网络。"},{"source":"全球治理","target":"国际关系","name":"议程","des":"无世界政府而治理全球问题的难题。"},{"source":"康德","target":"永久和平论","name":"著就","des":"1795年共和、联盟与友好三条款。"},{"source":"民主和平论","target":"永久和平论","name":"远源","des":"统计检验让康德命题复活。"},{"source":"民主和平论","target":"民主","name":"外溢","des":"民主国家之间几乎不开战。"},{"source":"混合政体","target":"分权制衡","name":"遥启","des":"混合与制衡的思路隔代传向分权设计。"},{"source":"孔子","target":"教育学","name":"奠基","des":"首开私学，弟子三千，中国教育的元话语自此定调。"},{"source":"苏格拉底","target":"教育学","name":"源头","des":"与孔子东西并峙，问答与德性开启西方传统。"},{"source":"《学记》","target":"教育学","name":"立论","des":"世界最早的教育专论，教学相长等命题至今有效。"},{"source":"赫尔巴特","target":"教育学","name":"立学","des":"1806年《普通教育学》令教育学成为独立学科。"},{"source":"孔子","target":"有教无类","name":"主张","des":"有教无类四字，把门第的门槛踏平了一半。"},{"source":"孔子","target":"因材施教","name":"示范","des":"同一问题视对象作答，因材由此成为教学法。"},{"source":"孔子","target":"六艺","name":"传授","des":"以六艺教人，身通六艺者七十二人。"},{"source":"《学记》","target":"因材施教","name":"呼应","des":"长善而救其失，因材施教的另一种表述。"},{"source":"苏格拉底","target":"产婆术","name":"创用","des":"只问不答，真理由对话者自己分娩。"},{"source":"产婆术","target":"《学记》","name":"同调","des":"道而弗牵、强而弗抑，与助产术东西同音。"},{"source":"智者派","target":"苏格拉底","name":"前驱","des":"同在雅典街头授业，苏格拉底不收费且追问更凶。"},{"source":"智者派","target":"昆体良","name":"承续","des":"从街头教人论辩，到著书论雄辩家的培养。"},{"source":"昆体良","target":"《大教学论》","name":"先声","des":"分级教学的设想，隔千年被夸美纽斯接续放大。"},{"source":"七艺","target":"中世纪大学","name":"构成","des":"七艺是文学院的看家课程，学位由此起步。"},{"source":"中世纪大学","target":"教育学","name":"源流","des":"自治行会的学位与学部，现代高等教育的发端。"},{"source":"六艺","target":"七艺","name":"并称","des":"东西方古典课程的双璧，皆文武或文理兼备。"},{"source":"书院","target":"科举制度","name":"相伴","des":"书院讲学与科举取士，一雅一俗撑起传统教育。"},{"source":"书院","target":"中世纪大学","name":"并称","des":"东西方两种讲学自治传统，各自成型。"},{"source":"有教无类","target":"义务教育","name":"先声","des":"有教无类两千三百年后写进法律。"},{"source":"夸美纽斯","target":"《大教学论》","name":"写就","des":"1632年成书，教育学的第一部系统蓝图。"},{"source":"《大教学论》","target":"班级授课制","name":"论证","des":"一位教师教一群学生的经济性首次得到系统辩护。"},{"source":"夸美纽斯","target":"泛智教育","name":"力主","des":"把一切知识教给一切人，口号即纲领。"},{"source":"泛智教育","target":"《大教学论》","name":"贯穿","des":"泛智理想撑起全书的学制与课程设计。"},{"source":"泛智教育","target":"义务教育","name":"先声","des":"教给一切人的愿望，是普及教育的最早宣言。"},{"source":"赫尔巴特","target":"班级授课制","name":"适配","des":"四段教学法正是为班级讲授量身裁衣。"},{"source":"卢梭","target":"《爱弥儿》","name":"写就","des":"1762年的教育小说，出版即遭焚毁。"},{"source":"《爱弥儿》","target":"自然教育","name":"阐发","des":"爱弥儿的成长即自然教育的示范课。"},{"source":"卢梭","target":"自然教育","name":"力主","des":"教育须顺应天性，成人勿要拔苗。"},{"source":"自然教育","target":"儿童中心","name":"预言","des":"解放儿童的呐喊，一百五十年后由进步主义接棒。"},{"source":"卢梭","target":"裴斯泰洛齐","name":"启发","des":"卢梭的信徒，把自然教育做成孤儿院里的功课。"},{"source":"裴斯泰洛齐","target":"要素教育","name":"提出","des":"拆到最简要素再逐级教，初等教育的脚手架。"},{"source":"要素教育","target":"程序教学","name":"先声","des":"最小步子逐级递进，两百年后复活于教学机器。"},{"source":"赫尔巴特","target":"四段教学法","name":"创立","des":"明了、联想、系统、方法，课堂的公文程式。"},{"source":"赫尔巴特","target":"教育性教学","name":"主张","des":"无教学的教育与无教育的教学皆不存在。"},{"source":"赫尔巴特","target":"统觉","name":"引入","des":"以统觉说明新知识如何挂上旧经验。"},{"source":"统觉","target":"四段教学法","name":"支撑","des":"新旧观念的统觉过程，正是四步的心理学依据。"},{"source":"赫尔巴特","target":"杜威","name":"对峙","des":"传统教育派与现代教育派，课堂重心之争的总纲。"},{"source":"杜威","target":"教育即生长","name":"提出","des":"教育即生活、即生长、即经验的改造。"},{"source":"杜威","target":"做中学","name":"力行","des":"芝加哥实验学校把课堂改成工坊。"},{"source":"杜威","target":"儿童中心","name":"转向","des":"重心从教师教材移到儿童，哥白尼式的倒转。"},{"source":"教育即生长","target":"儿童中心","name":"同源","des":"生长的隐喻与中心的转移，同一场革命的两种说法。"},{"source":"杜威","target":"《民主主义与教育》","name":"写就","des":"1916年把教育放进民主社会的框架。"},{"source":"《民主主义与教育》","target":"《爱弥儿》","name":"并称","des":"与《大教学论》同为教育史三座里程碑。"},{"source":"杜威","target":"进步主义教育","name":"领衔","des":"实验学校与著述，运动的理论发动机。"},{"source":"进步主义教育","target":"设计教学法","name":"孕育","des":"运动需要可操作的课堂方案，设计教学法应声而出。"},{"source":"克伯屈","target":"设计教学法","name":"提出","des":"1918年给出有目的活动的单元方案。"},{"source":"克伯屈","target":"杜威","name":"追随","des":"最卖力的布道者，把做中学落成教案。"},{"source":"设计教学法","target":"活动课程","name":"落地","des":"活动课程的讲义版，按设计单元重排课堂。"},{"source":"杜威","target":"活动课程","name":"试验","des":"芝加哥学校把课程拴在儿童的活动上。"},{"source":"蒙台梭利","target":"儿童之家","name":"创办","des":"1907年罗马贫民区的第一间实验室。"},{"source":"蒙台梭利","target":"进步主义教育","name":"同盟","des":"欧洲新教育运动与美国进步主义互为呼应。"},{"source":"蒙台梭利","target":"儿童中心","name":"呼应","des":"有准备的环境里，儿童自己已是中心。"},{"source":"自然教育","target":"儿童之家","name":"落地","des":"依天性布置环境，卢梭的纲领落进罗马贫民窟。"},{"source":"陶行知","target":"杜威","name":"师承","des":"留学哥伦比亚师从杜威，归国后把命题整个倒转。"},{"source":"陶行知","target":"生活教育","name":"创立","des":"生活即教育、社会即学校、教学做合一。"},{"source":"生活教育","target":"做中学","name":"转写","des":"教学做合一是做中学的中国方言。"},{"source":"晏阳初","target":"陶行知","name":"同道","des":"同办平民教育，一个进定县，一个下乡村。"},{"source":"苏霍姆林斯基","target":"凯洛夫","name":"同门异趣","des":"同出苏联教育学传统，一个重知识体系，一个重个性与阅读。"},{"source":"要素主义","target":"进步主义教育","name":"论战","des":"1938年巴格莱发难，斥其掏空系统知识。"},{"source":"永恒主义","target":"进步主义教育","name":"论战","des":"赫钦斯阵营斥其为反智的放纵。"},{"source":"要素主义","target":"赫尔巴特","name":"回归","des":"重提系统知识传授，旧学统卷土重来。"},{"source":"要素主义","target":"学科课程","name":"同盟","des":"分科课程是系统知识传递的老阵地。"},{"source":"永恒主义","target":"七艺","name":"复古","des":"书单换了，古典训练的逻辑未变。"},{"source":"桑代克","target":"试误学习","name":"发现","des":"迷笼里的猫，学习即试误的渐进减少。"},{"source":"桑代克","target":"教育心理学","name":"创立","des":"1903年同名著作，宣布学科的诞生。"},{"source":"巴甫洛夫","target":"斯金纳","name":"对照","des":"一个刺激在先，一个后果在后，条件作用的两个范式。"},{"source":"斯金纳","target":"操作性条件作用","name":"创立","des":"后果挑选行为，强化是那把筛子。"},{"source":"斯金纳","target":"程序教学","name":"发明","des":"把强化原理做成教学机器与程序教材。"},{"source":"程序教学","target":"计算机辅助教学","name":"演进","des":"小步子与即时反馈，原样搬进机房课件。"},{"source":"程序教学","target":"教学设计","name":"影响","des":"小步子与反馈成了教学设计的看家口诀。"},{"source":"格式塔学派","target":"顿悟学习","name":"孕育","des":"整体与重组的知觉传统，养出顿悟的猩猩。"},{"source":"顿悟学习","target":"试误学习","name":"论战","des":"猩猩的顿悟反衬迷笼中猫的盲目。"},{"source":"布鲁纳","target":"发现学习","name":"提出","des":"让学生像小科学家那样自己找到结论。"},{"source":"布鲁纳","target":"学科基本结构","name":"主张","des":"学结构胜于记事实，应对知识爆炸。"},{"source":"发现学习","target":"学科基本结构","name":"配套","des":"结构要靠学生自己发现，而非教师和盘托出。"},{"source":"布鲁纳","target":"杜威","name":"承续","des":"从做中学到发现学习，认知转向中一脉相续。"},{"source":"奥苏贝尔","target":"有意义学习","name":"提出","des":"新知识与旧认知结构的实质性联系。"},{"source":"奥苏贝尔","target":"先行组织者","name":"发明","des":"讲新课前先抛概括框架，预搭锚点。"},{"source":"有意义学习","target":"发现学习","name":"论战","des":"接受未必被动，发现未必有意义，两种课堂的拉锯。"},{"source":"先行组织者","target":"有意义学习","name":"服务","des":"先搭锚点，意义联系才有处可挂。"},{"source":"先行组织者","target":"教学设计","name":"入列","des":"成为教案开头的标准动作。"},{"source":"奥苏贝尔","target":"教育心理学","name":"汇入","des":"与布鲁纳的论战同写这门学科的黄金时代。"},{"source":"建构主义（教育学）","target":"皮亚杰","name":"汇源","des":"发生认识论为建构主义备好概念。"},{"source":"建构主义（教育学）","target":"维果茨基","name":"汇源","des":"社会文化一脉，撑起课堂里的对话与协作。"},{"source":"皮亚杰","target":"同化与顺应","name":"刻画","des":"两台发动机带动图式的生长。"},{"source":"同化与顺应","target":"建构主义（教育学）","name":"供料","des":"适应与平衡的机制，被搬成知识是建构的论据。"},{"source":"维果茨基","target":"皮亚杰","name":"对照","des":"个体建构与社会内化，发展研究的两条路线。"},{"source":"维果茨基","target":"最近发展区","name":"提出","des":"独立所能与协助所能之间的地带。"},{"source":"最近发展区","target":"支架式教学","name":"引出","des":"区既划定，脚手架便有了搭处。"},{"source":"支架式教学","target":"建构主义（教育学）","name":"落地","des":"建构主义课堂里最常见的操作方案。"},{"source":"观察学习","target":"试误学习","name":"修正","des":"不必亲自试错，看榜样的代价即可学会。"},{"source":"班杜拉","target":"自我效能感","name":"提出","des":"胜任信念比真实能力更能预测坚持。"},{"source":"自我效能感","target":"掌握学习","name":"相通","des":"相信能学会与真的学会，互为因果。"},{"source":"加涅","target":"信息加工理论","name":"引入","des":"以编码储存提取统整学习研究。"},{"source":"信息加工理论","target":"教学设计","name":"供给","des":"九大教学事件即按信息加工流程排定。"},{"source":"建构主义（教育学）","target":"教学设计","name":"改写","des":"从客观主义方案转向以学习者为中心。"},{"source":"泰勒（课程理论）","target":"泰勒原理","name":"凝成","des":"1949年小册子四问，课程领域的公理。"},{"source":"泰勒原理","target":"教学评价","name":"奠基","des":"第四问令评价成为课程开发的内置环节。"},{"source":"泰勒（课程理论）","target":"布卢姆","name":"影响","des":"同在芝加哥的测量传统，分类学接着目标问题往下说。"},{"source":"泰勒原理","target":"教学设计","name":"奠基","des":"教学设计流程的血脉里流着四个问题。"},{"source":"学科课程","target":"活动课程","name":"论战","des":"知识逻辑与儿童逻辑，课程领域的百年拉锯。"},{"source":"隐性课程","target":"泰勒原理","name":"补充","des":"四问之外，学校还在悄悄教着第四张课表。"},{"source":"布卢姆","target":"教育目标分类学","name":"创立","des":"认知目标的六级阶梯，量尺自此统一。"},{"source":"布卢姆","target":"掌握学习","name":"提出","des":"给足时间反馈，人人可达标。"},{"source":"教育目标分类学","target":"泰勒原理","name":"配套","des":"目标先行，分类学把目标磨成可测的术语。"},{"source":"教育目标分类学","target":"掌握学习","name":"支撑","des":"目标分层之后，达标才有刻度可依。"},{"source":"掌握学习","target":"形成性评价","name":"依托","des":"及时反馈补教再测，形成性评价是引擎。"},{"source":"掌握学习","target":"班级授课制","name":"调适","des":"不拆班级而给足时间，群体中求个别化。"},{"source":"形成性评价","target":"教学评价","name":"属于","des":"三分类型中距改进最近的一种。"},{"source":"学科基本结构","target":"学科课程","name":"深化","des":"六十年代课程改革把分科推向结构化。"},{"source":"凯洛夫","target":"赫尔巴特","name":"承续","des":"五环节课堂实为四段法的苏联放大版。"},{"source":"凯洛夫","target":"赞可夫","name":"论战","des":"赞可夫的发展直接挑战知识本位。"},{"source":"赞可夫","target":"维果茨基","name":"承续","des":"教学走在发展前面直接取自最近发展区。"},{"source":"巴班斯基","target":"凯洛夫","name":"后继","des":"苏联教学论的收束者，各家原则拢进最优化。"},{"source":"巴班斯基","target":"教学设计","name":"相通","des":"给定约束下求最优方案，与教学设计同构。"},{"source":"学制（中国）","target":"义务教育","name":"承载","des":"义务教育写进学制的底端几格。"},{"source":"科举制度","target":"学制（中国）","name":"让位","des":"1905年科举一废，新式学校与学制才真正铺开。"},{"source":"科举制度","target":"教学评价","name":"远祖","des":"以考试取士的制度，文官考试与教育测验的远祖。"},{"source":"朗格朗","target":"终身教育","name":"提出","des":"1965年教科文会议的议案，改写教育的时间表。"},{"source":"终身教育","target":"义务教育","name":"超越","des":"受教育权从学龄段扩展到整个人生。"},{"source":"终身教育","target":"慕课","name":"延伸","des":"人人处处可学，技术终于追上理念。"},{"source":"洪堡","target":"柏林大学","name":"创办","des":"1810年手创，教研合一由此立规。"},{"source":"柏林大学","target":"中世纪大学","name":"革新","des":"保留自治与学位，新增研究与学术自由。"},{"source":"教育心理学","target":"建构主义（教育学）","name":"推手","des":"八九十年代学习理论的主角换成建构主义。"},{"source":"布迪厄","target":"教育社会学","name":"领衔","des":"再生产分析使教育社会学进入理论中心。"},{"source":"布迪厄","target":"文化资本","name":"提出","des":"谈吐趣味与文凭皆资本，代际传递。"},{"source":"布迪厄","target":"教育再生产","name":"立论","des":"1970年《再生产》给出判词。"},{"source":"文化资本","target":"教育再生产","name":"驱动","des":"家庭馈赠的文化资本，在校兑换成成绩与文凭。"},{"source":"教育再生产","target":"义务教育","name":"质询","des":"普及的学校为何未能抹平出身的差距。"},{"source":"教育技术学","target":"视听教学","name":"起家","des":"名称几经更迭，源头在视听教育运动。"},{"source":"视听教学","target":"程序教学","name":"合流","des":"六十年代视听教育与教学机器合为教学技术。"},{"source":"计算机辅助教学","target":"慕课","name":"铺路","des":"从单机课件到联网开放课程，三步并作一步。"},{"source":"人工智能教育","target":"慕课","name":"接棒","des":"大规模之后是个性化，自适应接棒开课。"},{"source":"人工智能教育","target":"因材施教","name":"复兴","des":"两千年的因材理想，交给算法一试。"},{"source":"人工智能教育","target":"教育技术学","name":"前沿","des":"教育技术的最新一页，也是争议最烈的一页。"},{"source":"人工智能教育","target":"形成性评价","name":"加持","des":"学情画像把形成性反馈做到每道题。"},{"source":"比较教育","target":"教育学","name":"分支","des":"以跨国之眼为各国教育互为镜鉴。"},{"source":"比较教育","target":"学制（中国）","name":"镜鉴","des":"癸卯仿日、壬戌仿美，皆比较之功。"},{"source":"德育","target":"教育学","name":"支柱","des":"与智育体育并列，却又无处不在。"},{"source":"德育","target":"教育性教学","name":"呼应","des":"德育与教学不可分，赫尔巴特早有此言。"},{"source":"科尔伯格","target":"道德发展阶段","name":"提出","des":"三水平六阶段，判断力随年龄攀爬。"},{"source":"道德发展阶段","target":"皮亚杰","name":"承续","des":"在他律到自律的框架上再加阶梯。"},{"source":"科尔伯格","target":"德育","name":"供给","des":"两难讨论自此进入德育课堂。"},{"source":"苏霍姆林斯基","target":"德育","name":"躬行","des":"把德育做在劳动与阅读里，而非说教里。"},{"source":"教育社会学","target":"班级授课制","name":"观察","des":"几十人的班级即小社会，分层在此排练。"},{"source":"观察学习","target":"隐性课程","name":"相通","des":"榜样与暗流，都在正经课程之外教人。"},{"source":"教育社会学","target":"教育学","name":"分支","des":"以社会学之眼研究教育现象。"},{"source":"教育技术学","target":"教育学","name":"分支","des":"以工程之术介入怎样教的老问题。"},{"source":"教育心理学","target":"教育学","name":"分支","des":"以心理学之眼研究学习与教学。"},{"source":"集合","target":"映射","name":"引出","des":"集合之间的对应规则催生映射概念。"},{"source":"映射","target":"函数","name":"特化为","des":"定义域与值域都在实数集内的映射即函数。"},{"source":"函数","target":"复合函数","name":"叠成","des":"一个函数的输出作另一个的输入即复合。"},{"source":"函数","target":"反函数","name":"反转为","des":"对应关系逆转即得反函数，需一一对应。"},{"source":"反函数","target":"单调性","name":"依托","des":"严格单调保证一一对应，是反函数存在的充分条件。"},{"source":"函数","target":"奇偶性","name":"呈现","des":"奇偶性描述函数图像的对称特征。"},{"source":"初等函数","target":"幂函数","name":"包含","des":"幂函数是基本初等函数之一。"},{"source":"初等函数","target":"指数函数","name":"包含","des":"指数函数是基本初等函数之一。"},{"source":"初等函数","target":"对数函数","name":"包含","des":"对数函数是基本初等函数之一。"},{"source":"初等函数","target":"三角函数","name":"包含","des":"三角函数是基本初等函数之一。"},{"source":"指数函数","target":"对数函数","name":"互逆","des":"同底的指数函数与对数函数互为反函数。"},{"source":"三角函数","target":"周期性","name":"体现","des":"三角函数是周期性最典型的载体。"},{"source":"极限","target":"数列极限","name":"表现为","des":"极限思想在离散数列上的具体形态。"},{"source":"极限","target":"函数极限","name":"表现为","des":"极限思想在连续变量上的具体形态。"},{"source":"数列极限","target":"函数极限","name":"归结","des":"归结原理把函数极限化为数列极限处理。"},{"source":"无穷小量","target":"极限","name":"刻画","des":"函数有极限当且仅当可写为常数加无穷小。"},{"source":"无穷大量","target":"无穷小量","name":"互倒","des":"非零无穷大的倒数是无穷小，反之亦然。"},{"source":"等价无穷小","target":"无穷小量","name":"比较","des":"比值极限为一的无穷小彼此等价，可替换求极限。"},{"source":"极限四则运算法则","target":"极限","name":"实施","des":"把复杂函数的极限拆解为简单极限的四则运算。"},{"source":"夹逼准则","target":"数列极限","name":"判定","des":"夹逼是证明数列极限存在的常用手段。"},{"source":"函数连续","target":"函数极限","name":"立足","des":"连续的本质是极限值恰等于该点的函数值。"},{"source":"间断点","target":"函数连续","name":"破坏","des":"间断点正是连续性失效的位置。"},{"source":"闭区间连续函数性质","target":"函数连续","name":"强化","des":"闭区间加连续导出有界、最值与介值三大性质。"},{"source":"介值定理","target":"闭区间连续函数性质","name":"属于","des":"介值定理是闭区间连续函数的标志性性质。"},{"source":"零点定理","target":"介值定理","name":"特化为","des":"取中间值为零即得零点存在定理。"},{"source":"渐近线","target":"函数极限","name":"取决于","des":"渐近线的位置由相应的极限确定。"},{"source":"导数","target":"左右导数","name":"细分为","des":"左右两侧差商的极限分别给出左右导数。"},{"source":"求导法则","target":"导数","name":"规范","des":"四则与反函数求导法则让求导有章可循。"},{"source":"链式法则","target":"求导法则","name":"隶属于","des":"链式法则是复合函数求导的核心法则。"},{"source":"高阶导数","target":"导数","name":"反复而得","des":"对导数再求导即得高阶导数。"},{"source":"微分","target":"导数","name":"等价","des":"一元情形可微与可导等价，dy=f'(x)dx。"},{"source":"微分中值定理","target":"导数","name":"架桥于","des":"在导数与函数整体性态之间架起桥梁。"},{"source":"罗尔定理","target":"微分中值定理","name":"奠基","des":"罗尔定理是最简洁的中值定理原型。"},{"source":"拉格朗日中值定理","target":"微分中值定理","name":"领衔","des":"应用最广的中值定理，微分学的核心。"},{"source":"柯西中值定理","target":"拉格朗日中值定理","name":"推广","des":"参数化两个函数后得到比值形式的推广。"},{"source":"单调性与极值","target":"拉格朗日中值定理","name":"依据","des":"依中值定理用导数符号判定单调与极值。"},{"source":"凹凸性与拐点","target":"单调性与极值","name":"深化","des":"在升降基础上进一步刻画弯曲方向。"},{"source":"最值问题","target":"单调性与极值","name":"归结为","des":"最值在极值点与区间端点中产生。"},{"source":"洛必达法则","target":"柯西中值定理","name":"源自","des":"洛必达法则由柯西中值定理推出。"},{"source":"隐函数求导","target":"链式法则","name":"借用","des":"将 y 视为中间变量套用链式法则。"},{"source":"不定积分","target":"原函数","name":"汇集","des":"不定积分表示原函数的全体。"},{"source":"原函数存在定理","target":"原函数","name":"保证","des":"连续函数必存在原函数。"},{"source":"原函数存在定理","target":"变限积分","name":"构造","des":"变限积分给出原函数的显式构造。"},{"source":"变限积分","target":"定积分","name":"参数化","des":"积分上限变为变量，定积分变成函数。"},{"source":"牛顿-莱布尼茨公式","target":"定积分","name":"计算出","des":"定积分化为原函数在上下限的增量。"},{"source":"牛顿-莱布尼茨公式","target":"原函数","name":"依托","des":"公式把定积分计算归结为求原函数。"},{"source":"换元积分法","target":"不定积分","name":"求解","des":"换元是计算不定积分的基本手段。"},{"source":"分部积分法","target":"不定积分","name":"求解","des":"分部积分处理乘积型被积函数。"},{"source":"有理函数积分","target":"不定积分","name":"化归为","des":"部分分式分解后必可积出。"},{"source":"反常积分","target":"定积分","name":"推广至","des":"把积分推向无穷区间与无界函数。"},{"source":"微元法","target":"定积分","name":"生成","des":"微元累加的极限即定积分。"},{"source":"定积分应用","target":"微元法","name":"依循","des":"面积体积等应用均按微元法建模。"},{"source":"旋转体体积","target":"定积分应用","name":"属于","des":"旋转体体积是几何应用的代表。"},{"source":"积分中值定理","target":"定积分","name":"沟通","des":"沟通积分平均值与某点的函数值。"},{"source":"常数项级数","target":"收敛与发散","name":"取决于","des":"级数的命运取决于部分和数列是否有极限。"},{"source":"正项级数","target":"常数项级数","name":"归属于","des":"各项非负的基本级数类型。"},{"source":"比值判别法","target":"正项级数","name":"判别","des":"达朗贝尔判别法快速判定正项级数敛散。"},{"source":"交错级数","target":"常数项级数","name":"归属于","des":"正负交替的级数，莱布尼茨条件保证收敛。"},{"source":"绝对收敛与条件收敛","target":"收敛与发散","name":"细分","des":"收敛进一步区分为绝对与条件两级。"},{"source":"收敛半径","target":"幂级数","name":"界定","des":"收敛半径确定幂级数收敛区间的范围。"},{"source":"泰勒级数","target":"幂级数","name":"展开为","des":"泰勒级数是把函数展开成的幂级数。"},{"source":"麦克劳林级数","target":"泰勒级数","name":"特化为","des":"展开点取原点的泰勒级数即麦克劳林级数。"},{"source":"收敛半径","target":"比值判别法","name":"算出","des":"收敛半径由系数比的极限算得。"},{"source":"可分离变量方程","target":"微分方程","name":"隶属于","des":"最基础的一阶微分方程类型。"},{"source":"一阶线性微分方程","target":"微分方程","name":"隶属于","des":"线性一阶方程有统一通解公式。"},{"source":"二阶常系数线性微分方程","target":"微分方程","name":"隶属于","des":"特征根法是求解的主要途径。"},{"source":"一阶线性微分方程","target":"二阶常系数线性微分方程","name":"延拓到","des":"线性方程理论由一阶延拓至高阶。"},{"source":"行列式","target":"矩阵","name":"派生自","des":"行列式是方阵按规则算出的一个数。"},{"source":"矩阵运算","target":"矩阵","name":"作用于","des":"加乘转置等运算构成矩阵代数骨架。"},{"source":"逆矩阵","target":"矩阵","name":"反转","des":"逆矩阵实现矩阵乘法意义的除法。"},{"source":"伴随矩阵","target":"逆矩阵","name":"表达出","des":"A^-1=A*/|A| 给出逆的显式表达。"},{"source":"行列式","target":"逆矩阵","name":"判定","des":"矩阵可逆当且仅当行列式非零。"},{"source":"矩阵的秩","target":"矩阵","name":"刻画","des":"秩是矩阵在初等变换下不变的数字特征。"},{"source":"初等变换","target":"矩阵的秩","name":"求出","des":"行变换化阶梯形后直接读出秩。"},{"source":"矩阵","target":"向量组","name":"拆分为","des":"矩阵按列拆开即得一个向量组。"},{"source":"线性相关性","target":"向量组","name":"审视","des":"相关性审视向量组内有无多余向量。"},{"source":"极大无关组","target":"线性相关性","name":"提炼自","des":"从向量组提炼出线性无关的极大骨架。"},{"source":"向量组的秩","target":"极大无关组","name":"计数为","des":"向量组的秩即极大无关组的向量个数。"},{"source":"矩阵的秩","target":"向量组的秩","name":"统一于","des":"矩阵的秩等于其列向量组的秩。"},{"source":"线性方程组","target":"矩阵","name":"写成","des":"方程组浓缩为 Ax=b 的矩阵形式。"},{"source":"齐次方程组","target":"线性方程组","name":"伴随","des":"非齐次组必伴随一个导出的齐次组。"},{"source":"基础解系","target":"齐次方程组","name":"张成","des":"基础解系的线性组合生成全部解。"},{"source":"矩阵的秩","target":"齐次方程组","name":"决定","des":"秩决定自由未知量数即解空间维数。"},{"source":"特征值与特征向量","target":"矩阵","name":"刻画","des":"特征对揭示矩阵变换的本征方向。"},{"source":"相似对角化","target":"特征值与特征向量","name":"依赖","des":"n 个无关特征向量是可对角化的关键。"},{"source":"相似对角化","target":"矩阵运算","name":"简化","des":"对角化后求幂等运算大幅简化。"},{"source":"二次型","target":"矩阵","name":"对应于","des":"每个二次型对应唯一的实对称矩阵。"},{"source":"正定二次型","target":"二次型","name":"分类于","des":"正定性是二次型最重要的分类标准。"},{"source":"特征值与特征向量","target":"正定二次型","name":"判定","des":"实对称阵正定当且仅当特征值全正。"},{"source":"线性空间","target":"向量组","name":"容纳","des":"线性空间为向量组提供公理化舞台。"},{"source":"线性变换","target":"线性空间","name":"作用于","des":"线性变换是空间到自身保结构的映射。"},{"source":"线性变换","target":"矩阵","name":"表示为","des":"取定基后线性变换与矩阵一一对应。"},{"source":"函数极限","target":"函数","name":"考察","des":"函数极限研究自变量变化时函数值的趋势。"},{"source":"函数连续","target":"函数","name":"刻画","des":"连续刻画函数连绵不断的天然属性。"},{"source":"对数函数","target":"渐近线","name":"具有","des":"对数函数的图像有铅直渐近线 x=0。"},{"source":"闭区间连续函数性质","target":"有界性","name":"保证","des":"闭区间连续函数必有界，有界性的免费来源。"},{"source":"三角函数","target":"等价无穷小","name":"生成","des":"sin x~x 等常用等价无穷小源自三角函数。"},{"source":"导数","target":"函数","name":"度量","des":"导数量化函数的瞬时变化率。"},{"source":"单调性与极值","target":"单调性","name":"判定","des":"用导数符号严格判定函数的单调性。"},{"source":"复合函数","target":"链式法则","name":"依赖","des":"复合函数求导依赖链式法则层层展开。"},{"source":"求导法则","target":"反函数","name":"适用于","des":"反函数求导法则给出导数的倒数关系。"},{"source":"三角函数","target":"高阶导数","name":"循环","des":"sin x 的 n 阶导数按四阶循环。"},{"source":"对数函数","target":"求导法则","name":"辅助于","des":"对数求导法处理幂指函数与连乘式。"},{"source":"换元积分法","target":"三角函数","name":"借用","des":"三角换元处理含根号的二次式积分。"},{"source":"有理函数积分","target":"幂函数","name":"拆解为","des":"部分分式最终化为幂函数型分式积分。"},{"source":"不定积分","target":"对数函数","name":"给出","des":"1/x 的不定积分是对数函数。"},{"source":"指数函数","target":"分部积分法","name":"登场于","des":"指数函数与多项式搭配是分部积分典型。"},{"source":"定积分应用","target":"奇偶性","name":"利用","des":"对称区间上奇偶性可简化定积分。"},{"source":"麦克劳林级数","target":"指数函数","name":"展开","des":"e^x=Σx^n/n! 是最经典的展开式。"},{"source":"麦克劳林级数","target":"三角函数","name":"展开","des":"sin x 与 cos x 都有经典幂级数展开。"},{"source":"傅里叶级数","target":"三角函数","name":"分解为","des":"傅里叶级数把周期函数分解为三角函数之和。"},{"source":"傅里叶级数","target":"周期性","name":"立足于","des":"傅里叶展开以函数的周期性为前提。"},{"source":"常数项级数","target":"数列极限","name":"归结为","des":"级数敛散即部分和数列的极限问题。"},{"source":"导数","target":"函数极限","name":"定义为","des":"导数定义为差商当 Δx→0 的极限。"},{"source":"洛必达法则","target":"等价无穷小","name":"配合","des":"求极限时常与等价无穷小替换配合使用。"},{"source":"拉格朗日中值定理","target":"函数连续","name":"要求","des":"中值定理要求闭区间连续开区间可导。"},{"source":"导数","target":"函数连续","name":"蕴含","des":"可导必连续，连续是可导的必要条件。"},{"source":"定积分","target":"函数极限","name":"定义为","des":"定积分是黎曼和当分割无限细的极限。"},{"source":"积分中值定理","target":"介值定理","name":"证明靠","des":"积分中值定理的证明用到介值定理。"},{"source":"原函数存在定理","target":"函数连续","name":"立足于","des":"连续是原函数存在的充分条件。"},{"source":"变限积分","target":"函数连续","name":"继承","des":"被积函数连续时变限积分连续且可导。"},{"source":"原函数","target":"导数","name":"定义于","des":"原函数由导数等式 F'=f 来定义。"},{"source":"牛顿-莱布尼茨公式","target":"微分","name":"联结","des":"公式揭示微分与积分互逆的深刻联系。"},{"source":"换元积分法","target":"链式法则","name":"逆转","des":"换元积分法是链式法则的逆推。"},{"source":"分部积分法","target":"求导法则","name":"逆转","des":"分部积分由乘积求导法则移项而来。"},{"source":"微元法","target":"微分","name":"凭借","des":"微元法以微分近似增量再累加求和。"},{"source":"洛必达法则","target":"变限积分","name":"处理","des":"含变限积分的未定式极限常需洛必达。"},{"source":"积分中值定理","target":"拉格朗日中值定理","name":"对偶","des":"积分中值定理与微分中值定理形式对偶。"},{"source":"微分方程","target":"导数","name":"含有","des":"微分方程是含未知函数导数的方程。"},{"source":"泰勒级数","target":"高阶导数","name":"取决于","des":"泰勒系数由展开点的各阶导数确定。"},{"source":"可分离变量方程","target":"不定积分","name":"化为","des":"分离变量后两端积分即得通解。"},{"source":"反常积分","target":"常数项级数","name":"类比","des":"无穷积分与级数敛散判别互相印证。"},{"source":"