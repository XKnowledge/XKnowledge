","des":"回鹘商团继承粟特商网"},{"source":"回鹘与高昌","target":"佛教东传","name":"转译","des":"回鹘文佛经的北道传承"},{"source":"数字与天文","target":"飞钱与汇票","name":"算术","des":"记账与汇兑依赖计算术"},{"source":"黑死病沿路","target":"蒙古治世","name":"阴影","des":"1347年围城抛尸的疫源"},{"source":"黑死病沿路","target":"威尼斯","name":"登陆","des":"墨西拿与热那亚的西传首站"},{"source":"张骞凿空","target":"班超与西域都护","name":"承续","des":"东汉再度经营西域"},{"source":"张骞凿空","target":"汗血马","name":"带回","des":"乌孙马与天马的情报"},{"source":"班超与西域都护","target":"甘英西使","name":"遣使","des":"使大秦止于条支海的西望"},{"source":"甘英西使","target":"绿洲丝路","name":"西尽","des":"汉使团沿干道的最远点"},{"source":"蒙古治世","target":"驿站系统","name":"骨架","des":"站赤网络的通衢保障"},{"source":"蒙古治世","target":"马可·波罗","name":"穿行","des":"大汗治下的顺畅旅程"},{"source":"蒙古治世","target":"柏朗嘉宾与鲁布鲁克","name":"放行","des":"教廷使节的蒙古宫廷之行"},{"source":"蒙古治世","target":"伊本·白图泰","name":"后继","des":"十四世纪穆斯林商网之旅"},{"source":"驿站系统","target":"飞钱与汇票","name":"互补","des":"官驿与民间信用并行"},{"source":"马可·波罗","target":"海路替代","name":"诱航","des":"游记点燃的西向寻路"},{"source":"伊本·白图泰","target":"泉州","name":"游历","des":"刺桐港见闻入其行纪"},{"source":"帖木儿帝国","target":"奥斯曼壁垒","name":"先声","des":"河中战乱抬高的商路成本"},{"source":"奥斯曼壁垒","target":"海路替代","name":"逼出","des":"绕行好望角的直接动因"},{"source":"丝路考古与藏经洞","target":"斯文·赫定与楼兰","name":"同潮","des":"西域考古大发现的时代"},{"source":"李希霍芬命名","target":"斯文·赫定与楼兰","name":"同门","des":"德语地理学界的丝路想象"},{"source":"丝绸之路申遗","target":"一带一路","name":"回响","des":"古路名义的现代再利用"},{"source":"丝绸之路申遗","target":"长安","name":"起点段","des":"廊道自长安天山起步"},{"source":"一带一路","target":"海上丝绸之路","name":"借用","des":"二十一世纪海上丝路之名"},{"source":"关市与商税","target":"敦煌","name":"验关","des":"玉门关的过所与检查"},{"source":"珊瑚与宝石","target":"海上丝绸之路","name":"回程","des":"海路回程货的代表"},{"source":"玻璃器","target":"长安","name":"出土","des":"地宫与贵族墓的波斯玻璃"},{"source":"香料","target":"马六甲","name":"集散","des":"丁香胡椒的集散税口"},{"source":"木","target":"火（五行）","name":"相生","des":"木性资火助其燃，柴薪化焰即木生火。"},{"source":"火（五行）","target":"土","name":"相生","des":"火焚成灰归于土，焦土反成滋养之基。"},{"source":"土","target":"金","name":"相生","des":"矿藏蕴结于山土之中，掘土乃见金。"},{"source":"金","target":"水（五行）","name":"相生","des":"金凝露而润生水，金属熔亦化为液。"},{"source":"水（五行）","target":"木","name":"相生","des":"水润则草木得滋，灌溉而后萌芽生。"},{"source":"木","target":"土","name":"相克","des":"树根穿土破块，木旺则疏泄土气。"},{"source":"土","target":"水（五行）","name":"相克","des":"筑堤御水，土厚则遏其泛流之势。"},{"source":"水（五行）","target":"火（五行）","name":"相克","des":"水至则火熄灭，泼水救火即此理。"},{"source":"火（五行）","target":"金","name":"相克","des":"烈焰能熔金石，火旺则金销为水。"},{"source":"金","target":"木","name":"相克","des":"刀斧伐木成材，金利则裁木之疯长。"},{"source":"阴阳","target":"五行","name":"衍化","des":"五行乃阴阳之细分，木火为阳、金水属阴。"},{"source":"阴阳","target":"阴阳互根","name":"互根","des":"阳根于阴、阴根于阳，互为存在的前提。"},{"source":"五行","target":"相生","name":"推演","des":"五行递相资生，次序为木火土金水。"},{"source":"五行","target":"相克","name":"推演","des":"五行间隔相制，次序为木土水火金。"},{"source":"相生","target":"制化","name":"相合","des":"生中有克方能制化，资生而不致过亢。"},{"source":"相克","target":"制化","name":"相合","des":"克中寓生方能制化，制约而不致绝灭。"},{"source":"制化","target":"亢害承制","name":"阐发","des":"亢则害、承乃制，制化失衡的自稳之道。"},{"source":"木","target":"肝","name":"配属","des":"肝属木，主疏泄喜条达，应春生之气。"},{"source":"火（五行）","target":"心","name":"配属","des":"心属火，主温煦血脉，应夏长之气。"},{"source":"土","target":"脾","name":"配属","des":"脾属土，主运化水谷，应长夏之气。"},{"source":"金","target":"肺","name":"配属","des":"肺属金，主清肃下降，应秋收之气。"},{"source":"水（五行）","target":"肾","name":"配属","des":"肾属水，主闭藏精气，应冬藏之气。"},{"source":"肝","target":"胆","name":"表里","des":"肝胆相表里，胆附肝叶，共司疏泄决断。"},{"source":"心","target":"小肠","name":"表里","des":"心与小肠相表里，心热可下移小肠。"},{"source":"脾","target":"胃","name":"表里","des":"脾胃相表里，脾主运化、胃主受纳。"},{"source":"肺","target":"大肠","name":"表里","des":"肺与大肠相表里，肃降助大肠传导。"},{"source":"肾","target":"膀胱","name":"表里","des":"肾与膀胱相表里，肾气化则尿能出。"},{"source":"心","target":"心包","name":"外卫","des":"心包护心于内，外邪犯心先代心受。"},{"source":"心包","target":"三焦","name":"表里","des":"心包与三焦相为表里，经脉互相络属。"},{"source":"肾","target":"命门","name":"寓藏","des":"命门寓于两肾之间，为生命之门户。"},{"source":"肾","target":"脑","name":"充养","des":"肾藏精生髓，髓聚上充于脑为髓海。"},{"source":"肾","target":"女子胞","name":"系养","des":"肾气盛天癸至，胞宫方主经水孕育。"},{"source":"胃","target":"小肠","name":"传化","des":"胃腐熟水谷，下传小肠继续化物。"},{"source":"小肠","target":"大肠","name":"传导","des":"小肠泌别清浊，糟粕下归大肠而出。"},{"source":"胆","target":"小肠","name":"泄助","des":"胆汁下泄于小肠，助饮食物之消化。"},{"source":"三焦","target":"膀胱","name":"通调","des":"水液经三焦之道，下输膀胱而排出。"},{"source":"心","target":"脾","name":"相生","des":"心火温运脾土，火暖则运化有力。"},{"source":"脾","target":"肺","name":"相生","des":"脾土生养肺金，水谷精气上注于肺。"},{"source":"肺","target":"肾","name":"相生","des":"肺金滋生肾水，金能生水以为源。"},{"source":"肾","target":"肝","name":"相生","des":"肾水滋养肝木，水涵则木荣不亢。"},{"source":"肝","target":"心","name":"相生","des":"肝木生养心火，母实则子亦强盛。"},{"source":"肝","target":"脾","name":"相克","des":"肝木横逆克脾土，郁怒最易伤脾胃。"},{"source":"脾","target":"肾","name":"相克","des":"脾土克制肾水，土壅则水道不利。"},{"source":"肾","target":"心","name":"相克","des":"肾水上济心火，水火既济则安眠。"},{"source":"心","target":"肺","name":"相克","des":"心火克制肺金，火旺则灼伤肺津。"},{"source":"肺","target":"肝","name":"相克","des":"肺金克制肝木，金亢则木郁不达。"},{"source":"气","target":"血","name":"生化","des":"气能生血，气旺则化血有力，气虚血亦亏。"},{"source":"血","target":"气","name":"载运","des":"血为气之母，载气而行不使耗散。"},{"source":"津液","target":"血","name":"渗生","des":"津液渗注脉中，与营气合而化赤为血。"},{"source":"精","target":"气","name":"化生","des":"精能化气，为一身之气生生之根。"},{"source":"精","target":"血","name":"化生","des":"精血同源互化，肝肾同源即此义。"},{"source":"元气","target":"气","name":"组成","des":"元气是气的根本，激发诸脏腑之机能。"},{"source":"宗气","target":"气","name":"组成","des":"宗气积于胸中，贯心脉而行呼吸。"},{"source":"营气","target":"气","name":"组成","des":"营气行于脉中，化生血液营养周身。"},{"source":"卫气","target":"气","name":"组成","des":"卫气行于脉外，温分肉而御外邪。"},{"source":"气","target":"气机","name":"升降","des":"气之运动表现为升降出入四种形式。"},{"source":"气机","target":"气化","name":"推运","des":"气机运转引发气化，完成物质转化。"},{"source":"精","target":"神","name":"化生","des":"精气充盈则神旺，形与神俱而长生。"},{"source":"血","target":"神","name":"濡养","des":"血养神明，血虚则神不安而失眠。"},{"source":"脉","target":"血","name":"约束","des":"脉为血之府，裹血循行不使外溢。"},{"source":"肾","target":"精","name":"封藏","des":"肾藏精，主人身生长发育与生殖。"},{"source":"脾","target":"血","name":"统摄","des":"脾气统摄血液，使行脉内而不外逸。"},{"source":"心","target":"血","name":"推动","des":"心主血脉，以搏动推血循行于周身。"},{"source":"肝","target":"血","name":"贮藏","des":"肝藏血而调节血量，人动血运诸经。"},{"source":"肺","target":"气","name":"主司","des":"肺主一身之气，司呼吸而吸清呼浊。"},{"source":"脾","target":"津液","name":"运化","des":"脾运化水湿，为津液生成输布之枢。"},{"source":"肺","target":"津液","name":"输布","des":"肺为水之上源，宣降布散津液周身。"},{"source":"肾","target":"津液","name":"主控","des":"肾主水，统摄调控全身水液之代谢。"},{"source":"肾","target":"元气","name":"化生","des":"元气根植于肾，由先天之精化生而来。"},{"source":"肺","target":"宗气","name":"合成","des":"肺吸清气与谷气相合，聚于胸为宗气。"},{"source":"心","target":"神","name":"藏御","des":"心藏神，为精神意识思维之总主宰。"},{"source":"肝","target":"气机","name":"调畅","des":"肝主疏泄，一身上下气机赖以调畅。"},{"source":"三焦","target":"元气","name":"通行","des":"元气借三焦为通道，布达于一身。"},{"source":"大肠","target":"津液","name":"吸收","des":"大肠主津，吸收水液使粪便成形。"},{"source":"小肠","target":"津液","name":"泌别","des":"小肠主液，泌别清浊而分理水液。"},{"source":"膀胱","target":"津液","name":"贮藏","des":"膀胱贮藏津液，气化则尿液能出。"},{"source":"十二经脉","target":"经络","name":"组成","des":"十二正经是经络系统的主干部分。"},{"source":"奇经八脉","target":"经络","name":"组成","des":"八脉纵横交错，补充调节十二经脉。"},{"source":"任脉","target":"督脉","name":"相接","des":"任行腹而督行背，二脉首尾相衔接。"},{"source":"冲脉","target":"任脉","name":"同源","des":"冲任督皆起于胞中，一源而三歧。"},{"source":"带脉","target":"冲脉","name":"约束","des":"带脉环腰束带，约束诸经之气血。"},{"source":"十二经脉","target":"络脉","name":"分出","des":"经脉别出支络，沟通表里渗灌气血。"},{"source":"十二经脉","target":"经别","name":"别出","des":"经别从正经分出，深入体腔联脏腑。"},{"source":"十二经脉","target":"经筋","name":"连属","des":"经筋连属骨节，主司一身关节运动。"},{"source":"十二经脉","target":"皮部","name":"划分","des":"体表按经划分为十二皮部之分区。"},{"source":"经络","target":"腧穴","name":"输注","des":"腧穴是经气输注出入于体表之处的点。"},{"source":"经络","target":"气","name":"通行","des":"经络为气之通路，经气循行于其间。"},{"source":"督脉","target":"脑","name":"入络","des":"督脉上项入络于脑，总督一身之阳。"},{"source":"任脉","target":"女子胞","name":"主养","des":"任脉起于胞中，主胞胎与月经孕育。"},{"source":"冲脉","target":"女子胞","name":"调养","des":"冲为血海，调养月经而主生殖之机。"},{"source":"十二经脉","target":"心","name":"属络","des":"心经属心络小肠，经脉与脏腑内外相应。"},{"source":"十二经脉","target":"肝","name":"属络","des":"肝经属肝络胆，经气相通以候肝之疾。"},{"source":"十二经脉","target":"脾","name":"属络","des":"脾经属脾络胃，外应于肌肉四肢。"},{"source":"十二经脉","target":"肺","name":"属络","des":"肺经属肺络大肠，外合皮毛主一身之表。"},{"source":"十二经脉","target":"肾","name":"属络","des":"肾经属肾络膀胱，外系于骨而通于髓。"},{"source":"六淫","target":"邪气","name":"归属","des":"六淫是外感病邪的总类，属邪气之一。"},{"source":"疠气","target":"邪气","name":"归属","des":"疠气传染性最强，亦属外感之邪。"},{"source":"七情","target":"气机","name":"扰乱","des":"情志过激则气机逆乱，怒则气上。"},{"source":"七情","target":"肝","name":"郁伤","des":"郁怒最易伤肝，疏泄失职而气郁。"},{"source":"七情","target":"心","name":"扰动","des":"心为神明之主，情志之变动心先应。"},{"source":"六淫","target":"肺","name":"侵袭","des":"外邪自皮毛口鼻而入，肺首当其冲。"},{"source":"津液","target":"痰饮","name":"停聚","des":"津液代谢输布障碍，停聚而成痰饮。"},{"source":"血","target":"瘀血","name":"瘀滞","des":"血行迟缓或离经不散，停而为瘀。"},{"source":"痰饮","target":"经络","name":"阻滞","des":"痰饮流注经络，阻碍气血之运行。"},{"source":"瘀血","target":"脉","name":"阻痹","des":"瘀血阻痹脉道，不通则痛随之生。"},{"source":"六淫","target":"阴阳失调","name":"促发","des":"阳邪伤阴、阴邪伤阳，终致阴阳失调。"},{"source":"正气","target":"正邪相争","name":"抗御","des":"正气奋起抗邪，邪正交争定发病转归。"},{"source":"邪气","target":"正邪相争","name":"侵袭","des":"邪气侵入人体，与正气交争而成病。"},{"source":"体质","target":"正气","name":"影响","des":"体质强弱决定正气盛衰与发病倾向。"},{"source":"脾","target":"内生五邪","name":"化生","des":"脾虚失运则湿从内生，内邪由是而起。"},{"source":"饮食失宜","target":"脾","name":"损伤","des":"饥饱失常先伤脾胃，运化随之失职。"},{"source":"经络","target":"传变","name":"传导","des":"病邪循经络由表入里，由此脏传彼脏。"},{"source":"正邪相争","target":"传变","name":"决定","des":"邪正消长进退，决定疾病传变方向。"},{"source":"望诊","target":"四诊","name":"组成","des":"望诊观神色形态，为四诊之首位。"},{"source":"切诊","target":"四诊","name":"组成","des":"切脉按肤探脉象，为四诊之一环。"},{"source":"舌诊","target":"望诊","name":"归属","des":"舌诊属望诊内容，舌象可察脏腑气血。"},{"source":"四诊","target":"八纲辨证","name":"提供","des":"四诊合参收集病情，为辨证提供依据。"},{"source":"八纲辨证","target":"辨证论治","name":"纲领","des":"八纲为辨证总纲，据此确立治法方药。"},{"source":"同病异治","target":"辨证论治","name":"体现","des":"证异治亦异，正是辨证论治的体现。"},{"source":"八纲辨证","target":"正治反治","name":"指导","des":"寒热虚实既辨，正治反治乃有所依。"},{"source":"辨证论治","target":"标本缓急","name":"决定","des":"辨明证候后，依标本缓急定先后次序。"},{"source":"扶正祛邪","target":"正邪相争","name":"针对","des":"依邪正盛衰之势，定攻补之先后缓急。"},{"source":"扶正祛邪","target":"正气","name":"扶助","des":"扶正即补益正气，增强抗邪之能力。"},{"source":"调整阴阳","target":"阴阳失调","name":"纠正","des":"损其偏盛，补其偏衰，使以平为期。"},{"source":"治未病","target":"传变","name":"防杜","des":"既病防变，先安未受邪之地以杜传变。"},{"source":"治未病","target":"正气","name":"培固","des":"未病先防，首在调养培固一身正气。"},{"source":"因人制宜","target":"体质","name":"结合","des":"视体质强弱、长幼男女而治各不同。"},{"source":"切诊","target":"脉","name":"诊察","des":"切按寸口之脉，察气血脏腑之消息。"},{"source":"阴阳","target":"八纲辨证","name":"统摄","des":"阴阳为八纲之总纲，统摄表里寒热虚实。"},{"source":"阴阳","target":"对立制约","name":"对立","des":"阴阳双方彼此制约，如动制静、寒制热，维持相对平衡。"},{"source":"阴阳","target":"阴阳消长","name":"消长","des":"阴阳此消彼长而动态平衡，如昼夜交替、寒来暑往。"},{"source":"阴阳","target":"阴阳转化","name":"转化","des":"阴阳极则相易，重阴必阳、重阳必阴。"},{"source":"对立制约","target":"阴阳消长","name":"动力","des":"制约与反制约推动阴阳消长进退，失约则偏盛偏衰。"},{"source":"阴阳互根","target":"阴阳转化","name":"根据","des":"互根方有互变之机，阴得阳则化，阳得阴则生。"},{"source":"阴阳消长","target":"阴阳转化","name":"渐积","des":"消长为量变之渐，积渐至极乃发质变之转化。"},{"source":"肾","target":"骨","name":"主养","des":"肾藏精主骨，齿为骨之余，肾充则骨坚齿固。"},{"source":"肾","target":"髓","name":"化生","des":"肾精化生精髓，精足则髓充骨壮。"},{"source":"骨","target":"髓","name":"内藏","des":"骨为髓之府，精髓充盈于骨腔之中。"},{"source":"髓","target":"脑","name":"汇聚","des":"诸髓皆上属于脑，脑为髓之海。"},{"source":"心","target":"肾","name":"既济","des":"心火下温肾水，肾水上济心火，水火既济则寤寐如常。"},{"source":"肝","target":"肾","name":"同源","des":"肝肾同源，精血互生，乙癸相资。"},{"source":"任脉","target":"奇经八脉","name":"组成","des":"任脉总任一身之阴，为阴脉之海。"},{"source":"督脉","target":"奇经八脉","name":"组成","des":"督脉总督一身之阳，为阳脉之海。"},{"source":"冲脉","target":"奇经八脉","name":"组成","des":"冲脉涵蓄十二经气血，称十二经之海、血海。"},{"source":"带脉","target":"奇经八脉","name":"组成","des":"带脉环腰一周，约束纵行诸经。"},{"source":"跷脉","target":"奇经八脉","name":"组成","des":"跷脉主司矫捷运动与寤寐开阖。"},{"source":"维脉","target":"奇经八脉","name":"组成","des":"维脉维络一身表里之阴阳。"},{"source":"跷脉","target":"卫气","name":"协同","des":"卫气昼行阳跷则目张而寤，夜行阴跷则目瞑而寐。"},{"source":"营气","target":"血","name":"化生","des":"营气泌津液注于脉中，化赤而为血。"},{"source":"卫气","target":"皮部","name":"温煦","des":"卫气行于肤表分肉，温分肉、肥腠理、司开阖御外邪。"},{"source":"三焦","target":"津液","name":"决渎","des":"三焦为决渎之官，水道出焉，津液赖以环流。"},{"source":"劳逸失度","target":"正气","name":"耗伤","des":"劳则气耗，久劳伤精，正气因之亏虚。"},{"source":"劳逸失度","target":"气机","name":"滞涩","des":"过逸少动则气血不行，气机迟滞渐生痰瘀。"},{"source":"闻诊","target":"四诊","name":"组成","des":"听声嗅气与望问切相合，四诊合参乃全。"},{"source":"问诊","target":"四诊","name":"组成","des":"问而知之谓之工，病之因由多凭问诊而明。"},{"source":"问诊","target":"七情","name":"追询","des":"情志内伤起病隐曲，须问诊方能究其由。"},{"source":"闻诊","target":"肺","name":"听察","des":"咳喘声息之变，首察肺气之盛衰。"},{"source":"脉诊","target":"切诊","name":"归属","des":"脉诊候脉，为切诊之主体。"},{"source":"因时制宜","target":"六淫","name":"参酌","des":"时令邪气各有所偏，春防风、夏防暑湿，治随季变。"},{"source":"因地制宜","target":"六淫","name":"参酌","des":"地高陵居多燥寒，卑下卑湿多湿热，邪随方土而异。"},{"source":"正治反治","target":"八法","name":"统驭","des":"寒者热之、热者寒之，正治之道由八法温清而落实。"},{"source":"甲骨文","target":"金文","name":"演变","des":"契刻转为熔铸，线条由方折渐趋圆浑丰润。"},{"source":"金文","target":"大篆","name":"汇为","des":"两周铭文与籀文一脉相承，共同汇成大篆体系。"},{"source":"石鼓文","target":"大篆","name":"典范","des":"鼓形刻石上的籀文遗则，大篆结字的标准器。"},{"source":"大篆","target":"小篆","name":"省改","des":"秦并天下，罢其不与秦文合者，省改而为小篆。"},{"source":"李斯","target":"小篆","name":"厘定","des":"同文之政出其手，玉箸篆法由此立范。"},{"source":"小篆","target":"隶变","name":"孕育","des":"刀笔吏急就省写，篆法在日常书写中溃散。"},{"source":"隶变","target":"隶书","name":"结成","des":"解散篆体、化圆为方，蚕头燕尾之形成立。"},{"source":"隶变","target":"中国书法史","name":"转向","des":"古今文字由此分野，汉字史上最重要的转向。"},{"source":"隶书","target":"章草","name":"捷写","des":"草隶约定俗成，字字独立而波磔犹存。"},{"source":"章草","target":"今草","name":"演进","des":"去波磔、通连属，草书正脉自此脱胎。"},{"source":"今草","target":"狂草","name":"极化","des":"以情驭笔冲决法度，张旭怀素造其极。"},{"source":"隶书","target":"楷书","name":"整饬","des":"敛波磔为顿挫，点画分明而法度立。"},{"source":"楷书","target":"行书","name":"间出","des":"介于楷草之间最宜日用，晋人独绝。"},{"source":"中国书法史","target":"甲骨文","name":"发端","des":"现存最早的成体系汉字，一切自此起步。"},{"source":"《说文解字》","target":"小篆","name":"立纲","des":"以篆为纲，九千字系于五百四十部。"},{"source":"《说文解字》","target":"金石学","name":"滋养","des":"乾嘉考据据以释读金文，字学因而复活。"},{"source":"中国书法史","target":"王羲之","name":"尊为","des":"书圣千年不祧，笼罩此后一切行草讨论。"},{"source":"卫夫人","target":"王羲之","name":"授业","des":"传《笔阵图》笔法，簪花之评启幕右军。"},{"source":"王羲之","target":"王献之","name":"家传","des":"笔法传家，父子并称二王共革新体。"},{"source":"王羲之","target":"《兰亭序》","name":"写就","des":"永和九年修禊雅集，稿成即成绝唱。"},{"source":"王羲之","target":"《十七帖》","name":"写就","des":"晚年草书信札，帖中龙象、习草津梁。"},{"source":"王羲之","target":"行书","name":"变古","des":"熔铸汉魏开遒媚新体，行书自此有法。"},{"source":"王献之","target":"今草","name":"推进","des":"破体连绵一笔书，为草书开尚奇之门。"},{"source":"智永","target":"王羲之","name":"嗣响","des":"七世孙守家法，千字文八百本传其谱系。"},{"source":"智永","target":"永字八法","name":"演备","des":"书真草千文八百本，八法赖以定型传世。"},{"source":"欧阳询","target":"王羲之","name":"取法","des":"初唐诸家自右军出，欧阳询得其骨。"},{"source":"欧阳询","target":"《九成宫醴泉铭》","name":"写就","des":"七十六岁人书俱老，唐楷第一神品。"},{"source":"虞世南","target":"智永","name":"师承","des":"亲炙永欣寺，接续王家笔法谱系。"},{"source":"虞世南","target":"楷书","name":"雅正","des":"《孔子庙堂碑》外柔内刚，立唐楷雅音。"},{"source":"褚遂良","target":"王羲之","name":"取法","des":"疏通隶意入楷，实自右军处得法。"},{"source":"褚遂良","target":"《雁塔圣教序》","name":"写就","des":"晚年空灵瘦润如婵娟，唐楷转关之作。"},{"source":"褚遂良","target":"颜真卿","name":"沾溉","des":"宽绰疏宕一脉相延，唐楷大厅由此而开。"},{"source":"颜真卿","target":"楷书","name":"变法","des":"外拓雄浑一变初唐瘦硬，立庙堂气象。"},{"source":"颜真卿","target":"《多宝塔碑》","name":"写就","des":"四十四岁端严整秀，学颜者的首级台阶。"},{"source":"颜真卿","target":"《颜勤礼碑》","name":"写就","des":"晚年横细竖阔，外紧内松而磅礴。"},{"source":"颜真卿","target":"《祭侄文稿》","name":"写就","des":"祭侄血泪任笔所之，不计工拙而真气弥满。"},{"source":"颜真卿","target":"屋漏痕","name":"拈出","des":"与怀素论笔法，坼壁之路自然无做作。"},{"source":"柳公权","target":"颜真卿","name":"承变","des":"取颜体而益以骨鲠，世称颜筋柳骨。"},{"source":"柳公权","target":"《玄秘塔碑》","name":"写就","des":"骨力洞达锋棱跃然，后世学柳之门户。"},{"source":"柳公权","target":"楷书","name":"立骨","des":"以心正笔正谏君，唐楷法度的最后高峰。"},{"source":"张旭","target":"狂草","name":"开创","des":"观公主担夫争道而悟笔，颠草惊风雨。"},{"source":"张旭","target":"楷书","name":"兼擅","des":"《郎官石柱记》严整，颠外别有法度。"},{"source":"张旭","target":"颜真卿","name":"传法","des":"十二笔意亲授鲁公，谱系一线相续。"},{"source":"怀素","target":"张旭","name":"遥承","des":"以狂继颠，两人草法气类相感相接。"},{"source":"怀素","target":"狂草","name":"驰骋","des":"种蕉代纸、观云悟笔，酒酣兴发而不可遏。"},{"source":"怀素","target":"《自叙帖》","name":"写就","des":"飞环走汞、骤雨旋风，狂草的标准像。"},{"source":"怀素","target":"屋漏痕","name":"对参","des":"坼壁之路与屋漏痕同参，笔贵涩进自然。"},{"source":"孙过庭","target":"《书谱》","name":"写就","des":"三千七百言文墨双绝，唐人论书第一手。"},{"source":"孙过庭","target":"今草","name":"宗王","des":"以二王为宗，俊拔刚断，唐草之正脉。"},{"source":"杨凝式","target":"颜真卿","name":"遥接","des":"得颜之气而化为萧散，唐音遂入宋调。"},{"source":"苏轼","target":"杨凝式","name":"推服","des":"称其笔迹雄杰，尚意之门由此开启。"},{"source":"苏轼","target":"宋四家","name":"居首","des":"苏黄米蔡并称，东坡气韵天成居首。"},{"source":"黄庭坚","target":"宋四家","name":"列名","des":"长枪大戟自成一格，山谷居其亚席。"},{"source":"米芾","target":"宋四家","name":"列名","des":"刷字痛快沉着，八面出锋兼得二王。"},{"source":"苏轼","target":"《寒食帖》","name":"写就","des":"黄州苦雨死灰吹不起，意到笔随。"},{"source":"苏轼","target":"颜真卿","name":"师法","des":"独爱鲁公忠厚，于字外求人格气象。"},{"source":"黄庭坚","target":"《寒食帖》","name":"题跋","des":"跋尾小字精妙，与本文相映成双璧。"},{"source":"黄庭坚","target":"怀素","name":"取法","des":"观荡桨而悟笔，长枪大戟自狂草来。"},{"source":"米芾","target":"王羲之","name":"集古","des":"集古字三十年而成家，腕底自有二王。"},{"source":"米芾","target":"赵佶","name":"供奉","des":"为书画学博士，瑶台召对得论书之宠。"},{"source":"赵佶","target":"楷书","name":"别裁","des":"瘦金体如屈铁断金，帝王楷法独标一格。"},{"source":"赵孟頫","target":"王羲之","name":"复古","des":"直追晋唐一扫南宋颓风，用笔千古不易。"},{"source":"赵孟頫","target":"《兰亭序》","name":"题识","des":"兰亭十三跋，舟行中细与右军对语。"},{"source":"董其昌","target":"赵孟頫","name":"争胜","des":"初习松雪后自树一帜，淡墨别开生面。"},{"source":"董其昌","target":"帖学","name":"殿军","des":"疏空章法生秀，帖学暮色最后一抹清光。"},{"source":"董其昌","target":"题跋","name":"品鉴","des":"题识遍天下，真赝常经其一言而分。"},{"source":"王铎","target":"《淳化阁帖》","name":"临古","des":"一日临帖一日应索，连绵草势自阁帖出。"},{"source":"王铎","target":"帖学","name":"力挽","des":"连绵巨帙沉雄跌宕，帖学最后的光焰。"},{"source":"王铎","target":"傅山","name":"并世","des":"明清之际书坛双峰，一沉雄一倔强。"},{"source":"傅山","target":"赵孟頫","name":"贬抑","des":"四宁四毋直指熟媚，气节遂入书论。"},{"source":"傅山","target":"碑学","name":"先声","des":"力戒甜熟、崇尚拙厚，为尊碑张本。"},{"source":"邓石如","target":"碑学","name":"践行","des":"以隶笔作篆，布衣而开碑学书风。"},{"source":"邓石如","target":"篆刻","name":"入印","des":"印从书出，以刀代笔，遂开皖派门户。"},{"source":"邓石如","target":"计白当黑","name":"拈出","des":"疏处走马、密不透风，空白同受经营。"},{"source":"吴昌硕","target":"石鼓文","name":"临写","des":"一生临石鼓，一日有一日之境界。"},{"source":"吴昌硕","target":"篆刻","name":"重镇","des":"钝刀硬入雄浑苍茫，西泠印社首任社长。"},{"source":"何绍基","target":"颜真卿","name":"私淑","des":"回腕高悬学鲁公，熔篆隶入行草。"},{"source":"何绍基","target":"碑学","name":"会通","des":"遍临汉碑周金，为碑帖融通之先行者。"},{"source":"《淳化阁帖》","target":"帖学","name":"奠基","des":"淳化摹勒十卷，法帖之祖、帖学武库。"},{"source":"帖学","target":"王羲之","name":"尊为","des":"阁帖过半为二王，帖学即二王之学。"},{"source":"《淳化阁帖》","target":"王献之","name":"收录","des":"大令帖目几与乃父分庭抗礼，父子并耀。"},{"source":"阮元","target":"碑学","name":"倡立","des":"《南北书派论》分派立说，尊碑自此发端。"},{"source":"包世臣","target":"阮元","name":"接武","des":"《艺舟双楫》推演师说，北碑益张。"},{"source":"康有为","target":"包世臣","name":"推广","des":"《广艺舟双楫》集其大成，尊魏卑唐。"},{"source":"康有为","target":"尊碑抑帖","name":"力倡","des":"十六宗之说，尊碑之论推至其极。"},{"source":"康有为","target":"魏碑","name":"标举","des":"独尊南碑与龙门造像，卑唐之说惊世。"},{"source":"尊碑抑帖","target":"帖学","name":"论争","des":"斥刻帖翻摹失真，帖学受百年冲击。"},{"source":"魏碑","target":"碑学","name":"取资","des":"龙门造像雄强角出，碑派笔法之源。"},{"source":"魏碑","target":"楷书","name":"别支","des":"北朝楷刻与南帖并峙，别立雄强一格。"},{"source":"金石学","target":"碑学","name":"托举","des":"访碑著录考释成风，学人眼光一变。"},{"source":"王懿荣","target":"甲骨文","name":"发现","des":"一八九九年视药材为古契，商史重光。"},{"source":"王懿荣","target":"金石学","name":"殿军","des":"庚子殉节的名臣学者，收藏考据冠绝一时。"},{"source":"金石学","target":"石鼓文","name":"椎拓","des":"唐人已重石鼓，椎拓考据自此发端。"},{"source":"《九成宫醴泉铭》","target":"楷书","name":"典范","des":"欧书险劲极则，万千学楷者共由之阶梯。"},{"source":"《兰亭序》","target":"行书","name":"立极","des":"三百二十四字，行书法度千年之极。"},{"source":"《兰亭序》","target":"三大行书","name":"居首","des":"真迹殉葬昭陵，摹拓之本亦足千秋。"},{"source":"《祭侄文稿》","target":"三大行书","name":"居次","des":"涂改满纸而真气弥漫，天下第二。"},{"source":"《寒食帖》","target":"三大行书","name":"居三","des":"黄州自书诗卷，宋人尚意书风之极。"},{"source":"《祭侄文稿》","target":"行书","name":"别调","des":"不袭兰亭而血泪斑斑，行书另一极。"},{"source":"《十七帖》","target":"今草","name":"范本","des":"字字不连而气脉贯通，习草之津梁。"},{"source":"《自叙帖》","target":"狂草","name":"极致","des":"狂草墨迹长卷第一标本，飞动如史诗。"},{"source":"《曹全碑》","target":"隶书","name":"秀润","des":"蚕头燕尾姿致翩翩，汉碑清丽一路。"},{"source":"《张迁碑》","target":"隶书","name":"方拙","des":"方笔斩截古拙茂密，与曹全各执一端。"},{"source":"《书谱》","target":"意在笔先","name":"阐发","des":"先散怀抱、意在笔前，唐论之眼。"},{"source":"《书谱》","target":"神采形质","name":"辨析","des":"点画为形质、使转为情性，纲领在焉。"},{"source":"卫夫人","target":"意在笔先","name":"发端","des":"《笔阵图》意前笔后之论启其端绪。"},{"source":"王羲之","target":"意在笔先","name":"申说","des":"夫欲书者先干研墨，凝神静思预想。"},{"source":"永字八法","target":"楷书","name":"立范","des":"侧勒努趯策掠啄磔，八法一字该备。"},{"source":"毛笔","target":"中国书法史","name":"利器","des":"惟笔软则奇怪生焉，柔锋生万态。"},{"source":"毛笔","target":"文房四宝","name":"组成","des":"四友之首，锋毫生发出一切线质。"},{"source":"徽墨","target":"文房四宝","name":"组成","des":"松烟油烟杵捣成型，浓淡枯润分五色。"},{"source":"宣纸","target":"文房四宝","name":"组成","des":"生宣渗化、熟宣矜持，纸性定笔性。"},{"source":"砚台","target":"文房四宝","name":"组成","des":"发墨益毫而不损毫，端歙各擅其胜。"},{"source":"篆刻","target":"小篆","name":"取字","des":"印宗秦汉，篆法乃治印之根本依据。"},{"source":"苏轼","target":"米芾","name":"知音","des":"誉其书当与钟王并行，米芾名动天下。"},{"source":"孔子","target":"中国哲学","name":"奠基","des":"删述六经、有教无类，奠定仁学与师道传统。"},{"source":"论语","target":"孔子","name":"著述","des":"弟子及再传弟子辑录的言行录，仁学的第一文献。"},{"source":"孔子","target":"仁","name":"核心思想","des":"仁者爱人，克己复礼为仁，儒学最高的道德理想。"},{"source":"孔子","target":"礼","name":"核心思想","des":"损益周礼而重铸之，让规范重新获得人心根基。"},{"source":"仁","target":"礼","name":"内外关系","des":"克己复礼为仁：仁为礼之实，礼为仁之文。"},{"source":"孔子","target":"中庸","name":"方法论","des":"执两用中、过犹不及的实践智慧。"},{"source":"孔子","target":"天命","name":"敬畏","des":"五十而知天命，把人格神之天转为使命感之天。"},{"source":"周易","target":"孔子","name":"阐释","des":"相传晚年赞易作十翼，卜筮之书升华为哲理经典。"},{"source":"孟子","target":"孔子","name":"私淑继统","des":"未得亲炙而愿学孔子，战国儒学的正宗。"},{"source":"孟子","target":"性善论","name":"主张","des":"四端之心人皆有之，善是人性中生长的萌芽。"},{"source":"性善论","target":"仁政","name":"支撑","des":"人皆有不忍人之心，故可行不忍人之政。"},{"source":"孟子","target":"仁政","name":"主张","des":"制民之产、省刑罚薄税敛的王道政治。"},{"source":"仁政","target":"民贵君轻","name":"内涵","des":"民为贵，社稷次之，君为轻。"},{"source":"荀子","target":"性恶论","name":"主张","des":"人之性恶，其善者伪也。"},{"source":"性恶论","target":"化性起伪","name":"支撑","des":"既然性恶，善必须靠师法教化人为养成。"},{"source":"荀子","target":"化性起伪","name":"主张","des":"礼义师法化导自然人性，改变与生俱来的趋向。"},{"source":"孟子","target":"荀子","name":"对峙","des":"儒门内部人性论与工夫路线的两条歧路。"},{"source":"荀子","target":"礼","name":"重铸","des":"礼者养也：礼由规范转为养欲给求的制度安排。"},{"source":"荀子","target":"经学","name":"传经","des":"汉初经师多出自荀门，经学传授有案可稽。"},{"source":"中庸","target":"天命","name":"承接","des":"天命之谓性，率性之谓道：天命与人性直接贯通。"},{"source":"老子","target":"中国哲学","name":"奠基","des":"以道为宗，开出与儒学互补的形上智慧。"},{"source":"老子","target":"道德经","name":"著述","des":"五千言道论总纲，中国哲学的元典。"},{"source":"道德经","target":"道","name":"阐发","des":"道可道非常道，五千言皆是对道的言说。"},{"source":"道","target":"无为","name":"落实","des":"道法自然，无为而无不为。"},{"source":"道德经","target":"反者道之动","name":"阐发","des":"反者道之动，弱者道之用：老子辩证法的核心命题。"},{"source":"庄子","target":"老子","name":"继承","des":"以道为宗而转向精神自由，老庄自此并称。"},{"source":"庄子","target":"逍遥游","name":"阐发","des":"乘天地之正而御六气之辩，以游无穷。"},{"source":"庄子","target":"齐物论","name":"阐发","des":"万物一齐、是非两行的相对视域。"},{"source":"庄子","target":"心斋坐忘","name":"工夫","des":"堕肢体、黜聪明后的纯粹体验。"},{"source":"齐物论","target":"逍遥游","name":"基础","des":"先齐物我之辨，方得无待之游。"},{"source":"齐物论","target":"公孙龙","name":"消解","des":"以万物一齐消解坚白同异的名辩之争。"},{"source":"墨子","target":"孔子","name":"反叛","des":"学儒者之业而后叛，以无差等之爱攻有差等之仁。"},{"source":"墨子","target":"兼爱","name":"核心","des":"视人之国若视其国，无差等的普遍之爱。"},{"source":"墨子","target":"非攻","name":"主张","des":"兼爱的政治推论，止楚攻宋身体力行。"},{"source":"兼爱","target":"非攻","name":"推论","des":"攻战亏人以遂私利，与兼爱正面冲突。"},{"source":"仁","target":"兼爱","name":"对照","des":"爱有差等与爱无差等，儒墨互诋的焦点。"},{"source":"墨子","target":"墨辩","name":"开创","des":"墨经名辞说辨之说，中国逻辑学的先声。"},{"source":"商鞅","target":"韩非","name":"先驱","des":"变法实践为法家理论提供了现实样本。"},{"source":"商鞅","target":"法术势","name":"先行","des":"耕战与信赏必罚的制度先导。"},{"source":"韩非","target":"法术势","name":"集成","des":"法、术、势交织的君主操控体系。"},{"source":"韩非","target":"荀子","name":"师承","des":"与李斯俱学于荀卿，性恶论悄然通向法制。"},{"source":"韩非","target":"老子","name":"援用","des":"《解老》《喻老》传世最早注老，法家与君人南面术的暗合。"},{"source":"董仲舒","target":"天人感应","name":"构建","des":"灾异谴告说，为大一统提供宇宙论论证。"},{"source":"董仲舒","target":"独尊儒术","name":"建议","des":"天人三策建议罢黜百家，儒学升为官方意识形态。"},{"source":"独尊儒术","target":"经学","name":"促成","des":"定于一尊后，经学成为学术与仕进的唯一正途。"},{"source":"经学","target":"今古文之争","name":"分化","des":"文字与家法之异，演为两千年经学公案。"},{"source":"今古文之争","target":"白虎观会议","name":"裁定","des":"章帝亲临裁定经义异同，官方经学的整合。"},{"source":"天人感应","target":"谶纬","name":"流变","des":"谶纬借天人感应而泛滥成迷信。"},{"source":"王充","target":"谶纬","name":"批判","des":"疾虚妄，以元气自然论扫荡神学目的论。"},{"source":"太学","target":"经学","name":"制度","des":"五经博士立于太学，经学与仕途制度性捆绑。"},{"source":"魏晋玄学","target":"周易","name":"重释","des":"老庄易并称三玄，易学从此转入义理一路。"},{"source":"王弼","target":"魏晋玄学","name":"开创","des":"少年注老解易，正始之音的领奏者。"},{"source":"王弼","target":"贵无论","name":"立论","des":"万物以无为本，本体论思维在魏晋发端。"},{"source":"贵无论","target":"名教与自然","name":"立场","des":"名教本于自然：为礼法寻求形上根基。"},{"source":"嵇康","target":"名教与自然","name":"立场","des":"越名教而任自然，竹林一派的激烈姿态。"},{"source":"嵇康","target":"清谈","name":"同调","des":"竹林之音接续正始之音。"},{"source":"郭象","target":"庄子","name":"注解","des":"郭象注庄，注出了自己的独化论。"},{"source":"郭象","target":"魏晋玄学","name":"集成","des":"独化于玄冥之境，玄学的收束者。"},{"source":"清谈","target":"魏晋玄学","name":"载体","des":"执麈尾论本末有无的贵族思想沙龙。"},{"source":"庄子","target":"魏晋玄学","name":"远源","des":"竹林与元康名士共同的精神偶像。"},{"source":"佛教东传","target":"格义","name":"方法","des":"初期借老庄概念比附佛理的过渡方案。"},{"source":"格义","target":"魏晋玄学","name":"依附","des":"借玄学语言讲佛法，先依附后超越。"},{"source":"玄奘","target":"格义","name":"反拨","des":"恶其迂曲而西行求原典，直接译介唯识今学。"},{"source":"玄奘","target":"唯识宗","name":"开创","des":"译经千卷，因明与万法唯识的精密体系。"},{"source":"禅宗","target":"佛教东传","name":"结晶","des":"佛教中国化最彻底、影响最久的形态。"},{"source":"慧能","target":"禅宗","name":"开派","des":"六祖革命：不立文字，直指人心。"},{"source":"六祖坛经","target":"慧能","name":"著述","des":"唯一称经的中国僧人著述，禅宗根本典籍。"},{"source":"慧能","target":"顿悟","name":"主张","des":"前念迷即凡夫，后念悟即佛。"},{"source":"佛性","target":"顿悟","name":"支撑","des":"人人皆有佛性，悟才可能在刹那完成。"},{"source":"佛性","target":"禅宗","name":"前提","des":"心性本觉是禅宗全部工夫论的起点。"},{"source":"心斋坐忘","target":"顿悟","name":"先声","des":"道家心斋与禅家顿悟在工夫论上的共鸣。"},{"source":"理学","target":"中国哲学","name":"高峰","des":"儒学吸收佛道之后的哲学巅峰形态。"},{"source":"周敦颐","target":"理学","name":"开山","des":"《太极图说》与《通书》，理学谱系的第一环。"},{"source":"周敦颐","target":"太极图说","name":"著述","des":"无极而太极，为理学提供宇宙论图式。"},{"source":"周易","target":"太极图说","name":"渊源","des":"太极之名即取自易传。"},{"source":"张载","target":"气学","name":"开派","des":"太虚即气，以实气言道体的路线。"},{"source":"气学","target":"理学","name":"一系","des":"与程朱陆王并立的一脉，气本论的坚持者。"},{"source":"张载","target":"横渠四句","name":"自道","des":"为天地立心，为生民立命，为往圣继绝学，为万世开太平。"},{"source":"二程","target":"天理","name":"体贴","des":"吾学虽有授受，天理二字却是自家体贴出来。"},{"source":"天理","target":"理学","name":"内核","des":"既是宇宙法则又是道德本体的最高范畴。"},{"source":"朱熹","target":"二程","name":"继承","des":"接续洛学而综罗百代。"},{"source":"朱熹","target":"理学","name":"集大成","des":"编定四书，完成理气论与格物说。"},{"source":"朱熹","target":"格物致知","name":"工夫","des":"即物穷理，今日格一物，明日格一物。"},{"source":"朱熹","target":"理一分殊","name":"阐发","des":"月映万川：一理与万理的关系图式。"},{"source":"朱熹","target":"存天理灭人欲","name":"教条","des":"修养总纲，后世争论的渊薮。"},{"source":"朱熹","target":"论语","name":"集注","des":"集注四书，四书从此取代五经成为新经典。"},{"source":"天命","target":"天理","name":"演进","des":"从主宰之天到义理之天，范畴的哲学化。"},{"source":"陆九渊","target":"朱熹","name":"对峙","des":"鹅湖之会，尊德性与道问学当面交锋。"},{"source":"鹅湖之会","target":"理学","name":"见证","des":"朱陆之辩是心学与理学的分水岭。"},{"source":"王阳明","target":"陆九渊","name":"继承","des":"承象山之学而致广大，心学的完成者。"},{"source":"王阳明","target":"朱熹","name":"突破","des":"从格竹之惑到龙场悟道，格物被重释为正念头。"},{"source":"王阳明","target":"致良知","name":"宗旨","des":"良知是你自家的准则，晚年揭出的三字真言。"},{"source":"王阳明","target":"知行合一","name":"主张","des":"知是行之始，行是知之成。"},{"source":"知行合一","target":"格物致知","name":"重释","des":"心学以正念头重释《大学》格物。"},{"source":"禅宗","target":"理学","name":"刺激","des":"心性论与顿悟工夫暗中塑造理学的气质。"},{"source":"中庸","target":"理学","name":"供源","des":"心性论的元典依据，四书之一。"},{"source":"顾炎武","target":"朴学","name":"开山","des":"舍空谈而趋实证，开清代考据之风。"},{"source":"顾炎武","target":"经世致用","name":"主张","des":"天下兴亡匹夫有责，学问须有益于国事。"},{"source":"朴学","target":"理学","name":"反动","des":"厌弃心性空谈，退回文字音韵训诂的实证。"},{"source":"戴震","target":"顾炎武","name":"承续","des":"由训诂音韵以明义理的路线一脉相承。"},{"source":"戴震","target":"朴学","name":"殿军","des":"训诂明而后义理明，考据学的哲学总结。"},{"source":"戴震","target":"存天理灭人欲","name":"批判","des":"以理杀人：后儒以理责人的血泪控诉。"},{"source":"康有为","target":"大同","name":"著述","des":"《大同书》构想无邦国、无阶级的理想世界。"},{"source":"康有为","target":"今古文之争","name":"重启","des":"以公羊三世说托古改制，为变法造经学依据。"},{"source":"新文化运动","target":"孔子","name":"冲击","des":"打倒孔家店：两千年偶像的黄昏。"},{"source":"新文化运动","target":"科玄论战","name":"引发","des":"科学能否解决人生观，1923年的大论战。"},{"source":"冯友兰","target":"中国哲学","name":"史述","des":"两卷本《中国哲学史》确立现代学术范式。"},{"source":"冯友兰","target":"理学","name":"接续","des":"贞元六书以新理学重接程朱一脉。"},{"source":"熊十力","target":"唯识宗","name":"转出","des":"由唯识学翻出体用不二的新唯识论。"},{"source":"熊十力","target":"现代新儒家","name":"开派","des":"第一代新儒家的中心人物。"},{"source":"牟宗三","target":"熊十力","name":"师承","des":"亲炙熊门，以智的直觉会通康德。"},{"source":"牟宗三","target":"现代新儒家","name":"第二代","des":"第二代代表，构建道德的形上学。"},{"source":"现代新儒家","target":"新文化运动","name":"回应","des":"对全盘性反传统的保守主义回应。"},{"source":"现代新儒家","target":"中国哲学","name":"转化","des":"在西学冲击下接续道统的现代尝试。"},{"source":"优孟衣冠","target":"中国戏曲","name":"滥觞","des":"扮孙叔敖谏动楚王，扮演艺术的最早记载。"},{"source":"优孟衣冠","target":"参军戏","name":"先声","des":"滑稽讽谏一脉相承，由优孟而及参军。"},{"source":"百戏与角抵","target":"中国戏曲","name":"滋养","des":"百戏荟萃诸般技艺，为戏曲备下武功排场。"},{"source":"百戏与角抵","target":"程式化表演","name":"沉淀","des":"角抵筋斗沿袭千年，渐渐化作武打程式。"},{"source":"勾栏瓦舍","target":"中国戏曲","name":"温床","des":"宋元城市棚栏卖艺，职业戏班由此养成。"},{"source":"勾栏瓦舍","target":"南戏","name":"场地","des":"瓦舍勾栏日日开锣，戏文杂剧同台竞胜。"},{"source":"参军戏","target":"中国戏曲","name":"蜕变","des":"参军苍鹘一庄一谐，角色行当的最初萌芽。"},{"source":"参军戏","target":"丑行","name":"远祖","des":"插科打诨一脉承继，丑角奉为祖师爷。"},{"source":"诸宫调","target":"元杂剧","name":"过渡","des":"说唱联套讲唱故事，北曲剧曲的直接先河。"},{"source":"诸宫调","target":"西厢记","name":"蓝本","des":"董解元弹唱西厢，王实甫据以敷演成剧。"},{"source":"南戏","target":"中国戏曲","name":"成型","des":"生旦净丑体制初备，最早的完整戏曲形态。"},{"source":"四大南戏","target":"南戏","name":"支柱","des":"荆刘拜杀四种戏文，南戏存世的柱石。"},{"source":"南戏","target":"元杂剧","name":"分峙","des":"南戏文与北杂剧，一南一北各擅胜场。"},{"source":"元杂剧","target":"中国戏曲","name":"鼎盛","des":"四折一楔子一人主唱，北曲臻于极盛。"},{"source":"元杂剧","target":"昆曲","name":"存续","des":"北曲杂剧赖昆腔传唱，至今氍毹不辍。"},{"source":"关汉卿","target":"元杂剧","name":"领袖","des":"驱梨园领袖总编修师首，捻杂剧班头。"},{"source":"窦娥冤","target":"关汉卿","name":"出自","des":"三宗誓愿感天动地，公案悲剧的绝顶。"},{"source":"窦娥冤","target":"元杂剧","name":"压卷","des":"六月飞雪见证奇冤，本色派悲剧之最。"},{"source":"王实甫","target":"西厢记","name":"撰作","des":"长亭送别曲词冠绝，文采派之极则。"},{"source":"王实甫","target":"元杂剧","name":"文采","des":"与关汉卿本色派对垒，元曲双峰并峙。"},{"source":"西厢记","target":"元杂剧","name":"翘楚","des":"北曲剧本文学的最高峰，后世取之不竭。"},{"source":"马致远","target":"汉宫秋","name":"撰作","des":"秋思之祖的苍凉笔墨，写昭君出塞事。"},{"source":"汉宫秋","target":"元杂剧","name":"名作","des":"孤雁声声撕破秋空，元曲四大悲剧之一。"},{"source":"南戏","target":"四大声腔","name":"裂变","des":"戏文流布四方，腔随地改各成一派。"},{"source":"四大声腔","target":"昆山腔","name":"名列","des":"四腔并出，昆山腔后发而终成雅音正宗。"},{"source":"四大声腔","target":"弋阳腔","name":"名列","des":"弋阳一腔足迹最广，遍及南北各地。"},{"source":"魏良辅","target":"昆山腔","name":"改良","des":"足不下楼十年，厘正字音板眼成新声。"},{"source":"魏良辅","target":"水磨腔","name":"创制","des":"转喉若丝细腻如磨，水磨调由此立名。"},{"source":"水磨腔","target":"昆曲","name":"定型","des":"水磨新声由清曲入剧曲，昆曲声腔定型。"},{"source":"梁辰鱼","target":"浣纱记","name":"撰作","des":"依水磨新声谱传奇，昆腔登上剧台。"},{"source":"浣纱记","target":"昆曲","name":"首演","des":"改良昆腔付诸场上的开山之作。"},{"source":"汤显祖","target":"临川四梦","name":"撰作","des":"玉茗堂四种皆以梦写情，临川派旗帜。"},{"source":"牡丹亭","target":"临川四梦","name":"压卷","des":"游园惊梦情之所至，四梦之冠冕。"},{"source":"汤显祖","target":"牡丹亭","name":"至情","des":"因情成梦因梦成戏，至情说的结晶。"},{"source":"汤显祖","target":"昆曲","name":"文心","des":"临川词章谱入吴歙，昆剧文学的灵魂。"},{"source":"牡丹亭","target":"昆曲","name":"看家","des":"一折游园惊梦，昆曲生死攸关的戏码。"},{"source":"长生殿","target":"昆曲","name":"晚照","des":"洪昇谱天宝遗事，清代昆剧最后高峰。"},{"source":"桃花扇","target":"昆曲","name":"双璧","des":"借离合写兴亡，与长生殿并称于世。"},{"source":"折子戏","target":"昆曲","name":"精炼","des":"全本摘出精粹，表演千锤百炼而纯。"},{"source":"折子戏","target":"京剧","name":"沿用","des":"京剧承其路数，骨子老戏愈演愈精。"},{"source":"花雅之争","target":"昆曲","name":"雅部","des":"朝廷崇雅抑花，昆曲园地日渐收缩。"},{"source":"花雅之争","target":"地方戏勃兴","name":"催发","des":"花部得势于民间，地方声腔竞相破土。"},{"source":"花雅之争","target":"徽班进京","name":"伏笔","des":"花部既盛，徽汉梆子得以长驱入京。"},{"source":"昆曲","target":"中国戏曲","name":"冠冕","des":"曲牌体之极诣，被尊为百戏之祖。"},{"source":"昆曲","target":"京剧","name":"滋养","des":"身段排场曲词典籍，京剧雅深一脉所自。"},{"source":"弋阳腔","target":"川剧","name":"入川","des":"弋阳遗响化为高腔，帮打唱合为一体。"},{"source":"梆子腔","target":"豫剧","name":"支脉","des":"河南梆子高亢泼辣，梆子腔最大支系。"},{"source":"梆子腔","target":"徽班进京","name":"助阵","des":"秦腔梆子随徽班入京，昆乱杂陈一台。"},{"source":"梆子腔","target":"皮黄腔","name":"互鉴","des":"同为板式变化体，梆黄两路互相取法。"},{"source":"汉调","target":"皮黄腔","name":"孕育","des":"楚调兼唱皮黄，声腔体制于此成熟。"},{"source":"汉调","target":"徽班进京","name":"合流","des":"徽汉艺人同台奏艺，皮黄于京师定型。"},{"source":"皮黄腔","target":"京剧","name":"熔铸","des":"西皮明快二黄深沉，京剧两根声柱。"},{"source":"川剧","target":"地方戏勃兴","name":"竞秀","des":"五腔并存变脸绝技，西南梨园重镇。"},{"source":"豫剧","target":"地方戏勃兴","name":"竞秀","des":"中原梆子豫味十足，流布最广者之一。"},{"source":"越剧","target":"地方戏勃兴","name":"崛起","des":"嵊县唱书化身女子文戏，后起称雄。"},{"source":"黄梅戏","target":"地方戏勃兴","name":"崛起","des":"采茶调自安庆唱向全国，清新可喜。"},{"source":"评剧","target":"地方戏勃兴","name":"崛起","des":"莲花落蹦蹦戏合流，于北地生根。"},{"source":"粤剧","target":"地方戏勃兴","name":"远播","des":"红船子弟四海为台，声名及于南洋。"},{"source":"粤剧","target":"皮黄腔","name":"远绍","des":"梆黄南渐入粤，与粤讴南音合流。"},{"source":"地方戏勃兴","target":"中国戏曲","name":"繁衍","des":"诸腔落地生根，剧种一度逾三百之数。"},{"source":"三庆班","target":"徽班进京","name":"首发","des":"率先入京为高宗祝寿，徽班立足之始。"},{"source":"徽班进京","target":"京剧","name":"孕育","des":"四大徽班扎根京师，备齐班底与声腔。"},{"source":"程长庚","target":"三庆班","name":"掌班","des":"执掌三庆数十年，大老板德艺服人。"},{"source":"程长庚","target":"京剧","name":"开山","des":"熔徽汉昆梆于一炉，被尊开山鼻祖。"},{"source":"程长庚","target":"谭鑫培","name":"师承","des":"谭氏亲炙程门，尽得传承而自变化之。"},{"source":"同光十三绝","target":"程长庚","name":"入画","des":"沈蓉圃图其剧装小像，居十三绝之首。"},{"source":"同光十三绝","target":"京剧","name":"写照","des":"名伶群像传世，同光中兴的图像史。"},{"source":"富连成","target":"京剧","name":"育才","des":"喜富连盛七科相传，人才半座江山。"},{"source":"富连成","target":"马连良","name":"出科","des":"连字科苦功出身，科班严训成大器。"},{"source":"生旦净丑","target":"京剧","name":"骨架","des":"行当四门分工互济，撑起人物世界。"},{"source":"生行","target":"生旦净丑","name":"分立","des":"老生为尊，武生小生各司其职。"},{"source":"旦行","target":"生旦净丑","name":"分立","des":"青衣花旦武旦老旦，坤装一门齐备。"},{"source":"净行","target":"生旦净丑","name":"分立","des":"花脸铜锤架子两路，以气魄声势见长。"},{"source":"丑行","target":"生旦净丑","name":"分立","des":"方巾袍带茶衣武丑，无丑不成戏。"},{"source":"谭鑫培","target":"生行","name":"归属","des":"文武老生兼擅，老生行泰山北斗。"},{"source":"周信芳","target":"生行","name":"归属","des":"麒派老生衰音见劲，做派炽烈如火。"},{"source":"杨小楼","target":"生行","name":"归属","des":"长靠短打并臻化境，武生一代宗师。"},{"source":"马连良","target":"生行","name":"归属","des":"唱念潇洒飘逸，马派老生自成格局。"},{"source":"盖叫天","target":"生行","name":"归属","des":"武松戏震南北，盖派武生自立门户。"},{"source":"梅兰芳","target":"旦行","name":"归属","des":"昆乱不挡兼收并蓄，旦行的天际线。"},{"source":"程砚秋","target":"旦行","name":"归属","des":"幽咽婉转若断若续，旦行自成一峰。"},{"source":"荀慧生","target":"旦行","name":"归属","des":"花旦贴尽人情，荀派自成一路。"},{"source":"尚小云","target":"旦行","name":"归属","des":"文武兼备刚健矫健，尚派独标风骨。"},{"source":"王瑶卿","target":"旦行","name":"革新","des":"融三门为花衫，旦行面目焕然一新。"},{"source":"净行","target":"脸谱","name":"勾画","des":"满面油彩按谱勾填，忠奸一望立判。"},{"source":"丑行","target":"脸谱","name":"豆腐块","des":"只勾小块白粉，与净行大花脸相映。"},{"source":"京剧","target":"中国戏曲","name":"集大成","des":"唱念做打兼备，晚集古典戏曲之大成。"},{"source":"京剧","target":"文武场","name":"场面","des":"琴鼓托腔保调，戏的呼吸与心跳。"},{"source":"谭鑫培","target":"京剧","name":"立极","des":"伶界大王执牛耳，四海无腔不学谭。"},{"source":"谭鑫培","target":"流派（戏曲）","name":"开风气","des":"谭门立派衣钵相传，流派自此成风。"},{"source":"流派（戏曲）","target":"京剧","name":"机制","des":"师承为体独创为用，京剧生命的方式。"},{"source":"王瑶卿","target":"梅兰芳","name":"授艺","des":"因材施教，为梅兰芳点拨花衫新戏。"},{"source":"王瑶卿","target":"程砚秋","name":"授艺","des":"亲为程腔踏戏设计，成就幽咽新声。"},{"source":"王瑶卿","target":"荀慧生","name":"授艺","des":"点化荀派身段，花旦戏别开生面。"},{"source":"王瑶卿","target":"尚小云","name":"授艺","des":"尚派刀马功夫，亦自王门锤炼而出。"},{"source":"王瑶卿","target":"京剧","name":"通天","des":"通天教主门墙桃李，旦行半壁出其门。"},{"source":"梅兰芳","target":"四大名旦","name":"领衔","des":"票选折桂居首，旦行黄金时代旗手。"},{"source":"程砚秋","target":"四大名旦","name":"同列","des":"程腔独绝，与梅派并辔而驰。"},{"source":"荀慧生","target":"四大名旦","name":"同列","des":"荀派俏丽贴人情，四旦各执一端。"},{"source":"尚小云","target":"四大名旦","name":"同列","des":"尚派刚健能戏三百，巾帼不让须眉。"},{"source":"四大名旦","target":"流派（戏曲）","name":"竞秀","des":"同门而异派，各开生面数十年。"},{"source":"四大名旦","target":"京剧","name":"盛世","des":"旦行执剧坛牛耳，京剧鼎盛代名词。"},{"source":"周信芳","target":"流派（戏曲）","name":"立派","des":"麒派炽烈如炬，海派京剧一面旗帜。"},{"source":"男旦","target":"旦行","name":"沿革","des":"旧例女不登台，男旦担纲旦行百年。"},{"source":"男旦","target":"京剧","name":"旧例","des":"四大名旦皆乾旦出身，一时风气所成。"},{"source":"杨小楼","target":"京剧","name":"武戏文唱","des":"境界圆融，杨梅并称一时瑜亮。"},{"source":"梅兰芳","target":"昆曲","name":"取法","des":"身段唱法多得昆曲滋养，古装新戏所本。"},{"source":"四功五法","target":"京剧","name":"功底","des":"唱念做打与手眼身法步，全部家当。"},{"source":"四功五法","target":"程式化表演","name":"相成","des":"功法炼成程式，程式赖功法而活。"},{"source":"板式","target":"京剧","name":"节奏","des":"原板慢板流水快板，快慢总由板起。"},{"source":"板式","target":"皮黄腔","name":"细目","des":"皮黄以板式变化行腔，与曲牌体抗礼。"},{"source":"文武场","target":"板式","name":"司掌","des":"鼓师操板琴师托腔，节奏命脉所系。"},{"source":"水袖","target":"四功五法","name":"做功","des":"抛甩掷挑皆归做功，袖端见心绪。"},{"source":"行头与砌末","target":"京剧","name":"装扮","des":"宁穿破不穿错，一桌二椅可作万事。"},{"source":"贵妃醉酒","target":"梅兰芳","name":"代表作","des":"卧鱼衔杯身段，梅氏雅化的骨子老戏。"},{"source":"贵妃醉酒","target":"京剧","name":"骨子戏","des":"代代打磨的老戏，经点化点石成金。"},{"source":"霸王别姬","target":"梅兰芳","name":"代表作","des":"虞姬舞剑诀别，遂成千古绝唱。"},{"source":"霸王别姬","target":"杨小楼","name":"搭档","des":"杨饰霸王气魄沉雄，梅杨同台双璧。"},{"source":"锁麟囊","target":"程砚秋","name":"代表作","des":"春秋亭避雨赠囊，程腔集大成之作。"},{"source":"穆桂英挂帅","target":"梅兰芳","name":"压轴","des":"五十三岁又出征，梅氏暮年最后新戏。"},{"source":"赵氏孤儿","target":"元杂剧","name":"同题","des":"纪君祥杂剧旧题，程婴救孤故事。"},{"source":"赵氏孤儿","target":"马连良","name":"新编","des":"马派谱皮黄新声，大义凛然千秋。"},{"source":"昆曲","target":"非遗传承","name":"首列","des":"二〇〇一年列首批非遗，古腔重获生机。"},{"source":"京剧","target":"非遗传承","name":"并列","des":"国粹相继入册，薪传至今犹未歇。"},{"source":"牡丹亭","target":"非遗传承","name":"青春版","des":"白先勇新排青春版，唤回青年观众。"},{"source":"程式化表演","target":"中国戏曲","name":"美学","des":"虚拟写意以简驭繁，舞台美学之根。"},{"source":"生旦净丑","target":"四功五法","name":"互训","des":"行当各有功法侧重，四功贯于四门。"},{"source":"诗经","target":"中国文学史","name":"源头","des":"风雅颂三百篇，现实主义的起点。"},{"source":"赋比兴","target":"诗经","name":"手法","des":"六义中的三种表现方法。"},{"source":"楚辞","target":"中国文学史","name":"源头","des":"南方巫风想象，浪漫主义的起点。"},{"source":"屈原","target":"楚辞","name":"创造","des":"楚辞体式因他而定型。"},{"source":"离骚","target":"屈原","name":"著作","des":"路漫漫其修远兮的求索之歌。"},{"source":"诗经","target":"楚辞","name":"双源","des":"北方写实与南方想象两大源头。"},{"source":"先秦诸子散文","target":"中国文学史","name":"一脉","des":"论辩与寓言奠定散文传统。"},{"source":"司马相如","target":"汉赋","name":"高峰","des":"子虚上林的铺陈极致。"},