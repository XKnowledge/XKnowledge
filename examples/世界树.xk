},{"source":"河姆渡榫卯","target":"燕尾榫","name":"先声","des":"新石器时代已有燕尾形榫板的雏形。"},{"source":"鲁班","target":"框锯","name":"传说始创","des":"齿刃故事的起点归于祖师爷。"},{"source":"鲁班","target":"曲尺","name":"传说始创","des":"直角规矩以班为名。"},{"source":"鲁班","target":"《鲁班经》","name":"托名","des":"民间匠籍借祖师之名流传。"},{"source":"《营造法式》","target":"大木作","name":"规范","des":"以材为祖的模数化营造法。"},{"source":"《天工开物》","target":"斧与锛","name":"图录","des":"明代工具谱的写实快照。"},{"source":"样房与烫样","target":"故宫","name":"服务","des":"样式雷图档覆盖清宫主要工程。"},{"source":"木性","target":"木材干燥","name":"前提","des":"含水率不合地域，再好的手艺也会开裂。"},{"source":"木性","target":"穿带","name":"应对","des":"给胀缩留余地的木性设计。"},{"source":"直榫","target":"格肩榫","name":"进阶","des":"从明榫裸露到格肩藏缝。"},{"source":"燕尾榫","target":"粽角榫","name":"组合","des":"多个梯形榫在三面合角处汇合。"},{"source":"夹头榫","target":"插肩榫","name":"同族","des":"案式结构的一体两面，一嵌一插。"},{"source":"抱肩榫","target":"粽角榫","name":"同类","des":"都是多方材角部的立体咬合。"},{"source":"霸王枨","target":"插肩榫","name":"搭档","des":"隐形斜撑替明枨撑住案面。"},{"source":"楔钉榫","target":"燕尾榫","name":"借形","des":"弧材连接同样利用斜面自锁。"},{"source":"走马销","target":"栽榫","name":"同源","des":"以独立销榫做活连接的两条路线。"},{"source":"银锭榫","target":"龙凤榫","name":"补位于","des":"拼板与加固都是它的防区。"},{"source":"龙凤榫","target":"穿带","name":"配套","des":"企口拼板再穿带，桌面的双保险。"},{"source":"大木作","target":"抬梁式","name":"官式","des":"北方宫殿庙宇的主流构架。"},{"source":"大木作","target":"穿斗式","name":"民式","des":"南方民居的轻盈答案。"},{"source":"抬梁式","target":"斗拱","name":"檐下","des":"梁架与屋檐之间由斗拱过渡。"},{"source":"穿斗式","target":"斗拱","name":"省略","des":"穿斗直接承檩，斗拱多不登场。"},{"source":"井干式","target":"大木作","name":"边缘支线","des":"原木垒叠的原始构架存活于林区。"},{"source":"斗拱","target":"斗与升","name":"节点","des":"层叠体系的轴承零件。"},{"source":"斗拱","target":"昂","name":"悬挑","des":"斜昂杠杆把屋檐挑得更远。"},{"source":"斗拱","target":"雀替","name":"同位","des":"都是梁柱交接处的过渡构件。"},{"source":"斗拱","target":"榫卯抗震","name":"机制","des":"节点半刚性变形耗散地震能量。"},{"source":"榫卯抗震","target":"应县木塔","name":"实证","des":"千年地震炮击不倒的木构孤例。"},{"source":"斗拱","target":"独乐寺观音阁","name":"标本","des":"辽代斗拱粗大率真的教科书。"},{"source":"斗拱","target":"故宫","name":"终点","des":"明清斗拱退化为装饰性构件。"},{"source":"《营造法式