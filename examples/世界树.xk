ory":"机构与传动"},{"name":"曲柄摇杆机构","des":"整转的曲柄驱动往复摆动的摇杆：雨刮器与搅拌机的经典节奏。","symbolSize":40,"category":"机构与传动"},{"name":"双曲柄机构","des":"两连架杆皆可整周回转：平行四边形机构让火车车轮同步起舞。","symbolSize":40,"category":"机构与传动"},{"name":"曲柄滑块机构","des":"摇杆演化成滑块：旋转与直线运动的翻译官，内燃机与压缩机的心脏。","symbolSize":40,"category":"机构与传动"},{"name":"格拉肖夫准则","des":"最短杆与最长杆之和不超过其余两杆之和时存在曲柄：四杆机构有解的判据。","symbolSize":40,"category":"机构与传动"},{"name":"凸轮机构","des":"廓形即程序：按设计好的运动规律定制从动件升程，内燃机配气机构的灵魂。","symbolSize":50,"category":"机构与传动"},{"name":"齿轮传动","des":"轮齿啮合实现瞬时传动比恒定：结构紧凑的刚性传动主干道。","symbolSize":50,"category":"机构与传动"},{"name":"渐开线齿廓","des":"基圆展开线保证啮合角恒定与中心距可分性：齿轮互换性的几何基石。","symbolSize":40,"category":"机构与传动"},{"name":"轮系与减速器","des":"多级齿轮级联将电机高转速换成大扭矩：传动系统的大后方。","symbolSize":40,"category":"机构与传动"},{"name":"行星轮系","des":"太阳轮、行星轮与系杆同轴套装：结构紧凑的大速比密码。","symbolSize":40,"category":"机构与传动"},{"name":"蜗轮蜗杆","des":"交错轴大速比传动且可自锁：起重与卷扬装置的防倒转保险。","symbolSize":40,"category":"机构与传动"},{"name":"带传动","des":"挠性带靠预紧摩擦传力：运行平稳且过载打滑是天然保险丝。","symbolSize":40,"category":"机构与传动"},{"name":"链传动","des":"链节与链轮啮合无弹性滑动：自行车与摩托车的动力链条。","symbolSize":40,"category":"机构与传动"},{"name":"间歇机构","des":"把连续转动切成时动时停：自动机械与包装线的节拍器。","symbolSize":40,"category":"机构与传动"},{"name":"槽轮机构","des":"拨销驱动径向槽实现步进转动：电影放映机每秒二十四次的换幅机构。","symbolSize":40,"category":"机构与传动"},{"name":"棘轮机构","des":"棘爪单向咬合防倒转并传递间歇运动：牛头刨床进给与千斤顶的机关。","symbolSize":40,"category":"机构与传动"},{"name":"螺旋传动","des":"回转与直线运动的互换：机床进给丝杠与螺旋千斤顶的原理。","symbolSize":40,"category":"机构与传动"},{"name":"谐波减速器","des":"波发生器令柔轮变形啮合：机器人关节里小体积大速比的后起之秀。","symbolSize":40,"category":"机构与传动"},{"name":"无级变速器","des":"锥盘与钢带连续调节传动比：汽车换挡无顿挫的机械方案。","symbolSize":40,"category":"机构与传动"},{"name":"机械工程","des":"将能量与材料转化为有用动力与运动的装置和学问：从杠杆与齿轮到机器人与智能制造。","symbolSize":70,"category":"机械设计基础"},{"name":"强度与刚度","des":"不断裂与不过量变形的双重底线：机械零件设计校核的第一问。","symbolSize":50,"category":"机械设计基础"},{"name":"疲劳与S-N曲线","des":"循环应力下裂纹萌生扩展的无警示失效：绝大多数机械事故的元凶。","symbolSize":40,"category":"机械设计基础"},{"name":"公差与配合","des":"基孔制与基轴制规定尺寸变动区间：零件互换性与大批量生产的契约。","symbolSize":50,"category":"机械设计基础"},{"