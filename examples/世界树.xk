symbolSize":50,"category":"感知"},{"name":"卡尔曼滤波","des":"预测加更新的递归估计，高斯世界状态估计的标准答案。","symbolSize":50,"category":"感知"},{"name":"粒子滤波","des":"用随机采样粒子逼近任意分布，非高斯非线性系统的救场者。","symbolSize":40,"category":"感知"},{"name":"深度学习感知","des":"卷积网络识别物体与场景，感知精度十年间的质的飞跃。","symbolSize":40,"category":"感知"},{"name":"反馈控制","des":"用误差不断纠正自己的闭环思想，自动化的哲学核心。","symbolSize":50,"category":"控制与规划"},{"name":"PID控制","des":"比例积分微分三兄弟的组合拳，工业控制的万金油。","symbolSize":50,"category":"控制与规划"},{"name":"轨迹跟踪","des":"让末端沿期望轨迹行进，位置控制的进阶形态。","symbolSize":40,"category":"控制与规划"},{"name":"阻抗控制","des":"控制机器人与环境接触时的软硬，打磨装配的必需品。","symbolSize":40,"category":"控制与规划"},{"name":"力控制","des":"直接调控接触力而非位置，人机共处的分寸感。","symbolSize":40,"category":"控制与规划"},{"name":"模型预测控制","des":"滚动优化未来时域内的控制序列，处理约束的强者。","symbolSize":40,"category":"控制与规划"},{"name":"运动规划","des":"在障碍丛生的空间里为机器人找一条可行路径。","symbolSize":50,"category":"控制与规划"},{"name":"构型空间","des":"以关节坐标为轴的空间表示，障碍映射后规划豁然开朗。","symbolSize":40,"category":"控制与规划"},{"name":"RRT","des":"快速探索随机树：随机撒点探测高维空间的规划算法。","symbolSize":40,"category":"控制与规划"},{"name":"A*算法","des":"启发式搜索网格图的最短路，游戏与导航的常青树。","symbolSize":40,"category":"控制与规划"},{"name":"避障","des":"感知障碍、实时绕行的局部导航本能。","symbolSize":40,"category":"控制与规划"},{"name":"SLAM","des":"同时定位与建图：没有地图时边画地图边找自己，自主机器的元问题。","symbolSize":70,"category":"定位与建图"},{"name":"定位","des":"我在哪：给定地图或先验下的位姿估计。","symbolSize":40,"category":"定位与建图"},{"name":"建图","des":"周围什么样：占据栅格、点云与特征地图三种表达。","symbolSize":40,"category":"定位与建图"},{"name":"视觉SLAM","des":"以相机为主的 SLAM：特征点法与直接法两大流派。","symbolSize":50,"category":"定位与建图"},{"name":"回环检测","des":"认出曾经来过的地方，把累积漂移一键归零的关键。","symbolSize":40,"category":"定位与建图"},{"name":"图优化（位姿图）","des":"把位姿与观测建成因子图联合优化，后端的数学骨架。","symbolSize":40,"category":"定位与建图"},{"name":"占据栅格地图","des":"把空间切成格子标记占据概率，扫地机器人的经典底图。","symbolSize":40,"category":"定位与建图"},{"name":"粒子滤波定位","des":"蒙特卡洛定位：一群粒子代表位姿假设的重采样生存游戏。","symbolSize":40,"category":"定位与建图"},{"name":"多视图几何","des":"对极几何与基本矩阵，双目与多相机的三维重建基础。","symbolSize":40,"category":"定位与建图"},{"name":"视觉里程计","des":"逐帧估计相机自身运动，SLAM 的前端主力。"