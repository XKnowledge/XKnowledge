{"version":2,"nodes":[{"name":"气象学","des":"研究大气现象及其演变规律的科学：从一朵云的形成到全球气候的变迁。","symbolSize":70,"category":"大气基础"},{"name":"大气分层","des":"对流层、平流层到散逸层：天气的舞台在底层。","symbolSize":40,"category":"大气基础"},{"name":"大气成分","des":"氮氧为主、水汽与二氧化碳为配角的大气汤。","symbolSize":30,"category":"大气基础"},{"name":"气温与辐射","des":"太阳短波进出与地面长波滞留：能量的收支账。","symbolSize":40,"category":"大气基础"},{"name":"气压与气压梯度","des":"单位距离的气压差：风的动力来源。","symbolSize":40,"category":"大气基础"},{"name":"湿度与露点","des":"大气的水账：饱和与凝结的门槛。","symbolSize":30,"category":"大气基础"},{"name":"蒸发凝结","des":"水的相变：云雨雾露的物理内核。","symbolSize":30,"category":"大气基础"},{"name":"云的分类","des":"十云属：高度与形状的命名法。","symbolSize":40,"category":"大气基础"},{"name":"雾","des":"贴地的云：辐射雾与平流雾。","symbolSize":30,"category":"大气基础"},{"name":"降水的形成","des":"碰并与冰晶效应：雨滴雪花的诞生。","symbolSize":40,"category":"大气基础"},{"name":"气温直减率与绝热","des":"干绝热与湿绝热：气块升降的温度曲线。","symbolSize":30,"category":"大气基础"},{"name":"大气稳定度","des":"气块回不回家：对流能否发展的判据。","symbolSize":40,"category":"大气基础"},{"name":"气团","des":"大范围均匀的空气：冷气团与暖气团。","symbolSize":30,"category":"大气基础"},{"name":"风","des":"空气的水平流动：从微风到狂风。","symbolSize":30,"category":"大气基础"},{"name":"天气图","des":"等压线与系统的地图：预报员的老朋友。","symbolSize":40,"category":"天气系统"},{"name":"锋面","des":"冷暖干湿的交绥：冷锋、暖锋与静止锋。","symbolSize":50,"category":"天气系统"},{"name":"温带气旋","des":"中纬度的低压系统：波动发展的一生。","symbolSize":50,"category":"天气系统"},{"name":"反气旋","des":"高压系统：晴朗与下沉的稳定。","symbolSize":30,"category":"天气系统"},{"name":"急流","des":"高空西风的窄河道：万米高空的河流。","symbolSize":30,"category":"天气系统"},{"name":"季风","des":"海陆热力差的季节节拍：东亚的雨热同季。","symbolSize":40,"category":"天气系统"},{"name":"副热带高压","des":"西太平洋副高：雨带进退的总指挥。","symbolSize":40,"category":"天气系统"},{"name":"厄尔尼诺与拉尼娜","des":"ENSO：赤道太平洋的冷热摇摆。","symbolSize":40,"category":"天气系统"},{"name":"沃克环流","des":"赤道太平洋的东西翻腾：厄尔尼诺的母体。","symbolSize":30,"category":"天气系统"},{"name":"阻塞高压","des":"环流的梗塞：天气形势的卡顿。","symbolSize":30,"category":"天气系统"},{"name":"寒潮","des":"蒙古高压的倾泻：冬季的强冷空气。","symbolSize":30,"category":"天气系统"},{"name":"局地环流","des":"海陆风、山谷风与焚风：地方性的风系。","symbolSize":30,"category":"天气系统"},{"name":"台风","des":"旋转的热机：眼区、眼壁与螺旋雨带。","symbolSize":60,"category":"天气系统"},{"name":"梅雨","des":"六月的静止锋：江淮的连绵雨季。","symbolSize":30,"category":"天气系统"},{"name":"强对流","des":"雷暴与飑线：不稳定能量的集中释放。","symbolSize":40,"category":"灾害性天气"},{"name":"超级单体","des":"旋转的对流风暴：龙卷之母。","symbolSize":30,"category":"灾害性天气"},{"name":"龙卷风","des":"藤田分级的风中刺客：EF0到EF5。","symbolSize":40,"category":"灾害性天气"},{"name":"冰雹","des":"强上升里的冰粒循环：越滚越大。","symbolSize":30,"category":"灾害性天气"},{"name":"闪电与雷","des":"电荷分离与放电：云内云间云地。","symbolSize":30,"category":"灾害性天气"},{"name":"下击暴流","des":"直线下击的狂风：易被误认龙卷。","symbolSize":30,"category":"灾害性天气"},{"name":"沙尘暴","des":"冷锋后的大风卷沙：能见度骤降。","symbolSize":30,"category":"灾害性天气"},{"name":"高温热浪","des":"副高控制下的伏旱：越来越频繁。","symbolSize":30,"category":"灾害性天气"},{"name":"暴雪与冻雨","des":"锋面逆温的产物：压垮电线的雨凇。","symbolSize":30,"category":"灾害性天气"},{"name":"风暴潮","des":"台风的风与低压抽吸：海面的隆起。","symbolSize":30,"category":"灾害性天气"},{"name":"气象观测","des":"百叶箱、自动站与浮标：大地的感官。","symbolSize":40,"category":"观测与预报"},{"name":"探空气球","des":"升空的哨兵：温压湿风的垂直剖面。","symbolSize":30,"category":"观测与预报"},{"name":"气象雷达","des":"多普勒回波：探测降水的显微镜。","symbolSize":50,"category":"观测与预报"},{"name":"气象卫星","des":"风云与 GOES：静止与极轨的天眼。","symbolSize":40,"category":"观测与预报"},{"name":"数值天气预报","des":"以大气方程组算出天气：理查德森的梦想成真。","symbolSize":60,"category":"观测与预报"},{"name":"集合预报","des":"多初值多模式的投票：不确定性的量化。","symbolSize":30,"category":"观测与预报"},{"name":"蝴蝶效应与可预报性","des":"洛伦兹的混沌：两周左右的理论极限。","symbolSize":40,"category":"观测与预报"},{"name":"短临预报","des":"零到两小时的临近外推：雷达回波的追踪。","symbolSize":30,"category":"观测与预报"},{"name":"再分析资料","des":"模式加观测的回算：几十年的气候档案。","symbolSize":30,"category":"观测与预报"},{"name":"人工影响天气","des":"增雨与防雹：向云要水的尝试。","symbolSize":30,"category":"观测与预报"},{"name":"气候学","des":"天气的长期统计与物理：气候即平均与变率。","symbolSize":50,"category":"气候学"},{"name":"气候系统","des":"大气、海洋、陆地、冰雪与生物圈：五大圈层的耦合。","symbolSize":40,"category":"气候学"},{"name":"柯本气候分类","des":"以气温降水与植被划分的气候地图。","symbolSize":40,"category":"气候学"},{"name":"三圈环流","des":"哈德来、费雷尔与极地环流：全球环流的底盘。","symbolSize":40,"category":"气候学"},{"