{
  "version": 2,
  "title": "中土世界",
  "description": "从爱努的大乐章到灰港的最后一航：维拉、精灵、人类、矮人与霍比特人在三个纪元里争夺、守护与放下魔戒的漫长史诗。",
  "nodes": [
    { "name": "中土世界", "des": "托尔金以一生构筑的架空世界，语言先于故事存在，种族、纪元与地理彼此咬合如真实历史。", "symbolSize": 70, "category": "创世与全景" },
    { "name": "伊露维塔", "des": "独一的神，以大乐章孕育万物蓝图，首生儿女是精灵，次生儿女是人类，矮人则是后补的私生子。", "symbolSize": 50, "category": "维拉与迈雅" },
    { "name": "曼威", "des": "气息之主，维拉之王，俯瞰整个阿尔达的风与鹰都听他调遣，却始终不懂邪恶的深度。", "symbolSize": 40, "category": "维拉与迈雅" },
    { "name": "瓦尔妲", "des": "星辰之后，点亮双树时代的星空，精灵呼其名而光即至，是中土夜空的所有源头。", "symbolSize": 40, "category": "维拉与迈雅" },
    { "name": "奥力", "des": "工匠维拉，大地与锻造之主，等不及精灵醒来便偷偷造了矮人，是所有匠艺的守护者。", "symbolSize": 40, "category": "维拉与迈雅" },
    { "name": "雅凡娜", "des": "果实与生长之后，一切植物的神，为保护树木而请求造出树人来守林。", "symbolSize": 40, "category": "维拉与迈雅" },
    { "name": "曼督斯", "des": "命运与审判的维拉，记得一切已发生与将发生之事，说出的话即是预言。", "symbolSize": 40, "category": "维拉与迈雅" },
    { "name": "涅娜", "des": "怜悯与哀伤的维拉，教人以眼泪理解苦难，曼督斯的妻子。", "symbolSize": 40, "category": "维拉与迈雅" },
    { "name": "米尔寇", "des": "维拉中最强大者，堕入傲慢与毁灭，成为大敌魔苟斯：毒杀双树、窃走宝钻、给世界钉进一切苦难。", "symbolSize": 50, "category": "维拉与迈雅" },
    { "name": "美丽安", "des": "侍奉瓦尔妲的迈雅，下嫁精灵王辛葛，以歌之结界守护多瑞亚斯千年，露西恩之母。", "symbolSize": 40, "category": "维拉与迈雅" },
    { "name": "萨鲁曼", "des": "白袍巫师，迈雅中的智者之首，因研究敌人而迷上力量，最终堕落成一个小号的暴君。", "symbolSize": 40, "category": "维拉与迈雅" },
    { "name": "索伦", "des": "魔苟斯的大将被留下的遗产，锻造至尊魔戒奴役诸族，被斩去肉身后以魔眼横贯第三纪元。", "symbolSize": 60, "category": "维拉与迈雅" },
    { "name": "甘道夫", "des": "灰袍巫师，迈雅欧络因，白道会的火种，以劝导代替强权，倒在墨瑞亚又以白袍归来。", "symbolSize": 60, "category": "维拉与迈雅" },
    { "name": "炎魔", "des": "堕落的火焰迈雅，都灵的克星，盘踞墨瑞亚深处直到与甘道夫在桥上同坠深渊。", "symbolSize": 40, "category": "维拉与迈雅" },
    { "name": "芬威", "des": "三支精灵亲族的共同祖先，首位被邀前往维林诺的精灵王，死于魔苟斯劫宝之夜。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "费艾诺", "des": "诺多族最伟大的匠人，打造三颗精灵宝钻，其誓言把整个族裔拖进永劫的血债。", "symbolSize": 50, "category": "精灵谱系" },
    { "name": "芬国昐", "des": "费艾诺的异母弟，坚忍者，率族横越冰原，在精灵与魔苟斯的首次决斗中单挑大敌而殒。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "菲纳芬", "des": "芬威第三子，留在维林诺的最小一支，其后裔却在贝烈瑞安德大放光芒。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "芬巩", "des": "芬国昐之子，救援表亲、号角吹响孤山之战的义王，被炎魔拖入烈火。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "图尔巩", "des": "芬国昐幼子，隐匿之城贡多林的缔造者，坚壁最终毁于侄孙的背叛。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "辛葛", "des": "灰精灵之王，多瑞亚斯的统治者，以美丽安的结界守住中土最后的和平。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "伊缀尔德", "des": "贡多林的黄金公主，冲破戒律嫁予人类图奥，生下大航海者埃雅仁迪尔。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "露西恩", "des": "精灵与迈雅的女儿，贝烈瑞安德最美的歌者，为爱下闯地府，从魔苟斯冠上夺回宝钻。", "symbolSize": 50, "category": "精灵谱系" },
    { "name": "加拉德瑞尔", "des": "亲历三个纪元的诺多公主，罗斯洛立安的白夫人，抵抗魔戒诱惑直到最后渡海。", "symbolSize": 50, "category": "精灵谱系" },
    { "name": "凯勒鹏", "des": "加拉德瑞尔之夫，银泉之名的主人，与妻子共治黄金森林。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "瑟兰迪尔", "des": "幽暗密林的精灵王，孤山王庭的旧账让他对矮人全无好感。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "莱戈拉斯", "des": "瑟兰迪尔之子，远征队中的精灵代表，与金雳的友谊跨越了种族宿怨。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "埃尔隆德", "des": "半精灵，瑞文戴尔之主，持维雅之戒，选择精灵命运，让女儿自己选择凡人之路。", "symbolSize": 50, "category": "精灵谱系" },
    { "name": "埃尔罗斯", "des": "埃尔隆德的双生兄弟，选择人类命运，成为努门诺尔开国之王，血脉直抵阿拉贡。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "埃雅仁迪尔", "des": "图奥与伊缀尔德之子，大航海者，携宝钻横渡天空成为晨星，为人类求得诸神出手。", "symbolSize": 50, "category": "精灵谱系" },
    { "name": "吉尔加拉德", "des": "最后的高等精灵王，最后联盟之战中与索伦同归于炽焰。", "symbolSize": 40, "category": "精灵谱系" },
    { "name": "贝伦", "des": "人类英雄，为迎娶露西恩只身闯入魔苟斯铁冠之厅，以断掌换回一颗宝钻。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "图奥", "des": "被命运与天鹅指引的人类，进入贡多林娶得公主，其子成为两大种族的桥梁。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "胡林", "des": "最强大的人类战士，被魔苟斯俘虏后钉上高椅，被迫目睹全家被诅咒吞没。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "图林", "des": "胡林之子，黑剑，一生逃离诅咒却步步踏进诅咒，命运的悲剧内核比死亡更黑。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "埃兰迪尔", "des": "努门诺尔忠贞派的领袖，携两子逃离沉岛，在中土共建刚铎与阿诺。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "伊熙尔杜", "des": "从索伦手上斩下魔戒又拒绝销毁的人类王，「这是我的」一句话买下三千年祸根。", "symbolSize": 50, "category": "人类与家族" },
    { "name": "阿纳瑞安", "des": "伊熙尔杜之弟，刚铎的共同奠基者，战死于巴拉督尔塔下。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "阿拉贡", "des": "伊熙尔杜的第四十代直系，人称「大步」的游侠，持重铸圣剑走完从流浪者到人皇的漫长加冕礼。", "symbolSize": 60, "category": "人类与家族" },
    { "name": "阿尔玟", "des": "埃尔隆德之女，暮星，为阿拉贡放弃不朽，选择露西恩一样的凡人命运。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "希优顿", "des": "洛汗骠骑王，从萨鲁曼的傀儡咒中醒来，率骑兵冲锋圣盔谷与佩兰诺，马革裹尸。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "伊奥梅尔", "des": "希优顿的外甥与继承人，骠骑第三元帅，战后的洛汗之王。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "伊奥温", "des": "洛汗之女，扮男装冲锋佩兰诺，与梅里合力斩杀戒灵之首，破了无人能杀他的预言。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "波罗米尔", "des": "刚铎宰相长子，刚勇正直却在魔戒前失守，以三箭之死赎回自己的荣誉。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "法拉米尔", "des": "波罗米尔之弟，父亲眼中不如兄长的幼子，却是唯一主动拒绝魔戒诱惑的人类。", "symbolSize": 40, "category": "人类与家族" },
    { "name": "都灵", "des": "矮人七族之祖中的长生者，墨瑞亚的奠基王，其血脉与克星同名于地底。", "symbolSize": 40, "category": "矮人霍比特与异族" },
    { "name": "索林·橡木盾", "des": "都灵一脉的流亡王，十二同伴远征收复孤山，在五军之战的黄金堆上读懂了贪婪。", "symbolSize": 50, "category": "矮人霍比特与异族" },
    { "name": "巴林", "des": "索林的堂弟与忠仆，晚年率殖民队重返墨瑞亚，墓碑被后来者含泪读过。", "symbolSize": 40, "category": "矮人霍比特与异族" },
    { "name": "金雳", "des": "格罗因之子，远征队中的矮人，与莱戈拉斯结为生死之交，最终独获渡海恩典。", "symbolSize": 40, "category": "矮人霍比特与异族" },
    { "name": "比尔博", "des": "袋底洞的体面霍比特人，被甘道夫拽进冒险，在山洞摸到一枚改变世界的戒指。", "symbolSize": 50, "category": "矮人霍比特与异族" },
    { "name": "弗罗多", "des": "继承戒指的霍比特人，以最弱小的肩膀扛起魔戒走向末日火山，慈悲放走了咬他的咕噜。", "symbolSize": 60, "category": "矮人霍比特与异族" },
    { "name": "山姆", "des": "弗罗多的园丁，「我不能替你背戒指，但我能背你」，真正的无名英雄。", "symbolSize": 50, "category": "矮人霍比特与异族" },
    { "name": "梅里", "des": "霍比特四客之一，随骑士参军，在佩兰诺战场上帮伊奥温补上致命一刺。", "symbolSize": 40, "category": "矮人霍比特与异族" },
    { "name": "皮平", "des": "最年轻的霍比特，好奇心闯祸无数，却在白城点燃了求援的烽火。", "symbolSize": 40, "category": "矮人霍比特与异族" },
    { "name": "咕噜", "des": "被戒指吃了五百年的霍比特人斯密戈，双重人格在洞穴黑暗里自言自语，命运最后成了销毁魔戒的左手。", "symbolSize": 50, "category": "矮人霍比特与异族" },
    { "name": "树胡", "des": "法贡森林最古老的恩特，牧树人，被萨鲁曼的斧头逼出千年沉睡，率树须大军踏平艾辛格。", "symbolSize": 40, "category": "矮人霍比特与异族" },
    { "name": "史毛革", "des": "孤山之下的火龙，魔苟斯时代的最后遗孽，睡在黄金上，死于黑箭对空鳞缺口的精确一击。", "symbolSize": 40, "category": "矮人霍比特与异族" },
    { "name": "兽人", "des": "魔苟斯以扭曲精灵育成的战斗种族，恨光恨自己恨一切，是两位黑主君的军械基数。", "symbolSize": 40, "category": "矮人霍比特与异族" },
    { "name": "戒灵", "des": "接受九戒的人类君王，千年后化为索伦的阴影奴仆，为首的安格玛巫王无人能杀。", "symbolSize": 40, "category": "矮人霍比特与异族" },
    { "name": "夏尔", "des": "霍比特人的田园四分之一区，与世无争的绿色角落，整个大战的终点是保卫它。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "布理", "des": "夏尔以东的杂居小镇，跃马客栈是弗罗多首次亮出魔戒名字的地方。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "瑞文戴尔", "des": "埃尔隆德的隐谷之家，幽谷深处的最后庇护所，远征队在此结成。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "罗斯洛立安", "des": "黄金森林，加拉德瑞尔夫妇的镜与光之地，时间在其中流得比外面慢。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "迷雾山脉", "des": "纵贯中土的巨脊，风暴、石巨人与地底王国层层叠叠，咕噜曾藏在其最深水潭边。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "墨瑞亚", "des": "都灵一族的卡扎督姆，矮人最伟大的地底都城，因掘深米斯瑞尔而唤醒了炎魔。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "贡多林", "des": "图尔巩的隐匿白城，被群山与守密结界藏了四百年，终毁于叛徒与烈焰之龙。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "多瑞亚斯", "des": "辛葛与美丽安的地下王国，大乐章时期中土唯一的乐土。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "贝烈瑞安德", "des": "第一纪元的主战场，精灵与人类的百战之地，愤怒之战后整体沉入海中。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "阿门洲", "des": "诸神居住的蒙福之地，精灵的白船独享航路，凡人航向西即是死亡或奇迹。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "灰港", "des": "造船者奇尔丹的滨海港，精灵渡海西去的出发地，最后一航从这里起锚。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "刚铎", "des": "南方人类的石之城邦，埃兰迪尔二子所建，千年守护着对抗魔多的前线。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "米那斯提力斯", "des": "白城，七环之城，王座空置千年等一位持剑归来的人。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "米那斯魔窟", "des": "曾经的月之城，堕落为戒灵盘踞的妖术之城，与白城隔谷相望。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "洛汗", "des": "马背上的王国，希优顿的骠骑之地，以骑兵与誓言著称。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "圣盔谷", "des": "号角堡深谷，洛汗最后的要塞，一夜血战等来了黎明的骑兵。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "魔多", "des": "黑门之后的阴影之国，火山、灰烬与铁的军营，索伦的魔眼日夜环视。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "末日火山", "des": "欧洛都因，至尊魔戒铸成之地，也是整个世界上唯一能销毁它的裂缝。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "艾辛格", "des": "努门诺尔式的环塔山谷，萨鲁曼的领地，树须的洪水冲垮了它的军械库。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "法贡森林", "des": "最古老的森林，恩特与树须的领地，树木会走路，也会记仇。", "symbolSize": 40, "category": "地理与国度" },
    { "name": "昆雅语", "des": "高等精灵语，维林诺的拉丁语，宝钻与挽歌的语言，第三纪元已是学者的古典。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "辛达语", "des": "灰精灵语，中土精灵的日常语言，多瑞亚斯的方言成了通行语。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "阿都纳克语", "des": "努门诺尔的人类语言，随王国的傲慢一同沉入海浪。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "库兹都语", "des": "矮人的族语，外族绝不传授，连战歌都只刻在石壁上。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "黑语", "des": "索伦为奴役诸族造的语言，至尊魔戒内圈的铭文用它写成，念出口便天色骤暗。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "通用语", "des": "中土的西部语，托尔金声称全书都是它的「英语译本」。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "恩特语", "des": "树人绵长的语言，说「你好」要耗上一个下午，最接近树木的心跳。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "托尔金", "des": "牛津的古英语教授，先造语言再造世界来承载它们，一封圣诞信开头写出一整个中土。", "symbolSize": 50, "category": "语言与著作" },
    { "name": "克里斯托弗·托尔金", "des": "幼子与遗稿执行人，用半个世纪整理《精灵宝钻》与《中洲历史》，让父亲的抽屉变成了学科。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "《霍比特人》", "des": "1937 年的童话体冒险，比尔博与十三矮人的孤山之路，意外捡起了二十世纪的奇幻史诗的引信。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "《魔戒》", "des": "奇幻文学的珠穆朗玛，护戒远征的三部曲，友谊、诱惑与放弃权力的现代史诗。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "《精灵宝钻》", "des": "托尔金一生的底稿，创世到第一纪元的神话骨架，作者死后四年由幼子整理出版。", "symbolSize": 40, "category": "语言与著作" },
    { "name": "至尊魔戒", "des": "索伦在末日火山倾入权能与寿命的主戒，「一戒统御众戒」，以隐身与延寿诱捕每一个持有者。", "symbolSize": 60, "category": "器物与圣物" },
    { "name": "精灵三戒", "des": "未被索伦染指的三枚至美之戒：纳雅藏火、南雅藏水、维雅藏气，分别护佑智慧、庇护与治愈。", "symbolSize": 40, "category": "器物与圣物" },
    { "name": "七戒与九戒", "des": "索伦假手精灵工匠分发的十六戒，矮人七戒养出贪婪，人类九戒养出戒灵。", "symbolSize": 40, "category": "器物与圣物" },
    { "name": "精灵宝钻", "des": "费艾诺封存双树之光的三颗宝石，与其说宝物不如说诅咒，一颗升天、一颗入火、一颗沉海。", "symbolSize": 50, "category": "器物与圣物" },
    { "name": "安都瑞尔", "des": "纳希尔圣剑重铸之名，伊熙尔杜断刃传家的星辰之刃，阿拉贡加冕之路的佩剑。", "symbolSize": 40, "category": "器物与圣物" },
    { "name": "敌击剑", "des": "贡多林遗剑 Glamdring，甘道夫自巨魔洞穴所得，与刺针同出一脉。", "symbolSize": 40, "category": "器物与圣物" },
    { "name": "刺针", "des": "比尔博传给弗罗多的小精灵短剑，半兽人靠近时发出蓝光。", "symbolSize": 40, "category": "器物与圣物" },
    { "name": "阿肯宝珠", "des": "孤山之心，矮人王室的传家宝石，索林临终才明白它贵过整座金山。", "symbolSize": 40, "category": "器物与圣物" },
    { "name": "帕蓝提尔", "des": "七枚真知晶球，努门诺尔的遗物，用来望远传讯，也能被更强的意志反噬。", "symbolSize": 40, "category": "器物与圣物" },
    { "name": "米斯瑞尔", "des": "真银，轻如絮硬如龙鳞，墨瑞亚的命脉，一件锁子衫抵得过一个王国。", "symbolSize": 40, "category": "器物与圣物" },
    { "name": "爱努的大乐章", "des": "创世之乐，众神以声部合唱世界蓝图，米尔寇的杂音成了苦难的种子。", "symbolSize": 40, "category": "纪元与大战" },
    { "name": "双树纪", "des": "维林诺金银双树照亮的远古，精灵苏醒渡海，以双树之光被窃告终。", "symbolSize": 40, "category": "纪元与大战" },
    { "name": "愤怒之战", "des": "诸神亲自下场的终战，魔苟斯被缚入虚空，整片贝烈瑞安德为此沉海。", "symbolSize": 40, "category": "纪元与大战" },
    { "name": "努门诺尔沦亡", "des": "人类岛屿王国的傲慢终局：听信索伦驶向不死之地，整岛被海吞没，只有忠贞派驾船逃生。", "symbolSize": 40, "category": "纪元与大战" },
    { "name": "最后联盟之战", "des": "第二纪元末，吉尔加拉德与埃兰迪尔联手击倒索伦，伊熙尔杜却留下魔戒，埋下三千年伏笔。", "symbolSize": 40, "category": "纪元与大战" },
    { "name": "五军之战", "des": "孤山下的精灵、人类、矮人对半兽人与狼骑的大混战，比尔博在营地里被一石砸晕。", "symbolSize": 40, "category": "纪元与大战" },
    { "name": "圣盔谷之战", "des": "萨鲁曼的乌鲁克大军夜攻号角堡，黎明时分甘道夫率援军从山坡冲锋而下。", "symbolSize": 40, "category": "纪元与大战" },
    { "name": "佩兰诺平野之战", "des": "白城之下的存亡之战，骠骑冲锋、南海驰援、戒灵授首，千年王城的黎明。", "symbolSize": 40, "category": "纪元与大战" },
    { "name": "黑门之战", "des": "阿拉贡以寡击众的诱敌棋，用一支送死的军队为两个霍比特人换来走完最后一里的时间。", "symbolSize": 40, "category": "纪元与大战" },
    { "name": "魔戒大战", "des": "第三纪元的终局战争，九人远征、两线作战，以一枚戒指坠入火焰结束，精灵时代随之落幕。", "symbolSize": 50, "category": "纪元与大战" }
  ],
