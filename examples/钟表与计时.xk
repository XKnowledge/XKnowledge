{
  "version": 2,
  "title": "钟表与计时",
  "description": "从日晷漏刻到光钟与 UTC：擒纵机构的千年进化、航海钟与制表大师、石英危机与原子标准——人类给时间刻度的全部手艺。",
  "nodes": [
    { "name": "钟表与计时", "des": "给看不见的时间刻上刻度的全部手艺：从影子和滴水，到摆轮与石英，再到铯原子的跃迁——计时器的每一次进步，都是文明对确定性的又一次进攻。", "symbolSize": 70, "category": "古代计时" },
    { "name": "日晷", "des": "以晷针影子扫过刻度盘的太阳能钟表，晴天专属，且每天都不太一样。", "symbolSize": 40, "category": "古代计时" },
    { "name": "漏刻", "des": "以均匀滴水或泄水计时的水钟，中国宫廷以刻漏分昼夜为百刻。", "symbolSize": 40, "category": "古代计时" },
    { "name": "沙漏", "des": "不受冰冻与晃动影响的干式计时器，航海与布道的标配计时沙账。", "symbolSize": 40, "category": "古代计时" },
    { "name": "更香与火钟", "des": "以燃烧速度计时的香篆，一炷香的浪漫里藏着等时分段的朴素工程。", "symbolSize": 40, "category": "古代计时" },
    { "name": "水运仪象台", "des": "苏颂 1092 年建成的水力天文钟楼，「天衡」机构是世界最早的擒纵记载。", "symbolSize": 40, "category": "古代计时" },
    { "name": "机械钟", "des": "约 1300 年前后诞生于欧洲教堂塔楼的重锤钟，时间第一次从流动变成齿轮。", "symbolSize": 50, "category": "机械钟诞生" },
    { "name": "机轴擒纵", "des": "冠状轮与立轴的最原始擒纵，每天一刻钟的误差也足以安排祈祷。", "symbolSize": 40, "category": "机械钟诞生" },
    { "name": "平衡摆杆", "des": "foliot 杆式调速器，往复横跳的无弹簧摆轮前传，精度全靠手感配重。", "symbolSize": 40, "category": "机械钟诞生" },
    { "name": "塔钟与公共时钟", "des": "钟楼把时间从修道院挂上城市天空，公共时间是市民社会的第一件共享品。", "symbolSize": 40, "category": "机械钟诞生" },
    { "name": "发条动力", "des": "盘簧储能让钟表离开重锤与墙，便携计时从座钟走向怀表。", "symbolSize": 40, "category": "机械钟诞生" },
    { "name": "均力圆锥轮", "des": "fusee 宝塔轮以锥形绳轮补偿发条力矩衰减，发条时代的第一课微积分。", "symbolSize": 40, "category": "机械钟诞生" },
    { "name": "擒纵机构", "des": "钟表的心脏瓣膜：把动力切成等份的嗒嗒声，一切精度的来源。", "symbolSize": 50, "category": "摆钟革命" },
    { "name": "惠更斯", "des": "1656 年把伽利略的摆的等时性装进钟壳，误差从每天一刻钟降到一分钟内。", "symbolSize": 50, "category": "摆钟革命" },
    { "name": "摆钟", "des": "以单摆为节拍器的钟，两个世纪里人类最准的机器。", "symbolSize": 40, "category": "摆钟革命" },
    { "name": "锚式擒纵", "des": "1670 年前后的英国改良，摆幅缩小的同时齿尖不再猛推，精度与寿命同涨。", "symbolSize": 40, "category": "摆钟革命" },
    { "name": "格雷厄姆直进式擒纵", "des": "1715 年的死拍擒纵让秒针稳稳走格，天文台级精度的门票。", "symbolSize": 40, "category": "摆钟革命" },
    { "name": "肖特自由摆钟", "des": "1921 年以两个真空中的自由摆隔空对话，机械计时的巅峰，误差每天毫秒级。", "symbolSize": 40, "category": "摆钟革命" },
    { "name": "经度问题", "des": "海上定经度等于知道当地时间：一座不怕风浪的准钟，值两万英镑悬赏。", "symbolSize": 40, "category": "航海钟" },
    { "name": "约翰·哈里森", "des": "木匠出身的英国钟表匠，四十年造五台钟，把经度问题从天文学手里抢了回来。", "symbolSize": 50, "category": "航海钟" },
    { "name": "H1至H3", "des": "三台船舱大小的黄铜怪兽，与海浪搏斗了三十年的笨重尝试。", "symbolSize": 40, "category": "航海钟" },
    { "name": "H4航海钟", "des": "1759 年完成的怀表式大作，1761 年试航牙买加往返误差以秒计。", "symbolSize": 40, "category": "航海钟" },
    { "name": "航海天文钟", "des": "从哈里森孤品到阿诺德与厄恩肖的量产船钟，每条远洋船的标配心跳。", "symbolSize": 40, "category": "航海钟" },
    { "name": "怀表", "des": "从「纽伦堡蛋」到铁路怀表，四个世纪的口袋机器。", "symbolSize": 50, "category": "怀表与大师" },
    { "name": "纽伦堡蛋", "des": "十六世纪初亨利安的便携发条钟，椭圆形的钟表便携化第一步。", "symbolSize": 40, "category": "怀表与大师" },
    { "name": "杠杆擒纵", "des": "马奇 1755 年发明的分离式杠杆擒纵，今天九成机械表仍在用的心脏。", "symbolSize": 40, "category": "怀表与大师" },
    { "name": "宝玑", "des": "阿伯拉罕-路易·宝玑，制表业的达芬奇：陀飞轮、上绕游丝、触觉表不计其数。", "symbolSize": 50, "category": "怀表与大师" },
    { "name": "陀飞轮", "des": "1801 年专利的旋转擒纵框架，把地心引力对手表误差的影响平均掉。", "symbolSize": 40, "category": "怀表与大师" },
    { "name": "瑞士制表", "des": "从加尔文禁止佩戴珠宝后的金匠转行，到日内瓦印记与天文台竞赛的百年体制。", "symbolSize": 50, "category": "怀表与大师" },
    { "name": "汝拉山谷", "des": "积雪半年的人们在窗前车制零件，爱彼与宝珀的寒冬作坊传奇。", "symbolSize": 40, "category": "怀表与大师" },
    { "name": "百达翡丽", "des": "1839 年创立的日内瓦老铺，复杂功能与拍卖纪录的常客。", "symbolSize": 40, "category": "怀表与大师" },
    { "name": "美国怀表工业", "des": "沃瑟姆以可互换零件量产怀表，把瑞士人吓出一身冷汗的流水线。", "symbolSize": 40, "category": "怀表与大师" },
    { "name": "复杂功能", "des": "超出走时之外的一切机械野心：历法、报时与计时的三重奏。", "symbolSize": 40, "category": "复杂功能" },
    { "name": "计时码表", "des": "1821 年里厄塞克为赛马计名次发明的墨滴计时，按下即记录的机械秒表。", "symbolSize": 40, "category": "复杂功能" },
    { "name": "三问报时", "des": "黑暗中按动簧片听音报时的机械奇迹，音锤音簧的微型音乐盒。", "symbolSize": 40, "category": "复杂功能" },
    { "name": "万年历", "des": "自动识别大小月与闰年的机械历法，2100 年才需调一次的傲慢。", "symbolSize": 40, "category": "复杂功能" },
    { "name": "月相显示", "des": "以 29.5 天齿轮周期复刻月亮脸的浪漫冗余。", "symbolSize": 40, "category": "复杂功能" },
    { "name": "腕表", "des": "从贵妇手镯到一战军官标配，二十世纪时间戴上了手腕。", "symbolSize": 50, "category": "腕表时代" },
    { "name": "劳力士蚝式", "des": "1926 年的旋入式防水表壳，次年横渡英吉利海峡的宣传奇袭。", "symbolSize": 40, "category": "腕表时代" },
    { "name": "自动上链", "des": "摆陀把日常晃动攒成发条能量，从宝玑撞陀到哈伍德现代摆陀。", "symbolSize": 40, "category": "腕表时代" },
    { "name": "潜水表", "des": "1953 年五十噚与潜航者定下的旋转表圈单向棘轮，深潜的安全绳。", "symbolSize": 40, "category": "腕表时代" },
    { "name": "天文台认证", "des": "COSC 十六天的五方位三温度测试，-4/+6 秒的及格线。", "symbolSize": 40, "category": "腕表时代" },
    { "name": "石英表", "des": "以晶体振荡分频驱动的电子表，一年误差三十秒的平民革命。", "symbolSize": 50, "category": "石英革命" },
    { "name": "石英晶体振荡", "des": "32768 赫兹的压电音叉，比摆轮快千倍的稳定心跳。", "symbolSize": 40, "category": "石英革命" },
    { "name": "精工Astron", "des": "1969 年 12 月 25 日东京发售的世界首块石英腕表，售价一辆卡罗拉。", "symbolSize": 40, "category": "石英革命" },
    { "name": "石英危机", "des": "瑞士制表业十年间失血三分之二岗位，从九万人的行业到几乎熄灯。", "symbolSize": 40, "category": "石英革命" },
    { "name": "斯沃琪复兴", "des": "1983 年海耶克以塑料石英表把瑞士表从计时工具改写成时尚宣言。", "symbolSize": 40, "category": "石英革命" },
    { "name": "电波授时", "des": "JJY、WWV 与商丘 BPC 的长波授时台，腕表每夜自动对表的隐形基站。", "symbolSize": 40, "category": "石英革命" },
    { "name": "智能手表", "des": "手腕上的计算机接管计时、健康与通知，钟表业的第四次洗牌。", "symbolSize": 40, "category": "石英革命" },
    { "name": "原子钟", "des": "以原子跃迁频率定义时间的新纪元，三亿年不差一秒的守法者。", "symbolSize": 50, "category": "原子与标准时间" },
    { "name": "铯钟与秒定义", "des": "1967 年起，一秒等于铯原子 9192631770 次振荡——时间单位第一次脱离天文。", "symbolSize": 40, "category": "原子与标准时间" },
    { "name": "光钟", "des": "以光学晶格中的锶原子计时，精度迈向宇宙年龄量级。", "symbolSize": 40, "category": "原子与标准时间" },
    { "name": "UTC与闰秒", "des": "原子时与地球自转的折中协议，已决议在 2035 年前告别闰秒。", "symbolSize": 40, "category": "原子与标准时间" },
    { "name": "GPS时间", "des": "三十余颗卫星各自带着原子钟，定位的本质是测时间差。", "symbolSize": 40, "category": "原子与标准时间" },
    { "name": "格林尼治与本初子午线", "des": "1884 年华盛顿会议把零度经线钉在格林尼治，世界从此有了统一的经度与日期变更线。", "symbolSize": 40, "category": "原子与标准时间" },
    { "name": "标准时与铁路", "des": "1883 年美国铁路以五个时区统一地方时，「两个正午日」拨快了整个社会。", "symbolSize": 40, "category": "原子与标准时间" }
  ],
