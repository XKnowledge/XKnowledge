":"微量物证","des":"纤维油漆玻璃土壤，移动即留痕。","symbolSize":40,"category":"毒物与微量物证"},{"name":"物证技术","des":"发现提取比对痕迹与物品的法庭科学技术。","symbolSize":50,"category":"物证技术"},{"name":"生物物证","des":"血痕精斑毛发组织等来自人体的检材。","symbolSize":50,"category":"生物物证"},{"name":"洛克伍德交换原理","des":"犯罪必留痕迹：凡接触必交换。","symbolSize":50,"category":"物证技术"},{"name":"痕迹检验","des":"手印足迹工痕的整体比对体系。","symbolSize":40,"category":"物证技术"},{"name":"足迹分析","des":"步法特征与鞋底花纹的追踪术。","symbolSize":40,"category":"物证技术"},{"name":"工具痕迹","des":"撬棍剪切留下的金属对话。","symbolSize":40,"category":"物证技术"},{"name":"枪弹痕迹","des":"膛线痕与击针痕，枪支的指纹。","symbolSize":40,"category":"物证技术"},{"name":"文件检验","des":"笔迹印章印刷文件的三重鉴定。","symbolSize":40,"category":"物证技术"},{"name":"笔迹鉴定","des":"书写习惯的动力定型。","symbolSize":40,"category":"物证技术"},{"name":"声纹鉴定","des":"语音的频谱身份证。","symbolSize":40,"category":"物证技术"},{"name":"犯罪现场重建","des":"痕迹拼图还原事件序列。","symbolSize":40,"category":"物证技术"},{"name":"洛卡德","des":"里昂犯罪学实验室创始人，物证学先知。","symbolSize":40,"category":"物证技术"},{"name":"血痕检验","des":"预试验确证种属与个体分型。","symbolSize":40,"category":"生物物证"},{"name":"鲁米诺","des":"黑暗中让潜血发出幽光。","symbolSize":40,"category":"生物物证"},{"name":"血型检验","des":"ABO与MN，DNA之前的个体区分。","symbolSize":40,"category":"生物物证"},{"name":"种属鉴定","des":"先辨人畜再谈个体。","symbolSize":40,"category":"生物物证"},{"name":"精斑检验","des":"性侵案件的关键物证。","symbolSize":40,"category":"生物物证"},{"name":"Y-STR","des":"父系追踪，男性混合检体的利器。","symbolSize":40,"category":"生物物证"},{"name":"线粒体DNA","des":"母系标记，毛发烧骨的最后手段。","symbolSize":40,"category":"生物物证"},{"name":"DNA数据库","des":"全国联网的基因档案比对网。","symbolSize":40,"category":"生物物证"},{"name":"亲子鉴定","des":"血缘的概率语言：肯定或排除。","symbolSize":40,"category":"生物物证"},{"name":"白骨案鉴定","des":"无名尸骸的年龄性别身高三要素。","symbolSize":40,"category":"生物物证"},{"name":"法医精神鉴定","des":"责任能力与受审能力的医学裁量。","symbolSize":40,"category":"法庭与伦理"},{"name":"法医临床学","des":"活体损伤与伤残等级评定。","symbolSize":40,"category":"法庭与伦理"},{"name":"伤残等级","des":"事故损伤的量化标尺。","symbolSize":40,"category":"法庭与伦理"},{"name":"证据链","des":"物证从现场到法庭的完整保管链。","symbolSize":40,"category":"法庭与伦理"},{"name":"专家证人","des":"以专业知识辅