{
  "version": 2,
  "title": "照明技术史",
  "description": "从一支火把到一枚二极管：燃料、火焰与光子的万年接力——油灯、蜡烛、煤气灯、白炽灯、荧光灯到 LED，光源的每次换代都重写了夜晚的形状。",
  "nodes": [
    { "name": "照明技术史", "des": "从一支火把到一枚二极管：光源的每次换代，都重写了夜晚的形状。", "symbolSize": 70, "category": "照明技术史" },
    { "name": "火的驯服", "des": "人类第一个光源也是第一个技术：守住火种，就是守住漫长的夜。", "symbolSize": 50, "category": "火的驯服" },
    { "name": "篝火与火塘", "des": "史前聚落围火而眠，火塘是光源、炉灶与祭坛的三合一。", "symbolSize": 40, "category": "火的驯服" },
    { "name": "火把与松明", "des": "树脂枝条绑束成炬，第一件便携光源，洞穴壁画就着它完成。", "symbolSize": 40, "category": "火的驯服" },
    { "name": "燧石与火镰", "des": "击石取火让光摆脱雷击与野火，火种从此可以随身携带。", "symbolSize": 40, "category": "火的驯服" },
    { "name": "火折子", "des": "纸卷浸药加盖焖燃，可以揣进怀里的慢速火种。", "symbolSize": 40, "category": "火的驯服" },
    { "name": "动物油脂灯", "des": "贝壳石槽盛脂置芯，最原始的灯具，油灯一万年的起点。", "symbolSize": 40, "category": "火的驯服" },
    { "name": "油灯时代", "des": "从脂到油的燃料升级，灯芯与灯罩两件小发明撑起千年夜读。", "symbolSize": 50, "category": "油灯时代" },
    { "name": "长信宫灯", "des": "西汉鎏金宫灯，烟气导入袖管水滤其尘，两千年前的环保设计。", "symbolSize": 40, "category": "油灯时代" },
    { "name": "鲸油灯", "des": "十九世纪捕鲸业撑起欧美灯盏，鲸脑油的洁净火焰照亮书房。", "symbolSize": 40, "category": "油灯时代" },
    { "name": "煤油灯", "des": "石油分馏便宜亮堂，德雷克油井之后千家万户的光。", "symbolSize": 40, "category": "油灯时代" },
    { "name": "阿拉丁汽灯", "des": "煤油加压汽化喷烧纱罩，亮逾白炽，乡野之夜的小太阳。", "symbolSize": 40, "category": "油灯时代" },
    { "name": "灯芯与灯罩", "des": "平芯圆芯控火焰，玻璃罩防风聚亮，油灯的两次微革命。", "symbolSize": 40, "category": "油灯时代" },
    { "name": "提灯与马灯", "des": "折叠风罩与提梁，风雨夜可携的光源，马车与铁路的标配。", "symbolSize": 40, "category": "油灯时代" },
    { "name": "青灯与书斋", "des": "囊萤映雪与青灯古卷，一盏油灯撑起的千年夜读史。", "symbolSize": 40, "category": "油灯时代" },
    { "name": "蜡烛谱系", "des": "火焰装进可搬运的柱体：一部燃料提纯史，也是教堂与家宅的光。", "symbolSize": 50, "category": "蜡烛谱系" },
    { "name": "牛脂烛", "des": "牛羊油脂浇模而成，便宜多烟，中世纪家户的日常光。", "symbolSize": 40, "category": "蜡烛谱系" },
    { "name": "蜂蜡烛", "des": "蜂巢蜡洁净无烟，弥撒圣坛的专供，按重量计价的奢侈品。", "symbolSize": 40, "category": "蜡烛谱系" },
    { "name": "鲸蜡烛", "des": "抹香鲸脑油凝固成烛，火焰挺立不淌泪，烛中贵族。", "symbolSize": 40, "category": "蜡烛谱系" },
    { "name": "硬脂酸烛", "des": "十九世纪化学分提硬脂，坚硬白净，蜡烛的平民化拐点。", "symbolSize": 40, "category": "蜡烛谱系" },
    { "name": "烛剪与灭烛罩", "des": "剪焦芯防淌泪，罩灭防烟，蜡烛时代的日用小工具。", "symbolSize": 40, "category": "蜡烛谱系" },
    { "name": "烛光单位", "des": "一支标准蜡烛的亮度，成了后世光照计量的原点。", "symbolSize": 40, "category": "蜡烛谱系" },
    { "name": "蜡烛与时辰", "des": "刻度蜡烛燃尽即知时，暗夜里的钟表替身。", "symbolSize": 40, "category": "蜡烛谱系" },
    { "name": "煤气灯时代", "des": "煤第一次变成管道里的光：城市夜间经济的第一次爆发。", "symbolSize": 50, "category": "煤气灯时代" },
    { "name": "煤气厂与干馏", "des": "城市煤气厂蒸馏煤产气，管网把光送进街灯与客厅。", "symbolSize": 40, "category": "煤气灯时代" },
    { "name": "煤气街灯", "des": "一八〇七年伦敦帕尔摩街首亮，黄昏后商店第一次开门营业。", "symbolSize": 40, "category": "煤气灯时代" },
    { "name": "韦尔斯巴赫白炽罩", "des": "钍铈纱罩遇火炽亮，煤气灯亮度跃升数倍，续命二十年。", "symbolSize": 40, "category": "煤气灯时代" },
    { "name": "点灯人", "des": "执长杆逐盏点灯熄灯，街灯时代独有的职业剪影。", "symbolSize": 40, "category": "煤气灯时代" },
    { "name": "煤气表的争议", "des": "计费方便与爆炸隐患并存，煤气既是便利也是城市之险。", "symbolSize": 40, "category": "煤气灯时代" },
    { "name": "电弧与放电", "des": "电池堆点出第一道电光：太亮太贵，却叩开电照明之门。", "symbolSize": 50, "category": "电弧与放电" },
    { "name": "戴维碳弧", "des": "伏打电堆拉出碳极电弧，实验室里的小太阳。", "symbolSize": 40, "category": "电弧与放电" },
    { "name": "电烛", "des": "雅布洛奇科夫并排碳棒放电，一八七六年巴黎大道的首代电路灯。", "symbolSize": 40, "category": "电弧与放电" },
    { "name": "弧光街灯与灯塔", "des": "电厂带动之下，码头广场与灯塔换上刺眼的白光。", "symbolSize": 40, "category": "电弧与放电" },
    { "name": "探照灯", "des": "抛物面反射镜聚起弧光，要塞与军舰的夜之利器。", "symbolSize": 40, "category": "电弧与放电" },
    { "name": "盖斯勒管", "des": "低压气体放电发光的玻璃管，霓虹与荧光灯的胚胎。", "symbolSize": 40, "category": "电弧与放电" },
    { "name": "白炽灯", "des": "电阻烧到白热的细丝：爱迪生与斯旺把电变成商品光源。", "symbolSize": 50, "category": "白炽灯" },
    { "name": "斯旺碳丝灯", "des": "英国先行的碳化棉丝，一八七九年纽卡斯尔的最早亮光。", "symbolSize": 40, "category": "白炽灯" },
    { "name": "爱迪生与门洛帕克", "des": "系统化试验数千种灯丝，卖的不是一个灯泡而是整套电网。", "symbolSize": 40, "category": "白炽灯" },
    { "name": "碳化竹丝", "des": "日本竹丝碳化后寿命破千小时，白炽灯商业化的临门一脚。", "symbolSize": 40, "category": "白炽灯" },
    { "name": "库利奇钨丝", "des": "一九〇八年拉延韧性钨丝，更亮更耐，白炽灯定型百年。", "symbolSize": 40, "category": "白炽灯" },
    { "name": "充气与朗缪尔", "des": "惰性气体填充抑制钨蒸发，灯丝再提亮度与寿命。", "symbolSize": 40, "category": "白炽灯" },
    { "name": "卤钨循环", "des": "碘钨循环把蒸发的钨送回灯丝，一九五五年后的强光光源。", "symbolSize": 40, "category": "白炽灯" },
    { "name": "E27螺口", "des": "爱迪生螺口成为全球标准，一只灯座通用百年不废。", "symbolSize": 40, "category": "白炽灯" },
    { "name": "灯泡阴谋", "des": "一九二四年福玻斯卡特尔把灯泡寿命钉死在一千小时。", "symbolSize": 40, "category": "白炽灯" },
    { "name": "荧光与放电灯", "des": "不靠灯丝靠气体：紫外激发荧光粉，节能时代的第一棒。", "symbolSize": 50, "category": "荧光与放电灯" },
    { "name": "霓虹灯", "des": "克劳德充氖弯管成字，一九一〇年巴黎的电子夜色。", "symbolSize": 40, "category": "荧光与放电灯" },
    { "name": "荧光灯管", "des": "一九三八年通用电气量产，紫外线激发荧光粉的办公室白光。", "symbolSize": 40, "category": "荧光与放电灯" },
    { "name": "镇流器", "des": "气体放电的电流闸门，启辉闪跳是几代人的记忆。", "symbolSize": 40, "category": "荧光与放电灯" },
    { "name": "高压汞灯", "des": "蓝白光的大功率放电灯，厂房与广场的老担当。", "symbolSize": 40, "category": "荧光与放电灯" },
    { "name": "低压钠灯", "des": "单色黄光最省电也最透雾，公路与港口的老配置。", "symbolSize": 40, "category": "荧光与放电灯" },
    { "name": "高压钠灯", "des": "橙黄光高效省电，二十世纪城市夜空的主色调。", "symbolSize": 40, "category": "荧光与放电灯" },
    { "name": "CFL节能灯", "des": "荧光管弯成螺旋塞进螺口，白炽与 LED 之间的过渡方案。", "symbolSize": 40, "category": "荧光与放电灯" },
    { "name": "LED革命", "des": "半导体结区直接发光：不发热的光，照明史的现在进行时。", "symbolSize": 50, "category": "LED革命" },
    { "name": "发光二极管", "des": "电子与空穴复合放出光子，电光转换的物理新路径。", "symbolSize": 40, "category": "LED革命" },
    { "name": "红光LED", "des": "霍洛尼亚克一九六二年做出首颗可见光 LED，起初只配指示灯。", "symbolSize": 40, "category": "LED革命" },
    { "name": "蓝光LED", "des": "赤崎勇、天野浩、中村修二突破氮化镓，二〇一四年诺贝尔奖。", "symbolSize": 40, "category": "LED革命" },
    { "name": "白光LED与荧光粉", "des": "蓝光芯片打在 YAG 荧光粉上，白光照明的最后一公里。", "symbolSize": 40, "category": "LED革命" },
    { "name": "LED球泡与灯丝灯", "des": "把 LED 阵列装回灯泡的形状，替换式照明的形态归一。", "symbolSize": 40, "category": "LED革命" },
    { "name": "大功率封装与散热", "des": "流明密度与散热的军备赛，照明级 LED 的工程核心。", "symbolSize": 40, "category": "LED革命" },
    { "name": "OLED", "des": "有机薄膜面发光，可弯可折，光与屏幕的合流。", "symbolSize": 40, "category": "LED革命" },
    { "name": "智能照明", "des": "调光调色接入网络，光变成可编程的环境参数。", "symbolSize": 40, "category": "LED革命" },
    { "name": "光与社会", "des": "光源换代从不只关亮度：它改写作息、街道、生意与星空。", "symbolSize": 50, "category": "光与社会" },
    { "name": "流明与勒克斯", "des": "光通量与照度把亮度变成数字，选购灯泡的新语言。", "symbolSize": 40, "category": "光与社会" },
    { "name": "色温", "des": "从暖白到冷白的刻度，光的表情被量化成开尔文。", "symbolSize": 40, "category": "光与社会" },
    { "name": "显色指数", "des": "还原物体真色的能力，菜场与画室最在乎的指标。", "symbolSize": 40, "category": "光与社会" },
    { "name": "城市之夜", "des": "街灯延长营业与治安，夜班夜校与夜生活的地基。", "symbolSize": 40, "category": "光与社会" },
    { "name": "光污染", "des": "过量的灯光熄灭星空，暗夜保护区成为新诉求。", "symbolSize": 40, "category": "光与社会" },
    { "name": "火灾与灯火", "des": "灯烛之火曾是城市大患，消防史与照明史互相纠缠。", "symbolSize": 40, "category": "光与社会" },
    { "name": "灯节", "des": "上元灯会与圣诞灯串，火的技术变成节庆的语言。", "symbolSize": 40, "category": "光与社会" },
    { "name": "钨丝灯退市", "des": "各国禁售时间表相继落地，百年灯丝灯光谢幕。", "symbolSize": 40, "category": "光与社会" }
  ],
