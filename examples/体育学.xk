{"version":2,"nodes":[{"name":"体育学","des":"研究身体运动促进人的全面发展之规律的学科群，人体科学、训练学与人文社会学三足鼎立。","symbolSize":70,"category":"体育史"},{"name":"古希腊奥林匹克","des":"公元前776年至393年奥林匹亚四年一度的祭神竞技会，赤身参赛、神圣休战，现代奥运的直系祖先。","symbolSize":50,"category":"体育史"},{"name":"马拉松起源","des":"传令兵斐迪庇第斯自马拉松战场跑回雅典报捷后力竭的传说，42.195公里的赛程1908年才定长。","symbolSize":40,"category":"体育史"},{"name":"顾拜旦","des":"法国教育改革家，1894年巴黎大会倡议复兴奥运会并创建国际奥委会，尊为现代奥林匹克之父。","symbolSize":50,"category":"体育史"},{"name":"体育颂","des":"顾拜旦1912年以笔名发表的散文诗，礼赞体育是美丽、正义、勇气与乐趣的化身。","symbolSize":40,"category":"体育史"},{"name":"国际奥委会","des":"1894年成立的体育组织，以个人委员制而非政府代表运作，拥有奥运会的全部产权。","symbolSize":40,"category":"体育史"},{"name":"现代奥林匹克运动","des":"1896年雅典起步的全球运动体系，四年一届的奥运会已是世界上规模最大的文化体育事件。","symbolSize":50,"category":"体育史"},{"name":"英国公学竞技","des":"十九世纪英国公学把竞技视作品格教育的课堂，费厄泼赖精神为顾拜旦的奥林匹克构想供料。","symbolSize":40,"category":"体育史"},{"name":"德国体操","des":"十九世纪杨氏与施皮斯建立的器械体操体系，承载强国强种诉求，随兵操教材输出世界。","symbolSize":40,"category":"体育史"},{"name":"冬季奥运会","des":"1924年夏蒙尼首届，滑冰滑雪项目的最高竞技场，与夏奥同属一家而错峰四年。","symbolSize":40,"category":"体育史"},{"name":"残奥会","des":"1960年罗马首届，由二战伤残军人的康复比赛发展而来，与奥运同城接续举行。","symbolSize":40,"category":"体育史"},{"name":"养生导引","des":"中国本土的身体修炼传统：肢体屈伸配合呼吸吐纳，重养护而非竞胜，与西方体育殊途。","symbolSize":50,"category":"中国体育"},{"name":"五禽戏","des":"东汉华佗仿虎鹿熊猿鸟五种动物姿态编成的医疗体操，事见《后汉书·方术传》。","symbolSize":40,"category":"中国体育"},{"name":"八段锦","des":"八节成套的导引功法，南宋典籍已见著录，口诀相传至今仍是晨练场上的主力。","symbolSize":40,"category":"中国体育"},{"name":"易筋经","des":"明末面世而托名达摩的筋膜锻炼功法，内壮外强，后世武侠小说不断加码。","symbolSize":40,"category":"中国体育"},{"name":"太极拳","des":"以柔克刚、借力打力的内家拳，2020年列入联合国人类非物质文化遗产名录。","symbolSize":40,"category":"中国体育"},{"name":"武术","des":"中国传统技击术的总汇，套路与散打两大体系、拳种逾百，体育与武学的合体。","symbolSize":50,"category":"中国体育"},{"name":"蹴鞠","des":"战国齐地已兴、宋代臻于鼎盛的古代足球，国际足联2004年认定足球运动源于此。","symbolSize":40,"category":"中国体育"},{"name":"洋务运动与近代体育","des":"晚清新军编练与北洋水师学堂引入德式兵操，西方体育随坚船利炮东渐中国。","symbolSize":40,"category":"中国体育"},{"name":"刘长春","des":"1932年只身赴洛杉矶，中国第一位奥运选手，海上漂泊二十余天仍站上百米跑道。","symbolSize":40,"category":"中国体育"},{"name":"新中国体育","des":"从发展体育运动、增强人民体质到竞技争光与全民健身并举的国家体育事业。","symbolSize":50,"category":"中国体育"},{"name":"举国体制","des":"集中财政与人才资源培养竞技精英的中国模式，从少体校到国家队的层层输送链。","symbolSize":40,"category":"中国体育"},{"name":"乒乓外交","des":"1971年名古屋世乒赛期间中美球员互动，小球转动大球，为尼克松访华铺路。","symbolSize":40,"category":"中国体育"},{"name":"女排精神","des":"中国女排1981年首夺世界冠军并成就五连冠，顽强拼搏、为国争光的时代强音。","symbolSize":40,"category":"中国体育"},{"name":"许海峰","des":"1984年洛杉矶奥运会男子手枪慢射冠军，中国奥运金牌零的突破。","symbolSize":40,"category":"中国体育"},{"name":"姚明","des":"2002年以选秀状元身份登陆NBA的中国中锋，中国体育全球化最著名的名片。","symbolSize":40,"category":"中国体育"},{"name":"北京双奥","des":"2008年夏奥会与2022年冬奥会，北京成为全球首座先后承办两季奥运会的城市。","symbolSize":40,"category":"中国体育"},{"name":"运动解剖学","des":"研究运动对人体形态结构影响的学科，肌肉骨骼的杠杆系统是一切动作分析的底图。","symbolSize":40,"category":"运动人体科学"},{"name":"运动生理学","des":"研究急性运动的即时反应与长期训练的适应规律，运动人体科学诸学科的枢纽。","symbolSize":50,"category":"运动人体科学"},{"name":"三大供能系统","des":"磷酸原、糖酵解与有氧氧化三套产能途径，任何项目的能量账都由它们分摊。","symbolSize":50,"category":"运动人体科学"},{"name":"磷酸原系统","des":"ATP与磷酸肌酸直接供能，支撑十秒以内的极限输出，短跑与跳跃的引擎。","symbolSize":40,"category":"运动人体科学"},{"name":"糖酵解系统","des":"糖原无氧分解快速供能，可支撑约两分钟的高强度运动，副产品是乳酸。","symbolSize":40,"category":"运动人体科学"},{"name":"有氧氧化系统","des":"糖与脂肪在线粒体中持续氧化供能，马拉松式的持久动力，离不开氧气供应。","symbolSize":40,"category":"运动人体科学"},{"name":"超量恢复","des":"适度消耗后机体恢复超过原有水平的适应现象，训练与休息交替安排的生理依据。","symbolSize":40,"category":"运动人体科学"},{"name":"最大摄氧量","des":"每分钟每公斤体重利用氧的毫升数上限，心肺机能与耐力天赋的硬指标。","symbolSize":40,"category":"运动人体科学"},{"name":"乳酸阈","des":"血乳酸急剧攀升的转折点，直接换算为可持续的最快配速，耐力训练的分界线。","symbolSize":40,"category":"运动人体科学"},{"name":"运动员心脏","des":"长期耐力训练使心腔扩大、心壁增厚、安静心率下降的生理性重塑。","symbolSize":40,"category":"运动人体科学"},{"name":"肌纤维类型","des":"慢肌耐力好、快肌爆发强，比例主要由遗传写定，选材时先看这张底牌。","symbolSize":40,"category":"运动人体科学"},{"name":"运动生物力学","des":"以力学定律解析运动技术与人器关系的学科，动作优化与器材设计的算尺。","symbolSize":40,"category":"运动人体科学"},{"name":"运动心理学","des":"研究运动情境中的动机、情绪与认知，临场发挥的一半是心理。","symbolSize":40,"category":"运动人体科学"},{"name":"倒U假说","des":"唤醒水平与运动表现呈倒U形关系：太低迟钝、太高慌乱，适度才出状态。","symbolSize":40,"category":"运动人体科学"},{"name":"心理技能训练","des":"目标设置、表象演练与注意调控的系统训练，把唤醒调到倒U曲线的顶点。","symbolSize":40,"category":"运动人体科学"},{"name":"运动营养学","des":"研究运动员膳食结构与补剂配比的学科，训练之外的另一张训练表。","symbolSize":40,"category":"运动人体科学"},{"name":"运动处方","des":"按运动种类、强度、时间与频率开出的健康剂量单，科学健身的核心文件。","symbolSize":40,"category":"运动人体科学"},{"name":"运动训练学","des":"研究训练规律、原则与方法的学科，竞技场上教练员的指挥学。","symbolSize":50,"category":"运动训练学"},{"name":"马特维耶夫周期理论","des":"苏联学者1965年系统化的训练分期学说：全年分准备、竞赛与过渡期，负荷波浪消长。","symbolSize":50,"category":"运动训练学"},{"name":"板块训练","des":"当代对传统周期理论的修正：高度集中的负荷分板块依次叠加，适应密集赛程。","symbolSize":40,"category":"运动训练学"},{"name":"运动负荷","des":"负荷量与负荷强度的组合，训练刺激的剂量单位，过大过小皆非所宜。","symbolSize":40,"category":"运动训练学"},{"name":"体能训练","des":"力量、速度、耐力、柔韧与灵敏的总装工程，现代竞技的地基。","symbolSize":40,"category":"运动训练学"},{"name":"力量素质","des":"神经募集能力与肌肉横截面的乘积，五大身体素质之首。","symbolSize":40,"category":"运动训练学"},{"name":"速度素质","des":"反应、动作与位移速度的三合一，短跑与球类项目的第一道门槛。","symbolSize":40,"category":"运动训练学"},{"name":"耐力素质","des":"有氧与无氧耐力的续航能力，对抗疲劳、推迟疲劳的本钱。","symbolSize":40,"category":"运动训练学"},{"name":"柔韧素质","des":"关节活动幅度与肌肉延展性，动作幅度与损伤防线的双重保障。","symbolSize":40,"category":"运动训练学"},{"name":"灵敏素质","des":"急停、变向与随机应变的综合能力，球类与格斗场的看家本领。","symbolSize":40,"category":"运动训练学"},{"name":"间歇训练","des":"高强度运动与间歇休息交替的安排，一次课同时打磨有氧与无氧两套系统。","symbolSize":40,"category":"运动训练学"},{"name":"高原训练","des":"利用低氧环境刺激红细胞增生，下山后携氧能力短期占优的耐力项目老办法。","symbolSize":40,"category":"运动训练学"},{"name":"技术训练","des":"千锤百炼把动作模式推向自动化，经济、稳定而不假思索。","symbolSize":40,"category":"运动训练学"},{"name":"战术训练","des":"依对手与赛局调配技术、体力与心理的临场艺术，赛前反复的沙盘推演。","symbolSize":40,"category":"运动训练学"},{"name":"运动选材","des":"以形态、机能、心理与遗传指标甄别竞技苗子，科学的选材少走十年弯路。","symbolSize":40,"category":"运动训练学"},{"name":"田径","des":"运动之母：径赛竞速、田赛比远，跑跳投掷是最古老也最基础的竞技形态。","symbolSize":50,"category":"运动项目"},{"name":"径赛","des":"以时间计胜负的跑与竞走，从百米飞人大战到马拉松大军。","symbolSize":40,"category":"运动项目"},{"name":"田赛","des":"以远度和高度计胜负的跳与投，跳高跳远、铅球标枪各占其场。","symbolSize":40,"category":"运动项目"},{"name":"体操","des":"从德式体操演化而来的力与美：难度分与完成分相加的器械竞技。","symbolSize":40,"category":"运动项目"},{"name":"足球","des":"二十二人与一粒皮的攻防战争，1863年英格兰定下现代规则，世界第一运动。","symbolSize":40,"category":"运动项目"},{"name":"篮球","des":"1891年奈史密斯为冬日室内课所创，从桃筐与十三条规则长成全球性运动。","symbolSize":40,"category":"运动项目"},{"name":"排球","des":"1895年摩根所创的网前集体攻防，每球得分制下快节奏的六人战场。","symbolSize":40,"category":"运动项目"},{"name":"乒乓球","des":"源于英国的桌上网球，容国团1959年首夺世界冠军后在中国成为国球。","symbolSize":40,"category":"运动项目"},{"name":"羽毛球","des":"由印度浦那的游戏定型于英国，球速可达每小时四百公里的最快拍类运动。","symbolSize":40,"category":"运动项目"},{"name":"网球","des":"1877年温布尔登开赛，四大满贯支撑的职业网球金字塔最古老的一层。","symbolSize":40,"category":"运动项目"},{"name":"游泳","des":"从生存技能到四种泳姿的竞速，水的浮力让它成为对关节最友好的全身运动。","symbolSize":40,"category":"运动项目"},{"name":"拳击","des":"古代奥运已有此项，1867年昆斯伯里规则引入手套与回合制，人称甜蜜的科学。","symbolSize":40,"category":"运动项目"},{"name":"摔跤","des":"最古老的竞技之一、古代奥运的核心项目，古典式与自由式各自角力。","symbolSize":40,"category":"运动项目"},{"name":"柔道","des":"嘉纳治五郎1882年创于讲道馆，讲精力善用、以柔克刚，1964年入奥。","symbolSize":40,"category":"运动项目"},{"name":"跆拳道","des":"朝鲜半岛武艺现代化的产物，以腿法为主的对抗，2000年成为奥运正式项目。","symbolSize":40,"category":"运动项目"},{"name":"射击","des":"从狩猎与军用射击演化而来的精准对决，历届奥运首金的传统出处。","symbolSize":40,"category":"运动项目"},{"name":"冰雪运动","des":"滑冰与滑雪的大家族，从北欧生存技能长成冬奥赛场的争金产业。","symbolSize":40,"category":"运动项目"},{"name":"电子竞技","des":"反应、协作与战术的数字竞技，从网吧时代一路走进亚运正式项目。","symbolSize":40,"category":"运动项目"},{"name":"奥林匹克主义","des":"奥林匹克宪章开宗明义：以竞技运动服务人的和谐发展，重在参与的生活哲学。","symbolSize":50,"category":"体育与社会"},{"name":"奥林匹克格言","des":"更快、更高、更强——更团结，后半句2021年方才补入。","symbolSize":40,"category":"体育与社会"},{"name":"竞技体育","des":"以夺取优胜为目标的精英体育，训练学的服务对象，国家与社会的成绩单。","symbolSize":50,"category":"体育与社会"},{"name":"兴奋剂","des":"以药物强行提高成绩的作弊手段，透支健康、亵渎公平的竞技暗面。","symbolSize":40,"category":"体育与社会"},{"name":"世界反兴奋剂机构","des":"1999年成立的国际组织，统一禁用清单、检测技术与处罚标准。","symbolSize":40,"category":"体育与社会"},{"name":"职业体育","des":"以联赛与市场造血的竞技组织形态，NBA与欧洲足球联赛为典型。","symbolSize":40,"category":"体育与社会"},{"name":"体育产业","des":"赛事运营、用品制造、传媒版权与健身服务合成的万亿级市场。","symbolSize":40,"category":"体育与社会"},{"name":"全民健身","des":"面向所有人的体育权利，自1995年全民健身计划纲要起上升为国家战略。","symbolSize":40,"category":"体育与社会"},{"name":"学校体育","des":"体育课程与健康教育的制度安排，文明其精神、野蛮其体魄的百年功课。","symbolSize":40,"category":"体育与社会"},{"name":"运动康复","des":"从RICE急救原则到术后功能训练，助运动员与常人重返赛场与生活。","symbolSize":40,"category":"体育与社会"},{"name":"体育社会学","des":"用社会学之眼审视体育：阶级、性别、族群与国家如何在赛场上投影。","symbolSize":40,"category":"体育与社会"}],"links":[{"source":"古希腊奥林匹克","target":"体育学","name":"渊源","des":"千年祭典竞技为这门学科备下项目、仪式与精神原型。"},{"source":"现代奥林匹克运动","target":"古希腊奥林匹克","name":"复兴","des":"1896年首届奥运回到雅典，接续中断千余年的竞技传统。"},{"source":"顾拜旦","target":"现代奥林匹克运动","name":"奠基","des":"1894年倡议复兴奥运，两年后雅典如期开幕。"},{"source":"顾拜旦","target":"国际奥委会","name":"缔造","des":"1894年巴黎大会立起委员制组织，执掌奥运至今。"},{"source":"顾拜旦","target":"体育颂","name":"写就","des":"1912年以笔名发表的散文诗，礼赞体育之美。"},{"source":"体育颂","target":"奥林匹克主义","name":"抒写","des":"用诗行演绎体育是身心和谐的教育力量。"},{"source":"国际奥委会","target":"现代奥林匹克运动","name":"主持","des":"拥有奥运产权并遴选主办城市的最高机构。"},{"source":"马拉松起源","target":"现代奥林匹克运动","name":"催生","des":"首届现代奥运特设马拉松赛，纪念报捷的传令兵。"},{"source":"马拉松起源","target":"古希腊奥林匹克","name":"附丽","des":"希波战争的传奇借奥运记忆流传至今。"},{"source":"马拉松起源","target":"田径","name":"归入","des":"42.195公里的公路竞速是田径家族的极限一端。"},{"source":"英国公学竞技","target":"顾拜旦","name":"启发","des":"公学的竞技教育让他看到体育塑造人格的可能。"},{"source":"德国体操","target":"体操","name":"孕育","des":"杨氏与施皮斯的器械体系是竞技体操的直系祖先。"},{"source":"德国体操","target":"洋务运动与近代体育","name":"东渐","des":"晚清新军与水师学堂的兵操多取德式教材。"},{"source":"冬季奥运会","target":"现代奥林匹克运动","name":"扩展","des":"1924年夏蒙尼首届，冰雪有了自己的奥运。"},{"source":"残奥会","target":"现代奥林匹克运动","name":"并行","des":"1960年起与奥运同城接续的残健融合盛会。"},{"source":"残奥会","target":"北京双奥","name":"相伴","des":"北京先后承办了夏残奥与冬残奥。"},{"source":"养生导引","target":"体育学","name":"汇入","des":"重吐纳养护而非竞胜的身体文化，是体育的另一源头。"},{"source":"五禽戏","target":"养生导引","name":"派生","des":"华佗仿五兽姿态编成最早的医疗体操。"},{"source":"八段锦","target":"养生导引","name":"派生","des":"八节动作配以口诀，南宋典籍已见著录。"},{"source":"易筋经","target":"养生导引","name":"派生","des":"托名达摩的筋膜功法，明清武林内外兼修。"},{"source":"太极拳","target":"武术","name":"拳种","des":"以柔克刚的内家代表，2020年列入人类非遗。"},{"source":"太极拳","target":"养生导引","name":"取法","des":"拳架以导引吐纳为底色。"},{"source":"武术","target":"体育学","name":"东方一脉","des":"技击套路与武学哲理并存的东方身体文化。"},