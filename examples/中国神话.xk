{
  "version": 2,
  "title": "中国神话",
  "description": "从盘古开辟到西游取经，上古神祇、山海异兽、昆仑仙话、封神谱系与幽冥民俗的源流之网。",
  "nodes": [
    { "name": "中国神话", "des": "自开天辟地至封神西游，神祇、异兽与英雄在此交织成网，一张文明童年时代的想象力地图。", "symbolSize": 70, "category": "创世与三皇五帝" },
    { "name": "盘古", "des": "沉睡于混沌巨卵一万八千年，醒来以斧开天，身化山川日月，是创世叙事的第一声惊雷。", "symbolSize": 60, "category": "创世与三皇五帝" },
    { "name": "女娲", "des": "人首蛇身的创世母神，抟土造人、炼石补天，婚姻制度的开端也归于她的名字。", "symbolSize": 60, "category": "创世与三皇五帝" },
    { "name": "伏羲", "des": "人文始祖，仰观天象俯察地理而画八卦，结网罟、定嫁娶，与女娲并称的人类启蒙者。", "symbolSize": 50, "category": "创世与三皇五帝" },
    { "name": "祝融", "des": "南方火神，兽身人面乘双龙，火之文明的化身，与水神的争斗改变了天地的形状。", "symbolSize": 40, "category": "创世与三皇五帝" },
    { "name": "共工", "des": "人面蛇身朱发的北方水神，怒触天柱的失败者，洪水由此漫下人间，治水叙事自他开启。", "symbolSize": 40, "category": "创世与三皇五帝" },
    { "name": "不周山", "des": "撑天的西北巨柱，被战败的共工一头撞断，天倾西北、地陷东南，从此江河东流。", "symbolSize": 40, "category": "创世与三皇五帝" },
    { "name": "黄帝", "des": "轩辕氏，五帝之首，定衣冠、造舟车、命仓颉造字，涿鹿一战定鼎华夏的人文共祖。", "symbolSize": 60, "category": "创世与三皇五帝" },
    { "name": "炎帝", "des": "神农氏，尝百草、教稼穑的农神与医药之祖，与黄帝合祀为「炎黄」共同的血脉源头。", "symbolSize": 50, "category": "创世与三皇五帝" },
    { "name": "蚩尤", "des": "铜头铁额、兴云作雾的九黎之君，与黄帝争锋于涿鹿，虽败犹被奉为战神祭祀。", "symbolSize": 50, "category": "创世与三皇五帝" },
    { "name": "颛顼", "des": "黄帝之孙、五帝之一，命重黎绝地天通，天地自此相隔，神人各归其位。", "symbolSize": 40, "category": "创世与三皇五帝" },
    { "name": "尧", "des": "帝尧陶唐氏，设谏鼓、定历法，禅位于舜而不传丹朱，德政的开端与让贤的典范。", "symbolSize": 40, "category": "创世与三皇五帝" },
    { "name": "舜", "des": "出身寒微的孝子，耕历山、渔雷泽而天下归心，受尧禅让，又流四凶、禅位于禹。", "symbolSize": 40, "category": "创世与三皇五帝" },
    { "name": "鲧", "des": "窃息壤以堙洪水的天神，九年功败垂成，殛于羽郊，腹中生禹，留下治水的遗志。", "symbolSize": 40, "category": "创世与三皇五帝" },
    { "name": "禹", "des": "大禹，三过家门而不入，疏川导滞终平水患，划九州、铸九鼎，夏朝的奠基者。", "symbolSize": 50, "category": "创世与三皇五帝" },
    { "name": "大禹治水", "des": "以疏代堵的十三年功业，应龙画地、神龟负泥，华夏先民与洪水订下的和约。", "symbolSize": 40, "category": "创世与三皇五帝" },
    { "name": "烛龙", "des": "钟山之神烛九阴，人面蛇身而赤，睁眼为昼、闭眼为夜，呼吸之间四季流转。", "symbolSize": 50, "category": "山海经异兽" },
    { "name": "应龙", "des": "生有双翼的黄龙，蓄水助黄帝诛蚩尤，又以尾画地成江导禹治水，战功最著的神兽。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "九尾狐", "des": "青丘之山食人的灵狐，又是涂山氏的祥瑞，后世化作文人笔下的倾城妖姬。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "饕餮", "des": "羊身人面、目在腋下的贪食凶兽，青铜器上狞厉的兽面，饕餮之名的来历。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "穷奇", "des": "有翼的虎形凶兽，闻人争斗便吃掉有理的一方，奖恶惩善的荒诞化身。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "梼杌", "des": "傲狠明目的西方凶兽，顽劣不可教训，后世以之名记凶人，为四凶之一。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "混沌", "des": "状如黄囊、六足四翼的无面目神兽，识歌舞却好善恶，浑敦无窍的凶顽之名。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "毕方", "des": "独脚的青色火鸟，白喙赤纹，现于何处何处便有怪火，火灾的先兆之鸟。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "白泽", "des": "通晓天下万物之情的祥瑞神兽，向黄帝陈述一万一千五百二十种精怪，成《白泽图》。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "相柳", "des": "共工之臣，九首蛇身，食于九山，所过之处尽成毒泽，大禹所诛的最恶之妖。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "精卫", "des": "炎帝幼女溺于东海所化的花脑袋白喙小鸟，日日衔西山木石填海，志鸟之名由此而来。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "夸父", "des": "追赶太阳的巨人，道渴而死，弃杖化为邓林桃林，不自量力或至死不渝的两面传说。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "刑天", "des": "与帝争神被断首的战神，以乳为目、以脐为口，操干戚而舞，不屈精神的图腾。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "金乌", "des": "居于扶桑的三足神鸟，太阳的化身，十日并出之时，大地几被烤焦。", "symbolSize": 40, "category": "山海经异兽" },
    { "name": "西王母", "des": "掌管灾疫刑罚与不死药的昆仑女主，虎齿豹尾的原始形象渐化为雍容天后，瑶池的主人。", "symbolSize": 50, "category": "昆仑仙话" },
    { "name": "瑶池", "des": "昆仑之巅的圣池，蟠桃盛会的所在，周穆王曾在此与西王母宴饮唱和。", "symbolSize": 40, "category": "昆仑仙话" },
    { "name": "蟠桃", "des": "三千年一熟的仙桃，食之长生不老，瑶池盛宴的珍馐，也是大闹天宫的引线。", "symbolSize": 40, "category": "昆仑仙话" },
    { "name": "后羿", "des": "弯弓射落九日的射神，为民除害的英雄，却留不住妻子奔月的背影。", "symbolSize": 50, "category": "昆仑仙话" },
    { "name": "嫦娥", "des": "窃食不死药而奔月的月宫仙子，碧海青天夜夜心的孤寂，成了中秋的底色。", "symbolSize": 50, "category": "昆仑仙话" },
    { "name": "月宫", "des": "广寒清虚之府，桂影婆娑的清冷宫阙，奔月故事的终点与仰望的起点。", "symbolSize": 40, "category": "昆仑仙话" },
    { "name": "玉兔", "des": "月宫中捣制仙药的白兔，望月的孩童最先认出的居民，嫦娥最初的陪伴。", "symbolSize": 40, "category": "昆仑仙话" },
    { "name": "吴刚", "des": "学仙有过被谪的樵夫，月宫伐桂，树创随合，永无止境的劳作。", "symbolSize": 40, "category": "昆仑仙话" },
    { "name": "不死药", "des": "西王母所掌的不死良药，一粒足够飞升，后羿求得而嫦娥独食。", "symbolSize": 40, "category": "昆仑仙话" },
    { "name": "射日", "des": "十日并出、草木焦枯之时，神箭手弯弓落其九，留其一照人间。", "symbolSize": 40, "category": "昆仑仙话" },
    { "name": "穆天子", "des": "驾八骏西巡的周穆王，万里赴昆仑会西王母于瑶池，留下互酬的歌声与再会之约。", "symbolSize": 40, "category": "昆仑仙话" },
    { "name": "八骏", "des": "穆王的八匹神驹，日行三万里，绝地、翻羽、奔霄，每一匹都有超越凡马的名字。", "symbolSize": 40, "category": "昆仑仙话" },
    { "name": "姜子牙", "des": "渭水垂钓直钩钓来文王的军师，执掌封神榜的神仙领袖，大器晚成的极致。", "symbolSize": 60, "category": "封神谱系" },
    { "name": "哪吒", "des": "灵珠子转世的少年英雄，闹海屠龙、莲花重生，脚踏风火轮的永远的七岁。", "symbolSize": 50, "category": "封神谱系" },
    { "name": "杨戬", "des": "额生天眼的三只眼战神，肉身成圣的清源妙道真君，西游路上与悟空打得难分难解的二郎神。", "symbolSize": 50, "category": "封神谱系" },
    { "name": "雷震子", "des": "文王百子之义子，食二杏而生风雷双翼，武王伐纣麾下的先锋猛将。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "妲己", "des": "冀州侯之女，被九尾狐附体的绝色，酒池肉林的祸水之名，史上最著名的替罪者。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "纣王", "des": "商朝末代之君，才力过人却刚愎自用，炮烙忠良、宠信妲己，鹿台自焚而商亡。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "申公豹", "des": "姜子牙的师弟，一句「道友请留步」说动截教群仙下山送死，倾轧同门的暗流。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "闻仲", "des": "三朝元老闻太师，额生神目、坐墨麒麟的商朝柱石，绝龙岭殒命而登封神榜。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "黄飞虎", "des": "镇国武成王，妻死反出朝歌、投周伐纣，战死渑池而为东岳大帝。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "土行孙", "des": "身不满四尺的地行术高手，遁地千里的矮将，归周后娶了邓婵玉的福将。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "封神榜", "des": "三教共签的神谱，凡在劫中身死者依功过敕封为神，一部杀伐与超度的名册。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "元始天尊", "des": "阐教掌教，玉清之主，坐昆仑山玉虚宫，敕命封神、广收门徒的众仙之首。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "通天教主", "des": "截教掌教，有教无类、门下万仙，摆诛仙万仙二阵与师兄对垒，败走后一教封神。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "太乙真人", "des": "乾元山金光洞的阐教金仙，哪吒之师，以莲花重塑弟子身躯的慈父般的存在。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "李靖", "des": "陈塘关总兵，哪吒之父，托塔天王的原型，父子相杀又同殿为臣的复杂一生。", "symbolSize": 40, "category": "封神谱系" },
    { "name": "孙悟空", "des": "石猴出身的美猴王，学艺闹天宫、被压五行山、护唐僧取经，斗战胜佛的诞生史。", "symbolSize": 60, "category": "西游体系" },
    { "name": "唐僧", "des": "金蝉子转生的取经人，十世修行的高僧，肉眼凡胎却以信念走完十万八千里。", "symbolSize": 40, "category": "西游体系" },
    { "name": "猪八戒", "des": "天蓬元帅获罪下凡，错投猪胎的高老庄女婿，贪懒馋滑却砍妖从不手软的八戒。", "symbolSize": 40, "category": "西游体系" },
    { "name": "沙僧", "des": "卷帘大将失手碎盏贬入流沙河，取经队伍里沉默的挑担人，任劳任怨的沙悟净。", "symbolSize": 40, "category": "西游体系" },
    { "name": "白龙马", "des": "西海龙王三太子，纵火烧殿获罪，化白马驮经十万里的无名功臣。", "symbolSize": 40, "category": "西游体系" },
    { "name": "如来佛祖", "des": "灵山雷音寺的世尊，一掌化五行山镇悟空五百年，取经大业的总设计者。", "symbolSize": 50, "category": "西游体系" },
    { "name": "观音菩萨", "des": "寻访取经人的慈悲化身，杨柳净瓶度化顽劣，取经路上有求必应的守护者。", "symbolSize": 50, "category": "西游体系" },
    { "name": "菩提祖师", "des": "灵台方寸山斜月三星洞的隐世高人，授悟空七十二变与筋斗云，此后再不认这个徒弟。", "symbolSize": 40, "category": "西游体系" },
    { "name": "牛魔王", "des": "悟空的结义大哥、平天大圣，火焰山一役家破，被哪吒缚归佛门的大力王。", "symbolSize": 40, "category": "西游体系" },
    { "name": "铁扇公主", "des": "罗刹女，芭蕉扇的主人，因红孩儿之事与悟空结怨，一扇扇出五万里的风。", "symbolSize": 40, "category": "西游体系" },
    { "name": "红孩儿", "des": "牛魔王与铁扇公主之子，三昧真火烧得悟空魂飞，被观音收作善财童子的圣婴大王。", "symbolSize": 40, "category": "西游体系" },
    { "name": "六耳猕猴", "des": "真假美猴王里的另一只猴，与悟空同像同音，瞒过诸天神佛，唯独瞒不过如来。", "symbolSize": 40, "category": "西游体系" },
    { "name": "紧箍咒", "des": "观音授予、唐僧哄戴的花帽，一念咒便头痛欲裂，是约束也是师徒关系的隐喻。", "symbolSize": 40, "category": "西游体系" },
    { "name": "花果山", "des": "东胜神洲傲来国的仙山，石头里蹦出的猴子称王的水帘洞天。", "symbolSize": 40, "category": "西游体系" },
    { "name": "火焰山", "des": "八百里火焰寸草不生，孙悟空踢翻丹炉落下的余火，取经路上必须借扇而过的一劫。", "symbolSize": 40, "category": "西游体系" },
    { "name": "阎罗王", "des": "地府十殿之首的阎君，掌生死簿、断善恶，被悟空勾了名册的苦主。", "symbolSize": 50, "category": "幽冥与民俗神" },
    { "name": "地府", "des": "阴曹地府，十殿阎罗、六道轮回所在，亡魂过奈何桥、饮孟婆汤，黑白无常缉魂引路的幽冥官署。", "symbolSize": 40, "category": "幽冥与民俗神" },
    { "name": "孟婆", "des": "奈何桥畔熬汤的老妪，一碗忘却前生的孟婆汤，让每个亡魂干干净净地转世。", "symbolSize": 40, "category": "幽冥与民俗神" },
    { "name": "判官", "des": "执生死簿、判善恶功过的阴间司法官，崔判官改寿数的传说流传最广。", "symbolSize": 40, "category": "幽冥与民俗神" },
    { "name": "钟馗", "des": "豹头环眼的捉鬼判官，含冤而死誓除天下妖邪，端午与岁末被贴上门户的镇宅之神。", "symbolSize": 40, "category": "幽冥与民俗神" },
    { "name": "灶神", "des": "腊月二十三上天言事的一家之主，灶台上的督察御史，糖瓜粘嘴的可爱无奈。", "symbolSize": 40, "category": "幽冥与民俗神" },
    { "name": "门神", "des": "自神荼郁垒而秦琼尉迟恭，守护门户的最初安防，怒目圆睁的年画主角。", "symbolSize": 40, "category": "幽冥与民俗神" },
    { "name": "月老", "des": "月下老人，以红绳系定姻缘，绳一系之，虽仇敌异域，终不可逭。", "symbolSize": 40, "category": "幽冥与民俗神" },
    { "name": "龙王", "des": "四渎四海之主，行云布雨的水府之尊，与悟空、哪吒都结过梁子的委屈上司。", "symbolSize": 40, "category": "幽冥与民俗神" },
    { "name": "土地公", "des": "一方水土的守护小神，白发拄杖和蔼可亲，西游路上被悟空唤来唤去的老熟人。", "symbolSize": 40, "category": "幽冥与民俗神" },
    { "name": "妈祖", "des": "湄洲林默娘升化而成的天妃天后，护佑航海的海上女神，万船同祭的和平信仰。", "symbolSize": 40, "category": "幽冥与民俗神" },
    { "name": "财神", "des": "正月初五迎的赵公明与关公、比干诸说，人间对富足最直白的祈愿。", "symbolSize": 40, "category": "幽冥与民俗神" }
  ],
  "links": [
    { "source": "中国神话", "target": "盘古", "name": "开天", "des": "混沌剖开的瞬间，一切叙事的时间开始了。" },
    { "source": "中国神话", "target": "女娲", "name": "造化", "des": "抟土造人的母神，人间烟火自此点起。" },
    { "source": "中国神话", "target": "黄帝", "name": "人文", "des": "炎黄共祖的源头，部族记忆凝成华夏。" },
