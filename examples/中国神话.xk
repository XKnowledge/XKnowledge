    { "source": "唐僧", "target": "如来佛祖", "name": "求经", "des": "十万八千里西行，只为灵山一藏真经。" },
    { "source": "六耳猕猴", "target": "孙悟空", "name": "冒名", "des": "一模一样的猴王，连观音的照妖镜也照不出。" },
    { "source": "如来佛祖", "target": "六耳猕猴", "name": "识破", "des": "金钵盂罩下，四猴混世的原形现出。" },
    { "source": "孙悟空", "target": "阎罗王", "name": "闹殿", "des": "勾了生死簿上的猴属名字，地府从此无权管他。" },
    { "source": "孙悟空", "target": "地府", "name": "勾簿", "des": "大笔一挥，猴类名字尽除，生死簿缺了一页。" },
    { "source": "孙悟空", "target": "龙王", "name": "索宝", "des": "东海龙宫借兵器，定海神针从此姓孙。" },
    { "source": "孙悟空", "target": "土地公", "name": "唤问", "des": "一声「土地老儿」，山神土地随叫随到。" },
    { "source": "阎罗王", "target": "地府", "name": "统领", "des": "十殿之首总司幽冥，掌万类生死之籍。" },
    { "source": "判官", "target": "地府", "name": "佐理", "des": "生死簿上一笔定寿数，赏善罚恶的阴间法官。" },
    { "source": "孟婆", "target": "地府", "name": "司汤", "des": "奈何桥畔一碗汤，前尘尽忘再入轮回。" },
    { "source": "阎罗王", "target": "判官", "name": "同僚", "des": "阎君断案，判官执簿，幽冥的法度森然。" },
    { "source": "钟馗", "target": "门神", "name": "同职", "des": "一个捉鬼于途，一个拒鬼于门，都是门户的守护。" },
    { "source": "灶神", "target": "门神", "name": "同祀", "des": "门有门神灶有灶君，一屋之内各司其职。" },
    { "source": "财神", "target": "灶神", "name": "迎送", "des": "腊月廿三送灶，正月里接财神，年俗的头尾。" },
    { "source": "财神", "target": "封神榜", "name": "受封", "des": "赵公明上榜封金龙如意正一龙虎玄坛真君。" },
    { "source": "女娲", "target": "月老", "name": "传承", "des": "女娲始置婚姻，红线牵系的职事由此发端。" },
    { "source": "妈祖", "target": "龙王", "name": "统辖", "des": "海天之上女天后，四海龙王听其节制。" },
    { "source": "龙王", "target": "白龙马", "name": "亲子", "des": "西海龙宫的三太子，纵火烧殿获罪于天。" },
    { "source": "龙王", "target": "大禹治水", "name": "协治", "des": "应龙画地之外，龙族驱水开河的助力之说。" }
  ]
}
