{"version":2,"nodes":[{"name":"细胞膜","des":"以磷脂双分子层为骨架、镶嵌蛋白质的流动镶嵌结构，物质进出的海关。","symbolSize":50,"category":"细胞结构"},{"name":"细胞核","des":"遗传信息库兼代谢调控中心，细胞这台机器的总控制室。","symbolSize":50,"category":"细胞结构"},{"name":"线粒体","des":"双膜结构的动力车间，有氧呼吸主战场，细胞的产能大户。","symbolSize":50,"category":"细胞结构"},{"name":"叶绿体","des":"进行光合作用的养料制造车间，把光能装进糖里的能量转换器。","symbolSize":50,"category":"细胞结构"},{"name":"内质网","des":"膜性管道纵横成网，蛋白质加工与脂质合成的双重车间。","symbolSize":40,"category":"细胞结构"},{"name":"高尔基体","des":"对蛋白质再加工、分类与发送的物流中心，囊泡往来如梭。","symbolSize":40,"category":"细胞结构"},{"name":"核糖体","des":"无膜结构的椭球颗粒，读取密码装配蛋白质的车间。","symbolSize":50,"category":"细胞结构"},{"name":"溶酶体","des":"内含多种水解酶的消化车间，细胞内的回收处理站。","symbolSize":40,"category":"细胞结构"},{"name":"中心体","des":"由两个互相垂直的中心粒组成，动物细胞纺锤体的组织者。","symbolSize":40,"category":"细胞结构"},{"name":"细胞壁","des":"植物细胞外的纤维素盔甲，保护细胞并支撑其形态。","symbolSize":40,"category":"细胞结构"},{"name":"液泡","des":"成熟植物细胞的大水泡，储存物质并维持渗透压。","symbolSize":40,"category":"细胞结构"},{"name":"细胞骨架","des":"由微管与微丝编织的网架，撑形态、运货物、助分裂。","symbolSize":40,"category":"细胞结构"},{"name":"核孔","des":"核被膜上蛋白质构成的通道，大分子进出细胞核的关卡。","symbolSize":40,"category":"细胞结构"},{"name":"核仁","des":"与 rRNA 合成及核糖体亚基组装相关的致密结构。","symbolSize":40,"category":"细胞结构"},{"name":"蛋白质","des":"氨基酸脱水缩合而成的生命活动承担者，催化、运输、防御、结构样样在场。","symbolSize":70,"category":"生物大分子"},{"name":"核酸","des":"由核苷酸连成的信息大分子，一切生物的遗传密码载体。","symbolSize":50,"category":"生物大分子"},{"name":"DNA","des":"规则双螺旋的脱氧核糖核酸，储藏遗传信息的蓝图书库。","symbolSize":70,"category":"生物大分子"},{"name":"RNA","des":"通常单链的核糖核酸，遗传信息的信使与搬运工。","symbolSize":50,"category":"生物大分子"},{"name":"mRNA","des":"携带遗传密码的信使，从细胞核送出蛋白施工图。","symbolSize":50,"category":"生物大分子"},{"name":"tRNA","des":"三叶草形的小分子 RNA，一端识码一端接氨基酸，专职搬运工。","symbolSize":40,"category":"生物大分子"},{"name":"核苷酸","des":"由含氮碱基、五碳糖和磷酸组成的单体，拼写核酸的字母。","symbolSize":40,"category":"生物大分子"},{"name":"氨基酸","des":"至少含一个氨基和一个羧基的有机酸，蛋白质的积木。","symbolSize":40,"category":"生物大分子"},{"name":"肽键","des":"连接两个氨基酸的酰胺键，脱水缩合留下的接缝。","symbolSize":40,"category":"生物大分子"},{"name":"多糖","des":"淀粉、糖原与纤维素等，储能与建身的糖类仓库。","symbolSize":40,"category":"生物大分子"},{"name":"脂质","des":"磷脂、脂肪与固醇一族，膜骨架兼高密度储能介质。","symbolSize":40,"category":"生物大分子"},{"name":"酶","des":"活细胞产生的生物催化剂，本质多为蛋白质，降低活化能的推手。","symbolSize":70,"category":"生物大分子"},{"name":"ATP","des":"腺苷三磷酸，高能磷酸键水解即释能，细胞的能量货币。","symbolSize":70,"category":"生物大分子"},{"name":"水","des":"占细胞鲜重最多的成分，良好溶剂，代谢反应的介质兼原料。","symbolSize":40,"category":"生物大分子"},{"name":"无机盐","des":"多以离子形式存在，构成化合物或维持生命活动的必需成分。","symbolSize":40,"category":"生物大分子"},{"name":"基因","des":"有遗传效应的 DNA 片段，控制性状的基本遗传单位。","symbolSize":50,"category":"遗传信息"},{"name":"染色体","des":"由 DNA 和蛋白质包装而成的遗传物质载体，基因的班车。","symbolSize":50,"category":"遗传信息"},{"name":"染色质","des":"间期细胞核中丝状的 DNA-蛋白质复合体，染色体的松弛形态。","symbolSize":40,"category":"遗传信息"},{"name":"DNA复制","des":"以亲代双链为模板合成子代双链，遗传信息的接力传递。","symbolSize":50,"category":"遗传信息"},{"name":"转录","des":"以 DNA 一条链为模板合成 RNA，把密码从书库抄出。","symbolSize":50,"category":"遗传信息"},{"name":"翻译","des":"按 mRNA 密码子顺序合成肽链，密码落成蛋白质。","symbolSize":50,"category":"遗传信息"},{"name":"密码子","des":"mRNA 上相邻的三个碱基，决定一个氨基酸，共 64 个。","symbolSize":40,"category":"遗传信息"},{"name":"半保留复制","des":"新链以旧链为模板逐一配对，子代 DNA 半新半旧。","symbolSize":40,"category":"遗传信息"},{"name":"逆转录","des":"以 RNA 为模板合成 DNA，遗传信息的逆流而上。","symbolSize":40,"category":"遗传信息"},{"name":"中心法则","des":"遗传信息沿 DNA—RNA—蛋白质流动的总路线图。","symbolSize":70,"category":"遗传信息"},{"name":"碱基互补配对","des":"A 配 T（U）、C 配 G 的规则，复制转录翻译共同的语法。","symbolSize":40,"category":"遗传信息"},{"name":"基因突变","des":"基因上碱基对的增添、缺失或替换，可遗传变异之源。","symbolSize":40,"category":"遗传信息"},{"name":"基因重组","des":"控制不同性状的基因重新组合，生物多样性的重要来源。","symbolSize":40,"category":"遗传信息"},{"name":"等位基因","des":"同源染色体上控制同一性状的不同基因，同座位的版本之差。","symbolSize":40,"category":"遗传信息"},{"name":"基因组","des":"一个细胞或生物体所含的一套完整遗传信息。","symbolSize":40,"category":"遗传信息"},{"name":"新陈代谢","des":"生物体内全部有序化学反应的总称，同化与异化的天平。","symbolSize":50,"category":"代谢途径"},{"name":"糖酵解","des":"一分子葡萄糖裂解为两分子丙酮酸，最古老的供能方式。","symbolSize":40,"category":"代谢途径"},{"name":"三羧酸循环","des":"乙酰辅酶 A 彻底氧化的循环回路，需氧代谢的旋转门。","symbolSize":40,"category":"代谢途径"},{"name":"氧化磷酸化","des":"电子传递偶联 ATP 合成，产能环节的收官大招。","symbolSize":40,"category":"代谢途径"},{"name":"有氧呼吸","des":"有机物彻底氧化为二氧化碳和水，释放大量能量的主航道。","symbolSize":50,"category":"代谢途径"},{"name":"无氧呼吸","des":"缺氧下丙酮酸转为乳酸或酒精，应急的低效供能方案。","symbolSize":40,"category":"代谢途径"},{"name":"光合作用","des":"光能转变为化学能储入有机物，生物圈一切能量的入口。","symbolSize":50,"category":"代谢途径"},{"name":"光反应","des":"类囊体薄膜上光解水并生成 ATP 与 NADPH 的阶段。","symbolSize":40,"category":"代谢途径"},{"name":"暗反应","des":"基质中固定二氧化碳还原成糖的卡尔文循环，不需光却靠光的产物。","symbolSize":40,"category":"代谢途径"},{"name":"呼吸链","des":"线粒体内膜上的电子传递链，把能量一步步榨成质子梯度。","symbolSize":40,"category":"代谢途径"},{"name":"葡萄糖","des":"细胞呼吸最常燃烧的六碳糖燃料，能量的标准小块。","symbolSize":40,"category":"代谢途径"},{"name":"丙酮酸","des":"糖酵解的产物，通向有氧与无氧两条路的岔口。","symbolSize":40,"category":"代谢途径"},{"name":"二氧化碳","des":"暗反应的碳源，有氧呼吸的终点废物。","symbolSize":40,"category":"代谢途径"},{"name":"NADPH","des":"光反应攒下的还原力，暗反应合成糖类的供氢使者。","symbolSize":40,"category":"代谢途径"},{"name":"细胞增殖","des":"细胞数目增加的过程，生长、发育与损伤修复的基础。","symbolSize":40,"category":"细胞分裂"},{"name":"细胞周期","des":"连续分裂细胞从一次分裂结束到下一次分裂结束的循环。","symbolSize":50,"category":"细胞分裂"},{"name":"分裂间期","des":"周期中最长的准备期，完成 DNA 复制与相关蛋白合成。","symbolSize":40,"category":"细胞分裂"},{"name":"有丝分裂","des":"染色体复制一次、分裂一次，子细胞与亲代完全一致。","symbolSize":50,"category":"细胞分裂"},{"name":"减数分裂","des":"复制一次、连续分裂两次，染色体数目减半的特种分裂。","symbolSize":50,"category":"细胞分裂"},{"name":"同源染色体","des":"一条来自父方一条来自母方的成对染色体，形态大小一般相同。","symbolSize":40,"category":"细胞分裂"},{"name":"姐妹染色单体","des":"复制产生的两条完全相同的单体，由着丝粒相连。","symbolSize":40,"category":"细胞分裂"},{"name":"联会","des":"减数分裂时同源染色体两两配对，四分体的前奏。","symbolSize":40,"category":"细胞分裂"},{"name":"交叉互换","des":"四分体时期同源染色体的非姐妹染色单体交换片段。","symbolSize":40,"category":"细胞分裂"},{"name":"自由组合","des":"减数第一次分裂后期非同源染色体的自由搭配。","symbolSize":40,"category":"细胞分裂"},{"name":"纺锤体","des":"由纺锤丝组成的牵引装置，拉开染色体的缆绳系统。","symbolSize":40,"category":"细胞分裂"},{"name":"配子","des":"减数分裂产生的成熟生殖细胞，染色体数减半。","symbolSize":40,"category":"细胞分裂"},{"name":"受精作用","des":"精子与卵细胞融合，染色体数目恢复为双份。","symbolSize":40,"category":"细胞分裂"},{"name":"启动子","des":"RNA 聚合酶识别与结合的 DNA 序列，转录的点火开关。","symbolSize":40,"category":"基因表达调控"},{"name":"操纵子","des":"原核生物功能相关基因的成簇调控单位，乳糖操纵子是经典。","symbolSize":40,"category":"基因表达调控"},{"name":"转录因子","des":"与调控序列结合的调节蛋白，转录起始的开关员。","symbolSize":40,"category":"基因表达调控"},{"name":"RNA聚合酶","des":"以 DNA 为模板合成 RNA 的酶，转录的引擎。","symbolSize":40,"category":"基因表达调控"},{"name":"表观遗传","des":"不改变 DNA 序列而可遗传的表达变化，写在基因之上的批注。","symbolSize":40,"category":"基因表达调控"},{"name":"DNA甲基化","des":"给碱基添上甲基封闭转录，给基因贴的封条。","symbolSize":40,"category":"基因表达调控"},{"name":"组蛋白修饰","des":"乙酰化等修饰改变染色质松紧，基因表达的可调旋钮。","symbolSize":40,"category":"基因表达调控"},{"name":"选择性表达","des":"不同细胞开启不同的基因组合，细胞分工的分子基础。","symbolSize":40,"category":"基因表达调控"},{"name":"细胞分化","des":"相同基因组表达出不同表型，从全能细胞到专职细胞。","symbolSize":50,"category":"基因表达调控"},{"name":"细胞凋亡","des":"由基因决定的程序性死亡，主动而有序的自我了断。","symbolSize":40,"category":"基因表达调控"},{"name":"原癌基因","des":"正常调控细胞周期的基因，突变激活后变成癌变的油门。","symbolSize":40,"category":"基因表达调控"},{"name":"抑癌基因","des":"抑制异常增殖的基因，失活即刹车失灵的保险装置。","symbolSize":40,"category":"基因表达调控"},{"name":"细胞癌变","des":"多基因突变累积的结果，无限增殖的恶性蜕变。","symbolSize":40,"category":"基因表达调控"}],"links":[{"source":"细胞壁","target":"细胞膜","name":"保护","des":"纤维素外壁为膜及内部原生质体提供刚性屏障。"},{"source":"细胞膜","target":"细胞骨架","name":"锚定","des":"骨架蛋白与膜内侧相连，维持细胞形态与运动。"},{"source":"核仁","target":"核糖体","name":"组装","des":"核仁转录 rRNA 并装配核糖体亚基。"},{"source":"核糖体","target":"内质网","name":"附着","des":"粗面内质网膜外布满核糖体，专职合成分泌蛋白。"},{"source":"内质网","target":"高尔基体","name":"运输","des":"加工产物以囊泡形式送往高尔基体深加工。"},{"source":"高尔基体","target":"溶酶体","name":"形成","des":"水解酶在此加工打包，出芽形成溶酶体。"},{"source":"高尔基体","target":"细胞膜","name":"分泌","des":"分泌囊泡与膜融合，将产物胞吐到胞外。"},{"source":"线粒体","target":"DNA","name":"含有","des":"线粒体具环状 DNA，是半自主性细胞器。"},{"source":"叶绿体","target":"DNA","name":"含有","des":"叶绿体有自己的基因组，同样半自主。"},{"source":"液泡","target":"水","name":"储存","des":"成熟植物细胞的大液泡储水并维持渗透压。"},{"source":"溶酶体","target":"酶","name":"含有","des":"内含数十种酸性水解酶，分解衰老细胞器。"},{"source":"细胞膜","target":"蛋白质","name":"镶嵌","des":"膜蛋白承担运输、识别与信号传导。"},{"source":"细胞壁","target":"多糖","name":"构成","des":"细胞壁的主要成分纤维素是葡萄糖的多聚物。"},{"source":"内质网","target":"脂质","name":"合成","des":"光面内质网是磷脂与固醇的合成车间。"},{"source":"核仁","target":"RNA","name":"转录","des":"核仁区的 rRNA 基因高度活跃地转录。"},{"source":"mRNA","target":"核孔","name":"穿行","des":"成熟 mRNA 经核孔进入细胞质待译。"},{"source":"肽键","target":"氨基酸","name":"连接","des":"一个氨基酸的羧基与另一个的氨基脱水缩合。"},{"source":"氨基酸","target":"蛋白质","name":"组成","des":"氨基酸按序列连成多肽，折叠为蛋白质。"},{"source":"酶","target":"蛋白质","name":"属于","des":"绝大多数酶的化学本质是蛋白质。"},{"source":"核酸","target":"DNA","name":"包括","des":"核酸分为脱氧核糖核酸与核糖核酸两类。"},{"source":"核酸","target":"RNA","name":"包括","des":"RNA 携带遗传信息并参与表达。"},{"source":"DNA","target":"RNA","name":"指导","des":"以 DNA 一条链为模板转录出 RNA。"},{"source":"核苷酸","target":"核酸","name":"组成","des":"核酸是核苷酸连成的长链。"},{"source":"mRNA","target":"tRNA","name":"适配","des":"反密码子与密码子配对，对号入座。"},{"source":"tRNA","target":"氨基酸","name":"运载","des":"每种 tRNA 专运一种特定氨基酸。"},{"source":"无机盐","target":"酶","name":"辅助","des":"许多金属离子是酶发挥活性的必需辅因子。"},{"source":"多糖","target":"葡萄糖","name":"水解","des":"淀粉与糖原水解为葡萄糖单体供能。"},{"source":"脂质","target":"细胞膜","name":"构成","des":"磷脂双分子层是膜的基本骨架。"},{"source":"水","target":"细胞膜","name":"渗透","des":"水分子以自由扩散方式穿越磷脂双分子层。"},{"source":"基因","target":"DNA","name":"片段","des":"基因是有遗传效应的 DNA 片段。"},{"source":"基因","target":"蛋白质","name":"编码","des":"基因通过转录翻译指导蛋白质合成。"},{"source":"基因","target":"染色体","name":"定位","des":"基因在染色体上呈线性排列。"},{"source":"染色质","target":"染色体","name":"浓缩","des":"分裂时染色质螺旋化，变粗变短成染色体。"},{"source":"染色质","target":"细胞核","name":"位于","des":"染色质充斥于间期细胞的细胞核中。"},{"source":"染色体","target":"DNA","name":"携带","des":"DNA 与蛋白质打包即成染色体。"},{"source":"染色体","target":"蛋白质","name":"包装","des":"DNA 缠绕组蛋白，逐级压缩近万倍。"},{"source":"中心法则","target":"DNA","name":"描绘","des":"信息可从 DNA 流向 DNA 与 RNA。"},{"source":"中心法则","target":"蛋白质","name":"流向","des":"信息流动的终点是蛋白质的性状表达。"},{"source":"中心法则","target":"转录","name":"包含","des":"DNA 到 RNA 是中心法则的中游。"},{"source":"中心法则","target":"翻译","name":"包含","des":"RNA 到蛋白质完成信息表达。"},{"source":"中心法则","target":"逆转录","name":"补充","des":"逆转录病毒的发现完善了中心法则。"},{"source":"DNA复制","target":"半保留复制","name":"方式","des":"子代 DNA 双链各保留一条母链。"},{"source":"DNA复制","target":"碱基互补配对","name":"依据","des":"A-T、G-C 配对保证复制忠实。"},{"source":"DNA复制","target":"基因突变","name":"引入","des":"复制差错是突变的重要来源。"},{"source":"转录","target":"碱基互补配对","name":"依据","des":"转录同样遵循 A-U 配对规则。"},{"source":"转录","target":"mRNA","name":"生成","des":"信使 RNA 由转录产生。"},{"source":"转录","target":"细胞核","name":"发生于","des":"真核生物的转录在细胞核内进行。"},{"source":"翻译","target":"核糖体","name":"发生于","des":"核糖体是蛋白质合成的车间。"},{"source":"翻译","target":"mRNA","name":"模板","des":"按 mRNA 密码序列逐个添加氨基酸。"},{"source":"翻译","target":"蛋白质","name":"产物","des":"翻译的直接产物是多肽链。"},{"source":"翻译","target":"肽键","name":"形成","des":"核糖体催化肽键把氨基酸串联起来。"},{"source":"密码子","target":"mRNA","name":"排列","des":"密码子在 mRNA 链上相邻阅读。"},{"source":"密码子","target":"氨基酸","name":"决定","des":"每个密码子对应一种特定氨基酸。"},{"source":"基因","target":"转录","name":"控制","des":"基因表达从转录这一步启动。"},{"source":"基因突变","target":"基因","name":"改变","des":"碱基对的增添、缺失或替换。"},{"source":"基因突变","target":"原癌基因","name":"激活","des":"突变使原癌基因变为癌基因。"},{"source":"基因重组","target":"等位基因","name":"重排","des":"控制不同性状的基因重新组合。"},{"source":"等位基因","target":"同源染色体","name":"位于","des":"等位基因分坐同源染色体的对应座位。"},{"source":"自由组合","target":"基因重组","name":"实现","des":"非同源染色体自由组合实现基因重组。"},{"source":"交叉互换","target":"基因重组","name":"贡献","des":"染色单体片段交换同样造成重组。"},{"source":"逆转录","target":"RNA","name":"模板","des":"以 RNA 为模板反向合成 DNA。"},{"source":"逆转录","target":"DNA","name":"产物","des":"逆转录酶催化合成 DNA 单链。"},{"source":"基因组","target":"DNA","name":"全集","des":"基因组是一套完整的 DNA 遗传信息。"},{"source":"新陈代谢","target":"酶","name":"依赖","des":"代谢的每一步反应都由酶催化。"},{"source":"新陈代谢","target":"ATP","name":"贯通","des":"代谢的实质是物质与能量的流转，ATP 是硬通货。"},{"source":"有氧呼吸","target":"糖酵解","name":"包括","des":"糖酵解是有氧呼吸的第一阶段。"},{"source":"有氧呼吸","target":"三羧酸循环","name":"包括","des":"第二阶段丙酮酸入线粒体彻底氧化。"},{"source":"有氧呼吸","target":"线粒体","name":"发生于","des":"真核细胞有氧呼吸的主战场在线粒体。"},{"source":"有氧呼吸","target":"二氧化碳","name":"释放","des":"有机物彻底氧化放出二氧化碳。"},{"source":"糖酵解","target":"丙酮酸","name":"生成","des":"一分子葡萄糖裂解为两分子丙酮酸。"},{"source":"糖酵解","target":"ATP","name":"净产","des":"底物水平磷酸化净得两个 ATP。"},{"source":"丙酮酸","target":"三羧酸循环","name":"进入","des":"丙酮酸脱羧成乙酰辅酶 A 后进入循环。"},{"source":"三羧酸循环","target":"呼吸链","name":"递氢","des":"循环产生的 NADH 送入呼吸链。"},{"source":"三羧酸循环","target":"线粒体","name":"位于","des":"三羧酸循环发生在线粒体基质。"},{"source":"呼吸链","target":"氧化磷酸化","name":"驱动","des":"电子传递泵出质子建立电化学梯度。"},{"source":"氧化磷酸化","target":"ATP","name":"合成","des":"质子回流推动 ATP 合酶大量产能。"},{"source":"氧化磷酸化","target":"线粒体","name":"发生于","des":"氧化磷酸化位于线粒体内膜。"},{"source":"无氧呼吸","target":"糖酵解","name":"依赖","des":"无氧呼吸第一阶段同为糖酵解。"},{"source":"无氧呼吸","target":"丙酮酸","name":"发酵","des":"丙酮酸被还原为乳酸或酒精。"},{"source":"光合作用","target":"叶绿体","name":"发生于","des":"光合作用全程在叶绿体中进行。"},{"source":"光合作用","target":"光反应","name":"包括","des":"光反应在类囊体薄膜上进行。"},{"source":"光合作用","target":"暗反应","name":"包括","des":"暗反应在叶绿体基质中进行。"},{"source":"光反应","target":"暗反应","name":"供能","des":"为暗反应提供 ATP 与 NADPH。"},{"source":"光反应","target":"水","name":"光解","des":"水分子被光解，释放氧气、氢与电子。"},{"source":"光反应","target":"ATP","name":"生成","des":"光合磷酸化把光能暂存入 ATP。"},{"source":"光反应","target":"NADPH","name":"生成","des":"电子传递最终还原生成 NADPH。"},{"source":"暗反应","target":"二氧化碳","name":"固定","des":"二氧化碳与五碳化合物结合被固定。"},{"source":"暗反应","target":"NADPH","name":"消耗","des":"NADPH 供氢还原三碳化合物。"},{"source":"暗反应","target":"葡萄糖","name":"合成","des":"卡尔文循环最终产出葡萄糖等有机物。"},{"source":"葡萄糖","target":"细胞膜","name":"转运","des":"借助载体蛋白以协助扩散进入细胞。"},{"source":"ATP","target":"细胞骨架","name":"驱动","des":"马达蛋白水解 ATP 沿微管运送货物。"},{"source":"ATP","target":"纺锤体","name":"供能","des":"纺锤丝牵引染色体运动消耗能量。"},{"source":"酶","target":"DNA复制","name":"催化","des":"解旋酶、聚合酶等一整套酶系协同复制。"},{"source":"细胞增殖","target":"细胞周期","name":"经历","des":"连续分裂的细胞沿周期循环运转。"},{"source":"细胞周期","target":"分裂间期","name":"包括","des":"间期占时九成以上并完成物质准备。"},{"source":"细胞周期","target":"有丝分裂","name":"包括","des":"分裂期将染色体均分入两个子细胞。"},{"source":"分裂间期","target":"DNA复制","name":"完成","des":"S 期完成整个基因组的复制。"},{"source":"有丝分裂","target":"纺锤体","name":"依靠","des":"纺锤丝牵引染色体移向细胞两极。"},{"source":"纺锤体","target":"染色体","name":"牵引","des":"纺锤丝附着着丝粒将其拉向两极。"},{"source":"有丝分裂","target":"姐妹染色单体","name":"分开","des":"后期着丝粒分裂，单体彼此分开。"},{"source":"减数分裂","target":"同源染色体","name":"联会","des":"减数第一次分裂前期同源染色体配对。"},{"source":"交叉互换","target":"联会","name":"发生于","des":"互换发生在联会形成的四分体时期。"},{"source":"交叉互换","target":"减数分裂","name":"发生于","des":"是减数第一次分裂前期的重组事件。"},{"source":"自由组合","target":"减数分裂","name":"发生于","des":"发生在减数第一次分裂后期。"},{"source":"减数分裂","target":"配子","name":"产生","des":"一次减数分裂最多产出四个子细胞。"},{"source":"配子","target":"受精作用","name":"融合","des":"精子与卵细胞融合恢复二倍体。"},{"source":"受精作用","target":"染色体","name":"复原","des":"受精使染色体数目恢复为 2N。"},{"source":"中心体","target":"纺锤体","name":"组织","des":"星射线由中心体放射组成纺锤体。"},{"source":"启动子","target":"RNA聚合酶","name":"识别","des":"聚合酶结合启动子启动转录。"},{"source":"启动子","target":"转录","name":"起始","des":"启动子决定转录从哪里开始。"},{"source":"操纵子","target":"启动子","name":"包含","des":"操纵子含启动子、操纵基因与结构基因。"},{"source":"操纵子","target":"基因","name":"调节","des":"乳糖操纵子是原核调控的经典模型。"},{"source":"转录因子","target":"启动子","name":"结合","des":"转录因子协助装配转录起始复合体。"},{"source":"转录因子","target":"蛋白质","name":"属于","des":"转录因子是一类起调节作用的蛋白。"},{"source":"RNA聚合酶","target":"转录","name":"催化","des":"沿模板链移动逐个延伸 RNA 链。"},{"source":"表观遗传","target":"DNA甲基化","name":"机制","des":"甲基化是表观调控的重要手段。"},{"source":"表观遗传","target":"组蛋白修饰","name":"机制","des":"修饰改变染色质的可接近性。"},{"source":"组蛋白修饰","target":"染色质","name":"改造","des":"乙酰化松开染色质利于转录。"},{"source":"DNA甲基化","target":"基因","name":"沉默","des":"启动子高甲基化使基因表达沉默。"},{"source":"表观遗传","target":"细胞分化","name":"影响","des":"表观标记稳定传递维持细胞身份。"},{"source":"细胞分化","target":"选择性表达","name":"本质","des":"分化的实质是基因的选择性表达。"},{"source":"选择性表达","target":"基因","name":"开关","des":"不同细胞开动不同的基因组合。"},{"source":"细胞分化","target":"细胞增殖","name":"来源","des":"增殖产生的新细胞逐渐走向分化。"},{"source":"细胞凋亡","target":"细胞分化","name":"参与","des":"胚胎发育中靠凋亡雕琢出形态。"},{"source":"细胞凋亡","target":"基因","name":"编程","des":"凋亡是由基因决定的程序性死亡。"},{"source":"细胞凋亡","target":"细胞骨架","name":"解构","des":"凋亡执行期细胞骨架有序瓦解。"},{"source":"原癌基因","target":"细胞增殖","name":"促进","des":"正常状态下促进生长与分裂的油门。"},{"source":"抑癌基因","target":"细胞增殖","name":"抑制","des":"如同刹车限制细胞的异常增殖。"},{"source":"原癌基因","target":"细胞癌变","name":"导致","des":"突变激活后驱动细胞恶性增殖。"},{"source":"抑癌基因","target":"细胞癌变","name":"失守","des":"抑癌基因失活即刹车失灵。"},{"source":"细胞癌变","target":"细胞增殖","name":"逃逸","des":"癌细胞摆脱周期调控无限增殖。"},{"source":"细胞癌变","target":"细胞凋亡","name":"逃避","des":"癌细胞逃逸凋亡获得不死性。"},{"source":"表观遗传","target":"细胞癌变","name":"参与","des":"甲基化异常广泛见于癌变过程。"},{"source":"等位基因","target":"基因突变","name":"产生","des":"突变造就控制同一性状的新版本。"}],"title":"生物分子与细胞","description":"从细胞器到中心法则的分子生物学概念图"}