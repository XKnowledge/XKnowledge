{"version":2,"nodes":[{"name":"动物行为学","des":"研究动物行为的原因、发育、功能与演化的学科：从本能到文化。","symbolSize":60,"category":"奠基时代"},{"name":"达尔文与情绪表达","des":"1872 年《人与动物的情绪表达》：行为研究的进化论起点。","symbolSize":35,"category":"奠基时代"},{"name":"洛伦兹","des":"灰雁与铭印：欧洲行为学传统的开创者。","symbolSize":55,"category":"奠基时代"},{"name":"廷伯根","des":"棘鱼四问与三刺鱼研究：行为学的问题分析大师。","symbolSize":50,"category":"奠基时代"},{"name":"冯·弗里施","des":"蜜蜂舞蹈语言的破译者。","symbolSize":50,"category":"奠基时代"},{"name":"1973年诺贝尔奖","des":"三人同获生理学或医学奖：行为学的加冕礼。","symbolSize":30,"category":"奠基时代"},{"name":"固定动作模式","des":"特定刺激引发的定型行为序列：本能的单位。","symbolSize":40,"category":"奠基时代"},{"name":"释放刺激","des":"触发本能行为的信号特征：哑蛋与假喙。","symbolSize":30,"category":"奠基时代"},{"name":"铭印","des":"关键期的跟随学习：洛伦兹被灰雁认作母亲。","symbolSize":45,"category":"奠基时代"},{"name":"行为主义之争","des":"摩根法则对拟人化的约束：与比较心理学的张力。","symbolSize":30,"category":"奠基时代"},{"name":"四问框架","des":"机制、发育、功能、演化：廷伯根的问题坐标系。","symbolSize":45,"category":"四问框架"},{"name":"近因与远因","des":"「怎么发生」与「为何存在」的两层解释。","symbolSize":30,"category":"四问框架"},{"name":"比较心理学","des":"迷宫与斯金纳箱的美式传统：学习的量化研究。","symbolSize":25,"category":"四问框架"},{"name":"最优觅食理论","des":"把经济学带入觅食：能量收支的最优解。","symbolSize":35,"category":"觅食与生存"},{"name":"捕食者-猎物军备","des":"蝙蝠与蛾的声呐对决：协同演化的武器库。","symbolSize":30,"category":"觅食与生存"},{"name":"拟态与伪装","des":"贝氏拟态与穆氏拟态：欺骗的演化经济学。","symbolSize":30,"category":"觅食与生存"},{"name":"贮食行为","des":"松鼠与星鸦的空间记忆缓存。","symbolSize":25,"category":"觅食与生存"},{"name":"领域行为","des":"画地为巢的经济学：领域大小与资源密度。","symbolSize":30,"category":"觅食与生存"},{"name":"亲缘选择","des":"汉密尔顿 1964：基因视角的利他解。","symbolSize":40,"category":"社会行为"},{"name":"汉密尔顿法则","des":"rB>C：利他演化的不等式。","symbolSize":30,"category":"社会行为"},{"name":"利他行为","des":"从报警呼叫到分食：看似矛盾的适应景观。","symbolSize":40,"category":"社会行为"},{"name":"互惠利他","des":"吸血蝙蝠的血餐分享：延迟回报的合作。","symbolSize":30,"category":"社会行为"},{"name":"真社会性","des":"蚂蚁、白蚁与裸鼹鼠：生殖分工的极致社会。","symbolSize":45,"category":"社会行为"},{"name":"等级序位","des":"啄序与支配关系：群体内的冲突管理。","symbolSize":25,"category":"社会行为"},{"name":"灵长类社会","des":"狒狒的联盟与黑猩猩的政治。","symbolSize":35,"category":"社会行为"},{"name":"珍·古道尔","des":"贡贝的黑猩猩研究：工具与文化的人类近邻。","symbolSize":35,"category":"社会行为"},{"name":"蜜蜂舞蹈语言","des":"8 字舞的方向与距离编码。","symbolSize":40,"category":"交流"},{"name":"鸟鸣学习","des":"鸣禽的敏感期与方言：行为文化的模型。","symbolSize":30,"category":"交流"},{"name":"信息素","des":"蛾类的化学情书与蚂蚁的气味路线。","symbolSize":30,"category":"交流"},{"name":"警报通讯","des":"猴群的豹、鹰、蛇三声警报：语义的雏形。","symbolSize":25,"category":"交流"},{"name":"动物语言争论","des":"教黑猩猩手语的成败与争议。","symbolSize":25,"category":"交流"},{"name":"性选择","des":"达尔文 1871：雌雄淘汰的第二引擎。","symbolSize":40,"category":"求偶与性选择"},{"name":"求偶场","des":"孔雀开宽的集体竞技场：leks 的演化。","symbolSize":35,"category":"求偶与性选择"},{"name":"雌性选择","des":"华而不实原则：偏好驱动雄性装饰。","symbolSize":30,"category":"求偶与性选择"},{"name":"昂贵信号","des":" handicap 理论：代价保证信号诚实。","symbolSize":30,"category":"求偶与性选择"},{"name":"交配系统","des":"一夫多妻、一妻多夫与单配偶的谱系。","symbolSize":30,"category":"求偶与性选择"},{"name":"ESS 进化稳定策略","des":"一旦占据便不可入侵的策略集。","symbolSize":35,"category":"行为生态与理论"},{"name":"博弈与行为","des":"鹰鸽博弈与合作演化：行为生态的引擎。","symbolSize":30,"category":"行为生态与理论"},{"name":"亲代投资","des":"特里弗斯的亲代投资理论：性角色分工的根源。","symbolSize":30,"category":"行为生态与理论"},{"name":"动物文化","des":"日本猴洗红薯与黑猩猩工具传承：非基因的传递。","symbolSize":25,"category":"行为生态与理论"},{"name":"行为生态学","des":"把生态、经济与博弈合流的新综合。","symbolSize":40,"category":"行为生态与理论"}],"links":[{"source":"动物行为学","target":"洛伦兹","name":"奠基","des":"铭印与本能学派。"},{"source":"动物行为学","target":"廷伯根","name":"奠基","des":"四问的分析纲领。"},{"source":"动物行为学","target":"冯·弗里施","name":"奠基","des":"舞蹈语言的解码。"},{"source":"动物行为学","target":"达尔文与情绪表达","name":"起点","des":"进化论的直接延伸。"},{"source":"动物行为学","target":"四问框架","name":"骨架","des":"四个问题定义学科版图。"},{"source":"动物行为学","target":"行为生态学","name":"当代","des":"生态与博弈的新综合。"},{"source":"动物行为学","target":"真社会性","name":"高峰","des":"社会演化的极端形态。"},{"source":"洛伦兹","target":"铭印","name":"发现","des":"灰雁跟随的关键期。"},{"source":"洛伦兹","target":"固定动作模式","name":"提出","des":"本能行为的结构单元。"},{"source":"释放刺激","target":"固定动作模式","name":"触发","des":"信号钥匙打开动作锁。"},{"source":"廷伯根","target":"四问框架","name":"提出","des":"1963 年的提纲论文。"},{"source":"冯·