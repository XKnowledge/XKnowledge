{"version":2,"nodes":[{"name":"希腊城邦","des":"散落于爱琴海岸的小型主权公民共同体，西方政治文明的母体。","symbolSize":50,"category":"古典文明"},{"name":"雅典民主","des":"公民大会与陪审法庭的直接民主，经梭伦至克里斯提尼奠基、伯里克利臻于极盛，后世民主制度的源头。","symbolSize":50,"category":"古典文明"},{"name":"梭伦改革","des":"公元前594年的解负令与等级权利制，雅典民主的第一块踏脚石。","symbolSize":40,"category":"古典文明"},{"name":"伯里克利","des":"雅典黄金时代的掌舵人，公民大会全盛期的实际领导人。","symbolSize":40,"category":"古典文明"},{"name":"伯罗奔尼撒战争","des":"前431至前404年雅典与斯巴达的争霸拉锯，希腊世界由盛转衰的转折。","symbolSize":40,"category":"古典文明"},{"name":"亚历山大帝国","des":"前336至前323年东征建立的跨洲大帝国，希腊文明东传至中亚与印度河。","symbolSize":50,"category":"古典文明"},{"name":"希腊化时代","des":"希腊文明与东方文明交融互渗的三百年，亚历山大城为其学术中心。","symbolSize":40,"category":"古典文明"},{"name":"罗马共和国","des":"前509年起执政官、元老院与公民大会并立的混合政体，共和理念的策源地。","symbolSize":50,"category":"古典文明"},{"name":"布匿战争","des":"前264至前146年罗马与迦太基的三次地中海霸权之争，迦太基的毁灭成就罗马霸业。","symbolSize":40,"category":"古典文明"},{"name":"凯撒","des":"征服高卢、渡过卢比孔河，引领罗马由共和国走向帝制的过渡人物。","symbolSize":50,"category":"古典文明"},{"name":"奥古斯都","des":"屋大维，凯撒遇刺后内战的胜者，以元首之名创立帝制的开国者。","symbolSize":50,"category":"古典文明"},{"name":"罗马帝国","des":"前27年开启的地中海大一统帝国，极盛时环地中海而治，古典文明的集大成载体。","symbolSize":70,"category":"古典文明"},{"name":"罗马和平","des":"奥古斯都至安东尼王朝约两百年的安定繁荣，道路、法律与商贸的黄金时代。","symbolSize":40,"category":"古典文明"},{"name":"罗马法","des":"从《十二铜表法》到《民法大全》的成文法体系，后世大陆法系的祖先。","symbolSize":50,"category":"古典文明"},{"name":"基督教兴起","des":"公元一世纪诞生于罗马行省犹太地，由受迫害教派终成国教，重塑欧洲精神世界。","symbolSize":50,"category":"古典文明"},{"name":"戴克里先","des":"创立四帝共治、稳住三世纪危机的改革者皇帝，帝国转型的关键人物。","symbolSize":40,"category":"古典文明"},{"name":"西罗马灭亡","des":"476年末代皇帝被废，日耳曼诸王国取而代之的旧新更替，中世纪的开端。","symbolSize":50,"category":"古典文明"},{"name":"法兰克王国","des":"日耳曼诸王国中最强的一支，由克洛维皈依到加洛林崛起，法德两国的共同胚胎。","symbolSize":50,"category":"中世纪"},{"name":"查理曼","des":"公元800年加冕称帝、一统西欧大部的法兰克君主，后世尊为欧洲之父。","symbolSize":50,"category":"中世纪"},{"name":"封建制度","des":"以封君封臣与采邑为纽带的层级权利义务网络，中世纪欧洲的社会基本框架。","symbolSize":50,"category":"中世纪"},{"name":"神圣罗马帝国","des":"962年奥托一世开创的帝国政体，既是一种帝国理念又是松散的诸侯联合。","symbolSize":40,"category":"中世纪"},{"name":"十字军东征","des":"1096至1291年间的系列东征地中海东岸行动，宗教旗帜下的东西方大碰撞与大交流。","symbolSize":40,"category":"中世纪"},{"name":"维京时代","des":"八至十一世纪北欧人劫掠、经商与殖民的海上扩张，重塑欧洲沿海格局。","symbolSize":40,"category":"中世纪"},{"name":"叙任权之争","des":"教皇与皇帝围绕主教任命权的百年角力，教俗权力博弈的核心剧目。","symbolSize":40,"category":"中世纪"},{"name":"黑死病","des":"1347至1353年夺走欧洲三分之一人口的大瘟疫，中世纪晚期社会结构的强力摇撼者。","symbolSize":50,"category":"中世纪"},{"name":"百年战争","des":"1337至1453年英格兰与法兰西的百年缠斗，两国民族意识的催化剂。","symbolSize":40,"category":"中世纪"},{"name":"经院哲学","des":"信仰寻求理性论证的学术形态，托马斯·阿奎那的体系为其顶峰，中世纪大学的课堂正统。","symbolSize":40,"category":"中世纪"},{"name":"大学兴起","des":"自博洛尼亚、巴黎到牛津，十二世纪起获得自治的学者共同体，近现代大学的制度祖先。","symbolSize":40,"category":"中世纪"},{"name":"拜占庭","des":"以君士坦丁堡为都延续千年的东部帝国，为西方守护并传递古典学问。","symbolSize":40,"category":"中世纪"},{"name":"大宪章","des":"1215年英格兰贵族逼迫约翰王签署的权利文件，未经同意不征税为其内核，宪政的远源。","symbolSize":50,"category":"中世纪"},{"name":"城市兴起","des":"十一世纪起的商业市镇与市民自治，中世纪版图中崛起的第三等级。","symbolSize":40,"category":"中世纪"},{"name":"君士坦丁堡陷落","des":"1453年奥斯曼攻陷拜占庭都城，中世纪的终点与开辟新航路的推手。","symbolSize":40,"category":"中世纪"},{"name":"文艺复兴","des":"十四世纪起自意大利兴起，以复兴古典、发现人的尊严为旗帜的大变革，欧洲近代的序幕。","symbolSize":70,"category":"文艺复兴与大航海"},{"name":"人文主义","des":"以人为中心而非以神为中心，肯定世俗生活与个体价值，文艺复兴的精神主调。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"美第奇家族","des":"佛罗伦萨的银行家与政治家族，文艺复兴最大的赞助人，把财富织进艺术。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"达·芬奇","des":"画家、解剖学家与工程师于一身的全才，全人理想的最佳化身。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"米开朗基罗","des":"西斯廷天顶画与大卫像的缔造者，雕塑绘画双绝的英雄气质典范。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"拉斐尔","des":"盛期文艺复兴的和谐与优雅，《雅典学院》式的古典范式。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"印刷革命","des":"十五世纪中古腾堡活字印刷，知识复制成本骤降一个量级，宗教改革之前的信息革命。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"宗教改革","des":"1517年起以因信称义直挑战教皇权威的大变革，基督教世界由一统走向多元。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"马丁·路德","des":"1517年张贴《九十五条论纲》点燃宗教改革风暴的维滕贝格神学家。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"加尔文","des":"日内瓦宗教改革的设计师，预定论与入世禁欲深刻影响新教伦理。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"哥伦布","des":"1492年向西横渡大西洋抵达美洲的热那亚航海家，两个半球文明大汇合的开端。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"麦哲伦","des":"其船队于1519至1522年完成首次环球航行，以实践证明地球为球体。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"大航海时代","des":"十五世纪末开启的海外扩张浪潮，欧洲从世界边缘走向世界中心。","symbolSize":50,"category":"文艺复兴与大航海"},{"name":"日心说","des":"1543年哥白尼提出以太阳为中心的宇宙图景，中世纪世界观的第一个缺口。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"价格革命","des":"十六世纪美洲白银涌入欧洲引发的物价腾贵，大商业时代的货币前奏。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"威斯特伐利亚和约","des":"1648年终结三十年战争的合约体系，主权国家间秩序的现代起点。","symbolSize":40,"category":"文艺复兴与大航海"},{"name":"英国革命","des":"1640年起围绕王权边界的内战与动荡，近代政治革命的序幕。","symbolSize":40,"category":"革命时代"},{"name":"光荣革命","des":"1688年不流血的改朝换代，议会至上就此定局。","symbolSize":50,"category":"革命时代"},{"name":"君主立宪","des":"《权利法案》后国王统而不治、议会至上的政体，近代宪政的模板。","symbolSize":50,"category":"革命时代"},{"name":"启蒙运动","des":"十八世纪以理性为武器、以自由平等进步为蓝图的思想高潮。","symbolSize":50,"category":"革命时代"},{"name":"伏尔泰","des":"以批判教会与倡导宽容闻名的启蒙旗手，一个时代的精神领袖。","symbolSize":40,"category":"革命时代"},{"name":"孟德斯鸠","des":"《论法的精神》提出三权分立，为近代宪制提供结构设计。","symbolSize":40,"category":"革命时代"},{"name":"卢梭","des":"《社会契约论》与人民主权学说的提出者，法国大革命最激进的思想源头。","symbolSize":50,"category":"革命时代"},{"name":"美国独立","des":"1776年《独立宣言》建国，启蒙思想的第一次大规模落地实践。","symbolSize":40,"category":"革命时代"},{"name":"法国大革命","des":"1789年摧毁旧制度的革命，自由平等博爱响彻欧洲，近代史的分水岭。","symbolSize":70,"category":"革命时代"},{"name":"攻占巴士底狱","des":"1789年7月14日巴黎民众攻陷王家监狱，革命爆发的象征。","symbolSize":40,"category":"革命时代"},{"name":"拿破仑","des":"自革命中崛起、加冕称帝的军政强人，以征服传播革命的成果。","symbolSize":50,"category":"革命时代"},{"name":"拿破仑法典","des":"1804年颁布，确立法律面前人人平等与私有财产保护，随战火传遍欧洲。","symbolSize":40,"category":"革命时代"},{"name":"维也纳体系","des":"1815年后列强协调与均势的国际安排，维持欧洲近一个世纪无全欧大战。","symbolSize":40,"category":"革命时代"},{"name":"彼得大帝改革","des":"世纪之交的全面西化，俄罗斯以强制手段跨入欧洲强国的竞技场。","symbolSize":40,"category":"革命时代"},{"name":"工业革命","des":"十八世纪六十年代起自英国，机器代手工、工厂代作坊，近代经济增长的发令枪。","symbolSize":70,"category":"工业与帝国时代"},{"name":"珍妮纺纱机","des":"1765年哈格里夫斯的多元纺机，纺织技术革命的第一件产品。","symbolSize":40,"category":"工业与帝国时代"},{"name":"瓦特蒸汽机","des":"十八世纪七十年代分离冷凝器的改良，工厂时代的通用动力。","symbolSize":50,"category":"工业与帝国时代"},{"name":"铁路时代","des":"1825年首条运营铁路起，轨道与蒸汽编织大陆市场。","symbolSize":40,"category":"工业与帝国时代"},{"name":"城市化","des":"人口向工业城市聚集的大迁移，曼彻斯特的繁华与贫民窟的阴影并存。","symbolSize":40,"category":"工业与帝国时代"},{"name":"宪章运动","des":"十九世纪三四十年代英国工人争取普选权的请愿运动，大众政治的序曲。","symbolSize":40,"category":"工业与帝国时代"},{"name":"马克思主义","des":"马克思与恩格斯对资本主义的批判与解放纲领，工人运动的思想旗帜。","symbolSize":50,"category":"工业与帝国时代"},{"name":"1848年革命","des":"席卷欧陆的革命浪潮，民族之春失败却成为民族统一的转折点。","symbolSize":40,"category":"工业与帝国时代"},{"name":"意大利统一","des":"以撒丁王国为中心于1870年完成，亚平宁半岛民族国家的诞生。","symbolSize":40,"category":"工业与帝国时代"},{"name":"德意志统一","des":"1871年由铁血三战完成，欧洲列强格局最大的一次变局。","symbolSize":50,"category":"工业与帝国时代"},{"name":"俾斯麦","des":"设计三场王朝战争、编织同盟体系的普鲁士宰相，德意志帝国首任首相。","symbolSize":50,"category":"工业与帝国时代"},{"name":"第二次工业革命","des":"十九世纪七十年代起德美领跑的电气与内燃机时代，钢铁化工电力的飞跃。","symbolSize":40,"category":"工业与帝国时代"},{"name":"殖民扩张","des":"十九世纪末列强瓜分亚非的狂潮，世界体系完成与矛盾积累并存。","symbolSize":40,"category":"工业与帝国时代"},{"name":"同盟体系","des":"俾斯麦之后列强互保条约织成的密网，战争传导的链条。","symbolSize":40,"category":"工业与帝国时代"},{"name":"第一次世界大战","des":"1914至1918年列强总体战，四大帝国终结，欧洲文明深受重创。","symbolSize":50,"category":"世界大战与冷战"},{"name":"凡尔赛体系","des":"1919年对战败国的严厉处置与秩序重排，被称为二十年停战。","symbolSize":40,"category":"世界大战与冷战"},{"name":"国际联盟","des":"1920年成立的首个国际集体安全组织，理想主义的首次尝试与受挫。","symbolSize":40,"category":"世界大战与冷战"},{"name":"大萧条","des":"1929年爆发的世界经济危机，繁荣崩塌与政治动荡的经济根源。","symbolSize":40,"category":"世界大战与冷战"},{"name":"第二次世界大战","des":"1939至1945年由欧洲蔓延至全球的大战，近代史上最大的动荡，战后欧洲地位彻底改变。","symbolSize":50,"category":"世界大战与冷战"},{"name":"雅尔塔体系","des":"1945年战后大国安排，两极格局的秩序基础。","symbolSize":40,"category":"世界大战与冷战"},{"name":"冷战","des":"1947至1991年近半世纪的大国对峙，不诉诸直接战争的抗衡与割据。","symbolSize":50,"category":"世界大战与冷战"},{"name":"北约","des":"1949年成立的跨大西洋集体防御组织，西方阵营的硬骨架。","symbolSize":40,"category":"世界大战与冷战"},{"name":"华约","des":"1955年成立的东方阵营军事同盟，与北约对峙 counterpart，1991年解散。","symbolSize":40,"category":"世界大战与冷战"},{"name":"欧洲一体化","des":"自煤钢联营至欧盟的联合实验，欧洲对战争教训的回答。","symbolSize":50,"category":"世界大战与冷战"},{"name":"柏林墙倒塌","des":"1989年11月分隔象征的崩塌，冷战在欧洲落幕，德国统一随之而来。","symbolSize":40,"category":"世界大战与冷战"},{"name":"法学","des":"以法为对象的学问，从规范条文追问到正义根基，两千年来往返于书斋与法庭之间。","symbolSize":70,"category":"法理学基石"},{"name":"法律","des":"由国家强制保障的行为规范体系，秩序的骨架，也是正义与权力反复争夺的领地。","symbolSize":55,"category":"法理学基石"},{"name":"权利","des":"法律承认并保护的利益与自由，近代法学的中心概念，义务与责任皆以它为镜像。","symbolSize":50,"category":"法理学基石"},{"name":"义务","des":"法律课以的作为或不作为负担，与权利相生相伴，无义务则权利无所附丽。","symbolSize":40,"category":"法理学基石"},{"name":"法律责任","des":"违反义务所触发的强制后果，赔偿、惩罚与恢复的三副面孔，法之严肃所在。","symbolSize":40,"category":"法理学基石"},{"name":"法律关系","des":"主体之间依规范结成的权利义务纽带，把生活事实翻译为法律世界的语汇。","symbolSize":40,"category":"法理学基石"},{"name":"法的渊源","des":"规范效力的来处：制定法、判例、习惯与法理，法官找法时按图索骥的藏宝图。","symbolSize":40,"category":"法理学基石"},{"name":"正义","des":"各得其应得的古老训诫，法学的永恒问号，一切法哲学论战背后隐身的裁判席。","symbolSize":55,"category":"法理学基石"},{"name":"法治","des":"规则之治而非人意之治，与“法制”一字之差，隔开工具理性与价值理想。","symbolSize":55,"category":"法理学基石"},{"name":"法律解释","des":"条文与案情之间的摆渡人，文义、体系与目的诸方法在此轮番登场。","symbolSize":40,"category":"法理学基石"},{"name":"法律推理","des":"从大前提到小前提推出结论的技艺，演绎、类比与权衡轮番上阵的裁判功课。","symbolSize":40,"category":"法理学基石"},{"name":"立法","des":"把社会共识铸成规范的国家活动，法的生命起点，也是各方利益博弈的战场。","symbolSize":40,"category":"法理学基石"},{"name":"法律行为","des":"以意思表示为要素的自主设权行为，民法大厦的原子单元，法律关系的发动机。","symbolSize":40,"category":"法理学基石"},{"name":"自然法","des":"高悬于人定法之上的理性法则，权利与正义的永恒上诉法院，两千年不灭的火种。","symbolSize":60,"category":"自然法与法哲学"},{"name":"实证主义法学","des":"只问法是什么、不问法应当如何，以主权者意志与逻辑体系立学，与自然法对峙。","symbolSize":50,"category":"自然法与法哲学"},{"name":"边沁","des":"以最大多数人的最大幸福重估一切法律，法典化运动的旗手，功利主义法学开创者。","symbolSize":50,"category":"自然法与法哲学"},{"name":"功利主义","des":"苦乐计算作为立法的标尺，制度须以总福利后果论成败，法律改革的伦理引擎。","symbolSize":40,"category":"自然法与法哲学"},{"name":"奥斯丁","des":"法律命令说的奠基者，法是主权者以制裁为后盾的命令，实证主义的第一块界碑。","symbolSize":50,"category":"自然法与法哲学"},{"name":"法律命令说","des":"法即主权者的命令，违者受制裁，简洁有力，却在习惯法与授权立法前节节败退。","symbolSize":40,"category":"自然法与法哲学"},{"name":"哈特","des":"《法律的概念》作者，以承认规则取代命令模型，初级与次级规则的体系设计者。","symbolSize":55,"category":"自然法与法哲学"},{"name":"富勒","des":"法律内在道德八项要求的提出者，程序自然法的旗手，因恶法之争留名青史。","symbolSize":50,"category":"自然法与法哲学"},{"name":"德沃金","des":"认真对待权利的法哲学家，法律不止规则更有原则，权利是抗衡政策的王牌。","symbolSize":40,"category":"自然法与法哲学"},{"name":"大陆法系","des":"承罗马法余绪、以成文法典为骨的家族，从巴黎到东京，演绎推理的规范世界。","symbolSize":55,"category":"两大法系源流"},{"name":"英美法系","des":"从英格兰法庭里生长出来的判例家族，法官造法，程序优先，经验压倒逻辑。","symbolSize":55,"category":"两大法系源流"},{"name":"民法大全","des":"查士丁尼时代汇编的学说与敕令总集，千年罗马智慧的封存，也是复兴的火种。","symbolSize":50,"category":"两大法系源流"},{"name":"法典化","des":"把散乱规范熔铸成体系严整的成文法典的雄心，理性时代最盛大的立法信仰。","symbolSize":50,"category":"两大法系源流"},{"name":"德国民法典","des":"一九〇〇年生效的《德国民法典》，潘德克顿学派的巅峰，概念法学的结晶。","symbolSize":50,"category":"两大法系源流"},{"name":"普通法","des":"诺曼征服后王室法院累积的判例之网，如珊瑚礁般缓慢生长的法官造法。","symbolSize":55,"category":"两大法系源流"},{"name":"衡平法","des":"普通法僵硬处的良心补丁，大法官以衡平救济令状之穷，终成一平行体系。","symbolSize":40,"category":"两大法系源流"},{"name":"遵循先例","des":"后来的法官须受先前判决拘束，判例法的脊柱，稳定性与个案正义的平衡术。","symbolSize":50,"category":"两大法系源流"},{"name":"陪审团","des":"平民裁事实、法官适用法的分工设计，民众参与司法的古老英格兰遗产。","symbolSize":40,"category":"两大法系源流"},{"name":"令状制度","des":"没有令状就没有救济，程序形式先于实体权利，普通法形式主义的胎记。","symbolSize":40,"category":"两大法系源流"},{"name":"乌尔比安","des":"罗马五大法学家之一，公法私法之分的提出者，语录占《学说汇纂》三分之一。","symbolSize":40,"category":"两大法系源流"},{"name":"萨维尼","des":"历史法学派宗师，法是民族精神的沉静生长，与蒂堡论战并反对仓促法典化。","symbolSize":40,"category":"两大法系源流"},{"name":"历史法学派","des":"法如语言随民族生长，罗马法研究由此重焕生机，潘德克顿体系的孵化器。","symbolSize":40,"category":"两大法系源流"},{"name":"宪法","des":"规定国家权力组织与公民根本地位的最高法，法律位阶金字塔的塔尖。","symbolSize":55,"category":"宪政与公法"},{"name":"宪政","des":"以宪法约束权力的政治形态，权力驯服于规则，是法治在公法领域的完成式。","symbolSize":40,"category":"宪政与公法"},{"name":"权力分立","des":"立法、行政与司法分立制衡的设计，防止绝对权力，孟德斯鸠的传世图纸。","symbolSize":50,"category":"宪政与公法"},{"name":"违宪审查","des":"审查法律本身是否违宪的机制，宪法的牙齿，让根本法真正长出咬合力。","symbolSize":50,"category":"宪政与公法"},{"name":"马伯里诉麦迪逊","des":"一八〇三年马歇尔所判名案，最高法院赢得解释宪法并推翻法律之权的开山之作。","symbolSize":50,"category":"宪政与公法"},{"name":"基本权利","des":"宪法所保障的公民根本权利，抵抗多数决定的防线，个人对抗国家的盾牌。","symbolSize":40,"category":"宪政与公法"},{"name":"人权","des":"人之为人即应享有的权利，从自然权利到世界宣言，道德诉求的法律化身。","symbolSize":40,"category":"宪政与公法"},{"name":"平等原则","des":"相同情形相同对待、不同情形差别对待，法律面前人人平等的规范内核。","symbolSize":40,"category":"宪政与公法"},{"name":"比例原则","des":"审查公权手段是否过当的均衡术，禁止以大炮轰麻雀，公法中的帝王条款。","symbolSize":40,"category":"宪政与公法"},{"name":"依法行政","des":"行政须有法律授权并依法律而行，法无授权不可为，法治在行政领域的化身。","symbolSize":40,"category":"宪政与公法"},{"name":"行政诉讼","des":"民告官的法庭，把行政机关拖入司法审查的轨道，官民对峙的制度化场景。","symbolSize":40,"category":"宪政与公法"},{"name":"主权在民","des":"国家一切权力属于人民，公意学说的宪法化表达，现代民主合法性的总纲。","symbolSize":40,"category":"宪政与公法"},{"name":"民法","des":"调整平等主体间人身财产关系的私法，从摇篮到坟墓，日常生活的默示背景。","symbolSize":55,"category":"民法与私法自治"},{"name":"私法自治","des":"当事人依自己意思塑造法律关系，合同自由为核心，市场经济的法律灵魂。","symbolSize":50,"category":"民法与私法自治"},{"name":"民事主体","des":"权利义务的归属者，从自然人到组织的千年扩张史，法律人格的边界之争。","symbolSize":40,"category":"民法与私法自治"},{"name":"法人","des":"被法律拟制的人格，公司为其最强劲形态，有限责任重塑了整个商业世界。","symbolSize":40,"category":"民法与私法自治"},{"name":"物权","des":"对物直接支配并排除他人干涉的权利，静态财产秩序的骨架，对世权的典型。","symbolSize":50,"category":"民法与私法自治"},{"name":"所有权","des":"占有使用收益处分四权能的集大成，私产制度的法律心脏，物权体系原点。","symbolSize":40,"category":"民法与私法自治"},{"name":"债权","des":"请求特定人为特定行为的权利，动态财产流转的经纬，与物权相对而成对。","symbolSize":50,"category":"民法与私法自治"},{"name":"合同","des":"合意即法，当事人为自己立法，债权头号发生原因，私法自治的主舞台。","symbolSize":50,"category":"民法与私法自治"},{"name":"侵权责任","des":"不法侵害他人权益的赔偿之责，行为自由的边界与代价，债权第二引擎。","symbolSize":50,"category":"民法与私法自治"},{"name":"过错责任","des":"无过错即无责任，以主观可归责性定责罚，个人主义时代的民法信条。","symbolSize":40,"category":"民法与私法自治"},{"name":"无过错责任","des":"危险所在、责任所归，工业事故催生的归责新篇，企业风险的分配正义。","symbolSize":40,"category":"民法与私法自治"},{"name":"代理","des":"以他人名义行为而效果归于本人，私法自治的时空延伸，民事生活的触手。","symbolSize":40,"category":"民法与私法自治"},{"name":"婚姻继承","des":"身份法与财产法的交汇地带，从家父权到配偶平等，继承回望一生所积。","symbolSize":40,"category":"民法与私法自治"},{"name":"诚实信用","des":"行使权利履行义务须持诚信，道德入法的帝王条款，民法的弹性灵魂。","symbolSize":50,"category":"民法与私法自治"},{"name":"刑法","des":"规定犯罪与刑罚的国家法律，生杀予夺之权所在的法域，最需缰绳的猛兽。","symbolSize":55,"category":"刑法与正当程序"},{"name":"罪刑法定","des":"法无明文规定不为罪、不处罚，公民对抗国家刑罚权的堡垒，现代刑法第一原则。","symbolSize":60,"category":"刑法与正当程序"},{"name":"罪刑相适应","des":"重罪重刑、轻罪轻刑，刑罚须与罪责相称，罪刑法定原则的孪生支柱。","symbolSize":40,"category":"刑法与正当程序"},{"name":"无罪推定","des":"未经审判证明有罪之前推定其无罪，控方承担证明责任，刑事司法的度量衡。","symbolSize":50,"category":"刑法与正当程序"},{"name":"贝卡里亚","des":"《论犯罪与刑罚》的年轻作者，罪刑法定与刑罚人道化的启蒙吹哨人。","symbolSize":50,"category":"刑法与正当程序"},{"name":"正当防卫","des":"面对不法侵害的即时反击权，法不向不法让步，个人权利的自力救赎。","symbolSize":40,"category":"刑法与正当程序"},{"name":"犯罪故意","des":"明知并希望或放任结果发生的主观心态，归责的第一台阶，罪责的心核。","symbolSize":40,"category":"刑法与正当程序"},{"name":"犯罪过失","des":"应注意、能注意而不注意，疏忽与过于自信的罪责，注意义务的法律刻度。","symbolSize":40,"category":"刑法与正当程序"},{"name":"犯罪未遂","des":"已着手而未得逞的犯罪形态，主观恶性的半程证明，处罚从宽的理由所在。","symbolSize":40,"category":"刑法与正当程序"},{"name":"刑事诉讼","des":"国家追诉犯罪的程序剧场，惩罚犯罪与保障人权的拉锯场，宪法的安全阀。","symbolSize":50,"category":"刑法与正当程序"},{"name":"民事诉讼","des":"平等主体对簿公堂解决私权之争，不告不理，辩论主义主导的裁判空间。","symbolSize":40,"category":"刑法与正当程序"},{"name":"证据","des":"诉讼的燃料，裁判事实认定的唯一凭据，举证之所在、败诉之所在的竞技场。","symbolSize":40,"category":"刑法与正当程序"},{"name":"正当程序","des":"程序本身即是正义，剥夺权利须经正当过程，英美法最响亮的宪政口号。","symbolSize":55,"category":"刑法与正当程序"},{"name":"米兰达规则","des":"你有权保持沉默，羁押讯问前的权利告知，正当程序原则最著名的台词。","symbolSize":40,"category":"刑法与正当程序"},{"name":"司法独立","des":"法官依法律独立审判，以任期与薪酬保障免受干预，法治的组织基石。","symbolSize":50,"category":"刑法与正当程序"},{"name":"辩护权","des":"被告人申辩并获得帮助的权利，对抗指控的盾牌，控辩平等的制度支点。","symbolSize":40,"category":"刑法与正当程序"}],"links":[{"source":"希腊城邦","target":"雅典民主","name":"孕育","des":"城邦小国寡民的规模是直接民主的前提。"},{"source":"梭伦改革","target":"雅典民主","name":"奠基","des":"解负令与等级权利开启公民参政传统。"},{"source":"伯里克利","target":"雅典民主","name":"完善","des":"公民大会与陪审法庭全速运转，民主的黄金时代。"},{"source":"伯罗奔尼撒战争","target":"希腊城邦","name":"削弱","des":"二十七年拉锯耗尽各邦，为马其顿崛起让路。"},{"source":"伯罗奔尼撒战争","target":"雅典民主","name":"动摇","des":"战败与寡头政变交替冲击民主秩序。"},{"source":"希腊城邦","target":"罗马共和国","name":"滋养","des":"希腊政治思想为罗马早期制度提供养分。"},{"source":"亚历山大帝国","target":"希腊化时代","name":"开启","des":"东征之后希腊与东方文明大交融。"},{"source":"希腊化时代","target":"罗马帝国","name":"汇入","des":"罗马逐步吸纳希腊化诸国并继承其学统。"},{"source":"布匿战争","target":"罗马共和国","name":"成就霸业"