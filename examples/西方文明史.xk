,"target":"华约","name":"催生","des":"东方阵营对应结盟。"},{"source":"北约","target":"华约","name":"对峙","des":"两大集团相向而立，欧洲一分为二。"},{"source":"冷战","target":"欧洲一体化","name":"倒逼","des":"两极压力使西欧联合图强。"},{"source":"第二次世界大战","target":"欧洲一体化","name":"催生","des":"绝不再战是一体化的初衷。"},{"source":"华约","target":"柏林墙倒塌","name":"伴生","des":"东方阵营体系自内部松动。"},{"source":"柏林墙倒塌","target":"冷战","name":"终结","des":"分隔象征崩塌，对峙落幕。"},{"source":"柏林墙倒塌","target":"欧洲一体化","name":"推进","des":"德国统一推动一体化扩至全欧。"},{"source":"印刷革命","target":"启蒙运动","name":"铺垫","des":"印刷书使思想大规模传播成为可能。"},{"source":"法学","target":"法律","name":"研析","des":"以法为对象，从条文之学进于正义之学。"},{"source":"权利","target":"法律","name":"派生","des":"权利由法确认保障，又反身成为法的价值目标。"},{"source":"义务","target":"权利","name":"相对","des":"互为表里，结构上等值而方向相反。"},{"source":"法律责任","target":"义务","name":"担保","des":"违反义务即触发责任，强制其履行。"},{"source":"权利","target":"法律关系","name":"构成","des":"权利义务的纽带编织成法律关系的经纬。"},{"source":"法律行为","target":"法律关系","name":"变动","des":"以意思表示设立、变更与消灭法律关系。"},{"source":"法的渊源","target":"法律","name":"出处","des":"规范效力自此寻根，效力与位阶之所据。"},{"source":"正义","target":"法律","name":"评价","des":"一切法都须接受正义的拷问，方称良法。"},{"source":"法律","target":"法治","name":"归旨","des":"法的目标状态即法治，规则统治而非人意。"},{"source":"法律解释","target":"法律","name":"适用","des":"摆渡于条文与案情之间，法现实化的工序。"},{"source":"法律推理","target":"法律解释","name":"延伸","des":"解释之后尚须推理，结论在论证中成形。"},{"source":"立法","target":"法律","name":"创制","des":"立法者铸造规范，法的生命自此起步。"},{"source":"立法","target":"法的渊源","name":"注入","des":"制定法为最重要渊源，成文传统的支柱。"},{"source":"法学","target":"正义","name":"叩问","des":"正义是法学永恒的乡愁与终极试金石。"},{"source":"法学","target":"法治","name":"致思","des":"从治理之术到规则之治，指向良法善治。"},{"source":"权利","target":"基本权利","name":"入宪","des":"基本权利是权利经宪法确认的形态。"},{"source":"遵循先例","target":"法的渊源","name":"充任","des":"判例经先例拘束原则跻身正式法源。"},{"source":"功利主义","target":"正义","name":"挑战","des":"最大幸福对分配正义发起功利拷问。"},{"source":"民事主体","target":"法律关系","name":"充当","des":"主体是法律关系的第一要素，权利所归。"},{"source":"侵权责任","target":"法律责任","name":"类型","des":"民事责任是法律责任三大类型之一。"},{"source":"诚实信用","target":"法律解释","name":"补给","des":"帝王条款为解释方法注入价值判断。"},{"source":"自然法","target":"法学","name":"滋养","des":"自然法学说是西方法学两千年的主流血脉。"},{"source":"自然法","target":"正义","name":"安放","des":"为正义寻找先于实在法的理性根基。"},{"source":"实证主义法学","target":"自然法","name":"论战","des":"法是什么与法应是什么，分离命题的攻防。"},{"source":"哈特","target":"实证主义法学","name":"修正","des":"以承认规则重述实证主义，转趋柔性。"},{"source":"奥斯丁","target":"实证主义法学","name":"开创","des":"命令说立起实证主义的第一块界石。"},{"source":"奥斯丁","target":"法律命令说","name":"提出","des":"法是主权者以制裁为后盾的命令。"},{"source":"哈特","target":"法律命令说","name":"批判","des":"承认规则与次级规则取代命令模型。"},{"source":"边沁","target":"功利主义","name":"创立","des":"以苦乐计算重估法律，立法科学化宣言。"},{"source":"边沁","target":"奥斯丁","name":"师承","des":"功利原则被改铸为分析实证的体系。"},{"source":"边沁","target":"法典化","name":"推动","des":"痛斥普通话驳杂，力主全面法典化。"},{"source":"孟德斯鸠","target":"权力分立","name":"设计","des":"三权分立以防专制，自由的制度屏障。"},{"source":"富勒","target":"自然法","name":"复兴","des":"以内在道德八原则重续自然法香火。"},{"source":"富勒","target":"实证主义法学","name":"论战","des":"法律的道德性不容价值中立的退让。"},{"source":"哈特","target":"富勒","name":"论战","des":"纳粹恶法是否法，战后最著名的笔战。"},{"source":"德沃金","target":"哈特","name":"批判","des":"以整全法回击规则模式，原则入法。"},{"source":"德沃金","target":"权利","name":"重申","des":"权利是抗衡政策的王牌，须认真对待。"},{"source":"自然法","target":"人权","name":"奠基","des":"先于国家的权利，人权的哲学出身。"},{"source":"卢梭","target":"主权在民","name":"提出","des":"公意学说为人民主权奠定理论基调。"},{"source":"罗马法","target":"大陆法系","name":"承续","des":"法典传统与概念体系皆直承罗马法。"},{"source":"民法大全","target":"罗马法","name":"集成","des":"查士丁尼把千年罗马法封存为总集。"},{"source":"民法大全","target":"拿破仑法典","name":"滋养","des":"注释法学派唤醒的罗马文本化为法典血肉。"},{"source":"拿破仑法典","target":"德国民法典","name":"对照","des":"革命色调对学理深功，两代法典双峰并峙。"},{"source":"法典化","target":"拿破仑法典","name":"开山","des":"一八〇四年法典令法典化理想首次落地。"},{"source":"法典化","target":"德国民法典","name":"收官","des":"五编制与概念金字塔，法典化的巅峰。"},{"source":"萨维尼","target":"历史法学派","name":"创立","des":"主张法是民族精神的沉静自然生长。"},{"source":"萨维尼","target":"法典化","name":"论战","des":"与蒂堡笔战：民族未熟，不宜仓促成典。"},{"source":"历史法学派","target":"德国民法典","name":"孕育","des":"潘德克顿学理终成德民的体系骨架。"},{"source":"大陆法系","target":"法典化","name":"崇尚","des":"成文法典与演绎推理是它的徽章。"},{"source":"普通法","target":"英美法系","name":"构成","des":"普通法是英美法系的躯干与源头。"},{"source":"衡平法","target":"普通法","name":"补济","des":"良心法院补普通法之穷，两河并流。"},{"source":"遵循先例","target":"普通法","name":"支撑","des":"先例拘束让判例积累为法律本体。"},{"source":"遵循先例","target":"英美法系","name":"标识","des":"判例法方法是与法典法分道的旗帜。"},{"source":"大陆法系","target":"英美法系","name":"对照","des":"法典对判例、演绎对类比的双生镜像。"},{"source":"令状制度","target":"普通法","name":"塑形","des":"程式诉讼塑造了普通法的程序性格。"},{"source":"陪审团","target":"英美法系","name":"传统","des":"平民裁事实，参与司法的英伦遗产。"},{"source":"陪审团","target":"正当程序","name":"体现于","des":"陪审审判是正当程序的古老形态。"},{"source":"乌尔比安","target":"罗马法","name":"诠释","des":"公私法之分与诚信原则的罗马源头。"},{"source":"拿破仑法典","target":"民法","name":"立范","des":"近代民法典范，私法自治的成文表达。"},{"source":"德国民法典","target":"民法","name":"精雕","des":"概念体系登峰造极的二十世纪私法典。"},{"source":"民法大全","target":"法学","name":"传灯","des":"罗马法文本哺育博洛尼亚以降的法学。"},{"source":"历史法学派","target":"罗马法","name":"研习","des":"萨维尼学派以罗马法锻造概念工具。"},{"source":"民法","target":"罗马法","name":"认祖","des":"私法的概念谱系可以上溯到罗马法。"},{"source":"衡平法","target":"诚实信用","name":"灌注","des":"大法官的良心注入民法的帝王条款。"},{"source":"宪法","target":"法治","name":"深化","des":"法治的最高形态，是落实于宪法的统治。"},{"source":"权力分立","target":"宪法","name":"入典","des":"分立制衡是成文宪法的标准配置。"},{"source":"违宪审查","target":"宪法","name":"守护","des":"审查机制让根本法长出咬合的牙齿。"},{"source":"马伯里诉麦迪逊","target":"违宪审查","name":"确立","des":"马歇尔以此案为司法审查奠基开山。"},{"source":"基本权利","target":"宪法","name":"构成","des":"基本权利是宪法的核心与出发点。"},{"source":"人权","target":"基本权利","name":"入宪","des":"人权经宪法确认化为基本权利目录。"},{"source":"主权在民","target":"宪法","name":"奠基","des":"人民主权是现代宪法的合法性来源。"},{"source":"宪法","target":"宪政","name":"践行","des":"宪法从文本走向现实的统治即宪政。"},{"source":"法治","target":"宪政","name":"贯通","des":"公法之治与私法之治在宪政处汇流。"},{"source":"平等原则","target":"基本权利","name":"列首","des":"平等原则居于基本权利体系之首。"},{"source":"比例原则","target":"依法行政","name":"标尺","des":"行政手段须过比例原则的审查关。"},{"source":"依法行政","target":"法治","name":"体现于","des":"法无授权不可为，行政领域的法治。"},{"source":"行政诉讼","target":"依法行政","name":"保障","des":"民告官的法庭倒逼行政机关守法。"},{"source":"违宪审查","target":"司法独立","name":"依托","des":"审查权的行使以审判独立为前提。"},{"source":"司法独立","target":"法治","name":"支柱","des":"法官只服从法律，法治的组织底线。"},{"source":"违宪审查","target":"英美法系","name":"原生","des":"分散审查模式生于普通法的土壤。"},{"source":"大陆法系","target":"违宪审查","name":"另设","des":"欧陆另立宪法法院集中行使审查。"},{"source":"平等原则","target":"正义","name":"派生","des":"形式平等是正义最古老的面相之一。"},{"source":"司法独立","target":"权力分立","name":"一足","des":"司法权独立是三分格局中的一极。"},{"source":"民法","target":"法学","name":"重镇","des":"私法学问号称法学界的半壁江山。"},{"source":"民法","target":"私法自治","name":"内核","des":"平等主体依自己意思塑造法律关系。"},{"source":"合同","target":"私法自治","name":"体现于","des":"契约自由是私法自治最亮的旗帜。"},{"source":"代理","target":"私法自治","name":"延伸","des":"意思力的时空扩展，自治的延长线。"},{"source":"债权","target":"物权","name":"相对","des":"对世支配对人情请求，财产法双雄。"},{"source":"所有权","target":"物权","name":"原型","des":"完整物权的范本，四权能的集大成。"},{"source":"合同","target":"债权","name":"发生","des":"合同之债是债权的第一发生原因。"},{"source":"侵权责任","target":"债权","name":"发生","des":"侵权之债与合同之债同为债之双辕。"},{"source":"过错责任","target":"侵权责任","name":"原则","des":"过错是归责门槛，自由与安全之衡。"},{"source":"无过错责任","target":"过错责任","name":"修正","des":"工业化风险撕开过错归责的缺口。"},{"source":"无过错责任","target":"侵权责任","name":"并列","des":"危险责任与过错责任如双轨并行。"},{"source":"诚实信用","target":"合同","name":"君临","des":"帝王条款贯穿合同订立履行全程。"},{"source":"婚姻继承","target":"民法","name":"归属","des":"身份与财产交汇的亲属继承两编。"},{"source":"法人","target":"民事主体","name":"扩张","des":"组织取得人格，主体制度大扩容。"},{"source":"合同","target":"法律行为","name":"典型","des":"合同是法律行为中最典型的形态。"},{"source":"刑法","target":"法学","name":"锋刃","des":"刑罚权是国家最锋利的强制之力。"},{"source":"罪刑法定","target":"刑法","name":"铁则","des":"法无明文不为罪，刑罚权的缰绳。"},{"source":"罪刑相适应","target":"罪刑法定","name":"配套","des":"罪与刑相称，法定之外的第二约束。"},{"source":"无罪推定","target":"罪刑法定","name":"呼应","des":"实体上的法定与程序上的推定互为表里。"},{"source":"贝卡里亚","target":"罪刑法定","name":"奠基","des":"一七六四年小册子立起原则基石。"},{"source":"贝卡里亚","target":"罪刑相适应","name":"提出","des":"罪刑相称、刑罚宽和，反对酷刑。"},{"source":"贝卡里亚","target":"无罪推定","name":"启发","des":"启蒙小册子为程序原则供给思想。"},{"source":"正当防卫","target":"刑法","name":"正当化","des":"违法阻却事由，法不向不法低头。"},{"source":"犯罪故意","target":"刑法","name":"归责","des":"主观罪过是刑事责任的心理门槛。"},{"source":"犯罪过失","target":"犯罪故意","name":"对照","des":"明知对不注意，罪责两级的心证。"},{"source":"犯罪未遂","target":"犯罪故意","name":"依托","des":"未遂的归责以既遂的故意为前提。"},{"source":"犯罪未遂","target":"罪刑相适应","name":"检验","des":"是否得逞分层罪责，牵动刑罚轻重。"},{"source":"刑事诉讼","target":"刑法","name":"实现","des":"无程序则无刑罚，刑法凭程序而动。"},{"source":"无罪推定","target":"刑事诉讼","name":"基石","des":"控方承担证明，疑罪从无的出发点。"},{"source":"证据","target":"刑事诉讼","name":"燃料","des":"证据裁判主义是刑事审判生死线。"},{"source":"证据","target":"民事诉讼","name":"共用","des":"谁主张谁举证，私权之争的法则。"},{"source":"民事诉讼","target":"民法","name":"保障","des":"私权之争终须法庭程序给出出口。"},{"source":"正当程序","target":"刑事诉讼","name":"统摄","des":"正当程序是刑事诉讼的帝王原则。"},{"source":"米兰达规则","target":"正当程序","name":"体现于","des":"沉默权告知，程序正义的著名台词。"},{"source":"米兰达规则","target":"证据","name":"排除","des":"违反告知的供述或被排除于庭外。"},{"source":"辩护权","target":"刑事诉讼","name":"支柱","des":"辩护席是控辩平等对抗的制度支点。"},{"source":"辩护权","target":"基本权利","name":"入宪","des":"获得辩护被抬升至宪法位阶保障。"},{"source":"正当程序","target":"英美法系","name":"溯源","des":"自大宪章条款长出的程序法传统。"},{"source":"正当防卫","target":"权利","name":"自力","des":"公力救济不及之处的自力反击权。"}],"title":"西方文明史","description":"从爱琴海城邦到冷战落幕，历史、哲学与法律交织的西方文明因果网络。"}