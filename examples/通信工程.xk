{"version":2,"nodes":[{"name":"通信工程","des":"把信息装进信号送到远方的系统工程：从一根电报线到全球无线互联的百年长跑。","symbolSize":70,"category":"基础理论"},{"name":"信号","des":"随时间变化的电压或场强，一切信息的物理载体。","symbolSize":50,"category":"基础理论"},{"name":"频谱","des":"频率从低到高的全谱段，无线电管理最稀缺的国有资源。","symbolSize":50,"category":"基础理论"},{"name":"傅里叶分析","des":"任何信号都可拆成正弦波之和，频域视角是通信的通用语言。","symbolSize":50,"category":"基础理论"},{"name":"带宽","des":"信道能通过的频率范围，信息高速公路的车道数。","symbolSize":50,"category":"基础理论"},{"name":"采样定理","des":"奈奎斯特：采样率超过信号带宽两倍，模拟信号即可完美数字化。","symbolSize":50,"category":"基础理论"},{"name":"噪声","des":"热噪声、干扰与散粒噪声，通信工程师永远的对手。","symbolSize":40,"category":"基础理论"},{"name":"信噪比","des":"信号与噪声功率之比，分贝世界里衡量链路质量的体温计。","symbolSize":40,"category":"基础理论"},{"name":"信道","des":"从双绞线到自由空间，信号经过的一切路径统称。","symbolSize":40,"category":"基础理论"},{"name":"多径衰落","des":"信号经反射多路抵达彼此干涉，无线信道起伏不定的元凶。","symbolSize":40,"category":"基础理论"},{"name":"香农","des":"信息论之父，一篇 1948 年论文为整个数字时代奠基。","symbolSize":40,"category":"基础理论"},{"name":"香农定理","des":"信道容量 C=B·log₂(1+S/N)：带宽与信噪比框定了传输速率的天花板。","symbolSize":70,"category":"基础理论"},{"name":"信息熵","des":"消息不确定性的度量，信息可以被精确称量的惊人思想。","symbolSize":50,"category":"基础理论"},{"name":"分贝","des":"对数刻度的放大镜，把悬殊的功率比值压缩成顺手的整数。","symbolSize":40,"category":"基础理论"},{"name":"信源编码","des":"压缩冗余，用最少的比特表达原始信息，熵是它的极限。","symbolSize":50,"category":"信源编码"},{"name":"量化","des":"连续幅度离散化，从模拟到数字必经的失真之门。","symbolSize":40,"category":"信源编码"},{"name":"PCM","des":"脉冲编码调制：采样量化编码三步走，一路电话 64kbps 的标准答案。","symbolSize":40,"category":"信源编码"},{"name":"霍夫曼编码","des":"高频符号短码、低频符号长码，变长编码的经典。","symbolSize":40,"category":"信源编码"},{"name":"算术编码","des":"整条消息编码成一个小数，逼近熵极限的压缩术。","symbolSize":40,"category":"信源编码"},{"name":"语音编码","des":"从波形编码到参数编码，一路电话从 64k 压到几 k。","symbolSize":40,"category":"信源编码"},{"name":"视频编码","des":"帧间预测加变换量化，H.264 与 HEVC 让流媒体时代成为可能。","symbolSize":40,"category":"信源编码"},{"name":"冗余度","des":"消息里可压缩的水分，信息论与压缩算法的中间地带。","symbolSize":40,"category":"信源编码"},{"name":"信道编码","des":"主动添加冗余换取纠错能力，与信源编码相反方向的智慧。","symbolSize":50,"category":"信道与编码"},{"name":"差错控制","des":"检错与纠错的统称：发现错误重传，或直接算出正确答案。","symbolSize":40,"category":"信道与编码"},{"name":"奇偶校验","des":"附加一位让 1 的个数凑偶，最便宜的检错手段。","symbolSize":40,"category":"信道与编码"},{"name":"汉明码","des":"不仅能发现还能定位单比特错误，纠错码的启蒙。","symbolSize":40,"category":"信道与编码"},{"name":"卷积码","des":"滑窗式编码，配合维特比译码统治深空通信三十年。","symbolSize":40,"category":"信道与编码"},{"name":"Turbo码","des":"两个卷积码迭代互译，逼近香农极限 0.5dB 的 1993 年惊雷。","symbolSize":40,"category":"信道与编码"},{"name":"LDPC码","des":"稀疏校验矩阵的并行译码，5G 数据信道的最终选择。","symbolSize":40,"category":"信道与编码"},{"name":"极化码","des":"阿里坎的构造：把信道极化成无噪与全噪，5G 短码标准。","symbolSize":40,"category":"信道与编码"},{"name":"交织","des":"打乱比特顺序把突发错误摊成零散错误，纠错码的排兵布阵。","symbolSize":40,"category":"信道与编码"},{"name":"ARQ","des":"自动重传请求：错了就重发，可靠性的老实人方案。","symbolSize":40,"category":"信道与编码"},{"name":"HARQ","des":"重传与前向纠错合体，存下坏包与新包软合并，5G 的标配。","symbolSize":40,"category":"信道与编码"},{"name":"调制","des":"把基带信号搬到载波上的搬家术，高频天线才发得出去。","symbolSize":50,"category":"调制技术"},{"name":"调幅","des":"载波幅度随消息起伏，收音机中波的经典广播制式。","symbolSize":40,"category":"调制技术"},{"name":"调频","des":"载波频率随消息偏移，抗幅度噪声的更优广播。","symbolSize":40,"category":"调制技术"},{"name":"QAM","des":"幅相联合调制，一个符号携带多比特，Wi-Fi 与 5G 的主力星座。","symbolSize":50,"category":"调制技术"},{"name":"星座图","des":"符号在幅相平面的分布点阵，调制方式的显微镜。","symbolSize":40,"category":"调制技术"},{"name":"OFDM","des":"把宽带切成成百上千正交子载波，对抗多径衰落的现代无线基石。","symbolSize":50,"category":"调制技术"},{"name":"多址接入","des":"让多用户共享同一频谱：FDMA、TDMA、CDMA 到 OFDMA 的接力。","symbolSize":50,"category":"调制技术"},{"name":"CDMA","des":"码分多址：不同用户用正交扩频码同频共道，3G 的主角。","symbolSize":40,"category":"调制技术"},{"name":"扩频","des":"用带宽换鲁棒的艺术，信号摊薄在宽频带上反而更抗干扰更保密。","symbolSize":40,"category":"调制技术"},{"name":"跳频","des":"载波按伪随机序列跳变，影星海蒂·拉玛的传世发明。","symbolSize":40,"category":"调制技术"},{"name":"MIMO","des":"多天线并行收发空间流，不增加带宽的容量倍增器。","symbolSize":50,"category":"调制技术"},{"name":"波束赋形","des":"多天线相位协同把能量聚成定向波束，5G 毫米波的必修课。","symbolSize":40,"category":"调制技术"},{"name":"双绞线","des":"两根绞在一起的铜线，电话线与以太网的百年老兵。","symbolSize":40,"category":"传输介质"},{"name":"同轴电缆","des":"屏蔽层包裹的铜芯，有线电视与早期局域网的血管。","symbolSize":40,"category":"传输介质"},{"name":"光纤","des":"全反射困住光束的玻璃丝，容量近乎无限的传输主干。","symbolSize":50,"category":"传输介质"},{"name":"海底光缆","des":"铺遍洋底的洲际光纤，全球互联网 99% 流量的沉默通道。","symbolSize":40,"category":"传输介质"},{"name":"微波中继","des":"视距接力的高频无线电，地形复杂地区的干线补网。","symbolSize":40,"category":"传输介质"},{"name":"卫星通信","des":"轨道上的中继站，从同步轨道到低轨星座的接力革命。","symbolSize":40,"category":"传输介质"},{"name":"天线","des":"把电路里的振荡抛向空间的换能器，麦克斯韦方程的接口。","symbolSize":50,"category":"传输介质"},{"name":"自由空间损耗","des":"电磁波球面扩散的能量稀释，距离是链路预算的头号杀手。","symbolSize":40,"category":"传输介质"},{"name":"蜂窝网络","des":"把覆盖切成小区频率复用，移动通信的空间智慧。","symbolSize":50,"category":"蜂窝演进"},{"name":"切换","des":"用户跨小区时通话无缝移交，移动性的核心技术。","symbolSize":40,"category":"蜂窝演进"},{"name":"1G","des":"模拟调频的语音时代，大哥大与砖头手机。","symbolSize":40,"category":"蜂窝演进"},{"name":"2G","des":"GSM 数字化：短信诞生、SIM 卡问世，手机变为人手一部。","symbolSize":40,"category":"蜂窝演进"},{"name":"3G","des":"CDMA 驱动移动上网，2007 年 iPhone 接过了接力棒。","symbolSize":40,"category":"蜂窝演进"},{"name":"4G","des":"LTE 全 IP 化，OFDM 加 MIMO 撑起移动互联网与短视频。","symbolSize":40,"category":"蜂窝演进"},{"name":"5G","des":"三大场景：eMBB 大带宽、URLLC 低时延、mMTC 海量连接。","symbolSize":50,"category":"蜂窝演进"},{"name":"毫米波","des":"24GHz 以上频段，带宽豪奢但覆盖娇气，城市热点专用。","symbolSize":40,"category":"蜂窝演进"},{"name":"网络切片","des":"一张物理网切成多个虚拟专网，5G 面向行业的卖点。","symbolSize":40,"category":"蜂窝演进"},{"name":"6G","des":"太赫兹、星地融合与通感一体：2030 年代的候选答卷。","symbolSize":40,"category":"蜂窝演进"},{"name":"移动通信标准化","des":"从 ITU 到 3GPP，全球厂商逐条争稿的马拉松谈判。","symbolSize":40,"category":"蜂窝演进"},{"name":"电路交换","des":"先建专线再通话，电话网一百年的经典模式。","symbolSize":40,"category":"网络交换"},{"name":"分组交换","des":"消息切成包独立路由，互联网之父们的激进选择。","symbolSize":50,"category":"网络交换"},{"name":"路由","des":"为每个分组选下一跳，分布式选路的智力核心。","symbolSize":40,"category":"网络交换"},{"name":"多路复用","des":"FDM、TDM 与 WDM：让一条物理线路承载成千上万路信号。","symbolSize":50,"category":"网络交换"},{"name":"拥塞控制","des":"网络堵车时的减速礼让，TCP 的看家本领。","symbolSize":40,"category":"网络交换"},{"name":"OSI模型","des":"七层抽象塔，通信协议世界的行政区划图。","symbolSize":40,"category":"网络交换"},{"name":"互联网","des":"全球分组交换网络的互联互通，通信工程最大的作品。","symbolSize":50,"category":"网络交换"}],"links":[{"source":"通信工程","target":"香农定理","name":"圣经","des":"一切通信系统设计都活在这条定理划定的边界内。"},{"source":"通信工程","target":"频谱","name":"命根","des":"无线通信争夺的根本资源。"},{"source":"通信工程","target":"蜂窝网络","name":"空间组织","des":"把无限需求装进有限频谱的几何智慧。"},{"source":"通信工程","target":"OSI模型","name":"思维地图","des":"分层抽象让复杂系统可以被谈论。"},{"source":"通信工程","target":"互联网","name":"最大作品","des":"百年通信技术长跑的集大成。"},{"source":"信号","target":"傅里叶分析","name":"拆解为","des":"时域波形与频域谱线是同一枚硬币的两面。"},{"source":"傅里叶分析","target":"频谱","name":"张成","des":"正弦波分量按频率排开便是频谱。"},{"source":"频谱","target":"带宽","name":"划出","des":"许可频段的可用来就是带宽。"},{"source":"信号","target":"采样定理","name":"数字化","des":"采样定理是模拟与数字世界的边界契约。"},{"source":"噪声","target":"信噪比","name":"对比出","des":"有噪声才有信噪比，工程质量的量化起点。"},{"source":"分贝","target":"信噪比","name":"标定","des":"对数刻度让十亿倍功率比变成顺手的分贝数。"},{"source":"带宽","target":"香农定理","name":"代入","des":"容量随带宽线性增长。"},{"source":"信噪比","target":"香农定理","name":"代入","des":"容量随信噪比对数增长，安静比宽带更值钱。"},{"source":"香农","target":"香农定理","name":"提出","des":"1948 年一篇论文奠定信息论。"},{"source":"香农","target":"信息熵","name":"度量","des":"给信息称重的数学起点。"},{"source":"多径衰落","target":"信噪比","name":"拉低","des":"深衰落瞬间信号骤降，误码随之飙升。"},{"source":"信道","target":"香农定理","name":"受审于","des":"任何信道都被容量公式判了上限。"},{"source":"信息熵","target":"信源编码","name":"极限于","des":"无损压缩不可能低于熵。"},{"source":"信源编码","target":"信道编码","name":"反向于","des":"一个删冗余、一个加冗余，方向相反却同宗同源。"},{"source":"量化","target":"PCM","name":"组成","des":"采样、量化、编码三步走。"},{"source":"PCM","target":"语音编码","name":"起步于","des":"64kbps 一路电话是数字化通信的原点。"},{"source":"霍夫曼编码","target":"信源编码","name":"属于","des":"统计编码的经典解法。"},{"source":"算术编码","target":"霍夫曼编码","name":"逼近超越","des":"整条消息一个小数，比逐符号编码更贴熵。"},{"source":"视频编码","target":"冗余度","name":"猎杀","des":"时间、空间与统计冗余一网打尽。"},{"source":"冗余度","target":"信息熵","name":"度量于","des":"水分多少，熵说了算。"},{"source":"信道编码","target":"差错控制","name":"属于","des":"前向纠错是差错控制的主动出击。"},{"source":"差错控制","target":"ARQ","name":"包含","des":"重传是最朴素的差错控制。"},{"source":"ARQ","target":"HARQ","name":"合体成","des":"重传加软合并，效率倍增。"},{"source":"奇偶校验","target":"汉明码","name":"升级为","des":"从只能发现到能定位并纠正。"},{"source":"汉明码","target":"信道编码","name":"开创","des":"1948 年起的纠错码启蒙。"},{"source":"卷积码","target":"Turbo码","name":"进化出","des":"迭代译码思想让逼近极限成为可能。"},{"source":"Turbo码","target":"香农定理","name":"逼近","des":"距理论极限仅 0.5dB。"},{"source":"LDPC码","target":"香农定理","name":"逼近","des":"稀疏图译码同样贴着极限飞。"},{"source":"LDPC码","target":"5G","name":"入选","des":"5G 数据信道的长码方案。"},{"source":"极化码","target":"5G","name":"入选","des":"5G 控制信道的短码方案。"},{"source":"交织","target":"信道编码","name":"配合","des":"把突发错误摊薄成纠错码力所能及的零散错误。"},{"source":"HARQ","target":"5G","name":"标配于","des":"物理层重传机制的底座。"},{"source":"调制","target":"调幅","name":"始于","des":"马可尼时代最古老的搬法。"},{"source":"调幅","target":"调频","name":"对照","des":"一个改幅度一个改频率，抗噪能力天差地别。"},{"source":"QAM","target":"星座图","name":"画成","des":"幅相平面的点阵即星座。"},{"source":"星座图","target":"信噪比","name":"受评于","des":"噪声越大，星座点越糊。"},{"source":"OFDM","target":"多径衰落","name":"对抗","des":"子载波窄到信道近似平坦，多径无从作乱。"},{"source":"OFDM","target":"多址接入","name":"升级为","des":"OFDMA 把子载波分给不同用户。"},{"source":"多址接入","target":"CDMA","name":"包含","des":"码分是第三代的多址答案。"},{"source":"CDMA","target":"扩频","name":"基于","des":"正交扩频码是共道不扰的秘密。"},{"source":"扩频","target":"跳频","name":"分支","des":"直接序列与跳频两大流派。"},{"source":"MIMO","target":"OFDM","name":"搭档","des":"空时与频域结合，现代无线的黄金组合。"},{"source":"波束赋形","target":"MIMO","name":"依托","des":"大规模天线阵列的相控阵运用。"},{"source":"天线","target":"信号","name":"收发","des":"电磁波与电路电流的互相翻译。"},{"source":"双绞线","target":"同轴电缆","name":"对照","des":"绞线抗干扰，同轴靠屏蔽，各有各的护法。"},{"source":"光纤","target":"海底光缆","name":"铺成","des":"跨洋通信的主动脉。"},{"source":"海底光缆","target":"多路复用","name":"依赖","des":"波分复用让一根纤芯跑几十路波长。"},{"source":"卫星通信","target":"蜂窝网络","name":"对照","des":"一个以覆盖见长，一个以容量见长。"},{"source":"自由空间损耗","target":"毫米波","name":"惩罚","des":"频率越高衰减越狠，毫米波必须靠波束赋形续命。"},{"source":"波束赋形","target":"毫米波","name":"补救","des":"能量聚束弥补覆盖短板。"},{"source":"蜂窝网络","target":"频谱","name":"复用","des":"隔一个小区就能重复使用同一频率。"},{"source":"切换","target":"蜂窝网络","name":"发生于","des":"跨小区的无缝移交是移动性的关键。"},{"source":"1G","target":"调频","name":"基于","des":"模拟调频承载语音。"},{"source":"1G","target":"2G","name":"让位给","des":"数字化的碾压式进步。"},{"source":"2G","target":"多址接入","name":"采用","des":"GSM 用 TDMA 加 FDD。"},{"source":"2G","target":"电路交换","name":"生于","des":"GSM 语音仍在电路域。"},{"source":"2G","target":"3G","name":"演进为","des":"数据业务驱动下一代。"},{"source":"3G","target":"CDMA","name":"基于","des":"码分多址承载移动上网。"},{"source":"3G","target":"4G","name":"演进为","des":"全 IP 化的必然方向。"},{"source":"4G","target":"OFDM","name":"调制于","des":"LTE 的空口基石。"},{"source":"4G","target":"MIMO","name":"装备","des":"多天线成倍扩容。"},{"source":"4G","target":"分组交换","name":"全跑在","des":"语音也成了数据流。"},{"source":"4G","target":"5G","name":"演进为","des":"从消费互联网走向产业互联网。"},{"source":"5G","target":"毫米波","name":"启用","des":"大带宽场景的豪奢频段。"},{"source":"5G","target":"网络切片","name":"主打","des":"面向行业的虚拟专网。"},{"source":"5G","target":"6G","name":"接棒","des":"太赫兹与星地融合的前瞻竞赛。"},{"source":"移动通信标准化","target":"5G","name":"产出","des":"3GPP 一版一版冻结的全球共识。"},{"source":"移动通信标准化","target":"4G","name":"产出","des":"LTE 标准化的协作典范。"},{"source":"电路交换","target":"分组交换","name":"让位于","des":"统计复用胜过独占线路。"},{"source":"分组交换","target":"互联网","name":"支撑","des":"无连接分组网络长成全球互联网。"},{"source":"路由","target":"互联网","name":"运行于","des":"分布式选路是互联网的神经系统。"},{"source":"拥塞控制","target":"互联网","name":"守护","des":"端到端的退让机制防止崩溃。"},{"source":"多路复用","target":"带宽","name":"切分","des":"时间、频率与波长都是切分维度。"},{"source":"OSI模型","target":"通信工程","name":"刻画","des":"七层地图让人各司其职。"},{"source":"微波中继","target":"天线","name":"依仗","des":"视距接力全靠定向抛物面天线相传。"},{"source":"傅里叶分析","target":"OFDM","name":"正交","des":"子载波正交性是傅里叶级数的直接应用。"},{"source":"带宽","target":"OFDM","name":"花在","des":"OFDM 把整段带宽切成并行窄带。"},{"source":"信道","target":"多径衰落","name":"充满","des":"无线信道的本质麻烦是多径。"},{"source":"信噪比","target":"QAM","name":"决定","des":"信噪比越高星座点可以摆得越密。"},{"source":"调制","target":"天线","name":"交给","des":"已调信号最终由天线辐射出去。"},{"source":"香农定理","target":"信源编码","name":"指导","des":"熵给出压缩的下界。"},{"source":"香农定理","target":"信道编码","name":"指导","des":"容量给出编码速率的上界。"},{"source":"采样定理","target":"PCM","name":"支撑","des":"8kHz 采样正是语音带宽的两倍余量。"},{"source":"视频编码","target":"互联网","name":"喂养","des":"流媒体吃掉大半网络流量。"},{"source":"语音编码","target":"2G","name":"成就","des":"数字语音让频谱效率倍增。"},{"source":"OFDM","target":"5G","name":"空口","des":"5G NR 仍是 OFDM 家族。"},{"source":"MIMO","target":"5G","name":"规模化","des":"Massive MIMO 是 5G 的标签技术。"},{"source":"1G","target":"蜂窝网络","name":"建于","des":"第一代蜂窝系统的开山之作。"},{"source":"海底光缆","target":"互联网","name":"承载","des":"洲际流量的主动脉。"},{"source":"卫星通信","target":"6G","name":"并入","des":"星地融合是 6G 的候选方向。"},{"source":"双绞线","target":"带宽","name":"受限","des":"铜线的可用带宽随距离衰减。"},{"source":"拥塞控制","target":"分组交换","name":"伴生","des":"统计复用必然带来拥塞。"},{"source":"路由","target":"OSI模型","name":"位列","des":"网络层的核心职能。"}],"title":"通信工程","description":"从频谱与调制到香农极限，从 2G 到 6G 的移动通信演进：声音、比特与电磁波的百年长跑。"}