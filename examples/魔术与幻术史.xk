":"解构","des":"揭底式表演的反讽双人组。"},{"source":"宗师谱系","target":"西格弗里德与罗伊","name":"赌城","des":"拉斯维加斯白虎时代的缔造者。"},{"source":"宗师谱系","target":"刘谦","name":"中文","des":"春晚近景让魔术成为中文流行语。"},{"source":"罗贝尔-乌当","target":"哈利·胡迪尼","name":"致敬","des":"艺名取自偶像：如胡丹一般，还要更胜一筹。"},{"source":"哈利·胡迪尼","target":"戴·弗农","name":"受骗","des":"被教授的纸牌戏法骗过，胡迪尼输得心服。"},{"source":"罗贝尔-乌当","target":"幻术剧场化","name":"定调","des":"他确立了魔术师的着装、谈吐与剧场地位。"},{"source":"卡迪尼","target":"纸牌魔术","name":"舞台化","des":"把近景牌技放大到剧场后排。"},{"source":"大卫·科波菲尔","target":"消失","name":"奇观","des":"自由女神像在直播中没入夜色。"},{"source":"大卫·科波菲尔","target":"人体切割","name":"续写","des":"世纪之锯的电视升级版。"},{"source":"西格弗里德与罗伊","target":"鸽子魔术","name":"延伸","des":"从变鸽到驯虎，动物幻术的极致。"},{"source":"佩恩与泰勒","target":"魔术三诫","name":"僭越","des":"公开拆解手法，却守住核心的秘密。"},{"source":"刘谦","target":"近景魔术","name":"代言","des":"一张桌子八分钟，近景的中文时刻。"},{"source":"刘谦","target":"纸牌魔术","name":"招牌","des":"纸牌是他最锋利的武器。"},{"source":"里奇·杰伊","target":"魔术文献与收藏","name":"学者","des":"牌技之外他是绝版魔术书的最大藏家之一。"},{"source":"行业与殿堂","target":"魔术城堡","name":"麦加","des":"好莱坞私宅里的行业圣殿。"},{"source":"行业与殿堂","target":"FISM","name":"大考","des":"三年一届的世界魔术大赛。"},{"source":"行业与殿堂","target":"魔术师组织","name":"结社","des":"百年兄弟会共享会刊与秘密。"},{"source":"行业与殿堂","target":"魔术商店","name":"启蒙","des":"柜台前的演示是多数人的第一课。"},{"source":"行业与殿堂","target":"《塔贝尔课程》","name":"教材","des":"六十课函授写就的百科全书。"},{"source":"行业与殿堂","target":"揭密风波","name":"地震","des":"电视揭底引发的行业伦理论战。"},{"source":"行业与殿堂","target":"魔术文献与收藏","name":"暗流","des":"秘籍与手稿的市场从未公开也从未中断。"},{"source":"行业与殿堂","target":"短视频魔术潮","name":"新台","des":"十五秒的镜头成为新的舞台。"},{"source":"魔术三诫","target":"揭密风波","name":"被冒犯","des":"电视揭底触碰的正是这三条底线。"},{"source":"《塔贝尔课程》","target":"魔术师组织","name":"同路","des":"函授教材与兄弟会是行业普及的双腿。"},{"source":"短视频魔术潮","target":"近景魔术","name":"再翻红","des":"镜头怼近反而成就了近景手法。"},{"source":"短视频魔术潮","target":"揭密风波","name":"延续","des":"算法既传播奇迹也贩卖秘密。"},{"source":"FISM","target":"宗师谱系","name":"检阅","des":"大赛冠军名单几乎就是当代宗师名录。"}]}