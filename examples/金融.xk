{"version":2,"nodes":[{"name":"GDP","des":"一个经济体在一定时期内生产的全部最终商品与服务的市场价值，衡量经济总量的核心指标。","symbolSize":50,"category":"宏观经济"},{"name":"通货膨胀","des":"物价总水平持续上涨、货币购买力下降的现象，CPI 是其常用标尺。","symbolSize":50,"category":"宏观经济"},{"name":"CPI","des":"衡量一篮子居民消费品与服务价格变动的指数，观察通胀的第一口径。","symbolSize":40,"category":"宏观经济"},{"name":"失业率","des":"劳动力中无工作且正积极求职者所占比例，经济景气的滞后确认指标。","symbolSize":40,"category":"宏观经济"},{"name":"菲利普斯曲线","des":"描述短期通胀率与失业率之间此消彼长替代关系的曲线。","symbolSize":40,"category":"宏观经济"},{"name":"经济周期","des":"经济扩张与收缩交替出现的波动规律，分为繁荣、衰退、萧条、复苏四阶段。","symbolSize":70,"category":"宏观经济"},{"name":"财政政策","des":"政府通过税收与支出调节总需求的政策，与货币政策搭配发力。","symbolSize":50,"category":"宏观经济"},{"name":"货币政策","des":"中央银行调节货币供给与利率以稳定物价、促进就业的政策。","symbolSize":50,"category":"宏观经济"},{"name":"汇率","des":"一种货币兑换另一种货币的价格，影响进出口与国际资本流动。","symbolSize":50,"category":"宏观经济"},{"name":"国际收支","des":"一国与境外全部经济交易的系统记录，含经常账户与资本账户。","symbolSize":40,"category":"宏观经济"},{"name":"美林时钟","des":"将经济周期阶段与最优资产轮动对应的配置框架：复苏买股、过热持商品、滞胀持现金、衰退买债。","symbolSize":40,"category":"宏观经济"},{"name":"滞胀","des":"通胀高企与增长停滞并存的宏观困局，政策两难的最棘手组合。","symbolSize":40,"category":"宏观经济"},{"name":"货币","des":"交易媒介、价值尺度与储藏手段的统一体，形态从贝壳演进到数字货币。","symbolSize":50,"category":"货币与银行"},{"name":"信用","des":"以偿还为前提的价值让渡，现代经济运行的血脉。","symbolSize":50,"category":"货币与银行"},{"name":"中央银行","des":"发行的银行、银行的银行、政府的银行，货币政策的制定与执行者。","symbolSize":50,"category":"货币与银行"},{"name":"商业银行","des":"吸收存款、发放贷款、经营信用的金融中介，信用创造的主体。","symbolSize":50,"category":"货币与银行"},{"name":"存款准备金率","des":"银行须缴存央行的存款比例，调整它直接改变货币乘数。","symbolSize":40,"category":"货币与银行"},{"name":"公开市场操作","des":"央行买卖国债与票据调节市场流动性，最常用的货币政策工具。","symbolSize":40,"category":"货币与银行"},{"name":"政策利率","des":"央行向银行体系提供资金的利率（如再贴现率、MLF 利率），整个利率体系之锚。","symbolSize":40,"category":"货币与银行"},{"name":"货币供给层次","des":"按流动性划分的货币统计口径：M0 现金，M1 加活期存款，M2 再加定期与准货币。","symbolSize":40,"category":"货币与银行"},{"name":"货币乘数","des":"基础货币经银行体系反复派生存款而放大的倍数。","symbolSize":40,"category":"货币与银行"},{"name":"信用创造","des":"银行放贷的同时创造存款，是货币扩张的引擎。","symbolSize":40,"category":"货币与银行"},{"name":"利率","des":"货币的时间价格，牵动债券、汇率与一切资产定价的万有引力。","symbolSize":70,"category":"货币与银行"},{"name":"银行挤兑","des":"存款人恐慌性集中提款引发流动性崩塌，金融危机的经典引爆点。","symbolSize":40,"category":"货币与银行"},{"name":"存款保险","des":"对居民存款的限额保障，阻断恐慌传染的制度防火墙。","symbolSize":40,"category":"货币与银行"},{"name":"金融危机","des":"信用链条断裂引发的资产价格暴跌与机构连环倒闭。","symbolSize":40,"category":"货币与银行"},{"name":"股票","des":"公司所有权的凭证，享受剩余收益分配，风险与收益高于债券。","symbolSize":50,"category":"证券市场"},{"name":"债券","des":"发行人出具的债务凭证，按期付息、到期还本，收益相对固定。","symbolSize":50,"category":"证券市场"},{"name":"基金","des":"集合众多投资者的钱交由专业管理人分散投资的投资工具。","symbolSize":50,"category":"证券市场"},{"name":"ETF","des":"跟踪指数、可像股票一样在场内交易的基金，费率低、持仓透明。","symbolSize":40,"category":"证券市场"},{"name":"金融衍生品","des":"价值依附于标的资产的合约，天然带杠杆，是投机与对冲的双刃剑。","symbolSize":50,"category":"证券市场"},{"name":"期货","des":"标准化合约约定未来按确定价格交割，保证金交易自带杠杆。","symbolSize":40,"category":"证券市场"},{"name":"期权","des":"支付权利金买入未来按约定价格交易的选择权，收益结构非对称。","symbolSize":40,"category":"证券市场"},{"name":"互换","des":"双方约定在未来交换现金流的合约，最常用于利率与汇率风险管理。","symbolSize":40,"category":"证券市场"},{"name":"一级市场","des":"证券首次发行的市场，募集资金直接流入发行人。","symbolSize":40,"category":"证券市场"},{"name":"二级市场","des":"已发行证券流通转让的市场，提供流动性与连续定价。","symbolSize":40,"category":"证券市场"},{"name":"IPO","des":"公司首次公开发行股票上市，从私有走向公众的里程碑。","symbolSize":40,"category":"证券市场"},{"name":"做空","des":"先借券卖出、低价买回还券，从下跌中获利，同时为市场提供纠错信息。","symbolSize":40,"category":"证券市场"},{"name":"流动性","des":"资产以合理价格快速变现的能力，市场的血液。","symbolSize":40,"category":"证券市场"},{"name":"交易所","des":"集中撮合证券买卖的场所与规则制定者。","symbolSize":40,"category":"证券市场"},{"name":"股票指数","des":"由一篮子代表性股票按权重合成的价格指标，市场的温度计。","symbolSize":50,"category":"证券市场"},{"name":"公司金融","des":"围绕企业价值最大化的投融资决策体系：钱从哪来、投到哪去、如何分配。","symbolSize":40,"category":"公司金融"},{"name":"货币时间价值","des":"今天的一块钱比明天的一块钱更值钱，一切估值逻辑的起点。","symbolSize":70,"category":"公司金融"},{"name":"复利","des":"利息计入本金再计息，收益滚雪球，时间是最大的杠杆。","symbolSize":50,"category":"公司金融"},{"name":"贴现","des":"把未来的钱换算成今天的价值，复利的逆运算。","symbolSize":50,"category":"公司金融"},{"name":"资本预算","des":"评估长期投资项目是否值得投的决策流程，NPV 与 IRR 是其标尺。","symbolSize":40,"category":"公司金融"},{"name":"净现值","des":"NPV：未来现金流贴现总和减去初始投入，大于零即为企业创造价值。","symbolSize":50,"category":"公司金融"},{"name":"内部收益率","des":"IRR：使项目 NPV 恰好为零的折现率，代表项目自身的回报率。","symbolSize":40,"category":"公司金融"},{"name":"贴现现金流","des":"DCF：把企业未来全部自由现金流贴现加总的内在价值估值法。","symbolSize":50,"category":"公司金融"},{"name":"WACC","des":"加权平均资本成本：股权与债务成本按市值权重加权，企业现金流的折现率。","symbolSize":50,"category":"公司金融"},{"name":"资本结构","des":"债务与股权的比例搭配，同时影响企业风险与资本成本。","symbolSize":50,"category":"公司金融"},{"name":"MM定理","des":"理想市场下资本结构不影响企业价值；引入税收后利息税盾创造价值。","symbolSize":40,"category":"公司金融"},{"name":"股利政策","des":"利润留存再投资还是分红给股东的分配决策。","symbolSize":40,"category":"公司金融"},{"name":"杠杆","des":"以债务或固定成本放大收益与亏损的机制，双刃剑。","symbolSize":40,"category":"公司金融"},{"name":"并购","des":"企业间的兼并与收购，外延扩张的捷径或价值毁灭的陷阱。","symbolSize":40,"category":"公司金融"},{"name":"营运资本管理","des":"短期资产与负债的周转管理，确保企业现金流不断裂。","symbolSize":40,"category":"公司金融"},{"name":"风险","des":"收益的不确定性，金融的第一性概念——管理的对象，而非消灭的对象。","symbolSize":70,"category":"风险与组合"},{"name":"系统性风险","des":"波及整个市场的风险（利率、衰退、危机），分散化无法消除。","symbolSize":50,"category":"风险与组合"},{"name":"非系统性风险","des":"个别公司或行业特有的风险，分散投资的用武之地。","symbolSize":40,"category":"风险与组合"},{"name":"波动率","des":"收益率偏离均值的标准差，风险最常用的量化指标。","symbolSize":50,"category":"风险与组合"},{"name":"Beta系数","des":"个股收益对市场收益的敏感度，衡量承担系统性风险的大小。","symbolSize":50,"category":"风险与组合"},{"name":"预期收益","des":"各种可能结局按概率加权的平均收益，风险决策的出发点。","symbolSize":40,"category":"风险与组合"},{"name":"分散化","des":"不把鸡蛋放在一个篮子里，唯一免费的降低组合风险的方法。","symbolSize":50,"category":"风险与组合"},{"name":"现代组合理论","des":"MPT：马科维茨以均值-方差优化资产组合的框架，现代金融学的基石。","symbolSize":40,"category":"风险与组合"},{"name":"有效边界","des":"既定风险下收益最高（既定收益下风险最低）的组合集合。","symbolSize":40,"category":"风险与组合"},{"name":"CAPM","des":"资本资产定价模型：预期收益 = 无风险利率 + Beta × 市场风险溢价。","symbolSize":50,"category":"风险与组合"},{"name":"无风险利率","des":"近似零风险资产的收益率（如短期国债），一切风险定价的锚。","symbolSize":50,"category":"风险与组合"},{"name":"市场风险溢价","des":"市场组合收益超出无风险利率的部分，承担系统风险的补偿。","symbolSize":40,"category":"风险与组合"},{"name":"有效市场假说","des":"EMH：价格已反映全部可得信息，持续战胜市场极其困难。","symbolSize":40,"category":"风险与组合"},{"name":"VaR","des":"风险价值：给定置信水平与期限内组合的最大预期损失。","symbolSize":40,"category":"风险与组合"},{"name":"对冲","des":"建立相反头寸抵消既有风险敞口，用确定性换取放弃的潜在收益。","symbolSize":40,"category":"风险与组合"},{"name":"资产负债表","des":"某一时点资产、负债与所有者权益的存量快照：钱在哪、钱是谁的。","symbolSize":50,"category":"财务分析"},{"name":"利润表","des":"一段期间收入扣除费用得出利润的流量记录，赚钱能力的成绩单。","symbolSize":50,"category":"财务分析"},{"name":"现金流量表","des":"按经营、投资、筹资三段记录现金真实进出，利润的照妖镜。","symbolSize":50,"category":"财务分析"},{"name":"现金流","des":"企业或资产实际发生的现金进出，比账面利润更难粉饰。","symbolSize":70,"category":"财务分析"},{"name":"资产","des":"由过去交易形成、企业拥有或控制、预期带来经济利益的资源。","symbolSize":40,"category":"财务分析"},{"name":"负债","des":"预期导致经济利益流出的现时义务，借来的钱终须偿还。","symbolSize":40,"category":"财务分析"},{"name":"所有者权益","des":"资产减去负债后的剩余索取权，股东的账面家底。","symbolSize":40,"category":"财务分析"},{"name":"收入","des":"日常经营活动形成的经济利益总流入，利润的源头活水。","symbolSize":40,"category":"财务分析"},{"name":"净利润","des":"收入扣除全部成本、费用与税负后的最终经营成果。","symbolSize":50,"category":"财务分析"},{"name":"ROE","des":"净资产收益率：净利润 ÷ 净资产，股东每一块钱赚钱效率的终极指标。","symbolSize":50,"category":"财务分析"},{"name":"ROA","des":"总资产收益率：净利润 ÷ 总资产，衡量全部资产的使用效率。","symbolSize":40,"category":"财务分析"},{"name":"杜邦分析","des":"把 ROE 拆解为利润率 × 周转率 × 杠杆的三因素分解框架。","symbolSize":40,"category":"财务分析"},{"name":"市盈率","des":"PE：股价 ÷ 每股收益，为一块钱的盈利愿意付多少价钱。","symbolSize":40,"category":"财务分析"},{"name":"市净率","des":"PB：股价 ÷ 每股净资产，重资产行业常用的估值标尺。","symbolSize":40,"category":"财务分析"},{"name":"自由现金流","des":"FCF：扣除维持性资本开支后可自由分配的现金，DCF 估值的原料。","symbolSize":50,"category":"财务分析"},{"name":"流动比率","des":"流动资产 ÷ 流动负债，短期偿债能力的温度计。","symbolSize":40,"category":"财务分析"}],"links":[{"source":"CPI","target":"通货膨胀","name":"衡量","des":"CPI 涨幅是判断通胀程度的第一口径。"},{"source":"经济周期","target":"GDP","name":"驱动","des":"经济在扩张与收缩间波动，决定产出水平的起伏。"},{"source":"GDP","target":"失业率","name":"影响","des":"奥肯定律：产出缺口与失业率反向联动。"},{"source":"菲利普斯曲线","target":"通货膨胀","name":"刻画","des":"短期通胀与失业存在此消彼长的替代关系。"},{"source":"菲利普斯曲线","target":"失业率","name":"刻画","des":"政策在通胀与失业之间被迫权衡。"},{"source":"滞胀","target":"通货膨胀","name":"并存","des":"通胀高企的同时增长停滞，替代关系失灵。"},{"source":"滞胀","target":"失业率","name":"并存","des":"失业与通胀同时恶化，令政策左右为难。"},{"source":"经济周期","target":"滞胀","name":"孕育","des":"周期叠供给冲击可能陷入滞胀困局。"},{"source":"美林时钟","target":"经济周期","name":"映射","des":"按周期阶段轮动配置大类资产。"},{"source":"财政政策","target":"经济周期","name":"平滑","des":"逆周期调节：衰退时减税增支，过热时反向。"},{"source":"货币政策","target":"经济周期","name":"平滑","des":"通过利率与货币供给缓和经济波动。"},{"source":"财政政策","target":"货币政策","name":"搭配","des":"财政与货币协同发力，避免同时收紧或放松过度。"},{"source":"国际收支","target":"汇率","name":"决定","des":"持续顺差支撑本币升值，逆差施压贬值。"},{"source":"货币政策","target":"汇率","name":"影响","des":"利差变化驱动跨境资金流动，牵动汇率。"},{"source":"通货膨胀","target":"利率","name":"触发","des":"通胀高企倒逼央行加息抑制需求。"},{"source":"货币政策","target":"利率","name":"传导","des":"政策利率调整经市场传导至整条收益率曲线。"},{"source":"经济周期","target":"系统性风险","name":"催生","des":"衰退与危机是系统性风险的总源头。"},{"source":"美林时钟","target":"股票","name":"配置","des":"复苏期股票是性价比最高的资产。"},{"source":"美林时钟","target":"债券","name":"配置","des":"衰退期利率下行，债券是最优资产。"},{"source":"中央银行","target":"货币政策","name":"制定","des":"央行是货币政策的制定与执行主体。"},{"source":"中央银行","target":"公开市场操作","name":"执行","des":"买卖国债与票据是最日常的操作工具。"},{"source":"中央银行","target":"存款准备金率","name":"设定","des":"调整准备金率是威力较大的总量工具。"},{"source":"中央银行","target":"政策利率","name":"设定","des":"政策利率是央行引导市场利率的抓手。"},{"source":"政策利率","target":"利率","name":"传导","des":"政策利率变动沿利率体系传导至存贷款与债券市场。"},{"source":"公开市场操作","target":"货币供给层次","name":"调节","des":"买入投放、卖出回笼，直接改变基础货币。"},{"source":"存款准备金率","target":"货币乘数","name":"决定","des":"准备金率越低，银行可放贷资金越多，乘数越大。"},{"source":"货币乘数","target":"信用创造","name":"解释","des":"基础货币经多轮存贷派生被成倍放大。"},{"source":"商业银行","target":"信用创造","name":"执行","des":"每笔放贷同时创造等额存款，银行是派生主体。"},{"source":"信用创造","target":"货币供给层次","name":"扩张","des":"派生存款使 M2 远大于基础货币。"},{"source":"中央银行","target":"商业银行","name":"监管","des":"央行维系支付清算并对银行体系监督管理。"},{"source":"商业银行","target":"信用","name":"经营","des":"银行的本质是经营信用风险的中介。"},{"source":"银行挤兑","target":"商业银行","name":"冲击","des":"恐慌性提款可在数日内掏空银行流动性。"},{"source":"存款保险","target":"银行挤兑","name":"防范","des":"限额保障降低储户挤兑动机。"},{"source":"金融危机","target":"银行挤兑","name":"包含","des":"危机的经典剧本：坏消息、恐慌、挤兑、连环倒闭。"},{"source":"货币","target":"信用","name":"基于","des":"现代货币的本质是央行与银行的信用负债。"},{"source":"货币供给层次","target":"货币","name":"统计","des":"M0、M1、M2 从现金到准货币按流动性分层计量。"},{"source":"利率","target":"复利","name":"驱动","des":"利率是复利滚动的速率，微小差异长期放大为鸿沟。"},{"source":"利率","target":"贴现","name":"参照","des":"折现率通常在基准利率之上加风险补偿。"},{"source":"利率","target":"无风险利率","name":"锚定","des":"无风险利率是利率体系中的基准一端。"},{"source":"利率","target":"汇率","name":"影响","des":"高息货币吸引套息资金流入，推升汇率。"},{"source":"债券","target":"利率","name":"反向联动","des":"市场利率上行，存量债券价格下跌。"},{"source":"利率","target":"货币时间价值","name":"体现","des":"市场利率是货币时间价值的集中定价。"},{"source":"股票","target":"一级市场","name":"发行","des":"新股首发在一级市场完成募资。"},{"source":"债券","target":"一级市场","name":"发行","des":"债券发行同样在一级市场募集。"},{"source":"IPO","target":"一级市场","name":"属于","des":"IPO 是一级市场最瞩目的发行活动。"},{"source":"IPO","target":"股票","name":"发行","des":"首次公开发行将公司推向公众市场。"},{"source":"股票","target":"二级市场","name":"流通","des":"发行完毕后股票在场内持续转手。"},{"source":"债券","target":"二级市场","name":"流通","des":"存量债券在二级市场形成连续报价。"},{"source":"交易所","target":"二级市场","name":"组织","des":"交易所提供集中撮合与规则保障。"},{"source":"二级市场","target":"流动性","name":"提供","des":"交易越活跃，资产变现越容易、代价越小。"},{"source":"ETF","target":"基金","name":"属于","des":"ETF 是可在场内交易的开放式指数基金。"},{"source":"ETF","target":"股票指数","name":"跟踪","des":"ETF 力求复制指数的成分与权重。"},{"source":"股票","target":"股票指数","name":"构成","des":"指数由一篮子股票按权重合成。"},{"source":"做空","target":"二级市场","name":"交易","des":"做空依赖二级市场可借券、可买卖。"},{"source":"做空","target":"股票","name":"借入","des":"先借券卖出，后低价买回还券。"},{"source":"期货","target":"金融衍生品","name":"属于","des":"期货是标准化程度最高的衍生品。"},{"source":"期权","target":"金融衍生品","name":"属于","des":"期权买卖的是选择权本身。"},{"source":"互换","target":"金融衍生品","name":"属于","des":"互换交换的是两串未来的现金流。"},{"source":"期权","target":"股票","name":"挂钩","des":"股票期权以个股或指数为标的。"},{"source":"基金","target":"股票","name":"投资","des":"基金以组合方式持有股票等资产。"},{"source":"基金","target":"债券","name":"投资","des":"债券基金专注固定收益资产。"},{"source":"债券","target":"现金流","name":"产生","des":"息票与本金构成一串可预期的现金流。"},{"source":"债券","target":"货币时间价值","name":"基于","des":"债券价格即未来现金流按利率贴现之和。"},{"source":"金融衍生品","target":"对冲","name":"用于","des":"衍生品天然适合建立反向头寸对冲风险。"},{"source":"市盈率","target":"股票","name":"估值","des":"PE 是股票相对估值最常用的标尺。"},{"source":"市净率","target":"股票","name":"估值","des":"PB 常用于银行等重资产行业。"},{"source":"股票","target":"风险","name":"承担","des":"股票求偿顺序靠后，承担剩余风险换取剩余收益。"},{"source":"有效市场假说","target":"ETF","name":"支持","des":"若市场高度有效，低成本指数基金是最优选择。"},{"source":"公司金融","target":"资本预算","name":"涵盖","des":"投资决策：钱投到哪个项目。"},{"source":"公司金融","target":"资本结构","name":"涵盖","des":"融资决策：钱从股权还是债务来。"},{"source":"公司金融","target":"营运资本管理","name":"涵盖","des":"短期决策：日常资金周转。"},{"source":"公司金融","target":"股利政策","name":"涵盖","des":"分配决策：利润留多少、分多少。"},{"source":"公司金融","target":"并购","name":"涵盖","des":"扩张决策：买企业还是建企业。"},{"source":"复利","target":"货币时间价值","name":"体现","des":"利滚利是时间就是价值的最直观形式。"},{"source":"贴现","target":"货币时间价值","name":"源于","des":"贴现把未来价值换算回今天，与复利互逆。"},{"source":"贴现","target":"复利","name":"互逆","des":"复利由现在推未来，贴现由未来折回现在。"},{"source":"净现值","target":"货币时间价值","name":"根植于","des":"NPV 比较的正是不同时点金钱的价值。"},{"source":"内部收益率","target":"货币时间价值","name":"根植于","des":"IRR 本身就是一个时间价值的折算率。"},{"source":"净现值","target":"贴现","name":"依赖","des":"NPV 把各期现金流逐一贴现后加总。"},{"source":"贴现现金流","target":"贴现","name":"依赖","des":"DCF 是贴现思想在企业估值上的集大成。"},{"source":"贴现现金流","target":"净现值","name":"推广","des":"DCF 本质是 NPV 思想从项目到企业的延伸。"},{"source":"资本预算","target":"净现值","name":"应用","des":"NPV 大于零是接受项目的黄金准则。"},{"source":"资本预算","target":"内部收益率","name":"应用","des":"IRR 与门槛利率比较辅助决策。"},{"source":"内部收益率","target":"净现值","name":"平衡","des":"IRR 正是使 NPV 等于零的折现率。"},{"source":"贴现现金流","target":"WACC","name":"折现于","des":"企业自由现金流通常以 WACC 为折现率。"},{"source":"资本结构","target":"WACC","name":"决定","des":"债务与股权的比重直接改变加权资本成本。"},{"source":"MM定理","target":"资本结构","name":"研究","des":"MM 定理是资本结构理论的逻辑起点。"},{"source":"资本结构","target":"杠杆","name":"体现","des":"债务占比越高，财务杠杆越大。"},{"source":"贴现现金流","target":"资本预算","name":"支撑","des":"DCF 是评估长期项目价值的主流方法。"},{"source":"贴现现金流","target":"自由现金流","name":"贴现对象","des":"DCF 的原料是企业未来的自由现金流。"},{"source":"营运资本管理","target":"现金流","name":"守护","des":"管好应收应付与存货，防止现金流断裂。"},{"source":"杠杆","target":"风险","name":"放大","des":"高杠杆在放大收益的同时等比放大风险。"},{"source":"杠杆","target":"ROE","name":"放大","des":"资产回报高于债务成本时，杠杆抬高股东回报。"},{"source":"股利政策","target":"净利润","name":"分配","des":"分红与留存此消彼长，共同瓜分净利润。"},{"source":"风险","target":"系统性风险","name":"分解为","des":"无法通过分散消除的市场性风险。"},{"source":"风险","target":"非系统性风险","name":"分解为","des":"可以通过分散化化解的特质风险。"},{"source":"波动率","target":"风险","name":"量化","des":"标准差把不确定性压缩成一个可比的数字。"},{"source":"Beta系数","target":"系统性风险","name":"衡量","des":"Beta 越大，随市场同涨同跌的幅度越大。"},{"source":"分散化","target":"非系统性风险","name":"消除","des":"持有足够多低相关资产，特质风险近乎归零。"},{"source":"预期收益","target":"风险","name":"补偿","des":"要求更高的预期收益，是承担风险的报酬。"},{"source":"现代组合理论","target":"分散化","name":"基于","des":"组合的风险不是个股风险的简单加总。"},{"source":"现代组合理论","target":"有效边界","name":"推导","des":"优化后的组合集合构成风险收益前沿。"},{"source":"有效边界","target":"预期收益","name":"权衡","des":"沿前沿移动：多一分收益，多一分风险。"},{"source":"CAPM","target":"Beta系数","name":"基于","des":"Beta 决定资产承担多少系统风险。"},{"source":"CAPM","target":"无风险利率","name":"基于","des":"预期收益从无风险利率起算。"},{"source":"CAPM","target":"市场风险溢价","name":"基于","des":"乘上 Beta 便得到个体风险补偿。"},{"source":"市场风险溢价","target":"系统性风险","name":"补偿","des":"市场整体承担系统风险所要求的回报。"},{"source":"VaR","target":"风险","name":"度量","des":"用一个数字回答最坏会亏多少。"},{"source":"对冲","target":"风险","name":"抵消","des":"以相反头寸对冲，把不确定性变成确定。"},{"source":"风险","target":"WACC","name":"抬高","des":"风险越高，投资者要求的折现率越高，估值越低。"},{"source":"有效市场假说","target":"波动率","name":"解释","des":"新信息随机到达使价格波动近似随机游走。"},{"source":"资产负债表","target":"资产","name":"列示","des":"资产的存量与结构。"},{"source":"资产负债表","target":"负债","name":"列示","des":"负债的规模与期限。"},{"source":"资产负债表","target":"所有者权益","name":"列示","des":"资产减负债后的股东净值。"},{"source":"利润表","target":"收入","name":"列示","des":"收入是利润故事的起点。"},{"source":"利润表","target":"净利润","name":"列示","des":"层层扣除后的最终成果。"},{"source":"收入","target":"净利润","name":"转化为","des":"扣除成本费用税负后凝结为净利润。"},{"source":"现金流量表","target":"现金流","name":"记录","des":"按经营、投资、筹资三段还原现金真实进出。"},{"source":"净利润","target":"现金流","name":"调节","des":"利润是观点，现金是事实，两者差异暴露盈利质量。"},{"source":"净利润","target":"ROE","name":"构成","des":"ROE 的分子是当期净利润。"},{"source":"所有者权益","target":"ROE","name":"构成","des":"ROE 的分母是股东投入的净资产。"},{"source":"净利润","target":"ROA","name":"构成","des":"ROA 以净利润比上全部资产。"},{"source":"资产","target":"ROA","name":"构成","des":"资产规模决定回报的分母。"},{"source":"杜邦分析","target":"ROE","name":"分解","des":"ROE 等于利润率乘周转率乘杠杆。"},{"source":"市盈率","target":"净利润","name":"基于","des":"PE 的分母每股收益源自净利润。"},{"source":"市净率","target":"所有者权益","name":"基于","des":"PB 的分母每股净资产源自权益。"},{"source":"自由现金流","target":"现金流量表","name":"源于","des":"FCF 由经营现金流减资本开支推算。"},{"source":"自由现金流","target":"现金流","name":"度量","des":"FCF 是可自由分配给全部出资人的现金流。"},{"source":"流动比率","target":"负债","name":"对照","des":"流动资产覆盖短期负债的程度。"},{"source":"流动比率","target":"营运资本管理","name":"检验","des":"短期偿债指标是营运资本管理的成绩单。"}]}