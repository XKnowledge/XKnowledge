{
  "version": 2,
  "title": "哈利波特魔法体系",
  "description": "九又四分之三站台之后的世界：四学院与千年创始、魔杖与咒语的谱系、纯血家族的谱牒，与魂器、圣器、预言交织的正邪大战。",
  "nodes": [
    { "name": "哈利波特魔法体系", "des": "一个藏在壁炉、站台与砖墙之后的平行英国：魔法部治理巫师，霍格沃茨传承千年，而爱是最古老的魔法。", "symbolSize": 70, "category": "魔法世界全景" },
    { "name": "霍格沃茨魔法学校", "des": "千年古堡，四位创始人共同缔造的魔法最高学府：一百四十二级楼梯、会动的画像，与家养小精灵经营的后厨。", "symbolSize": 50, "category": "霍格沃茨与学院" },
    { "name": "戈德里克·格兰芬多", "des": "四位创始人之一，勇气之门的开创者，「真正的格兰芬多能从帽子里拔出宝剑」。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "萨拉查·斯莱特林", "des": "四位创始人之一，纯血论的源头，与挚友决裂后密造蛇怪密室，血统执念毒流千年。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "罗伊纳·拉文克劳", "des": "四位创始人之一，智慧至上，「过人的聪明是人最大的财富」，冠冕是她的遗物。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "赫尔加·赫奇帕奇", "des": "四位创始人之一，「我教所有人，一视同仁」，勤劳与忠诚的金杯传世。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "格兰芬多学院", "des": "勇气之院，红色的狮子，出过邓布利多也出过差点被开除的救世主。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "斯莱特林学院", "des": "野心与血统之院，绿色的蛇，出了最多的黑巫师也出了最勇敢的双面间谍。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "拉文克劳学院", "des": "智慧之院，青铜鹰门环只答谜题，卢娜的位子在这里。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "赫奇帕奇学院", "des": "忠诚勤恳之院，獾院的公共休息室挨着厨房，塞德里克是它的骄傲。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "分院帽", "des": "四位创始人脑力的合体，每年开学歌一曲，把每个新生分进命定的学院——「我们自己也能选择」。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "有求必应屋", "des": "只有真正需要时才会出现的房间，藏过秘密军队的训练场，也藏过一顶冠冕。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "密室", "des": "萨拉查私造的地下密室，管道深处沉眠蛇怪，只有斯莱特林传人能开启。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "禁林", "des": "霍格沃茨明令禁止踏入的森林：人马的星象、独角兽的血、八眼巨蛛的网。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "霍格莫德村", "des": "全英唯一纯巫师村落，黄油啤酒与蜂蜜公爵，周末的法定幸福。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "黑魔法防御术的诅咒", "des": "伏地魔被拒后种下的诅咒：这门课的教师没人能教满一年，卢平是少数全身而退的幸存者。", "symbolSize": 40, "category": "霍格沃茨与学院" },
    { "name": "魔杖与魔杖学", "des": "「魔杖选择巫师」：木质、杖芯与长度构成一支杖的性格，三大家芯材——凤凰羽、独角兽毛、龙心腱。", "symbolSize": 50, "category": "魔咒与魔法体系" },
    { "name": "奥利凡德", "des": "老字号魔杖匠人，「就用这根吧」——他记着自己卖出的每一支杖，包括那对孪生羽。", "symbolSize": 40, "category": "魔咒与魔法体系" },
    { "name": "除你武器", "des": "Expelliarmus，缴械咒，哈利的标志：一个男孩最顺手的咒语，偏偏赢过黑魔王的杀戮。", "symbolSize": 40, "category": "魔咒与魔法体系" },
    { "name": "呼神护卫", "des": "Expecto Patronum，以最快乐的回忆驱赶摄魂怪，守护神的形态泄露施术者最深的自我。", "symbolSize": 40, "category": "魔咒与魔法体系" },
    { "name": "三大不可饶恕咒", "des": "阿瓦达索命、钻心剜骨、夺魂咒——施于人类者终身监禁于阿兹卡班，黑魔王的母语。", "symbolSize": 50, "category": "魔咒与魔法体系" },
    { "name": "幻影移形", "des": "随想随到的消失术，考试要领三条：目标、决心、从容—— Splinch 是失败者的学费。", "symbolSize": 40, "category": "魔咒与魔法体系" },
    { "name": "飞路粉", "des": "投入壁炉、喊清地名，绿色的火焰里是巫师世界的城际网络。", "symbolSize": 40, "category": "魔咒与魔法体系" },
    { "name": "门钥匙", "des": "被施了咒的废旧物品，一摸即传送，大型活动的散场利器，也做过黑暗的诱饵。", "symbolSize": 40, "category": "魔咒与魔法体系" },
    { "name": "摄神取念与大脑封闭术", "des": "读取心智与闭锁心智的对偶技艺，斯内普是当世罕见的双料大师。", "symbolSize": 40, "category": "魔咒与魔法体系" },
    { "name": "复方汤剂", "des": "喝下即变他人，需对方的头发与一个月的熬煮——赫敏酿过，也错变成猫。", "symbolSize": 40, "category": "魔咒与魔法体系" },
    { "name": "活点地图", "des": "「我庄严宣誓我没干好事」——月亮脸、虫尾巴、大脚板与尖头叉子的传世之作，全校人的脚印尽收眼底。", "symbolSize": 40, "category": "魔咒与魔法体系" },
    { "name": "古代魔法与血缘保护", "des": "比咒语更老的魔法：莉莉以死为祭，在儿子的血里织进保护——伏地魔算尽了魂器，漏算了这个。", "symbolSize": 40, "category": "魔咒与魔法体系" },
    { "name": "凤凰福克斯", "des": "邓布利多的凤凰，浴火轮回，歌声能给正直者以勇气、给背叛者以恐惧，眼泪是唯一的解药。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "鹰头马身有翼兽", "des": "巴克比克：半鹰半马的高贵生物，鞠躬是唯一的通行证，后来驮着小天狼星飞向了自由。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "独角兽", "des": "禁林中最纯洁的生物，银血可续命——但杀戮纯洁者换来的每一秒都带着诅咒。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "人马", "des": "禁林的星象学家，傲慢的火盆与玛人联盟，读星的人最恨被当作牲口。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "狼人", "des": "月圆之刑：卢平每月的挣扎，变身者被社会放逐，偏见比狼牙更伤人。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "巨人", "des": "山地的衰亡种族，海格的另一半血统，伏地魔想拉拢的雇佣兵。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "蛇怪", "des": "萨拉查沉在密室深处的千年巨蛇：黄瞳即死、间接对视即石化，蛇佬腔是唯一的遥控器。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "夜骐", "des": "拽着霍格沃茨马车的黑色翼马，只有见过死亡的人才看得见——哈利与卢娜的共通语言。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "家养小精灵", "des": "古老的仆役种族，以衣物为解约书：多比教他们什么叫自由，克利切教他们什么叫忠诚。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "妖精与古灵阁", "des": "古灵阁的经营者，最精明的金匠与最执拗的产权人：妖精认为造物永远属于工匠，卖出去只是「租」。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "摄魂怪", "des": "阿兹卡班的守卫，吸走快乐与希望的裹尸布：它们不是动物也不是幽灵，是腐烂本身的形状。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "阿拉戈克", "des": "海格养大的八眼巨蛛，误解的牺牲品，蜘蛛的感激是绝不亲自吃掉恩人的朋友。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "火龙", "des": "守着古灵阁深库的半盲老龙、三强争霸的第一道关、挪威脊背龙诺伯——巫师世界最强生物的法律地位是「受管制」。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "博格特", "des": "没人知道它真面目的变形者，扮成你最怕的东西——笑声与滑稽咒是它的天敌。", "symbolSize": 40, "category": "魔法生物" },
    { "name": "布莱克家族", "des": "最古老的纯血世家之一，格里莫广场十二号的挂毯上，烧掉的名字是家族的耻辱——也是它的良心。", "symbolSize": 40, "category": "巫师家族谱系" },
    { "name": "韦斯莱家族", "des": "红头发的血统叛徒：穷得叮当响的七口之家，出了两个傲罗、一个笑话商店和整个凤凰社的半壁。", "symbolSize": 50, "category": "巫师家族谱系" },
    { "name": "马尔福家族", "des": "金钱与血统的旧贵族，庄园的客厅接待过黑魔王，地下牢房关过反对者。", "symbolSize": 40, "category": "巫师家族谱系" },
    { "name": "波特家族", "des": "隐形衣的传承者，伊格诺图斯·佩弗利尔的直系，老楼的箱底藏着三器合一的可能。", "symbolSize": 40, "category": "巫师家族谱系" },
    { "name": "冈特家族", "des": "斯莱特林与佩弗利尔的双重后裔，穷困、近亲与疯狂，把复活石镶在传家戒指上。", "symbolSize": 40, "category": "巫师家族谱系" },
    { "name": "里德尔家族", "des": "小汉格顿的麻瓜乡绅，被巫师妻子抛下的老汤姆，儿子回来时一家三口没能见到天亮。", "symbolSize": 40, "category": "巫师家族谱系" },
    { "name": "隆巴顿家族", "des": "极有前途的傲罗世家，弗兰克与艾丽斯被钻心咒逼疯——纳威在每个探视日长大一点。", "symbolSize": 40, "category": "巫师家族谱系" },
    { "name": "佩弗利尔三兄弟", "des": "死亡圣器传说的主角：安提俄克要权杖、卡德摩斯要复活石、伊格诺图斯只要一件隐形衣——三件遗产分出三种人性。", "symbolSize": 50, "category": "巫师家族谱系" },
    { "name": "德拉科·马尔福", "des": "卢修斯之子，斯莱特林的找球手，被迫接下杀人的任务才发现自己下不了手——十六岁的被迫成年。", "symbolSize": 40, "category": "巫师家族谱系" },
    { "name": "邓布利多", "des": "阿不思·邓布利多：变形术教授、凤凰社创始、老魔杖末代主人，以一辈子的算计布一盘以自己为子的局。", "symbolSize": 60, "category": "凤凰社与正派" },
    { "name": "哈利·波特", "des": "大难不死的男孩，从碗柜到救世主的漫长成长，最终发现自己也是棋盘上的一枚——而他从禁林走了回来。", "symbolSize": 60, "category": "凤凰社与正派" },
    { "name": "罗恩", "des": "六个哥哥阴影下的第七个孩子，巫师棋的车：第一次过关靠他牺牲自己，最后一次也是他想着家。", "symbolSize": 50, "category": "凤凰社与正派" },
    { "name": "赫敏", "des": "麻瓜出身的最强女巫，图书馆的常客、D.A.的组织委员，「还有更重要的——友谊和勇气」。", "symbolSize": 50, "category": "凤凰社与正派" },
    { "name": "金妮", "des": "韦斯莱家唯一的女儿，七口之家的凤凰，从被日记控制的女孩长成全场最狠的蝙蝠精咒。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "纳威·隆巴顿", "des": "隆巴顿家的奇迹：记性最差、蟾蜍最常丢，最终在废墟的礼堂里从分院帽拔出宝剑，斩断了最后一枚魂器。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "卢娜·洛夫古德", "des": "「疯姑娘」卢娜，拉文克劳的空气感少女，看得见夜骐也看得穿流言，忠诚得毫无条件。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "小天狼星·布莱克", "des": "布莱克家的叛徒、哈利的教父，阿兹卡班十二年没磨掉的赤诚，倒进帷幔时还带着笑。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "卢平", "des": "月亮脸：狼人、教授、劫盗者，一生温和到连月光都欺负他，战死时终于不再是怪物。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "穆迪", "des": "疯眼汉：最传奇的傲罗，茶壶随身、魔眼盯墙，唯一一次松懈来自自己人。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "唐克斯", "des": "易容马格斯女傲罗，粉头发与笨拙并存，爱上卢平这件事比黑魔法还倔。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "斯内普", "des": "西弗勒斯·斯内普：双面间谍、混血王子、「始终」——用一辈子的刻薄藏一句十年的情话。", "symbolSize": 60, "category": "凤凰社与正派" },
    { "name": "麦格教授", "des": "米勒娃·麦格，变形术教授与格兰芬多院长，方格眼镜后的苏格兰式坚硬与柔软。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "海格", "des": "鲁伯·海格，钥匙与场地管理员、保护神奇生物课教师，对危险生物的品味与忠诚同样无可救药。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "凤凰社", "des": "邓布利多两次组建的秘密组织，第一次对抗格林德沃余波与伏地魔初起，第二次直接站在战争最前排。", "symbolSize": 50, "category": "凤凰社与正派" },
    { "name": "D.A.邓布利多军", "des": "有求必应屋里偷偷练咒的学生军，加隆币为信，从此霍格沃茨的抵抗不再只属于大人。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "多比", "des": "「多比是个自由的小精灵！」——从马尔福家的仆役到自由的战士，为一根魔杖挡下了致命一刀。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "特里劳妮与预言", "des": "猪头酒吧里的失神一刻：「两个都活不了，除非其中一个死在另一个手上」——预言自己挑了它的听众。", "symbolSize": 40, "category": "凤凰社与正派" },
    { "name": "伏地魔", "des": "汤姆·里德尔，孤儿院走出的斯莱特林传人，把灵魂切成七片换不朽，唯一没算懂的是爱与死亡。", "symbolSize": 60, "category": "食死徒与黑魔法" },
    { "name": "贝拉特里克斯", "des": "布莱克家走出的头号女食死徒，钻心咒的艺术家，笑声比咒语更渗人，终败给一位母亲的爱。", "symbolSize": 40, "category": "食死徒与黑魔法" },
    { "name": "卢修斯·马尔福", "des": "食死徒的体面面孔：魔法部的捐客、董事会的黑手，拐杖里藏着魔杖也藏着旧主人的日记。", "symbolSize": 40, "category": "食死徒与黑魔法" },
    { "name": "小巴蒂·克劳奇", "des": "越狱的完美学生，喝着复方汤剂扮了一年穆迪，把三强争霸赛变成了一场刺杀。", "symbolSize": 40, "category": "食死徒与黑魔法" },
    { "name": "小矮星彼得", "des": "虫尾巴：四人组里最不起眼的一个，十二年的宠物鼠，用一只银手还清又欠下命债。", "symbolSize": 40, "category": "食死徒与黑魔法" },
    { "name": "食死徒", "des": "黑魔王的白口罩军团：贵族、流氓与懦夫的集合，黑魔标记既是荣耀也是枷锁。", "symbolSize": 50, "category": "食死徒与黑魔法" },
    { "name": "格林德沃", "des": "「为了更伟大的利益」：第一代黑魔王，老魔杖的前主人，1945 年败给一生中唯一的朋友。", "symbolSize": 50, "category": "食死徒与黑魔法" },
    { "name": "乌姆里奇", "des": "粉色的菲尼斯式恐怖：猫咪挂盘、血刑羽毛笔与《教育令》，体制化的恶意不需要黑魔法。", "symbolSize": 40, "category": "食死徒与黑魔法" },
    { "name": "魂器", "des": "以杀戮切割灵魂、以容器封存不死的禁术：伏地魔做了六枚，外加一枚计划外的。", "symbolSize": 50, "category": "魂器与死亡圣器" },
    { "name": "里德尔日记", "des": "第一枚魂器，五十年前的记忆自我：控制过金妮，被蛇怪毒牙钉穿在密室。", "symbolSize": 40, "category": "魂器与死亡圣器" },
    { "name": "冈特戒指", "des": "镶着复活石的黑石戒指，邓布利多毁它时中了致命诅咒——那只焦黑的手只剩一年。", "symbolSize": 40, "category": "魂器与死亡圣器" },
    { "name": "斯莱特林挂坠盒", "des": "「S」形挂坠，真品被雷古勒斯调包进格里莫广场，最终在森林里死于格兰芬多宝剑。", "symbolSize": 40, "category": "魂器与死亡圣器" },
    { "name": "赫奇帕奇金杯", "des": "两柄小金杯，藏进古灵阁最深处的莱斯特兰奇金库，被赫敏以毒牙终结。", "symbolSize": 40, "category": "魂器与死亡圣器" },
    { "name": "拉文克劳冠冕", "des": "「智慧无价」的灰冠，在有求必应屋藏了半个世纪，终毁于失控的厉火。", "symbolSize": 40, "category": "魂器与死亡圣器" },
    { "name": "纳吉尼", "des": "伏地魔的蛇、第七枚魂器，护主的最后一道保险，被纳威从分院帽下拔剑斩落。", "symbolSize": 40, "category": "魂器与死亡圣器" },
    { "name": "死亡圣器", "des": "老魔杖、复活石、隐形衣：传说里死神的礼物，集齐者为主宰死亡之人——传说的真相或许只是三兄弟的手艺。", "symbolSize": 50, "category": "魂器与死亡圣器" },
    { "name": "老魔杖", "des": "接骨木魔杖，杖谱相传的至强之杖：从格里戈洛维奇到格林德沃、邓布利多、德拉科，最终认了一个不想赢的人。", "symbolSize": 40, "category": "魂器与死亡圣器" },
    { "name": "复活石", "des": "镶在冈特戒指里的黑石，能唤回影子却唤不回人：第三兄弟用它召来亡妻，然后追随她而去。", "symbolSize": 40, "category": "魂器与死亡圣器" },
    { "name": "隐形衣", "des": "伊格诺图斯传下的真正的隐形衣：从不失效、代代相传，波特家的家底。", "symbolSize": 40, "category": "魂器与死亡圣器" },
    { "name": "《诗翁彼豆故事集》", "des": "巫师的童话书：三兄弟的故事藏在其中，邓布利多用遗赠给赫敏的书留下最后的谜面。", "symbolSize": 40, "category": "魂器与死亡圣器" },
    { "name": "魔法部", "des": "魔法世界的白宫与白厅：九层电梯往下是神秘事务司，鸾凤蛋形的心脏沉在最深一层。", "symbolSize": 50, "category": "地点与机构" },
    { "name": "威森加摩", "des": "巫师最高法庭，元老与议席由德高望重者出任——邓布利多曾是其首席。", "symbolSize": 40, "category": "地点与机构" },
    { "name": "阿兹卡班", "des": "北海外的大狱，摄魂怪看守的无墙监狱：进去的人不是疯了，就是正在慢慢疯。", "symbolSize": 40, "category": "地点与机构" },
    { "name": "对角巷", "des": "破釜酒吧砖墙后的商业街：奥利凡德的杖、丽痕的书、摩金夫人的袍，每个新学年的起点。", "symbolSize": 40, "category": "地点与机构" },
    { "name": "翻倒巷", "des": "对角巷的暗面：博金-博克的黑货、摇头晃脑的围观，马尔福家的常客走得到的地方。", "symbolSize": 40, "category": "地点与机构" },
    { "name": "国王十字车站9¾站台", "des": "第三与第四柱之间的界墙，霍格沃茨特快在此发车：每年九月一日的十一点整。", "symbolSize": 40, "category": "地点与机构" },
    { "name": "陋居", "des": "韦斯莱家的歪塔楼：钟面指着全家人的安危，地精在院子里被倒提着转圈。", "symbolSize": 40, "category": "地点与机构" },
    { "name": "戈德里克山谷", "des": "波特家的旧居所在，圣诞夜被毁的废墟至今保留——圣器的故事也源起于此。", "symbolSize": 40, "category": "地点与机构" },
    { "name": "魁地奇", "des": "巫师世界第一运动：四个球、七人队、找球手定胜负——规则是描述它最少犯规死人的方式。", "symbolSize": 50, "category": "魁地奇与巫师文化" },
    { "name": "金色飞贼", "des": "银翼的金胡桃，被抓住即得一百五十分终局：核桃壳里可以藏一句遗言。", "symbolSize": 40, "category": "魁地奇与巫师文化" },
    { "name": "魁地奇世界杯", "des": "四年一度的盛大节日：爱尔兰对保加利亚的那一夜，黑魔标记升上天空。", "symbolSize": 40, "category": "魁地奇与巫师文化" },
    { "name": "三强争霸赛", "des": "三校传统的友谊赛：火龙、黑湖与迷宫，那年多出了一个名字——第四勇士哈利。", "symbolSize": 40, "category": "魁地奇与巫师文化" },
    { "name": "巧克力蛙与比比多味豆", "des": "巫师零食的双璧：卡片上的校长会跑，豆子里的耳屎味是社交试金石。", "symbolSize": 40, "category": "魁地奇与巫师文化" },
    { "name": "预言家日报", "des": "巫师界的头版：时而喉舌、时而小报，丽塔·斯基特的速记羽毛笔从不出错地写错。", "symbolSize": 40, "category": "魁地奇与巫师文化" },
    { "name": "巫师棋", "des": "会喊会砍会罢工的棋：第一年的那盘棋里，罗恩用车换了一场胜利。", "symbolSize": 40, "category": "魁地奇与巫师文化" },
    { "name": "纯血统意识形态", "des": "「泥巴种」与「血统叛徒」的谱系学：先斩混血、再灭麻瓜、最后连纯血自己也内部分等。", "symbolSize": 40, "category": "魁地奇与巫师文化" },
    { "name": "J.K.罗琳", "des": "从爱丁堡咖啡馆的餐巾到全球现象：她写的不是魔法存在，而是魔法也需要面对偏见、官僚与死亡。", "symbolSize": 50, "category": "魁地奇与巫师文化" }
  ],
