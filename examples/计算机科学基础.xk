{"version":2,"nodes":[{"name":"数组","des":"连续内存中按下标存放的同型元素序列，随机访问飞快，插入删除要搬移。","symbolSize":40,"category":"数据结构"},{"name":"链表","des":"节点靠指针串成的序列，插删只改指针，访问必须逐个跳跃。","symbolSize":40,"category":"数据结构"},{"name":"栈","des":"后进先出的单开口线性表，函数调用与括号匹配的第一利器。","symbolSize":40,"category":"数据结构"},{"name":"队列","des":"先进先出的双开口线性表，缓冲与排队的天然形态。","symbolSize":40,"category":"数据结构"},{"name":"哈希表","des":"以哈希函数把键散列进桶数组，平均 O(1) 存取的查找支柱。","symbolSize":70,"category":"数据结构"},{"name":"二叉搜索树","des":"左子树小、右子树大的有序二叉树，中序遍历即得升序。","symbolSize":40,"category":"数据结构"},{"name":"平衡树","des":"用旋转把左右高度差摁在常数内的搜索树，AVL 与红黑树是代表。","symbolSize":40,"category":"数据结构"},{"name":"堆","des":"父节点恒不劣于子节点的完全二叉树，优先队列的标准骨架。","symbolSize":40,"category":"数据结构"},{"name":"B树","des":"为磁盘而生的多路平衡搜索树，节点大而树身矮，省 IO 次数。","symbolSize":40,"category":"数据结构"},{"name":"图","des":"顶点加边的数学结构，一切关系网络的通用建模语言。","symbolSize":50,"category":"数据结构"},{"name":"Trie","des":"以字符为边的多叉树，公共前缀共享路径，查词如顺藤摸瓜。","symbolSize":40,"category":"数据结构"},{"name":"跳表","des":"给有序链表叠加多级索引，以概率分层换二分般的跳跃查找。","symbolSize":40,"category":"数据结构"},{"name":"哈希函数","des":"把任意键压成定长地址的映射，均匀性决定哈希表的生死。","symbolSize":40,"category":"数据结构"},{"name":"优先队列","des":"不按先来后到、按优先级出队的抽象类型，永远先吐最紧的。","symbolSize":40,"category":"数据结构"},{"name":"邻接表","des":"每个顶点挂一条邻居链表的存图法，稀疏图的省内存之选。","symbolSize":40,"category":"数据结构"},{"name":"布隆过滤器","des":"多位哈希联合判存在：说不存在必不存在，说存在可能误报。","symbolSize":40,"category":"数据结构"},{"name":"快速排序","des":"选基准分区再递归，平均 O(n log n) 的原地排序实践之王。","symbolSize":50,"category":"算法"},{"name":"归并排序","des":"对半排好再合并，稳定且最坏仍 O(n log n)，外部排序主力。","symbolSize":40,"category":"算法"},{"name":"堆排序","des":"建堆后反复取堆顶，原地且最坏 O(n log n) 的稳妥派。","symbolSize":40,"category":"算法"},{"name":"二分查找","des":"每比较一次淘汰一半候选，O(log n) 的前提是有序。","symbolSize":50,"category":"算法"},{"name":"深度优先搜索","des":"一条路走到黑、无路再回头的图遍历，回溯与割边的母体。","symbolSize":50,"category":"算法"},{"name":"广度优先搜索","des":"从近到远逐层扩散的遍历，无权图中首次到达即最短。","symbolSize":50,"category":"算法"},{"name":"Dijkstra","des":"每次敲定当前最近的顶点，求单源最短路，要求边权非负。","symbolSize":50,"category":"算法"},{"name":"动态规划","des":"拆成重叠子问题并记住答案，空间换时间的不二心法。","symbolSize":50,"category":"算法"},{"name":"贪心算法","des":"每步只取当下最优，有时恰好通向全局最优，有时谬以千里。","symbolSize":40,"category":"算法"},{"name":"分治","des":"分割、递归、合并三步曲，快排与归并共同的母题。","symbolSize":40,"category":"算法"},{"name":"回溯","des":"深搜试探、碰壁即退，解空间中有序的穷举与悔棋。","symbolSize":40,"category":"算法"},{"name":"KMP","des":"失配时按前缀函数滑移模式串，主串指针永不回头。","symbolSize":40,"category":"算法"},{"name":"拓扑排序","des":"把依赖关系排成线性序列，有向无环图的专属操作。","symbolSize":40,"category":"算法"},{"name":"最小生成树","des":"以 n-1 条边连通全部顶点且总权最小的生成树。","symbolSize":40,"category":"算法"},{"name":"双指针","des":"两个下标协同推进，把嵌套循环压成一次线性扫描。","symbolSize":40,"category":"算法"},{"name":"递归","des":"函数调用自身求解，大问题化小的第一直觉。","symbolSize":40,"category":"算法"},{"name":"大O记号","des":"描述函数增长率的渐近上界，抹去常数只看量级。","symbolSize":50,"category":"计算理论"},{"name":"时间复杂度","des":"运行时间随输入规模增长的阶数，算法快慢的通用标尺。","symbolSize":70,"category":"计算理论"},{"name":"空间复杂度","des":"算法额外占用的内存随输入规模增长的阶，空间账本。","symbolSize":40,"category":"计算理论"},{"name":"图灵机","des":"无限纸带加读写头的假想机器，一切可计算性的基准模型。","symbolSize":50,"category":"计算理论"},{"name":"可计算性","des":"研究哪些问题存在算法解，为计算能力画出边界。","symbolSize":40,"category":"计算理论"},{"name":"停机问题","des":"判定任意程序会否终止的问题，被证明不可判定。","symbolSize":40,"category":"计算理论"},{"name":"P与NP问题","des":"多项式可解与多项式可验证是否同一世界，千禧年悬赏难题。","symbolSize":50,"category":"计算理论"},{"name":"NP完全","des":"NP 中最难的一族问题，其一有多项式解则全线失守。","symbolSize":40,"category":"计算理论"},{"name":"状态机","des":"有限状态随事件迁移的模型，协议与电路的共同语言。","symbolSize":40,"category":"计算理论"},{"name":"正则表达式","des":"描述正则语言的紧凑模式串，与有限自动机等价。","symbolSize":40,"category":"计算理论"},{"name":"丘奇-图灵论题","des":"直觉上可计算的都可由图灵机计算，计算的定义性假设。","symbolSize":40,"category":"计算理论"},{"name":"归约","des":"把一个问题改装成另一个问题的桥梁，证明难度的钥匙。","symbolSize":40,"category":"计算理论"},{"name":"形式语言","des":"按文法规则生成符号串的体系，乔姆斯基谱系分层。","symbolSize":40,"category":"计算理论"},{"name":"旅行商问题","des":"走遍所有城市再回到起点的最短回路，NP 完全的代言人。","symbolSize":40,"category":"计算理论"},{"name":"布尔逻辑","des":"与或非构成的代数体系，硬件电路与查询条件的共同根基。","symbolSize":40,"category":"计算理论"},{"name":"进程","des":"程序的一次运行实例，操作系统资源分配的基本单位。","symbolSize":70,"category":"操作系统"},{"name":"线程","des":"进程内独立执行的流，CPU 调度的基本单位。","symbolSize":50,"category":"操作系统"},{"name":"调度","des":"决定下一个占用 CPU 的是谁，公平与吞吐的平衡术。","symbolSize":40,"category":"操作系统"},{"name":"死锁","des":"互相持有对方所需资源而永久僵持的环形等待。","symbolSize":50,"category":"操作系统"},{"name":"互斥锁","des":"同一时刻只放一个执行流进临界区的最基础锁具。","symbolSize":40,"category":"操作系统"},{"name":"虚拟内存","des":"给每个进程一套独立连续地址空间的抽象，隔离与扩容兼得。","symbolSize":50,"category":"操作系统"},{"name":"分页","des":"把地址空间切成固定大小的页，按需装入物理页框。","symbolSize":40,"category":"操作系统"},{"name":"页面置换算法","des":"内存已满时决定牺牲哪一页，LRU 是教科书答案。","symbolSize":40,"category":"操作系统"},{"name":"文件系统","des":"把磁盘块组织成文件与目录树的命名存储体系。","symbolSize":40,"category":"操作系统"},{"name":"系统调用","des":"用户程序请求内核服务的唯一正规入口。","symbolSize":50,"category":"操作系统"},{"name":"中断","des":"硬件打断 CPU 当前工作请求处理的信号，事件驱动之源。","symbolSize":40,"category":"操作系统"},{"name":"上下文切换","des":"保存旧执行流现场、恢复新执行流现场的换人开销。","symbolSize":40,"category":"操作系统"},{"name":"信号量","des":"计数器配等待队列，P/V 操作撑起同步与互斥。","symbolSize":40,"category":"操作系统"},{"name":"页缓存","des":"内核在内存里暂存磁盘数据的缓冲，读写的加速带。","symbolSize":40,"category":"操作系统"},{"name":"内核","des":"掌管硬件并为上层程序服务的操作系统核心。","symbolSize":40,"category":"操作系统"},{"name":"OSI模型","des":"网络互连的七层概念蓝图，分层解耦的教学宪法。","symbolSize":40,"category":"计算机网络"},{"name":"TCP/IP","des":"事实上的互联网协议族，四层结构承载全球通信。","symbolSize":50,"category":"计算机网络"},{"name":"IP协议","des":"为主机编址并尽力而为转发数据包的网络层基石。","symbolSize":40,"category":"计算机网络"},{"name":"TCP","des":"面向连接、可靠按序的传输层旗舰，互联网的托底者。","symbolSize":70,"category":"计算机网络"},{"name":"UDP","des":"无连接、不保序的轻量传输，省去寒暄只求快。","symbolSize":40,"category":"计算机网络"},{"name":"三次握手","des":"SYN、SYN-ACK、ACK 三报文敲定 TCP 连接的开场礼。","symbolSize":40,"category":"计算机网络"},{"name":"DNS","des":"把域名翻译成 IP 地址的分布式目录服务。","symbolSize":40,"category":"计算机网络"},{"name":"HTTP","des":"浏览器与服务器间请求与响应的应用层通用语。","symbolSize":40,"category":"计算机网络"},{"name":"HTTPS","des":"在 HTTP 外层加 TLS，加密信道兼验证身份。","symbolSize":40,"category":"计算机网络"},{"name":"路由","des":"为分组逐跳选择穿越网络路径的转发决策。","symbolSize":40,"category":"计算机网络"},{"name":"NAT","des":"在边界改写地址与端口，让私网共享一个公网 IP。","symbolSize":40,"category":"计算机网络"},{"name":"以太网","des":"以帧和 MAC 编址统治局域网的链路层标准。","symbolSize":40,"category":"计算机网络"},{"name":"MAC地址","des":"烧录在网卡里的链路层地址，本地网段的门牌号。","symbolSize":40,"category":"计算机网络"},{"name":"交换机","des":"按 MAC 地址表在端口间转发帧的局域网枢纽。","symbolSize":40,"category":"计算机网络"},{"name":"拥塞控制","des":"TCP 感知网络拥堵自动降速再爬升的自愈机制。","symbolSize":40,"category":"计算机网络"},{"name":"分组交换","des":"数据切成分组各自寻路转发的交换方式，互联网的基因。","symbolSize":40,"category":"计算机网络"},{"name":"关系模型","des":"以元组与属性组织数据的二维表体系，建立在集合论之上。","symbolSize":40,"category":"数据库"},{"name":"SQL","des":"声明式数据库语言：说清要什么，无需交代怎么拿。","symbolSize":70,"category":"数据库"},{"name":"事务","des":"一组操作要么全部生效、要么全然未发生的执行单元。","symbolSize":40,"category":"数据库"},{"name":"ACID","des":"原子、一致、隔离、持久，可靠事务的四字箴言。","symbolSize":50,"category":"数据库"},{"name":"索引","des":"以空间换时间的查找捷径，查询提速的第一杠杆。","symbolSize":40,"category":"数据库"},{"name":"B+树","des":"内节点当路标、叶子串成有序链表的多路树，磁盘 IO 的驯服者。","symbolSize":50,"category":"数据库"},{"name":"主键","des":"唯一标识表中一行且不许为空的列，行的身份证。","symbolSize":40,"category":"数据库"},{"name":"外键","des":"引用他表主键的约束，替数据库看守引用完整性。","symbolSize":40,"category":"数据库"},{"name":"范式","des":"逐级消除冗余与更新异常的表结构设计规范。","symbolSize":40,"category":"数据库"},{"name":"隔离级别","des":"事务间互不见的程度，从读未提交到串行化逐级加严。","symbolSize":40,"category":"数据库"},{"name":"连接查询","des":"按匹配条件把多张表横向拼成一个结果集的操作。","symbolSize":40,"category":"数据库"},{"name":"视图","des":"以查询语句定义的虚拟表，简化访问兼作安全幕布。","symbolSize":40,"category":"数据库"},{"name":"事务日志","des":"先写日志再改数据，崩溃恢复的救命底账。","symbolSize":40,"category":"数据库"},{"name":"MVCC","des":"保留多版本快照让读写互不阻塞，高并发读的常胜法。","symbolSize":40,"category":"数据库"}],"links":[{"source":"数组","target":"链表","name":"对照","des":"连续与离散两种存法，定下随机访问与插删的取舍。"},{"source":"栈","target":"队列","name":"对照","des":"后进先出与先进先出，两种出入纪律各司其职。"},{"source":"哈希表","target":"数组","name":"基于","des":"底层以数组作桶，键经散列落到具体下标。"},{"source":"哈希函数","target":"哈希表","name":"定址","des":"键先经哈希函数压成下标，再入桶存取。"},{"source":"链表","target":"跳表","name":"叠层","des":"在有序链表上叠加多级索引，才有跳跃查找。"},{"source":"二叉搜索树","target":"平衡树","name":"催生","des":"BST 最坏退化成链表，旋转平衡应运而生。"},{"source":"平衡树","target":"B树","name":"推广","des":"二叉改多叉、按块分叉，迁就磁盘读取习性。"},{"source":"堆","target":"优先队列","name":"实现","des":"小顶堆出堆顶即最小元，是优先队列的标准实现。"},{"source":"堆","target":"数组","name":"存于","des":"完全二叉树按层序隐式存进数组，无需指针。"},{"source":"图","target":"邻接表","name":"存为","des":"每个顶点挂一条邻居链，稀疏图最省内存。"},{"source":"邻接表","target":"数组","name":"依托","des":"表头是数组，数组每格再串邻居链表。"},{"source":"布隆过滤器","target":"哈希函数","name":"复用","des":"多个哈希函数联合投票，才敢断言不存在。"},{"source":"快速排序","target":"分治","name":"遵循","des":"每轮分区把大数组拆成两段小问题。"},{"source":"归并排序","target":"分治","name":"遵循","des":"对半切开、各自排好，再合并成一路。"},{"source":"动态规划","target":"分治","name":"接棒","des":"子问题重叠时分治重复计算，DP 记答案接棒。"},{"source":"递归","target":"归并排序","name":"驱动","des":"自顶向下不断二分，递归到单元再回头合并。"},{"source":"动态规划","target":"递归","name":"记忆化","des":"给递归加上备忘录，重复子问题只算一次。"},{"source":"深度优先搜索","target":"回溯","name":"推广","des":"深搜加撤销与候选生成，即成回溯法。"},{"source":"Dijkstra","target":"贪心算法","name":"基于","des":"每轮敲定当前最近的未定顶点，是贪心策略。"},{"source":"Dijkstra","target":"广度优先搜索","name":"退化为","des":"边权全为 1 时，Dijkstra 就是逐层 BFS。"},{"source":"最小生成树","target":"贪心算法","name":"基于","des":"Kruskal 取短边、Prim 长树，皆为贪心。"},{"source":"拓扑排序","target":"深度优先搜索","name":"借力","des":"深搜完成顺序的逆序恰是一个拓扑序。"},{"source":"双指针","target":"二分查找","name":"借意","des":"双指针在线性结构上模拟二分的收缩步伐。"},{"source":"贪心算法","target":"动态规划","name":"对照","des":"贪心每步不回头，DP 保留所有子问题答案。"},{"source":"大O记号","target":"时间复杂度","name":"刻画","des":"用渐近上界描述运行时间的增长阶。"},{"source":"时间复杂度","target":"空间复杂度","name":"权衡","des":"时间与空间常可互换，鱼与熊掌的抉择。"},{"source":"图灵机","target":"可计算性","name":"界定","des":"图灵机算得出的，才叫可计算。"},{"source":"停机问题","target":"可计算性","name":"反例","des":"停机不可判定，为可计算性划出天花板。"},{"source":"图灵机","target":"停机问题","name":"催生","des":"对角线论证证明没有通用停机判定器。"},{"source":"P与NP问题","target":"NP完全","name":"包含","des":"NP 完全是 NP 中最难的一小撮。"},{"source":"NP完全","target":"归约","name":"证明","des":"把已知难题归约过来，即证新问题同样难。"},{"source":"归约","target":"P与NP问题","name":"回答","des":"任一 NPC 问题有多项式解，P 即等于 NP。"},{"source":"旅行商问题","target":"NP完全","name":"属于","des":"其判定版本是最早一批被证明的 NPC 问题。"},{"source":"状态机","target":"正则表达式","name":"等价","des":"有限自动机与正则表达式表达同一族语言。"},{"source":"形式语言","target":"状态机","name":"对应","des":"乔姆斯基 3 型文法恰是有限自动机。"},{"source":"丘奇-图灵论题","target":"图灵机","name":"注解","des":"一切直觉可计算的都落在图灵机的能力圈内。"},{"source":"形式语言","target":"图灵机","name":"对齐","des":"0 型文法与图灵机生成同一类语言。"},{"source":"布尔逻辑","target":"状态机","name":"构造","des":"组合逻辑加状态寄存器，即拼出时序电路。"},{"source":"进程","target":"线程","name":"包含","des":"一个进程可挂多个线程，共享同一地址空间。"},{"source":"调度","target":"进程","name":"编排","des":"从就绪进程里挑下一个上 CPU 的幸运儿。"},{"source":"调度","target":"上下文切换","name":"引发","des":"换了人选就得换现场，调度必付切换成本。"},{"source":"线程","target":"上下文切换","name":"触发","des":"线程让出 CPU 前先存现场，回来再恢复。"},{"source":"互斥锁","target":"死锁","name":"诱因","des":"交叉持锁又互相等待，便锁成死结。"},{"source":"信号量","target":"互斥锁","name":"泛化","des":"互斥锁可视作只取 0 和 1 的二元信号量。"},{"source":"虚拟内存","target":"分页","name":"实现于","des":"主流做法是分页：切页、映射、按需调入。"},{"source":"分页","target":"页面置换算法","name":"配合","des":"页框不够时由置换算法决定请谁出局。"},{"source":"页面置换算法","target":"虚拟内存","name":"服务于","des":"置换策略的好坏直接决定缺页代价。"},{"source":"文件系统","target":"页缓存","name":"借道","des":"读写文件先过页缓存，热门数据不必碰盘。"},{"source":"内核","target":"系统调用","name":"提供","des":"系统调用是内核向用户程序开放的服务窗口。"},{"source":"系统调用","target":"中断","name":"实现于","des":"软陷入本质上就是一种受控中断。"},{"source":"中断","target":"调度","name":"触发","des":"时钟中断定期叫醒调度器重新选人。"},{"source":"进程","target":"虚拟内存","name":"隔离","des":"每个进程独享一套虚拟地址空间，互不越界。"},{"source":"OSI模型","target":"TCP/IP","name":"对照","des":"七层理论蓝图与四层工程实现的相互映照。"},{"source":"TCP/IP","target":"IP协议","name":"包含","des":"IP 是整个协议族的网络层基石。"},{"source":"TCP","target":"IP协议","name":"基于","des":"TCP 段封装进 IP 包，交给 IP 送达对端。"},{"source":"UDP","target":"IP协议","name":"基于","des":"UDP 同样借 IP 传包，只是不操心可靠。"},{"source":"TCP","target":"三次握手","name":"始于","des":"SYN、SYN-ACK、ACK 三步敲定连接。"},{"source":"TCP","target":"拥塞控制","name":"内含","des":"拥塞窗口随丢包与超时自适应伸缩。"},{"source":"HTTP","target":"TCP","name":"基于","des":"HTTP 报文交由 TCP 可靠信道护送。"},{"source":"HTTPS","target":"HTTP","name":"封装","des":"HTTP 原封不动，外层多套一圈 TLS。"},{"source":"DNS","target":"HTTP","name":"先行","des":"发请求前先问 DNS：这个域名住哪个 IP。"},{"source":"DNS","target":"UDP","name":"多用","des":"传统查询走 UDP 53 端口，一来一回图快。"},{"source":"IP协议","target":"MAC地址","name":"衔接","des":"靠 ARP 把下一跳 IP 翻译成 MAC 才能封帧。"},{"source":"路由","target":"IP协议","name":"转发","des":"按目的 IP 查表选下一跳，逐站接力。"},{"source":"NAT","target":"IP协议","name":"改写","des":"出口处改写 IP 与端口，私网集体隐身。"},{"source":"以太网","target":"MAC地址","name":"编址","des":"帧按 MAC 地址在本地链路投递。"},{"source":"交换机","target":"以太网","name":"组网","des":"交换机互联各网段，织成星型以太网。"},{"source":"交换机","target":"MAC地址","name":"查表","des":"按 MAC 地址表把帧精准发往端口。"},{"source":"分组交换","target":"IP协议","name":"实践","des":"IP 网络是分组交换思想最大的实践场。"},{"source":"OSI模型","target":"以太网","name":"归属","des":"以太网居于 OSI 的链路层与物理层。"},{"source":"关系模型","target":"SQL","name":"语言化","des":"SQL 是关系代数披上了可执行的语法外衣。"},{"source":"关系模型","target":"主键","name":"要求","des":"表中的每个元组都得有唯一标识。"},{"source":"外键","target":"主键","name":"引用","des":"外键指着别家主键，表间关系由此建立。"},{"source":"事务","target":"ACID","name":"保证","des":"四条性质合起来，才配叫可靠事务。"},{"source":"ACID","target":"隔离级别","name":"细化","des":"隔离性按强弱分四级，越强越不互相干扰。"},{"source":"隔离级别","target":"MVCC","name":"实现","des":"快照隔离靠多版本实现读写互不阻塞。"},{"source":"索引","target":"B+树","name":"采用","des":"主流数据库索引几乎都落地为 B+ 树。"},{"source":"范式","target":"关系模型","name":"规范","des":"逐级消除冗余与异常，把表磨得更规矩。"},{"source":"连接查询","target":"主键","name":"依托","des":"主外键是连接最自然的匹配条件。"},{"source":"视图","target":"SQL","name":"定义于","des":"视图就是一条起好名字的查询语句。"},{"source":"事务日志","target":"ACID","name":"兑现","des":"先写日志再改数据，崩溃后原子与持久有据可查。"},{"source":"SQL","target":"索引","name":"命中","des":"优化器决定走不走索引、走哪一个。"},{"source":"SQL","target":"连接查询","name":"表达","des":"JOIN 子句把多张表横向拼成宽结果。"},{"source":"MVCC","target":"事务","name":"服务","des":"并发事务各读各的快照，互不打扰。"},{"source":"堆排序","target":"堆","name":"取材","des":"建堆再反复取堆顶，天然长在堆结构上。"},{"source":"二分查找","target":"数组","name":"要求","des":"要下标直达又要有序，只有数组两者兼得。"},{"source":"深度优先搜索","target":"栈","name":"借助","des":"显式栈或调用栈替深搜记住回头路。"},{"source":"广度优先搜索","target":"队列","name":"借助","des":"队列保证一层放完才放下一层。"},{"source":"递归","target":"栈","name":"依赖","des":"函数调用栈本身就是栈结构的应用。"},{"source":"深度优先搜索","target":"图","name":"遍历","des":"沿边一头扎到底，无路可走再回头换道。"},{"source":"广度优先搜索","target":"图","name":"遍历","des":"从源点逐层向外染，染到即记录距离。"},{"source":"Dijkstra","target":"图","name":"作用于","des":"在边权非负的图上求单源最短路。"},{"source":"Dijkstra","target":"堆","name":"加速于","des":"小顶堆把每轮选最近点降到对数代价。"},{"source":"拓扑排序","target":"图","name":"前提","des":"只有有向无环图才排得出拓扑序。"},{"source":"最小生成树","target":"图","name":"作用于","des":"在带权连通图上挑出总权最小的连边集。"},{"source":"双指针","target":"数组","name":"游走于","des":"两个下标在数组两端或同侧协同推进。"},{"source":"跳表","target":"二分查找","name":"逼近","des":"多级索引让链表摸到二分的效率。"},{"source":"Trie","target":"KMP","name":"结合","des":"Trie 骨架加失配指针，即成 AC 自动机。"},{"source":"时间复杂度","target":"快速排序","name":"标注","des":"平均 O(n log n)，最坏退化 O(n²)。"},{"source":"时间复杂度","target":"二分查找","name":"标注","des":"每轮折半，O(log n) 稳定不飘。"},{"source":"时间复杂度","target":"动态规划","name":"标注","des":"子问题数乘单个子问题代价，即总复杂度。"},{"source":"大O记号","target":"Dijkstra","name":"标注","des":"堆优化后为 O((V+E)logV)。"},{"source":"空间复杂度","target":"动态规划","name":"权衡","des":"滚动数组可把 DP 表压到一维。"},{"source":"时间复杂度","target":"哈希表","name":"标注","des":"平均 O(1) 存取，最坏 O(n) 的退化赌注。"},{"source":"旅行商问题","target":"图","name":"巡行于","des":"在带权完全图上找最短哈密顿回路。"},{"source":"状态机","target":"TCP","name":"建模","des":"TCP 连接生命周期就是一张状态迁移图。"},{"source":"布尔逻辑","target":"SQL","name":"支撑","des":"WHERE 里的 AND、OR、NOT 即布尔表达式。"},{"source":"调度","target":"优先队列","name":"应用","des":"就绪队列按优先级取下一个上 CPU 者。"},{"source":"页面置换算法","target":"哈希表","name":"实现于","des":"LRU 常用哈希表加双向链表做到 O(1)。"},{"source":"分页","target":"Trie","name":"形似","des":"多级页号逐级索引，如字符树按位寻径。"},{"source":"死锁","target":"图","name":"建模","des":"资源分配图有环是死锁的必要形态。"},{"source":"系统调用","target":"TCP/IP","name":"入口","des":"应用经 socket 调用步入内核协议栈。"},{"source":"系统调用","target":"UDP","name":"经由","des":"收发 UDP 数据报同样走套接字调用。"},{"source":"B+树","target":"B树","name":"演化","des":"数据全落叶子并串成链表，范围查询更顺手。"},{"source":"索引","target":"哈希表","name":"另有","des":"哈希索引等值快，却不支持范围扫描。"},{"source":"B+树","target":"页缓存","name":"贴近","des":"节点大小对齐页，让每次 IO 物有所值。"},{"source":"事务日志","target":"文件系统","name":"承载","des":"日志终究要以文件形式落进文件系统。"},{"source":"死锁","target":"事务","name":"复现","des":"锁等待环是数据库里死锁的经典现场。"},{"source":"归并排序","target":"链表","name":"亲和","des":"归并在链表上合并无需额外空间，是首选。"},{"source":"拓扑排序","target":"邻接表","name":"存于","des":"邻接表是拓扑排序最常用的输入形态。"},{"source":"时间复杂度","target":"归并排序","name":"标注","des":"最坏情况仍是 O(n log n)，稳定不退化。"},{"source":"空间复杂度","target":"递归","name":"计入","des":"递归深度就是调用栈的空间账单。"},{"source":"文件系统","target":"B树","name":"取材","des":"文件系统索引多用 B 树家族对抗磁盘慢速。"},{"source":"中断","target":"状态机","name":"驱动","des":"中断处理按状态机组织各步流转。"},{"source":"交换机","target":"队列","name":"缓冲","des":"端口输出队列暂存排队待发的帧。"},{"source":"路由","target":"图","name":"抽象为","des":"网络拓扑即带权图，路由是图上选路问题。"},{"source":"事务","target":"互斥锁","name":"借用","des":"两阶段锁用互斥思想给事务排座位。"},{"source":"SQL","target":"图灵机","name":"逼近","des":"加上递归 CTE，SQL 便图灵完备。"},{"source":"索引","target":"二分查找","name":"呼应","des":"B+ 树叶页内按键二分定位记录。"},{"source":"三次握手","target":"状态机","name":"演绎","des":"从 SYN_SENT 到 ESTABLISHED 的经典迁移。"},{"source":"贪心算法","target":"调度","name":"现身","des":"最短作业优先正是贪心在调度中的身影。"}]}