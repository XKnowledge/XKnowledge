t":"发酵醪","name":"前提","des":"没有低度酒液，就没有蒸馏的原料。"},{"source":"发酵醪","target":"壶式蒸馏器","name":"入壶","des":"分批慢蒸的传统线。"},{"source":"发酵醪","target":"塔式蒸馏器","name":"入塔","des":"连续高效的现代线。"},{"source":"壶式蒸馏器","target":"塔式蒸馏器","name":"对照","des":"一个保风味，一个求纯净。"},{"source":"壶式蒸馏器","target":"铜的催化","name":"器壁","des":"铜壁吃掉硫化物，粗辣变柔顺。"},{"source":"蒸馏原理","target":"酒头酒心酒尾","name":"切割","des":"掐头去尾，只取中段酒心。"},{"source":"酒头酒心酒尾","target":"新酒","name":"产出","des":"切割之后，得到无色的新酒。"},{"source":"新酒","target":"桶陈工艺","name":"入桶","des":"白纸入桶，颜色香气全靠桶与时间。"},{"source":"蒸馏原理","target":"稀释与装瓶度数","name":"末笔","des":"从桶强到四十度，加水的最后一步。"},{"source":"苏格兰威士忌","target":"斯佩塞","name":"谷仓","des":"酒厂最密的果甜谷地。"},{"source":"苏格兰威士忌","target":"艾雷岛","name":"海风","des":"泥煤与海盐的重烟要塞。"},{"source":"苏格兰威士忌","target":"高地","name":"拼图","des":"风格跨度最大的辽阔产区。"},{"source":"苏格兰威士忌","target":"低地","name":"清淡","des":"轻柔入口派与谷物基地。"},{"source":"苏格兰威士忌","target":"坎贝尔敦","name":"遗韵","des":"从数十家衰落到三家的半岛余晖。"},{"source":"艾雷岛","target":"泥煤","name":"燃料","des":"烘麦烧泥煤，烟熏印章盖在每滴酒上。"},{"source":"泥煤","target":"泥煤度","name":"度量","des":"苯酚含量把烟熏变成可读数字。"},{"source":"苏格兰威士忌","target":"单一麦芽","name":"宣言","des":"一家酒厂的个性签名。"},{"source":"苏格兰威士忌","target":"调和威士忌","name":"交响","des":"几十种麦芽与谷物的调配艺术。"},{"source":"单一麦芽","target":"调和威士忌","name":"对照","des":"独奏与乐团的市场之争。"},{"source":"格兰菲迪","target":"单一麦芽","name":"点火","des":"一九六三年率先大规模出口，单麦浪潮自此启动。"},{"source":"麦卡伦","target":"雪莉桶","name":"深耕","des":"把雪莉桶做成品牌护城河。"},{"source":"斯佩塞","target":"麦卡伦","name":"一员","des":"斯佩塞河畔的雪莉桶标杆。"},{"source":"拉弗格","target":"艾雷岛","name":"极端","des":"药用烟熏的最重一端。"},{"source":"世界威士忌","target":"爱尔兰威士忌","name":"长兄","des":"蒸馏术最早职业化的产地之一。"},{"source":"爱尔兰威士忌","target":"壶式蒸馏器","name":"三馏","des":"传统三次蒸馏的柔顺路线。"},{"source":"世界威士忌","target":"波本","name":"玉米","des":"新炭化桶酿出的焦糖香草。"},{"source":"波本","target":"波本桶","name":"一次","des":"法规限定新桶，用过就退役出口。"},{"source":"世界威士忌","target":"田纳西威士忌","name":"滤炭","des":"枫木炭过滤的南方工序。"},{"source":"田纳西威士忌","target":"波本","name":"近亲","des":"工艺同源，多一道滤炭的身份差。"},{"source":"世界威士忌","target":"黑麦威士忌","name":"辛香","des":"老派鸡尾酒的香料骨干。"},{"source":"世界威士忌","target":"加拿大威士忌","name":"轻调","des":"最柔和的调和传统。"},{"source":"世界威士忌","target":"日本威士忌","name":"学徒","des":"苏格兰取经，东方审美落地。"},{"source":"日本威士忌","target":"山崎","name":"起点","des":"一九二三年日本第一座麦芽蒸馏所。"},{"source":"日本威士忌","target":"响","name":"调和","des":"三得利的调和美学旗舰。"},{"source":"世界威士忌","target":"噶玛兰","name":"新星","des":"亚热带熟成速度的台湾答卷。"},{"source":"桶陈工艺","target":"美国白橡木与欧洲橡木","name":"选木","des":"两种橡木的两套风味语法。"},{"source":"美国白橡木与欧洲橡木","target":"波本桶","name":"取材","des":"美国新桶的香草甜与快熟。"},{"source":"桶陈工艺","target":"炭化与烘烤","name":"火候","des":"火燎桶壁，给木头开风味通道。"},{"source":"炭化与烘烤","target":"波本","name":"焦糖","des":"炭化层烧出的红糖香草香。"},{"source":"桶陈工艺","target":"雪莉桶","name":"二手","des":"西班牙酒桶的二次就业。"},{"source":"桶陈工艺","target":"过桶熟成","name":"补课","des":"桶尾换桶短时借香的收尾手法。"},{"source":"雪莉桶","target":"过桶熟成","name":"源头","des":"换桶玩法最早正来自雪莉桶实验。"},{"source":"桶陈工艺","target":"天使分享","name":"蒸发","des":"每年交给天使的租金。"},{"source":"桶陈工艺","target":"桶强原酒","name":"不掺","des":"出桶原度装瓶的浓度派。"},{"source":"桶陈工艺","target":"单桶","name":"独一","des":"单独一只桶的限定编号。"},{"source":"桶陈工艺","target":"陈年时限","name":"法定","des":"三年橡桶起步才有名分。"},{"source":"桶陈工艺","target":"索莱拉","name":"叠代","des":"层层补桶的混龄系统。"},{"source":"天使分享","target":"陈年时限","name":"折损","des":"年份越高存量越少，价格的算术。"},{"source":"烈酒家族","target":"白兰地","name":"总门","des":"葡萄酒蒸馏的大家族。"},{"source":"白兰地","target":"干邑","name":"名片","des":"夏朗德双重壶馏的法定产区。"},{"source":"白兰地","target":"雅文邑","name":"老派","des":"更古老更小众的西南土法。"},{"source":"干邑","target":"壶式蒸馏器","name":"同器","des":"双重壶馏是法定工序。"},{"source":"白兰地","target":"葡萄渣白兰地","name":"榨干","des":"果渣的第二次生命。"},{"source":"烈酒家族","target":"朗姆酒","name":"甘蔗","des":"糖蜜蒸馏的海洋烈酒。"},{"source":"朗姆酒","target":"农业朗姆","name":"分野","des":"糖蜜派与甘蔗汁派的风土之争。"},{"source":"烈酒家族","target":"龙舌兰","name":"沙漠","des":"龙舌兰草心八年一熟的等待。"},{"source":"龙舌兰","target":"特基拉","name":"名分","des":"只限蓝色龙舌兰与法定产区。"},{"source":"龙舌兰","target":"梅斯卡尔","name":"土法","des":"窑烧烟熏的乡村路线。"},{"source":"烈酒家族","target":"伏特加","name":"极简","des":"中性无味的纯粹派。"},{"source":"伏特加","target":"塔式蒸馏器","name":"极致","des":"连续蒸馏加过滤的极限提纯。"},{"source":"烈酒家族","target":"金酒","name":"药酒","des":"杜松子起家的荷兰药汤。"},{"source":"金酒","target":"汤力水与金汤力","name":"传奇","des":"奎宁水从抗疟药变成经典高球。"},{"source":"烈酒家族","target":"中国白酒","name":"东亚","des":"固态发酵的独立路线。"},{"source":"中国白酒","target":"酱香与浓香","name":"分香","des":"两大香型的风味分野。"},{"source":"烈酒家族","target":"烧酒与泡盛","name":"米系","des":"米与薯的东亚低度蒸馏传统。"},{"source":"风味与品饮","target":"威士忌风味轮","name":"词典","des":"从果香到烟熏的标准词表。"},{"source":"风味与品饮","target":"泥煤度","name":"仪表","des":"把烟熏变成可比的数字。"},{"source":"泥煤度","target":"艾雷岛","name":"度尺","des":"艾雷岛的酒标常把苯酚值当卖点。"},{"source":"风味与品饮","target":"纯净加水之辩","name":"争议","des":"一滴水能否撑开香气的口水仗。"},{"source":"风味与品饮","target":"冰球与老冰","name":"降温","des":"慢融大冰的降温美学。"},{"source":"风味与品饮","target":"嗨棒","name":"苏打","des":"威士忌苏打的日式复兴。"},{"source":"嗨棒","target":"日本威士忌","name":"推手","des":"居酒屋嗨棒让日威销量起飞。"},{"source":"风味与品饮","target":"古典鸡尾酒","name":"元祖","des":"最古老配方的活化石。"},{"source":"风味与品饮","target":"曼哈顿","name":"之后","des":"味美思与威士忌的联姻经典。"},{"source":"风味与品饮","target":"威士忌酸","name":"酸甜","des":"柠檬糖浆的结构课。"},{"source":"黑麦威士忌","target":"曼哈顿","name":"骨架","des":"老派曼哈顿本就用黑麦。"},{"source":"波本","target":"古典鸡尾酒","name":"标配","des":"焦甜波本撑得起老式配方。"},{"source":"风味与品饮","target":"格兰凯恩杯","name":"聚香","des":"郁金香杯的行业品鉴标准。"},{"source":"风味与品饮","target":"收藏与拍卖","name":"行情","des":"稀缺年份的价格火箭。"},{"source":"雪莉桶","target":"麦卡伦","name":"成全","des":"雪莉桶的声誉一半由麦卡伦写就。"},{"source":"索莱拉","target":"朗姆酒","name":"借用","des":"陈年朗姆常借索莱拉系统混龄。"}]}