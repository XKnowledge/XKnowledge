{
  "version": 2,
  "title": "姓氏与谱系学",
  "description": "姓别婚姻，氏别贵贱：从上古八大姓到明清字辈诗，从郡望门阀到洪洞大槐树，再到基因追溯与全球家谱数据库——一部关于「我们是谁的后人」的学问。",
  "nodes": [
    { "name": "姓氏与谱系学", "des": "研究姓氏起源流变与世系传承的学问：姓与氏如何分合，谱牒如何书写，字辈如何排序，以及今天如何用文献与基因双重证据追溯每一位祖先。", "symbolSize": 70, "category": "姓与氏的起源" },
    { "name": "姓", "des": "标示血缘出生的符号，「姓者生也」，源于母系氏族，上古同姓不婚，故古姓多从女旁：姬、姜、嬴、姒皆是。", "symbolSize": 50, "category": "姓与氏的起源" },
    { "name": "氏", "des": "姓的分支，「氏者支也」，用以别贵贱、分族系，卿大夫以封地、官职为氏，秦汉以后姓氏合一，混而不再分。", "symbolSize": 50, "category": "姓与氏的起源" },
    { "name": "上古八大姓", "des": "姬、姜、嬴、姒、妘、妫、姚、姞八姓，皆带女旁，是母系社会的血缘印记，后世姓氏大半由此分衍而来。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "姬姓", "des": "黄帝之姓、周室国姓，分封诸侯遍及天下，衍生出周、吴、郑、王、鲁、魏等数百氏，是「万姓之祖」的第一候选。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "姜姓", "des": "炎帝之姓，与姬姓世代联姻，齐、吕、许、谢皆其后，从封国到辣椒，这个字在汉语里始终火气不减。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "图腾起源说", "des": "姓氏起源的主流假说之一：原始氏族以动植物或自然物为图腾标识，龙、马、牛、云等姓氏用字里仍可辨认其残影。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "封地命氏", "des": "以受封采邑之名为氏，是最普遍的命氏途径，鲁、韩、赵、魏、范、知，一朝受封便是一姓之始。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "以国为氏", "des": "国灭之后，遗民以故国之名为氏纪念故土，齐、楚、宋、郑、陈、蔡，亡国的钟声成了姓氏的诞生礼。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "以官为氏", "des": "以祖上官职为氏：司马、司徒、司空、太史、冢宰，先祖的职守成了子孙的姓，官名与姓氏从此难分。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "以职业为氏", "des": "以世传职业技艺为氏：陶、屠、卜、巫、匠、庖，营生的手艺沉淀为家族的名号。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "以居地为氏", "des": "以所居地望为氏：东郭、西门、南宫、柳下，住址即姓氏，是中国最早的「地理坐标命名法」。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "以字为氏", "des": "以祖父之字为氏：鲁国季孙氏出自桓公之子季友，郑国国氏出自子国，先人的表字成了支族的姓氏。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "以谥为氏", "des": "以先祖谥号为氏：庄、穆、康、武皆出谥法，死后哀荣一字，竟成子孙千年的姓。", "symbolSize": 40, "category": "姓与氏的起源" },
    { "name": "赐姓", "des": "天子赐姓是最高规格的荣宠：汉赐娄敬刘姓、唐赐徐世勣李姓、明赐郑和郑姓，国姓的授予即是身份的重铸。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "避讳改姓", "des": "为避帝王名讳而改姓：庆氏避安帝父讳改贺，师氏避晋景帝讳改帅，一字之讳，阖族改姓。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "避祸改姓", "des": "政治避祸下的隐姓埋名：西灭后戈氏改戈、韩灭后韩氏改何，改姓换字以求存续，藏起了多少家族的惊险一夜。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "胡姓汉化", "des": "北魏孝文帝改胡姓为汉姓：拓跋改元、独孤改刘、步六孤改陆，一场自上而下的改姓运动重塑了北方的姓氏版图。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "郡望", "des": "「郡中之望族」：姓氏与发祥地绑定的身份标签，太原王氏、陇西李氏、琅琊王氏，郡望是门第社会的通行证。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "门阀士族", "des": "以婚宦与谱牒维系的世袭贵族阶层，「上品无寒门，下品无势族」，姓氏即阶级，直到唐末才被科举与战乱联手瓦解。", "symbolSize": 50, "category": "姓氏流变与制度" },
    { "name": "五姓七望", "des": "隋唐最顶尖的门阀集团：崔、卢、李、郑、王五姓七家，连皇室求亲都敢怠慢，自恃血脉比龙椅更古老。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "《百家姓》", "des": "成书于宋初的蒙学识字课本，四百六十八字押韵成篇，「赵钱孙李」以国姓开篇，是流传最广的姓氏总目。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "《通志·氏族略》", "des": "南宋郑樵所撰氏族学专篇，将得姓受氏之源分为三十二类，是古代姓氏研究的集大成之作。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "复姓消长", "des": "复姓由繁而简的长时段趋势：工程浩大的单姓化让第五、闻人、羊舌日渐稀少，也让慕容、上官成了小说常客。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "大姓现象", "des": "「张王李赵遍地刘」：人口向少数姓氏高度集中，五大姓占全国人口近三成，是战乱、改姓与移民共同塑形的结果。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "姓氏分布与人口", "des": "用统计眼光看姓氏：李王张刘陈雄踞榜首，姓氏的地域聚簇与方言线、移民路高度重合，人口普查成了新谱牒。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "洪洞大槐树移民", "des": "明初自山西向中原的大规模官方移民，传说移民后代小脚趾甲分两瓣，「解手」一词由此而来，亿万族谱共指一棵槐。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "少数民族姓氏", "des": "五十五个少数民族的姓氏生态：彝族的父子连名、维吾尔的父名加姓、满族的哈拉与汉姓对译，各自成谱又互有交融。", "symbolSize": 40, "category": "姓氏流变与制度" },
    { "name": "家谱", "des": "记录家族世系与事迹的谱牒，「谱者属也」，一册在手，千百年祖孙名字蝉联而下，是中国人家族记忆的核心载体。", "symbolSize": 50, "category": "谱牒与世系" },
    { "name": "谱牒学", "des": "专门研究谱牒的学问，魏晋选官「稽谱牒而察其真」使其成为显学，官修谱局一度垄断了谁能上谱的权力。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "玉牒", "des": "皇家专用谱牒之名，历代设宗人府专修，帝系、支派、婚嫁、封爵一一在册，是规格最高的家谱。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "欧阳修谱式", "des": "欧阳修创「表格式」谱法：世代分格横推，五世一表一提，眉目清爽如史表，后世称「欧式」。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "苏洵谱式", "des": "苏洵创「垂珠体」谱法：世系竖连如珠串，大宗小宗详略有别，与欧式并称「欧苏谱法」，为千年修谱立下范式。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "始祖与始迁祖", "des": "谱牒的两座基准点：受姓或肇基之祖为始祖，迁居本支之地者为始迁祖，寻根问祖，问的就是这两个名字。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "房支", "des": "宗族之下的分支单位：始祖诸子各立一房，房又分支，支又分派，一棵大树层层展开，谱名里常自报家门「几房几支」。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "昭穆", "des": "宗法制度的左右排序法：始祖居中，二世昭居左，三世穆居右，父子异列、祖孙同列，坟山与祠堂皆按此布位。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "世系图", "des": "谱牒的骨架图：名字连缀、世代横行，血缘与过继用线区别分明，一张好世系图抵得过千言万语的家族史。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "祠堂", "des": "宗族的物理与精神中心：祭祖、议事、执法、办学皆在此进行，一村一祠、一祠一谱，毁祠等于斩断一族之根。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "族田", "des": "宗族公产：以田租供祭祀、赡族人或助学，「义庄」是其最著名的形态，经济基础撑起了宗族的千年运转。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "宗族", "des": "以父系血缘为纽带结成的人群组织，谱牒记其名、祠堂聚其身、族田养其众、族规束其行，是传统社会最坚韧的中间层。", "symbolSize": 50, "category": "谱牒与世系" },
    { "name": "修谱传统", "des": "「三十年不修谱即为不孝」：续修的周期、领谱的编号、验谱的仪式都有讲究，修谱是宗族最重要的文化工程。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "家乘与族规", "des": "谱牒的另一半内容：族规家训、祠规义条，把伦理写进谱书，让每一次翻检都成为一次家风的重申。", "symbolSize": 40, "category": "谱牒与世系" },
    { "name": "字辈", "des": "以固定用字标示世代的命名制度：同辈共用一字，一看名字便知长幼尊卑，是中国宗族最具操作性的发明之一。", "symbolSize": 50, "category": "字辈与命名制度" },
    { "name": "字辈诗", "des": "把辈分用字串成吉祥诗句：四言五言七言皆有，寓意连绵，一族一部「命名词典」，用完一轮再续新诗。", "symbolSize": 40, "category": "字辈与命名制度" },
    { "name": "孔氏字辈", "des": "孔门行辈的巅峰：明清皇帝先后钦赐十字，孔孟颜曾四姓通天谱共用，五十六代至今不乱，是全国统一度最高的字辈体系。", "symbolSize": 40, "category": "字辈与命名制度" },
    { "name": "行第", "des": "以排行入名或入称：伯仲叔季表长幼，唐人以行第相称——白二十二、刘二十八——亲昵之外自见座次。", "symbolSize": 40, "category": "字辈与命名制度" },
    { "name": "名与字", "des": "「名以正体，字以表德」：幼年命名，成年取字，名字相应或相补——诸葛亮字孔明，亮与明互为注脚。", "symbolSize": 40, "category": "字辈与命名制度" },
    { "name": "号", "des": "名与字之外的自取别名：室名、斋号、别号随心而设，东坡、放翁、饮冰室主人，号是古人的第三个自我。", "symbolSize": 40, "category": "字辈与命名制度" },
    { "name": "冠字与笄字", "des": "男子二十冠礼取字、女子十五笄礼取字，取字即成年，此后平辈以字相称，直呼其名反而成了冒犯。", "symbolSize": 40, "category": "字辈与命名制度" },
    { "name": "避讳制度", "des": "对君主与尊长之名不得直书直呼的制度：改字、缺笔、空格诸法并用，一讳牵动经史百家，也牵动了千万人的姓与名。", "symbolSize": 50, "category": "字辈与命名制度" },
    { "name": "国讳", "des": "避皇帝及其父祖之名：观音原称观世音，为避李世民讳去「世」；正月之「正」读平声，相传也是避秦始皇嬴政。", "symbolSize": 40, "category": "字辈与命名制度" },
    { "name": "家讳", "des": "避父祖之名：「今日只说『这里』」——司马迁父名谈，《史记》通篇讳谈字，私人记忆改写了公共写作。", "symbolSize": 40, "category": "字辈与命名制度" },
    { "name": "圣讳", "des": "避「圣人」之名：清代避孔子讳，丘姓加邑旁成「邱」，一个帝王的决定让整支姓氏换了写法。", "symbolSize": 40, "category": "字辈与命名制度" },
    { "name": "单名与双名", "des": "汉魏流行单名、王莽令去二名只是一瞬，两晋以降双名渐盛，取名的长短里也藏着礼制的松紧与人口的膨胀。", "symbolSize": 40, "category": "字辈与命名制度" },
    { "name": "文献考证", "des": "谱系研究的看家功夫：以正史、方志、碑刻与谱牒互勘，去伪存真，替「攀附的族谱」做一次次外科手术。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "正史列传", "des": "纪传体正史里的列传与世家的谱系价值最高：人物籍贯、世次、婚宦俱在，是考证家族史的第一级台阶。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "方志", "des": "一地之百科全书的志书：人物、选举、氏族诸志详载本地家族迁徙与科第，填补了正史顾不上的千万个家族。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "墓志铭", "des": "埋于墓中的生平石刻：志主世系、婚姻、卒葬记载精确，出土即是一手谱料，常能纠正传世谱牒的攀附之误。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "口述家史", "des": "向族中长者采集记忆的活材料：口传的迁徙、过继、隐情常不见于纸面，抢救性录音是修新谱的第一步。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "基因谱系学", "des": "用脱氧核糖核酸标记追溯血缘的学科：一滴唾液回溯千年父系母系，与传统谱牒构成「二重证据」的当代版本。", "symbolSize": 50, "category": "谱系学方法" },
    { "name": "Y 染色体追溯", "des": "父系代代相传的 Y 染色体：突变速率如分子钟，同一父系宗族的男性共享相近的标记，是「同姓是否同宗」的物理判据。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "线粒体谱系", "des": "只随母系传递的线粒体脱氧核糖核酸：母女相续、绵延不绝，「线粒体夏娃」正是全人类母系的共同远祖假说。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "共同祖先", "des": "谱系学的基本事实：人口有限而世代无穷，回溯足够远，任何两人都能找到共同祖先，「最近共同祖先」的寻找正是其算法核心。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "同姓联宗", "des": "不同支派同姓者认联一宗、合修通谱的传统：或真为同源，或仅为壮大声势，联宗是姓氏社会的横向联合。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "攀附与伪谱", "des": "谱牒的慢性病：始祖必托名帝王将相，世系必接续名人，清人钱大昕讥其「凿空撰造」，是考证者永远的对手。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "谱师职业", "des": "以修谱为业的匠人：走村串族承揽谱局，善者续真，庸者套用「模板始祖」，民国谱师留下的伪谱至今仍在误导寻根者。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "GEDCOM 标准", "des": "家谱数据的通用交换格式：以「个人—家庭」两层结构描述全部亲属关系，让不同软件间的家族树彼此兼容。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "家谱数据库", "des": "全球家谱的数字化汇聚：数以十亿计的谱系记录与文献影像在线检索，家谱从祠堂的樟木箱搬进了云端。", "symbolSize": 40, "category": "谱系学方法" },
    { "name": "家族树", "des": "以树状图呈现的血缘网络：根为始祖、枝为房支、叶为生者，直观到无需识字也能看懂，是全人类共通的谱系语言。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "欧洲姓氏起源", "des": "欧洲姓氏普遍晚至中世纪后期才定型：人口增长与行政登记迫使「名不够用」，姓氏才从绰号、地名、父名中沉淀下来。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "职业姓氏", "des": "英语姓氏里最常见的来源：铁匠、面包师、磨坊主、厨子，一人一职一姓，职业名录直接变成了姓氏名录。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "父名制", "des": "以父亲之名构成子女姓氏的制度：约翰之子姓约翰逊，伊万之子姓伊万诺夫，姓随父变、代代更替，是动态的谱系。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "冰岛父名制", "des": "至今不用家族姓氏的活化石：女儿名「多蒂尔」（之女）、儿子名「松」（之子），祖父与孙可能「姓」毫无重合，电话簿按名排序。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "俄罗斯姓名三段", "des": "名＋父称＋姓的三段式：父称表明「谁之子」，姓氏迟至十九世纪才普及到农奴，一部姓名史就是半部社会史。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "西班牙双姓制", "des": "首姓承父、次姓承母的双姓并行制：全名天然携带父母两条线，女性婚后也不改姓，谱系信息量翻倍。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "日本苗字", "des": "明治八年「平民苗字必称义务令」一夜之间让全民有姓：田中、山口、中村，地名与景物仓促成姓，是最大规模的集中授姓。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "苏格兰氏族", "des": "以族名为纽带的苏格兰部落体系：格子呢纹样按氏族归属，族长、徽记与领地俱全，是欧洲最接近宗族的存在。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "纹章学", "des": "以盾徽纹样标识家族身份的学问：图案、配色、分区皆有严格规则，纹章按继承法传递，是穿在身上的谱牒。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "科恩与利未", "des": "犹太姓氏中的祭司印记：科恩意为祭司、利未意为利未支派，基因研究竟在两者体内找到了一致的父系标记。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "姓氏日", "des": "捷克与斯洛伐克独有的历法习俗：每一天对应一个名字，轮到自己的名字即是「命名日」，亲友道贺如过生日。", "symbolSize": 40, "category": "世界谱系传统" },
    { "name": "世界姓名顺序", "des": "东亚姓前名后、西方名前姓后、匈牙利独树姓前：姓名的排列方向，悄悄暴露了文化里个体与家族孰先孰后。", "symbolSize": 40, "category": "世界谱系传统" }
