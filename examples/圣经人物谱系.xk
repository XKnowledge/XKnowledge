{
  "version": 2,
  "title": "圣经人物谱系",
  "description": "从亚当到使徒，族长、君王、先知与耶稣时代的血脉与传承，一部圣典中的人物之网。",
  "nodes": [
    { "name": "圣经人物谱系", "des": "据圣经记载串联的人名之网，血脉、呼召与信约层层相续，谱系本身就是叙事。", "symbolSize": 70, "category": "创世与族长" },
    { "name": "亚当", "des": "按《创世记》记载的首个人类，自尘土受造、得生气而活，众人之祖的名字意为「人」。", "symbolSize": 50, "category": "创世与族长" },
    { "name": "夏娃", "des": "「众生之母」，自亚当肋骨造成的伴侣，与亚当同尝禁果而开启流放的叙事。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "该隐", "des": "长子，种地的，因献祭不蒙悦纳而杀弟，受印记流浪的农夫。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "亚伯", "des": "次子，牧羊的，义人所流的血「从地里哀告」，首位死者。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "塞特", "des": "亚伯之后另立的儿子，「样式形像」复归的一支，谱系自此续接。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "诺亚", "des": "洪水世代的义人，造方舟救全家与众生，虹约之下人类的新起点。", "symbolSize": 50, "category": "创世与族长" },
    { "name": "闪", "des": "诺亚长子，洪水后蒙祝福的一支，「闪的后裔」直抵亚伯拉罕。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "亚伯拉罕", "des": "蒙召离乡的信心之父，万国之父的应许与献子的试炼都落在他身上。", "symbolSize": 60, "category": "创世与族长" },
    { "name": "撒拉", "des": "年迈得子的族长之妻，「撒拉必生一子」的笑成了以撒名字的由来。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "夏甲", "des": "撒拉的埃及使女，代孕而生以实玛利，被逐旷野中蒙看顾的女子。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "以实玛利", "des": "「神听见」的少年，使女所出的长子，量大国的先祖，与以撒同父异母。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "以撒", "des": "应许之子，被献于坛上的少年，掘井为业、性情温和的二代族长。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "利百加", "des": "井旁遇上的利百加，以撒之妻，偏爱幼子而设计夺福的母亲。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "以扫", "des": "浑身毛发的长子，善猎的野性之人，为一碗红豆汤卖出长子名分。", "symbolSize": 40, "category": "创世与族长" },
    { "name": "雅各", "des": "抓住脚跟出生的幼子，伯特利梦见天梯，与神摔跤后改名以色列。", "symbolSize": 50, "category": "创世与族长" },
    { "name": "约瑟", "des": "雅各爱妻所出的爱子，彩衣与异梦的少年，被卖埃及而终成救民的宰相。", "symbolSize": 50, "category": "出埃及与士师" },
    { "name": "犹大", "des": "雅各四子，劝弟卖兄的提议者，却在大饥荒中挺身作保，后世王族所出的一支。", "symbolSize": 40, "category": "出埃及与士师" },
    { "name": "十二支派", "des": "雅各十二子所出的支派，下埃及七十人、出埃及数百万的族群骨架。", "symbolSize": 40, "category": "出埃及与士师" },
    { "name": "出埃及", "des": "十灾、过海、旷野四十年，奴役之民成为立约之族的开国叙事。", "symbolSize": 40, "category": "出埃及与士师" },
    { "name": "摩西", "des": "蒲苇箱里的婴儿、米甸的牧人、焚而不毁的荆棘前的解救者，律法的中保。", "symbolSize": 60, "category": "出埃及与士师" },
    { "name": "亚伦", "des": "摩西之兄与代言人，口才補足弟弟的笨拙，首任大祭司。", "symbolSize": 50, "category": "出埃及与士师" },
    { "name": "米利暗", "des": "看护弟弟的姐姐、海边击鼓歌唱的女先知，谱系里最早留下名字的女性之一。", "symbolSize": 40, "category": "出埃及与士师" },
    { "name": "约书亚", "des": "摩西的随扈与接班人，窥探迦南的两个信心者之一，带领渡河的一代统帅。", "symbolSize": 50, "category": "出埃及与士师" },
    { "name": "迦勒", "des": "与约书亚同报善信的探子，「专心跟从」而得希伯仑为业的耶孚尼之子。", "symbolSize": 40, "category": "出埃及与士师" },
    { "name": "底波拉", "des": "棕树下的女士师，与巴拉同战于基顺河，战后作歌的先知。", "symbolSize": 40, "category": "出埃及与士师" },
    { "name": "基甸", "des": "酒醡中打麦的怯懦者，三百人持火把夜袭的士师，以羊毛求证的胆小英雄。", "symbolSize": 40, "category": "出埃及与士师" },
    { "name": "参孙", "des": "拿细耳人之力的士师，驴腮骨杀敌、被剃发而败、与殿同殉的悲情大力士。", "symbolSize": 40, "category": "出埃及与士师" },
    { "name": "撒母耳", "des": "殿中长大的最后士师与首位先知，膏立两王而开启王国时代。", "symbolSize": 50, "category": "出埃及与士师" },
    { "name": "扫罗", "des": "受膏的首位君王，高人一头的便雅悯人，功业与嫉妒并行、终于战败自刎的悲剧王。", "symbolSize": 40, "category": "君王时代" },
    { "name": "大卫", "des": "伯利恒的牧羊少年、击倒歌利亚的琴手、合神心意的王，诗篇半数归于其名。", "symbolSize": 60, "category": "君王时代" },
    { "name": "约拿单", "des": "扫罗之子、大卫的挚友，爱友胜过王位的王子，折弓相赠的深情。", "symbolSize": 40, "category": "君王时代" },
    { "name": "歌利亚", "des": "迦特来的非利士巨人，铠甲如山、日日骂阵，却倒于一枚机弦甩石。", "symbolSize": 40, "category": "君王时代" },
    { "name": "米甲", "des": "扫罗之女、爱大卫而嫁的公主，居高窗前望夫逃亡的复杂身影。", "symbolSize": 40, "category": "君王时代" },
    { "name": "拔示巴", "des": "沐浴中被窥见的美人，丧夫再嫁、痛失爱子后又生所罗门的王后之母。", "symbolSize": 40, "category": "君王时代" },
    { "name": "所罗门", "des": "求智慧而得富足的和平之王，建圣殿、断疑案、晚年失度的传奇君主。", "symbolSize": 50, "category": "君王时代" },
    { "name": "示巴女王", "des": "闻智慧之名而来的南方女王，携带难题与香料，见而叹服的异国君主。", "symbolSize": 40, "category": "君王时代" },
    { "name": "罗波安", "des": "所罗门之子，「我父亲用鞭子责打你们，我要用蝎子鞭」的少主，分裂之责所系。", "symbolSize": 40, "category": "君王时代" },
    { "name": "耶罗波安", "des": "北方十支派拥立的王，立金牛于但与伯特利的分裂王国开创者。", "symbolSize": 40, "category": "君王时代" },
    { "name": "大卫之约", "des": "「你的家和你的国必永远坚立」，王座与后裔的应许，系于牧羊人之王。", "symbolSize": 40, "category": "君王时代" },
    { "name": "约柜", "des": "法柜，施恩座与基路伯之间的同在之记，随行旷野、入住圣殿的核心圣物。", "symbolSize": 40, "category": "君王时代" },
    { "name": "圣殿", "des": "所罗门建于摩利亚山的「为大神建殿宇」，焚于巴比伦、复建于归回之后。", "symbolSize": 40, "category": "君王时代" },
    { "name": "以利亚", "des": "迦密山上求火降雨的先知，火车火马旋升而去，未尝死亡的提斯比人。", "symbolSize": 50, "category": "先知" },
    { "name": "以利沙", "des": "耕地时蒙召、承接外衣的先知，求了双倍的灵，行神迹最多的书念故人。", "symbolSize": 40, "category": "先知" },
    { "name": "以赛亚", "des": "乌西雅王崩年见异象的先知，「童女怀孕」「仆人之歌」皆出自他的书。", "symbolSize": 50, "category": "先知" },
    { "name": "耶利米", "des": "未出母腹已被选立的先知，泪书哀歌、预言被掳七十年而买地于敌军压境时。", "symbolSize": 40, "category": "先知" },
    { "name": "以西结", "des": "迦巴鲁河边见四轮异象的祭司先知，枯骨复生的异象出自被掳之地。", "symbolSize": 40, "category": "先知" },
    { "name": "但以理", "des": "被掳王庭中的犹大少年，解梦、狮坑与墙上文字，一日三次开窗祷告的人。", "symbolSize": 40, "category": "先知" },
    { "name": "何西阿", "des": "娶回背弃之妻以喻神人之约的先知，以家事说预言的伤心人。", "symbolSize": 40, "category": "先知" },
    { "name": "约拿", "des": "逃避差遣而被大鱼吞咽的先知，三日三夜在鱼腹中祷告的逃避者。", "symbolSize": 40, "category": "先知" },
    { "name": "阿摩司", "des": "提哥亚的牧人与修理桑树者，「惟愿公平如大水滚滚」的北方宣讲者。", "symbolSize": 40, "category": "先知" },
    { "name": "巴比伦之囚", "des": "圣城陷落、圣殿被焚、精英被掳的七十年，哀歌与盼望交织的流亡岁月。", "symbolSize": 40, "category": "先知" },
    { "name": "以斯拉", "des": "通达律法的文士祭司，率第二批归回、于水门前宣读律法的复兴者。", "symbolSize": 40, "category": "先知" },
    { "name": "尼希米", "des": "酒政出身的省长，闻城墙被毁而哭泣禁食、五十二日重修城垣的实干家。", "symbolSize": 40, "category": "先知" },
    { "name": "撒迦利亚", "des": "殿中烧香而见异象的老祭司，因疑而哑、得子后开口颂赞的父亲。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "伊利莎白", "des": "素称不生育而已老的祭司之妻，怀胎生约翰、与马利亚同住的亲属长辈。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "施洗约翰", "des": "旷野中穿骆驼毛衣服的先知，修直主路的呼声，为表号而来又殉于狱中。", "symbolSize": 50, "category": "耶稣时代" },
    { "name": "马利亚", "des": "拿撒勒的童贞女，「情愿照你的话成就在我身上」，尊主颂至今传唱的母亲。", "symbolSize": 50, "category": "耶稣时代" },
    { "name": "木匠约瑟", "des": "大卫家的木匠，梦中受指示而娶妻、携家避难的沉默义人。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "耶稣", "des": "拿撒勒人、基督，福音书记载的救主，生而为王、死而复活的中心人物。", "symbolSize": 60, "category": "耶稣时代" },
    { "name": "东方三博士", "des": "随星而来朝拜圣婴的术士们，献上黄金乳香没药后由别的路而去。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "希律大帝", "des": "重建圣殿又疑忌成性的以东王，闻新生王而屠尽伯利恒婴孩的希律王。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "西面", "des": "素常盼望安慰者的耶路撒冷老人，殿中抱婴颂「我的眼睛已经看见你的救恩」。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "希律安提帕", "des": "斩了约翰又戏弄耶稣的加利利分封王，希律家族的第二代，终被流放高卢。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "本丢彼拉多", "des": "洗手仍洗不净的罗马巡抚，在石头上写下「犹太人的王」的判官。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "最后晚餐", "des": "逾越节的筵席上擘饼递杯，「这是我的身体」所设立的纪念之夜。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "受难", "des": "荆棘冠冕、苦路与十字架，据福音书记载为世人所受的十架之刑。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "耶稣家谱", "des": "马太与路加两部福音各自排出的谱系，上溯亚伯拉罕与亚当以证圣婴的王统。", "symbolSize": 40, "category": "耶稣时代" },
    { "name": "彼得", "des": "矶法，「你是基督」的认信者与三次不认主的渔夫，五旬节站起讲道的那块磐石。", "symbolSize": 50, "category": "使徒与初代教会" },
    { "name": "安得烈", "des": "彼得的兄弟，领兄见主的首位跟随者，总在引人到耶稣面前的安静使徒。", "symbolSize": 40, "category": "使徒与初代教会" },
    { "name": "西庇太之子雅各", "des": "雷子之一，十二使徒中首位殉道的，被希律刀杀的约翰之兄。", "symbolSize": 40, "category": "使徒与初代教会" },
    { "name": "约翰", "des": "靠在主怀里的「主所爱的门徒」，十字架下受托、晚年写启示录的西庇太之子。", "symbolSize": 50, "category": "使徒与初代教会" },
    { "name": "多马", "des": "「我总不信」的多疑者，探入钉痕后俯首称「我的主我的神」的诚实疑问者。", "symbolSize": 40, "category": "使徒与初代教会" },
    { "name": "马太", "des": "坐在税关上的税吏利未，蒙召撇下一切、以谱系开篇记述福音的税吏使徒。", "symbolSize": 40, "category": "使徒与初代教会" },
    { "name": "加略人犹大", "des": "管钱囊却以亲嘴为号的使徒，三十块银钱与自缢的结局，背叛的名字。", "symbolSize": 40, "category": "使徒与初代教会" },
    { "name": "马提亚", "des": "摇签补上犹大空缺的两位候选人之一，常与使徒同列的后来者。", "symbolSize": 40, "category": "使徒与初代教会" },
    { "name": "保罗", "des": "扫罗，逼迫教会的法利赛人、大马士革路上仆倒归主的外邦使徒，书信过半归于他。", "symbolSize": 60, "category": "使徒与初代教会" },
    { "name": "巴拿巴", "des": "「劝慰之子」，把逼迫者保罗荐给使徒、又与他在安提阿同工的良善之人。", "symbolSize": 40, "category": "使徒与初代教会" },
    { "name": "司提反", "des": "以智慧和圣灵说话的七执事之首，殉道时面如天使、为掷石者代求的先声。", "symbolSize": 40, "category": "使徒与初代教会" },
    { "name": "路加", "des": "医生与细致的史家，随行保罗而写下路加福音与使徒行传的外邦执笔者。", "symbolSize": 40, "category": "使徒与初代教会" },
    { "name": "马可", "des": "中途退出的青年、后来被保罗再要回的同工，彼得讲道的记录者马可约翰。", "symbolSize": 40, "category": "使徒与初代教会" },
    { "name": "抹大拉的马利亚", "des": "曾被七个鬼附着而蒙医治的女子，各各他与空坟墓前的见证人，复活的首报信者。", "symbolSize": 40, "category": "使徒与初代教会" }
  ],
  "links": [
    { "source": "圣经人物谱系", "target": "亚当", "name": "源起", "des": "一切名字自第一个人开始，谱系的第一页写着尘土与生气。" },
    { "source": "圣经人物谱系", "target": "亚伯拉罕", "name": "拣选", "des": "蒙召离乡的一人，成了万族得福的起点。" },
    { "source": "圣经人物谱系", "target": "摩西", "name": "立约", "des": "西奈山下的律法，把一群奴工铸成立约之民。" },
    { "source": "圣经人物谱系", "target": "大卫", "name": "王统", "des": "牧羊人的王座与后裔的应许，谱系由此转向王室。" },
    { "source": "圣经人物谱系", "target": "耶稣", "name": "成全", "des": "福音书把一切谱系的应许指向伯利恒的婴孩。" },
    { "source": "圣经人物谱系", "target": "保罗", "name": "广传", "des": "从耶路撒冷到罗马，福音之路由外邦使徒走完。" },
    { "source": "亚当", "target": "夏娃", "name": "配偶", "des": "骨中之骨肉中之肉，第一场婚姻由创造设立。" },
    { "source": "亚当", "target": "该隐", "name": "亲子", "des": "「我得了一个男子」，头生子出生时的欢呼。" },
    { "source": "亚当", "target": "亚伯", "name": "亲子", "des": "第二个儿子承了牧羊的营生。" },
    { "source": "亚当", "target": "塞特", "name": "亲子", "des": "亚伯之后另立的一子，敬虔的谱系由此续接。" },
    { "source": "夏娃", "target": "该隐", "name": "母子", "des": "母亲见证了长子的一生与流放。" },
    { "source": "夏娃", "target": "亚伯", "name": "母子", "des": "第二个儿子死于兄长之手，母亲第一次丧子。" },
    { "source": "夏娃", "target": "塞特", "name": "母子", "des": "「神另给我立了一个儿子代替亚伯」。" },
    { "source": "该隐", "target": "亚伯", "name": "弑弟", "des": "田间的发怒酿成第一桩命案，血从地里哀告。" },
    { "source": "塞特", "target": "诺亚", "name": "世系", "des": "十代而传的家谱，在洪水前夜抵达方舟的建造者。" },
    { "source": "诺亚", "target": "闪", "name": "亲子", "des": "长子在方舟中蒙福，洪水后的世界自三子展开。" },
    { "source": "闪", "target": "亚伯拉罕", "name": "世系", "des": "又十代的家谱，自闪的帐棚到他拉的儿子。" },
    { "source": "亚伯拉罕", "target": "撒拉", "name": "配偶", "des": "同出哈兰的夫妻，同行七十五年信心的路。" },
    { "source": "亚伯拉罕", "target": "夏甲", "name": "妾室", "des": "无子之年的替代方案，铸就两族的开始。" },
    { "source": "亚伯拉罕", "target": "以实玛利", "name": "父子", "des": "使女所生的长子，十三岁受割礼的长子。" },
    { "source": "夏甲", "target": "以实玛利", "name": "母子", "des": "旷野中「神听见」的母子，别是巴的井旁蒙看顾。" },
    { "source": "撒拉", "target": "夏甲", "name": "逐出", "des": "以撒断奶之日，使女母子被逐，一个家的裂痕。" },
    { "source": "亚伯拉罕", "target": "以撒", "name": "父子", "des": "应许之子终于降生，老来得子的笑。" },
    { "source": "撒拉", "target": "以撒", "name": "母子", "des": "九十岁的母亲生了「喜笑」之名的儿子。" },
    { "source": "亚伯拉罕", "target": "以撒", "name": "试献", "des": "摩利亚山上的捆绑，替代的公羊与信心的至高处。" },
    { "source": "以撒", "target": "利百加", "name": "配偶", "des": "井旁的相遇与老仆人的祷告，第二代的婚姻。" },
    { "source": "以撒", "target": "以扫", "name": "亲子", "des": "「红汤」的长子，善猎的以扫。" },
    { "source": "以撒", "target": "雅各", "name": "亲子", "des": "抓住脚跟的幼子，安居帐棚的雅各。" },
    { "source": "利百加", "target": "以扫", "name": "母子", "des": "腹中相争的双子，母亲偏爱幼子的开始。" },
    { "source": "利百加", "target": "雅各", "name": "母子", "des": "披上山羊皮的手，母亲一手策划的祝福。" },
    { "source": "以扫", "target": "雅各", "name": "孪生", "des": "同日所生的双子，将来大的要服侍小的。" },
    { "source": "以扫", "target": "雅各", "name": "卖名", "des": "一碗红豆汤换走的长子名分，累了一生的交易。" },
    { "source": "雅各", "target": "以扫", "name": "和解", "des": "二十年后雅博渡口摔跤归来，兄弟抱头而哭。" },
    { "source": "雅各", "target": "约瑟", "name": "父子", "des": "爱妻拉结所出的爱子，一件彩衣招来的嫉妒。" },
    { "source": "雅各", "target": "犹大", "name": "父子", "des": "四子犹大，日后王族谱系所出的一支。" },
    { "source": "雅各", "target": "十二支派", "name": "所出", "des": "十二子各成一派，以色列的骨架由此而成。" },
    { "source": "犹大", "target": "十二支派", "name": "位列", "des": "四子之派后来居上，出君王与救主谱系的支派。" },
    { "source": "犹大", "target": "约瑟", "name": "卖弟", "des": "「不可害他的性命」，提议卖弟的提议者日后认罪。" },
    { "source": "约瑟", "target": "出埃及", "name": "前史", "des": "被卖为奴的少年成了宰相，七十口之家下埃及。" },
    { "source": "摩西", "target": "十二支派", "name": "领出", "des": "数百万之众出埃及，支派的编制在旷野中排定。" },
    { "source": "亚伦", "target": "十二支派", "name": "位列", "des": "利未支派所出的首任大祭司，祭司体系之始。" },
    { "source": "摩西", "target": "出埃及", "name": "领导", "des": "十灾、过海、西奈立约，八十岁的领袖领民出走。" },
    { "source": "亚伦", "target": "摩西", "name": "兄弟", "des": "「他是有口才的」，兄长作了弟弟的发言人。" },
    { "source": "米利暗", "target": "摩西", "name": "姐妹", "des": "蒲苇箱旁守望的姐姐，又领众妇女海边击鼓歌唱。" },
    { "source": "米利暗", "target": "亚伦", "name": "姐妹", "des": "三位一体的姐弟组合，同领旷野四十年。" },
    { "source": "米利暗", "target": "出埃及", "name": "颂歌", "des": "海中得救的当夜，女先知带头唱得胜之歌。" },
    { "source": "亚伦", "target": "出埃及", "name": "代言", "des": "法老面前「神这样说」的话，多半由亚伦开口。" },
    { "source": "约书亚", "target": "摩西", "name": "随扈", "des": "会幕的少年侍从、窥探迦南的战士，四十年的学徒。" },
    { "source": "约书亚", "target": "出埃及", "name": "继业", "des": "旷野的一代替补死去，渡约旦河的使命落在约书亚肩上。" },
    { "source": "迦勒", "target": "约书亚", "name": "同探", "des": "十二探子中仅有的两位，「我们立刻上去得那地吧」。" },
    { "source": "底波拉", "target": "基甸", "name": "后继", "des": "士师的接力，从棕树下的女先知到酒醡中的打麦人。" },
    { "source": "基甸", "target": "参孙", "name": "后继", "des": "勇力与谋略代代相续，士师记的链条又续一环。" },
    { "source": "参孙", "target": "撒母耳", "name": "后继", "des": "大力士之后，最后一位士师兼先知登场。" },
    { "source": "撒母耳", "target": "扫罗", "name": "膏立", "des": "膏油倒在寻驴的少年头上，「这不是耶和华膏你作领袖么」。" },
    { "source": "撒母耳", "target": "大卫", "name": "膏立", "des": "伯利恒的膏油再次倒下，王位的更替已在暗中完成。" },
    { "source": "扫罗", "target": "撒母耳", "name": "忤逆", "des": "「你既厌弃耶和华的命令，他也厌弃你作王」。" },
    { "source": "扫罗", "target": "大卫", "name": "嫉害", "des": "「扫罗打死千千，大卫杀死万万」，歌从此成了追杀令。" },
    { "source": "扫罗", "target": "约拿单", "name": "父子", "des": "王的儿子却与逃亡者立约，父与子站在了爱的两侧。" },
    { "source": "扫罗", "target": "米甲", "name": "父女", "des": "以女儿为网罗的许婚，米甲却爱了大卫。" },
    { "source": "米甲", "target": "大卫", "name": "配偶", "des": "窗前垂下绳索的一夜，妻子助夫逃亡。" },
    { "source": "约拿单", "target": "大卫", "name": "挚友", "des": "「你我心里深相契合」，王子与逃亡者的结盟之爱。" },
    { "source": "大卫", "target": "歌利亚", "name": "击杀", "des": "溪中五块光滑石子，机弦一甩，巨人倒地。" },
    { "source": "大卫", "target": "拔示巴", "name": "夺娶", "des": "屋顶所见酿成大罪，乌利亚的信成了自己的死刑状。" },
    { "source": "大卫", "target": "所罗门", "name": "父子", "des": "拔示巴的次子，蒙爱起名「耶底底亚」。" },
    { "source": "拔示巴", "target": "所罗门", "name": "母子", "des": "丧子之后再得的孩子，母亲为他铺陈了王位。" },
    { "source": "大卫", "target": "犹大", "name": "裔出", "des": "「圭必不离犹大」，牧羊之王出自犹大支派。" },
    { "source": "大卫之约", "target": "大卫", "name": "立定", "des": "拿单的预言：你的家和你的国必在神面前永远坚立。" },
    { "source": "大卫之约", "target": "耶稣", "name": "应验", "des": "「大卫的子孙」，福音书开篇即认定的王统成全。" },
    { "source": "大卫", "target": "约柜", "name": "迎入", "des": "运约柜入大卫城，王在约柜前极力跳舞。" },
    { "source": "所罗门", "target": "圣殿", "name": "营建", "des": "四百八十年的出埃及之后，石头在摩利亚山垒起。" },
    { "source": "约柜", "target": "圣殿", "name": "安置", "des": "「愿你的祭司披上救恩」，至圣所从此有了中心。" },
    { "source": "示巴女王", "target": "所罗门", "name": "问道", "des": "难解的话与贵重的礼物，女王见而叹服的智慧。" },
    { "source": "所罗门", "target": "罗波安", "name": "父子", "des": "王国裂痕在繁荣中孕育，传到下一代终于崩开。" },
    { "source": "罗波安", "target": "耶罗波安", "name": "分裂", "des": "一句狠话，十个支派转身离去，一国裂为南北。" },
    { "source": "耶罗波安", "target": "十二支派", "name": "分领", "des": "北方十派立金牛为国教，与南国分庭抗礼。" },
    { "source": "以利亚", "target": "以利沙", "name": "师承", "des": "「愿感动你的灵加倍地感动我」，外衣自旋升者身上落下。" },
    { "source": "以利亚", "target": "耶稣", "name": "预表", "des": "登山变像时与摩西同现，谈论将成的事。" },
    { "source": "施洗约翰", "target": "以利亚", "name": "灵传", "des": "「他必有以利亚的心志能力」，旷野的呼声前后相接。" },
    { "source": "以赛亚", "target": "大卫之约", "name": "预言", "des": "「从耶西的必发一条」，先知把王室的盼望重新点燃。" },
    { "source": "以赛亚", "target": "受难", "name": "预言", "des": "「他被藐视，被人厌弃」，仆人之歌预先写下的十架。" },
    { "source": "耶利米", "target": "巴比伦之囚", "name": "预言", "des": "七十年为满的预言，写信给被掳之民劝其安居等候。" },
    { "source": "以西结", "target": "巴比伦之囚", "name": "身历", "des": "与王同被掳去的祭司，在迦巴鲁河边得见异象。" },
    { "source": "但以理", "target": "巴比伦之囚", "name": "身历", "des": "少年入王宫、历三朝而不住祷告的流亡者。" },
    { "source": "以斯拉", "target": "巴比伦之囚", "name": "归回", "des": "七十年期满，文士率第二批之民上耶路撒冷。" },
    { "source": "尼希米", "target": "巴比伦之囚", "name": "归回", "des": "书珊城的宫中闻噩耗，求王准假归国修墙。" },
    { "source": "以斯拉", "target": "尼希米", "name": "同工", "des": "一个宣读律法，一个重修城垣，归回时代的双柱。" },
    { "source": "巴比伦之囚", "target": "圣殿", "name": "焚毁", "des": "公元前五八六年，巴比伦的火把圣殿烧成废墟。" },
    { "source": "何西阿", "target": "阿摩司", "name": "同代", "des": "第八世纪的两位先知，同向北方支派发声。" },
    { "source": "约拿", "target": "耶稣", "name": "预表", "des": "「约拿三日三夜在大鱼肚腹中」，人子也要三日在地里。" },
    { "source": "撒迦利亚", "target": "伊利莎白", "name": "配偶", "des": "亚伦后裔的老夫妻，素来无可指摘的一对。" },
    { "source": "撒迦利亚", "target": "施洗约翰", "name": "父子", "des": "殿中异象应验，哑了的父亲写下「他的名字是约翰」。" },
    { "source": "伊利莎白", "target": "施洗约翰", "name": "母子", "des": "「主在她身上这样眷顾」，不育的老妻怀了先知。" },
    { "source": "马利亚", "target": "伊利莎白", "name": "探访", "des": "「你所怀的胎也是有福的」，两个孕妇的同住三个月。" },
    { "source": "马利亚", "target": "木匠约瑟", "name": "许配", "des": "已许配的童女，义人本想暗暗休妻却在梦中受示。" },
    { "source": "马利亚", "target": "耶稣", "name": "母子", "des": "「情愿照你的话成就在我身上」，十字架下母亲站立。" },
    { "source": "木匠约瑟", "target": "耶稣", "name": "养父", "des": "律法上的父亲，谱系经由他上溯大卫，木匠的沉默担当。" },
    { "source": "施洗约翰", "target": "耶稣", "name": "前驱", "des": "「修直他的路」，旷野预备的呼声在前头行走。" },
    { "source": "施洗约翰", "target": "耶稣", "name": "施洗", "des": "约旦河里「尽诸般的义」，鸽子与天上的声音同降。" },
    { "source": "希律安提帕", "target": "施洗约翰", "name": "斩首", "des": "希律生日宴上，因起誓与恶妇之求，先知的头放在盘子里。" },
    { "source": "东方三博士", "target": "耶稣", "name": "朝拜", "des": "随星而至的术士俯伏拜那小孩子，献上三样礼物。" },
    { "source": "希律大帝", "target": "耶稣", "name": "屠婴", "des": "「凡两岁以里的都杀尽」，博士由别的路回去了。" },
    { "source": "西面", "target": "耶稣", "name": "抱祝", "des": "「我的眼睛已经看见你的救恩」，老殿里最久的一次等候。" },
    { "source": "希律安提帕", "target": "耶稣", "name": "讥诮", "des": "彼拉多把加利利人解去分封王那里，被穿上华丽袍子戏弄。" },
    { "source": "本丢彼拉多", "target": "耶稣", "name": "判钉", "des": "洗手示清白之后，仍把无罪者交给人钉十字架。" },
    { "source": "最后晚餐", "target": "耶稣", "name": "设立", "des": "「你们也应当如此行，为的是记念我」。" },
    { "source": "最后晚餐", "target": "出埃及", "name": "逾越", "des": "除酵节的第一夜，新约的杯就摆在逾越的筵席上。" },
    { "source": "耶稣", "target": "受难", "name": "经历", "des": "客西马尼的汗滴与各各他的钉痕，福音书的高潮。" },
    { "source": "耶稣家谱", "target": "亚伯拉罕", "name": "上溯", "des": "「亚伯拉罕的后裔，大卫的子孙」，马太福音的第一句。" },
    { "source": "耶稣家谱", "target": "大卫", "name": "上溯", "des": "王统的谱系按应许上溯至合神心意的王。" },
    { "source": "耶稣家谱", "target": "所罗门", "name": "经由", "des": "马太所记的王室路线：大卫生所罗门，直传到雅各。" },
    { "source": "耶稣家谱", "target": "木匠约瑟", "name": "经由", "des": "谱系按法律经由约瑟之家，上接大卫的王统。" },
    { "source": "耶稣家谱", "target": "耶稣", "name": "证谱", "des": "两份谱系共同作证：拿撒勒人出自应许的谱系。" },
    { "source": "马太", "target": "耶稣家谱", "name": "记载", "des": "开篇十四代乘三的家谱，税吏使徒笔下的王统。" },
    { "source": "路加", "target": "耶稣家谱", "name": "记载", "des": "逆推至亚当的另一个谱系，医生的史笔各有侧重。" },
    { "source": "安得烈", "target": "彼得", "name": "兄弟", "des": "「我们遇见弥赛亚了」，弟弟被哥哥领到主面前。" },
    { "source": "安得烈", "target": "耶稣", "name": "引荐", "des": "施洗约翰的两个门徒跟了耶稣，安得烈是其中之一。" },
    { "source": "耶稣", "target": "彼得", "name": "呼召", "des": "「来跟从我，我要叫你们得人如得鱼一样」。" },
    { "source": "彼得", "target": "耶稣", "name": "认主", "des": "「你是基督，是永生神的儿子」，磐石的名由此而立。" },
    { "source": "西庇太之子雅各", "target": "约翰", "name": "兄弟", "des": "补网的两兄弟同时蒙召，被称「雷子」的一对。" },
    { "source": "耶稣", "target": "西庇太之子雅各", "name": "呼召", "des": "别了父亲和雇工，兄弟俩随主登上了变像的山。" },
    { "source": "耶稣", "target": "约翰", "name": "呼召", "des": "最年轻的使徒，从革尼撒勒湖跟到十字架下。" },
    { "source": "约翰", "target": "耶稣", "name": "所爱", "des": "侧身挨近主怀里的门徒，十架下受托看顾母亲。" },
    { "source": "耶稣", "target": "马太", "name": "呼召", "des": "「你跟从我来」，税吏撇下税关起来跟从了他。" },
    { "source": "多马", "target": "耶稣", "name": "疑信", "des": "「伸出你的指头来，探入我的肋旁」，疑问得到温柔的回应。" },
    { "source": "加略人犹大", "target": "耶稣", "name": "出卖", "des": "三十块银钱与客西马尼的亲嘴，黑暗掌权的一夜。" },
    { "source": "加略人犹大", "target": "最后晚餐", "name": "同席", "des": "蘸饼的一角递给了将要卖主的人。「你所做的，快做吧」。" },
    { "source": "马提亚", "target": "加略人犹大", "name": "补缺", "des": "摇签摇出马提亚，「他就和十一个使徒同列」。" },
    { "source": "司提反", "target": "保罗", "name": "触动", "des": "「扫罗也喜悦他被害」，石头落下时未来的使徒站在旁边。" },
    { "source": "保罗", "target": "耶稣", "name": "归主", "des": "大马士革路上的大光，「扫罗，扫罗，你为什么逼迫我」。" },
    { "source": "巴拿巴", "target": "保罗", "name": "荐引", "des": "「惟有巴拿巴接待他」，领着人人害怕的归信者见使徒。" },
    { "source": "保罗", "target": "巴拿巴", "name": "同工", "des": "安提阿同教一年、又结伴出外传道的首批宣教搭档。" },
    { "source": "巴拿巴", "target": "马可", "name": "带携", "des": "保罗不肯再带马可时，巴拿巴带着表弟另走一路。" },
    { "source": "保罗", "target": "马可", "name": "纳回", "des": "「你来的时候要把马可带来，他在传道的事上于我有益处」。" },
    { "source": "路加", "target": "保罗", "name": "同工", "des": "「所亲爱的医生路加」与保罗同行直到罗马的监牢。" },
    { "source": "马可", "target": "彼得", "name": "转述", "des": "「我儿子马可」，彼得的讲章由这年轻人笔录成书。" },
    { "source": "保罗", "target": "彼得", "name": "分工", "des": "「往外邦人那里去，他们往受割礼的人那里去」，右手相交之约。" },
    { "source": "抹大拉的马利亚", "target": "耶稣", "name": "医释", "des": "「曾赶出七个鬼」的女子，从此跟随服事的队伍。" },
    { "source": "抹大拉的马利亚", "target": "耶稣", "name": "首证", "des": "「你去告诉我的弟兄」，空坟墓的第一位见证人。" },
    { "source": "抹大拉的马利亚", "target": "彼得", "name": "报信", "des": "「有人把主从坟墓里挪了去」，她跑去告诉西门彼得。" },
    { "source": "彼得", "target": "约翰", "name": "同工", "des": "殿门口「金银我都没有，只把我所有的给你」的一对。" }
  ]
}
