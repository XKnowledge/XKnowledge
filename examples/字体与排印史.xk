{
  "version": 2,
  "title": "字体与排印史",
  "description": "文字的服装史：从加洛林小写体到贾蒙的旧衬线，从卡斯隆到迪多的极致对比，从 Futura 的几何纯粹到 Helvetica 的全球面孔，再到可变字体与思源家族——每一个时代都用一套字型回答「文字该长什么样」。",
  "nodes": [
    { "name": "字体与排印史", "des": "type 与 typography 的五百年：字形设计（字体）与版面编排（排印）互为表里的视觉语言体系。字体是无声的发言人，排印是它的舞台调度。", "symbolSize": 70, "category": "书法到活字" },
    { "name": "加洛林小写体", "des": "查理曼时代的标准化手写体，清晰圆润，是今日小写字母的直系祖先。", "symbolSize": 40, "category": "书法到活字" },
    { "name": "哥特黑字体", "des": "中世纪北欧的密集尖峭手写体，古腾堡最初的活字就仿它而成，德文地区用到二十世纪。", "symbolSize": 40, "category": "书法到活字" },
    { "name": "人文主义体", "des": "文艺复兴意大利以加洛林体为「古代体」复兴的手写风，旧衬线的审美源头。", "symbolSize": 40, "category": "书法到活字" },
    { "name": "詹森与初代罗马体", "des": "1470 年威尼斯印刷商尼古拉·詹森铸出第一批成熟罗马活字，手写传统与印刷术的正式分家。", "symbolSize": 50, "category": "书法到活字" },
    { "name": "阿尔杜斯与斜体", "des": "1501 年阿尔杜斯·马努提乌斯为口袋书省纸而铸的斜体活字，italic 从此成为独立声部。", "symbolSize": 40, "category": "书法到活字" },
    { "name": "字盘与大小写", "des": "uppercase 与 lowercase 得名于活字字盘：大写格在上层小写格在下层，排版工人的身体记忆进了语言。", "symbolSize": 40, "category": "书法到活字" },
    { "name": "衬线", "des": "笔画末端的脚注式收笔。衬线体的谱系学：旧式、过渡、现代三段演化。", "symbolSize": 50, "category": "衬线体系" },
    { "name": "字轴与对比度", "des": "圆形笔画的倾斜轴心与粗细反差：两个参数就能把五百年衬线史排成谱系。", "symbolSize": 40, "category": "衬线体系" },
    { "name": "x 字高", "des": "小写字母主体的高度基准：字高越大，同字号显得越大，正文字体的隐形竞争力。", "symbolSize": 40, "category": "衬线体系" },
    { "name": "字距调整", "des": "kerning：特定字母对之间的距离微调，AV、To 这些组合是字体师的绣花功夫。", "symbolSize": 40, "category": "衬线体系" },
    { "name": "加拉蒙", "des": "十六世纪巴黎铸字师克劳德·加拉蒙的旧式衬线，五百年后仍是书籍排版的老钱风。", "symbolSize": 50, "category": "衬线体系" },
    { "name": "卡斯隆", "des": "1720 年代威廉·卡斯隆的英国旧式体，美国《独立宣言》的印刷面孔。", "symbolSize": 40, "category": "衬线体系" },
    { "name": "巴斯克维尔", "des": "1757 年约翰·巴斯克维尔以超平滑纸面与锐利转向做出的过渡体，被富兰克林盛赞。", "symbolSize": 40, "category": "衬线体系" },
    { "name": "迪多", "des": "法国迪多家族的极致对比衬线，细如发丝的衬线是启蒙时代的理性美学。", "symbolSize": 40, "category": "衬线体系" },
    { "name": "博多尼", "des": "帕尔马的贾姆巴蒂斯塔·博多尼，与迪多并称现代衬线双峰，《博多尼印刷手册》传世。", "symbolSize": 50, "category": "衬线体系" },
    { "name": "旧式到现代", "des": "衬线演化三段论：旧式的斜轴温润、过渡的折中、现代的垂直轴与强对比——字形的现代化进程。", "symbolSize": 40, "category": "衬线体系" },
    { "name": "木活字与海报字", "des": "十九世纪木刻大号活字让海报字体爆炸式生长，Fat Face 胖脸体把迪多对比度拉满。", "symbolSize": 40, "category": "工业时代" },
    { "name": "埃及体", "des": "slab serif 方衬线体：工业时代的产物，粗壮的方脚像铸铁机器，广告业的重型武器。", "symbolSize": 40, "category": "工业时代" },
    { "name": "广告字体狂潮", "des": "维多利亚时代报刊广告对花体怪字的无尽胃口，字体目录从几十种膨胀到上千种。", "symbolSize": 40, "category": "工业时代" },
    { "name": "字体铸造厂", "des": "从活字时代的 type foundry 到授权时代的数字字库，字体生意模式的五百年演变。", "symbolSize": 40, "category": "工业时代" },
    { "name": "无衬线起源", "des": "1816 年卡斯隆IV号首次尝试无脚活字，此后百年从怪胎长成主流。", "symbolSize": 40, "category": "无衬线革命" },
    { "name": "Akzidenz-Grotesk", "des": "1898 年柏林铸字厂的实用主义无衬线，后来 Helvetica 的直接母本。", "symbolSize": 40, "category": "无衬线革命" },
    { "name": "Futura", "des": "1927 年保罗·伦纳的几何无衬线：圆规直尺做字，包豪斯精神的脸，登月铭牌用它。", "symbolSize": 50, "category": "无衬线革命" },
    { "name": "Gill Sans", "des": "1928 年埃里克·吉尔的英国人文无衬线，伦敦地铁与企鹅书的国民面孔。", "symbolSize": 40, "category": "无衬线革命" },
    { "name": "Univers", "des": "1957 年阿德里安·弗鲁蒂格的数字编号家族（21、55、67…），字体系统化思维的里程碑。", "symbolSize": 40, "category": "无衬线革命" },
    { "name": "Helvetica", "des": "1957 年马克·米丁格的瑞士无衬线，二十世纪最著名的字体，纽约地铁到苹果系统的默认面孔。", "symbolSize": 50, "category": "无衬线革命" },
    { "name": "Arial", "des": "1982 年为 IBM 兼容 Helvetica 度量的替代字体，微软时代的默认值与「山寨」争议。", "symbolSize": 40, "category": "无衬线革命" },
    { "name": "Frutiger", "des": "1975 年为戴高乐机场导视设计的字体，公共场所认读性的世界标准。", "symbolSize": 40, "category": "无衬线革命" },
    { "name": "新排版运动", "des": "1928 年奇措尔德《新排版》把构成主义原则带进印刷车间：不对称、无衬线、大片留白。", "symbolSize": 40, "category": "现代主义" },
    { "name": "包豪斯排印", "des": "德绍包豪斯的印刷工坊实验：字当作建筑材料的构成主义游戏。", "symbolSize": 40, "category": "现代主义" },
    { "name": "瑞士国际主义", "des": "二战后巴塞尔-苏黎世学派：网格系统、无衬线、客观中立——影响全球企业设计五十年的方法论。", "symbolSize": 50, "category": "现代主义" },
    { "name": "网格系统", "des": "缪勒-布罗克曼的版面数学：栏与模块的坐标纸，排印从手艺变工程的转折。", "symbolSize": 40, "category": "现代主义" },
    { "name": "埃米尔·鲁德", "des": "巴塞尔设计学校的排版教学柱石，《文字排版》把可读性研究带进现代主义。", "symbolSize": 40, "category": "现代主义" },
    { "name": "扎普夫", "des": "赫尔曼·扎普夫：Palatino 与 Zapfino 的作者，书法家与字体设计的合体，数字字体先驱。", "symbolSize": 40, "category": "现代主义" },
    { "name": "马修·卡特", "des": "从铸字世家到屏幕字体的常青树：Verdana、Georgia 为低分辨率屏幕而生，成为早期网页的默认正音。", "symbolSize": 50, "category": "数字字体" },
    { "name": "位图字体", "des": "点阵时代的像素字：72dpi 屏幕上逐点描摹的字形，中文点阵字库是八十年代的国家级工程。", "symbolSize": 40, "category": "数字字体" },
    { "name": "贝塞尔曲线与 PostScript", "des": "1984 年 PostScript 以贝塞尔曲线描述字形，字号从此无限缩放，字体进入数学时代。", "symbolSize": 50, "category": "数字字体" },
    { "name": "TrueType 与 OpenType", "des": "苹果微软的 TrueType 与后来的 OpenType 标准：跨平台、可装智能特性（连字、变音）的字盒格式。", "symbolSize": 40, "category": "数字字体" },
    { "name": "Hinting", "des": "为小字号屏显嵌入的像素级指令，TrueType hinting 是九十年代表现最精细的手工。", "symbolSize": 40, "category": "数字字体" },
    { "name": "网页字体", "des": "@font-face 与 WOFF 让字体随网页下发，从系统字体的囚笼中解放了排印。", "symbolSize": 40, "category": "数字字体" },
    { "name": "可变字体", "des": "2016 年 OpenType Variable：一个文件装下整个字重字宽轴，字体的「一个文件一种字重」时代终结。", "symbolSize": 40, "category": "数字字体" },
    { "name": "中文字体谱系", "des": "宋体的横细竖壮、仿宋的秀挺、楷体的手写余温、黑体的现代直白——四大印刷字体的中国答案。", "symbolSize": 50, "category": "中文字体" },
    { "name": "宋体", "des": "明代定型于江南的刻本字体，横细竖壮喇叭收脚，汉字印刷五百年来的正装。", "symbolSize": 40, "category": "中文字体" },
    { "name": "铅印时代字模", "des": "从美华书馆到上海字模一厂：以吨计的铜模铅字车间，几万字一套的汉字工业。", "symbolSize": 40, "category": "中文字体" },
    { "name": "照相排字", "des": "以字库盘透光成像的手动照排机，铅与火到光与电的中间站台。", "symbolSize": 40, "category": "中文字体" },
    { "name": "汉字激光照排", "des": "王选团队的 748 工程：轮廓加参数的汉字压缩方案，中文出版业整体跃入数字时代的国家工程。", "symbolSize": 50, "category": "中文字体" },
    { "name": "思源字体", "des": "2014 年 Adobe 与 Google 合作的开源泛 CJK 家族：思源黑体与宋体，百万字级工程的开源馈赠。", "symbolSize": 40, "category": "中文字体" },
    { "name": "当代中文字体设计", "des": "方正、汉仪与独立工作室的字库竞赛：从复古美术字复兴到屏幕可读性实验的当代生态。", "symbolSize": 40, "category": "中文字体" }
  ],
