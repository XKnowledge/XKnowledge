{
  "version": 2,
  "title": "化学",
  "description": "元素、反应到有机无机的核心概念网络",
  "nodes": [
    { "name": "元素周期表", "des": "把118种元素按质子数排成一张大表，化学世界的地图，周期与族一查便知。", "symbolSize": 65, "category": "物质结构与元素周期律" },
    { "name": "原子结构", "des": "原子由居中的原子核与绕核运动的电子构成，核内质子数决定元素身份。", "symbolSize": 62, "category": "物质结构与元素周期律" },
    { "name": "元素周期律", "des": "随质子数递增，元素性质呈周期性重复变化的规律，是周期表排列的依据。", "symbolSize": 60, "category": "物质结构与元素周期律" },
    { "name": "核外电子排布", "des": "电子在核外按能量高低分层排布，像住楼房一样从低层往高层住。", "symbolSize": 55, "category": "物质结构与元素周期律" },
    { "name": "电负性", "des": "原子在化学键中争夺电子能力强弱的标尺，氟是抢电子的冠军。", "symbolSize": 55, "category": "物质结构与元素周期律" },
    { "name": "原子半径", "des": "原子大小的量度，同周期从左到右逐渐减小，同族从上到下逐渐增大。", "symbolSize": 45, "category": "物质结构与元素周期律" },
    { "name": "主族元素", "des": "周期表中ⅠA到ⅦA族的元素，最外层电子数决定它们的典型化合价。", "symbolSize": 45, "category": "物质结构与元素周期律" },
    { "name": "过渡金属", "des": "占据表中部的d区金属，化合物色彩斑斓，也是催化剂的常客。", "symbolSize": 45, "category": "物质结构与元素周期律" },
    { "name": "稀有气体", "des": "最外层电子全满的零族元素，性格极不活泼，常用作焊接保护气。", "symbolSize": 42, "category": "物质结构与元素周期律" },
    { "name": "同位素", "des": "质子数相同而中子数不同的同一元素原子，如碳12与碳14，身份同体重异。", "symbolSize": 42, "category": "物质结构与元素周期律" },
    { "name": "卤族元素", "des": "氟氯溴碘一族，最外层只差一个电子，抢电子本领冠绝元素界。", "symbolSize": 45, "category": "物质结构与元素周期律" },
    { "name": "碱金属", "des": "锂钠钾铷铯，最外层只有一个电子，极易丢失，遇水便剧烈反应。", "symbolSize": 42, "category": "物质结构与元素周期律" },
    { "name": "元素金属性", "des": "原子失去电子能力的体现，金属性越强，其最高价氧化物水化物碱性越强。", "symbolSize": 40, "category": "物质结构与元素周期律" },
    { "name": "化学键", "des": "原子之间强烈的相互作用，是物质世界把原子粘在一起的各种胶水。", "symbolSize": 63, "category": "化学键与分子结构" },
    { "name": "共价键", "des": "原子共享电子对形成的键，电子不转让只合用，水分子里就有它。", "symbolSize": 55, "category": "化学键与分子结构" },
    { "name": "离子键", "des": "阴阳离子之间的静电引力，电子彻底易主，如钠丢氯得而成盐。", "symbolSize": 55, "category": "化学键与分子结构" },
    { "name": "金属键", "des": "金属阳离子沉浸在自由电子海洋中形成的键，导电导热的根源。", "symbolSize": 45, "category": "化学键与分子结构" },
    { "name": "分子极性", "des": "正负电荷中心是否重合决定分子极性，水是极性分子，甲烷不是。", "symbolSize": 50, "category": "化学键与分子结构" },
    { "name": "杂化轨道", "des": "原子轨道混合重组形成几个等效轨道，解释甲烷正四面体的关键。", "symbolSize": 50, "category": "化学键与分子结构" },
    { "name": "分子间作用力", "des": "分子与分子之间的弱吸引力，决定沸点高低和溶解难易。", "symbolSize": 45, "category": "化学键与分子结构" },
    { "name": "氢键", "des": "氢与氟氧氮之间特殊的较强吸引力，让水的沸点反常地高。", "symbolSize": 50, "category": "化学键与分子结构" },
    { "name": "晶体结构", "des": "粒子在空间周期性排列的固体，离子晶体、分子晶体、原子晶体各有所长。", "symbolSize": 45, "category": "化学键与分子结构" },
    { "name": "路易斯结构式", "des": "用小圆点表示外层电子的画法，一眼看清成键电子与孤对电子。", "symbolSize": 40, "category": "化学键与分子结构" },
    { "name": "键参数", "des": "键长、键能、键角三兄弟，量化化学键的强弱与分子的形状。", "symbolSize": 42, "category": "化学键与分子结构" },
    { "name": "VSEPR理论", "des": "价层电子对互斥理论，电子对互相排挤，撑出分子的几何构型。", "symbolSize": 45, "category": "化学键与分子结构" },
    { "name": "配位键", "des": "一对电子由单方面提供的特殊共价键，是配合物结构的核心。", "symbolSize": 42, "category": "化学键与分子结构" },
    { "name": "化学平衡", "des": "正逆反应速率相等时各组分浓度不再变化的动态静止状态。", "symbolSize": 60, "category": "化学反应原理" },
    { "name": "催化剂", "des": "改道降低活化能却自身不消耗的推手，生命与工业都离不开它。", "symbolSize": 60, "category": "化学反应原理" },
    { "name": "化学反应速率", "des": "衡量反应快慢的尺子，用单位时间内物质浓度的变化来表示。", "symbolSize": 55, "category": "化学反应原理" },
    { "name": "活化能", "des": "反应必须翻越的能量山峰，山越高，愿意翻山的分子越少。", "symbolSize": 55, "category": "化学反应原理" },
    { "name": "可逆反应", "des": "同一条件下正反两个方向同时进行的反应，永远打不到底。", "symbolSize": 52, "category": "化学反应原理" },
    { "name": "勒夏特列原理", "des": "平衡被扰动后，自动向削弱该扰动的方向移动的补偿原理。", "symbolSize": 52, "category": "化学反应原理" },
    { "name": "平衡常数", "des": "生成物与反应物浓度幂之比，只随温度改变，衡量反应彻底程度。", "symbolSize": 50, "category": "化学反应原理" },
    { "name": "反应热", "des": "反应放出或吸收的热量，是键能断裂与形成的收支账本。", "symbolSize": 50, "category": "化学反应原理" },
    { "name": "焓变", "des": "恒压条件下的反应热，ΔH为负放热为正吸热，能量的会计科目。", "symbolSize": 42, "category": "化学反应原理" },
    { "name": "熵变", "des": "体系混乱度的变化，熵增是宇宙万物自发的共同倾向。", "symbolSize": 42, "category": "化学反应原理" },
    { "name": "自由能", "des": "焓变与熵变合力的判决书，ΔG小于零反应才能自发进行。", "symbolSize": 45, "category": "化学反应原理" },
    { "name": "碰撞理论", "des": "反应靠分子碰撞完成，只有能量足、取向对的碰撞才有效。", "symbolSize": 40, "category": "化学反应原理" },
    { "name": "盖斯定律", "des": "反应总热效应只看始末态与路径无关，可分段拆账再算总账。", "symbolSize": 42, "category": "化学反应原理" },
    { "name": "pH", "des": "氢离子浓度的负对数，pH每降1酸性就增强十倍，酸碱的统一刻度。", "symbolSize": 55, "category": "溶液与酸碱平衡" },
    { "name": "物质的量", "des": "把微观粒子数与宏观质量互相换算的桥梁，单位是摩尔。", "symbolSize": 55, "category": "溶液与酸碱平衡" },
    { "name": "溶液浓度", "des": "单位体积溶液里所含溶质的多少，物质的量浓度是最常用表示法。", "symbolSize": 50, "category": "溶液与酸碱平衡" },
    { "name": "酸碱中和", "des": "酸与碱互相交换成分生成水和盐，放出热量，是滴定分析的基础。", "symbolSize": 52, "category": "溶液与酸碱平衡" },
    { "name": "电离平衡", "des": "弱电解质分子与离子之间建立的动态平衡，溶液越稀越电离。", "symbolSize": 50, "category": "溶液与酸碱平衡" },
    { "name": "水的离子积", "des": "水中氢离子与氢氧根浓度之积恒为常数，是酸碱共用的天平。", "symbolSize": 42, "category": "溶液与酸碱平衡" },
    { "name": "盐类水解", "des": "盐的离子抢走水中的氢或氢氧根，让溶液悄悄显酸性或碱性。", "symbolSize": 48, "category": "溶液与酸碱平衡" },
    { "name": "缓冲溶液", "des": "共轭酸碱对组成的抗压溶液，外加少量酸碱pH都纹丝不动。", "symbolSize": 45, "category": "溶液与酸碱平衡" },
    { "name": "沉淀溶解平衡", "des": "难溶盐在溶液中建立的无声平衡，沉淀与溶解暗中进行。", "symbolSize": 45, "category": "溶液与酸碱平衡" },
    { "name": "溶度积", "des": "沉淀溶解平衡的常数，比较谁先沉淀谁后沉淀的裁判。", "symbolSize": 42, "category": "溶液与酸碱平衡" },
    { "name": "弱电解质", "des": "在水中只能部分电离的化合物，醋酸和氨水都是代表。", "symbolSize": 40, "category": "溶液与酸碱平衡" },
    { "name": "滴定分析", "des": "用已知浓度的溶液滴定未知溶液，变色点一锤定音的定量方法。", "symbolSize": 42, "category": "溶液与酸碱平衡" },
    { "name": "酸碱指示剂", "des": "随pH变色的信号灯，酚酞遇碱泛红，甲基橙酸红碱黄。", "symbolSize": 40, "category": "溶液与酸碱平衡" },
    { "name": "氧化还原反应", "des": "电子发生转移的反应，升失氧降得还，化学世界的能量交易。", "symbolSize": 63, "category": "氧化还原与电化学" },
    { "name": "原电池", "des": "把氧化还原拆到两极进行的发电装置，化学能就地变成电能。", "symbolSize": 58, "category": "氧化还原与电化学" },
    { "name": "电解池", "des": "外电流强迫非自发反应发生的装置，用电把化合物硬生生拆开。", "symbolSize": 55, "category": "氧化还原与电化学" },
    { "name": "化合价", "des": "元素在化合物中的电荷身份，升降正是电子转移的账面记录。", "symbolSize": 52, "category": "氧化还原与电化学" },
    { "name": "氧化剂", "des": "抢走电子自己被还原的一方，氧气和高锰酸钾都是典型。", "symbolSize": 50, "category": "氧化还原与电化学" },
    { "name": "还原剂", "des": "交出电子自己被氧化的一方，活泼金属和碳是老牌还原剂。", "symbolSize": 50, "category": "氧化还原与电化学" },
    { "name": "电极电势", "des": "电极得失电子趋势的电压表，数值越正氧化性越强。", "symbolSize": 45, "category": "氧化还原与电化学" },
    { "name": "金属腐蚀", "des": "金属被氧化的自发败坏过程，铁生锈是最常见的电化学腐蚀。", "symbolSize": 48, "category": "氧化还原与电化学" },
    { "name": "金属防护", "des": "牺牲阳极或镀层隔离，用各种手段拖住金属变锈的脚步。", "symbolSize": 42, "category": "氧化还原与电化学" },
    { "name": "电镀", "des": "用电解原理给物件穿上一层金属外衣，既美观又防腐蚀。", "symbolSize": 42, "category": "氧化还原与电化学" },
    { "name": "燃料电池", "des": "氢气氧气在电极上安静发电的电池，产物只有清洁的水。", "symbolSize": 45, "category": "氧化还原与电化学" },
    { "name": "半反应", "des": "把氧化还原拆成失电子与得电子两半的记账方式，配平利器。", "symbolSize": 40, "category": "氧化还原与电化学" },
    { "name": "干电池", "des": "锌锰一次电池，随身携带的化学能小仓库，用完即弃。", "symbolSize": 40, "category": "氧化还原与电化学" },
    { "name": "官能团", "des": "决定化合物特性的原子团，羟基羧基醛基，认住它就认住性格。", "symbolSize": 62, "category": "有机化学基础" },
    { "name": "聚合物", "des": "单体手拉手连成的长链大分子，塑料纤维橡胶的本体。", "symbolSize": 55, "category": "有机化学基础" },
    { "name": "烃", "des": "只含碳氢两种元素的化合物，有机世界最简洁的骨架家族。", "symbolSize": 55, "category": "有机化学基础" },
    { "name": "同分异构体", "des": "分子式相同而结构不同的化合物，同样的原子另一种拼法。", "symbolSize": 52, "category": "有机化学基础" },
    { "name": "苯", "des": "六个碳环上电子高度离域的芳香烃，介于单双键之间的特殊键。", "symbolSize": 50, "category": "有机化学基础" },
    { "name": "蛋白质", "des": "氨基酸缩合形成的生物大分子，生命活动的主要执行者。", "symbolSize": 48, "category": "有机化学基础" },
    { "name": "酯化反应", "des": "羧酸与醇脱去一分子水生成酯，香料工业的核心反应。", "symbolSize": 48, "category": "有机化学基础" },
    { "name": "取代反应", "des": "有机分子里的原子或原子团被别的基团顶替换位的反应。", "symbolSize": 48, "category": "有机化学基础" },
    { "name": "加成反应", "des": "不饱和键断开一截直接吞入新原子，双键就此变单键。", "symbolSize": 45, "category": "有机化学基础" },
    { "name": "烷烃", "des": "碳碳单键的饱和链烃，甲烷乙烷丙烷，性情温和的骨架。", "symbolSize": 45, "category": "有机化学基础" },
    { "name": "烯烃", "des": "含碳碳双键的不饱和烃，双键活泼易加成，是塑料的原料。", "symbolSize": 45, "category": "有机化学基础" },
    { "name": "醇", "des": "带羟基的有机化合物，乙醇最常见，能被氧化也能发生取代。", "symbolSize": 45, "category": "有机化学基础" },
    { "name": "羧酸", "des": "带羧基的有机酸，醋酸是代表，兼具酸性与酯化的双重身份。", "symbolSize": 45, "category": "有机化学基础" },
    { "name": "酯", "des": "羧酸与醇脱水的产物，许多花香果香都来自这个家族。", "symbolSize": 42, "category": "有机化学基础" }
  ],
