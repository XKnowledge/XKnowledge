"category":"宋元文学"},{"name":"话本","des":"说书人的底本，白话小说的直系源头。","symbolSize":40,"category":"宋元文学"},{"name":"散曲","des":"元代新兴韵文，与剧曲相对的清唱曲。","symbolSize":30,"category":"宋元文学"},{"name":"马致远","des":"秋思之祖，天净沙·秋思二十八字冠绝古今。","symbolSize":40,"category":"宋元文学"},{"name":"明清小说","des":"小说成为文学大宗，四大名著与世情讽刺各极其实。","symbolSize":60,"category":"明清小说"},{"name":"三国演义","des":"罗贯中著，七分实三分虚的历史演义开山。","symbolSize":50,"category":"明清小说"},{"name":"罗贯中","des":"章回小说的开创者之一。","symbolSize":30,"category":"明清小说"},{"name":"水浒传","des":"施耐庵著，官逼民反的英雄传奇。","symbolSize":50,"category":"明清小说"},{"name":"施耐庵","des":"水浒作者，话本集群体的最后定型者。","symbolSize":30,"category":"明清小说"},{"name":"西游记","des":"吴承恩著，神魔小说的想象盛宴。","symbolSize":50,"category":"明清小说"},{"name":"吴承恩","des":"以谐剧写庄严的西游记作者。","symbolSize":30,"category":"明清小说"},{"name":"金瓶梅","des":"第一部文人独创的世情小说，由神魔转入人情。","symbolSize":40,"category":"明清小说"},{"name":"红楼梦","des":"曹雪芹著，千古绝唱的白话小说之王，中国文学的莎士比亚。","symbolSize":70,"category":"明清小说"},{"name":"曹雪芹","des":"批阅十载、增删五次，举家食粥著书黄叶村。","symbolSize":50,"category":"明清小说"},{"name":"聊斋志异","des":"蒲松龄著，用传奇法而以志怪的文言短篇之王。","symbolSize":40,"category":"明清小说"},{"name":"蒲松龄","des":"柳泉居士，设茶采风的故事大王。","symbolSize":40,"category":"明清小说"},{"name":"儒林外史","des":"吴敬梓著，讽刺小说的成立。","symbolSize":40,"category":"明清小说"},{"name":"三言二拍","des":"冯梦龙凌濛初编，拟话本的巅峰。","symbolSize":30,"category":"明清小说"},{"name":"五四新文学","des":"白话取代文言的文学革命，现代文学的开端。","symbolSize":50,"category":"近现代文学"},{"name":"白话文","des":"以口语为基础的现代书面语。","symbolSize":40,"category":"近现代文学"},{"name":"胡适","des":"文学改良刍议的八不主义，新文学的理论先驱。","symbolSize":40,"category":"近现代文学"},{"name":"鲁迅","des":"现代文学之父，横眉冷对千夫指。","symbolSize":60,"category":"近现代文学"},{"name":"狂人日记","des":"第一篇现代白话小说，救救孩子。","symbolSize":40,"category":"近现代文学"},{"name":"阿Q正传","des":"精神胜利法的国民性解剖。","symbolSize":40,"category":"近现代文学"},{"name":"郭沫若","des":"《女神》的浪漫主义呐喊。","symbolSize":40,"category":"近现代文学"},{"name":"茅盾","des":"社会剖析派，《子夜》的宏阔结构。","symbolSize":40,"category":"近现代文学"},{"name":"老舍","des":"京味小说，《骆驼祥子》与《茶馆》。","symbolSize":40,"category":"近现代文学"},{"name":"巴金","des":"《家》的控诉与青年出走。","symbolSize":40,"category":"近现代文学"},{"name":"曹禺","des":"《雷雨》标志中国话剧成熟。","symbolSize":30,"category":"近现代文学"},{"name":"沈从文","des":"《边城》的牧歌，湘西世界的造梦者。","symbolSize":40,"category":"近现代文学"},{"name":"张爱玲","des":"苍凉的手势，都市传奇的现代变奏。","symbolSize":40,"category":"近现代文学"},{"name":"朦胧诗","des":"北岛顾城舒婷，重新发现意象与自我。","symbolSize":30,"category":"近现代文学"}],"links":[{"source":"诗经","target":"中国文学史","name":"源头","des":"风雅颂三百篇，现实主义的起点。"},{"source":"赋比兴","target":"诗经","name":"手法","des":"六义中的三种表现方法。"},{"source":"楚辞","target":"中国文学史","name":"源头","des":"南方巫风想象，浪漫主义的起点。"},{"source":"屈原","target":"楚辞","name":"创造","des":"楚辞体式因他而定型。"},{"source":"离骚","target":"屈原","name":"著作","des":"路漫漫其修远兮的求索之歌。"},{"source":"诗经","target":"楚辞","name":"双源","des":"北方写实与南方想象两大源头。"},{"source":"先秦诸子散文","target":"中国文学史","name":"一脉","des":"论辩与寓言奠定散文传统。"},{"source":"司马相如","target":"汉赋","name":"高峰","des":"子虚上林的铺陈极致。"},{"source":"司马迁","target":"史记","name":"著述","des":"究天人之际，通古今之变，成一家之言。"},{"source":"史记","target":"中国文学史","name":"典范","des":"史传文学确立中国叙事传统。"},{"source":"史记","target":"汉书","name":"开创","des":"纪传体例为汉书所承。"},{"source":"乐府诗","target":"中国文学史","name":"源流","des":"感于哀乐，缘事而发。"},{"source":"古诗十九首","target":"乐府诗","name":"承接","des":"文温以丽的五言由乐府滋养。"},{"source":"曹操","target":"建安文学","name":"领袖","des":"外定武功，内兴文学。"},{"source":"曹操","target":"乐府诗","name":"旧题新声","des":"用汉乐府旧题写时代悲慨。"},{"source":"曹植","target":"建安文学","name":"代表","des":"才高八斗，洛神之赋。"},{"source":"陶渊明","target":"田园诗","name":"开创","des":"采菊东篱下，悠然见南山。"},{"source":"谢灵运","target":"山水诗","name":"开创","des":"池塘生春草，园柳变鸣禽。"},{"source":"田园诗","target":"山水诗","name":"并称","des":"陶谢并称，唐代王孟的先声。"},{"source":"志怪小说","target":"唐传奇","name":"先河","des":"搜神记为唐传奇伏脉。"},{"source":"世说新语","target":"志怪小说","name":"对照","des":"志人与志怪的小说双轨。"},{"source":"刘勰","target":"文心雕龙","name":"著述","des":"体大思精，笼罩文论千年。"},{"source":"昭明文选","target":"文心雕龙","name":"同代双璧","des":"南朝选本与文论的两座高峰。"},{"source":"骈文","target":"汉赋","name":"渊源","des":"四六对偶由赋体演化。"},{"source":"唐诗","target":"中国文学史","name":"巅峰","des":"诗到唐代众体皆备。"},{"source":"