{
  "version": 2,
  "title": "星球大战宇宙",
  "description": "从塔图因的双日黄昏到埃克斯戈的最终对决：原力的光明与黑暗、天行者三代的命运，与一个银河帝国兴衰的编年史。",
  "nodes": [
    { "name": "星球大战宇宙", "des": "1977 年一部太空歌剧意外长成的跨媒体银河：九部正传、无数剧集与游戏共享同一条时间线，师徒与父子的循环是它永恒的母题。", "symbolSize": 70, "category": "银河全景" },
    { "name": "原力", "des": "贯穿一切生命的能量场，由它生出绝地与西斯的千年之争；它不辨善恶，只等待被使用的方式。", "symbolSize": 60, "category": "原力与教团" },
    { "name": "光明面与黑暗面", "des": "同一原力的两种取向：克制、守护与联结，或恐惧、愤怒与占有——多数堕落只需一个害怕失去的念头。", "symbolSize": 40, "category": "原力与教团" },
    { "name": "原力平衡", "des": "预言中的终极状态：不是光明压倒黑暗，而是两者回到恰当的比例，代价往往由整个银河支付。", "symbolSize": 40, "category": "原力与教团" },
    { "name": "原力敏感者", "des": "血液中有机氯甲烷含量超标的幸运儿，能感知并操纵原力，被绝地招募或被西斯猎取。", "symbolSize": 40, "category": "原力与教团" },
    { "name": "绝地武士团", "des": "原力光明面的武士僧团，千年充当共和国的调停者与护卫，因僵化的教条在自己的圣殿里被一夜清空。", "symbolSize": 50, "category": "原力与教团" },
    { "name": "绝地议会", "des": "绝地的最高决策机构，十二席位围坐论道，既错过天选之子，也错过身边的议长。", "symbolSize": 40, "category": "原力与教团" },
    { "name": "绝地圣殿", "des": "科洛桑塔尖之上的武士团总部，陷落后被改建为皇帝的宫殿，荣耀的原址成了权力的墓碑。", "symbolSize": 40, "category": "原力与教团" },
    { "name": "西斯", "des": "原力黑暗面的古老教团，历经内战自我毁灭后立下二人法则：一师一徒，以阴谋代替数量。", "symbolSize": 50, "category": "原力与教团" },
    { "name": "二人法则", "des": "达斯·贝恩定下的生存铁律：主人握权力，学徒渴望权力，弑师即换届，千年不衰。", "symbolSize": 40, "category": "原力与教团" },
    { "name": "天选之子预言", "des": "「他将为原力带来平衡」——绝地以为是光明全面胜利，平衡却以几乎清空绝地的方式到来。", "symbolSize": 40, "category": "原力与教团" },
    { "name": "光剑", "des": "等离子束的剑刃，绝地与西斯的身份象征，凯伯水晶的颜色泄露主人的立场。", "symbolSize": 40, "category": "原力与教团" },
    { "name": "原力闪电", "des": "黑暗面的极端技艺，从指尖喷涌的雷霆，常留着对付出人意料的敌人。", "symbolSize": 40, "category": "原力与教团" },
    { "name": "心灵控心术", "des": "「你不想卖给我死亡之星图纸」——对意志薄弱者一挥手就够，对绝地换成三个回合。", "symbolSize": 40, "category": "原力与教团" },
    { "name": "施密·天行者", "des": "塔图因的奴隶母亲，无夫而孕诞下原力之子，临终前的安详成了儿子黑化的第一块基石。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "阿纳金·天行者", "des": "预言中的天选之子，从九岁的奴隶神童到银河最恐惧的黑爵士达斯·维达，最后以一场弑主完成迟来三十年的平衡。", "symbolSize": 60, "category": "英雄与家族" },
    { "name": "帕德梅·艾米达拉", "des": "纳布女王出身的共和国议员，十四岁执掌星球，与绝地的秘密婚姻埋下了帝国的种子，死于心碎而非疾病。", "symbolSize": 50, "category": "英雄与家族" },
    { "name": "卢克·天行者", "des": "塔图因农场的孤儿，银河最后的老式英雄，以拒绝杀戮的方式完成了绝地的复兴。", "symbolSize": 60, "category": "英雄与家族" },
    { "name": "莱娅·奥加纳", "des": "奥德朗公主、义军领袖、抵抗组织缔造者，原力在她身上以另一种方式强大：从不放弃任何人。", "symbolSize": 50, "category": "英雄与家族" },
    { "name": "汉·索罗", "des": "千年隼的走私者船长，嘴上只信钱和运气，身体一次次替朋友把命垫上。", "symbolSize": 50, "category": "英雄与家族" },
    { "name": "凯洛·伦", "des": "本·索罗，莱娅与汉的儿子，卢克的侄徒，戴着祖父的破碎面具寻找自己的黑暗，最终在太阳升起的接舷战里回到光明。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "蕾伊", "des": "贾库拾荒的女孩，原力自己找到的答案，从等待父母到自命名天行者，用一代人的时间重走完绝地的路。", "symbolSize": 50, "category": "英雄与家族" },
    { "name": "欧比旺·克诺比", "des": "「本」，从莽撞的学徒到老练的将军再到双日下的独居隐士，一生都在替师门收拾两代人的残局。", "symbolSize": 50, "category": "英雄与家族" },
    { "name": "尤达", "des": "九百岁的绝地宗师，倒装句的智者，把「做与不做没有试试」教给了最后一个学生。", "symbolSize": 50, "category": "英雄与家族" },
    { "name": "阿索卡·塔诺", "des": "阿纳金的学徒，被冤屈后离团出走，成为灰色地带的浪游者，帝国废墟上活着的老绝地之一。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "丘巴卡", "des": "卡希克的伍基人战士，千年隼的副驾驶与大副，欠汉·索罗一条命，还了一辈子。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "C-3PO", "des": "礼仪机器人，六百万种语言的翻译家，全程知情的胆小鬼，九部史诗的活体字幕。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "R2-D2", "des": "天文机器人，所有人秘密的保管箱，从纳布到埃克斯戈，它修好的东西比一个舰队还多。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "BB-8", "des": "抵抗组织的球形宇航技工机器人，波·达默龙的搭档，装着一块决定战局的地图。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "兰多·卡瑞辛", "des": "云城行政官、赌徒、永远的耍帅者，出卖过朋友一次，然后用后半生把它赢回来。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "波·达默龙", "des": "抵抗组织王牌飞行员，莱娅最锋利的剑，信条是先飞进去再想撤路。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "芬恩", "des": "从编号 FN-2187 逃亡的暴风兵，第一个把头盔砸在机库里的人，用一场叛逃证明盔甲里有人。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "丁·贾林", "des": "曼达洛赏金猎人，「这是我的道路」，头盔从不示人，为护送一个孩子跑遍边疆。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "格罗古", "des": "尤达同族的幼儿，五十年才长到能抓丸子，原力却足以掀翻一头犀牛怪。", "symbolSize": 40, "category": "英雄与家族" },
    { "name": "帕尔帕廷", "des": "达斯·西迪厄斯，藏在共和衣袍里的最后一位西斯，以三场战争蛀空一个文明，死了两次还留了备份。", "symbolSize": 60, "category": "阵营与反派" },
    { "name": "达斯·摩尔", "des": "达斯·摩尔，红黑文身的扎布拉克杀手，双头光剑首次亮相就带走了一位绝地大师，怨恨支撑他多活了三十年。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "杜库伯爵", "des": "达斯·泰拉纳斯，前绝地贵族转投黑暗面，优雅的剑客，始终只是师父计划里的耗材。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "塔金总督", "des": "高星区总督，死星的第一任指挥官，以炸毁奥德朗演示秩序，与失败一起蒸发在雅文的光束里。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "银河共和国", "des": "千年民主的银河共和国，被一个人用战争、授权与爱国的名义，合法地拆成了帝国。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "银河帝国", "des": "帕尔帕廷的新秩序：白色盔甲、灰色舰影与死星的威慑，十九年后被一群拖鞋飞船推翻。", "symbolSize": 50, "category": "阵营与反派" },
    { "name": "克隆人军队", "des": "卡米诺培育的大军，编号代替姓名，脑内的抑制芯片等待一道六十六号的指令。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "暴风兵", "des": "帝国军基的白甲步兵，瞄准技术是银河第一笑话，数量却从不让人笑得出来。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "义军同盟", "des": "从零散的地方起义长成的联盟，以凤凰标记集结，用一艘艘旧船换帝国的分崩离析。", "symbolSize": 50, "category": "阵营与反派" },
    { "name": "蒙·莫斯马", "des": "钱德里拉出身的议员与义军领袖，白发下的冷静算计，是同盟真正的政治大脑。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "贾巴", "des": "塔图因的赫特人黑帮头目，宫殿里的蛞蝓之王，欠他的碳凝账最终被铁链结清。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "波巴·费特", "des": "詹戈的克隆之子，曼达洛盔甲的赏金猎人，被误判死于沙坑，实际活着回来继承了塔图因的王座。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "第一秩序", "des": "帝国残党在未知区域孵化的新政权，以弑星者的红光接续旧帝国的梦。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "斯诺克", "des": "第一秩序的最高领袖，基因实验室里的造物，一枚用旧即弃的傀儡棋子。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "赫克斯", "des": "第一秩序将军，弑星者的操盘手，与凯洛·伦的宫斗贯穿整个新政权的兴亡。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "抵抗组织", "des": "莱娅在和平年代私下组建的小股部队，被新共和国当作杞人忧天，直到第一秩序开火。", "symbolSize": 40, "category": "阵营与反派" },
    { "name": "塔图因", "des": "双日落下的沙海星球，外环的走私走廊，银河史诗每一幕都从这里的农庄或酒馆开始。", "symbolSize": 50, "category": "行星与场所" },
    { "name": "纳布", "des": "湖光与草原的和平星球，地下的冈根人城市，出了女王也招来了贸易联盟的封锁。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "科洛桑", "des": "整个星球即一座城市，共和国与绝地圣殿的心脏，霓虹之下是上千层的暗面。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "达戈巴", "des": "雾气腾腾的沼泽星球，没有地图值得标注，却是流亡宗师与树根里的黑暗洞穴的家。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "霍斯", "des": "冰封的第六行星，义军 Echo 基地的所在地，雪地战壕里第一次看见了步行机的影子。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "恩多", "des": "森林卫星，伊沃克人的篝火旁，第二颗死星的护盾发生器与帝国的胜利一同烧成了灰。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "雅文四号", "des": "气态巨行星的丛林卫星，玛雅神庙改建的义军基地，一场以分钟计的奇迹在此发生。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "奥德朗", "des": "和平的文明星球，莱娅的母星，以被第一发超武器激光抹除的方式载入史册。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "穆斯塔法", "des": "熔岩奔流的炼狱星球，决斗的火光里诞生了黑爵士的呼吸机，也钉死了师徒三十年的孽债。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "卡希克", "des": "丛林的伍基人母星，树冠上的战场，丘巴卡的故乡。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "阿奇托", "des": "无名海岛群，第一座绝地圣殿的遗址，一个老人在此把自己关进原力里。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "曼达洛", "des": "武士文化的母星，矿与荣耀同色，「This is the Way」的口诀从这里传遍银河。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "贾库", "des": "沙漠坟场，帝国最后的舰队残骸所在地，拾荒者的故乡，新战争与旧战争的交汇点。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "斯卡里夫", "des": "热带环礁星球，帝国档案塔矗立在白沙与浅海之间，一场自杀式冲锋换来了两米宽的图纸。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "埃克斯戈", "des": "未知区域深处的隐藏世界，西斯的古老母星，复生的皇帝在雷电下藏了最后一支舰队。", "symbolSize": 40, "category": "行星与场所" },
    { "name": "死星", "des": "行星级的战斗空间站，单点超激光足以抹除文明，两次建成两次被两米宽的排风口葬送。", "symbolSize": 50, "category": "舰船与兵器" },
    { "name": "弑星者基地", "des": "第一秩序改造冰行星造出的超武器，一发充能吞掉整个霍斯良系统。", "symbolSize": 40, "category": "舰船与兵器" },
    { "name": "千年隼", "des": "科雷利亚货船，0.5 倍光速级的改装怪物，「她可能看起来不怎么样，但她有她的本事」。", "symbolSize": 50, "category": "舰船与兵器" },
    { "name": "X翼战机", "des": "英康 T-65，四翼展开的 S 翼是义军的自由图腾，卢克的座驾。", "symbolSize": 40, "category": "舰船与兵器" },
    { "name": "钛战机", "des": "帝国量产的拦截机，无盾、无超空间引擎、无回收价值，蜂群般扑向目标。", "symbolSize": 40, "category": "舰船与兵器" },
    { "name": "歼星舰", "des": "帝国级歼星舰的楔形舰影，威慑本身的形状，坠毁在贾库沙海里成了孩子们的游乐场。", "symbolSize": 40, "category": "舰船与兵器" },
    { "name": "AT-AT步行机", "des": "四足装甲运输步行机，霍斯雪原上缓缓压来的骆驼巨兽，缆索是它唯一的天敌。", "symbolSize": 40, "category": "舰船与兵器" },
    { "name": "纳布之战", "des": "贸易联盟封锁纳布的战役：飞船隧道里奇迹一击，决斗坑边一位大师倒下，一位学徒跪下。", "symbolSize": 40, "category": "关键战役" },
    { "name": "克隆人战争", "des": "共和国与分离主义的银河大战，克隆人与绝地并肩作战，而战争的每一环都是西斯设计的桥段。", "symbolSize": 40, "category": "关键战役" },
    { "name": "66号令", "des": "预制在克隆人脑中的清除指令，「执行六十六号令」一句白烟，绝地千年教团一夜只剩幸存者名单。", "symbolSize": 40, "category": "关键战役" },
    { "name": "穆斯塔法决斗", "des": "熔岩河上的师徒决裂，「你是我兄弟！」——高处的优势换来一具焦躯与一副黑色盔甲。", "symbolSize": 40, "category": "关键战役" },
    { "name": "斯卡里夫战役", "des": "侠盗一号的自毁冲锋：地面抢塔、舰队挡门、护盾穿针，全灭换来死星图纸两米宽的胜利。", "symbolSize": 40, "category": "关键战役" },
    { "name": "雅文战役", "des": "以分钟计的奇迹：报废中队对死星，原力第一次替瞄具做了主。", "symbolSize": 40, "category": "关键战役" },
    { "name": "霍斯战役", "des": "帝国的铁蹄踏冰而来，义军以离子炮换撤退窗口，第一次真正意义上的溃逃。", "symbolSize": 40, "category": "关键战役" },
    { "name": "云城陷阱", "des": "贝斯坪的糖云之城，维达的香饵：碳凝的挚友、断掉的右手、与一句改写一切的家史。", "symbolSize": 40, "category": "关键战役" },
    { "name": "恩多战役", "des": "森林卫星的终局：地面炸护盾、天上斗舰队、塔里弑师，三线在同一小时里翻盘。", "symbolSize": 40, "category": "关键战役" },
    { "name": "贾库战役", "des": "银河内战的句号，帝国残部在贾库沙海的孤注一掷，输光之后的投降才签得体面。", "symbolSize": 40, "category": "关键战役" },
    { "name": "埃克斯戈决战", "des": "千舰叛军对暗夜舰队，天空医疗舱里的皇帝被孙女亲手了结，西斯的千年执念断在潮声里。", "symbolSize": 40, "category": "关键战役" },
    { "name": "乔治·卢卡斯", "des": "莫德斯托的赛车梦男孩，从坎贝尔神话与黑泽明武士片里拼出一个银河，1977 年之后再也无法剪掉自己的宇宙。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《新希望》", "des": "1977 年的《星球大战》，被剪辑与配乐救活的太空歌剧，把整个好莱坞推进了暑期大片时代。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《帝国反击战》", "des": "1980 年的黑暗续章，伊尔文·柯什纳执导，「我是你的父亲」成为影史最大的台词炸弹。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《绝地归来》", "des": "1983 年的原初三部曲终章，黑色头盔下的父亲转回光明，伊沃克篝火为旧时代送葬。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《魅影危机》", "des": "1999 年的前传开篇，九岁的天选之子离开沙海，达斯·摩尔的双刃光剑劈开了十六年的等待。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《克隆人的进攻》", "des": "2002 年的中章，分离主义机器大军对克隆人军团，绝地陷入战争的同时也陷入了教条的裂缝。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《西斯的复仇》", "des": "2005 年的坠幕：圣殿火光、议会改帜、熔岩决裂，民主以雷鸣掌声葬送了自己。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《原力觉醒》", "des": "2015 年的传承重启，贾库的拾荒女孩接过光剑，旧三杰与新世代在弑星者的红光下交接。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《最后的绝地》", "des": "2017 年最具争议的一章：天行者自我放逐又自我燃烧，原力不属于任何一个家族。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《天行者崛起》", "des": "2019 年的九部曲终章，埃克斯戈的雷暴里，蕾伊借来历代绝地的声音说出了自己的姓氏。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《侠盗一号》", "des": "2016 年的战争片外传，窃取死星图纸的特工全灭，「 rebellions are built on hope 」。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "《曼达洛人》", "des": "2019 年开启的真人剧集，赏金猎人与绿崽的边疆公路片，把银河拉回了最初西部片的味道。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "传奇旧正史", "des": "2014 年前的扩展宇宙：索龙元帅、绝地学院与遇战疯战争，被正史重设定格为「传说」，活在设定集的脚注里。", "symbolSize": 40, "category": "作品与幕后" },
    { "name": "约翰·威廉姆斯", "des": "九部正传的配乐者，开场号角五秒即令全场起立，银河的声音本身就是他的签名。", "symbolSize": 40, "category": "作品与幕后" }
