{"version":2,"nodes":[{"name":"中国书法史","des":"汉字形体三千年的演进史，也是笔墨与人格互相塑造的历史，本图一切脉络由此生发。","symbolSize":70,"category":"字体源流"},{"name":"甲骨文","des":"殷商契刻于龟甲兽骨，刀锋方折峻利，结字疏密与章法已见自觉，书法史的第一缕刻痕。","symbolSize":40,"category":"字体源流"},{"name":"金文","des":"铸于钟鼎彝器，线条圆浑凝重，肥笔块面存宗庙气象，西周为其极盛之期。","symbolSize":40,"category":"字体源流"},{"name":"石鼓文","des":"刻于十枚鼓形石上的猎碣文字，结体方正匀停，是留存至今最早的刻石篆书。","symbolSize":50,"category":"字体源流"},{"name":"大篆","des":"狭指籀文，广义统摄两周金文，上承甲骨下启小篆，古文字谱系的主干。","symbolSize":40,"category":"字体源流"},{"name":"小篆","des":"秦并天下后厘定的标准字体，线条匀净如玉箸，结构对称谨严，文字第一次大一统。","symbolSize":40,"category":"字体源流"},{"name":"李斯","des":"秦丞相主持书同文字，相传作《仓颉篇》，峄山泰山诸刻石皆出其手，玉箸篆之祖。","symbolSize":40,"category":"字体源流"},{"name":"隶变","des":"篆书草写引发的系统性简化，解散篆体、化圆为方，古今文字由此分野，汉字史上最大转向。","symbolSize":50,"category":"字体源流"},{"name":"隶书","des":"蚕头燕尾、一波三磔，由徒隶之书升为庙堂之体，东汉碑刻将其推向极盛。","symbolSize":40,"category":"字体源流"},{"name":"章草","des":"隶书之捷，字字独立而波磔犹存，皇象《急就章》为其典型，是今草的母体。","symbolSize":40,"category":"字体源流"},{"name":"今草","des":"去波磔而笔画连属，上下字血脉贯通，经二王删润定型，此后草书之正脉。","symbolSize":40,"category":"字体源流"},{"name":"狂草","des":"以情驭笔、法随气行，旭素一出，草书有了浪漫主义的巅峰，亦近于不可学的绝地。","symbolSize":40,"category":"字体源流"},{"name":"楷书","des":"敛尽波磔，点画顿挫分明，结体法度谨严，唐楷立其极峰，千年童蒙由此入门。","symbolSize":50,"category":"字体源流"},{"name":"行书","des":"楷之流动、草之易识，介乎两体之间最宜日用，晋人手笔遂成千古绝唱。","symbolSize":50,"category":"字体源流"},{"name":"《说文解字》","des":"许慎以小篆为纲分五百四十部，形义相训，字学与书法共奉的一部元典。","symbolSize":40,"category":"字体源流"},{"name":"卫夫人","des":"传为王羲之启蒙之师，《笔阵图》以千里阵云喻横，簪花小楷清雅有韵。","symbolSize":40,"category":"晋唐书家"},{"name":"王羲之","des":"尽揽汉魏众家笔法而熔铸新体，遒媚劲健，唐太宗推为尽善尽美，千古书圣。","symbolSize":60,"category":"晋唐书家"},{"name":"王献之","des":"劝父改体，创连绵奔放之草，风流媚趣时称过乃父，后世与羲之并称二王。","symbolSize":50,"category":"晋唐书家"},{"name":"智永","des":"王羲之七世孙，居永欣寺阁四十年，书真草千字文八百本分施浙东诸寺。","symbolSize":40,"category":"晋唐书家"},{"name":"欧阳询","des":"楷法险劲瘦硬，于平正中见险绝，复归平正，《九成宫》为唐楷立极。","symbolSize":50,"category":"晋唐书家"},{"name":"虞世南","des":"得智永亲传，书如其人外柔内刚，君子藏器，《孔子庙堂碑》为唐楷雅音。","symbolSize":40,"category":"晋唐书家"},{"name":"褚遂良","des":"疏通隶意以入楷法，瘦润华逸如瑶台婵娟，笔法下开颜真卿之门户。","symbolSize":40,"category":"晋唐书家"},{"name":"颜真卿","des":"变初唐瘦硬为雄浑外拓，忠烈之气贯于笔墨，《祭侄文稿》血泪与金石同铸。","symbolSize":60,"category":"晋唐书家"},{"name":"柳公权","des":"以心正笔正谏君，骨鲠之气入书，与颜真卿并称颜筋柳骨，唐楷殿军。","symbolSize":50,"category":"晋唐书家"},{"name":"张旭","des":"观公主与担夫争道而悟笔法，颠草惊风骤雨，草圣之名与羲之并悬。","symbolSize":50,"category":"晋唐书家"},{"name":"怀素","des":"贫无纸可书种蕉万株，观夏云奇峰而悟草法，以狂继颠，酒酣兴发。","symbolSize":40,"category":"晋唐书家"},{"name":"孙过庭","des":"《书谱》三千七百言文墨双绝，执使转用之辨精微，唐人论书第一手。","symbolSize":40,"category":"晋唐书家"},{"name":"杨凝式","des":"号杨疯子，得颜之气而化为萧散，《韭花帖》茂逸冲和，宋人尚意自此启程。","symbolSize":40,"category":"宋明清翰墨"},{"name":"宋四家","des":"苏黄米蔡并称，一反唐人尚法之崇，转而尊崇意趣，文人书风自此成主流。","symbolSize":50,"category":"宋明清翰墨"},{"name":"苏轼","des":"“我书意造本无法”，丰腴扁阔藏巧于拙，学问文章之气郁郁芊芊发于笔墨。","symbolSize":50,"category":"宋明清翰墨"},{"name":"黄庭坚","des":"长枪大戟、辐射开张，观荡桨群丁而悟笔法，字势奇崛一如其诗风。","symbolSize":40,"category":"宋明清翰墨"},{"name":"米芾","des":"集古字三十年而后自成家，八面出锋、刷字痛快，沉着与飞翥一人兼之。","symbolSize":40,"category":"宋明清翰墨"},{"name":"赵佶","des":"帝王书家第一人，瘦金体如屈铁断金，精丽的书画同出一副宫廷心眼。","symbolSize":40,"category":"宋明清翰墨"},{"name":"赵孟頫","des":"力倡复古直追晋唐，以用笔千古不易重立规矩，日书万字而气韵不衰。","symbolSize":60,"category":"宋明清翰墨"},{"name":"董其昌","des":"淡墨秀逸、疏空取势，生秀出于烟润之外，帖学暮色里最后一抹清光。","symbolSize":40,"category":"宋明清翰墨"},{"name":"王铎","des":"一日临帖、一日应索，连绵草势沉雄跌宕，明清巨轴书法的开拓者。","symbolSize":40,"category":"宋明清翰墨"},{"name":"傅山","des":"作字先作人，宁拙毋巧宁丑毋媚诸论力戒甜熟，倔强之气遂开碑学先声。","symbolSize":40,"category":"宋明清翰墨"},{"name":"邓石如","des":"布衣终身的碑学书家，以隶笔作篆，篆隶楷皆粹，兼开皖派篆刻之宗。","symbolSize":40,"category":"宋明清翰墨"},{"name":"吴昌硕","des":"一生临石鼓文而一日有一日之境，强抱篆籀之气入书画印，金石气横绝一世。","symbolSize":50,"category":"宋明清翰墨"},{"name":"帖学","des":"以刻帖为范本、宗法二王的千年传统，行草正脉与文人书风的根据地。","symbolSize":50,"category":"碑学帖学"},{"name":"碑学","des":"取法秦汉魏晋碑版，于荒崖漫漶间求金石之气，清代书学最大的一次转向。","symbolSize":60,"category":"碑学帖学"},{"name":"尊碑抑帖","des":"阮元发端、包世臣与康有为张大其军的纲领，斥刻帖翻摹失真，扬碑版原石浑朴。","symbolSize":40,"category":"碑学帖学"},{"name":"金石学","des":"访碑著录、椎拓考释之学，乾嘉以降大盛，学人眼光由纸帛转向金石。","symbolSize":40,"category":"碑学帖学"},{"name":"魏碑","des":"北朝墓志造像题记之属，雄强角出、刀石相激，楷书别开生面的一支。","symbolSize":40,"category":"碑学帖学"},{"name":"《淳化阁帖》","des":"淳化三年摹勒十卷法帖之祖，二王书迹几近其半，帖学千年的武库。","symbolSize":40,"category":"碑学帖学"},{"name":"阮元","des":"官至体仁阁大学士，著《南北书派论》分派立说，尊碑之论自此发端。","symbolSize":40,"category":"碑学帖学"},{"name":"包世臣","des":"《艺舟双楫》推演师说，详论笔法而中兴北碑，尊碑谱系的中坚传递者。","symbolSize":40,"category":"碑学帖学"},{"name":"康有为","des":"《广艺舟双楫》立十六宗，尊魏卑唐之论惊世，碑学理论至此集大成。","symbolSize":50,"category":"碑学帖学"},{"name":"王懿荣","des":"一八九九年从药材龙骨上认出契文，甲骨重见天日，庚子殉国的金石大家。","symbolSize":40,"category":"碑学帖学"},{"name":"何绍基","des":"回腕高悬遍临汉碑，熔篆隶入行草，碑帖融合之路上最早的跋涉者。","symbolSize":40,"category":"碑学帖学"},{"name":"《兰亭序》","des":"永和九年修禊之作，二十八行三百二十四字，重字皆别构，天下第一行书。","symbolSize":50,"category":"经典碑帖"},{"name":"《十七帖》","des":"王羲之草书信札之冠，字字不连而气脉贯通，后世习今草的第一级台阶。","symbolSize":40,"category":"经典碑帖"},{"name":"《九成宫醴泉铭》","des":"魏征撰文，欧阳询七十六岁奉敕而书，险劲秀润无一笔松懈，唐楷神品。","symbolSize":40,"category":"经典碑帖"},{"name":"《雁塔圣教序》","des":"褚遂良晚年臻品，空灵瘦润若美女婵娟，唐楷由森严转向流动的枢纽。","symbolSize":40,"category":"经典碑帖"},{"name":"《多宝塔碑》","des":"颜真卿四十四岁所书，端严整秀而不失丰腴，千万学颜者的第一级台阶。","symbolSize":40,"category":"经典碑帖"},{"name":"《颜勤礼碑》","des":"鲁公晚年楷书之则，横细竖阔、外紧内松，气象磅礴为其本色当行。","symbolSize":40,"category":"经典碑帖"},{"name":"《玄秘塔碑》","des":"柳公权六十四岁所书，骨力洞达、锋棱跃然，后世学柳的不二门户。","symbolSize":40,"category":"经典碑帖"},{"name":"《祭侄文稿》","des":"为殉难亡侄而作的祭文，涂改满纸、血泪入墨，不计工拙而千古无两。","symbolSize":50,"category":"经典碑帖"},{"name":"《寒食帖》","des":"苏轼黄州苦雨之篇，死灰吹不起之句沉郁顿挫，世称天下第三行书。","symbolSize":40,"category":"经典碑帖"},{"name":"《自叙帖》","des":"怀素大历年间书，飞环走汞、骤雨旋风，狂草墨迹长卷的第一标本。","symbolSize":40,"category":"经典碑帖"},{"name":"《书谱》","des":"孙过庭垂拱年间撰并书，三千七百余言文墨双绝，论书之文与草书同高。","symbolSize":40,"category":"经典碑帖"},{"name":"《曹全碑》","des":"东汉隶碑秀逸一路的极致，蚕头燕尾姿致翩翩，字如佳人临镜顾盼。","symbolSize":40,"category":"经典碑帖"},{"name":"《张迁碑》","des":"东汉隶碑方雄一路的代表，方笔斩截、古拙茂密，与曹全各执一端。","symbolSize":40,"category":"经典碑帖"},{"name":"三大行书","des":"兰亭、祭侄、寒食三卷并悬，晋韵、唐魄与宋意俱在，行书一部心史。","symbolSize":40,"category":"经典碑帖"},{"name":"意在笔先","des":"下笔之先已有全局，凝神静思、预想字形，《笔阵图》发端而右军申说。","symbolSize":40,"category":"书论与文房"},{"name":"计白当黑","des":"邓石如语，字画疏处可走马，密处不使透风，空白与笔画同受经营。","symbolSize":40,"category":"书论与文房"},{"name":"屋漏痕","des":"水痕顺壁徐行，喻线条涩进自然、无安排之迹，与锥画沙同为笔法名喻。","symbolSize":40,"category":"书论与文房"},{"name":"神采形质","des":"书之妙道，神采为上而形质次之，王僧虔一语为千年品评立下纲领。","symbolSize":40,"category":"书论与文房"},{"name":"永字八法","des":"侧勒努趯策掠啄磔，一字而八种笔法该备，楷则点画的总纲尽在其中。","symbolSize":40,"category":"书论与文房"},{"name":"文房四宝","des":"笔墨纸砚合为书斋四友，柔毫松烟坚石良纸，共同托起手上的功夫。","symbolSize":50,"category":"书论与文房"},{"name":"毛笔","des":"惟笔软则奇怪生焉，锋有中侧、毫分健柔，一切线条性格皆自此出。","symbolSize":40,"category":"书论与文房"},{"name":"徽墨","des":"松烟油烟杵捣成型，徽州所产为其冠，浓淡枯润遂有墨分五色之妙。","symbolSize":40,"category":"书论与文房"},{"name":"宣纸","des":"宣州皮料所制之书画用纸，生宣渗化、熟宣矜持，纸性一半决定笔性。","symbolSize":40,"category":"书论与文房"},{"name":"砚台","des":"发墨益毫而不损毫者方为佳砚，端歙鲁澄各擅其胜，石品亦成清玩。","symbolSize":40,"category":"书论与文房"},{"name":"篆刻","des":"印宗秦汉、印从书出，以刀代笔于方寸之间，与书法互为表里之艺。","symbolSize":40,"category":"书论与文房"},{"name":"题跋","des":"题于卷尾的诗文考识，鉴藏源流、品第高下皆赖之，卷轴的第二重生命。","symbolSize":40,"category":"书论与文房"}],"links":[{"source":"甲骨文","target":"金文","name":"演变","des":"契刻转为熔铸，线条由方折渐趋圆浑丰润。"},{"source":"金文","target":"大篆","name":"汇为","des":"两周铭文与籀文一脉相承，共同汇成大篆体系。"},{"source":"石鼓文","target":"大篆","name":"典范","des":"鼓形刻石上的籀文遗则，大篆结字的标准器。"},{"source":"大篆","target":"小篆","name":"省改","des":"秦并天下，罢其不与秦文合者，省改而为小篆。"},{"source":"李斯","target":"小篆","name":"厘定","des":"同文之政出其手，玉箸篆法由此立范。"},{"source":"小篆","target":"隶变","name":"孕育","des":"刀笔吏急就省写，篆法在日常书写中溃散。"},{"source":"隶变","target":"隶书","name":"结成","des":"解散篆体、化圆为方，蚕头燕尾之形成立。"},{"source":"隶变","target":"中国书法史","name":"转向","des":"古今文字由此分野，汉字史上最重要的转向。"},{"source":"隶书","target":"章草","name":"捷写","des":"草隶约定俗成，字字独立而波磔犹存。"},{"source":"章草","target":"今草","name":"演进","des":"去波磔、通连属，草书正脉自此脱胎。"},{"source":"今草","target":"狂草","name":"极化","des":"以情驭笔冲决法度，张旭怀素造其极。"},{"source":"隶书","target":"楷书","name":"整饬","des":"敛波磔为顿挫，点画分明而法度立。"},{"source":"楷书","target":"行书","name":"间出","des":"介于楷草之间最宜日用，晋人独绝。"},{"source":"中国书法史","target":"甲骨文","name":"发端","des":"现存最早的成体系汉字，一切自此起步。"},{"source":"《说文解字》","target":"小篆","name":"立纲","des":"以篆为纲，九千字系于五百四十部。"},{"source":"《说文解字》","target":"金石学","name":"滋养","des":"乾嘉考据据以释读金文，字学因而复活。"},{"source":"中国书法史","target":"王羲之","name":"尊为","des":"书圣千年不祧，笼罩此后一切行草讨论。"},{"source":"卫夫人","target":"王羲之","name":"授业","des":"传《笔阵图》笔法，簪花之评启幕右军。"},{"source":"王羲之","target":"王献之","name":"家传","des":"笔法传家，父子并称二王共革新体。"},{"source":"王羲之","target":"《兰亭序》","name":"写就","des":"永和九年修禊雅集，稿成即成绝唱。"},{"source":"王羲之","target":"《十七帖》","name":"写就","des":"晚年草书信札，帖中龙象、习草津梁。"},{"source":"王羲之","target":"行书","name":"变古","des":"熔铸汉魏开遒媚新体，行书自此有法。"},{"source":"王献之","target":"今草","name":"推进","des":"破体连绵一笔书，为草书开尚奇之门。"},{"source":"智永","target":"王羲之","name":"嗣响","des":"七世孙守家法，千字文八百本传其谱系。"},{"source":"智永","target":"永字八法","name":"演备","des":"书真草千文八百本，八法赖以定型传世。"},{"source":"欧阳询","target":"王羲之","name":"取法","des":"初唐诸家自右军出，欧阳询得其骨。"},{"source":"欧阳询","target":"《九成宫醴泉铭》","name":"写就","des":"七十六岁人书俱老，唐楷第一神品。"},{"source":"虞世南","target":"智永","name":"师承","des":"亲炙永欣寺，接续王家笔法谱系。"},{"source":"虞世南","target":"楷书","name":"雅正","des":"《孔子庙堂碑》外柔内刚，立唐楷雅音。"},{"source":"褚遂良","target":"王羲之","name":"取法","des":"疏通隶意入楷，实自右军处得法。"},{"source":"褚遂良","target":"《雁塔圣教序》","name":"写就","des":"晚年空灵瘦润如婵娟，唐楷转关之作。"},{"source":"褚遂良","target":"颜真卿","name":"沾溉","des":"宽绰疏宕一脉相延，唐楷大厅由此而开。"},{"source":"颜真卿","target":"楷书","name":"变法","des":"外拓雄浑一变初唐瘦硬，立庙堂气象。"},{"source":"颜真卿","target":"《多宝塔碑》","name":"写就","des":"四十四岁端严整秀，学颜者的首级台阶。"},{"source":"颜真卿","target":"《颜勤礼碑》","name":"写就","des":"晚年横细竖阔，外紧内松而磅礴。"},{"source":"颜真卿","target":"《祭侄文稿》","name":"写就","des":"祭侄血泪任笔所之，不计工拙而真气弥满。"},{"source":"颜真卿","target":"屋漏痕","name":"拈出","des":"与怀素论笔法，坼壁之路自然无做作。"},{"source":"柳公权","target":"颜真卿","name":"承变","des":"取颜体而益以骨鲠，世称颜筋柳骨。"},{"source":"柳公权","target":"《玄秘塔碑》","name":"写就","des":"骨力洞达锋棱跃然，后世学柳之门户。"},{"source":"柳公权","target":"楷书","name":"立骨","des":"以心正笔正谏君，唐楷法度的最后高峰。"},{"source":"张旭","target":"狂草","name":"开创","des":"观公主担夫争道而悟笔，颠草惊风雨。"},{"source":"张旭","target":"楷书","name":"兼擅","des":"《郎官石柱记》严整，颠外别有法度。"},{"source":"张旭","target":"颜真卿","name":"传法","des":"十二笔意亲授鲁公，谱系一线相续。"},{"source":"怀素","target":"张旭","name":"遥承","des":"以狂继颠，两人草法气类相感相接。"},{"source":"怀素","target":"狂草","name":"驰骋","des":"种蕉代纸、观云悟笔，酒酣兴发而不可遏。"},{"source":"怀素","target":"《自叙帖》","name":"写就","des":"飞环走汞、骤雨旋风，狂草的标准像。"},{"source":"怀素","target":"屋漏痕","name":"对参","des":"坼壁之路与屋漏痕同参，笔贵涩进自然。"},{"source":"孙过庭","target":"《书谱》","name":"写就","des":"三千七百言文墨双绝，唐人论书第一手。"},{"source":"孙过庭","target":"今草","name":"宗王","des":"以二王为宗，俊拔刚断，唐草之正脉。"},{"source":"杨凝式","target":"颜真卿","name":"遥接","des":"得颜之气而化为萧散，唐音遂入宋调。"},{"source":"苏轼","target":"杨凝式","name":"推服","des":"称其笔迹雄杰，尚意之门由此开启。"},{"source":"苏轼","target":"宋四家","name":"居首","des":"苏黄米蔡并称，东坡气韵天成居首。"},{"source":"黄庭坚","target":"宋四家","name":"列名","des":"长枪大戟自成一格，山谷居其亚席。"},{"source":"米芾","target":"宋四家","name":"列名","des":"刷字痛快沉着，八面出锋兼得二王。"},{"source":"苏轼","target":"《寒食帖》","name":"写就","des":"黄州苦雨死灰吹不起，意到笔随。"},{"source":"苏轼","target":"颜真卿","name":"师法","des":"独爱鲁公忠厚，于字外求人格气象。"},{"source":"黄庭坚","target":"《寒食帖》","name":"题跋","des":"跋尾小字精妙，与本文相映成双璧。"},{"source":"黄庭坚","target":"怀素","name":"取法","des":"观荡桨而悟笔，长枪大戟自狂草来。"},{"source":"米芾","target":"王羲之","name":"集古","des":"集古字三十年而成家，腕底自有二王。"},{"source":"米芾","target":"赵佶","name":"供奉","des":"为书画学博士，瑶台召对得论书之宠。"},{"source":"赵佶","target":"楷书","name":"别裁","des":"瘦金体如屈铁断金，帝王楷法独标一格。"},{"source":"赵孟頫","target":"王羲之","name":"复古","des":"直追晋唐一扫南宋颓风，用笔千古不易。"},{"source":"赵孟頫","target":"《兰亭序》","name":"题识","des":"兰亭十三跋，舟行中细与右军对语。"},{"source":"董其昌","target":"赵孟頫","name":"争胜","des":"初习松雪后自树一帜，淡墨别开生面。"},{"source":"董其昌","target":"帖学","name":"殿军","des":"疏空章法生秀，帖学暮色最后一抹清光。"},{"source":"董其昌","target":"题跋","name":"品鉴","des":"题识遍天下，真赝常经其一言而分。"},{"source":"王铎","target":"《淳化阁帖》","name":"临古","des":"一日临帖一日应索，连绵草势自阁帖出。"},{"source":"王铎","target":"帖学","name":"力挽","des":"连绵巨帙沉雄跌宕，帖学最后的光焰。"},{"source":"王铎","target":"傅山","name":"并世","des":"明清之际书坛双峰，一沉雄一倔强。"},{"source":"傅山","target":"赵孟頫","name":"贬抑","des":"四宁四毋直指熟媚，气节遂入书论。"},{"source":"傅山","target":"碑学","name":"先声","des":"力戒甜熟、崇尚拙厚，为尊碑张本。"},{"source":"邓石如","target":"碑学","name":"践行","des":"以隶笔作篆，布衣而开碑学书风。"},{"source":"邓石如","target":"篆刻","name":"入印","des":"印从书出，以刀代笔，遂开皖派门户。"},{"source":"邓石如","target":"计白当黑","name":"拈出","des":"疏处走马、密不透风，空白同受经营。"},{"source":"吴昌硕","target":"石鼓文","name":"临写","des":"一生临石鼓，一日有一日之境界。"},{"source":"吴昌硕","target":"篆刻","name":"重镇","des":"钝刀硬入雄浑苍茫，西泠印社首任社长。"},{"source":"何绍基","target":"颜真卿","name":"私淑","des":"回腕高悬学鲁公，熔篆隶入行草。"},{"source":"何绍基","target":"碑学","name":"会通","des":"遍临汉碑周金，为碑帖融通之先行者。"},{"source":"《淳化阁帖》","target":"帖学","name":"奠基","des":"淳化摹勒十卷，法帖之祖、帖学武库。"},{"source":"帖学","target":"王羲之","name":"尊为","des":"阁帖过半为二王，帖学即二王之学。"},{"source":"《淳化阁帖》","target":"王献之","name":"收录","des":"大令帖目几与乃父分庭抗礼，父子并耀。"},{"source":"阮元","target":"碑学","name":"倡立","des":"《南北书派论》分派立说，尊碑自此发端。"},{"source":"包世臣","target":"阮元","name":"接武","des":"《艺舟双楫》推演师说，北碑益张。"},{"source":"康有为","target":"包世臣","name":"推广","des":"《广艺舟双楫》集其大成，尊魏卑唐。"},{"source":"康有为","target":"尊碑抑帖","name":"力倡","des":"十六宗之说，尊碑之论推至其极。"},{"source":"康有为","target":"魏碑","name":"标举","des":"独尊南碑与龙门造像，卑唐之说惊世。"},{"source":"尊碑抑帖","target":"帖学","name":"论争","des":"斥刻帖翻摹失真，帖学受百年冲击。"},{"source":"魏碑","target":"碑学","name":"取资","des":"龙门造像雄强角出，碑派笔法之源。"},{"source":"魏碑","target":"楷书","name":"别支","des":"北朝楷刻与南帖并峙，别立雄强一格。"},{"source":"金石学","target":"碑学","name":"托举","des":"访碑著录考释成风，学人眼光一变。"},{"source":"王懿荣","target":"甲骨文","name":"发现","des":"一八九九年视药材为古契，商史重光。"},{"source":"王懿荣","target":"金石学","name":"殿军","des":"庚子殉节的名臣学者，收藏考据冠绝一时。"},{"source":"金石学","target":"石鼓文","name":"椎拓","des":"唐人已重石鼓，椎拓考据自此发端。"},{"source":"《九成宫醴泉铭》","target":"楷书","name":"典范","des":"欧书险劲极则，万千学楷者共由之阶梯。"},{"source":"《兰亭序》","target":"行书","name":"立极","des":"三百二十四字，行书法度千年之极。"},{"source":"《兰亭序》","target":"三大行书","name":"居首","des":"真迹殉葬昭陵，摹拓之本亦足千秋。"},{"source":"《祭侄文稿》","target":"三大行书","name":"居次","des":"涂改满纸而真气弥漫，天下第二。"},{"source":"《寒食帖》","target":"三大行书","name":"居三","des":"黄州自书诗卷，宋人尚意书风之极。"},{"source":"《祭侄文稿》","target":"行书","name":"别调","des":"不袭兰亭而血泪斑斑，行书另一极。"},{"source":"《十七帖》","target":"今草","name":"范本","des":"字字不连而气脉贯通，习草之津梁。"},{"source":"《自叙帖》","target":"狂草","name":"极致","des":"狂草墨迹长卷第一标本，飞动如史诗。"},{"source":"《曹全碑》","target":"隶书","name":"秀润","des":"蚕头燕尾姿致翩翩，汉碑清丽一路。"},{"source":"《张迁碑》","target":"隶书","name":"方拙","des":"方笔斩截古拙茂密，与曹全各执一端。"},{"source":"《书谱》","target":"意在笔先","name":"阐发","des":"先散怀抱、意在笔前，唐论之眼。"},{"source":"《书谱》","target":"神采形质","name":"辨析","des":"点画为形质、使转为情性，纲领在焉。"},{"source":"卫夫人","target":"意在笔先","name":"发端","des":"《笔阵图》意前笔后之论启其端绪。"},{"source":"王羲之","target":"意在笔先","name":"申说","des":"夫欲书者先干研墨，凝神静思预想。"},{"source":"永字八法","target":"楷书","name":"立范","des":"侧勒努趯策掠啄磔，八法一字该备。"},{"source":"毛笔","target":"中国书法史","name":"利器","des":"惟笔软则奇怪生焉，柔锋生万态。"},{"source":"毛笔","target":"文房四宝","name":"组成","des":"四友之首，锋毫生发出一切线质。"},{"source":"徽墨","target":"文房四宝","name":"组成","des":"松烟油烟杵捣成型，浓淡枯润分五色。"},{"source":"宣纸","target":"文房四宝","name":"组成","des":"生宣渗化、熟宣矜持，纸性定笔性。"},{"source":"砚台","target":"文房四宝","name":"组成","des":"发墨益毫而不损毫，端歙各擅其胜。"},{"source":"篆刻","target":"小篆","name":"取字","des":"印宗秦汉，篆法乃治印之根本依据。"},{"source":"苏轼","target":"米芾","name":"知音","des":"誉其书当与钟王并行，米芾名动天下。"}],"title":"中国书法史","description":"从甲骨的刻痕到碑帖之争，汉字形体三千年与笔墨的人格。"}