      "symbolSize": 50,
      "category": "中世纪与文艺复兴"
    },
    {
      "name": "佛兰德乐派",
      "des": "自低地诸城出发横扫欧洲宫廷的复调行吟军团，严格卡农与均模仿体系把教堂音乐推向工艺极限。",
      "symbolSize": 40,
      "category": "中世纪与文艺复兴"
    },
    {
      "name": "帕莱斯特里那",
      "des": "反宗教改革时代的罗马圣手，线条纯净互不相犯，以《马尔切洛斯教皇弥撒》证明复调无需亵渎词义即可神圣。",
      "symbolSize": 50,
      "category": "中世纪与文艺复兴"
    },
    {
      "name": "奥兰多·迪·拉索",
      "des": "十六世纪的浪游大师，两千余作横跨弥撒、经文歌与牧歌，悲喜声情皆可信手拈来，文艺复兴复调的收官者。",
      "symbolSize": 40,
      "category": "中世纪与文艺复兴"
    },
    {
      "name": "意大利牧歌",
      "des": "十六世纪意大利世俗合唱的明珠，词句哪里叹息音乐就在哪里半音，为巴洛克歌剧的独白式抒情备好了语法。",
      "symbolSize": 40,
      "category": "中世纪与文艺复兴"
    },
    {
      "name": "巴洛克时期",
