{
  "version": 2,
  "title": "灯塔与航标",
  "description": "从法罗斯灯塔到 IALA 浮标系统：灯塔工程史、菲涅尔透镜、灯质编码与守塔人——人类在海岸线上点亮的安全网络。",
  "nodes": [
    { "name": "灯塔与航标", "des": "人类钉在海岸线上的安全坐标：以石塔对抗海浪，以光学对抗黑夜，以编码对抗迷航——一部用光写成的航海辅助系统史。", "symbolSize": 70, "category": "古代灯塔" },
    { "name": "法罗斯灯塔", "des": "约公元前 280 年立于亚历山大港的百米石塔，古代七大奇迹里专为民生服务的一座。", "symbolSize": 50, "category": "古代灯塔" },
    { "name": "赫拉克勒斯塔", "des": "西班牙拉科鲁尼亚的罗马灯塔，近两千年仍在服役的现存最古老灯塔。", "symbolSize": 40, "category": "古代灯塔" },
    { "name": "中世纪灯塔", "des": "热那亚「灯笼塔」等港城灯火，商人城市以塔顶篝火做自己的港口广告。", "symbolSize": 40, "category": "古代灯塔" },
    { "name": "中国古航标", "des": "泉州六胜塔、杭州六合塔等以塔引航的传统，宋代市舶体系的岸上设施。", "symbolSize": 40, "category": "古代灯塔" },
    { "name": "艾迪斯通灯塔", "des": "英吉利海峡礁石上的四代塔：木塔卷走、木塔烧毁、石塔站住——灯塔工程的完整进化标本。", "symbolSize": 50, "category": "灯塔工程史" },
    { "name": "温斯坦利", "des": "1698 年建成第一代艾迪斯通塔的怪才，1703 年大风暴中与塔同殁的悲情注脚。", "symbolSize": 40, "category": "灯塔工程史" },
    { "name": "斯米顿", "des": "1756 年以花岗岩块、燕尾连接和水硬石灰建起第三代石塔，「土木工程之父」的出道作。", "symbolSize": 50, "category": "灯塔工程史" },
    { "name": "史蒂文森家族", "des": "苏格兰三代建塔世家，把北海狂礁变成阶梯，作家斯蒂文森即出自这个家族。", "symbolSize": 40, "category": "灯塔工程史" },
    { "name": "贝尔礁灯塔", "des": "1811 年亮灯的北海潮汐礁石塔，只在退潮的间隙施工，工程师斯蒂文森的成名作。", "symbolSize": 40, "category": "灯塔工程史" },
    { "name": "美国灯塔体系", "des": "1789 年华盛顿签署的第一批联邦法令之一：灯塔收归国有、免费服务航运。", "symbolSize": 40, "category": "灯塔工程史" },
    { "name": "灯塔船", "des": "锚泊在无法建塔的浅滩灯站，摇晃的灯火与孤独的船员，浮动的灯塔。", "symbolSize": 40, "category": "灯塔工程史" },
    { "name": "菲涅尔透镜", "des": "以环带棱镜把点光源的散光聚成水平薄扇的神奇镜组，一盏灯从此照亮几十公里。", "symbolSize": 50, "category": "光学系统" },
    { "name": "菲涅尔", "des": "波动光学的奠基人之一，1823 年为灯塔设计的第一枚一级透镜，39 岁早逝的法国天才。", "symbolSize": 40, "category": "光学系统" },
    { "name": "透镜级制", "des": "按焦距分成一到六级的镜组体系，一级菲涅尔重达数吨，是灯塔的心脏与身份。", "symbolSize": 40, "category": "光学系统" },
    { "name": "旋转灯器", "des": "水银浮槽承重的旋转机构，发条重锤驱动，把固定的光变成会眨眼的信标。", "symbolSize": 40, "category": "光学系统" },
    { "name": "牛眼透镜与全景灯", "des": "多组镜片围成光环，旋转一周便扫出节奏，光从此可以说话。", "symbolSize": 40, "category": "光学系统" },
    { "name": "鲸油与煤油灯", "des": "从熬鲸油到煤油再到瓦斯，灯芯的亮度就是灯塔的射程。", "symbolSize": 40, "category": "光源演进" },
    { "name": "达伦与乙炔", "des": "发明乙炔闪光器与太阳阀的瑞典工程师，让灯塔自动开关气路，1912 年诺贝尔物理学奖。", "symbolSize": 40, "category": "光源演进" },
    { "name": "电气化灯塔", "des": "电弧灯与白炽灯上塔，配柴油发电机，光强进入百万烛光量级。", "symbolSize": 40, "category": "光源演进" },
    { "name": "现代光源", "des": "卤素灯到 LED 的换代，功耗骤降，太阳能加电池让灯塔自给自足。", "symbolSize": 40, "category": "光源演进" },
    { "name": "灯质", "des": "闪光节奏、颜色与周期的官方编码，如「闪两次、周期十秒」，每座塔独有的名字。", "symbolSize": 50, "category": "灯语与信号" },
    { "name": "灯语与海图注记", "des": "海图上的灯质符号是航海者的摩尔斯电码，翻图即知前方是谁在眨眼。", "symbolSize": 40, "category": "灯语与信号" },
    { "name": "雾号", "des": "蒸汽与压缩空气驱动的雾中号角，浓雾封光时的备用声道。", "symbolSize": 40, "category": "灯语与信号" },
    { "name": "无线电航标", "des": "无线电信标与雷达应答器，让信号穿透黑夜浓雾，灯塔的光长出了电波。", "symbolSize": 40, "category": "灯语与信号" },
    { "name": "罗兰与台卡", "des": "双曲线无线电定位系统，远洋定位从天文走向地面台网，GNSS 时代的前奏。", "symbolSize": 40, "category": "灯语与信号" },
    { "name": "GNSS与航标转型", "des": "卫星定位普及后航标退居冗余与校核，但电子海图之外仍要一盏看得见的灯。", "symbolSize": 40, "category": "灯语与信号" },
    { "name": "浮标", "des": "以锚链系留的水上路标，形状、颜色与顶标各含语义，航标的毛细血管。", "symbolSize": 50, "category": "浮标与系统" },
    { "name": "IALA海上浮标系统", "des": "1982 年统一的全球浮标规则，A 区 B 区两侧互为镜像，红绿归边不再各说各话。", "symbolSize": 40, "category": "浮标与系统" },
    { "name": "侧面标", "des": "进港方向定左右的红绿浮标，航道的护栏与减速带。", "symbolSize": 40, "category": "浮标与系统" },
    { "name": "方位标与孤立危险标", "des": "以锥形顶标指明可航一侧的黄黑花标，绕行危险的几何语法。", "symbolSize": 40, "category": "浮标与系统" },
    { "name": "安全水域标", "des": "红白竖纹的球形标，周围皆可航行的「放心通过」信号。", "symbolSize": 40, "category": "浮标与系统" },
    { "name": "守塔人", "des": "以孤独为职业的人：擦镜、点灯、记录气象，风暴夜通宵摇重锤上发条。", "symbolSize": 50, "category": "守塔人与遗产" },
    { "name": "灯塔自动化", "des": "二十世纪末值守编制陆续撤销，太阳阀、遥测与 LED 让塔自己照顾自己。", "symbolSize": 40, "category": "守塔人与遗产" },
    { "name": "中国近代灯塔", "des": "花鸟山灯塔、硇洲灯塔等近代建塔，与 1871 年设立的中国海关海务科体系。", "symbolSize": 40, "category": "守塔人与遗产" },
    { "name": "灯塔与文化想象", "des": "从透纳的暴风雪到电影与小说，灯塔是最孤独也最安全的浪漫符号。", "symbolSize": 40, "category": "守塔人与遗产" },
    { "name": "国际航标协会", "des": "各国航标管理部门的联合体，统一灯语与浮标规则的全球协调人。", "symbolSize": 40, "category": "守塔人与遗产" }
  ],
