{"version":2,"title":"中医基础理论","description":"阴阳五行、脏腑经络到气血津液的核心概念网络","nodes":[{"name":"阴阳","des":"对立又互根的两大属性，动、热、升为阳，静、寒、降为阴，是中医的总纲。","symbolSize":70,"category":"阴阳五行"},{"name":"五行","des":"木火土金水五类属性及其运转，用来归类脏腑并推演它们之间的联系。","symbolSize":70,"category":"阴阳五行"},{"name":"木","des":"生长、升发、条达的属性，如春木舒展，对应肝与东方生发之气。","symbolSize":60,"category":"阴阳五行"},{"name":"火","des":"温热、上升、光亮的属性，如夏火炎上，对应心与血脉温煦。","symbolSize":60,"category":"阴阳五行"},{"name":"土","des":"承载、化育、受纳的属性，如长夏厚土，对应脾与运化之功。","symbolSize":60,"category":"阴阳五行"},{"name":"金","des":"清肃、收敛、变革的属性，如秋金肃杀，对应肺与皮毛。","symbolSize":60,"category":"阴阳五行"},{"name":"水","des":"滋润、下行、闭藏的属性，如冬水封藏，对应肾与骨髓。","symbolSize":60,"category":"阴阳五行"},{"name":"相生","des":"五行递相资生、互相促进的关系，循行不息如环无端。","symbolSize":45,"category":"阴阳五行"},{"name":"相克","des":"五行递相克制、互相约束的关系，防止任何一行过亢。","symbolSize":45,"category":"阴阳五行"},{"name":"制化","des":"生克结合的调节机制，生中有克、克中有生，维持平衡。","symbolSize":40,"category":"阴阳五行"},{"name":"亢害承制","des":"亢则为害，承乃制之，过亢之气自然引来制约以复平衡。","symbolSize":40,"category":"阴阳五行"},{"name":"阴阳互根","des":"阴阳互为存在的前提，孤阴不生、独阳不长，缺一不可。","symbolSize":40,"category":"阴阳五行"},{"name":"心","des":"君主之官，主血脉而藏神，统领脏腑百骸，生命活动之主宰。","symbolSize":65,"category":"脏象学说"},{"name":"肝","des":"将军之官，主疏泄而藏血，喜条达恶抑郁，调畅全身气机。","symbolSize":65,"category":"脏象学说"},{"name":"脾","des":"后天之本，主运化而统血，把水谷化为气血以养周身。","symbolSize":65,"category":"脏象学说"},{"name":"肺","des":"相傅之官，主气司呼吸，主宣发肃降，通调水道朝百脉。","symbolSize":65,"category":"脏象学说"},{"name":"肾","des":"先天之本，藏精主水纳气，内寓真阴真阳，生命之根。","symbolSize":65,"category":"脏象学说"},{"name":"胆","des":"中正之官，贮藏排泄胆汁、主决断，与肝相为表里。","symbolSize":45,"category":"脏象学说"},{"name":"胃","des":"水谷之海，受纳腐熟饮食，与脾纳运相合共养后天。","symbolSize":45,"category":"脏象学说"},{"name":"小肠","des":"受盛之官，承受胃中食糜，泌别清浊以分水谷。","symbolSize":45,"category":"脏象学说"},{"name":"大肠","des":"传导之官，吸收水分、传出糟粕，完成降浊之职。","symbolSize":45,"category":"脏象学说"},{"name":"膀胱","des":"州都之官，贮藏津液，经气化作用而排出尿液。","symbolSize":45,"category":"脏象学说"},{"name":"三焦","des":"孤府，通行元气与水液的通道，分上中下三部辖诸脏腑。","symbolSize":45,"category":"脏象学说"},{"name":"心包","des":"心之外卫，包裹护心，外邪内犯则代心受邪。","symbolSize":45,"category":"脏象学说"},{"name":"脑","des":"髓之海，奇恒之腑之一，藏髓而总统清灵之神机。","symbolSize":40,"category":"脏象学说"},{"name":"女子胞","des":"奇恒之腑，主持月经与孕育，冲任督脉皆起于此。","symbolSize":40,"category":"脏象学说"},{"name":"命门","des":"生命之门，肾间动气所居，内藏真火以温养全身。","symbolSize":45,"category":"脏象学说"},{"name":"气","des":"推动温煦人体的活力精微，升降出入不息，生命之动力。","symbolSize":65,"category":"气血津液"},{"name":"血","des":"循行脉中濡养全身的赤色液体，亦是神志活动的依托。","symbolSize":60,"category":"气血津液"},{"name":"津液","des":"体内一切正常水液，滋润脏腑孔窍，濡养关节脑髓。","symbolSize":55,"category":"气血津液"},{"name":"精","des":"生命的本原物质，禀于父母又充于水谷，为生身之本。","symbolSize":60,"category":"气血津液"},{"name":"神","des":"生命活动的主宰与外现，精气充足则神旺而有生机。","symbolSize":55,"category":"气血津液"},{"name":"元气","des":"最根本的气，根于肾，激发推动一切脏腑的功能。","symbolSize":45,"category":"气血津液"},{"name":"宗气","des":"积于胸中的气，由清气与谷气合成，贯心脉行呼吸。","symbolSize":45,"category":"气血津液"},{"name":"营气","des":"行于脉中的气，与津液合化生血，濡养周身脏腑。","symbolSize":45,"category":"气血津液"},{"name":"卫气","des":"行于脉外之气，温养肌肤腠理，护卫肌表御外邪。","symbolSize":45,"category":"气血津液"},{"name":"气机","des":"气升降出入的运动形式，气机调畅则脏腑安和。","symbolSize":45,"category":"气血津液"},{"name":"气化","des":"气的运动引发的各种转化，如水液变汗变尿皆赖此。","symbolSize":40,"category":"气血津液"},{"name":"脉","des":"血之府邸，约束血液循行于脉道之中不致外溢。","symbolSize":45,"category":"气血津液"},{"name":"经络","des":"运行气血、联络脏腑肢节、沟通内外的通路系统。","symbolSize":60,"category":"经络学说"},{"name":"十二经脉","des":"十二脏腑各领一条正经，气血流注循行如环无端。","symbolSize":55,"category":"经络学说"},{"name":"奇经八脉","des":"别道奇行的八条经脉，统率约束十二经，蓄调气血。","symbolSize":50,"category":"经络学说"},{"name":"任脉","des":"阴脉之海，行于腹面正中，总任一身之阴，主胞胎。","symbolSize":50,"category":"经络学说"},{"name":"督脉","des":"阳脉之海，行于背面正中，总督一身之阳，入络于脑。","symbolSize":50,"category":"经络学说"},{"name":"冲脉","des":"十二经之海又称血海，调节十二经气血，与生殖相关。","symbolSize":45,"category":"经络学说"},{"name":"带脉","des":"环腰一周如束带，约束纵行诸经，固护下元之气。","symbolSize":40,"category":"经络学说"},{"name":"络脉","des":"经脉别出的支络，沟通表里两经，渗灌周身气血。","symbolSize":45,"category":"经络学说"},{"name":"经别","des":"从正经分出的深入体腔之支，加强表里脏腑联系。","symbolSize":40,"category":"经络学说"},{"name":"经筋","des":"经脉之气结聚于筋肉，约束骨骼、主持关节运动。","symbolSize":40,"category":"经络学说"},{"name":"皮部","des":"经脉之气布散于体表的分区，外邪伤人首犯于此。","symbolSize":40,"category":"经络学说"},{"name":"腧穴","des":"脏腑经络之气输注于体表的特定点位，刺激可调病。","symbolSize":45,"category":"经络学说"},{"name":"六淫","des":"风寒暑湿燥火六种外感病邪，太过或不及则伤人。","symbolSize":55,"category":"病因病机"},{"name":"七情","des":"喜怒忧思悲恐惊七种情志，过激则内伤脏腑气机。","symbolSize":55,"category":"病因病机"},{"name":"邪气","des":"各种致病因素的统称，外感六淫、内伤情志皆属其列。","symbolSize":45,"category":"病因病机"},{"name":"正气","des":"人体的机能活动与抗病康复能力，正存于内邪不可干。","symbolSize":45,"category":"病因病机"},{"name":"疠气","des":"传染性极强的外邪，来势急骤，一人病可染一乡。","symbolSize":45,"category":"病因病机"},{"name":"饮食失宜","des":"饥饱失常、饮食不洁偏嗜，损伤脾胃而变生百病。","symbolSize":40,"category":"病因病机"},{"name":"痰饮","des":"水液代谢障碍的产物，稠浊为痰清稀为饮，又可致新病。","symbolSize":50,"category":"病因病机"},{"name":"瘀血","des":"血行不畅或离经停积而成，阻滞脉道又引发诸证。","symbolSize":50,"category":"病因病机"},{"name":"内生五邪","des":"因脏腑功能失调而内生的风寒湿燥火样病理变化。","symbolSize":40,"category":"病因病机"},{"name":"正邪相争","des":"正气与邪气交争消长，决定发病与否及病势进退。","symbolSize":50,"category":"病因病机"},{"name":"阴阳失调","des":"阴阳偏盛偏衰是疾病的基本病机，寒热由此而分。","symbolSize":50,"category":"病因病机"},{"name":"传变","des":"病变循一定规律发展传舍，如表入里、此脏传彼脏。","symbolSize":40,"category":"病因病机"},{"name":"体质","des":"个体形质与功能的特殊性，决定发病倾向与传变。","symbolSize":40,"category":"病因病机"},{"name":"四诊","des":"望闻问切四种诊法合参，从外表变化测知内脏病变。","symbolSize":55,"category":"诊法与治则"},{"name":"望诊","des":"观察神色形态与舌象，测知正气盛衰与病邪所在。","symbolSize":45,"category":"诊法与治则"},{"name":"切诊","des":"切脉与触按肌肤手足，从脉象变化察脏腑气血。","symbolSize":45,"category":"诊法与治则"},{"name":"舌诊","des":"望舌质舌苔以判断正气盛衰、病位深浅与病邪性质。","symbolSize":40,"category":"诊法与治则"},{"name":"八纲辨证","des":"以阴阳表里寒热虚实八纲归纳证候，是辨证的总纲。","symbolSize":55,"category":"诊法与治则"},{"name":"辨证论治","des":"先辨明证候再确立治法，证同治同、证异治异的诊疗核心。","symbolSize":60,"category":"诊法与治则"},{"name":"同病异治","des":"同一疾病因证候不同而治法各异，皆辨证使然。","symbolSize":40,"category":"诊法与治则"},{"name":"治未病","des":"未病先防、既病防变，防患于未然而不追于事后。","symbolSize":50,"category":"诊法与治则"},{"name":"扶正祛邪","des":"补益正气、祛除邪气两大治法的总括，邪正兼顾。","symbolSize":50,"category":"诊法与治则"},{"name":"调整阴阳","des":"损其偏盛、补其偏衰，使阴阳重归动态平衡。","symbolSize":45,"category":"诊法与治则"},{"name":"正治反治","des":"寒者热之、热者寒之为正治，从其假象为反治。","symbolSize":40,"category":"诊法与治则"},{"name":"标本缓急","des":"治病求本为常法，急则治标、缓则治本以权变。","symbolSize":40,"category":"诊法与治则"},{"name":"因人制宜","des":"依体质、年龄、性别不同而施治各异，三因制宜之一。","symbolSize":40,"category":"诊法与治则"},{"name":"对立制约","des":"阴阳相反相搏、彼此约束，如寒能制热、动得静安，防其一方偏亢为害。","symbolSize":40,"category":"阴阳五行"},{"name":"阴阳消长","des":"阴阳在互根制约中此进彼退、维系动态平衡，如昼夜寒暑之更替不息。","symbolSize":40,"category":"阴阳五行"},{"name":"阴阳转化","des":"阴阳至极则向对立面转变，重阴必阳、寒极生热，是量变积成的质变。","symbolSize":40,"category":"阴阳五行"},{"name":"髓","des":"奇恒之腑之一，肾精所化，充于骨而聚于脑，髓海充足则轻劲多力。","symbolSize":40,"category":"脏象学说"},{"name":"骨","des":"奇恒之腑之一，肾所主养，为身之干，内藏精髓而有赖精髓充养。","symbolSize":40,"category":"脏象学说"},{"name":"跷脉","des":"奇经之一，分阴跷阳跷，主下肢轻健矫捷，又司眼睑开阖与寤寐。","symbolSize":40,"category":"经络学说"},{"name":"维脉","des":"奇经之一，分阴维阳维，维络周身表里之阴阳，使其不相散失。","symbolSize":40,"category":"经络学说"},{"name":"劳逸失度","des":"过劳耗气伤精，过逸则气血滞涩，皆属内伤致病之因。","symbolSize":40,"category":"病因病机"},{"name":"闻诊","des":"听声音呼吸、嗅病体气味，以察脏腑盛衰与病邪性质。","symbolSize":40,"category":"诊法与治则"},{"name":"问诊","des":"询问起病缘由、症状苦楚与既往病史，病史资料多赖此而得。","symbolSize":40,"category":"诊法与治则"},{"name":"脉诊","des":"切按脉搏、体察脉象，从至数气势中候脏腑气血之盛衰。","symbolSize":40,"category":"诊法与治则"},{"name":"因时制宜","des":"顺时令气候遣方用药，如夏月慎峻温、冬月慎苦寒，防助邪伤正。","symbolSize":40,"category":"诊法与治则"},{"name":"因地制宜","des":"顺地域水土遣方用药，西北燥寒宜温润，东南湿热宜清化。","symbolSize":40,"category":"诊法与治则"},{"name":"八法","des":"汗、吐、下、和、温、清、消、补八种治法，是治则落实于方药的手段。","symbolSize":40,"category":"诊法与治则"}],"links":[{"source":"木","target":"火","name":"相生","des":"木性资火助其燃，柴薪化焰即木生火。"},{"source":"火","target":"土","name":"相生","des":"火焚成灰归于土，焦土反成滋养之基。"},{"source":"土","target":"金","name":"相生","des":"矿藏蕴结于山土之中，掘土乃见金。"},{"source":"金","target":"水","name":"相生","des":"金凝露而润生水，金属熔亦化为液。"},{"source":"水","target":"木","name":"相生","des":"水润则草木得滋，灌溉而后萌芽生。"},{"source":"木","target":"土","name":"相克","des":"树根穿土破块，木旺则疏泄土气。"},{"source":"土","target":"水","name":"相克","des":"筑堤御水，土厚则遏其泛流之势。"},{"source":"水","target":"火","name":"相克","des":"水至则火熄灭，泼水救火即此理。"},{"source":"火","target":"金","name":"相克","des":"烈焰能熔金石，火旺则金销为水。"},{"source":"金","target":"木","name":"相克","des":"刀斧伐木成材，金利则裁木之疯长。"},{"source":"阴阳","target":"五行","name":"衍化","des":"五行乃阴阳之细分，木火为阳、金水属阴。"},{"source":"阴阳","target":"阴阳互根","name":"互根","des":"阳根于阴、阴根于阳，互为存在的前提。"},{"source":"五行","target":"相生","name":"推演","des":"五行递相资生，次序为木火土金水。"},{"source":"五行","target":"相克","name":"推演","des":"五行间隔相制，次序为木土水火金。"},{"source":"相生","target":"制化","name":"相合","des":"生中有克方能制化，资生而不致过亢。"},{"source":"相克","target":"制化","name":"相合","des":"克中寓生方能制化，制约而不致绝灭。"},{"source":"制化","target":"亢害承制","name":"阐发","des":"亢则害、承乃制，制化失衡的自稳之道。"},{"source":"木","target":"肝","name":"配属","des":"肝属木，主疏泄喜条达，应春生之气。"},{"source":"火","target":"心","name":"配属","des":"心属火，主温煦血脉，应夏长之气。"},{"source":"土","target":"脾","name":"配属","des":"脾属土，主运化水谷，应长夏之气。"},{"source":"金","target":"肺","name":"配属","des":"肺属金，主清肃下降，应秋收之气。"},{"source":"水","target":"肾","name":"配属","des":"肾属水，主闭藏精气，应冬藏之气。"},{"source":"肝","target":"胆","name":"表里","des":"肝胆相表里，胆附肝叶，共司疏泄决断。"},{"source":"心","target":"小肠","name":"表里","des":"心与小肠相表里，心热可下移小肠。"},{"source":"脾","target":"胃","name":"表里","des":"脾胃相表里，脾主运化、胃主受纳。"},{"source":"肺","target":"大肠","name":"表里","des":"肺与大肠相表里，肃降助大肠传导。"},{"source":"肾","target":"膀胱","name":"表里","des":"肾与膀胱相表里，肾气化则尿能出。"},{"source":"心","target":"心包","name":"外卫","des":"心包护心于内，外邪犯心先代心受。"},{"source":"心包","target":"三焦","name":"表里","des":"心包与三焦相为表里，经脉互相络属。"},{"source":"肾","target":"命门","name":"寓藏","des":"命门寓于两肾之间，为生命之门户。"},{"source":"肾","target":"脑","name":"充养","des":"肾藏精生髓，髓聚上充于脑为髓海。"},{"source":"肾","target":"女子胞","name":"系养","des":"肾气盛天癸至，胞宫方主经水孕育。"},{"source":"胃","target":"小肠","name":"传化","des":"胃腐熟水谷，下传小肠继续化物。"},{"source":"小肠","target":"大肠","name":"传导","des":"小肠泌别清浊，糟粕下归大肠而出。"},{"source":"胆","target":"小肠","name":"泄助","des":"胆汁下泄于小肠，助饮食物之消化。"},{"source":"三焦","target":"膀胱","name":"通调","des":"水液经三焦之道，下输膀胱而排出。"},{"source":"心","target":"脾","name":"相生","des":"心火温运脾土，火暖则运化有力。"},{"source":"脾","target":"肺","name":"相生","des":"脾土生养肺金，水谷精气上注于肺。"},{"source":"肺","target":"肾","name":"相生","des":"肺金滋生肾水，金能生水以为源。"},{"source":"肾","target":"肝","name":"相生","des":"肾水滋养肝木，水涵则木荣不亢。"},{"source":"肝","target":"心","name":"相生","des":"肝木生养心火，母实则子亦强盛。"},{"source":"肝","target":"脾","name":"相克","des":"肝木横逆克脾土，郁怒最易伤脾胃。"},{"source":"脾","target":"肾","name":"相克","des":"脾土克制肾水，土壅则水道不利。"},{"source":"肾","target":"心","name":"相克","des":"肾水上济心火，水火既济则安眠。"},{"source":"心","target":"肺","name":"相克","des":"心火克制肺金，火旺则灼伤肺津。"},{"source":"肺","target":"肝","name":"相克","des":"肺金克制肝木，金亢则木郁不达。"},{"source":"气","target":"血","name":"生化","des":"气能生血，气旺则化血有力，气虚血亦亏。"},{"source":"血","target":"气","name":"载运","des":"血为气之母，载气而行不使耗散。"},{"source":"津液","target":"血","name":"渗生","des":"津液渗注脉中，与营气合而化赤为血。"},{"source":"精","target":"气","name":"化生","des":"精能化气，为一身之气生生之根。"},{"source":"精","target":"血","name":"化生","des":"精血同源互化，肝肾同源即此义。"},{"source":"元气","target":"气","name":"组成","des":"元气是气的根本，激发诸脏腑之机能。"},{"source":"宗气","target":"气","name":"组成","des":"宗气积于胸中，贯心脉而行呼吸。"},{"source":"营气","target":"气","name":"组成","des":"营气行于脉中，化生血液营养周身。"},{"source":"卫气","target":"气","name":"组成","des":"卫气行于脉外，温分肉而御外邪。"},{"source":"气","target":"气机","name":"升降","des":"气之运动表现为升降出入四种形式。"},{"source":"气机","target":"气化","name":"推运","des":"气机运转引发气化，完成物质转化。"},{"source":"精","target":"神","name":"化生","des":"精气充盈则神旺，形与神俱而长生。"},{"source":"血","target":"神","name":"濡养","des":"血养神明，血虚则神不安而失眠。"},{"source":"脉","target":"血","name":"约束","des":"脉为血之府，裹血循行不使外溢。"},{"source":"肾","target":"精","name":"封藏","des":"肾藏精，主人身生长发育与生殖。"},{"source":"脾","target":"血","name":"统摄","des":"脾气统摄血液，使行脉内而不外逸。"},{"source":"心","target":"血","name":"推动","des":"心主血脉，以搏动推血循行于周身。"},{"source":"肝","target":"血","name":"贮藏","des":"肝藏血而调节血量，人动血运诸经。"},{"source":"肺","target":"气","name":"主司","des":"肺主一身之气，司呼吸而吸清呼浊。"},{"source":"脾","target":"津液","name":"运化","des":"脾运化水湿，为津液生成输布之枢。"},{"source":"肺","target":"津液","name":"输布","des":"肺为水之上源，宣降布散津液周身。"},{"source":"肾","target":"津液","name":"主控","des":"肾主水，统摄调控全身水液之代谢。"},{"source":"肾","target":"元气","name":"化生","des":"元气根植于肾，由先天之精化生而来。"},{"source":"肺","target":"宗气","name":"合成","des":"肺吸清气与谷气相合，聚于胸为宗气。"},{"source":"心","target":"神","name":"藏御","des":"心藏神，为精神意识思维之总主宰。"},{"source":"肝","target":"气机","name":"调畅","des":"肝主疏泄，一身上下气机赖以调畅。"},{"source":"三焦","target":"元气","name":"通行","des":"元气借三焦为通道，布达于一身。"},{"source":"大肠","target":"津液","name":"吸收","des":"大肠主津，吸收水液使粪便成形。"},{"source":"小肠","target":"津液","name":"泌别","des":"小肠主液，泌别清浊而分理水液。"},{"source":"膀胱","target":"津液","name":"贮藏","des":"膀胱贮藏津液，气化则尿液能出。"},{"source":"十二经脉","target":"经络","name":"组成","des":"十二正经是经络系统的主干部分。"},{"source":"奇经八脉","target":"经络","name":"组成","des":"八脉纵横交错，补充调节十二经脉。"},{"source":"任脉","target":"督脉","name":"相接","des":"任行腹而督行背，二脉首尾相衔接。"},{"source":"冲脉","target":"任脉","name":"同源","des":"冲任督皆起于胞中，一源而三歧。"},{"source":"带脉","target":"冲脉","name":"约束","des":"带脉环腰束带，约束诸经之气血。"},{"source":"十二经脉","target":"络脉","name":"分出","des":"经脉别出支络，沟通表里渗灌气血。"},{"source":"十二经脉","target":"经别","name":"别出","des":"经别从正经分出，深入体腔联脏腑。"},{"source":"十二经脉","target":"经筋","name":"连属","des":"经筋连属骨节，主司一身关节运动。"},{"source":"十二经脉","target":"皮部","name":"划分","des":"体表按经划分为十二皮部之分区。"},{"source":"经络","target":"腧穴","name":"输注","des":"腧穴是经气输注出入于体表之处的点。"},{"source":"经络","target":"气","name":"通行","des":"经络为气之通路，经气循行于其间。"},{"source":"督脉","target":"脑","name":"入络","des":"督脉上项入络于脑，总督一身之阳。"},{"source":"任脉","target":"女子胞","name":"主养","des":"任脉起于胞中，主胞胎与月经孕育。"},{"source":"冲脉","target":"女子胞","name":"调养","des":"冲为血海，调养月经而主生殖之机。"},{"source":"十二经脉","target":"心","name":"属络","des":"心经属心络小肠，经脉与脏腑内外相应。"},{"source":"十二经脉","target":"肝","name":"属络","des":"肝经属肝络胆，经气相通以候肝之疾。"},{"source":"十二经脉","target":"脾","name":"属络","des":"脾经属脾络胃，外应于肌肉四肢。"},{"source":"十二经脉","target":"肺","name":"属络","des":"肺经属肺络大肠，外合皮毛主一身之表。"},{"source":"十二经脉","target":"肾","name":"属络","des":"肾经属肾络膀胱，外系于骨而通于髓。"},{"source":"六淫","target":"邪气","name":"归属","des":"六淫是外感病邪的总类，属邪气之一。"},{"source":"疠气","target":"邪气","name":"归属","des":"疠气传染性最强，亦属外感之邪。"},{"source":"七情","target":"气机","name":"扰乱","des":"情志过激则气机逆乱，怒则气上。"},{"source":"七情","target":"肝","name":"郁伤","des":"郁怒最易伤肝，疏泄失职而气郁。"},{"source":"七情","target":"心","name":"扰动","des":"心为神明之主，情志之变动心先应。"},{"source":"六淫","target":"肺","name":"侵袭","des":"外邪自皮毛口鼻而入，肺首当其冲。"},{"source":"津液","target":"痰饮","name":"停聚","des":"津液代谢输布障碍，停聚而成痰饮。"},{"source":"血","target":"瘀血","name":"瘀滞","des":"血行迟缓或离经不散，停而为瘀。"},{"source":"痰饮","target":"经络","name":"阻滞","des":"痰饮流注经络，阻碍气血之运行。"},{"source":"瘀血","target":"脉","name":"阻痹","des":"瘀血阻痹脉道，不通则痛随之生。"},{"source":"六淫","target":"阴阳失调","name":"促发","des":"阳邪伤阴、阴邪伤阳，终致阴阳失调。"},{"source":"正气","target":"正邪相争","name":"抗御","des":"正气奋起抗邪，邪正交争定发病转归。"},{"source":"邪气","target":"正邪相争","name":"侵袭","des":"邪气侵入人体，与正气交争而成病。"},{"source":"体质","target":"正气","name":"影响","des":"体质强弱决定正气盛衰与发病倾向。"},{"source":"脾","target":"内生五邪","name":"化生","des":"脾虚失运则湿从内生，内邪由是而起。"},{"source":"饮食失宜","target":"脾","name":"损伤","des":"饥饱失常先伤脾胃，运化随之失职。"},{"source":"经络","target":"传变","name":"传导","des":"病邪循经络由表入里，由此脏传彼脏。"},{"source":"正邪相争","target":"传变","name":"决定","des":"邪正消长进退，决定疾病传变方向。"},{"source":"望诊","target":"四诊","name":"组成","des":"望诊观神色形态，为四诊之首位。"},{"source":"切诊","target":"四诊","name":"组成","des":"切脉按肤探脉象，为四诊之一环。"},{"source":"舌诊","target":"望诊","name":"归属","des":"舌诊属望诊内容，舌象可察脏腑气血。"},{"source":"四诊","target":"八纲辨证","name":"提供","des":"四诊合参收集病情，为辨证提供依据。"},{"source":"八纲辨证","target":"辨证论治","name":"纲领","des":"八纲为辨证总纲，据此确立治法方药。"},{"source":"同病异治","target":"辨证论治","name":"体现","des":"证异治亦异，正是辨证论治的体现。"},{"source":"八纲辨证","target":"正治反治","name":"指导","des":"寒热虚实既辨，正治反治乃有所依。"},{"source":"辨证论治","target":"标本缓急","name":"决定","des":"辨明证候后，依标本缓急定先后次序。"},{"source":"扶正祛邪","target":"正邪相争","name":"针对","des":"依邪正盛衰之势，定攻补之先后缓急。"},{"source":"扶正祛邪","target":"正气","name":"扶助","des":"扶正即补益正气，增强抗邪之能力。"},{"source":"调整阴阳","target":"阴阳失调","name":"纠正","des":"损其偏盛，补其偏衰，使以平为期。"},{"source":"治未病","target":"传变","name":"防杜","des":"既病防变，先安未受邪之地以杜传变。"},{"source":"治未病","target":"正气","name":"培固","des":"未病先防，首在调养培固一身正气。"},{"source":"因人制宜","target":"体质","name":"结合","des":"视体质强弱、长幼男女而治各不同。"},{"source":"切诊","target":"脉","name":"诊察","des":"切按寸口之脉，察气血脏腑之消息。"},{"source":"阴阳","target":"八纲辨证","name":"统摄","des":"阴阳为八纲之总纲，统摄表里寒热虚实。"},{"source":"阴阳","target":"对立制约","name":"对立","des":"阴阳双方彼此制约，如动制静、寒制热，维持相对平衡。"},{"source":"阴阳","target":"阴阳消长","name":"消长","des":"阴阳此消彼长而动态平衡，如昼夜交替、寒来暑往。"},{"source":"阴阳","target":"阴阳转化","name":"转化","des":"阴阳极则相易，重阴必阳、重阳必阴。"},{"source":"对立制约","target":"阴阳消长","name":"动力","des":"制约与反制约推动阴阳消长进退，失约则偏盛偏衰。"},{"source":"阴阳互根","target":"阴阳转化","name":"根据","des":"互根方有互变之机，阴得阳则化，阳得阴则生。"},{"source":"阴阳消长","target":"阴阳转化","name":"渐积","des":"消长为量变之渐，积渐至极乃发质变之转化。"},{"source":"肾","target":"骨","name":"主养","des":"肾藏精主骨，齿为骨之余，肾充则骨坚齿固。"},{"source":"肾","target":"髓","name":"化生","des":"肾精化生精髓，精足则髓充骨壮。"},{"source":"骨","target":"髓","name":"内藏","des":"骨为髓之府，精髓充盈于骨腔之中。"},{"source":"髓","target":"脑","name":"汇聚","des":"诸髓皆上属于脑，脑为髓之海。"},{"source":"心","target":"肾","name":"既济","des":"心火下温肾水，肾水上济心火，水火既济则寤寐如常。"},{"source":"肝","target":"肾","name":"同源","des":"肝肾同源，精血互生，乙癸相资。"},{"source":"任脉","target":"奇经八脉","name":"组成","des":"任脉总任一身之阴，为阴脉之海。"},{"source":"督脉","target":"奇经八脉","name":"组成","des":"督脉总督一身之阳，为阳脉之海。"},{"source":"冲脉","target":"奇经八脉","name":"组成","des":"冲脉涵蓄十二经气血，称十二经之海、血海。"},{"source":"带脉","target":"奇经八脉","name":"组成","des":"带脉环腰一周，约束纵行诸经。"},{"source":"跷脉","target":"奇经八脉","name":"组成","des":"跷脉主司矫捷运动与寤寐开阖。"},{"source":"维脉","target":"奇经八脉","name":"组成","des":"维脉维络一身表里之阴阳。"},{"source":"跷脉","target":"卫气","name":"协同","des":"卫气昼行阳跷则目张而寤，夜行阴跷则目瞑而寐。"},{"source":"营气","target":"血","name":"化生","des":"营气泌津液注于脉中，化赤而为血。"},{"source":"卫气","target":"皮部","name":"温煦","des":"卫气行于肤表分肉，温分肉、肥腠理、司开阖御外邪。"},{"source":"三焦","target":"津液","name":"决渎","des":"三焦为决渎之官，水道出焉，津液赖以环流。"},{"source":"劳逸失度","target":"正气","name":"耗伤","des":"劳则气耗，久劳伤精，正气因之亏虚。"},{"source":"劳逸失度","target":"气机","name":"滞涩","des":"过逸少动则气血不行，气机迟滞渐生痰瘀。"},{"source":"闻诊","target":"四诊","name":"组成","des":"听声嗅气与望问切相合，四诊合参乃全。"},{"source":"问诊","target":"四诊","name":"组成","des":"问而知之谓之工，病之因由多凭问诊而明。"},{"source":"问诊","target":"七情","name":"追询","des":"情志内伤起病隐曲，须问诊方能究其由。"},{"source":"闻诊","target":"肺","name":"听察","des":"咳喘声息之变，首察肺气之盛衰。"},{"source":"脉诊","target":"切诊","name":"归属","des":"脉诊候脉，为切诊之主体。"},{"source":"因时制宜","target":"六淫","name":"参酌","des":"时令邪气各有所偏，春防风、夏防暑湿，治随季变。"},{"source":"因地制宜","target":"六淫","name":"参酌","des":"地高陵居多燥寒，卑下卑湿多湿热，邪随方土而异。"},{"source":"正治反治","target":"八法","name":"统驭","des":"寒者热之、热者寒之，正治之道由八法温清而落实。"}]}
