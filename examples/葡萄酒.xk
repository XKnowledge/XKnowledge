et":"有机与生物动力","name":"光谱","des":"从停药到看月亮的种植哲学。"},{"source":"葡萄栽培","target":"采收时机","name":"裁决","des":"糖酸表上的最后决定。"},{"source":"采收时机","target":"甜酒体系","name":"起点","des":"越晚采收糖越高，甜酒的先决条件。"},{"source":"酿造工艺","target":"破碎与浸渍","name":"开课","des":"皮汁接触，颜色与单宁的第一课。"},{"source":"破碎与浸渍","target":"桃红","name":"短借","des":"浸皮几小时就分离，粉色是借来的。"},{"source":"酿造工艺","target":"酒精发酵","name":"主课","des":"糖变酒精，香气的主生成现场。"},{"source":"酒精发酵","target":"温控发酵","name":"升级","des":"罐体冷暖可调，现代酿酒的分水岭。"},{"source":"酿造工艺","target":"苹乳发酵","name":"二课","des":"尖酸的苹果酸圆成乳酸。"},{"source":"酿造工艺","target":"橡木桶","name":"画笔","des":"微氧化加香料，风味的外挂车间。"},{"source":"橡木桶","target":"新桶比例","name":"音量","des":"橡木香的旋钮，过了就盖住果香。"},{"source":"橡木桶","target":"里奥哈","name":"长练","des":"长期桶陈的西班牙式慢功。"},{"source":"酿造工艺","target":"酒泥陈酿","name":"添香","des":"死酵母的贡献，饼干与圆润。"},{"source":"酒泥陈酿","target":"香槟","name":"同器","des":"传统法的酒泥陈年，面包香的来源。"},{"source":"酿造工艺","target":"换桶与澄清","name":"收尾","des":"下胶过滤的取舍，清与味的博弈。"},{"source":"酿造工艺","target":"二氧化硫","name":"防线","des":"从罗马时代沿用至今的保鲜剂。"},{"source":"酿造工艺","target":"二氧化碳浸渍","name":"整串","des":"罐内酶促发酵，香蕉糖果香的来路。"},{"source":"二氧化碳浸渍","target":"博若莱新酒","name":"出厂","des":"当年装瓶当年喝的第三周四狂欢。"},{"source":"酿造工艺","target":"传统法起泡","name":"瓶中","des":"瓶内二次发酵，转瓶除渣的慢工。"},{"source":"传统法起泡","target":"起泡酒家族","name":"高线","des":"瓶中二次发酵是起泡的高门槛路线。"},{"source":"香槟","target":"传统法起泡","name":"定名","des":"冷凉白垩与瓶中二次发酵的合谋。"},{"source":"类型与风格","target":"起泡酒家族","name":"分泡","des":"气泡的三种来路与三种性格。"},{"source":"类型与风格","target":"桃红","name":"浅浸","des":"粉色不是品种，是一道工艺选择。"},{"source":"类型与风格","target":"甜酒体系","name":"甜路","des":"浓缩葡萄的四条路，甜各有来处。"},{"source":"甜酒体系","target":"冰酒","name":"冻缩","des":"零下采收的冻果浓浆。"},{"source":"采收时机","target":"冰酒","name":"极致","des":"葡萄冻在枝头，压出糖浆般的汁。"},{"source":"类型与风格","target":"加强酒","name":"中断","des":"白兰地中止发酵，甜度被酒精锁定。"},{"source":"加强酒","target":"杜罗河","name":"原型","des":"波特是加强酒的教科书案例。"},{"source":"类型与风格","target":"橙酒","name":"复古","des":"白葡萄带皮发酵的琥珀色古法。"},{"source":"类型与风格","target":"博若莱新酒","name":"轻快","des":"新鲜到以周计算的风格极点。"},{"source":"品鉴与陈年","target":"单宁","name":"骨架","des":"口腔的收敛感，陈年的保险。"},{"source":"品鉴与陈年","target":"酸度","name":"脉搏","des":"一切平衡的起点，陈年潜力首指标。"},{"source":"品鉴与陈年","target":"酒体","name":"体型","des":"酒精与残糖撑起的重量。"},{"source":"品鉴与陈年","target":"余味","name":"秒表","des":"咽下之后，品质的最后一关。"},{"source":"品鉴与陈年","target":"香气三层","name":"分层","des":"果香发酵香陈年香的层级阅读。"},{"source":"品鉴与陈年","target":"瓶中陈年","name":"演化","des":"软木塞下的慢时间。"},{"source":"瓶中陈年","target":"香气三层","name":"三层","des":"陈年香正是第三层的主角。"},{"source":"品鉴与陈年","target":"适饮期","name":"曲线","des":"每瓶酒的生命周期表。"},{"source":"品鉴与陈年","target":"储存条件","name":"保管","des":"恒温恒湿避光平放的物理课。"},{"source":"单宁","target":"赤霞珠","name":"满格","des":"赤霞珠的单宁是品种里的天花板。"},{"source":"酸度","target":"雷司令","name":"立柱","des":"雷司令靠酸立起几十年的陈年骨架。"},{"source":"葡萄驯化","target":"格鲁吉亚Qvevri","name":"传世","des":"八千年前的陶罐酿法，在高加索山间从未中断。"},{"source":"葡萄驯化","target":"腓尼基人与希腊殖民","name":"携带","des":"驯化后的葡萄随商船与殖民城邦铺满地中海。"},{"source":"腓尼基人与希腊殖民","target":"古埃及陶罐印记","name":"传入","des":"尼罗河畔的葡萄园由东方输入，法老随葬酒罐写满印记。"},{"source":"腓尼基人与希腊殖民","target":"狄俄尼索斯","name":"敬奉","des":"殖民城邦把酒神崇拜带到南意大利与黑海之滨。"},{"source":"狄俄尼索斯","target":"希腊会饮","name":"主宰","des":"会饮从祭酒神开场，狂欢与理性同席。"},{"source":"希腊会饮","target":"罗马酿酒业","name":"传承","des":"罗马人接过希腊的杯盏，也接手了酿酒的产业。"},{"source":"罗马酿酒业","target":"加铅甜酒","name":"调味","des":"铅丹熬出的甜味剂，成了贵族杯中的慢性毒药。"},{"source":"罗马酿酒业","target":"莱茵与摩泽尔","name":"北拓","des":"军团把葡萄栽上莱茵与摩泽尔的陡坡。"},{"source":"罗马酿酒业","target":"中世纪修道院酿酒","name":"接续","des":"庄园技艺退进修道院，为圣餐续酿千年。"},{"source":"迦拿婚宴","target":"诺亚醉酒","name":"互文","des":"圣经里酒的第一个神迹与第一场醉酒，都写在开头。"},{"source":"迦拿婚宴","target":"中世纪修道院酿酒","name":"圣化","des":"圣餐必须用真葡萄酒，修士酿酒有了神圣理由。"},{"source":"中世纪修道院酿酒","target":"本笃会与西多会","name":"主持","des":"两大修会纪律严明，把酿酒做成了学问。"},{"source":"本笃会与西多会","target":"武戎围园","name":"圈地","des":"西多会修士垒起石墙，圈出武戎园的块块地界。"},{"source":"本笃会与西多会","target":"勃艮第克里玛","name":"命名","des":"修士以舌试土，为每块坡地定下名字。"},{"source":"勃艮第克里玛","target":"武戎围园","name":"归属","des":"围墙园是克里玛体系最壮观的实物遗存。"},{"source":"中世纪修道院酿酒","target":"唐培里侬","name":"出任","des":"奥维莱修道院的酒窖司库，后来被追认为香槟之父。"},{"source":"唐培里侬","target":"香槟命名权之战","name":"先声","des":"香槟之名从此带血统，也带千年缠讼。"},{"source":"莱茵与摩泽尔","target":"德国酒法","name":"伏笔","des":"罗马人留下的陡坡园，千年后以糖度立法分级。"},{"source":"埃莉诺与波尔多","target":"1855列级庄分级","name":"定盘","des":"数百年对英贸易垫出的价格阶梯，被一纸名单固定。"},{"source":"埃莉诺与波尔多","target":"波特酒","name":"断供","des":"英法交恶波尔多断供，英国人在杜罗河谷另寻替代。"},{"source":"1855列级庄分级","target":"期酒制度","name":"金融化","des":"名庄酒从饮品变成资产，桶中期货应运而生。"},{"source":"苏玳贵腐","target":"1855列级庄分级","name":"同榜","des":"同年的名单里唯一的甜白酒区，滴金酒庄居首。"},{"source":"AOC原产地制度","target":"香槟命名权之战","name":"撑腰","des":"原产地立法给香槟的名字之战提供了法理武器。"},{"source":"AOC原产地制度","target":"勃艮第克里玛","name":"定籍","des":"克里玛地块自1936年起逐一登录为法定原产地。"},{"source":"AOC原产地制度","target":"特级园制度","name":"分层","des":"勃艮第在原产地框架上叠出特级与一级的金字塔。"},{"source":"德国酒法","target":"AOC原产地制度","name":"对照","des":"法国以产地立法，德国以糖度分级，两条路线并立。"},{"source":"雪莉酒","target":"波特酒","name":"同流","des":"都是英国口味催生的加强酒，加烈经得起海运。"},{"source":"根瘤蚜虫灾","target":"美洲砧木嫁接","name":"得救","des":"欧洲藤嫁上美洲抗蚜砧木，绝境中的复活术。"},{"source":"根瘤蚜虫灾","target":"智利葡萄酒","name":"隔绝","des":"安第斯与海洋围出净土，智利老藤躲过一劫。"},{"source":"1976巴黎审判","target":"新旧世界之争","name":"引爆","des":"盲品放榜加州压倒法国，旧世界神话出现裂痕。"},{"source":"加州传教士葡萄","target":"1976巴黎审判","name":"铺垫","des":"传教士两百年前种下的藤，终在盲品桌上结果。"},{"source":"新旧世界之争","target":"门多萨马尔贝克","name":"呼应","des":"新世界自证身份的又一章，写在安第斯山麓。"},{"source":"门多萨马尔贝克","target":"智利葡萄酒","name":"邻竞","des":"安第斯两侧的南美双雄，共享出口的兴衰。"},{"source":"奔富","target":"新旧世界之争","name":"入局","des":"南半球名庄携葛兰许入局，屡屡摘下满分。"},{"source":"飞行酿酒师","target":"新旧世界之争","name":"弥合","des":"同一批顾问飞遍全球，风格界线反倒模糊。"},{"source":"现代酿酒学","target":"飞行酿酒师","name":"授业","des":"佩诺的门徒把实验室方法带进每个产区。"},{"source":"现代酿酒学","target":"1976巴黎审判","name":"垫底","des":"加州酒厂靠新式酿酒学悄悄补课，终在盲品爆冷。"},{"source":"格鲁吉亚Qvevri","target":"自然酒运动","name":"取火","des":"陶罐古法成了自然酒运动的精神图腾。"},{"source":"自然酒运动","target":"现代酿酒学","name":"反弹","des":"拒绝添加与修正，粗粝风味自成一派。"},{"source":"张裕","target":"宁夏贺兰山东麓","name":"先行","des":"从烟台到贺兰山，中国产区百年后再出发。"},{"source":"宁夏贺兰山东麓","target":"新旧世界之争","name":"新军","des":"中国产区以国际奖项叩开旧世界把守的门。"},{"source":"品鉴四步","target":"盲品训练","name":"立规","des":"遮标盲评以四步为骨架，训练的是味觉推理。"},{"source":"葡萄酒风味轮","target":"品鉴四步","name":"配词","des":"诺布尔风味轮给闻香一步配上标准词汇。"},{"source":"年份","target":"品鉴四步","name":"变量","des":"同一座园每年天气不同，差距就写在年份里。"},{"source":"帕克与百分制","target":"期酒制度","name":"评级","des":"一份《葡萄酒倡导者》的分数，成了期酒定价依据。"},{"source":"帕克与百分制","target":"酒窖收藏","name":"催热","des":"高分即涨价的年代，藏酒变成资产配置。"},{"source":"假酒案","target":"酒窖收藏","name":"寄生","des":"库尼亚万盯上的正是拍卖行与藏家的名利场。"},{"source":"侍酒师","target":"餐酒搭配","name":"执掌","des":"酒单与菜单一肩挑，搭配是看家功夫。"},{"source":"侍酒师","target":"醒酒与滗酒","name":"演示","des":"开瓶换瓶的手上功夫，餐桌前的小小仪式。"},{"source":"酒杯谱系","target":"品鉴四步","name":"塑形","des":"杯型引导香气流向，让四步各有其器。"},{"source":"餐酒搭配","target":"苏玳贵腐","name":"经典","des":"蓝纹奶酪配贵腐甜酒，搭配原理的教科书案例。"},{"source":"风土","target":"勃艮第克里玛","name":"落地","des":"克里玛是风土概念最极致的地块化表达。"},{"source":"风土","target":"年份","name":"限定","des":"风土是恒量，年份是它每年的表情。"},{"source":"酒窖收藏","target":"期酒制度","name":"接力","des":"桶边买进、窖中陈年、上拍变现的投资链。"},{"source":"AOC原产地制度","target":"风土","name":"立法","des":"把风土从酒农的经验写成了法律条文。"},{"source":"葡萄驯化","name":"孕育","target":"葡萄品种","des":"外高加索山坡八千年驯化，孕育出千姿百态的欧亚种葡萄。"},{"source":"唐培里侬","name":"被追认","target":"传统法起泡","des":"修士未必发明起泡，但瓶中二次发酵的传统法从此挂上他的名字。"},{"source":"波尔多","name":"定格于","target":"1855列级庄分级","des":"万国博览会上一纸分级，把波尔多名庄钉进百年榜单。"},{"source":"老藤","name":"挺过","target":"根瘤蚜虫灾","des":"19 世纪末虫灾后的幸存者，百年老藤是风土最稀有的活档案。"},{"source":"勃艮第","name":"田分","target":"勃艮第克里玛","des":"修道院千年圈出的克里玛田块，让勃艮第成为风土的教科书。"},{"source":"AOC原产地制度","name":"划定","target":"旧世界产区","des":"原产地命名把旧世界的产区边界写成了法律。"},{"source":"马尔贝克","name":"远嫁成","target":"门多萨马尔贝克","des":"在波尔多失意的品种，于门多萨高海拔阳光下成为阿根廷国酒。"},{"source":"苏玳贵腐","name":"跻身","target":"甜酒体系","des":"贵腐菌眷顾的苏玳，是甜酒体系里王座级的贵腐甜白。"},{"source":"波特酒","name":"属于","target":"加强酒","des":"白兰地中止发酵的波特，是加强酒家族的甜烈代表。"},{"source":"雪莉酒","name":"属于","target":"加强酒","des":"索雷拉系统叠层熟成的雪莉，是加强酒家族的氧化系代表。"},{"source":"葡萄酒风味轮","name":"细分出","target":"香气三层","des":"风味轮层层展开，正是杯中香气三层结构的品酒词库。"},{"source":"香槟命名权之战","name":"捍卫","target":"香槟","des":"一场跨越百年的官司，让「香槟」这个名字只属于香槟。"},{"source":"摩泽尔","name":"承自","target":"莱茵与摩泽尔","des":"罗马军团北拓的藤蔓，千年后仍在摩泽尔的板岩陡坡上结果。"},{"source":"宁夏贺兰山东麓","name":"补写","target":"新世界产区","des":"戈壁滩上的中国产区，为「新世界」补上东半球的一章。"}]}