{"version":2,"nodes":[{"name":"秦","des":"公元前221年扫平六国而立的第一个大一统王朝，两千年帝制的总开关。","symbolSize":70,"category":"朝代兴替"},{"name":"大一统","des":"统合疆土、制度与思想的帝国理想，中国历史跌宕向上的主旋律。","symbolSize":70,"category":"朝代兴替"},{"name":"西汉","des":"前202年刘邦建汉定都长安，奠四百年汉家基业。","symbolSize":50,"category":"朝代兴替"},{"name":"东汉","des":"公元25年刘秀光武中兴复汉，定都洛阳，豪强渐成尾大之势。","symbolSize":50,"category":"朝代兴替"},{"name":"三国鼎立","des":"魏蜀吴三分天下，东汉统一崩解后形成的分裂格局。","symbolSize":40,"category":"朝代兴替"},{"name":"隋","des":"581年代周而立、589年灭陈再统一，二世而亡而制度绵长。","symbolSize":50,"category":"朝代兴替"},{"name":"唐","des":"618年立国，贞观开元接续铸就盛世，胡汉交融的世界帝国。","symbolSize":70,"category":"朝代兴替"},{"name":"五代十国","des":"唐亡后五十余年军阀割据，中原五朝更迭如走马灯。","symbolSize":40,"category":"朝代兴替"},{"name":"北宋","des":"960年陈桥兵变立国，经济文化登峰而武备积弱的王朝。","symbolSize":50,"category":"朝代兴替"},{"name":"南宋","des":"1127年靖康之变后赵构南渡，偏安临安一百五十年。","symbolSize":50,"category":"朝代兴替"},{"name":"元","des":"1271年忽必烈定国号大元，首个由北方民族完成的大一统。","symbolSize":50,"category":"朝代兴替"},{"name":"明","des":"1368年朱元璋驱逐元廷而定鼎，皇权空前集中的近世王朝。","symbolSize":70,"category":"朝代兴替"},{"name":"清","des":"1644年入关定鼎北京，最后一个大一统王朝，1840年遇炮舰而变局。","symbolSize":70,"category":"朝代兴替"},{"name":"贞观之治","des":"唐太宗在位二十余年的治世，纳谏任贤、轻徭薄赋的典范。","symbolSize":40,"category":"朝代兴替"},{"name":"开元盛世","des":"唐玄宗开元年间国力登顶，长安为当时世界都会之最。","symbolSize":40,"category":"朝代兴替"},{"name":"康乾盛世","des":"康熙至乾隆百余年鼎盛，疆域人口登顶而危机暗伏其间。","symbolSize":40,"category":"朝代兴替"},{"name":"皇帝制","des":"皇权至上、皇位世袭的国家元首制度，帝制中国的权力原点。","symbolSize":50,"category":"政治制度"},{"name":"郡县制","des":"中央任免流官治理地方的垂直体系，取代分封的基石制度。","symbolSize":50,"category":"政治制度"},{"name":"三公九卿","des":"秦朝丞相、太尉、御史大夫领衔的中央官制架构。","symbolSize":40,"category":"政治制度"},{"name":"编户齐民","des":"登记全体户口以统一征发赋役的制度，帝国财政的底册。","symbolSize":40,"category":"政治制度"},{"name":"察举制","des":"地方荐举孝廉方正入仕的选官制度，两汉取士主渠道。","symbolSize":40,"category":"政治制度"},{"name":"三省六部制","des":"中书起草、门下封驳、尚书执行的宰相制度，古典分权范本。","symbolSize":50,"category":"政治制度"},{"name":"科举制","des":"以统一考试选官的制度，寒门上升通道，与文明同构的发明。","symbolSize":70,"category":"政治制度"},{"name":"行省制","des":"元代创设的行中书省体制，今日省制的直接源头。","symbolSize":50,"category":"政治制度"},{"name":"内阁制","des":"明代殿阁大学士辅政的中枢机制，无相名而有相权。","symbolSize":50,"category":"政治制度"},{"name":"军机处","des":"雍正设立的机要办事机构，跪受笔录，皇权专制顶点。","symbolSize":50,"category":"政治制度"},{"name":"府兵制","des":"兵农合一、征自均田农户的兵制，西魏至唐前期支柱。","symbolSize":40,"category":"政治制度"},{"name":"募兵制","des":"以雇佣方式募集职业兵的兵制，唐中叶后渐成主导。","symbolSize":40,"category":"政治制度"},{"name":"厂卫制度","des":"锦衣卫与东厂西厂的特务机构体系，明代皇权监控利器。","symbolSize":40,"category":"政治制度"},{"name":"八旗制度","des":"兵民合一的旗籍组织，清朝立国的军事与社会骨架。","symbolSize":40,"category":"政治制度"},{"name":"羁縻府州","des":"册封边疆首领、因俗而治的松散管辖体系，唐代的智慧。","symbolSize":40,"category":"政治制度"},{"name":"秦始皇","des":"嬴政，并六国称始皇帝，书同文车同轨的千古一帝。","symbolSize":50,"category":"历史人物"},{"name":"汉武帝","des":"刘彻，推恩削藩、盐铁官营、北击匈奴，铸就制度化的统一。","symbolSize":50,"category":"历史人物"},{"name":"曹操","des":"挟天子以令诸侯统一北方，曹魏政权的实际奠基者。","symbolSize":40,"category":"历史人物"},{"name":"隋文帝","des":"杨坚，代周建隋再造统一，启三省六部与分科取士之端。","symbolSize":50,"category":"历史人物"},{"name":"唐太宗","des":"李世民，贞观之治的缔造者，从谏如流的明君标本。","symbolSize":50,"category":"历史人物"},{"name":"武则天","des":"中国历史上唯一的正统女皇帝，上承贞观下启开元。","symbolSize":50,"category":"历史人物"},{"name":"唐玄宗","des":"李隆基，一手缔造开元盛世、一手亲历安史之乱的双面帝王。","symbolSize":50,"category":"历史人物"},{"name":"宋太祖","des":"赵匡胤，陈桥兵变黄袍加身，杯酒释兵权定重文轻武格局。","symbolSize":50,"category":"历史人物"},{"name":"王安石","des":"北宋改革家，天变不足畏的执拗宰相，熙宁变法总设计师。","symbolSize":50,"category":"历史人物"},{"name":"成吉思汗","des":"铁木真，统一蒙古高原并发动西征，蒙古帝国的缔造者。","symbolSize":50,"category":"历史人物"},{"name":"忽必烈","des":"元世祖，定国号大元、灭宋一统天下，行省制的确立者。","symbolSize":50,"category":"历史人物"},{"name":"明太祖","des":"朱元璋，从布衣到开国皇帝，废丞相设锦衣卫，集权登峰造极。","symbolSize":50,"category":"历史人物"},{"name":"郑和","des":"明代航海家，七下西洋最远抵非洲东岸的东方先行者。","symbolSize":40,"category":"历史人物"},{"name":"张居正","des":"万历首辅，考成法与一条鞭法的操盘手，明朝最后的改革家。","symbolSize":50,"category":"历史人物"},{"name":"康熙帝","des":"玄烨，擒鳌拜平三藩收台湾，康乾盛世的开启者。","symbolSize":50,"category":"历史人物"},{"name":"林则徐","des":"虎门销烟的民族英雄，开眼看世界的第一人。","symbolSize":40,"category":"历史人物"},{"name":"商鞅变法","des":"战国中期秦国的深度改革，废井田行县制，铸就统一发动机。","symbolSize":50,"category":"战争与变法"},{"name":"楚汉之争","des":"前206至前202年刘邦项羽争天下，四年鏖战定汉家基业。","symbolSize":40,"category":"战争与变法"},{"name":"七国之乱","des":"前154年吴楚七国以清君侧为名叛乱，三个月即被平定。","symbolSize":40,"category":"战争与变法"},{"name":"赤壁之战","des":"208年孙刘联军火攻破曹于长江，三分天下的定局之战。","symbolSize":40,"category":"战争与变法"},{"name":"安史之乱","des":"755年安禄山起兵的八年大乱，唐由盛转衰的总转折。","symbolSize":50,"category":"战争与变法"},{"name":"黄巢起义","des":"唐末民变席卷大半中国，流动作战拖垮王朝根基。","symbolSize":40,"category":"战争与变法"},{"name":"靖康之变","des":"1127年金军破开封掳徽钦二帝，北宋猝亡的奇耻。","symbolSize":40,"category":"战争与变法"},{"name":"靖难之役","des":"1399至1402年燕王朱棣以清君侧夺位，皇统移枝。","symbolSize":40,"category":"战争与变法"},{"name":"土木堡之变","des":"1449年英宗亲征瓦剌被俘，明军精锐毁于一旦。","symbolSize":40,"category":"战争与变法"},{"name":"王安石变法","des":"熙宁年间富国强兵的系统性改革，青苗募役并举而争议千年。","symbolSize":50,"category":"战争与变法"},{"name":"张居正改革","des":"万历初年以考成法整吏治、清丈田亩推条鞭的挽救式改革。","symbolSize":50,"category":"战争与变法"},{"name":"郑和下西洋","des":"1405至1433年七次远航，朝贡体系和平展示的海上巅峰。","symbolSize":40,"category":"战争与变法"},{"name":"戚继光抗倭","des":"嘉靖年间荡平东南倭患，戚家军冷热兵器混编的典范。","symbolSize":40,"category":"战争与变法"},{"name":"三藩之乱","des":"1673年吴三桂等三藩举兵反清，八年战乱后彻底撤藩。","symbolSize":40,"category":"战争与变法"},{"name":"鸦片战争","des":"1840年英国为鸦片贸易悍然开战，中国近代史的起点。","symbolSize":50,"category":"战争与变法"},{"name":"百家争鸣","des":"先秦诸子自由论争的思想爆发，中国思想的轴心时代。","symbolSize":50,"category":"思想文化"},{"name":"罢黜百家独尊儒术","des":"董仲舒议、汉武帝行的意识形态定于一尊，儒学官学化起点。","symbolSize":40,"category":"思想文化"},{"name":"禅宗","des":"佛教中国化的完成形态，明心见性，深刻塑造士人精神世界。","symbolSize":40,"category":"思想文化"},{"name":"宋明理学","des":"融佛入儒的新儒学体系，主导后期帝国精神世界的天理之学。","symbolSize":50,"category":"思想文化"},{"name":"陆王心学","des":"陆九渊王阳明以心即理为纲的一脉，点亮个体的主体性。","symbolSize":40,"category":"思想文化"},{"name":"八股取士","des":"以四书命题、按固定格式代圣贤立言的考试文体，才士的牢笼。","symbolSize":40,"category":"思想文化"},{"name":"文字狱","des":"因文字获罪的言论高压，清代达到顶峰，士人噤若寒蝉。","symbolSize":40,"category":"思想文化"},{"name":"西学东渐","des":"欧洲科技与思想随传教士与炮舰东来，传统社会的冲击波。","symbolSize":40,"category":"思想文化"},{"name":"《史记》","des":"司马迁忍辱著成的纪传体通史之祖，史家之绝唱。","symbolSize":40,"category":"思想文化"},{"name":"《资治通鉴》","des":"司马光主编的编年体巨著，专取关国家兴衰之往事。","symbolSize":40,"category":"思想文化"},{"name":"《永乐大典》","des":"永乐年间辑成两万余卷的类书，古代百科全书之巅。","symbolSize":40,"category":"思想文化"},{"name":"《四库全书》","des":"乾隆朝编纂的巨大丛书，文化总结与禁毁毁誉参半。","symbolSize":40,"category":"思想文化"},{"name":"四大名著","des":"三国水浒西游红楼，古典白话小说的四座高峰。","symbolSize":40,"category":"思想文化"},{"name":"乾嘉学派","des":"清代考据学高峰，无征不信的严谨与脱离现实之弊并存。","symbolSize":40,"category":"思想文化"},{"name":"唐诗宋词","des":"唐诗宋词双峰并峙，中国古典文学最耀眼的两座灯塔。","symbolSize":40,"category":"思想文化"},{"name":"丝绸之路","des":"贯通欧亚的贸易与文明通道，驼铃与帆影里的东西对话。","symbolSize":50,"category":"经济与科技"},{"name":"大运河","des":"隋代贯通的南北漕运动脉，帝国生命线沿用逾千年。","symbolSize":50,"category":"经济与科技"},{"name":"造纸术","des":"西汉现雏形、东汉蔡伦定型的信息载体革命性发明。","symbolSize":50,"category":"经济与科技"},{"name":"雕版印刷","des":"唐代成熟的整版刷印技术，书籍从抄写走向批量复制。","symbolSize":40,"category":"经济与科技"},{"name":"活字印刷","des":"北宋毕昇胶泥活字，印刷进入可拆装拼版的灵活时代。","symbolSize":40,"category":"经济与科技"},{"name":"火药","des":"炼丹家的意外发明，唐末用于军事，改写世界战争史。","symbolSize":40,"category":"经济与科技"},{"name":"指南针","des":"北宋人工磁化技术成熟，远洋航海从此不再迷航。","symbolSize":40,"category":"经济与科技"},{"name":"一条鞭法","des":"赋役合并、折银征收的财政改革，货币财政的转折点。","symbolSize":50,"category":"经济与科技"},{"name":"摊丁入亩","des":"雍正朝丁银并入田赋，延续两千年的人头税就此终结。","symbolSize":40,"category":"经济与科技"},{"name":"闭关锁国","des":"限定一口通商的对外政策，与工业浪潮擦肩的自我封闭。","symbolSize":40,"category":"经济与科技"},{"name":"江南市镇","des":"明清江南密布的手工业商业市镇，早期工业化的萌芽土壤。","symbolSize":40,"category":"经济与科技"},{"name":"占城稻","des":"引自越南的早熟稻种，宋代推广后江南粮仓地位定型。","symbolSize":40,"category":"经济与科技"},{"name":"黄道婆棉纺织","des":"黄道婆革新棉纺技艺，松江布衣被天下的产业奇迹。","symbolSize":40,"category":"经济与科技"},{"name":"隆庆开关","des":"1567年放开民间海外贸易，白银随之滚滚流入。","symbolSize":40,"category":"经济与科技"},{"name":"白银货币化","des":"明清白银担当主币，赋役折银与全球贸易的历史合流。","symbolSize":40,"category":"经济与科技"}],"links":[{"source":"商鞅变法","target":"秦","name":"奠定","des":"废井田、奖军功、行县制，百年后秦由弱转强终并六国。"},{"source":"秦","target":"大一统","name":"开创","des":"前221年并灭六国，首次建立大一统中央集权帝国。"},{"source":"秦始皇","target":"秦","name":"建立","des":"前221年自称始皇帝，中国自此进入帝制时代。"},{"source":"秦始皇","target":"皇帝制","name":"开创","des":"创皇帝名号，皇权至上、皇位世袭由此立极。"},{"source":"秦","target":"郡县制","name":"推行","des":"分天下为三十六郡，官员由中央任免，垂直到底。"},{"source":"郡县制","target":"大一统","name":"支撑","des":"流官取代封建，中央政令得以直达地方。"},{"source":"秦","target":"三公九卿","name":"设立","des":"丞相太尉御史大夫分掌政军监察，架构垂范汉代。"},{"source":"编户齐民","target":"秦","name":"确立于","des":"什伍编民、户籍相傅，赋役征收自此有账可依。"},{"source":"郡县制","target":"西汉","name":"定型于","des":"郡国并行经七国之乱后，郡县主导地位不可逆。"},{"source":"七国之乱","target":"西汉","name":"发生于","des":"前154年吴楚七国叛乱，三个月平定，诸侯再难抗衡中央。"},{"source":"楚汉之争","target":"西汉","name":"催生","des":"刘邦胜项羽，前202年即帝位开创汉室。"},{"source":"汉武帝","target":"大一统","name":"巩固","des":"推恩削藩、盐铁官营、独尊儒术，统一从版图深入制度。"},{"source":"汉武帝","target":"察举制","name":"推行","des":"元光元年令郡国岁举孝廉，荐举选官常态化。"},{"source":"察举制","target":"西汉","name":"确立于","des":"以孝廉为主科目，成为两汉入仕正途。"},{"source":"罢黜百家独尊儒术","target":"西汉","name":"提出于","des":"董仲舒对策建议，儒学升为官方意识形态。"},{"source":"汉武帝","target":"罢黜百家独尊儒术","name":"采纳","des":"罢黜百家表章六经，太学立五经博士。"},{"source":"丝绸之路","target":"西汉","name":"开通于","des":"张骞凿空西域，驼队自此贯通欧亚。"},{"source":"造纸术","target":"西汉","name":"发明于","des":"考古所见的西汉麻纸已具其雏形。"},{"source":"造纸术","target":"东汉","name":"改进于","des":"蔡伦以树皮麻头改进造纸，成本低廉文明提速。"},{"source":"东汉","target":"西汉","name":"承继","des":"刘秀自认汉室中兴，制度大体因仍西汉。"},{"source":"三国鼎立","target":"东汉","name":"终结","des":"黄巾乱后军阀割据，曹丕代汉走入三国。"},{"source":"曹操","target":"三国鼎立","name":"奠定","des":"挟天子以令诸侯，统一北方为曹魏立国奠基。"},{"source":"赤壁之战","target":"三国鼎立","name":"奠定","des":"孙刘联军火破曹军，三分格局就此成形。"},{"source":"察举制","target":"科举制","name":"演变为","des":"从荐举到考试，九品中正为其间过渡。"},{"source":"隋文帝","target":"隋","name":"建立","des":"581年代周建隋，589年灭陈再造统一。"},{"source":"隋文帝","target":"三省六部制","name":"创立","des":"确立三省分工框架，宰相制度自此定型。"},{"source":"隋","target":"科举制","name":"开创","des":"废九品中正，分科取士开科举先河。"},{"source":"大运河","target":"隋","name":"开凿于","des":"隋炀帝贯通南北五大水系，漕运干线维系千年。"},{"source":"隋","target":"唐","name":"奠定","des":"隋制唐承，短命王朝为盛唐备好制度底盘。"},{"source":"唐","target":"三省六部制","name":"完善","des":"三省长官议政于政事堂，分权制衡臻于成熟。"},{"source":"科举制","target":"唐","name":"成熟于","des":"进士科独尊天下英雄入彀，殿试武举渐次增设。"},{"source":"唐太宗","target":"贞观之治","name":"开创","des":"居安思危从谏如流，二十余年治世垂范后世。"},{"source":"唐太宗","target":"科举制","name":"振兴","des":"增筑学舍广收天下士，进士科声望陡升。"},{"source":"府兵制","target":"唐","name":"盛行于","des":"兵农合一折冲府布点，前期开疆的主力兵制。"},{"source":"募兵制","target":"唐","name":"推行于","des":"玄宗以长从宿卫取代府兵，职业兵登场。"},{"source":"府兵制","target":"募兵制","name":"演变为","des":"均田制瓦解兵源枯竭，召募遂代征发。"},{"source":"募兵制","target":"安史之乱","name":"滋长","des":"兵为将有的职业边军，使安禄山坐拥重兵。"},{"source":"安史之乱","target":"开元盛世","name":"终结","des":"755年渔阳鼙鼓动地来，盛世戛然而止。"},{"source":"安史之乱","target":"唐","name":"重创","des":"八年战乱后藩镇割据，帝国由盛转衰。"},{"source":"羁縻府州","target":"唐","name":"推行于","des":"册封首领因俗而治，松散灵活的边疆秩序。"},{"source":"武则天","target":"科举制","name":"发展","des":"首创殿试与武举，打压门阀提拔寒门。"},{"source":"武则天","target":"贞观之治","name":"承接","des":"政启开元治宏贞观，女皇承前启后。"},{"source":"唐玄宗","target":"开元盛世","name":"缔造","des":"任用姚崇宋璟励精图治，人口国力双双登顶。"},{"source":"贞观之治","target":"开元盛世","name":"铺垫","des":"制度与国力百年积累，终成开元极盛。"},{"source":"黄巢起义","target":"唐","name":"瓦解","des":"流动大军横扫大半中国，唐廷名存实亡。"},{"source":"唐","target":"五代十国","name":"演变为","des":"藩镇军阀接盘，五十余年政权走马灯。"},{"source":"北宋","target":"五代十国","name":"结束","des":"960年建国后近二十年扫平中原群雄。"},{"source":"宋太祖","target":"北宋","name":"建立","des":"陈桥兵变黄袍加身，杯酒释兵权根除武人干政。"},{"source":"宋太祖","target":"募兵制","name":"推行","des":"养兵百万强干弱枝，冗兵冗费之弊同时埋下。"},{"source":"科举制","target":"北宋","name":"完善于","des":"糊名誊录杜绝请托，取士规模空前扩大。"},{"source":"王安石","target":"王安石变法","name":"主持","des":"熙宁二年拜相，以富国强兵为总纲推进新法。"},{"source":"王安石变法","target":"北宋","name":"发生于","des":"针对积贫积弱，青苗募役保甲方田并举。"},{"source":"王安石变法","target":"募兵制","name":"针对","des":"将兵保甲欲练民兵，直指巨额养兵之费的积弊。"},{"source":"靖康之变","target":"北宋","name":"灭亡","des":"1127年金破开封，徽钦二帝被掳北去。"},{"source":"靖康之变","target":"南宋","name":"催生","des":"赵构南渡即位，偏安格局就此开启。"},{"source":"南宋","target":"北宋","name":"延续","des":"衣冠南渡定都临安，国祚又续一个半世纪。"},{"source":"占城稻","target":"南宋","name":"推广于","des":"早熟稻种大面积引种，江南粮仓地位定型。"},{"source":"江南市镇","target":"南宋","name":"兴起于","des":"经济重心南移完成，草市镇市渐成气候。"},{"source":"元","target":"南宋","name":"灭亡","des":"1279年崖山战后统一，南北再度混一。"},{"source":"成吉思汗","target":"元","name":"奠基","des":"统一草原创立蒙古汗国，元朝追尊其为太祖。"},{"source":"忽必烈","target":"元","name":"建立","des":"1271年定国号大元，次年定都大都。"},{"source":"忽必烈","target":"行省制","name":"创立","des":"设行中书省分镇地方，中央集权新形态。"},{"source":"行省制","target":"元","name":"确立于","des":"省制框架沿用至今，行政区划史的分水岭。"},{"source":"大运河","target":"元","name":"取直于","des":"开会通河截弯取直，漕运不再绕道洛阳。"},{"source":"黄道婆棉纺织","target":"元","name":"革新于","des":"黄道婆自崖州携技艺归来，松江棉布名动天下。"},{"source":"明太祖","target":"明","name":"建立","des":"1368年驱逐元廷定都应天，恢复汉家衣冠。"},{"source":"明太祖","target":"厂卫制度","name":"设立","des":"设锦衣卫侦缉臣民，特务政治开其端。"},{"source":"靖难之役","target":"明","name":"发生于","des":"燕王朱棣以清君侧之名夺位登基。"},{"source":"靖难之役","target":"内阁制","name":"催生","des":"成祖简文臣入直文渊阁参预机务。"},{"source":"内阁制","target":"明","name":"形成于","des":"殿阁大学士从顾问演变为中枢，无相名有相权。"},{"source":"郑和","target":"郑和下西洋","name":"率领","des":"1405年起的七次远航，最远抵非洲东海岸。"},{"source":"郑和下西洋","target":"明","name":"发生于","des":"永乐宣德两朝的国家行动，宝船船队冠绝当代。"},{"source":"指南针","target":"郑和下西洋","name":"应用于","des":"罗盘牵星过洋，远洋航行有眼。"},{"source":"土木堡之变","target":"明","name":"重创","des":"英宗被俘精锐尽丧，险些动摇国本。"},{"source":"戚继光抗倭","target":"明","name":"发生于","des":"嘉靖倭患终被荡平，东南海疆得安。"},{"source":"火药","target":"戚继光抗倭","name":"装备","des":"戚家军过半配鸟铳火炮，冷热兵器混编。"},{"source":"张居正","target":"张居正改革","name":"主持","des":"万历初年出任首辅，以考成法总揽纲纪。"},{"source":"张居正改革","target":"明","name":"发生于","des":"王朝暮年的最后一次自救式改革。"},{"source":"一条鞭法","target":"张居正改革","name":"推行于","des":"清丈田亩后赋役合并折银，在全国铺开。"},{"source":"一条鞭法","target":"明","name":"行于","des":"万历朝全面推行，货币财政迈出一大步。"},{"source":"清","target":"明","name":"取代","des":"1644年明清易代，清廷入关定鼎北京。"},{"source":"八旗制度","target":"清","name":"支撑","des":"兵民合一的旗籍组织，清廷立国的军事骨架。"},{"source":"康熙帝","target":"三藩之乱","name":"平定","des":"少年天子八年鏖战终撤三藩，集权巩固。"},{"source":"三藩之乱","target":"清","name":"发生于","des":"吴三桂等三藩举兵，战火波及大半个中国。"},{"source":"康熙帝","target":"康乾盛世","name":"开启","des":"擒鳌拜平三藩收台湾，百年盛世的底盘。"},{"source":"军机处","target":"清","name":"设立于","des":"雍正设军机房辅弼机务，皇权专制顶点。"},{"source":"摊丁入亩","target":"清","name":"推行于","des":"雍正朝丁银并入地亩，人头税两千年告终。"},{"source":"摊丁入亩","target":"一条鞭法","name":"承续","des":"赋役合并的思路再进一步，丁随亩征。"},{"source":"文字狱","target":"清","name":"盛行于","des":"康雍乾三朝屡兴大狱，士人噤若寒蝉。"},{"source":"《四库全书》","target":"清","name":"编纂于","des":"乾隆朝十数年成书，功过参半的文化总汇。"},{"source":"闭关锁国","target":"清","name":"推行于","des":"乾隆后限定广州一口通商，自我封闭定格。"},{"source":"鸦片战争","target":"清","name":"爆发于","des":"1840年炮舰叩关，天朝体系开始崩解。"},{"source":"科举制","target":"清","name":"废止于","des":"1905年停科举，一千三百年考试选官谢幕。"},{"source":"鸦片战争","target":"康乾盛世","name":"终结","des":"盛世的账在1840年被坚船利炮清算。"},{"source":"林则徐","target":"鸦片战争","name":"引发","des":"虎门销烟断英人利源，成为开战导火索。"},{"source":"西学东渐","target":"明","name":"兴起于","des":"利玛窦携西器西图入华，士大夫初开眼界。"},{"source":"鸦片战争","target":"西学东渐","name":"加速","des":"国门洞开，师夷长技渐成朝野共识。"},{"source":"四大名著","target":"明","name":"成书于","des":"三部定本于明，白话小说自此登堂入室。"},{"source":"《永乐大典》","target":"明","name":"编纂于","des":"永乐朝辑成两万余卷，当时世界最大类书。"},{"source":"《四库全书》","target":"《永乐大典》","name":"接续","des":"从类书到丛书，辑佚大典遗文一脉相承。"},{"source":"八股取士","target":"明","name":"定型于","des":"明初定以四书文取士，成化后格律愈严。"},{"source":"八股取士","target":"科举制","name":"依附","des":"命题限于四书代圣贤立言，考试文体僵化。"},{"source":"宋明理学","target":"科举制","name":"入主","des":"程朱注疏成为标准答案，官学地位确立。"},{"source":"陆王心学","target":"明","name":"兴盛于","des":"王阳明龙场悟道后姚江之学风靡晚明。"},{"source":"宋明理学","target":"陆王心学","name":"分出","des":"同宗儒门而以心即理另辟蹊径。"},{"source":"宋明理学","target":"禅宗","name":"吸纳","des":"援佛入儒，把伦理提升为本体论体系。"},{"source":"禅宗","target":"唐","name":"大兴于","des":"惠能南宗一花开五叶，佛教完成中国化。"},{"source":"百家争鸣","target":"罢黜百家独尊儒术","name":"落幕于","des":"官学定于一尊，诸子自由争鸣就此谢幕。"},{"source":"商鞅变法","target":"百家争鸣","name":"源于","des":"法家学说最彻底的一次落地实践。"},{"source":"《史记》","target":"西汉","name":"成书于","des":"司马迁究天人之际，纪传体垂范两千年。"},{"source":"《资治通鉴》","target":"北宋","name":"成书于","des":"司马光主编，记战国至五代兴衰的编年巨著。"},{"source":"《资治通鉴》","target":"《史记》","name":"并称","des":"史学双璧，一纪传一编年。"},{"source":"唐诗宋词","target":"唐","name":"鼎盛于","des":"盛唐诗到极顶，群星璀璨冠绝古今。"},{"source":"唐诗宋词","target":"北宋","name":"鼎盛于","des":"词至北宋而大，苏轼柳永各领风骚。"},{"source":"乾嘉学派","target":"清","name":"兴盛于","des":"乾隆嘉庆间考据之学登峰造极。"},{"source":"文字狱","target":"乾嘉学派","name":"催生","des":"高压之下智者躲进故纸堆求实证。"},{"source":"造纸术","target":"雕版印刷","name":"推动","des":"纸的普及是印刷技术得以推广的前提。"},{"source":"雕版印刷","target":"唐","name":"发明于","des":"初唐已见雕版印品，晚唐刻书成市。"},{"source":"活字印刷","target":"北宋","name":"发明于","des":"庆历年间毕昇胶泥活字，拼版时代开启。"},{"source":"雕版印刷","target":"活字印刷","name":"演进为","des":"从整版雕刻到活字排检，效率跃升。"},{"source":"指南针","target":"北宋","name":"成熟于","des":"人工磁化的指南鱼与罗盘见于宋人记载。"},{"source":"火药","target":"唐","name":"发明于","des":"炼丹家偶得配方，唐末已用于战事。"},{"source":"丝绸之路","target":"大一统","name":"依托","des":"帝国安定是商道畅通的底层保障。"},{"source":"大运河","target":"大一统","name":"沟通","des":"南粮北运，串起政治中心与财赋重地。"},{"source":"编户齐民","target":"郡县制","name":"服务","des":"有户籍底册，郡县征发赋役才有抓手。"},{"source":"隆庆开关","target":"明","name":"发生于","des":"1567年放开民间海外贸易，海禁松动的窗口。"},{"source":"隆庆开关","target":"白银货币化","name":"助推","des":"月港开放，白银滚滚流入中国。"},{"source":"白银货币化","target":"一条鞭法","name":"支撑","des":"白银足量流通，赋役折银方可操作。"},{"source":"黄道婆棉纺织","target":"江南市镇","name":"壮大","des":"棉纺成乡邦主业，市镇因业而兴。"},{"source":"大运河","target":"江南市镇","name":"孕育","des":"运河沿线漕船所至，市镇串珠成链。"},{"source":"占城稻","target":"江南市镇","name":"供养","des":"粮产有剩余，市镇方能脱农而立。"},{"source":"郑和下西洋","target":"闭关锁国","name":"让位于","des":"远洋国策人亡政息，海禁渐成主调。"},{"source":"戚继光抗倭","target":"隆庆开关","name":"铺平","des":"倭患平定后，海禁才有松动的可能。"},{"source":"三公九卿","target":"三省六部制","name":"演变为","des":"三公权力被拆解分流，化为三省分权。"},{"source":"羁縻府州","target":"大一统","name":"服务","des":"以松散臣属拓展治理半径，统合成本极低。"},{"source":"府兵制","target":"编户齐民","name":"依托","des":"兵源出自编户均田之民，有田斯有兵。"},{"source":"内阁制","target":"军机处","name":"让位于","des":"机要大权移入军机处，内阁渐成闲曹。"},{"source":"皇帝制","target":"军机处","name":"强化","des":"奏折直达御前，皇权专制至此登峰。"},{"source":"皇帝制","target":"大一统","name":"支撑","des":"皇帝是统一国家的权力枢纽与象征。"}],"title":"中国通史","description":"秦—清两千年制度、人物与事件的因果网络"}