{"version":2,"nodes":[{"name":"药学","des":"以药物为核心线索，贯通发现、机制、制剂、临床与监管的完整链条。","symbolSize":70,"category":"药理学基础"},{"name":"药理学","des":"研究药物与机体相互作用规律的学科，横跨作用机制与体内处置两大问题。","symbolSize":50,"category":"药理学基础"},{"name":"药效学","des":"药物对机体做什么：效应、机制与量效规律的定量科学。","symbolSize":40,"category":"药理学基础"},{"name":"受体理论","des":"兰格利1878年提出受体概念，埃利希侧链学说奠基：药物与受体互补结合而起效。","symbolSize":50,"category":"药理学基础"},{"name":"锁钥模型","des":"药物像钥匙、受体像锁的互补比喻，后发展为诱导契合的动态结合观。","symbolSize":40,"category":"药理学基础"},{"name":"激动剂与拮抗剂","des":"激动剂既有亲和力又有内在活性，拮抗剂只占位不激活，一开一关。","symbolSize":40,"category":"药理学基础"},{"name":"量效关系","des":"效应随剂量递增呈S形曲线，ED50与最大效能皆从曲线上读出。","symbolSize":40,"category":"药理学基础"},{"name":"治疗指数","des":"LD50与ED50之比，数字越大安全窗口越宽，化疗药常不足5。","symbolSize":40,"category":"药理学基础"},{"name":"药物靶点","des":"药物结合并调控的分子对象：受体、酶、离子通道、转运体四大家族。","symbolSize":50,"category":"药理学基础"},{"name":"酶抑制作用","des":"占据活性位点或变构位点抑制催化，磺胺与他汀皆是经典范例。","symbolSize":40,"category":"药理学基础"},{"name":"离子通道","des":"钠钙钾通道是心脏与神经电活动的门户，局麻药阻滞钠通道。","symbolSize":40,"category":"药理学基础"},{"name":"转运体","des":"跨膜搬运底物的蛋白，5-羟色胺再摄取转运体是抗抑郁药靶点。","symbolSize":40,"category":"药理学基础"},{"name":"选择性","des":"药物对不同靶点亲和力之差，选择性越高副作用通常越少。","symbolSize":40,"category":"药理学基础"},{"name":"第二信使","des":"cAMP、钙离子等胞内信使把受体信号逐级放大，瀑布级联的枢纽。","symbolSize":40,"category":"药理学基础"},{"name":"药物基因组学","des":"基因多态决定药效与毒性个体差异，CYP2C19慢代谢者氯吡格雷几近失效。","symbolSize":40,"category":"药理学基础"},{"name":"药物代谢动力学","des":"定量刻画吸收、分布、代谢、排泄四过程的学科，简称药动学。","symbolSize":50,"category":"药物代谢动力学"},{"name":"吸收","des":"药物自给药部位入血的过程，口服受溶解度与透膜性双重限制。","symbolSize":40,"category":"药物代谢动力学"},{"name":"首过效应","des":"口服药经门静脉先被肝脏代谢一部分，硝酸甘油口服几乎全灭。","symbolSize":40,"category":"药物代谢动力学"},{"name":"生物利用度","des":"入血的相对分量与速度，仿制药一致性评价的核心指标。","symbolSize":40,"category":"药物代谢动力学"},{"name":"表观分布容积","des":"体内药量除以血药浓度的理论容积，氯喹可达数百升示组织深藏。","symbolSize":40,"category":"药物代谢动力学"},{"name":"血脑屏障","des":"脑血管内皮紧密连接的关卡，只有脂溶性小分子方能入脑。","symbolSize":40,"category":"药物代谢动力学"},{"name":"药物代谢","des":"肝脏生物转化：I相氧化引入官能团，II相结合增水促排。","symbolSize":40,"category":"药物代谢动力学"},{"name":"CYP450酶系","des":"血红素蛋白酶超家族，负责约75%药物的I相代谢，3A4亚型功劳最大。","symbolSize":50,"category":"药物代谢动力学"},{"name":"药物相互作用","des":"共用代谢酶或转运体互相干扰，西柚汁抑制3A4抬高他汀血药浓度。","symbolSize":40,"category":"药物代谢动力学"},{"name":"肾排泄","des":"肾小球滤过加肾小管分泌，肾功能不全者必须减量。","symbolSize":40,"category":"药物代谢动力学"},{"name":"肝肠循环","des":"药物随胆汁排入肠腔再被重吸收，形成二次血药峰、延长半衰期。","symbolSize":40,"category":"药物代谢动力学"},{"name":"半衰期","des":"血药浓度下降一半所需时间，给药间隔与达稳速度的总开关。","symbolSize":40,"category":"药物代谢动力学"},{"name":"房室模型","des":"把机体抽象为一室或二室拟合药时曲线，动力学参数由此算出。","symbolSize":40,"category":"药物代谢动力学"},{"name":"稳态血药浓度","des":"恒量给药约5个半衰期后摄入等于清除，浓度趋于平台。","symbolSize":40,"category":"药物代谢动力学"},{"name":"治疗药物监测","des":"对地高辛、万古霉素等窄窗药物测血药浓度实现个体化给药。","symbolSize":40,"category":"药物代谢动力学"},{"name":"埃利希","des":"提出侧链学说与魔法子弹构想，1908年获诺奖，化学疗法之父。","symbolSize":50,"category":"药物发现史"},{"name":"胂凡纳明","des":"编号606的砷剂，1910年用于治梅毒，系统药物筛选的第一个成果。","symbolSize":40,"category":"药物发现史"},{"name":"乙醚麻醉","des":"1846年莫顿在麻省总医院公开演示，无痛外科自此开始，医学史分水岭。","symbolSize":40,"category":"药物发现史"},{"name":"阿司匹林","des":"1897年霍夫曼乙酰化水杨酸减刺激，拜耳两年后上市，百年常青。","symbolSize":40,"category":"药物发现史"},{"name":"磺胺类药物","des":"多马克1935年报道百浪多息抗菌，1939年获诺奖，抗菌化疗元年。","symbolSize":40,"category":"药物发现史"},{"name":"弗莱明","des":"1928年度假归来发现霉菌抑菌圈，青霉素的偶然发现者。","symbolSize":50,"category":"药物发现史"},{"name":"青霉素","des":"1941年进入临床，二战深罐培养量产，细菌感染从此不再是绝症。","symbolSize":50,"category":"药物发现史"},{"name":"弗洛里与钱恩","des":"牛津团队提纯青霉素并完成动物与临床验证，1945年共获诺奖。","symbolSize":40,"category":"药物发现史"},{"name":"链霉素","des":"瓦克斯曼1943年从土壤链霉菌中筛出，首个抗结核药，1952年获诺奖。","symbolSize":40,"category":"药物发现史"},{"name":"沙利度胺事件","des":"1957年起反应停致上万例海豹肢畸形，现代药物安全监管的转折点。","symbolSize":50,"category":"药物发现史"},{"name":"肿瘤化疗","des":"从二战芥子气泄露到氮芥治淋巴瘤，细胞毒药物抗癌自此起步。","symbolSize":40,"category":"药物发现史"},{"name":"AZT","des":"1987年获批的首个抗HIV药物，核苷类似物抑制逆转录酶。","symbolSize":40,"category":"药物发现史"},{"name":"他汀类药物","des":"1976年远藤章从青霉菌找到美伐他汀，降脂药王朝自霉菌起家。","symbolSize":40,"category":"药物发现史"},{"name":"质子泵抑制剂","des":"奥美拉唑1988年上市，抑制胃酸分泌最后一步的H+/K+-ATP酶。","symbolSize":40,"category":"药物发现史"},{"name":"格列卫","des":"伊马替尼2001年获批，BCR-Abl抑制剂，肿瘤靶向治疗时代开启。","symbolSize":50,"category":"药物发现史"},{"name":"靶向治疗","des":"针对癌细胞特异分子精确打击，与化疗的地毯式轰炸相对。","symbolSize":50,"category":"药物发现史"},{"name":"胰岛素","des":"1921年班廷与贝斯特提取成功，次年救活14岁糖尿病患儿。","symbolSize":40,"category":"药物发现史"},{"name":"基因工程药物","des":"1982年重组人胰岛素上市，大肠杆菌变身高分子药物工厂。","symbolSize":40,"category":"药物发现史"},{"name":"洋地黄","des":"威瑟林1785年系统记述洋地黄强心，民间草药变经典强心苷。","symbolSize":40,"category":"药物发现史"},{"name":"阿片类药物","des":"吗啡、芬太尼强效镇痛，镇痛与成瘾一体两面须严格管制。","symbolSize":40,"category":"药物发现史"},{"name":"药物化学","des":"在分子结构与生物活性之间架桥的学科，新药发现的发动机。","symbolSize":50,"category":"药物化学与药剂学"},{"name":"构效关系","des":"结构改造引起活性消长的规律，定量构效关系QSAR将其数学化。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"先导化合物","des":"有苗头但欠优化的原型分子，经多轮结构改造进化为候选药物。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"手性药物","des":"左旋与右旋药效可迥异，反应停悲剧正是构型之差的惨痛注脚。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"前药","des":"本身无活性，体内经酶切或水解释放原药，奥美拉唑自活化。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"药剂学","des":"把原料药加工成安全、有效、稳定制剂的应用学科。","symbolSize":50,"category":"药物化学与药剂学"},{"name":"剂型","des":"片剂胶囊注射剂等给药形态，同药不同剂型药动行为迥异。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"给药途径","des":"口服、注射、吸入、透皮等入口，决定起效快慢与生物利用度。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"注射剂","des":"直接入血或入组织，起效最快，无菌与热原检查最严。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"缓释与控释","des":"延缓或恒速释放药物，一日一服且血药浓度更平稳。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"透皮贴剂","des":"药物经皮肤缓释入血，避开首过效应，东莨菪碱贴防晕船。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"纳米制剂","des":"脂质体与纳米粒载药，增溶减毒并借EPR效应趋向肿瘤。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"冻干技术","des":"真空冷冻干燥保留活性，蛋白与疫苗得以常温长途运输。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"药用辅料","des":"填充、黏合、包衣等幕后材料，决定制剂成形与药物释放。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"生物药物","des":"蛋白、抗体与疫苗等大分子药，与小分子化学药两分天下。","symbolSize":40,"category":"药物化学与药剂学"},{"name":"临床试验","des":"I期试耐受与药代，II期初探疗效，III期确证，IV期上市后再评价。","symbolSize":50,"category":"临床用药与监管"},{"name":"随机双盲对照","des":"随机分组加医生患者双盲，判定疗效的金标准设计。","symbolSize":40,"category":"临床用药与监管"},{"name":"安慰剂效应","des":"无活性片剂也能缓解症状，心理期待引发真实生理变化。","symbolSize":40,"category":"临床用药与监管"},{"name":"新药审批","des":"1938年美国磺胺酏剂惨案后立法：上市前须证明安全有效。","symbolSize":40,"category":"临床用药与监管"},{"name":"ICH","des":"1990年美欧日发起的人用药品注册技术要求国际协调会。","symbolSize":40,"category":"临床用药与监管"},{"name":"中国药监","des":"1985年药品管理法起步，1998年组建药监局，2017年加入ICH。","symbolSize":40,"category":"临床用药与监管"},{"name":"药品说明书","des":"载明适应症、用法与禁忌的法定文件，超说明书用药须谨慎。","symbolSize":40,"category":"临床用药与监管"},{"name":"药物警戒","des":"从被动收集不良反应报告到主动监测风险信号的全生命周期管理。","symbolSize":40,"category":"临床用药与监管"},{"name":"耐药性","des":"抗生素选择压下细菌进化出耐药，多重耐药菌成全球威胁。","symbolSize":40,"category":"临床用药与监管"},{"name":"抗生素滥用","des":"不当处方与畜牧促生长添加，人为加速耐药性蔓延。","symbolSize":40,"category":"临床用药与监管"},{"name":"合理用药","des":"安全有效经济适当四要素，能口服不肌注、能肌注不输液。","symbolSize":40,"category":"临床用药与监管"},{"name":"药物滥用","des":"镇静催眠与阿片类反复使用致依赖，成瘾是慢性复发性脑病。","symbolSize":40,"category":"临床用药与监管"},{"name":"专利与仿制药","des":"20年专利悬崖后仿制药涌入，一致性评价保证同质同效。","symbolSize":40,"category":"临床用药与监管"},{"name":"基本药物目录","des":"WHO于1977年首创，满足基本医疗优先需求的遴选清单。","symbolSize":40,"category":"临床用药与监管"},{"name":"特殊人群用药","des":"孕妇胎盘通透、儿童酶系未全、老人肾清除减半，剂量须个体化。","symbolSize":40,"category":"临床用药与监管"},{"name":"神农本草经","des":"汉代成书的中国最早药物学专著，365味药分上中下三品。","symbolSize":40,"category":"中药与天然药物"},{"name":"本草纲目","des":"李时珍1578年成书，收药1892种、附方一万一千余，东方药学巨典。","symbolSize":50,"category":"中药与天然药物"},{"name":"李时珍","des":"行医采药27年、三易其稿撰成本草纲目，本草学集大成者。","symbolSize":40,"category":"中药与天然药物"},{"name":"生药学","des":"考证生药来源、鉴别真伪与评价品质的学科，本草的现代传人。","symbolSize":40,"category":"中药与天然药物"},{"name":"天然药物化学","des":"分离鉴定天然活性成分的学科，从吗啡到紫杉醇的两百年长跑。","symbolSize":50,"category":"中药与天然药物"},{"name":"吗啡","des":"1803年塞尔图纳自鸦片提得，史上第一个被纯化的活性生物碱。","symbolSize":40,"category":"中药与天然药物"},{"name":"紫杉醇","des":"1971年自太平洋红豆杉树皮分得，稳定微管的抗癌明星药。","symbolSize":40,"category":"中药与天然药物"},{"name":"长春新碱","des":"长春花生物碱阻断微管聚合，儿童白血病联合化疗的主力。","symbolSize":40,"category":"中药与天然药物"},{"name":"肘后备急方","des":"东晋葛洪所著急救方书，青蒿一握以水二升渍的低温提取线索。","symbolSize":40,"category":"中药与天然药物"},{"name":"屠呦呦","des":"从肘后备急方得到低温提取灵感，2015年获诺贝尔生理学或医学奖。","symbolSize":50,"category":"中药与天然药物"},{"name":"青蒿素","des":"1972年从黄花蒿分得，含过氧桥的倍半萜内酯，抗疟立奇功。","symbolSize":50,"category":"中药与天然药物"},{"name":"中国药典","des":"1953年首版《中华人民共和国药典》，每五年修订的国家药品标准。","symbolSize":40,"category":"中药与天然药物"},{"name":"中药现代化","des":"指纹图谱控质、成分解析与循证评价，让本草说现代语言。","symbolSize":40,"category":"中药与天然药物"},{"name":"复方与配伍","des":"君臣佐使、七情和合的组方艺术，多成分多靶点的协同网络。","symbolSize":40,"category":"中药与天然药物"}],"links":[{"source":"药理学","target":"药学","name":"基石","des":"研究药物作用与临床用药规律的核心学科。"},{"source":"药效学","target":"药理学","name":"分支","des":"回答药物对机体做什么。"},{"source":"药物代谢动力学","target":"药理学","name":"分支","des":"回答机体对药物做什么。"},{"source":"受体理论","target":"药效学","name":"奠基","des":"绝大多数药物效应始于与受体的结合。"},{"source":"埃利希","target":"受体理论","name":"奠基","des":"1897年侧链学说勾勒出受体雏形。"},{"source":"锁钥模型","target":"受体理论","name":"阐释","des":"结构互补是特异性结合的形象表达。"},{"source":"激动剂与拮抗剂","target":"受体理论","name":"衍生","des":"按有无内在活性划分的两类配体。"},{"source":"第二信使","target":"受体理论","name":"下游","des":"受体信号经cAMP与钙离子逐级放大。"},{"source":"量效关系","target":"药效学","name":"定量","des":"效应强度对剂量作图得量效曲线。"},{"source":"治疗指数","target":"量效关系","name":"衍生","des":"比较LD50与ED50量化安全窗口。"},{"source":"药物靶点","target":"药效学","name":"支点","des":"药物效应皆因调控特定靶点而起。"},{"source":"受体理论","target":"药物靶点","name":"属于","des":"受体是靶点四大家族之首。"},{"source":"酶抑制作用","target":"药物靶点","name":"属于","des":"酶是仅次于受体的靶点家族。"},{"source":"离子通道","target":"药物靶点","name":"属于","des":"通道开闭概率是药物调控的旋钮。"},{"source":"转运体","target":"药物靶点","name":"属于","des":"再摄取与外排泵皆可成靶。"},{"source":"选择性","target":"药物靶点","name":"取决于","des":"靶点分布与结合差异决定选择性高低。"},{"source":"药物基因组学","target":"药理学","name":"深化","des":"用基因型解释药效与毒性的个体差异。"},{"source":"药物基因组学","target":"CYP450酶系","name":"个体化","des":"CYP2C19慢代谢者氯吡格雷活化不足。"},{"source":"吸收","target":"药物代谢动力学","name":"环节","des":"ADME四部曲的第一步。"},{"source":"首过效应","target":"吸收","name":"关卡","des":"肝脏先行代谢削减口服药入血量。"},{"source":"首过效应","target":"生物利用度","name":"降低","des":"口服生物利用度因此大打折扣。"},{"source"