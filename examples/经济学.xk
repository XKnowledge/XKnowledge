{"version":2,"nodes":[{"name":"经济学","des":"研究稀缺资源如何在竞争目标间配置的社会科学，历经古典体系、边际革命与凯恩斯革命三大转折，本图由此生发。","symbolSize":70,"category":"古典经济学"},{"name":"重商主义","des":"16至18世纪欧洲正统：财富即金银，奖出限入以累积顺差，国家干预经济的最早论证。","symbolSize":50,"category":"古典经济学"},{"name":"重农学派","des":"18世纪法国学者群体，主张唯农业创造纯产品，自由放任口号的出处。","symbolSize":40,"category":"古典经济学"},{"name":"魁奈","des":"重农学派领袖，1758年《经济表》以锯齿图描绘部门间循环，宏观经济分析的先声。","symbolSize":40,"category":"古典经济学"},{"name":"亚当·斯密","des":"1776年发表《国富论》，熔分工、价值、分配与政府职责于一炉，现代经济学之父。","symbolSize":50,"category":"古典经济学"},{"name":"《国富论》","des":"全名《国民财富的性质和原因的研究》，以分工开篇、以看不见的手收束的开山之作。","symbolSize":50,"category":"古典经济学"},{"name":"看不见的手","des":"个人逐利在竞争中意外增进公共福祉，市场自发秩序的经典意象，此后两百年经济学的主线。","symbolSize":70,"category":"古典经济学"},{"name":"分工","des":"制针厂十八道工序的著名例子：分工提效而受市场范围限制，全书叙事的起点。","symbolSize":40,"category":"古典经济学"},{"name":"劳动价值论","des":"价值源于劳动耗费：斯密发端，李嘉图集大成，马克思批判性继承。","symbolSize":40,"category":"古典经济学"},{"name":"大卫·李嘉图","des":"1817年《政治经济学及赋税原理》，比较优势、级差地租与工资铁律的作者。","symbolSize":50,"category":"古典经济学"},{"name":"比较优势","des":"两优取其重、两劣取其轻，贸易互利与专业分工的根基，国际贸易第一定理。","symbolSize":50,"category":"古典经济学"},{"name":"级差地租","des":"肥力与位置较优土地的额外收益，随人口增长与边际递减而累积上升。","symbolSize":40,"category":"古典经济学"},{"name":"萨伊","des":"1803年《政治经济学概论》三分法的提出者，斯密学说的欧陆传人。","symbolSize":40,"category":"古典经济学"},{"name":"萨伊定律","des":"供给会创造自身需求，普遍过剩不可能，百年公理，凯恩斯革命的头号靶子。","symbolSize":50,"category":"古典经济学"},{"name":"马尔萨斯","des":"1798年《人口原理》论人口与食物赛跑，又以有效需求不足质疑萨伊，凯恩斯的隔代先声。","symbolSize":40,"category":"古典经济学"},{"name":"约翰·穆勒","des":"1848年《政治经济学原理》集古典体系之大成，分立生产规律与分配规律。","symbolSize":40,"category":"古典经济学"},{"name":"马克思","des":"承劳动价值论立剩余价值学说，《资本论》1867年首卷出版，政治经济学批判传统的开创者。","symbolSize":40,"category":"古典经济学"},{"name":"边际革命","des":"1870年代初杰文斯、门格尔、瓦尔拉斯各自独立以边际效用重立价值论，经济学由客观转向主观。","symbolSize":50,"category":"边际革命与新古典"},{"name":"杰文斯","des":"1871年《政治经济学理论》：价值取决于最后效用程度，与门格尔同年不谋而合。","symbolSize":40,"category":"边际革命与新古典"},{"name":"门格尔","des":"1871年《国民经济学原理》，边际分析与奥地利学派的开山之祖。","symbolSize":50,"category":"边际革命与新古典"},{"name":"瓦尔拉斯","des":"1874年《纯粹经济学要义》以联立方程刻画全部市场同时出清，洛桑学派之祖。","symbolSize":50,"category":"边际革命与新古典"},{"name":"一般均衡理论","des":"一切市场相互联动、同时出清的完整图景，经济学最雄心勃勃的理论骨架。","symbolSize":70,"category":"边际革命与新古典"},{"name":"阿罗-德布鲁模型","des":"1954年以不动点定理严格证明均衡存在，数理经济学的巅峰之作。","symbolSize":40,"category":"边际革命与新古典"},{"name":"阿罗","des":"一般均衡存在性与不可能定理的双重作者，1972年与希克斯同获诺贝尔奖。","symbolSize":40,"category":"边际革命与新古典"},{"name":"马歇尔","des":"1890年《经济学原理》织就供求局部均衡、弹性与消费者剩余，新古典体系的缔造者。","symbolSize":50,"category":"边际革命与新古典"},{"name":"供给与需求","des":"马歇尔的剪刀：两条曲线交点决定价格与产量，微观分析的默认语法。","symbolSize":40,"category":"边际革命与新古典"},{"name":"弹性","des":"需求量对价格变动的敏感比率，马歇尔命名，税负归宿与定价策略的标尺。","symbolSize":40,"category":"边际革命与新古典"},{"name":"消费者剩余","des":"愿付价格与实付价格之差，需求曲线下的一块三角形，福利度量的常用尺。","symbolSize":40,"category":"边际革命与新古典"},{"name":"帕累托","des":"洛桑学派第二代掌门，以序数效用替代基数效用，并留下最优配置判据。","symbolSize":40,"category":"边际革命与新古典"},{"name":"帕累托最优","des":"不使任何人受损便无人能再获益的配置状态，效率判准的通用语言。","symbolSize":50,"category":"边际革命与新古典"},{"name":"完全竞争","des":"买卖者众、产品同质、进出自由、信息完全的理想市场，效率定理的参照系。","symbolSize":40,"category":"边际革命与新古典"},{"name":"垄断","des":"独家卖主按边际收益定价，价高量少而效率受损，反垄断政策的理由。","symbolSize":40,"category":"边际革命与新古典"},{"name":"垄断竞争","des":"张伯伦与罗宾逊1933年同年各自提出：产品差异化填补两极之间的现实地带。","symbolSize":40,"category":"边际革命与新古典"},{"name":"稀缺性","des":"资源有限而欲望无穷，经济学之所以存在的第一前提。","symbolSize":50,"category":"微观经济学"},{"name":"机会成本","des":"为所选而放弃的次优选择价值，一切成本的本质。","symbolSize":40,"category":"微观经济学"},{"name":"生产可能性边界","des":"既定资源与技术下的最大产出组合曲线，机会成本的几何表达。","symbolSize":40,"category":"微观经济学"},{"name":"效用","des":"消费满足的主观评价，边际革命登上价值论中心的核心筹码。","symbolSize":40,"category":"微观经济学"},{"name":"边际效用递减","des":"追加消费带来的效用增量逐步下滑，水与钻石价值悖论的解答。","symbolSize":40,"category":"微观经济学"},{"name":"无差异曲线","des":"埃奇沃思发明、希克斯与艾伦1934年复活，序数效用论的分析骨架。","symbolSize":40,"category":"微观经济学"},{"name":"消费者均衡","des":"预算线与无差异曲线相切，每一元钱边际效用处处相等的最优点。","symbolSize":40,"category":"微观经济学"},{"name":"生产函数","des":"投入与产出之间的技术关系，边际产量递减与规模报酬皆由此展开。","symbolSize":40,"category":"微观经济学"},{"name":"规模报酬","des":"投入等比放大时产出的放大倍数，递增形态通往自然垄断。","symbolSize":40,"category":"微观经济学"},{"name":"外部性","des":"成本或收益溢出到交易双方之外，价格机制失真的经典来源。","symbolSize":50,"category":"微观经济学"},{"name":"庇古税","des":"按边际外部损害征税，把社会成本内部化，环境税的理论始祖。","symbolSize":40,"category":"微观经济学"},{"name":"庇古","des":"1920年《福利经济学》开创者，外部性矫正与旧福利经济学的设计师。","symbolSize":40,"category":"微观经济学"},{"name":"公共品","des":"非竞争且非排他的灯塔与国防，市场供给天然不足。","symbolSize":40,"category":"微观经济学"},{"name":"搭便车","des":"隐藏真实偏好坐享他人贡献，公共品自愿供给必然不足的机制。","symbolSize":40,"category":"微观经济学"},{"name":"市场失灵","des":"垄断、外部性、公共品与信息不对称令价格机制偏离帕累托最优的总清单。","symbolSize":50,"category":"微观经济学"},{"name":"信息不对称","des":"交易一方私知另一方不知的信息，逆向选择与道德风险由此滋生。","symbolSize":50,"category":"微观经济学"},{"name":"柠檬市场","des":"阿克洛夫1970年旧车模型：买方压价赶走好车，劣市驱逐良市。","symbolSize":40,"category":"微观经济学"},{"name":"阿克洛夫","des":"柠檬市场论文三度被拒终成经典，2001年诺贝尔经济学奖得主。","symbolSize":40,"category":"微观经济学"},{"name":"斯蒂格利茨","des":"信息不对称三杰之一，格罗斯曼-斯蒂格利茨悖论证明市场不可能信息完全有效。","symbolSize":40,"category":"微观经济学"},{"name":"大萧条","des":"1929年起美国产出跌落近三成、失业约四分之一，古典信条与金本位同时破产。","symbolSize":50,"category":"宏观经济学"},{"name":"凯恩斯","des":"1936年《就业、利息和货币通论》以有效需求重释萧条，现代宏观经济学与需求管理之父。","symbolSize":50,"category":"宏观经济学"},{"name":"有效需求","des":"总需求决定产出与就业，投资不足则萧条持久，凯恩斯体系的中枢。","symbolSize":70,"category":"宏观经济学"},{"name":"流动性偏好","des":"交易、预防与投机三重持币动机，利率由货币供求决定的凯恩斯内核。","symbolSize":40,"category":"宏观经济学"},{"name":"利率","des":"凯恩斯视之为纯货币现象：放弃流动性的报酬，由流动性偏好与货币量共同决定。","symbolSize":40,"category":"宏观经济学"},{"name":"流动性陷阱","des":"利率降至低位后货币宽松失效，财政扩张成为仅剩引擎。","symbolSize":40,"category":"宏观经济学"},{"name":"乘数原理","des":"卡恩1931年首算、凯恩斯采纳：一笔初始支出经连锁反应放大为数倍收入。","symbolSize":50,"category":"宏观经济学"},{"name":"边际消费倾向","des":"追加收入中用于消费的比例，乘数等于其一减之倒数。","symbolSize":40,"category":"宏观经济学"},{"name":"非自愿失业","des":"愿按现行工资工作而无工可做，工资刚性下劳动市场无法出清。","symbolSize":40,"category":"宏观经济学"},{"name":"IS-LM模型","des":"希克斯1937年把《通论》整理为产品与货币市场同时均衡的坐标系。","symbolSize":50,"category":"宏观经济学"},{"name":"希克斯","des":"IS-LM图形与一般均衡价值论的作者，1972年与阿罗同获诺贝尔奖。","symbolSize":40,"category":"宏观经济学"},{"name":"菲利普斯曲线","des":"1958年英国近百年工资数据与失业率负相关，通胀失业替代关系的经验支柱。","symbolSize":50,"category":"宏观经济学"},{"name":"通货膨胀","des":"物价总水平持续上涨，货币现象还是需求现象，两派学说的分水岭。","symbolSize":40,"category":"宏观经济学"},{"name":"滞胀","des":"二十世纪七十年代通胀与失业同升，替代关系崩塌，凯恩斯正统的裂缝。","symbolSize":40,"category":"宏观经济学"},{"name":"财政政策","des":"以税收与支出调节总需求，凯恩斯需求管理的第一工具。","symbolSize":50,"category":"宏观经济学"},{"name":"货币政策","des":"央行调节货币与利率以稳定总需求与物价，与财政政策并称两大稳定器。","symbolSize":50,"category":"宏观经济学"},{"name":"泰勒规则","des":"利率对通胀缺口与产出缺口作线性反应的简单规则，现代央行的隐性操作手册。","symbolSize":40,"category":"宏观经济学"},{"name":"国民收入核算","des":"库兹涅茨与斯通把经济总量变成可测数字，凯恩斯宏观学的统计地基。","symbolSize":40,"category":"宏观经济学"},{"name":"索洛增长模型","des":"1956年证明资本边际递减后长期增长唯靠技术进步，增长经济学的基准模型。","symbolSize":40,"category":"宏观经济学"},{"name":"经济增长","des":"长期产出能力的扩张，资本、劳动与技术进步的三重源泉，斯密首问的延续。","symbolSize":50,"category":"宏观经济学"},{"name":"货币主义","des":"货币量主导名义变量，通胀始终且处处是货币现象，规则优于相机抉择。","symbolSize":50,"category":"学派论战"},{"name":"弗里德曼","des":"芝加哥学派旗手，1956年重述数量论、1967年提出自然率假说，1976年获诺奖。","symbolSize":50,"category":"学派论战"},{"name":"货币数量论","des":"货币量乘流通速度等于物价乘产出，从休谟到弗里德曼的古老恒等式。","symbolSize":40,"category":"学派论战"},{"name":"自然失业率","des":"由摩擦性与结构性因素决定的失业底数，长期菲利普斯曲线垂直于此。","symbolSize":40,"category":"学派论战"},{"name":"理性预期","des":"穆斯1961年提出、卢卡斯发扬：公众用一切可得信息无系统偏差地预判政策。","symbolSize":50,"category":"学派论战"},{"name":"卢卡斯","des":"理性预期学派旗手，宏观经济学重建的总工程师，1995年获诺贝尔奖。","symbolSize":40,"category":"学派论战"},{"name":"卢卡斯批判","des":"政策一旦改变，历史数据估计的参数即告失效，宏观模型不能指导新政。","symbolSize":50,"category":"学派论战"},{"name":"供给学派","des":"以减税激励生产取代需求调节，里根经济学的理论底色。","symbolSize":40,"category":"学派论战"},{"name":"拉弗曲线","des":"税率超过临界点税收反而下降的倒U曲线，餐巾纸上的一画成名。","symbolSize":40,"category":"学派论战"},{"name":"奥地利学派","des":"门格尔一脉的主观价值与市场过程理论，拒绝均衡数学化的另一正统。","symbolSize":50,"category":"学派论战"},{"name":"米塞斯","des":"1920年首诘计划经济计算难题，主观主义方法论的中坚。","symbolSize":40,"category":"学派论战"},{"name":"哈耶克","des":"以知识的分立论证价格的信息功能，1974年获诺奖，凯恩斯的终身论敌。","symbolSize":50,"category":"学派论战"},{"name":"知识的分立","des":"知识散在无数个体手中不可集中，价格体系是汇聚它的电信系统。","symbolSize":40,"category":"学派论战"},{"name":"社会主义计算论战","des":"米塞斯与哈耶克对阵兰格一派：计划能否替代市场完成合理配置。","symbolSize":40,"category":"学派论战"},{"name":"新古典综合","des":"萨缪尔森嫁接凯恩斯宏观与新古典微观，战后教科书正统的代名词。","symbolSize":50,"category":"学派论战"},{"name":"萨缪尔森","des":"1948年《经济学》教科书、显示偏好理论与新古典综合，1970年美国首个经济学诺奖。","symbolSize":50,"category":"学派论战"},{"name":"芝加哥学派","des":"价格理论至上、信市场而疑政府，弗里德曼、卢卡斯与贝克尔皆出其门。","symbolSize":40,"category":"学派论战"},{"name":"凡勃伦","des":"1899年《有闲阶级论》论炫耀性消费与制度演化，旧制度学派开山。","symbolSize":40,"category":"制度与发展"},{"name":"炫耀性消费","des":"为彰显地位而非满足需求而消费，价格越高需求越旺的凡勃伦效应。","symbolSize":40,"category":"制度与发展"},{"name":"交易成本","des":"搜寻、谈判与执行契约的成本，企业与制度之所以存在的理由。","symbolSize":50,"category":"制度与发展"},{"name":"科斯","des":"1937年《企业的性质》与1960年《社会成本问题》两文的作者，1991年获诺奖。","symbolSize":50,"category":"制度与发展"},{"name":"企业的性质","des":"市场万能何需企业？企业边界定于市场成本与组织成本的比较。","symbolSize":40,"category":"制度与发展"},{"name":"科斯定理","des":"交易成本为零时产权初始配置不影响效率，庇古税之外另有出路。","symbolSize":50,"category":"制度与发展"},{"name":"诺斯","des":"把制度变迁与路径依赖引入经济史，1993年获诺奖，制度是长期增长的深层原因。","symbolSize":40,"category":"制度与发展"},{"name":"路径依赖","des":"初始选择锁定后续轨道，QWERTY键盘与殖民地制度的长期阴影。","symbolSize":40,"category":"制度与发展"},{"name":"威廉姆森","des":"交易成本经济学集大成者：资产专用性决定治理结构，2009年获诺奖。","symbolSize":40,"category":"制度与发展"},{"name":"刘易斯","des":"1954年二元经济模型的构建者，1979年获诺奖，发展经济学奠基人。","symbolSize":40,"category":"制度与发展"},{"name":"二元经济","des":"传统农业剩余劳动与现代工业部门并存，转移殆尽即迎来刘易斯拐点。","symbolSize":40,"category":"制度与发展"},{"name":"罗斯托","des":"1960年《经济增长的阶段》：主导部门与高储蓄率引致经济起飞。","symbolSize":40,"category":"制度与发展"},{"name":"赫希曼","des":"1958年《经济发展战略》主张不平衡增长，资源押注关联效应最强的环节。","symbolSize":40,"category":"制度与发展"},{"name":"福利经济学","des":"以效率与公平评判资源配置优劣，令经济学重回伦理判断的分支。","symbolSize":50,"category":"制度与发展"},{"name":"阿罗不可能定理","des":"1951年证明不存在同时满足最少合理条件的集体偏好加总机制，社会选择之殇。","symbolSize":40,"category":"制度与发展"},{"name":"行为经济学","des":"以有限理性、自控缺失与社会偏好修正理性人假设的新流派。","symbolSize":50,"category":"前沿交叉"},{"name":"卡尼曼","des":"心理学家而获2002年经济学诺奖，把偏差与启发式研究搬进经济学。","symbolSize":50,"category":"前沿交叉"},{"name":"特沃斯基","des":"卡尼曼的黄金搭档，共创前景理论，1996年早逝无缘同享诺奖。","symbolSize":40,"category":"前沿交叉"},{"name":"前景理论","des":"1979年以参照点、损失厌恶与概率加权替代期望效用，行为学派的镇山之论。","symbolSize":50,"category":"前沿交叉"},{"name":"塞勒","des":"心理账户、禀赋效应与助推的提出者，2017年获诺奖，行为经济学的落地者。","symbolSize":40,"category":"前沿交叉"},{"name":"助推","des":"不禁止不强制，只改造选择架构引导更优决策，行为政策学的名片。","symbolSize":40,"category":"前沿交叉"},{"name":"实验经济学","des":"史密斯首创受控实验室检验市场理论，2002年与卡尼曼同年获奖。","symbolSize":40,"category":"前沿交叉"},{"name":"史密斯","des":"口头双向拍卖实验证明市场快速收敛于均衡，实验方法的开创者。","symbolSize":40,"category":"前沿交叉"},{"name":"博弈论方法","des":"纳什均衡改写产业组织、信息与机制设计，战后经济学数学化的主引擎。","symbolSize":40,"category":"前沿交叉"},{"name":"环境经济学","des":"庇古税与产权交易治污染，碳定价的理论故乡。","symbolSize":40,"category":"前沿交叉"},{"name":"网络效应","des":"用户越多价值越大，需求方规模经济造就好赢家通吃。","symbolSize":40,"category":"前沿交叉"},{"name":"平台经济","des":"双边市场撮合与交叉补贴，反垄断与监管面临的新命题。","symbolSize":40,"category":"前沿交叉"}],"links":[{"source":"重商主义","target":"经济学","name":"先声","des":"奖出限入的干预信条为斯密的自由市场论准备了靶子。"},{"source":"重农学派","target":"重商主义","name":"反叛","des":"魁奈一派斥贸易致富论，坚称唯农业创造纯产品。"},{"source":"魁奈","target":"重农学派","name":"领衔","des":"《经济表》把部门间循环画成一图，宏观分析先声。"},{"source":"亚当·斯密","target":"重农学派","name":"交往","des":"1766年旅法结识魁奈，自由放任口号由此借鉴。"},{"source":"亚当·斯密","target":"《国富论》","name":"著就","des":"十年磨一剑，1776年出版即成学科奠基之作。"},{"source":"《国富论》","target":"经济学","name":"奠基","des":"分工、价值、分配与政府职责首次熔为一炉。"},{"source":"《国富论》","target":"看不见的手","name":"孕育","des":"一句名言成为市场自发秩序的永恒意象。"},{"source":"《国富论》","target":"分工","name":"阐发","des":"制针厂的例子开篇即讲效率之源。"},{"source":"看不见的手","target":"经济学","name":"灵魂","des":"论证或修补这只手，构成此后两百年经济学主线。"},{"source":"分工","target":"比较优势","name":"铺垫","des":"分工原则从工场内部推到国家之间。"},{"source":"劳动价值论","target":"《国富论》","name":"发端","des":"斯密以劳动衡量价值，开启百年价值论战。"},{"source":"大卫·李嘉图","target":"劳动价值论","name":"集大成","des":"把价值论推到严格形态，也留下解不开的难题。"},{"source":"大卫·李嘉图","target":"比较优势","name":"提出","des":"1817年以英葡呢绒与葡萄酒之例立论。"},{"source":"比较优势","target":"劳动价值论","name":"基于","des":"以相对劳动成本说明贸易互利的根源。"},{"source":"大卫·李嘉图","target":"级差地租","name":"提出","des":"优等地先耕，地租随人口增长与边际递减上升。"},{"source":"级差地租","target":"边际革命","name":"先声","des":"边际递减的分析已在地租论中萌芽。"},{"source":"萨伊","target":"萨伊定律","name":"提出","des":"供给创造自身需求，销售困难只是结构错位。"},{"source":"萨伊定律","target":"经济学","name":"支配","des":"百年间被奉为公理，直到凯恩斯革命才被正面击中。"},{"source":"萨伊","target":"亚当·斯密","name":"传承","des":"《政治经济学概论》把斯密体系传往欧陆。"},{"source":"马尔萨斯","target":"萨伊定律","name":"质疑","des":"与萨伊通信论战，首提有效需求可能不足。"},{"source":"马尔萨斯","target":"凯恩斯","name":"先声","des":"有效需求不足论隔百年被《通论》郑重启用。"},{"source":"约翰·穆勒","target":"大卫·李嘉图","name":"承接","des":"《政治经济学原理》总结古典体系而保留李嘉图价值论。"},{"source":"约翰·穆勒","target":"经济学","name":"综合","des":"古典经济学在其笔下成为成熟的教科书体系。"},{"source":"马克思","target":"劳动价值论","name":"批判继承","des":"承认劳动是价值源泉，追问剩余价值归谁所有。"},{"source":"马克思","target":"经济学","name":"对立","des":"政治经济学批判另立传统，直指资本主义内在矛盾。"},{"source":"边际革命","target":"劳动价值论","name":"颠覆","des":"价值不取决于劳动耗费而取决于边际效用。"},{"source":"杰文斯","target":"边际革命","name":"发动","des":"1871年宣布价值全赖效用，与门格尔同年不谋而合。"},{"source":"门格尔","target":"边际革命","name":"发动","des":"同年《国民经济学原理》独立提出边际分析。"},{"source":"门格尔","target":"奥地利学派","name":"开山","des":"主观价值与方法论个人主义由此立宗。"},{"source":"瓦尔拉斯","target":"边际革命","name":"发动","des":"第三位独立发现者，并把边际分析推至全部市场。"},{"source":"瓦尔拉斯","target":"一般均衡理论","name":"创建","des":"联立方程组令一切价格同时决定。"},{"source":"一般均衡理论","target":"经济学","name":"骨架","des":"所有市场联动的完整图景是学科的理论皇冠。"},{"source":"阿罗","target":"阿罗-德布鲁模型","name":"证明","des":"1954年与德布鲁以不动点定理证均衡存在。"},{"source":"阿罗-德布鲁模型","target":"一般均衡理论","name":"封顶","des":"瓦尔拉斯百年悬想的严格数学完成。"},{"source":"帕累托","target":"瓦尔拉斯","name":"接棒","des":"继掌洛桑教席，把基数效用改造为序数。"},{"source":"帕累托","target":"帕累托最优","name":"提出","des":"以配置效率替代不可测的人际效用比较。"},{"source":"帕累托最优","target":"福利经济学","name":"判准","des":"效率标尺从此通行福利分析。"},{"source":"马歇尔","target":"供给与需求","name":"综合","des":"剪刀合璧供求两派，均衡价格一锤定音。"},{"source":"供给与需求","target":"完全竞争","name":"呈现","des":"完全竞争下均衡即市场出清的教科书图景。"},{"source":"马歇尔","target":"弹性","name":"引入","des":"命名并度量需求弹性，价格理论从此可量化。"},{"source":"马歇尔","target":"消费者剩余","name":"提出","des":"需求曲线以下、价格以上的那块三角形。"},{"source":"消费者剩余","target":"福利经济学","name":"供尺","des":"成为成本收益分析与政策评估的常用工具。"},{"source":"完全竞争","target":"帕累托最优","name":"支撑","des":"第一福利定理：完全竞争均衡即帕累托最优。"},{"source":"垄断","target":"完全竞争","name":"对照","des":"垄断者按边际收益定价，产量更低价格更高。"},{"source":"垄断竞争","target":"完全竞争","name":"修正","des":"张伯伦与罗宾逊填补两极之间的现实地带。"},{"source":"稀缺性","target":"经济学","name":"出发","des":"资源有限欲望无穷，学科的第一定义。"},{"source":"机会成本","target":"稀缺性","name":"根植","des":"有稀缺才有取舍，取舍的代价即机会成本。"},{"source":"生产可能性边界","target":"机会成本","name":"呈现","des":"曲线的斜率量度弃此取彼的代价。"},{"source":"效用","target":"边际革命","name":"内核","des":"主观效用登上价值论的中心位置。"},{"source":"边际效用递减","target":"效用","name":"刻画","des":"追加消费的增量效用步步下滑。"},{"source":"边际效用递减","target":"无差异曲线","name":"化形","des":"序数化后表现为曲线凸向原点。"},{"source":"无差异曲线","target":"消费者均衡","name":"求解","des":"与预算线相切之处即最优组合。"},{"source":"消费者均衡","target":"边际效用递减","name":"条件","des":"每一元钱边际效用相等是均衡内核。"},{"source":"生产函数","target":"规模报酬","name":"推演","des":"等比扩大投入，观察产出放大几倍。"},{"source":"规模报酬","target":"垄断","name":"铺路","des":"报酬递增走到尽头便是自然垄断。"},{"source":"外部性","target":"市场失灵","name":"归入","des":"私人成本与社会成本背离令价格失真。"},{"source":"外部性","target":"庇古税","name":"引出","des":"庇古以矫正税把外部损害内部化。"},{"source":"庇古","target":"庇古税","name":"设计","des":"1920年《福利经济学》给出的政策工具。"},{"source":"庇古","target":"福利经济学","name":"开创","des":"把功利传统改造成可操作的福利分析。"},{"source":"公共品","target":"搭便车","name":"孕育","des":"非排他性令人争相坐享他人出钱。"},{"source":"公共品","target":"市场失灵","name":"归入","des":"无法排他定价的物品市场不愿供给。"},{"source":"市场失灵","target":"看不见的手","name":"修补","des":"失灵清单即对斯密秩序边界的勘定。"},{"source":"信息不对称","target":"市场失灵","name":"归入","des":"第四类失灵，被阿克洛夫与斯蒂格利茨论证其普遍。"},{"source":"柠檬市场","target":"信息不对称","name":"例证","des":"旧车市场的逆向选择令好车先行退场。"},{"source":"阿克洛夫","target":"柠檬市场","name":"提出","des":"1970年论文三度被拒终成开山经典。"},{"source":"斯蒂格利茨","target":"信息不对称","name":"深化","des":"筛选理论与信息效率悖论把失灵推而广之。"},{"source":"垄断","target":"市场失灵","name":"归入","des":"定价高于边际成本造成无谓损失。"},{"source":"大萧条","target":"凯恩斯","name":"催生","des":"旧理论在危机前失语，《通论》应运而出。"},{"source":"凯恩斯","target":"有效需求","name":"提出","des":"就业水平由总需求决定，萧条是需求之病。"},{"source":"有效需求","target":"萨伊定律","name":"颠覆","des":"需求决定供给而非相反，普遍过剩可能持久。"},{"source":"凯恩斯","target":"流动性偏好","name":"提出","des":"利率是放弃流动性的报酬。"},{"source":"流动性偏好","target":"利率","name":"决定","des":"货币供求的均衡价格，与可贷资金论针锋相对。"},{"source":"利率","target":"流动性陷阱","name":"陷入","des":"降至低位后货币需求弹性趋于无穷。"},{"source":"流动性陷阱","target":"财政政策","name":"逼出","des":"货币宽松失效，财政成为仅剩引擎。"},{"source":"凯恩斯","target":"乘数原理","name":"采纳","des":"卡恩首算的连锁放大效应写入《通论》。"},{"source":"乘数原理","target":"边际消费倾向","name":"依赖","des":"倾向越高乘数越大，等于其一减之倒数。"},{"source":"边际消费倾向","target":"有效需求","name":"构成","des":"消费函数是总需求的第一根支柱。"},{"source":"非自愿失业","target":"有效需求","name":"呼应","des":"需求不足令劳动市场无从出清。"},{"source":"非自愿失业","target":"大萧条","name":"描述","des":"失业四分之一绝非自愿选择闲暇。"},{"source":"希克斯","target":"IS-LM模型","name":"整理","des":"1937年把《通论》译成两张市场的均衡图。"},{"source":"IS-LM模型","target":"有效需求","name":"表达","des":"产品与货币市场同时均衡决定产出与利率。"},{"source":"IS-LM模型","target":"财政政策","name":"沙盘","des":"IS曲线移动的效力比较成了政策教科书内容。"},{"source":"IS-LM模型","target":"货币政策","name":"沙盘","des":"LM曲线移动同台竞技。"},{"source":"菲利普斯曲线","target":"通货膨胀","name":"关联","des":"失业与通胀的替代写进政策菜单。"},{"source":"滞胀","target":"菲利普斯曲线","name":"打破","des":"七十年代两者同升，替代关系崩塌。"},{"source":"滞胀","target":"货币主义","name":"助推","des":"菲利普斯崩塌给了货币主义登场舞台。"},{"source":"通货膨胀","target":"货币政策","name":"靶向","des":"物价稳定成为央行首要法定目标。"},{"source":"财政政策","target":"有效需求","name":"操作","des":"政府支出直接注入总需求，乘数放大其效。"},{"source":"货币政策","target":"利率","name":"传导","des":"调节货币量移动LM，利率随之变动。"},{"source":"泰勒规则","target":"货币政策","name":"塑造","des":"把相机抉择约束为可预期的规则。"},{"source":"泰勒规则","target":"通货膨胀","name":"响应","des":"通胀每高目标一单位便加息超过一单位。"},{"source":"国民收入核算","target":"大萧条","name":"应战","des":"库兹涅茨为把握萧条首次系统测算国民收入。"},{"source":"国民收入核算","target":"有效需求","name":"配套","des":"总量统计让总需求分析有了刻度。"},{"source":"索洛增长模型","target":"经济增长","name":"解释","des":"长期增长最终靠技术进步而非资本堆积。"},{"source":"索洛增长模型","target":"新古典综合","name":"属于","des":"索洛是综合派阵营的主力干将。"},{"source":"经济增长","target":"《国富论》","name":"呼应","des":"国民财富的性质与原因即增长之问。"},{"source":"弗里德曼","target":"货币主义","name":"立宗","des":"1956年《货币数量论重述》另起理论山头。"},{"source":"货币主义","target":"货币数量论","name":"复兴","des":"把休谟的旧恒等式重铸为现代假说。"},{"source":"货币数量论","target":"通货膨胀","name":"断言","des":"货币超发是通胀唯一持久的原因。"},{"source":"弗里德曼","target":"自然失业率","name":"提出","des":"1967年美国经济学会主席讲演宣判长期替代无效。"},{"source":"自然失业率","target":"菲利普斯曲线","name":"垂直化","des":"长期曲线竖立于自然失业率之上。"},{"source":"自然失业率","target":"理性预期","name":"接力","des":"预期迅速调整则短期替代亦弱。"},{"source":"卢卡斯","target":"理性预期","name":"发扬","des":"把穆斯的概念变成宏观重建的引擎。"},{"source":"卢卡斯","target":"卢卡斯批判","name":"提出","des":"计量模型的旧参数不能评价新政策。"},{"source":"卢卡斯批判","target":"新古典综合","name":"冲击","des":"大型宏观模型的政策评估权威动摇。"},{"source":"货币主义","target":"IS-LM模型","name":"不满","des":"斥其重财政轻货币、忽视通胀机制。"},{"source":"弗里德曼","target":"芝加哥学派","name":"领衔","des":"货币论战与价格理论在芝加哥合流。"},{"source":"芝加哥学派","target":"经济学","name":"重塑","des":"信市场的学风在七十年代后改写理论与政策。"},{"source":"供给学派","target":"拉弗曲线","name":"依托","des":"减税增产的论证画在一张餐巾纸上。"},{"source":"拉弗曲线","target":"财政政策","name":"反转","des":"减税未必减收，税率与税收非线性相关。"},{"source":"供给学派","target":"凯恩斯","name":"逆行","des":"把政策焦点从需求调节调回供给激励。"},{"source":"奥地利学派","target":"经济学","name":"独行","des":"拒绝均衡数学化，坚持市场过程与企业家发现。"},{"source":"米塞斯","target":"奥地利学派","name":"中坚","des":"把主观主义推及货币、周期与体制比较。"},{"source":"米塞斯","target":"社会主义计算论战","name":"发难","des":"1920年断言无生产资料市场便无合理定价。"},{"source":"哈耶克","target":"社会主义计算论战","name":"加入","des":"以知识分立论证中央计划的信息不可能。"},{"source":"哈耶克","target":"知识的分立","name":"阐发","des":"1945年《知识在社会中的运用》名文。"},{"source":"知识的分立","target":"看不见的手","name":"重释","des":"价格体系是汇聚千万分散知识的电信系统。"},{"source":"哈耶克","target":"芝加哥学派","name":"神似","des":"同尊市场而方法分途，前后脚获诺奖。"},{"source":"萨缪尔森","target":"新古典综合","name":"缔造","des":"嫁接凯恩斯宏观与新古典微观成战后正统。"},{"source":"新古典综合","target":"IS-LM模型","name":"教科书化","des":"希克斯图形成为综合派的标准教具。"},{"source":"新古典综合","target":"凯恩斯","name":"化用","des":"把革命收编进均衡框架，留下忠实与否之争。"},{"source":"新古典综合","target":"货币主义","name":"遭遇挑战","des":"六七十年代滞胀与货币论战令正统动摇。"},{"source":"凡勃伦","target":"经济学","name":"离经","des":"以演进与制度批判新古典的静态理性人。"},{"source":"凡勃伦","target":"炫耀性消费","name":"提出","des":"《有闲阶级论》点破消费背后的地位竞争。"},{"source":"炫耀性消费","target":"行为经济学","name":"先声","des":"社会性偏好与相对收入早被凡勃伦看破。"},{"source":"科斯","target":"企业的性质","name":"提问","des":"1937年问企业为何存在于市场的海洋。"},{"source":"企业的性质","target":"交易成本","name":"创立","des":"以组织成本对市场成本的比较作答。"},{"source":"交易成本","target":"科斯定理","name":"地基","des":"交易成本为零与为正的两种世界由此分开。"},{"source":"科斯","target":"科斯定理","name":"提出","des":"1960年《社会成本问题》重审庇古传统。"},{"source":"科斯定理","target":"庇古税","name":"对照","des":"或谈或税，视交易成本高低而定。"},{"source":"科斯定理","target":"外部性","name":"重解","des":"外部性实为产权界定问题而非天然的市场失败。"},{"source":"诺斯","target":"路径依赖","name":"概括","des":"制度变迁被初始条件与历史偶然锁定。"},{"source":"路径依赖","target":"经济增长","name":"解释","des":"初始制度差距拉大长期国运分野。"},{"source":"诺斯","target":"交易成本","name":"接续","des":"把成本概念延伸到制度与经济史。"},{"source":"威廉姆森","target":"交易成本","name":"集大成","des":"资产专用性与治理结构匹配成完整框架。"},{"source":"威廉姆森","target":"企业的性质","name":"续答","des":"半世纪后把科斯之问做成可操作理论。"},{"source":"刘易斯","target":"二元经济","name":"模型化","des":"1954年剩余劳动转移的发展叙事。"},{"source":"二元经济","target":"经济增长","name":"驱动","des":"农业剩余劳力流向现代部门即发展引擎。"},{"source":"罗斯托","target":"经济增长","name":"分段","des":"从传统社会到大众消费的六阶段序列。"},{"source":"赫希曼","target":"罗斯托","name":"相对","des":"不平衡增长对均衡起飞路线的反题。"},{"source":"赫希曼","target":"经济增长","name":"策略","des":"押注前向后向关联最强的环节以点带面。"},{"source":"阿罗","target":"阿罗不可能定理","name":"证明","des":"博士论文改写而成社会选择理论的基石。"},{"source":"阿罗不可能定理","target":"福利经济学","name":"重创","des":"完美加总个人偏好的机制并不存在。"},{"source":"福利经济学","target":"经济学","name":"价值判断","des":"效率与公平的权衡令学科直面伦理。"},{"source":"行为经济学","target":"消费者均衡","name":"修正","des":"偏好漂移、参照点与自控皆越出理性选择框架。"},{"source":"卡尼曼","target":"行为经济学","name":"奠基","des":"把偏差与启发式研究搬进经济学。"},{"source":"卡尼曼","target":"前景理论","name":"共创","des":"与特沃斯基以实验重写风险决策。"},{"source":"特沃斯基","target":"前景理论","name":"共创","des":"黄金搭档1996年早逝，无缘六年后的诺奖。"},{"source":"前景理论","target":"行为经济学","name":"立论","des":"参照点与损失厌恶成为行为派的镇山概念。"},{"source":"塞勒","target":"行为经济学","name":"落地","des":"心理账户、禀赋效应与助推推向政策。"},{"source":"塞勒","target":"助推","name":"提出","des":"与桑斯坦合著，改选择架构而非强制。"},{"source":"史密斯","target":"实验经济学","name":"开创","des":"1956年起以双向拍卖实验重估市场理论。"},{"source":"实验经济学","target":"行为经济学","name":"供给证据","des":"实验室同时喂养两大新流派。"},{"source":"实验经济学","target":"一般均衡理论","name":"检验","des":"双向拍卖实验显示市场快速收敛均衡。"},{"source":"博弈论方法","target":"信息不对称","name":"装配","des":"逆向选择与道德风险皆化为不完美信息博弈。"},{"source":"博弈论方法","target":"经济学","name":"硬化","des":"理论工具自此从供求曲线转向策略与机制设计。"},{"source":"环境经济学","target":"庇古税","name":"应用","des":"排放定价把矫正税用于气候治理。"},{"source":"环境经济学","target":"科斯定理","name":"应用","des":"排污权交易即产权方案的落地。"},{"source":"环境经济学","target":"外部性","name":"治理","des":"为负外部性定价是本学科的日常工作。"},{"source":"网络效应","target":"垄断","name":"重释","des":"需求侧规模经济令垄断不再依赖成本曲线。"},{"source":"网络效应","target":"平台经济","name":"支撑","des":"双边用户互相吸引造成赢家通吃。"},{"source":"平台经济","target":"交易成本","name":"削减","des":"平台以匹配算法压缩搜寻与谈判成本。"}],"title":"经济学","description":"从斯密的看不见的手到行为经济学，思想流派与微观宏观理论的全景。"}